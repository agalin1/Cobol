        <mxCell id="wHostCaption" parent="w1" style="text;html=1;fontSize=12;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#182230;" value="HOST — UGDTT37: estas secciones se CREAN aquí y se REPLICAN a Oracle" vertex="1">
