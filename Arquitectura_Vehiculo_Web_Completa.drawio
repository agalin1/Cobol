        <!-- ===================== PAQUETE B: SERVICIO DE RESOLUCIÓN (nuevo) ===================== -->
        <mxCell id="wPkgServicio" parent="w1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FDEDED;strokeColor=#B23A3A;align=left;spacingLeft=8;spacingTop=6;tabWidth=280;tabHeight=22;tabPosition=left;" value="Servicio de resolución de parametría (nuevo, a construir)" vertex="1">
          <mxGeometry height="580" width="320" x="420" y="560" as="geometry" />
        </mxCell>

        <mxCell id="wServicio" parent="w1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;" value="&lt;b&gt;Concesionario → Grupo de comisión&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Al seleccionar el concesionario, consulta la sección &lt;b&gt;9969&lt;/b&gt; (propuesta) replicada en T_CUGH_CONCESIONARIO.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;Nota: equivalente al &quot;1317&quot; del whiteboard de Sneider — mismo concepto, número definitivo pendiente de asignar en UMTA.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="440" y="600" as="geometry" />
        </mxCell>

        <mxCell id="wServicioNU" parent="w1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;" value="&lt;b&gt;Nuevo/Usado por subproducto&lt;/b&gt; &lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;— es una política, no un campo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Recibe el subproducto ya resuelto (ej. compra de cartera, compra instantánea) y consulta la sección &lt;b&gt;9971&lt;/b&gt; (respaldo dedicado) — puede sobrescribir lo que el cliente seleccionó en &quot;Estado&quot;.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;background:#FDF2E0;color:#B5760F;padding:2px&quot;&gt;Hallazgo: la sección 1314 YA tiene el atributo PLEDGESTATUS (NEW/USED) por subproducto — posible solape con 9971. Confirmar con Sneider/Negocio cuál de las dos usar, para no mantener la misma parametría en dos lados.&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="280" x="440" y="760" as="geometry" />
        </mxCell>

        <mxCell id="wServicioLTV" parent="w1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;" value="&lt;b&gt;Rangos vigentes de LTV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Tabla paramétrica nueva (propuesta, sección &lt;b&gt;9972&lt;/b&gt;) con los tramos oficiales actuales (ej. ≤70%/&amp;gt;70%), para que el Front muestre el corte correcto aunque cambie con el crecimiento del negocio.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;Distinto del catálogo automático de letras del batch (UGDTNRA 01-23): esto es la definición de negocio, no la traducción a letra.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="440" y="980" as="geometry" />
        </mxCell>

        <mxCell id="wEdgeConceServ" parent="w1" edge="1" source="wFieldConcesionario" target="wServicio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#B23A3A;fontFamily=Helvetica;fontSize=10;fontColor=#B23A3A;" value="al seleccionar">
