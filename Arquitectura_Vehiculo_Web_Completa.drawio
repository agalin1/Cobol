        <mxCell id="wCard9968" parent="w1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FDF2E0;strokeColor=#B5760F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;9968 — Prenda por subproducto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;ELEMENTO=subproducto · RESTO(1:1)=prenda+desc&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:8.5px;margin-top:4px;width:100%&quot;&gt;&lt;tr style=&quot;background:#B5760F;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;ELEM&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;3195&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;1 PRENDA AUTO NUEVO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;3280&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;3 SIN PRENDA NVO HIBR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;4086&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;2 PRENDA FGA USADO&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="260" x="800" y="306" as="geometry" />
        </mxCell>

        <mxCell id="wCard9969" parent="w1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FDF2E0;strokeColor=#B5760F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;9969 — NIT concesionario → Grupo&lt;/b&gt; &lt;font style=&quot;font-family:Helvetica;font-size:8px;color:#999999&quot;&gt;(≈1317 Sneider)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;ELEMENTO=NIT(11d) · RESTO(1:2)=grupo+(3:60)=nombre&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:8.5px;margin-top:4px;width:100%&quot;&gt;&lt;tr style=&quot;background:#B5760F;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;ELEM&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;0900123456&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;02 XYZ SAS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;0901654321&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;01 ABC LTDA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;DEFAULT&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;04&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="260" x="1080" y="306" as="geometry" />
        </mxCell>

        <mxCell id="wCard9970" parent="w1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FDF2E0;strokeColor=#B5760F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;9970 — Combustible por subproducto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;ELEMENTO=subproducto · RESTO(1:1)=combustible+desc&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:8.5px;margin-top:4px;width:100%&quot;&gt;&lt;tr style=&quot;background:#B5760F;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;ELEM&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;3195&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;1 GASOLINA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;3280&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;2 HIBRIDO/ELECTRICO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;4083&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;1 GASOLINA&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
