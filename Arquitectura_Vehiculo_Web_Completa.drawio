          <mxGeometry height="56" width="280" x="60" y="700" as="geometry" />
        </mxCell>

        <mxCell id="wFieldConcesionario" parent="w1" style="text;html=1;align=left;verticalAlign=top;" value="&lt;div style=&quot;font-size:10px;color:#B23A3A;font-weight:bold&quot;&gt;Concesionario &amp;#9679; NUEVO&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#182230;background:#FDEDED;border-bottom:2px solid #f3c9c9;padding:4px 0 8px 6px;margin-top:2px&quot;&gt;Selecciona tu concesionario &amp;#9662;&lt;/div&gt;" vertex="1">
          <mxGeometry height="56" width="280" x="60" y="762" as="geometry" />
        </mxCell>

        <mxCell id="wFieldGarantia" parent="w1" style="text;html=1;align=left;verticalAlign=top;" value="&lt;div style=&quot;font-size:10px;color:#B23A3A;font-weight:bold&quot;&gt;Garantía / Prenda &amp;#9679; NUEVO&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#8a94a3;margin-top:4px&quot;&gt;Diseño UX pendiente — hoy solo aparece como texto de marketing (&quot;con o sin prenda&quot;)&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#6B5CA5;margin-top:4px&quot;&gt;Se resuelve por tabla paramétrica (sección 9968) directo en HOST — no necesita resolverse antes en el Front/Oracle, a diferencia de Grupo, N/U y LTV.&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="280" x="60" y="824" as="geometry" />
        </mxCell>

        <mxCell id="wSendButton" parent="w1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1464A5;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;" value="Solicitar crédito" vertex="1">
