        <mxCell id="wLegend" parent="w1" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#5C6B7E;" value="&lt;b&gt;Notación:&lt;/b&gt; «component» = paso/transacción · cilindro = tabla · caja roja = campo/componente NUEVO a construir · caja ámbar = tabla HOST/DB2 · caja verde = capa Oracle/LRBA · caja morada = motor de tasa online.&amp;nbsp;&amp;nbsp;Fuente: &quot;simulación web1.png&quot;, &quot;imagen de sneider.png&quot; y &quot;capturaTablasparametricasHost-replica oracle.PNG&quot;." vertex="1">
