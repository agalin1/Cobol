        <mxCell id="wFieldValorNecesitas" parent="w1" style="text;html=1;align=left;verticalAlign=top;" value="&lt;div style=&quot;font-size:10px;color:#8a94a3&quot;&gt;Valor que necesitas&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#182230;border-bottom:2px solid #e3e6ea;padding:4px 0 6px 0;margin-top:2px&quot;&gt;$ 70.000.000&lt;/div&gt;&lt;div style=&quot;font-size:9px;color:#8a94a3;margin-top:4px&quot;&gt;Puedes solicitar desde $1.000.000 hasta $120.000.000&lt;/div&gt;" vertex="1">
