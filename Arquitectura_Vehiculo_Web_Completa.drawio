        <mxCell id="wFieldLTV" parent="w1" style="text;html=1;align=left;verticalAlign=top;" value="&lt;div style=&quot;font-size:10px;color:#8a94a3&quot;&gt;LTV — calculado automáticamente&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#B5760F;font-weight:bold;background:#FDF8EE;border-bottom:2px solid #FDF2E0;padding:4px 0 8px 6px;margin-top:2px&quot;&gt;58% &lt;span style=&quot;font-size:10px;font-weight:normal;color:#8a94a3&quot;&gt;(70.000.000 &amp;#247; 120.000.000)&lt;/span&gt;&lt;/div&gt;" vertex="1">
