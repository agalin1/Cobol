        <mxCell id="wCard9971" parent="w1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FDF2E0;strokeColor=#B5760F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;9971 — Nuevo/Usado por subproducto&lt;/b&gt; &lt;font style=&quot;font-family:Helvetica;font-size:8px;color:#999999&quot;&gt;(respaldo)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;Solo si el canal NO manda el valor directo. ELEMENTO=subproducto/flujo · RESTO(1:1)=N/U+desc&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:8.5px;margin-top:4px;width:100%&quot;&gt;&lt;tr style=&quot;background:#B5760F;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;ELEM&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;COMPRA_CARTERA&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;U SIEMPRE USADO (confirmado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;COMPRA_INSTANTANEA&lt;/td&gt;&lt;td style=&quot;padding:2px 4px;border-bottom:1px solid #eee&quot;&gt;N SIEMPRE NUEVO (confirmado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;¿otros?&lt;/td&gt;&lt;td style=&quot;padding:2px 4px&quot;&gt;pendiente confirmar&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
