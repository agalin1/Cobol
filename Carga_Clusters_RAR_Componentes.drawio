        <mxCell id="sec4Warn" parent="1" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;" value="&lt;font style=&quot;font-size:10px;color:#6B5CA5&quot;&gt;&lt;b&gt;Simulación documentada en UMTA&lt;/b&gt; — secciones 9968/9969/9970 &lt;b&gt;ilustrativas&lt;/b&gt;, pendientes de aprobación del líder. NO pertenecen a este batch: las consulta UG7CCNRA cuando el canal no envía el valor ya resuelto.&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="360" x="2040" y="684" as="geometry" />
        </mxCell>
