          <mxGeometry height="900" width="320" x="1660" y="444" as="geometry" />
        </mxCell>
        <mxCell id="t37" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FDF2E0;strokeColor=#B5760F;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" value="&lt;b&gt;UGDTT37 (DB2)&lt;/b&gt; &lt;i&gt;«tabla de parámetros»&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sección 9967 — Líneas habilitadas Modelo RAR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: rgb(92, 107, 126);&quot;&gt;ELEMENTO=código de línea · RESTO=indicador habilitado+desc.&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:9px;font-family:Courier New;margin-top:4px;width:100%&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background: rgb(181, 118, 15); color: rgb(255, 255, 255);&quot;&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;ELEM&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 2px 5px; border-bottom: 1px solid rgb(238, 238, 238);&quot;&gt;V&lt;/td&gt;&lt;td style=&quot;padding: 2px 5px; border-bottom: 1px solid rgb(238, 238, 238);&quot;&gt;1 VEHICULO HABILITADO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 2px 5px; border-bottom: 1px solid rgb(238, 238, 238);&quot;&gt;C&lt;/td&gt;&lt;td style=&quot;padding: 2px 5px; border-bottom: 1px solid rgb(238, 238, 238);&quot;&gt;1 CONSUMO HABILITADO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;L&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;1 LIBRANZA HABILITADO&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="280" x="1680" y="484" as="geometry" />
        </mxCell>
        <mxCell id="note9965" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCCCCC;dashed=1;align=left;verticalAlign=top;spacing=8;" value="&lt;font style=&quot;font-size:10px&quot;&gt;También existen &lt;b&gt;9965&lt;/b&gt; (colectivo libranza) y &lt;b&gt;9966&lt;/b&gt; (destino libranza), consultadas por este mismo paso UG4CRAR1 — aplican a Libranza (var. 16/17), &lt;b&gt;no a Vehículo&lt;/b&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="1680" y="804" as="geometry" />
        </mxCell>
        <mxCell id="tnra" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#FDF2E0;strokeColor=#B5760F;fontFamily=Courier New;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="UGDTNRA (DB2)&lt;br&gt;&lt;i&gt;«tabla de parámetros»&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reg 01-23: catálogo valor → letra (por línea)&lt;br&gt;&lt;br&gt;Reg 99: variables activas por línea&lt;br&gt;&lt;br&gt;Reg 90: CLAVE_ID (23) + TASA&lt;/font&gt;" vertex="1">
