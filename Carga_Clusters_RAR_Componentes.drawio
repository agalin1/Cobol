ona → Combustible&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Igualdad — REUTILIZADA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;20&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;RA&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Calificación rating&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Igualdad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#FDF2E0;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;21&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;PR&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Rango rating → Prenda&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Igualdad — REUTILIZADA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;22&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;GC&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Garantía comercial&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #ddd&quot;&gt;Igualdad (S/N)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;23&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;MO&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Monto operación comercial&lt;/td&gt;&lt;td style=&quot;padding:2px 6px&quot;&gt;Rango&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
