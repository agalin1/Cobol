        <mxCell id="table9969box" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F3F0FA;strokeColor=#6B5CA5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" value="&lt;b&gt;9969 — NIT concesionario → Grupo comisión&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;ELEMENTO = NIT (10 díg.) · RESTO (1:2)=grupo + (3:60)=nombre&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:9px;font-family:Courier New;margin-top:6px;width:100%&quot;&gt;&lt;tr style=&quot;background:#6B5CA5;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;ELEMENTO&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;0900123456&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;02 CONCESIONARIO XYZ SAS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;0901654321&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;01 CONCESIONARIO ABC LTDA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;DEFAULT&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;04&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="360" x="2040" y="854" as="geometry" />
        </mxCell>
        <mxCell id="table9968box" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F3F0FA;strokeColor=#6B5CA5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" value="&lt;b&gt;9968 — Prenda por subproducto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;ELEMENTO = subproducto · RESTO (1:1)=prenda + descripción&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:9px;font-family:Courier New;margin-top:6px;width:100%&quot;&gt;&lt;tr style=&quot;background:#6B5CA5;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;ELEMENTO&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;3195&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;1 PRENDA AUTO NUEVO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;3280&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;3 SIN PRENDA AUTO NUEVO HIBRIDO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;4086&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;2 PRENDA FGA AUTO USADO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;4115&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;4 OTRA GARANTIA HIBRIDO&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="360" x="2040" y="1054" as="geometry" />
        </mxCell>
        <mxCell id="table9970box" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F3F0FA;strokeColor=#6B5CA5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" value="&lt;b&gt;9970 — Combustible por subproducto (respaldo)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;ELEMENTO = subproducto · RESTO (1:1)=combustible + descripción&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:9px;font-family:Courier New;margin-top:6px;width:100%&quot;&gt;&lt;tr style=&quot;background:#6B5CA5;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;ELEMENTO&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;3195&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;1 GASOLINA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;3280&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;2 HIBRIDO/ELECTRICO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;4115&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;2 HIBRIDO/ELECTRICO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;4083&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;1 GASOLINA&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="190" width="360" x="2040" y="1254" as="geometry" />
        </mxCell>
        <mxCell id="table9971box" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F3F0FA;strokeColor=#6B5CA5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" value="&lt;b&gt;9971 — Nuevo/Usado por subproducto (respaldo)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;Solo si el canal NO manda el valor directo · ELEMENTO = subproducto/flujo · RESTO (1:1) = N/U + descripción&lt;/font&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:9px;font-family:Courier New;margin-top:6px;width:100%&quot;&gt;&lt;tr style=&quot;background:#6B5CA5;color:#fff&quot;&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;ELEMENTO&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;RESTO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;COMPRA_CARTERA&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;U SIEMPRE USADO (confirmado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;COMPRA_INSTANTANEA&lt;/td&gt;&lt;td style=&quot;padding:2px 5px;border-bottom:1px solid #eee&quot;&gt;N SIEMPRE NUEVO (confirmado)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;¿otros subproductos?&lt;/td&gt;&lt;td style=&quot;padding:2px 5px&quot;&gt;pendiente confirmar con Negocio&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#999999&quot;&gt;cobertura mínima garantizada: los 2 flujos especiales ya confirmados&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="2040" y="1464" as="geometry" />
        </mxCell>
