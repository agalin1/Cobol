<mxfile host="app.diagrams.net" agent="Claude Code">
  <diagram name="Escenario 1 - Oracle Nativo" id="escenario1-oracle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="o0" />
        <mxCell id="o1" parent="o0" />

        <mxCell id="oTitle" parent="o1" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;" value="Escenario 1 — Parametría Oracle Nativa (independiente de HOST) — SDA 56742" vertex="1">
          <mxGeometry height="28" width="1500" x="20" y="6" as="geometry" />
        </mxCell>
        <mxCell id="oLegend" parent="o1" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#5C6B7E;" value="&lt;b&gt;Notación:&lt;/b&gt; verde = Oracle/digital (fuente de verdad en este escenario) · ámbar = HOST/DB2 (sin cambios) · gris punteado = hipótesis sin confirmar · caja roja = pregunta abierta / riesgo." vertex="1">
          <mxGeometry height="22" width="1500" x="20" y="36" as="geometry" />
        </mxCell>

        <!-- ===================== EVALUACION DE NEGOCIO ===================== -->
        <mxCell id="oBizBox" parent="o1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDED;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;" value="&lt;b&gt;Evaluación de negocio (fuente: imagen de los dos escenarios, equipo de Arquitectura):&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;Camino MÁS LENTO: 1.5 a 2 meses. Requiere aprobaciones corporativas, incluyendo instancias en el exterior. Alto riesgo de retrasos.&lt;br&gt;Requiere definir desde cero: volumetría, políticas de respaldo/purga, y gestión ABM (alta/baja/modificación) manual o por scripts — hoy no existe ningún mecanismo de mantenimiento para una tabla Oracle nativa de este tipo.&lt;br&gt;&lt;b&gt;Impacto en Pricing: mayor costo y tiempos de salida prolongados.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="1300" x="20" y="64" as="geometry" />
        </mxCell>

        <!-- ===================== CANALES ===================== -->
        <mxCell id="oPkgWeb" parent="o1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=8;spacingTop=6;tabWidth=200;tabHeight=22;tabPosition=left;" value="Web Vehículo — tiene APX" vertex="1">
          <mxGeometry height="130" width="340" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="oWebFront" parent="o1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;" value="Front simulador — selecciona concesionario por NOMBRE. Hoy NO transporta Grupo ni LTV (ver Estado Actual)." vertex="1">
          <mxGeometry height="85" width="310" x="35" y="255" as="geometry" />
        </mxCell>

        <mxCell id="oPkgCap" parent="o1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=8;spacingTop=6;tabWidth=200;tabHeight=22;tabPosition=left;" value="CAP — tiene APX" vertex="1">
          <mxGeometry height="130" width="340" x="20" y="370" as="geometry" />
        </mxCell>
        <mxCell id="oCapFront" parent="o1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;" value="App CAP (Spring MVC/JSP) — ya tiene DTO de concesionario (NIT/nombre). Cambio: consultar Grupo vía APX ANTES del Scoring, no después (hoy se captura en Radicación, post-scoring)." vertex="1">
          <mxGeometry height="85" width="310" x="35" y="405" as="geometry" />
        </mxCell>

        <mxCell id="oPkgNacar" parent="o1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#F2F2F2;strokeColor=#808080;align=left;spacingLeft=8;spacingTop=6;tabWidth=200;tabHeight=22;tabPosition=left;" value="Nácar — NO tiene APX" vertex="1">
          <mxGeometry height="150" width="340" x="20" y="520" as="geometry" />
        </mxCell>
        <mxCell id="oNacarFront" parent="o1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#808080;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;" value="Transacción 371 ya resuelve Garantía/Combustible. Necesita camino propio a Oracle para Grupo y LTV (%).&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#B23A3A&quot;&gt;⚠ HIPÓTESIS - sin confirmar con el equipo de Nácar.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="310" x="35" y="555" as="geometry" />
        </mxCell>

        <mxCell id="oPkgApi" parent="o1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=8;spacingTop=6;tabWidth=200;tabHeight=22;tabPosition=left;" value="APIs / Inchcape — tiene APX (ASO)" vertex="1">
          <mxGeometry height="150" width="340" x="20" y="690" as="geometry" />
        </mxCell>
        <mxCell id="oApiFront" parent="o1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;" value="CPOVT001-006/CPOVR001-006 (ASO) → CUGHR000/101/103/107/108 (handlers). Hoy las 4 operaciones (CUGHTO01/03/04, CUGHTS02) no transportan Grupo/Concesionario." vertex="1">
          <mxGeometry height="105" width="310" x="35" y="725" as="geometry" />
        </mxCell>

        <!-- ===================== SERVICIO DE RESOLUCION ===================== -->
        <mxCell id="oPkgServ" parent="o1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#FDEDED;strokeColor=#B23A3A;align=left;spacingLeft=8;spacingTop=6;tabWidth=300;tabHeight=22;tabPosition=left;" value="Servicio de resolución (nuevo, compartido)" vertex="1">
          <mxGeometry height="420" width="340" x="420" y="220" as="geometry" />
        </mxCell>
        <mxCell id="oServicio" parent="o1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=10.5;" value="&lt;b&gt;Resuelve Concesionario → Grupo (1-6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Web busca por NOMBRE, CAP/APIs por NIT. Lookup directo, sin desempate por marca (mecanismo Inchcape ya retirado).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;Grupo 5 (canales directos) y Grupo 6 (Compra Cartera) se asignan por tipo de operación, sin buscar concesionario.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="435" y="260" as="geometry" />
        </mxCell>
        <mxCell id="oServicioLTV" parent="o1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=10.5;" value="&lt;b&gt;Resuelve Garantía (4 cat.) y LTV (rangos)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Homologa Garantía: Prenda/Sin prenda/Otros (Prenda FGA fuera de fase). LTV: trae el corte vigente (≤70.5%/&amp;gt;70.5%) para los canales que hoy no lo tienen (Nácar, Web).&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="310" x="435" y="430" as="geometry" />
        </mxCell>
        <mxCell id="oServicioComb" parent="o1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=10.5;" value="&lt;b&gt;Resuelve Combustible (3 cat.) y N/U&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Homologa Gasolina/Híbrido-Eléctrico/Otros, agregando la opción faltante en CAP/APIs. N/U ya funciona en los 3 canales - se replica igual.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="435" y="590" as="geometry" />
        </mxCell>

        <!-- ===================== ORACLE NATIVO ===================== -->
        <mxCell id="oPkgOracle" parent="o1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=10;spacingTop=6;tabWidth=360;tabHeight=24;tabPosition=left;" value="Oracle — parametría NATIVA, una tabla por variable (fuente de verdad)" vertex="1">
          <mxGeometry height="570" width="420" x="820" y="220" as="geometry" />
        </mxCell>
        <mxCell id="oTGrupo" parent="o1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;T_GRUPO_CONCESIONARIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;NIT · NOMBRE · GRUPO (1-6)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="370" x="840" y="260" as="geometry" />
        </mxCell>
        <mxCell id="oTGarantia" parent="o1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;T_GARANTIA_SUBPRODUCTO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;SUBPRODUCTO · GARANTIA (Prenda/Sin prenda/Otros)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="370" x="840" y="350" as="geometry" />
        </mxCell>
        <mxCell id="oTCombustible" parent="o1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;T_COMBUSTIBLE_SUBPRODUCTO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;SUBPRODUCTO · COMBUSTIBLE (Gasolina/Híbrido-Eléctrico/Otros)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="370" x="840" y="440" as="geometry" />
        </mxCell>
        <mxCell id="oTNU" parent="o1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;T_ESTADO_VEHICULO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;SUBPRODUCTO/FLUJO · N/U&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="370" x="840" y="530" as="geometry" />
        </mxCell>
        <mxCell id="oTLTV" parent="o1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontFamily=Courier New;fontSize=10;" value="&lt;b&gt;T_RANGO_LTV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;font-family:Helvetica;color:#5c6b7e&quot;&gt;TRAMO · RANGO (≤70.5% / &amp;gt;70.5%)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="370" x="840" y="620" as="geometry" />
        </mxCell>
        <mxCell id="oOracleMant" parent="o1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDED;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;" value="&lt;b&gt;⚠ Sin mecanismo de mantenimiento:&lt;/b&gt; no existe pantalla ni API de administración para estas 5 tablas. Negocio no tiene hoy dónde crear/editar un concesionario, un subproducto nuevo, etc." vertex="1">
          <mxGeometry height="70" width="370" x="840" y="710" as="geometry" />
        </mxCell>

