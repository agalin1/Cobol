          <mxGeometry height="90" width="300" x="1640" y="530" as="geometry" />
        </mxCell>
        <mxCell id="oBatch" parent="o1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=9.5;" value="&lt;b&gt;Batch (PUGDIA04...UG4CRAR1/2) sin cambios&lt;/b&gt; - el catálogo de clúster/letras se alimenta del archivo de Rentabilidad, no de estas tablas Oracle." vertex="1">
