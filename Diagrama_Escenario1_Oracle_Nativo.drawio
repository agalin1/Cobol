        </mxCell>
        <mxCell id="oUG7" parent="o1" style="html=1;shape=component;align=center;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#6B5CA5;spacingLeft=14;" value="UG7CCNRA&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;motor de tasa - solo lectura&lt;/font&gt;" vertex="1">
