          <mxGeometry height="480" width="520" x="1620" y="220" as="geometry" />
        </mxCell>
        <mxCell id="oUR7" parent="o1" style="html=1;shape=component;align=center;verticalAlign=middle;fontFamily=Courier New;fontSize=11;fontStyle=1;fillColor=#FFFFFF;strokeColor=#182230;spacingLeft=14;" value="UR7CCRAR&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;commarea UGWCRAR&lt;/font&gt;" vertex="1">
