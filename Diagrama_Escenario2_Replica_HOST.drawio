<mxfile host="app.diagrams.net" agent="Claude Code">
  <diagram name="Escenario 2 - Replica HOST" id="escenario2-host">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="h0" />
        <mxCell id="h1" parent="h0" />

        <mxCell id="hTitle" parent="h1" style="text;html=1;fontSize=18;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;" value="Escenario 2 — Parametría en HOST, replicada vía UMTA / LRBA / Control-M — SDA 56742" vertex="1">
          <mxGeometry height="28" width="1600" x="20" y="6" as="geometry" />
        </mxCell>
        <mxCell id="hLegend" parent="h1" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#5C6B7E;" value="&lt;b&gt;Notación:&lt;/b&gt; ámbar = HOST/DB2 (fuente de verdad en este escenario) · verde = Oracle/digital (espejo de solo lectura) · gris punteado = hipótesis sin confirmar." vertex="1">
          <mxGeometry height="22" width="1500" x="20" y="36" as="geometry" />
        </mxCell>

        <!-- ===================== EVALUACION DE NEGOCIO ===================== -->
        <mxCell id="hBizBox" parent="h1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;" value="&lt;b&gt;Evaluación de negocio (fuente: imagen de los dos escenarios, equipo de Arquitectura):&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;Camino MÁS ÁGIL: reutiliza infraestructura existente — mismo modelo ya usado para Vehículo Web (UMTA, T37, LRBA, Control-M), sin crear componentes desde cero.&lt;br&gt;Riesgo principal: sincronización por lotes/batch desde HOST — hay que coordinar validaciones con Arquitectura para la ventana de actualización.&lt;br&gt;&lt;b&gt;Impacto en Pricing: eficiencia de costos y tiempos de salida reducidos.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="1300" x="20" y="64" as="geometry" />
        </mxCell>

        <!-- ===================== CANALES ===================== -->
        <mxCell id="hPkgWeb" parent="h1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=8;spacingTop=6;tabWidth=200;tabHeight=22;tabPosition=left;" value="Web Vehículo — tiene APX" vertex="1">
          <mxGeometry height="130" width="340" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="hWebFront" parent="h1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D6B;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10;" value="Front simulador — selecciona concesionario por NOMBRE. Hoy NO transporta Grupo ni LTV (ver Estado Actual)." vertex="1">
          <mxGeometry height="85" width="310" x="35" y="255" as="geometry" />
        </mxCell>

        <mxCell id="hPkgCap" parent="h1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=8;spacingTop=6;tabWidth=200;tabHeight=22;tabPosition=left;" value="CAP — tiene APX" vertex="1">
