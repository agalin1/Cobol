        <mxCell id="aPkgNacar" parent="a1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#F2F2F2;strokeColor=#808080;align=left;spacingLeft=10;spacingTop=6;tabWidth=160;tabHeight=24;tabPosition=left;" value="Nácar — hoy" vertex="1">
