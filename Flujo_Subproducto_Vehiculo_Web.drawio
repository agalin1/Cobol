        <mxCell id="sConceServicio" parent="s1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A3A;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=10.5;" value="&lt;b&gt;Servicio: Concesionario → Grupo&lt;/b&gt; &lt;font style=&quot;font-size:9px;color:#5c6b7e&quot;&gt;(nuevo, a construir)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot;&gt;Al ④ seleccionar &quot;Autoland S.A.S.&quot;, consulta la tabla de la derecha y resuelve el grupo — el cliente nunca ve el grupo en pantalla, solo viaja con el resto del payload.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="60" y="936" as="geometry" />
        </mxCell>

