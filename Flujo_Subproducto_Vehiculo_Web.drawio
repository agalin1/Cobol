        <mxCell id="sMatrizBox" parent="s1" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D6B;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="Matriz de Perfilado Sub Producto&lt;br&gt;&lt;font style=&quot;font-size:9.5px;font-weight:normal;color:#5c6b7e&quot;&gt;decide cuál subproducto aplica, ANTES de llamar a HOST&lt;/font&gt;" vertex="1">
