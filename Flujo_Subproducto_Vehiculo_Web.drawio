  <diagram name="Flujo Subproducto Vehiculo Web" id="flujo-subproducto-web">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2780" pageHeight="1380" math="0" shadow="0">
      <root>
