        <mxCell id="sFieldConceA" parent="s1" style="text;html=1;align=left;verticalAlign=top;" value="&lt;div style=&quot;font-size:10px;color:#B23A3A;font-weight:bold&quot;&gt;Concesionario &amp;#9679; NUEVO&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#182230;background:#FDEDED;border-bottom:2px solid #f3c9c9;padding:3px 0 6px 6px;margin-top:2px&quot;&gt;Autoland S.A.S.&lt;/div&gt;" vertex="1">
