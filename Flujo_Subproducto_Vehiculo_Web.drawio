        <mxCell id="sConceFlowCaption" parent="s1" style="text;html=1;fontSize=11;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#182230;" value="¿De dónde sale la lista y el Grupo de &quot;Concesionario&quot;?" vertex="1">
