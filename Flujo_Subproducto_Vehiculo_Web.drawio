        <!-- ===================== B: MATRIZ DE PERFILADO (HIPOTESIS) ===================== -->
        <mxCell id="sPkgB" parent="s1" style="shape=folder;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EAF5F2;strokeColor=#2E7D6B;align=left;spacingLeft=8;spacingTop=6;tabWidth=420;tabHeight=22;tabPosition=left;dashed=1;" value="Matriz de Perfilado Sub Producto — hipótesis, NO confirmada en código" vertex="1">
