        <mxCell id="sTitle" parent="s1" style="text;html=1;fontSize=17;fontStyle=1;fontFamily=Helvetica;align=left;verticalAlign=middle;" value="¿Cómo viaja la Web a los subproductos de Vehículo y trae la información? — SDA 56742" vertex="1">
          <mxGeometry height="26" width="1700" x="20" y="6" as="geometry" />
        </mxCell>
        <mxCell id="sLegend" parent="s1" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#5C6B7E;" value="&lt;b&gt;Notación:&lt;/b&gt; caja gris = dato de entrada (Front) · borde verde punteado = &lt;b&gt;hipótesis&lt;/b&gt;, NO confirmado en código · borde ámbar sólido = &lt;b&gt;confirmado en código&lt;/b&gt; (grep sobre UR7CCRAR.cbl) · caja con fondo claro = ejemplo trabajado, con datos reales." vertex="1">
          <mxGeometry height="32" width="2200" x="20" y="36" as="geometry" />
        </mxCell>
        <mxCell id="sSeqLegend" parent="s1" style="text;html=1;fontSize=10.5;fontFamily=Helvetica;align=left;verticalAlign=middle;fontColor=#182230;" value="&lt;b&gt;Orden en el tiempo:&lt;/b&gt; ① carga lista de concesionarios &amp;#183; ② cliente diligencia perfil &amp;#183; ③ se muestra si va con prenda obligatoria &amp;#183; ④ cliente elige concesionario → resuelve grupo &amp;#183; ⑤ clic &quot;Solicitar crédito&quot; &amp;#183; ⑥ HOST confirma el subproducto" vertex="1">
          <mxGeometry height="20" width="2720" x="20" y="68" as="geometry" />
        </mxCell>

