           INITIALIZE                       UGTCANT
           MOVE MAE-ENTIOFI        TO       ANT-ENTIOFI
           MOVE MAE-CUENTA         TO       ANT-CUENTA

           EXEC SQL
                SELECT SUM(ANT_VALOR_ANT)
                INTO :ANT-VALOR-ANT
                FROM UGDTANT
                WHERE ANT_ENTIOFI =: ANT-ENTIOFI
                AND   ANT_CUENTA  =: ANT-CUENTA
                AND   ANT_ESTADO_ANT = 'F'
           END-EXEC

           MOVE SQLCODE                  TO DB2-RETURN-CDE
           IF DB2-OK
              CONTINUE
           ELSE
              IF DB2-NOTFND OR DB2-305
                 MOVE ZEROES            TO ANT-VALOR-ANT
              ELSE
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                 MOVE 'SELECT SUM  UGDTANT ' TO CAA-VAR1-ERROR
                 MOVE DB2-RETURN-CDE         TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.

