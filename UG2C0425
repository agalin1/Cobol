      ******************************************************************08293502
      *                  24B6-VERIF-COHERENCIA-DEUDA                   *08293602
      * - Verifica que el valor digitado corresponda a total de la     *
      *   en caso de no constructor y que no exceda el capital en el   *
      *   caso de constructor                                          *
      ******************************************************************08293902
       24B6-VERIF-COHERENCIA-DEUDA.
            MOVE  1                              TO WS-N
            PERFORM VARYING WS-N FROM 1 BY 1 UNTIL WS-N > 5
              IF WS-IDENT-VIN(WS-N) NOT = SPACES
                 IF WS-TIPO-VIN(WS-N) = 'O'
                    IF WS-VR-DIGITADO(WS-N) = WS-DEUDA-REAL(WS-N)
                       CONTINUE
                    ELSE
                       MOVE WS-DEUDA-REAL(WS-N) TO WS-DEUDA-REAL-NUM
                       MOVE 'UGE0939'               TO CAA-COD-ERROR
                       MOVE WS-CCC-VIN(WS-N)(5:14)
                                                TO CAA-VAR1-ERROR(1:14)
                       MOVE ' VR.ES'            TO CAA-VAR1-ERROR(15:6)
                       MOVE WS-DEUDA-REAL-ALF   TO CAA-VAR2-ERROR
                       PERFORM 3-FINAL-PROGRAMA
                    END-IF
                 ELSE
                   IF WS-VR-DIGITADO(WS-N)< WS-SALTEOR-VIN(WS-N)
                      CONTINUE
                   ELSE
                       MOVE 'UGE0939'               TO CAA-COD-ERROR
                       MOVE WS-CCC-VIN(WS-N)        TO CAA-VAR1-ERROR
                       MOVE 'VR EXCEDE CAP SUBRRG'  TO CAA-VAR2-ERROR
                       PERFORM 3-FINAL-PROGRAMA
                   END-IF
                 END-IF
              END-IF
            END-PERFORM.

      ******************************************************************
      *                  24B7-CALCULAR-TOTAL-DEUDA                     *
      * - Se calcula el valor total de la deuda a cancelar por cada    *
      *   Contrato vinculado vr-digitado + vr-gmf-dig                  *
      ******************************************************************
       24B7-CALCULAR-TOTAL-DEUDA.
            MOVE  1                              TO WS-N
            PERFORM VARYING WS-N FROM 1 BY 1 UNTIL WS-N > 5
              IF WS-IDENT-VIN(WS-N) NOT = SPACES
                 IF WS-TIPO-VIN(WS-N) = 'O'
                   COMPUTE WS-VR-TTAL-CAN(WS-N) = WS-DEUDA-REAL(WS-N)
                                                + WS-VR-GMF-DIG(WS-N)
                 ELSE
                   COMPUTE WS-VR-TTAL-CAN(WS-N) = WS-VR-DIGITADO(WS-N)
                                                + WS-VR-GMF-DIG(WS-N)
                 END-IF
              END-IF
            END-PERFORM.

      ******************************************************************
      *                  24B8-CALC-TOTAL-DEUDA-PROV                    *
      * - Se calcula el valor total de la deuda a cancelar por cada    *
      *   proveedor vinculado  vr-digitado + vr-gmf-dig                *
      ******************************************************************
       24B8-CALC-TOTAL-DEUDA-PROV.
            MOVE ZEROS                     TO WS-VR-ACUM-VIN1
                                              WS-VR-ACUM-VIN2
                                              WS-VR-ACUM-VIN3
                                              WS-VR-ACUM-VIN4
                                              WS-VR-CONT-VIN1
                                              WS-VR-CONT-VIN2
                                              WS-VR-CONT-VIN3
                                              WS-VR-CONT-VIN4
            MOVE  1                        TO WS-N
            PERFORM VARYING WS-N FROM 1 BY 1 UNTIL WS-N > 5
              IF WS-IDENT-VIN(WS-N) NOT = SPACES
                 EVALUATE WS-IDENT-PROV(WS-N)
                   WHEN G425-IDPRO1
                     IF WS-TIPO-VIN(WS-N) = 'O'
                        COMPUTE WS-VR-ACUM-VIN1 = WS-VR-ACUM-VIN1 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     ELSE
                        COMPUTE WS-VR-CONT-VIN1 = WS-VR-CONT-VIN1 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     END-IF
                   WHEN G425-IDPRO2
                     IF WS-TIPO-VIN(WS-N) = 'O'
                        COMPUTE WS-VR-ACUM-VIN2 = WS-VR-ACUM-VIN2 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     ELSE
                        COMPUTE WS-VR-CONT-VIN2 = WS-VR-CONT-VIN2 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     END-IF
                   WHEN G425-IDPRO3
                     IF WS-TIPO-VIN(WS-N) = 'O'
                        COMPUTE WS-VR-ACUM-VIN3 = WS-VR-ACUM-VIN3 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     ELSE
                        COMPUTE WS-VR-CONT-VIN3 = WS-VR-CONT-VIN3 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     END-IF
                   WHEN G425-IDPRO4
                     IF WS-TIPO-VIN(WS-N) = 'O'
                        COMPUTE WS-VR-ACUM-VIN4 = WS-VR-ACUM-VIN4 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     ELSE
                        COMPUTE WS-VR-CONT-VIN4 = WS-VR-CONT-VIN4 +
                                                  WS-VR-TTAL-CAN(WS-N)
                     END-IF
                   WHEN OTHER
                       MOVE 'UGE0939'               TO CAA-COD-ERROR
                       MOVE WS-IDENT-PROV(WS-N)     TO CAA-VAR1-ERROR
                       MOVE 'ID NO ES PROVEEDOR  '  TO CAA-VAR2-ERROR
                       PERFORM 3-FINAL-PROGRAMA
                 END-EVALUATE
              END-IF
            END-PERFORM.

