           MOVE MAE-ENTIOFI                   TO ANT-ENTIOFI
           MOVE MAE-CUENTA                    TO ANT-CUENTA

           EXEC SQL
               SELECT MIN(ANT_FECHA_ALTA)
                 INTO :ANT-FECHA-ALTA:WS-IND-NULL
                 FROM UGDTANT
                WHERE ANT_ENTIOFI = :ANT-ENTIOFI
                  AND ANT_CUENTA  = :ANT-CUENTA
           END-EXEC.

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK
              IF WS-IND-NULL LESS THAN ZEROS
                 MOVE '0001-01-01'            TO ANT-FECHA-ALTA
              END-IF
              IF ANT-FECHA-ALTA = SPACES OR LOW-VALUES
                 MOVE '0001-01-01'            TO ANT-FECHA-ALTA
              END-IF
           ELSE
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'SELECT TABLA UGDTANT'  TO CAA-VAR1-ERROR
                 MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR

                 PERFORM 3-FINAL-PROGRAMA
