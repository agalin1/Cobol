      *COL01-I                                                          12471001
      ******************************************************************12472001
      *                    26A-PROC-CANCEL-ANTICI                      *
      * Se realiza la cancelaci├│n anticipada de los creditos vinculados*12473001
      * y la subrogacion de los mismos                                 *12473001
      ******************************************************************12474001
       26A-PROC-CANCEL-ANTICI.
           PERFORM 26A1-CANCELA-OTROS-CRED                              12475001
           PERFORM 26A2-CANCELA-CONTRUCTOR.

      ******************************************************************12472001
      *                   26A1-CANCELA-OTROS-CRED                      *
      * Se realiza la cancelacion de los contratos vinculados a cada   *12473001
      * uno de los proveedores - Llamado a la rutina UR2C0190          *12473001
      ******************************************************************12474001
       26A1-CANCELA-OTROS-CRED.

            MOVE 1                      TO WS-N
            PERFORM VARYING WS-N FROM 1 BY 1 UNTIL WS-N > 5
                    OR WS-ENTIOFI-VIN(WS-N) = SPACES OR LOW-VALUES
              IF WS-TIPO-VIN(WS-N) = 'O'
                 INITIALIZE                       UGWC190
                 MOVE WS-ENTIOFI-VIN(WS-N)     TO W19-CCC(1:8)
                 MOVE '00'                     TO W19-CCC(9:2)
                 MOVE WS-CUENTA-VIN(WS-N)      TO W19-CCC(11:10)
                 MOVE WS-DEUDA-REAL(WS-N)      TO W19-IMPORTE
                 MOVE SPACES                   TO W19-CCCARGO
                 MOVE 'T'                      TO W19-CAJA
                 MOVE CAA-FECHA-CONTED(7:4)    TO W19-FEVALOR(1:4)
                 MOVE CAA-FECHA-CONTED(4:2)    TO W19-FEVALOR(6:2)
                 MOVE CAA-FECHA-CONTED(1:2)    TO W19-FEVALOR(9:2)
                 MOVE '-'                      TO W19-FEVALOR(5:1)
                                                  W19-FEVALOR(8:1)
                 MOVE SPACES                   TO W19-COMISIO
CEY              IF WS-N = 1
      *             si es primer vez se envia ind para borrar cola
                    MOVE 'P'                   TO W19-FORCALCU
                 ELSE
                    MOVE SPACES                TO W19-FORCALCU
CEY              END-IF
                 MOVE 'S'                      TO W19-EXOCOMIS
                 MOVE '1'                      TO W19-TIPCANCE
                                                  W19-INDRECU
                                                  W19-OPCION
                 MOVE CAA-TERMINAL-CONT        TO W19-TERMINAL
                 MOVE CAA-CENTRO-CONT          TO W19-CENTRO-CONT
                 MOVE CAA-USERID               TO W19-USERID
                 MOVE CAA-CODTRAN              TO W19-CODTRAN
                 MOVE CAA-HORA-TRANS           TO W19-HORA-TRANS
                 MOVE CAA-NETNAME              TO W19-NETNAME

                 EXEC CICS
                     LINK PROGRAM  ('UR2C0190')
                     COMMAREA (UGWC190)
                     NOHANDLE
                 END-EXEC

                 EVALUATE W19-COD-RET
                    WHEN '00'
                       CONTINUE
                    WHEN OTHER
                       MOVE W19-COD-ERROR           TO CAA-COD-ERROR
                       MOVE W19-VAR1-ERR            TO CAA-VAR1-ERROR
                       MOVE W19-VAR2-ERR            TO CAA-VAR2-ERROR
                       SET ERROR-GRAVE              TO TRUE
                       PERFORM 3-FINAL-PROGRAMA
                 END-EVALUATE
               END-IF
            END-PERFORM.

      ******************************************************************12472001
      *                   26A2-CANCELA-CONTRUCTOR                      *
      * Se realiza la subrogacion a los  contratos vinculados          *12473001
      ******************************************************************12474001
       26A2-CANCELA-CONTRUCTOR.
            MOVE 1                      TO WS-N
            PERFORM VARYING WS-N FROM 1 BY 1 UNTIL WS-N > 5
                   OR WS-ENTIOFI-VIN(WS-N) = SPACES OR LOW-VALUES
              IF WS-TIPO-VIN(WS-N) = 'C'
                 INITIALIZE                         UGWCSCC1
                 MOVE WS-ENTIOFI-VIN(WS-N)       TO SCC1-CCC-ENTIOFI
                 MOVE WS-CUENTA-VIN(WS-N)        TO SCC1-CCC-CUENTA
                 MOVE G425-OBLASO                TO SCC1-CCCCARGO
                 MOVE WS-VR-DIGITADO(WS-N)       TO SCC1-IMPORTE-PAGO
                 MOVE 'P'                        TO SCC1-OPCION
                 MOVE CAA-FECHA-OPER2            TO SCC1-FECHA-OPER
                 MOVE '1'                        TO SCC1-INDRECU
                 MOVE CAA-ENTIDAD                TO SCC1-ENTIDAD-CONT
                 MOVE CAA-CENTRO-CONT            TO SCC1-CENTRO-CONT
                 MOVE CAA-TERMINAL               TO SCC1-TERMINAL
                 MOVE CAA-USERID                 TO SCC1-USUARIO
                 MOVE CAA-FECHA-CONT2            TO SCC1-FECHA-CONT2
                 MOVE CAA-CODTRAN                TO SCC1-CODTRAN
                 MOVE CAA-HORA-TRANSED           TO SCC1-HORA-TRANSED
                 MOVE CAA-NETNAME                TO SCC1-NETNAME
                 MOVE CAA-TIPO-PROCESO           TO SCC1-TIPO-PROCESO
                 MOVE CAA-TERMINAL-CONT          TO SCC1-TERMINAL-CONT
                 MOVE 'AC'                       TO SCC1-TIPO-PAGO
                 MOVE 'ABONO POR COMPRA DE BIEN' TO SCC1-DESCRIP-PAGO
                 MOVE 'COP'                      TO SCC1-DIVISA
                 MOVE 'TF'                       TO SCC1-CANAL
                 MOVE 'SR'                       TO SCC1-MODO-PAGO
CEY              IF WS-N = 1
      *             si es primer vez se envia ind para borrar cola
                    MOVE 'P'                TO SCC1-RET-CODIGO(1:1)
                 ELSE
                    MOVE '00'               TO SCC1-RET-CODIGO
CEY              END-IF

                 EXEC CICS
                     LINK PROGRAM  (WS-UR2CSCC1)
                     COMMAREA (UGWCSCC1)
                     NOHANDLE
                 END-EXEC

                 EVALUATE SCC1-RET-CODIGO
                  WHEN '00'
                  WHEN SPACES
                       CONTINUE
                  WHEN '10'
                  WHEN '50'
                       MOVE 'UGE0939'             TO CAA-COD-ERROR
                       MOVE SCC1-RET-VAR1-ERROR   TO CAA-VAR1-ERROR
                       MOVE SCC1-RET-VAR2-ERROR   TO CAA-VAR2-ERROR
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                  WHEN '99'
                       MOVE 'UGE0939'            TO CAA-COD-ERROR
                       MOVE 'UR2CSCC1 CODE    '  TO CAA-VAR1-ERROR
                       MOVE SCC1-RET-SQLCODE     TO CAA-VAR1-ERROR(15:3)3)
                       MOVE SCC1-RET-VAR1-ERROR  TO CAA-VAR2-ERROR
                       MOVE SCC1-RET-SQLERRM     TO SQLERRM
                       MOVE 'UR2CSCC1'           TO CAA-OBJETO-ERROR
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                  WHEN OTHER
                       MOVE 'UGE0939'             TO CAA-COD-ERROR
                       MOVE SCC1-RET-VAR1-ERROR   TO CAA-VAR1-ERROR
                       MOVE SCC1-RET-VAR2-ERROR   TO CAA-VAR2-ERROR
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                 END-EVALUATE
              END-IF
            END-PERFORM.

      *COL01-F                                                          12479201
      *                                                                 12480001
      *@COL03-I
      ******************************************************************
      *                216-VALIDA-LEASING                              *
      *----------------------------------------------------------------*
      *   VALIDA QUE EL SUBPRODUCTO SEA DE LEASING                     *
      *                                                                *
      ******************************************************************
       216-VALIDA-LEASING.

           INITIALIZE UGTCT37
           SET NO-SUBPRO-LEASING-LHSP         TO TRUE.
           MOVE MAE-SUBPRO                    TO T37-ELEMENTO
           MOVE '1252'                        TO T37-SECCION

           EXEC SQL
               SELECT
                      SECCION ,
                      ELEMENTO
                 INTO
                      :T37-SECCION ,
                      :T37-ELEMENTO
                  FROM UGDTT37
                 WHERE SECCION    = :T37-SECCION
                   AND ELEMENTO   = :T37-ELEMENTO
           END-EXEC.
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK
              SET SI-SUBPRO-LEASING-LHSP      TO TRUE
      *
              IF G425-SUBPRO IS NOT NUMERIC
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                 MOVE 'CAMPO SUBPRODUCTO   ' TO CAA-VAR1-ERROR
                 MOVE 'DEBE INFORMARSE.    ' TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           ELSE
              IF DB2-NOTFND
                 SET NO-SUBPRO-LEASING-LHSP   TO TRUE
                 IF G425-SUBPRO IS NUMERIC
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'CREDITO NO APLICA   ' TO CAA-VAR1-ERROR
                    MOVE 'CAMBIO DE SUBPRO.   ' TO CAA-VAR2-ERROR
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
              ELSE
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTT37      ' TO CAA-VAR1-ERROR
                 MOVE '99 UGDTT37          ' TO CAA-VAR2-ERROR
      *          MOVE '99'                   TO CMP0-CODIGO-RETORNO
      *          MOVE 'UGDTT37'              TO CMP0-COD-ERROR
      *                                         CMP0-VAR1-ERROR
      *          MOVE 'SELECT UGDTT37'       TO CMP0-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF
      *@COL03-F
      *@COL05-I

           IF SI-SUBPRO-LEASING-LHSP

              MOVE '1252'                          TO T37-SECCION
              MOVE G425-SUBPRO                     TO T37-ELEMENTO

              EXEC SQL
                   SELECT SECCION
                        , ELEMENTO
                     INTO :T37-SECCION
                        , :T37-ELEMENTO
                     FROM UGDTT37
                    WHERE SECCION  =  :T37-SECCION
                      AND ELEMENTO =  :T37-ELEMENTO
              END-EXEC
              MOVE SQLCODE                      TO DB2-RETURN-CDE

              IF DB2-OK
                 MOVE 'UGE0939'                TO CAA-COD-ERROR
                 MOVE 'SUBPRODUCTO NO PUEDE'   TO CAA-VAR1-ERROR
                 MOVE 'SER LHSP.           '   TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                IF DB2-NOTFND
                   CONTINUE
                ELSE
                   MOVE 'UGE0939'               TO CAA-COD-ERROR
                   MOVE 'SELECT TABLA UGDTT37'  TO CAA-VAR1-ERROR
                   MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
                   PERFORM 3-FINAL-PROGRAMA
                END-IF
              END-IF

              MOVE '1250'                          TO T37-SECCION
              MOVE G425-SUBPRO                     TO T37-ELEMENTO

              EXEC SQL
                   SELECT SECCION
                        , ELEMENTO
                     INTO :T37-SECCION
                        , :T37-ELEMENTO
                     FROM UGDTT37
                    WHERE SECCION  =  :T37-SECCION
                      AND ELEMENTO =  :T37-ELEMENTO
              END-EXEC
              MOVE SQLCODE                      TO DB2-RETURN-CDE

              IF DB2-OK
                 CONTINUE
              ELSE
                IF DB2-NOTFND
                   MOVE 'UGE0939'                TO CAA-COD-ERROR
                   MOVE 'SUBPRODUCTO DEBE SER '  TO CAA-VAR1-ERROR
                   MOVE 'LEASING HABITACIONAL '  TO CAA-VAR2-ERROR
                   PERFORM 3-FINAL-PROGRAMA
                ELSE
                   MOVE 'UGE0939'               TO CAA-COD-ERROR
                   MOVE 'SELECT TABLA UGDTT37'  TO CAA-VAR1-ERROR
                   MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
                   PERFORM 3-FINAL-PROGRAMA
                END-IF
              END-IF
           END-IF

           SET NO-SUBPRO-LH                   TO TRUE.
           MOVE MAE-SUBPRO                    TO T37-ELEMENTO
           MOVE '1250'                        TO T37-SECCION

           EXEC SQL
               SELECT
                      SECCION ,
                      ELEMENTO
                 INTO
                      :T37-SECCION ,
                      :T37-ELEMENTO
                  FROM UGDTT37
                 WHERE SECCION    = :T37-SECCION
                   AND ELEMENTO   = :T37-ELEMENTO
           END-EXEC.
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK
              SET SI-SUBPRO-LH               TO TRUE
           ELSE
              IF DB2-NOTFND
                 SET NO-SUBPRO-LH            TO TRUE
              ELSE
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTT37      ' TO CAA-VAR1-ERROR
                 MOVE '99 UGDTT37          ' TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF
           .
      *@COL05-F
      *@COL03-I
      *****************************************************************
      * CALCULA EL RANGO DE FECHAS                                    *
      *                                                               *
      *****************************************************************
       215-CALC-RANGO-TCWC1750.
           INITIALIZE                       TCWC1750
           MOVE MAE-FEPROLIQ(1:4)        TO W175-FHGRE1(5:4)
           MOVE MAE-FEPROLIQ(6:2)        TO W175-FHGRE1(3:2)
           MOVE MAE-FEPROLIQ(9:2)        TO W175-FHGRE1(1:2)
           MOVE 'CO'                     TO W175-TPTRAT
           MOVE '2'                      TO W175-CDOPCIO
           MOVE -30                      TO W175-FACTOR

           CALL CON-TC8C1220 USING TCWC1750

           IF W175-CDRETORN = '00'
              CONTINUE
           ELSE
              MOVE 'UGE0939'               TO CAA-COD-ERROR
              MOVE 'ERR RUTINA  TC8C1220'  TO CAA-VAR1-ERROR
              MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      *@COL03-F
      *
      *@COL03-I
      ******************************************************************
      * SE BUSCA LA GARANTIA  PARA VERIFICAR EL VALOR ACTUAL       *
      ******************************************************************
       216-BUSCA-GARANTIA.
           PERFORM 2311-ABRIR-CURGAR
           MOVE 'N'                      TO SW-FIN-CUR
           SET NO-GAR-HIPOTECA           TO TRUE
           PERFORM 23121-FETCH-CUR UNTIL SW-SI-FIN-CUR
           PERFORM 2313-CIERRA-CUR.
      *
      ******************************************************************
      * SE ABRE EL CURSOR DE LAS GARANTIAS ASOCIADAS A LA OBLIGACION   *
      ******************************************************************
       2311-ABRIR-CURGAR.
           MOVE MAE-ENTIOFI              TO GRP-ENTIOFI
           MOVE MAE-CUENTA               TO GRP-CUENTA

           EXEC SQL
                OPEN CURSOR-GRP
           END-EXEC

           MOVE SQLCODE                  TO DB2-RETURN-CDE

           IF NOT DB2-OK
              MOVE 'UGE0939'               TO CAA-COD-ERROR
              MOVE 'ERROR ABRIENDO GRP  '  TO CAA-VAR1-ERROR
              MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      *
      *
      ******************************************************************
      * SE HACE LA LECTURA DEL CURSOR DE LA GRP                        *
      ******************************************************************
       23121-FETCH-CUR.
           EXEC SQL
                FETCH CURSOR-GRP
                INTO :GRP-CODIGAR,
                     :GRP-ENTIDAD-GAR,
                     :GRP-CENTRO-GAR,
                     :GRP-CUENTA-GAR
           END-EXEC.

           MOVE SQLCODE                  TO DB2-RETURN-CDE
           IF DB2-OK
              IF GRP-CODIGAR(1:1) ='1'OR'2'
                 SET SI-GAR-HIPOTECA     TO TRUE
                 PERFORM 23122-LEE-ICDTCAP
              END-IF
           ELSE
             IF DB2-NOTFND
                MOVE 'S'                   TO SW-FIN-CUR
                IF SI-GAR-HIPOTECA
                   CONTINUE
                ELSE
                   MOVE 'UGE0939'               TO CAA-COD-ERROR
                   MOVE 'DEBE EXISTIR UN     '  TO CAA-VAR1-ERROR
                   MOVE 'GARANTIA HIP ATADA  '  TO CAA-VAR2-ERROR
                   PERFORM 3-FINAL-PROGRAMA
                END-IF
             ELSE
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'ERROR LECTURA  GRP  '  TO CAA-VAR1-ERROR
                 MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
             END-IF
           END-IF.
      *
      ******************************************************************
      * SE VERIFICA SI LA GARANTIA CORRESPONDE A L.H.                  *
      ******************************************************************
       23122-LEE-ICDTCAP.
           INITIALIZE                    CAP-ICTCCAP0
           MOVE GRP-ENTIDAD-GAR          TO CAP-ICCENTPF
           MOVE GRP-CENTRO-GAR           TO CAP-ICCOFDPF
           MOVE GRP-CUENTA-GAR           TO CAP-ICCCTAPF


           EXEC SQL
                SELECT ICCENTPF,
                       ICCOFDPF,
                       ICCCTAPF
                INTO : CAP-ICCENTPF,
                     : CAP-ICCOFDPF,
                     : CAP-ICCCTAPF
                FROM ICDTCAP
                WHERE ICCENTPF =:CAP-ICCENTPF
                AND   ICCOFDPF =:CAP-ICCOFDPF
                AND   ICCCTAPF =:CAP-ICCCTAPF
           END-EXEC

           MOVE SQLCODE                  TO DB2-RETURN-CDE

           IF DB2-OK
              CONTINUE
           ELSE
             IF DB2-NOTFND
                MOVE 'UGE0939'               TO CAA-COD-ERROR
                MOVE 'SEGURO DE INCENDIO  '  TO CAA-VAR1-ERROR
                MOVE 'NO FORMALIZADO      '  TO CAA-VAR2-ERROR
                PERFORM 3-FINAL-PROGRAMA
             ELSE
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'ERROR SELECT ICDTCAP'  TO CAA-VAR1-ERROR
                 MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
             END-IF
           END-IF.

      *
      *
      ******************************************************************
      * SE CIERRA EL CURSOR DE LAS GARANTIAS                           *
      ******************************************************************
       2313-CIERRA-CUR.
           EXEC SQL
                CLOSE CURSOR-GRP
           END-EXEC

           MOVE SQLCODE                  TO DB2-RETURN-CDE

           IF NOT DB2-OK
              MOVE 'UGE0939'               TO CAA-COD-ERROR
              MOVE 'ERROR AL CERRAR GRP '  TO CAA-VAR1-ERROR
              MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      *@COL03-F
      *@COL03-I
      ******************************************************************
      *                217-LEE-UGDTPRO                                 *
      *                                                                *
      ******************************************************************
       217-LEE-UGDTPRO.

           INITIALIZE UGTCPRO
           MOVE G425-SUBPRO                   TO PRO-SUBPRO
           MOVE MAE-CUENTA(1:2)               TO PRO-PRODUCTO

           EXEC SQL
               SELECT
                      PRODUCTO,
                      SUBPRO,
      *@COL05-I
                      PLAZOMIN ,
                      PLAZOMAX ,
      *@COL05-F
                      LIBRE_CAR1
                 INTO
                      :PRO-PRODUCTO,
                      :PRO-SUBPRO,
      *@COL05-I
                      :PRO-PLAZOMIN ,
                      :PRO-PLAZOMAX ,
      *@COL05-F
                      :PRO-LIBRE-CAR1
                  FROM UGDTPRO
                 WHERE PRODUCTO   = :PRO-PRODUCTO
                   AND SUBPRO     = :PRO-SUBPRO
