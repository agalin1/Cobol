       2191-VALSOLDESEM.
           INITIALIZE UGTCDSM
           MOVE T37-RESTO(1:1)                TO SW-TIPO-CRED-CONST
           MOVE AMA-LIBRE-CAR3(12:6)          TO DSM-CODMPC
           EXEC SQL
               SELECT
                   DSM_CODDSM,
                   DSM_VLRSOLIC,
                   DSM_VIGDESEM
               INTO
                   :DSM-CODDSM,
                   :DSM-VLRSOLIC,
                   :DSM-VIGDESEM
               FROM
                   UGDTDSM
               WHERE
                   DSM_CODMPC = :DSM-CODMPC AND
                   DSM_INDCXI = :SW-TIPO-CRED-CONST AND
                   DSM_INDDESEMBOL <> 'S'
               ORDER BY DSM_TSCREA DESC
               FETCH FIRST 1 ROWS ONLY
           END-EXEC
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           EVALUATE TRUE
               WHEN DB2-OK
                   PERFORM 21911-COMPARAR-FECHAS
                   PERFORM 21912-COMPARAVALORES
               WHEN DB2-NOTFND
                   MOVE 'UGE0939'             TO CAA-COD-ERROR
                   MOVE 'NO EXISE SOLICITUD  ' TO CAA-VAR1-ERROR
                   MOVE 'DESEMBOLSO CONSTRUCT' TO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
               WHEN OTHER
                   MOVE 'UGE0939'             TO CAA-COD-ERROR
                   MOVE 'ERROR DB2 UGDTDSM  ' TO CAA-VAR1-ERROR
                   STRING 'CODIGO: ' DELIMITED BY SIZE
                     DB2-TEXT DELIMITED BY SIZE
                   INTO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
