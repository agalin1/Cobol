      ******************************************************************
       220400-VALIDAR-PLAZO.
             IF MAE-PLAZO(1:1) = '2'
                MOVE MAE-PLAZO(2:3)  TO WS-PLAZO-MAE-1
                IF WS-LINCRE = '01' OR WS-LINCRE ='11'
                     OR WS-LINCRE= '31'
                   IF WS-PLAZO-MAE < CTE-24
                      MOVE 'UGE0939'                TO CAA-COD-ERROR
                      MOVE 'VLR. SOLIC. ES MAYOR '  TO CAA-VAR1-ERROR
                      MOVE 'AL LIM. PARA 24 MESES'  TO CAA-VAR2-ERROR
                      PERFORM 999999-ROLLBACK
                      PERFORM 3-FINAL-PROGRAMA
                   END-IF
                END-IF
                IF WS-LINCRE = '02' OR WS-LINCRE = '12'
                      OR WS-LINCRE ='32'
                   IF WS-PLAZO-MAE < CTE-36
                       MOVE 'UGE0939'               TO CAA-COD-ERROR
                       MOVE 'VLR. SOLIC. ES MAYOR ' TO CAA-VAR1-ERROR
                       MOVE 'AL LIM. PARA 36 MESES' TO CAA-VAR2-ERROR
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                   END-IF
                END-IF
                IF WS-LINCRE = '03' OR WS-LINCRE = '13'
                     OR WS-LINCRE = '33'
                   IF WS-PLAZO-MAE < CTE-48
                      MOVE 'UGE0939'               TO CAA-COD-ERROR
                      MOVE 'VLR. SOLIC. ES MAYOR ' TO CAA-VAR1-ERROR
                      MOVE 'AL LIM. PARA 48 MESES' TO CAA-VAR2-ERROR
                      PERFORM 999999-ROLLBACK
                      PERFORM 3-FINAL-PROGRAMA
