                        :ADE-INDSUBVE,      :ADE-ENTSUB,
                        :ADE-CONSUB,        :ADE-CODLILIQ,
                        :ADE-UGYFARET,      :ADE-INDINANT,
                        :ADE-TIPODIAS,      :ADE-DIASCAL,
                        :ADE-PERIGRA,       :ADE-TIMESTAMP,
                        :ADE-NETNAME-UMO,   :ADE-USERID-UMO,
                        :ADE-CENTRO-UMO,    :ADE-ENTIDAD-UMO,
                        :ADE-UGCDIPAG,      :ADE-INDCOMOR,
                        :ADE-INDCUADI,      :ADE-PERMAX,
                        :ADE-COECUAMI,      :ADE-IND-MARCA1,
                        :ADE-IND-MARCA2,    :ADE-IND-MARCA3,
