       224-ACCEDER-UADS.
      *
           MOVE MAE-PRODUCTO                  TO ADS-PRODUCTO
           MOVE MAE-SUBPRO                    TO ADS-SUBPRO
      *
           EXEC SQL
              SELECT PERCAP, PERINT, CARECAP, CAREINT, TIPODIAS,
                     DIASCAL,
                     PERCAINT, CODTIAMO, LININCUO, PROGGEOM,
                     PROGARIT, INDINVAR, CODTIPRE,
                     CODREDON, CODLILIQ,
                     UGYFARET, INDSUBVE, INDINANT, ISUMCOM
              INTO
                :ADS-PERCAP,
                :ADS-PERINT,
                :ADS-CARECAP,
                :ADS-CAREINT,
                :ADS-TIPODIAS,
                :ADS-DIASCAL,
                :ADS-PERCAINT,
                :ADS-CODTIAMO,
                :ADS-LININCUO,
                :ADS-PROGGEOM,
                :ADS-PROGARIT,
                :ADS-INDINVAR,
                :ADS-CODTIPRE,
                :ADS-CODREDON,
                :ADS-CODLILIQ,
                :ADS-UGYFARET,
                :ADS-INDSUBVE,
                :ADS-INDINANT,
                :ADS-ISUMCON
              FROM   UGDTADS
              WHERE  PRODUCTO  = :ADS-PRODUCTO
                AND  SUBPRO    = :ADS-SUBPRO
