      ******************************************************************
       505-REGISTRA-FIDEICO.
           INITIALIZE UGTCMPC
           MOVE AMA-LIBRE-CAR3(12:6)       TO MPC-CODMPC
           EXEC SQL
               SELECT
                   MPC_FIDEICOMI,
                   MPC_CONDICIONES,
                   MPC_VLRAVALOTE,
      *COL145-I
      *            MPC_VLRCOSTOT
                   MPC_VLRCOSTOT,
