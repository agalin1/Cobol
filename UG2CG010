                    MOVE 'ABRIR UGDTT37'        TO CAA-VAR1-ERROR
                    MOVE 'SQLCODE '             TO CAA-VAR2-ERROR(1:8)
                    MOVE DB2-RETURN-CDE         TO CAA-VAR2-ERROR(9:)
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
              END-IF.
      *
      *****************************************************************
      *200440-FETCH-CURSOR-T37
      *****************************************************************
      *
       200440-FETCH-CURSOR-T37.
      *
              EXEC SQL
                  FETCH CURSOR-T37
                  INTO
                    :T37-ELEMENTO,
                    :T37-RESTO
              END-EXEC.

              MOVE SQLCODE                     TO   DB2-RETURN-CDE

              IF NOT (DB2-OK AND SQLWARN0 = SPACES)
                 IF (DB2-NOTFND AND SQLWARN0 = SPACES)
                    SET SW-SI-FIN-CURSOR        TO TRUE
                 ELSE
                    IF DB2-RECATR1 OR DB2-RECATR2
                       MOVE 'UGE0939'           TO CAA-COD-ERROR
                       MOVE 'RECURSO ATRAPADO ' TO CAA-VAR1-ERROR
                       MOVE 'INTENTE LUEGO'     TO CAA-VAR2-ERROR
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                    ELSE
                       MOVE 'UGE0939'           TO CAA-COD-ERROR
                       MOVE 'FETCH UGDTT37'     TO CAA-VAR1-ERROR
                       MOVE 'SQLCODE '          TO CAA-VAR2-ERROR(1:8)
                       MOVE DB2-RETURN-CDE      TO CAA-VAR2-ERROR(9:)
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                    END-IF
                 END-IF
              ELSE
                 ADD 1                          TO WS-T37-LEIDOS
                 IF CAA-CENTRO-CONT EQUAL T37-ELEMENTO(1:4)
                    SET SW-SI-CENTRO            TO TRUE
                 END-IF
