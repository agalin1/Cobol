                 WHERE ENTIOFI    = :MOV-ENTIOFI
                   AND CUENTA     = :MOV-CUENTA
                   AND CLACON     = :MOV-CLACON
                   AND IND_MARCA1 = :MOV-IND-MARCA1
                   AND INDRETRO   = :MOV-INDRETRO
