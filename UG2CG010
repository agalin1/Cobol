                   :MPC-CONDICIONES,
                   :MPC-VLRAVALOTE,
      *COL145-I
      *            :MPC-VLRCOSTOT
                   :MPC-VLRCOSTOT,
                   :MPC-OBSERVACIONES
      *COL145-F
               FROM UGDTMPC
               WHERE
                   MPC_CODMPC = :MPC-CODMPC
           END-EXEC
           MOVE SQLCODE                    TO DB2-RETURN-CDE
           EVALUATE TRUE
               WHEN DB2-OK
                   IF MPC-FIDEICOMI NOT = SPACES
                       IF G01-CODFIDE = SPACES
                           MOVE 'UGE0939' TO CAA-COD-ERROR
                           MOVE 'PROY CONSTRUCTOR CON' TO CAA-VAR1-ERROR
                           MOVE 'FIDEICOMISO,DIGITELO' TO CAA-VAR2-ERROR
                           PERFORM 999999-ROLLBACK
                           PERFORM 3-FINAL-PROGRAMA
                       END-IF
                       IF G01-CODFIDE NOT = MPC-FIDEICOMI
                           MOVE 'UGE0939' TO CAA-COD-ERROR
                           MOVE 'NUM FIDEICOM NO ES  ' TO CAA-VAR1-ERROR
                           MOVE 'IGUAL AL MODULO WEB ' TO CAA-VAR2-ERROR
                           PERFORM 999999-ROLLBACK
                           PERFORM 3-FINAL-PROGRAMA
