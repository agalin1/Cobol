                      :GAP-ENTIDAD-ABO,
                      :GAP-CENTRO-ABO,
                      :GAP-CUENTA-ABO,
                      :GAP-DIGICCC1-ABO,
                      :GAP-DIGICCC2-ABO,
                      :GAP-ENTIDAD-CAR,
                      :GAP-CENTRO-CAR,
                      :GAP-CUENTA-CAR,
                      :GAP-DIGICCC1-CAR,
                      :GAP-DIGICCC2-CAR,
                      :GAP-TEXTO,
                      :GAP-IND-MARCA1,
                      :GAP-LIBRE-IMP1,
                      :GAP-LIBRE-CAR1,
                      :GAP-ENTIDAD-UMO,
                      :GAP-CENTRO-UMO,
                      :GAP-USERID-UMO,
                      :GAP-NETNAME-UMO,
                      CURRENT TIMESTAMP,
                      :GAP-CONSEC)
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           IF DB2-OK
              CONTINUE
           ELSE
              MOVE 'UGE0939'                  TO CAA-COD-ERROR
              MOVE 'ERROR INSERT'             TO CAA-VAR1-ERROR
              MOVE 'UGDTGAP-P'                TO CAA-VAR2-ERROR
