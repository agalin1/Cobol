                        :ADE-PERCAP,        :ADE-PERINT,
                        :ADE-CARECAP,       :ADE-CAREINT,
                        :ADE-INDAVISO,      :ADE-NUMDIAVI,
                        :ADE-INDINVAR,      :ADE-CODTIPRE,
                        :ADE-CODREDON,      :ADE-PERCAINT,
                        :ADE-CODTIAMO,      :ADE-PROGGEOM,
                        :ADE-PROGARIT,      :ADE-LININCUO,
