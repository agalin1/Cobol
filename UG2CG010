      *COL217-I
      ******************************************************************
      * VALIDA SI EL HIPOT O LEASING TIENEN CONSUMO GDE RELACIONADO ACT*
      ******************************************************************
       266-VALIDA-GDE.

           IF SI-SUBPRO-LEASING
              PERFORM 2661-RUTINA-UR9CVGDE
           ELSE
              INITIALIZE            UGTCT37
              MOVE MAE-SUBPRO   TO  T37-ELEMENTO
              EXEC SQL
                SELECT SECCION
                INTO  :T37-SECCION
                FROM  UGDTT37
                WHERE ELEMENTO = :T37-ELEMENTO
                  AND SECCION IN ('1068', '1069', '1070', '1071')
                FETCH FIRST ROW ONLY
              END-EXEC

              MOVE  SQLCODE                         TO DB2-RETURN-CDE
              EVALUATE TRUE
                 WHEN DB2-OK
                      PERFORM 2661-RUTINA-UR9CVGDE
                 WHEN DB2-NOTFND
                      CONTINUE
                 WHEN OTHER
                     MOVE DB2-RETURN-CDE           TO CAA-COD-ERROR
                     MOVE 'ERROR SEL GDE'          TO CAA-VAR1-ERROR
                     MOVE 'TABLA UGDTT37 '         TO CAA-VAR2-ERROR
                     PERFORM 999999-ROLLBACK
                     PERFORM 3-FINAL-PROGRAMA
             END-EVALUATE.

      ******************************************************************
      *                      2112-RUTINA-UR9CVGDE                      *
      *----------------------------------------------------------------*
      * LLAMADO A RUTINA VALIDACION DE GASTOS DE ESCRITURACION GDE     *
      ******************************************************************
       2661-RUTINA-UR9CVGDE.
           INITIALIZE UGWCVGDE
           MOVE '02'                TO VGDE-OPCION
           MOVE MAE-ENTIOFI         TO VGDE-ENTIOFI
           MOVE MAE-CUENTA          TO VGDE-CUENTA
           CALL BBVA-UR9CVGDE       USING UGWCVGDE
      *
           EVALUATE VGDE-CODRET
             WHEN '00'
               IF VGDE-ESTADO-REL = 'A'
                  IF VGDE-SITPRES = CTE-CON-7 OR
                     VGDE-SITPRES = CTE-CON-8
                     MOVE 'UGE0939'               TO CAA-COD-ERROR
                     MOVE 'ANULAR SCORING GDE: '  TO CAA-VAR1-ERROR
                     MOVE VGDE-ENTIOFI-REL        TO CAA-VAR2-ERROR(1:8)
                     MOVE VGDE-CUENTA-REL         TO CAA-VAR2-ERROR(9:)
                     PERFORM 999999-ROLLBACK
                     PERFORM 3-FINAL-PROGRAMA
                  END-IF
                  IF VGDE-SITPRES EQUAL CTE-CON-0
                     SET WS-SI-GDE   TO TRUE
                  ELSE
                     SET WS-NO-GDE   TO TRUE
                  END-IF
               END-IF
             WHEN '20'
                 SET WS-NO-GDE     TO TRUE
             WHEN OTHER
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                  MOVE VGDE-VAR1-ERROR       TO CAA-VAR1-ERROR
                  MOVE BBVA-UR9CVGDE         TO CAA-VAR2-ERROR(1:8)
                  MOVE VGDE-CODRET           TO CAA-VAR2-ERROR(10:)
                  PERFORM 999999-ROLLBACK
                  PERFORM 3-FINAL-PROGRAMA
            END-EVALUATE.
      ******************************************************************
      *                      267-CANCELACION-GDE                       *
      *----------------------------------------------------------------*
      * RUTINA PARA CANCELAR CRED CONSUMO GASTOS DE ESCRITURACION GDE  *
      ******************************************************************
       267-CANCELACION-GDE.

           INITIALIZE URWCCGDE
           MOVE MAE-ENTIOFI         TO CGDE-E-ENTIOFI
           MOVE MAE-CUENTA          TO CGDE-E-CUENTA
           MOVE CAA-FECHA-CONT2     TO CGDE-E-FECHA-CONT2
           MOVE CAA-FECHA-OPER2     TO CGDE-E-FECHA-OPER2
           MOVE CAA-HORA-TRANS      TO CGDE-E-HORA-TRANS
           MOVE CAA-USERID          TO CGDE-E-USERID
           MOVE CAA-CODTRAN         TO CGDE-E-CODTRAN
           MOVE CAA-NETNAME         TO CGDE-E-NETNAME
           MOVE CAA-NETNAME-CONT    TO CGDE-E-NETNAME-CONT
           MOVE CAA-TERMINAL        TO CGDE-E-TERMINAL
           MOVE CAA-TERMINAL-CONT   TO CGDE-E-TERMINAL-CONT
           MOVE CAA-ENTIDAD         TO CGDE-E-ENTIDAD-CONT
           MOVE CAA-CENTRO-CONT     TO CGDE-E-CENTRO-CONT
           MOVE CAA-IDIOMA-TERM     TO CGDE-E-IDIOMA-TER
      *
              EXEC CICS LINK
                 PROGRAM (BBVA-UR2CCGDE)
                 COMMAREA (URWCCGDE)
                 NOHANDLE
              END-EXEC
      *
              EVALUATE CGDE-S-COD-RET
                 WHEN '00'
                    MOVE CGDE-S-VLR-CAP-TRASL  TO WS-CAPIT-UNIFIC
                 WHEN OTHER
                    MOVE CGDE-S-COD-ERROR      TO CAA-COD-ERROR
                    MOVE CGDE-S-VAR-ERROR1     TO CAA-VAR1-ERROR
                    MOVE CGDE-S-VAR-ERROR2     TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
              END-EVALUATE.
       EJECT .
      *COL217-F
      *COL221-I
      ******************************************************************
      *                     3100-DIA-CERO-INTERES                      *
      *----------------------------------------------------------------*
      * VALIDA SI DESEMBOLSO DE CREDITO APLICA PARA COBRAR INTERESES   *
      * DESDE EL PRIMER DIA, ESO EQUIVALE A INCREMENTAR EN 1 LOS DIAS  *
      ******************************************************************
       3100-DIA-CERO-INTERES.

           INITIALIZE UGNCUR80-01
           MOVE '02'                     TO UR80-E-OPCION
           MOVE MAE-SUBPRO               TO UR80-E-SUBPRO

           EXEC CICS
             LINK PROGRAM(CTE-UR7CR183)
             COMMAREA(UGNCUR80-01)
             NOHANDLE
           END-EXEC

           IF EIBRESP EQUAL DFHRESP(NORMAL)
              IF UR80-COD-RETORNO = '00'
                 IF UR80-S-TIPO-PRODUCTO EQUAL SPACES OR LOW-VALUES
                    MOVE 'X'               TO UR80-S-TIPO-PRODUCTO
                 END-IF
                 IF UR80-S-DIA-CERO EQUAL SPACES OR LOW-VALUES
                    MOVE 'N'                  TO UR80-S-DIA-CERO
                 ELSE
                    IF UR80-S-DIA-CERO = 'S' OR 'N'
                       CONTINUE
                    ELSE
                       MOVE 'N'                  TO UR80-S-DIA-CERO
                    END-IF
                 END-IF
              ELSE
                 MOVE 'X'                  TO UR80-S-TIPO-PRODUCTO
                 MOVE 'N'                  TO UR80-S-DIA-CERO
              END-IF
           ELSE
              MOVE 'X'                     TO UR80-S-TIPO-PRODUCTO
              MOVE 'N'                     TO UR80-S-DIA-CERO
           END-IF
