                     AND LOG_CUENTA = :LOG-CUENTA
                     AND LOG_CODIGO = :LOG-CODIGO
                   ORDER BY LOG_TIMESTAMP DESC
                   FETCH FIRST ROW ONLY
             END-EXEC

             MOVE SQLCODE       TO DB2-RETURN-CDE
             IF DB2-OK AND SQLWARN0 EQUAL SPACES
                IF LOG-CARANT(8:2) EQUAL SPACES OR
                   LOG-CARANT(8:2) EQUAL '00'
