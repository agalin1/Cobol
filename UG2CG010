      *
           EXEC SQL
                SELECT   ENTIOFI,            CUENTA,
                         FECOVALI,           FEFIVALI,
                         PERCAP,             PERINT,
                         CARECAP,            CAREINT,
                         INDAVISO,           NUMDIAVI,
