      *----------------------------------------------------------------*
      *  ACTUALIZAR TABLA DE SERVICIOS AGROPECUARIOS                   *
      *----------------------------------------------------------------*
       231-ACTUALIZA-SERVI-AGRO.

      *% Y VALOR DEL SERVICIO AGRO COBRADO
           MOVE RCO-PORC-COM                TO MAG-PORCOM
           MOVE RCO-IMPORTE-APLIC           TO MAG-IMPCOMTOT

      *% Y VALOR DE IVA DEL SERVICIO AGRO COBRADO
           MOVE RCO-PORC-IVA                TO MAG-PORIVA
           MOVE RCO-IMP-IVA-TEOR            TO MAG-IMPIVA

      *% Y VALOR DEL SERVICIO AGRO DEL LADO BBVA
           MOVE SAG-PORCOMBAN               TO MAG-PORCOMBAN
           COMPUTE MAG-IMPCOMBAN = ((RCO-IMPORTE-APLIC * SAG-PORCOMBAN)
                                     / 100)
      *% Y VALOR DEL SERVICIO AGRO DEL LADO DEL PROVEEDOR
           MOVE SAG-PORCOMPROV              TO MAG-PORCOMPROV
           COMPUTE MAG-IMPCOMPROV = RCO-IMPORTE-APLIC - MAG-IMPCOMBAN

      *  ACTUALIZA ESTADO
           MOVE  'C'                        TO  MAG-INDCOMAPRO
           MOVE  CAA-FECHA-OPER2            TO  MAG-FEOPER
           MOVE  CAA-CENTRO-CONT            TO  MAG-CENTRO-UMO
           MOVE  CAA-USERID                 TO  MAG-USERID-UMO
           MOVE  CAA-NETNAME                TO  MAG-TIMESTAMP

           EXEC SQL
                UPDATE  UGDTMAG
                   SET  FEOPER      = :MAG-FEOPER,
                        PORCOM      = :MAG-PORCOM,
                        IMPCOMTOT   = :MAG-IMPCOMTOT,
                        PORIVA      = :MAG-PORIVA,
                        IMPIVA      = :MAG-IMPIVA,
                        PORRFTE     = :MAG-PORRFTE,
                        IMPRFTE     = :MAG-IMPRFTE,
                        PORCOMBAN   = :MAG-PORCOMBAN,
                        IMPCOMBAN   = :MAG-IMPCOMBAN,
                        PORCOMPROV  = :MAG-PORCOMPROV,
                        IMPCOMPROV  = :MAG-IMPCOMPROV,
                        INDCOMAPRO  = :MAG-INDCOMAPRO,
                        CENTRO_UMO  = :MAG-CENTRO-UMO,
                        USERID_UMO  = :MAG-USERID-UMO,
                        NETNAME_UMO = :MAG-NETNAME-UMO,
                        TIMESTAMP   = CURRENT TIMESTAMP
                WHERE
                   ENTIOFI = :MAG-ENTIOFI  AND
                   CUENTA  = :MAG-CUENTA
           END-EXEC

