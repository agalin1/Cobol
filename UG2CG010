      *                  230-COBRAR-SERVICIOS-AGRO                     *
      *----------------------------------------------------------------*
      *  COLOCAR EN FIRME EL COBRO DE SERVICIOS AGROPECUARIOS          *
      *----------------------------------------------------------------*
       230-COBRAR-SERVICIOS-AGRO.

           IF ((MAE-ENTIDAD-VIN EQUAL SPACES OR LOW-VALUES) OR
               (MAE-CENTRO-VIN EQUAL SPACES OR LOW-VALUES) OR
               (MAE-CUENTA-VIN EQUAL SPACES OR LOW-VALUES))
                MOVE 'UGE3434'            TO CAA-COD-ERROR
                MOVE 'CREDITO SERVI-AGRO' TO CAA-VAR1-ERROR
                MOVE 'SIN CTA. VINCULADA' TO CAA-VAR2-ERROR
                PERFORM 999999-ROLLBACK
                PERFORM 3-FINAL-PROGRAMA
           ELSE
              IF MAG-IMPCOMTOT > ZEROS AND
                 MAG-INDCOMAPRO = 'P'
                 PERFORM 231-VALIDA-CLAVE-SERVICIO
                 PERFORM 231-ALTA-SERVI-AGRO-BBVA
                 IF SI-SERVI-AGRO-BBVA
                    IF RCO-IMPORTE-APLIC > ZEROS
                       PERFORM 231-DEBITO-SERVICIOS-AGRO
                    END-IF
                    IF RCO-IMP-IVA-TEOR > ZEROS
                       PERFORM 231-DEBITO-IVA-SERVI-AGRO
                    END-IF
                    PERFORM 231-CONSULTAR-PROV-SERVI-AGRO
                    PERFORM 231-ACTUALIZA-SERVI-AGRO
                    SET SI-MOV-SERVI-AG      TO TRUE
                    PERFORM 2313-GRABA-MOVIMIENTO
                 END-IF
              END-IF
           END-IF.

