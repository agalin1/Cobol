      *COL27-F

      ******************************************************************
      *                  000502-BUSCA-DATOS1-CAB1                      *
      ******************************************************************
       000502-BUSCA-DATOS1-CAB1.

              MOVE  MAE-ENTIOFI   TO PRT-ENTIOFI
              MOVE  MAE-CUENTA    TO PRT-CUENTA

              EXEC SQL
                SELECT
                       SUBPRO,
                       IND_BONIFICA,            PORTAFOLIO,
                       PUNTOS_TOTALES,          TASA_ACT,
                       SITUAC
                INTO
                  :PRT-SUBPRO,
                  :PRT-IND-BONIFICA,       :PRT-PORTAFOLIO,
                  :PRT-PUNTOS-TOTALES,     :PRT-TASA-ACT,
                  :PRT-SITUAC
                FROM UGDTPRT
                WHERE
                      ENTIOFI = :PRT-ENTIOFI  AND
                      CUENTA  = :PRT-CUENTA
              END-EXEC

              MOVE SQLCODE  TO DB2-RETURN-CDE
              IF DB2-NOTFND
      *COL44-I MANEJO ESTANDAR DE ERRORES
      *          MOVE 'UGA0123'                 TO CAA-COD-AVISO1
      *          MOVE '          CUENTA SIN'    TO CAA-VAR1-AVISO1
      *          MOVE 'PORTAFOLIO'              TO CAA-VAR2-AVISO1
                 MOVE 'UGE0939'                 TO CAA-COD-ERROR
                 MOVE '          CUENTA SIN'    TO CAA-VAR1-ERROR
                 MOVE 'PORTAFOLIO'              TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 IF NOT DB2-OK
      *@COL64-I
                    MOVE 'UGE0939'               TO CAA-COD-ERROR
                    MOVE 'ERR SELECT EN TABLA '  TO CAA-VAR1-ERROR
                    MOVE 'UGDTPRT 3 '            TO CAA-VAR2-ERROR(1:10)
                    MOVE SQLCODE                 TO CAA-VAR2-ERROR(11: )
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
