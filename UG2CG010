               USERID_UMO,
               NETNAME_UMO,
               MONEDA)
             VALUES(
               :MOD-CODTRAN,
               :MOD-TABLA,
               :MOD-CLAVE,
                CURRENT TIMESTAMP,
               :MOD-COLUMNA,
               :MOD-VALOR-ANT,
               :MOD-VALOR-ACT,
               :MOD-COMENTARIO,
               :MOD-ENTIDAD-UMO,
               :MOD-CENTRO-UMO,
