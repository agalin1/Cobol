      *----------------------------------------------------------------*
      *OBTIENE ACCEDIENDO A LA UGDTDRB EL NUMERO DE CUOTAS DE UN PRESTA*
      *MO PARA INSERTARLO EN LA UGDTCAR                                *
      ******************************************************************
       NUMERO-CUOTAS.
      *
           EXEC SQL
              SELECT  UGNPLPEN,
                      UGCCRCAP,
                      UGCCRINT
                  INTO :DRB-UGNPLPEN,
                       :WRB-UGCCRCAP,
                       :WRB-UGCCRINT
                  FROM UGDTDRB
                WHERE ENTIOFI = :MAE-ENTIOFI
                AND CUENTA  = :MAE-CUENTA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT(DB2-OK   AND SQLWARN0 = SPACES)
      *@COL64-I
              MOVE 'UGE0939'                  TO CAA-COD-ERROR
              MOVE 'ERR SELECT EN TABLA '     TO CAA-VAR1-ERROR
              MOVE 'UGDTDRB 2 '               TO CAA-VAR2-ERROR(1:10)
              MOVE SQLCODE                    TO CAA-VAR2-ERROR(11: )
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
      *       MOVE 'UGDTDRB'                  TO CAA-VAR1-ERROR
      *       MOVE 'SELECT UGDTDRB'           TO CAA-VAR2-ERROR
      *       PERFORM 999999-ABEND-DB2
      *@COL64-F
           END-IF.
      *
      ******************************************************************
      *  SE CALCULA EL NUMERO DE CUOTAS REALES DEL PRESTAMO.           *
      *  EN CASO DE SER UN PRESTAMO SIN PLAZOS DE CARENCIA,            *
      *  EL NUMERO DE CUOTAS EN EL CAMPO UGNPLPEN ES EL CORRECTO,      *
      *  DE LO CONTRARIO, SE LE SUMA LA CARENCIA.                      *
      ******************************************************************
           IF WRB-UGCCRCAP > SPACES
              MOVE WRB-UGCCRCAP(2:3)          TO WS-UGCCRCAP
      *
              IF WRB-UGCCRINT EQUAL SPACES OR LOW-VALUES
                 MOVE ZEROS                   TO WS-UGCCRINT
              ELSE
                 MOVE WRB-UGCCRINT(2:3)       TO WS-UGCCRINT
              END-IF
      *
              IF WRB-UGCCRCAP(1:1) EQUAL 3
                 COMPUTE WS-UGCCRCAP = WS-UGCCRCAP * 12
                 END-COMPUTE
              END-IF
      *
              IF WRB-UGCCRINT(1:1) EQUAL 3
                 COMPUTE WS-UGCCRINT = WS-UGCCRINT * 12
                 END-COMPUTE
              END-IF
      *
              IF WS-UGCCRINT EQUAL ZERO
                 COMPUTE WS-PLPEN = DRB-UGNPLPEN - MAE-NUMRECIB
                 END-COMPUTE
              ELSE
                 COMPUTE WS-PLPEN = (WS-UGCCRCAP / WS-UGCCRINT) +
                                    DRB-UGNPLPEN - MAE-NUMRECIB
                 END-COMPUTE
              END-IF
           ELSE
              COMPUTE WS-PLPEN = DRB-UGNPLPEN
              END-COMPUTE
           END-IF.
      *
           MOVE WS-PLPEN                      TO CAR-NUMERO-CUOTAS.
      *
           EJECT.
