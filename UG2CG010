       10340-EXIT.   EXIT.
      *EW001-F
      *
      ******************************************************************
      *                    999999-SELECT-CTAABONO                      *
      ******************************************************************
       999999-SELECT-CTAABONO.
           MOVE 'U021'                        TO MOD-CODTRAN
           MOVE 'CTAAACH'                     TO MOD-TABLA
           MOVE SPACES                        TO WS-CLAVE
           MOVE WS-CCC-ENTIOFI                TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA                 TO WS-CUENTA
           MOVE WS-CLAVE                      TO MOD-CLAVE
      *
           EXEC SQL
               SELECT
                     CODTRAN,
                     TABLA,
                     CLAVE,
                     VALOR_ANT
               INTO
                 :MOD-CODTRAN,
                 :MOD-TABLA,
                 :MOD-CLAVE,
                 :MOD-VALOR-ANT
               FROM
                   UGDTMOD
               WHERE CODTRAN = :MOD-CODTRAN AND
                     TABLA   = :MOD-TABLA AND
                     CLAVE   = :MOD-CLAVE
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
           EVALUATE TRUE
               WHEN DB2-OK
                 MOVE MOD-VALOR-ANT(1:4)   TO G013-ENTIDAD
                 MOVE MOD-VALOR-ANT(5:4)   TO G013-OFICINA
                 MOVE MOD-VALOR-ANT(9:1)   TO G013-DIGITO1
                 MOVE MOD-VALOR-ANT(10:1)  TO G013-DIGITO2
                 MOVE MOD-VALOR-ANT(11:)   TO G013-CUENTA
               WHEN OTHER
                 MOVE 'UGE0939'            TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTMOD'     TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '           TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE       TO CAA-VAR2-ERROR(9:)
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
      *-----------------------------------------------------------------
      *  JUSTIFICA A LA IZQUIERDA LA IDENTIFICACION
      *-----------------------------------------------------------------
       211031-AJUSTAR-ID.
           MOVE 1                       TO WS-IND1
           PERFORM 211031-BUSCAR-CERO
             UNTIL WS-IND1 > WS-LONG-CAMPO
                OR WS-ID-NUMERO (WS-IND1:1) NOT = ZERO
           COMPUTE WS-LONG = WS-LONG-CAMPO - (WS-IND1 - 1)
           MOVE SPACES                  TO WS-ID-NUM
           MOVE WS-ID-NUMERO (WS-IND1:WS-LONG) TO WS-ID-NUM.

      *-----------------------------------------------------------------
      *  HALLAR LA POSICION INICIAL DEL NUMERO
      *-----------------------------------------------------------------
       211031-BUSCAR-CERO.
           IF WS-ID-NUMERO (WS-IND1:1) = ZERO
              COMPUTE WS-IND1 = WS-IND1 + 1
           END-IF.
      *COL157-MALD3-F
      *COL160-MALD4-I
      *-----------------------------------------------------------------
      *               999-CONSULTA-CTAESPE-ACH
      *-----------------------------------------------------------------
       999-CONSULTA-CTAESPE-ACH.
           INITIALIZE                        UGTCT37
           MOVE '7070'                       TO T37-SECCION
           MOVE '0001'                       TO T37-ELEMENTO

           EXEC SQL
            SELECT
                  RESTO
            INTO
                 :T37-RESTO
            FROM
                  UGDTT37
            WHERE
                  SECCION  = :T37-SECCION
              AND ELEMENTO = :T37-ELEMENTO
           END-EXEC

           MOVE SQLCODE                      TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE T37-RESTO                 TO WS-CTAESP-ACH
              MOVE T37-RESTO(1:4)            TO MIR-ENTIDAD
              MOVE T37-RESTO(5:4)            TO MIR-CENTRO-ALTA
              MOVE T37-RESTO(9:10)           TO MIR-CUENTA
              PERFORM 21401-DIGITOS-CTAESP
           ELSE
             IF DB2-NOTFND
                MOVE 'UGE0939'               TO CAA-COD-ERROR
                MOVE 'DESEM/SO ACH NO SE  '  TO CAA-VAR1-ERROR
                MOVE 'ENCUENTRA CTA ESPERA'  TO CAA-VAR2-ERROR(1:10)
                MOVE SQLCODE                 TO CAA-VAR2-ERROR(11: )
                PERFORM 999999-ROLLBACK
                PERFORM 3-FINAL-PROGRAMA
             ELSE
                MOVE 'UGE0939'               TO CAA-COD-ERROR
                MOVE 'ERR SELECT TABLA T37'  TO CAA-VAR1-ERROR
                MOVE 'SE:9094 2 '            TO CAA-VAR2-ERROR(1:10)
                MOVE SQLCODE                 TO CAA-VAR2-ERROR(11: )
                PERFORM 999999-ROLLBACK
                PERFORM 3-FINAL-PROGRAMA
             END-IF
           END-IF.
      ******************************************************************
