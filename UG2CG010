               UGDTQUM          SET
               UGYREFAC    = :QUM-UGYREFAC     ,
               TIMESTAMP   =  CURRENT TIMESTAMP,
               ENTIDAD_UMO = :QUM-ENTIDAD-UMO ,
               CENTRO_UMO  = :QUM-CENTRO-UMO  ,
               NETNAME_UMO = :QUM-NETNAME-UMO ,
               USERID_UMO  = :QUM-USERID-UMO
               WHERE ENTIOFI  = : MAE-ENTIOFI   AND
                   CUENTA     = : MAE-CUENTA    AND
