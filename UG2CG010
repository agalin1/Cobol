      *----------------------------------------------------------------*
      *   ALTA DE SERVICIOS AGROPECUARIOS LADO BBVA                    *
      *   REGISTRA EN EL MCC LA COMISION                               *
      *----------------------------------------------------------------*
       231-ALTA-SERVI-AGRO-BBVA.

           SET NO-SERVI-AGRO-BBVA       TO TRUE
           INITIALIZE  QGECCOM0-01
           MOVE 'C'                     TO RCO-MODO-CONSUL
           MOVE MAE-ENTIOFI             TO RCO-NUMCTA(1:8)
           MOVE MAE-DIGICCC1            TO RCO-NUMCTA(9:1)
           MOVE MAE-DIGICCC2            TO RCO-NUMCTA(10:1)
           MOVE MAE-CUENTA              TO RCO-NUMCTA(11:10)
           MOVE SPACES                  TO RCO-TIPO-IDENT
           MOVE SPACES                  TO RCO-NUME-IDENT
           MOVE SPACES                  TO RCO-DIG-IDENT
           MOVE CAA-CENTRO-CONT         TO RCO-CEN-GESTOR
           MOVE ZEROS                   TO RCO-NUM-MOVTO
                                           RCO-NUM-MOVTO-B
           MOVE '96'                    TO RCO-PRODUCTO
           MOVE MAE-SUBPRO              TO RCO-SUBPRODU
           MOVE 'UG'                    TO RCO-APLICCOM
           MOVE WS-CLAVE-COMI           TO RCO-CLAVECOM
           MOVE MAE-IMPCONCE            TO RCO-IMPORTE
           MOVE 1                       TO RCO-UNIDADES
           MOVE 1                       TO RCO-CANTIDAD
           MOVE 'A'                     TO RCO-TIPO-LLAMADO
           MOVE SPACES                  TO RCO-OPCION-REFI
           MOVE SPACES                  TO RCO-CONCEPTO-REFI
           MOVE SPACES                  TO RCO-REGIMEN-REFI
           MOVE CAA-ENTIDAD             TO RCO-CAA-ENTIDAD
           MOVE CAA-CENTRO-CONT         TO RCO-CAA-CENTRO-CONT
           MOVE CAA-FECHA-OPER2         TO RCO-CAA-FECHA-OPER2
           MOVE CAA-HORA-TRANSED        TO RCO-CAA-HORA-OPERA
           MOVE CAA-USERID              TO RCO-CAA-USERID
           MOVE 'UG2CG010'              TO RCO-CAA-NETNAME
           MOVE ZEROS                   TO RCO-IMPOR-COMISION
                                           RCO-IMPOR-IVA
                                           RCO-IMPOR-LIBRE
           MOVE SPACES                  TO RCO-INDIC-LIBRE
                                           RCO-DESCR-LIBRE
           EXEC CICS
             LINK PROGRAM ('QG7CCOM0')
             COMMAREA (QGECCOM0-01)
             NOHANDLE
           END-EXEC

           EVALUATE RCO-RETORNO
              WHEN CON-COMI-OK

                IF RCO-IMPORTE-TEORI < ZEROS
                   MOVE CON-ERR-VARIOS              TO CAA-COD-ERROR
                   MOVE 'SER-AGRO <= 0'             TO CAA-VAR1-ERROR
                   MOVE 'RUTINA QG7CCOM0'           TO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
                END-IF
                IF RCO-IMP-IVA-TEOR < ZEROS
                   MOVE CON-ERR-VARIOS              TO CAA-COD-ERROR
                   MOVE 'IVA SER-AGRO <= 0'         TO CAA-VAR1-ERROR
                   MOVE 'RUTINA QG7CCOM0'           TO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
                END-IF

                SET SI-SERVI-AGRO-BBVA       TO TRUE

              WHEN CON-DTOS-IMCOMPLETOS
                 MOVE CON-ERR-VARIOS                 TO CAA-COD-ERROR
                 MOVE 'FALTAN DATOS'                 TO CAA-VAR1-ERROR
                 MOVE 'RUTINA QG7CCOM0'              TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              WHEN CON-ERROR-IMPORTE-NEGAT
                 MOVE CON-ERR-VARIOS                 TO CAA-COD-ERROR
                 MOVE 'SALDO NEGATIVO'               TO CAA-VAR1-ERROR
                 MOVE 'RUTINA QG7CCOM0'              TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              WHEN CON-NO-RELACION-PRODCOMI
                 MOVE CON-ERR-VARIOS                 TO CAA-COD-ERROR
                 MOVE 'PRODUCTO-COMISION'            TO CAA-VAR1-ERROR
                 MOVE 'RUTINA QG7CCOM0'              TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              WHEN CON-ERROR-IVA-BR7CRRF0
                 MOVE CON-ERR-VARIOS                 TO CAA-COD-ERROR
                 MOVE 'COMISION IVA'                 TO CAA-VAR1-ERROR
                 MOVE 'RUTINA QG7CCOM0'              TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              WHEN OTHER
                 MOVE RCO-RETORNO                    TO CAA-COD-ERROR
                 MOVE RCO-VARIABLE                   TO CAA-VAR1-ERROR
                 MOVE 'QG7CCOM0'                     TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.

