      *----------------------------------------------------------------*
       230-CONSULTAR-SERVICIOS-AGRO.

              INITIALIZE UGTCMAG
              SET NO-EXISTE-UGDTMAG  TO TRUE
              MOVE MAE-ENTIOFI       TO MAG-ENTIOFI
              MOVE MAE-CUENTA        TO MAG-CUENTA

              EXEC SQL
                SELECT FEOPER,
                       CODPROV,
                       TIPSER,
                       PORCOM,
                       IMPCOMTOT,
                       PORIVA,
                       IMPIVA,
                       PORRFTE,
                       IMPRFTE,
                       PORCOMBAN,
                       IMPCOMBAN,
                       PORCOMPROV,
                       IMPCOMPROV,
                       INDCOMAPRO,
                       CENTRO_UMO,
                       USERID_UMO,
                       NETNAME_UMO
                INTO :MAG-FEOPER,
                     :MAG-CODPROV,
                     :MAG-TIPSER,
                     :MAG-PORCOM,
                     :MAG-IMPCOMTOT,
                     :MAG-PORIVA,
                     :MAG-IMPIVA,
                     :MAG-PORRFTE,
                     :MAG-IMPRFTE,
                     :MAG-PORCOMBAN,
                     :MAG-IMPCOMBAN,
                     :MAG-PORCOMPROV,
                     :MAG-IMPCOMPROV,
                     :MAG-INDCOMAPRO,
                     :MAG-CENTRO-UMO,
                     :MAG-USERID-UMO,
                     :MAG-NETNAME-UMO
                FROM UGDTMAG
                WHERE
                      ENTIOFI = :MAG-ENTIOFI  AND
                      CUENTA  = :MAG-CUENTA
              END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK
                 SET SI-EXISTE-UGDTMAG  TO TRUE
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
      *@COL64-I
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'ERR SELECT EN TABLA '  TO CAA-VAR1-ERROR
                 MOVE 'UGDTMAG 1 '            TO CAA-VAR2-ERROR(1:10)
                 MOVE SQLCODE                 TO CAA-VAR2-ERROR(11: )
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
