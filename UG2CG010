       23131-INSERT-UMOV.
      *
           MOVE '0'                           TO MOV-UGYINCOR.
      *
           EXEC SQL
              INSERT INTO UGDTMOV
                (ENTIOFI, CUENTA, FECONTA, CENTRO_PAG,
                 CLAOPER, SECUMOV, FEOPER,  FEVALOR, ENTIOPE, CLACON,
                 IMPMOVI, INDRETRO, FELIQ, SALREAL,UGYINCOR,UGYINDIF,
