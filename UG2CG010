      *   ABONO CONSULTADO LA SECCION                                  *
      ******************************************************************
       10180-CONSULTA-BENEFI.
      *
      *
           INITIALIZE SW-FIN-CURSOR-T37
      *COL215-I
                      SW-FIN-CURSOR2
      *COL215-F
           MOVE '7060'                        TO    T37-SECCION
      *
           PERFORM 10181-ABRIR-CURSOR-T37
           PERFORM 10182-FETCH-CURSOR-T37
                    UNTIL SW-SI-FIN-CURSOR OR WS-I-T37 > 999
           PERFORM 10183-CERRAR-CURSOR-T37.
      ******************************************************************
      *                       10181-ABRIR-CURSOR-T37                   *
      ******************************************************************
       10181-ABRIR-CURSOR-T37.
      *
              SET WS-I-T37                        TO 1
              EXEC SQL
                  OPEN CURSOR-T37
              END-EXEC

              MOVE SQLCODE                     TO   DB2-RETURN-CDE

              IF NOT (DB2-OK AND SQLWARN0 = SPACES)
                 IF DB2-RECATR1 OR DB2-RECATR2
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'RECURSO ATRAPADO '    TO CAA-VAR1-ERROR
                    MOVE 'INTENTE LUEGO'        TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'ABRIR UGDTT37'        TO CAA-VAR1-ERROR
                    MOVE 'SQLCODE '             TO CAA-VAR2-ERROR(1:8)
                    MOVE DB2-RETURN-CDE         TO CAA-VAR2-ERROR(9:)
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
              END-IF.
      ******************************************************************
      *                       10182-FETCH-CURSOR-T37                   *
      ******************************************************************
       10182-FETCH-CURSOR-T37.

              EXEC SQL
                  FETCH CURSOR-T37
                  INTO
                    :T37-ELEMENTO,
                    :T37-RESTO
              END-EXEC

              MOVE SQLCODE                     TO   DB2-RETURN-CDE

              IF NOT (DB2-OK AND SQLWARN0 = SPACES)
                 IF (DB2-NOTFND AND SQLWARN0 = SPACES)
                    SET SW-SI-FIN-CURSOR        TO TRUE
                 ELSE
                    IF DB2-RECATR1 OR DB2-RECATR2
                       MOVE 'UGE0939'           TO CAA-COD-ERROR
                       MOVE 'RECURSO ATRAPADO ' TO CAA-VAR1-ERROR
                       MOVE 'INTENTE LUEGO'     TO CAA-VAR2-ERROR
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                    ELSE
                       MOVE 'UGE0939'           TO CAA-COD-ERROR
                       MOVE 'FETCH UGDTT37'     TO CAA-VAR1-ERROR
                       MOVE 'SQLCODE '          TO CAA-VAR2-ERROR(1:8)
                       MOVE DB2-RETURN-CDE      TO CAA-VAR2-ERROR(9:)
                       PERFORM 999999-ROLLBACK
                       PERFORM 3-FINAL-PROGRAMA
                    END-IF
                 END-IF
              ELSE
                 MOVE T37-ELEMENTO(1:1)      TO WS-TIP-BENEFIC(WS-I-T37)
                 MOVE T37-ELEMENTO(2:15)     TO WS-IDE-BENEFIC(WS-I-T37)
                 MOVE T37-ELEMENTO(17:1)     TO WS-DIG-BENEFIC(WS-I-T37)
                 MOVE T37-RESTO(1:4)         TO WS-COD-BAN(WS-I-T37)
                 MOVE T37-RESTO(6:2)         TO WS-TIP-CTA(WS-I-T37)
      *COL165-MALD5-I
      *          MOVE T37-RESTO(9:14)        TO WS-NUM-CTA(WS-I-T37)
      *          MOVE T37-RESTO(24:20)       TO WS-NOM-BEN(WS-I-T37)
                 MOVE T37-RESTO(9:16)        TO WS-NUM-CTA(WS-I-T37)
                 MOVE T37-RESTO(26:20)       TO WS-NOM-BEN(WS-I-T37)
      *COL165-MALD5-I
                 SET WS-I-T37 UP BY 1
                 ADD 1                       TO WS-CONT-T37
              END-IF.
      ******************************************************************
      *                   10183-CERRAR-CURSOR-T37                      *
      ******************************************************************
       10183-CERRAR-CURSOR-T37.
      *
              EXEC SQL
                 CLOSE CURSOR-T37
              END-EXEC

              MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
              IF DB2-OK
                 CONTINUE
              ELSE
                 IF DB2-RECATR1 OR DB2-RECATR2
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'RECURSO ATRAPADO '    TO CAA-VAR1-ERROR
                    MOVE 'INTENTE LUEGO'        TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'CERRAR UGDTT37'        TO CAA-VAR1-ERROR
                    MOVE 'SQLCODE '             TO CAA-VAR2-ERROR(1:8)
                    MOVE DB2-RETURN-CDE         TO CAA-VAR2-ERROR(9:)
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
             END-IF.
      ******************************************************************00066200
      *                    10190-INSERTAR-CYA                          *00066300
      *   SE LLAMA A LA RUTINA QUE INSERTA LA PETICION DE LA TRANSFE-  *
      *   RENCIA EN LAS TABLAS DE CARGOS Y ABONOS                      *
      ******************************************************************
       10190-INSERTAR-CYA.

           INITIALIZE CAWC0030-01
