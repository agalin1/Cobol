      *             MOVE 'SELECT UGDTPRT'          TO CAA-VAR2-ERROR
      *             MOVE SQLCODE                   TO DB2-RETURN-CDE
      *             PERFORM 999999-ROLLBACK
      *COL44-F      PERFORM 3-FINAL-PROGRAMA
      *             PERFORM 999999-ABEND-DB2
      *@COL64-F
                 END-IF
              END-IF.
             EJECT.

      ******************************************************************
      *                  000506-BUSCA-DATOS2-CAB1                      *
      ******************************************************************
      * BUSCA BONIFICACION MAX, SUMANDO SECCIONES T001 Y T002 DE
      * LA TABLA UGDTPTP
       000506-BUSCA-DATOS2-CAB1.
              MOVE 0              TO W-PTP-T001-PUNTOS
              MOVE PRT-PORTAFOLIO TO PTP-ELEMENTO
              EXEC SQL
                   SELECT
                            PUNTOS
                   INTO
                       :PTP-PUNTOS
                FROM UGDTPTP
                WHERE
                      TABLA     =  'T001'       AND
                      ELEMENTO  = :PTP-ELEMENTO
              END-EXEC
              MOVE SQLCODE  TO DB2-RETURN-CDE
              IF DB2-OK
                 MOVE PTP-PUNTOS  TO W-PTP-T001-PUNTOS
              ELSE
                 IF DB2-NOTFND
                    MOVE 'UGE0939'                 TO CAA-COD-ERROR
                    MOVE 'NO ENCUENTRA PORTAF'     TO CAA-VAR1-ERROR
                    MOVE 'EN UGDTPTP SEC T001'     TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    IF NOT DB2-OK
      *@COL64-I
                     MOVE 'UGE0939'              TO CAA-COD-ERROR
                     MOVE 'ERR SELECT EN TABLA ' TO CAA-VAR1-ERROR
                     MOVE 'UGDTPTP 4 '           TO CAA-VAR2-ERROR(1:10)
                     MOVE SQLCODE                TO CAA-VAR2-ERROR(11: )
                     PERFORM 999999-ROLLBACK
                     PERFORM 3-FINAL-PROGRAMA
      *                MOVE 'UGE0059'              TO CAA-VAR1-ERROR
      *                MOVE 'SELECT UGDTPTP-T001'  TO CAA-VAR2-ERROR
      *                MOVE SQLCODE                TO DB2-RETURN-CDE
      *COL44-I: ESTANDARIZAR MANEJO ERRORES
      *                 PERFORM 999999-ROLLBACK
      *COL44-F          PERFORM 3-FINAL-PROGRAMA
      *                PERFORM 999999-ABEND-DB2
      *@COL64-F
                    END-IF
                 END-IF
              END-IF
      *
              PERFORM 000510-CAL-PUNTOS-T002-PTP.

      ******************************************************************
      *                  000510-CAL-PUNTOS-T002-PTP                    *
      ******************************************************************
       000510-CAL-PUNTOS-T002-PTP.
              MOVE 0                    TO W-SUM-PUNTOS
              MOVE 0                    TO W-Y
              SET W88-NO-CAMBIO-PORTAFO TO TRUE
              PERFORM 000510-ABRIR-CURSOR-T002
              PERFORM 000510-LEE-T002-PTP  UNTIL W88-CAMBIO-PORTAFO
              PERFORM 000320-CERRAR-CURSOR-T002.

       000510-ABRIR-CURSOR-T002.
              INITIALIZE UGTCPTP
              MOVE PRT-PORTAFOLIO  TO WS-ELEM-PORTAF
              MOVE ALL '%'         TO WS-ELEM-SUBPROD
              MOVE ALL '%'         TO WS-ELEM-RESTO
              MOVE WS-ELEMENTO     TO PTP-ELEMENTO
               EXEC SQL
                    OPEN CUR-T002
               END-EXEC
               MOVE SQLCODE TO DB2-RETURN-CDE
               IF NOT DB2-OK
                  MOVE 'UGE0939'                 TO CAA-COD-ERROR
                  MOVE 'NO ENCUENTRA CONDIC'     TO CAA-VAR1-ERROR
                  MOVE 'DE PORTAF. SEC T002'     TO CAA-VAR2-ERROR
                  PERFORM 999999-ROLLBACK
                  PERFORM 3-FINAL-PROGRAMA
               END-IF.

       000510-LEE-T002-PTP.
              EXEC SQL
                   FETCH CUR-T002 INTO
                   :PTP-ELEMENTO,
                   :PTP-DIAS-NOCON,
                   :PTP-DEF-INBAJA,
                   :PTP-PUNTOS    ,
                   :PTP-DESCRIPCION
      *NOVA01-INI SE COLOCO EL CAMPO DESCRIPCION  NOVA01-FIN
              END-EXEC
              MOVE SQLCODE  TO DB2-RETURN-CDE
              IF DB2-NOTFND
                 SET W88-CAMBIO-PORTAFO TO TRUE
              ELSE
                 IF DB2-OK
                    ADD 1 TO W-Y
      *NOVA01-INI
                    MOVE PTP-DESCRIPCION(1:9)  TO W-MINIMO(W-Y)
                    MOVE PTP-DESCRIPCION(10:9) TO W-MAXIMO(W-Y)
                    MOVE PTP-DESCRIPCION(19:2) TO W-PERIODO(W-Y)
      *NOVA01-FIN
                    COMPUTE W-SUM-PUNTOS =
                       W-SUM-PUNTOS + ( PTP-PUNTOS * PTP-DIAS-NOCON )
      *COL25-I
                    COMPUTE WS-PUNTOS-F = PTP-PUNTOS * PTP-DIAS-NOCON
                    MOVE WS-PUNTOS-F          TO W-PTO-PROD(W-Y)
      *NOVA-INI
                    IF W-Y < 11 THEN
                     COMPUTE W-TOTAL-BONI = W-TOTAL-BONI
                                           + WS-PUNTOS-F
                    END-IF
      *NOVA-FIN
                    ADD 1                     TO WS-CONTADOR1
      *COL25-F
      *COL27-I
                    IF WS-BAND-HORIZONTE = 1
                       IF PTP-ELEMENTO(7:3) NOT EQUAL '50C'
                          MOVE 0              TO WS-BAND-HORIZONTE
                       END-IF
                    END-IF
      *COL27-F
      *NOVA01-INI
                    IF W-Y < 11
      *NOVA01-FIN
                       MOVE PTP-ELEMENTO(7:8) TO W-COD-SUBP(W-Y)
                       MOVE SPACES            TO W-DES-SUBP(W-Y)
                    END-IF
                 ELSE
      *@COL64-I
                    MOVE 'UGE0939'                TO CAA-COD-ERROR
                    MOVE 'ER FETC CUR-T002 EN '   TO CAA-VAR1-ERROR
                    MOVE 'UGDTPTP '               TO CAA-VAR2-ERROR(1:8)
                    MOVE SQLCODE                  TO CAA-VAR2-ERROR(9: )
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
      *             MOVE 'UGE0059'                 TO CAA-VAR1-ERROR
      *             MOVE 'OPEN CUR-T002 UGDTPTP'   TO CAA-VAR2-ERROR
      *             MOVE SQLCODE                   TO DB2-RETURN-CDE
      *COL44-I: ESTANDARIZAR MANEJO DE ERRORES
      *             PERFORM 999999-ROLLBACK
      *COL44-F      PERFORM 3-FINAL-PROGRAMA
      *             PERFORM 999999-ABEND-DB2
      *@COL64-F
                 END-IF
              END-IF.

       000320-CERRAR-CURSOR-T002.
            EXEC SQL
                 CLOSE CUR-T002
            END-EXEC
            EVALUATE SQLCODE
               WHEN ZEROS
                  CONTINUE
               WHEN OTHER
      *@COL64-I
                  MOVE 'UGE0939'                 TO CAA-COD-ERROR
                  MOVE 'ERR CER CUR-T002 EN '    TO CAA-VAR1-ERROR
                  MOVE 'UGDTPTP '                TO CAA-VAR2-ERROR(1:8)
                  MOVE SQLCODE                   TO CAA-VAR2-ERROR(9: )
                  PERFORM 999999-ROLLBACK
                  PERFORM 3-FINAL-PROGRAMA
      *           MOVE 'UGE0059'                 TO CAA-VAR1-ERROR
      *           MOVE 'CLOSE CUR-T002 PTP'      TO CAA-VAR2-ERROR
      *           MOVE SQLCODE                   TO DB2-RETURN-CDE
      *COL44-I: ESTANDARIZAR MANEJO DE ERRORES
      *           PERFORM 999999-ROLLBACK
      *COL44-F    PERFORM 3-FINAL-PROGRAMA
      *           PERFORM 999999-ABEND-DB2
      *@COL64-F
            END-EVALUATE.

      ******************************************************************
      *                  000780-BUSCA-DESC-CODIGOS                     *
      ******************************************************************
       000780-BUSCA-DESC-CODIGOS.
              MOVE 1 TO W-Y
      *@NOVA01 - INICIO
      *       PERFORM UNTIL W-Y > 5 OR W-COD-SUBP(W-Y) = SPACES
              PERFORM UNTIL W-Y > 10 OR W-COD-SUBP(W-Y) = SPACES
      *@NOVA01 - FIN
                 MOVE W-COD-SUBP(W-Y) TO PTP-ELEMENTO
                 PERFORM 000781-SELECT-T005
                 ADD 1 TO W-Y
              END-PERFORM.

      *@COL56-I
      ******************************************************************
      *                  00079A-PLAZO-CONTRATACION                     *
      ******************************************************************
       00079A-PLAZO-CONTRATACION.

              INITIALIZE UGTCT37
              MOVE '9071'                       TO T37-SECCION
              MOVE WS-PORTAFOLIO                TO T37-ELEMENTO(1:6)

                EXEC SQL
                    SELECT
                          RESTO
                      INTO
                          :T37-RESTO
                      FROM UGDTT37
                       WHERE SECCION  = :T37-SECCION
                       AND ELEMENTO   = :T37-ELEMENTO
                END-EXEC

              MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
                 IF DB2-OK AND SQLWARN0 = SPACES
                    MOVE T37-RESTO(1:3)      TO WS-PLAZO-PORTAFOLIO
                    MOVE WS-PLAZO-PORTAFOLIO TO FC10-PLAZO
                 ELSE
                    IF DB2-NOTFND AND SQLWARN0 = SPACES
                       MOVE PRO-PLAZOMAX   TO   WS-PLAZOMAX
                       EVALUATE WS-COD-PLAZOMAX
                           WHEN  3
                               MULTIPLY WS-PER-PLAZOMAX  BY 12
                                        GIVING WS-MESES-PLAZOMAX
                               IF WS-MESES-PLAZOMAX > 999
                                   MOVE 999      TO WS-PER-PLAZOMAX
                               END-IF
                           WHEN  2
                               MOVE WS-PER-PLAZOMAX  TO
                               WS-MESES-PLAZOMAX
                           WHEN  1
                               DIVIDE WS-PER-PLAZOMAX    BY 30
                                        GIVING WS-MESES-PLAZOMAX
                       END-EVALUATE
                       MOVE WS-MESES-PLAZOMAX   TO  FC10-PLAZO
                    ELSE
      *@COL64-I
                     MOVE 'UGE0939'              TO CAA-COD-ERROR
                     MOVE 'ERR SELECT EN TABLA ' TO CAA-VAR1-ERROR
                     MOVE 'UGDTT37 6 '           TO CAA-VAR2-ERROR(1:10)
                     MOVE SQLCODE                TO CAA-VAR2-ERROR(11: )
                     PERFORM 999999-ROLLBACK
                     PERFORM 3-FINAL-PROGRAMA
      *                MOVE 'UGDTT37'               TO CAA-VAR1-ERROR
      *                MOVE 'SELECT UGDTT37'        TO CAA-VAR2-ERROR
      *                PERFORM 999999-ABEND-DB2
      *@COL64-F
                    END-IF
                 END-IF.
      *@COL56-F
      ******************************************************************
      *                  000781-SELECT-T005                            *
      ******************************************************************
       000781-SELECT-T005.
              EXEC SQL
                   SELECT  DEF_INBAJA, DESCRIPCION
                     INTO  :PTP-DEF-INBAJA, :PTP-DESCRIPCION
                     FROM  UGDTPTP
                    WHERE  TABLA    = 'T005' AND
                           ELEMENTO = :PTP-ELEMENTO
              END-EXEC
              MOVE SQLCODE  TO DB2-RETURN-CDE
              IF DB2-OK
                 MOVE PTP-DESCRIPCION TO W-DES-SUBP(W-Y)
              ELSE
                 IF DB2-NOTFND
                    MOVE 'SD'                      TO W-DES-SUBP(W-Y)
                 ELSE
                    IF NOT DB2-OK
      *@COL64-I
                     MOVE 'UGE0939'              TO CAA-COD-ERROR
                     MOVE 'ERR SELECT EN TABLA ' TO CAA-VAR1-ERROR
                     MOVE 'UGDTPTP 5 '           TO CAA-VAR2-ERROR(1:10)
                     MOVE SQLCODE                TO CAA-VAR2-ERROR(11: )
                     PERFORM 999999-ROLLBACK
                     PERFORM 3-FINAL-PROGRAMA
      *                MOVE 'UGE0059'              TO CAA-VAR1-ERROR
      *                MOVE 'SELECT UGDTPTP-T005'  TO CAA-VAR2-ERROR
      *                MOVE SQLCODE                TO DB2-RETURN-CDE
