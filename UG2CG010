                 :MOV-MONEDA,     :MOV-LIBRE-IMP1,   :MOV-LIBRE-IMP2,
                 :MOV-NUMER-MOV,  :MOV-NUMCHEQ,      :MOV-LIBRE-CAR1,
      *EFR01-I
                 : MOV-IND-MARCA3,
      *EFR01-F
                 :MOV-LIBRE-IMP3)
           END-EXEC
