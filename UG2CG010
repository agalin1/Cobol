      **************************************************************
      *             301-EXISTE-UGDTCHA                             *
      * SE VALIDA ACTUALIZACION DE FINALIZACION - ETAPA GRABACION  *
      **************************************************************
       301-EXISTE-UGDTCHA.
              EXEC SQL
                 SELECT FECINI,
                        FECFIN  ,
                        HORAFIN
                   INTO
                        :CHA-FECINI  ,
                        :CHA-FECFIN  ,
                        :CHA-HORAFIN
