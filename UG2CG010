                   SET NO-RETANQUEO TO TRUE
      *@COL121-I
                   SET NO-RETOPECRE TO TRUE
      *@COL121-F
                END-IF
             ELSE
                IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                    SET NO-RETANQUEO TO TRUE
                ELSE
                    MOVE 'UGE0939'                  TO CAA-COD-ERROR
                    MOVE 'ERR SELECT LOG RETA '     TO CAA-VAR1-ERROR
                    MOVE SQLCODE                    TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
