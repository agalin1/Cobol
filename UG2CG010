      *COL160-MALD4-I
      *    MOVE MAE-ENTIDAD-VIN            TO WC30-CTA-ORIGEN(1:4)
      *    MOVE MAE-CENTRO-VIN             TO WC30-CTA-ORIGEN(5:4)
      *    MOVE '00'                       TO WC30-CTA-ORIGEN(9:2)
      *    MOVE MAE-CUENTA-VIN             TO WC30-CTA-ORIGEN(11:10)
           MOVE WS-CTAESP-ACH(1:4)         TO WC30-CTA-ORIGEN(1:4)
           MOVE WS-CTAESP-ACH(5:4)         TO WC30-CTA-ORIGEN(5:4)
           MOVE '00'                       TO WC30-CTA-ORIGEN(9:2)
           MOVE WS-CTAESP-ACH(9:)          TO WC30-CTA-ORIGEN(11:10)
      *COL160-MALD4-F
           MOVE '0'                        TO WC30-BCO-DESTINO(1:1)
           MOVE WS-CTAABO-ACH(1:3)         TO WC30-BCO-DESTINO(2:3)
           MOVE WS-CTAABO-ACH(5:)          TO WC30-CTA-DESTINO
           MOVE '0'                        TO WC30-TIPO-CTA(1:1)
           MOVE WS-CTAABO-ACH(4:1)         TO WC30-TIPO-CTA(2:1)
           MOVE CAA-FECHA-CONT2            TO WC30-FECHA
      *COL172-I
                IF SW-FLEXIBLE-SI OR SW-FLEXIBLE-VEHI-SI
                   COMPUTE WS-IMPORTE = WS-IMPORTE - MPF-IMPINI-SUBV
                END-IF
      *COL172-F
           MOVE WS-IMPORTE                 TO WC30-IMPORTE
           MOVE '00101'                    TO WC30-NUMCLIEN
           MOVE '00000860003020'           TO WC30-DOC-ORD
           MOVE 'BBVA COLOMBIA '           TO WC30-NOMBRE-ORD
           MOVE '0000000018'               TO WC30-CANAL
           MOVE '1'                        TO WC30-ORIGEN-SOP
           MOVE '01'                       TO WC30-CODIGO

           CALL 'CA9C0030' USING CAWC0030-01

           IF WC30-COD-RESPUESTA NOT = '00'
              MOVE 'UGE0939'              TO CAA-COD-ERROR
              MOVE 'ERROR LLAMADO    '    TO CAA-VAR1-ERROR
              MOVE 'RUT CA9C0030     '    TO CAA-VAR2-ERROR
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      ******************************************************************
      *                       10200-INSERTAR-MOD                       *
      ******************************************************************
       10200-INSERTAR-MOD.
           MOVE 'U043'                         TO MOD-CODTRAN
           MOVE 'FORMACH'                      TO MOD-TABLA
           MOVE SPACES                         TO WS-CLAVE
           MOVE WS-CCC-ENTIOFI                 TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA                  TO WS-CUENTA
           MOVE WS-CLAVE                       TO MOD-CLAVE
           MOVE CAA-NETNAME-CONT               TO MOD-NETNAME-UMO
           MOVE CAA-USERID                     TO MOD-USERID-UMO
           MOVE CAA-ENTIDAD                    TO MOD-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT                TO MOD-CENTRO-UMO
           MOVE WS-IMPORTE                     TO MOD-VALOR-ANT-NUM
           MOVE WC30-NUMCLIEN                  TO MOD-VALOR-ANT(15:8)
           MOVE WC30-FECHA                     TO MOD-VALOR-ANT(23:10)
           MOVE WC30-SOPORTE                   TO MOD-VALOR-ANT(33:5)
           MOVE WC30-TIPO-CTA                  TO MOD-VALOR-ANT(38:2)
           MOVE WC30-BCO-DESTINO               TO MOD-VALOR-ANT(40:4)
           MOVE WC30-CTA-DESTINO               TO MOD-VALOR-ACT(1:17)
           MOVE WC30-NOMBRE-ORD                TO MOD-VALOR-ACT(18:20)
           MOVE WC30-CANAL                     TO MOD-VALOR-ACT(38:10)
           MOVE WC30-DOC-BEN                   TO MOD-COLUMNA
           MOVE SPACES                         TO MOD-MONEDA

           EXEC SQL
             INSERT INTO UGDTMOD(
               CODTRAN,
