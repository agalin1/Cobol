      ******************************************************************
      *                                                                *
      *                 2801A4-CONSULTA-LEASING                        *
      * _____________________________________________________________  *
      *    CONSULTA DATOS DEL LEASING PARA VALIDAR SI ESTA MARCADO     *
      **   COMO CANCELADO                                            ***
      ******************************************************************
       2801A4-CONSULTA-LEASING.

           EXEC SQL
             SELECT SUBPRO,
                    SALREAL,
                    SALTEOR,
                    IND_MARCA4
               INTO :WV-SUBPRO,
                    :WV-SALREAL,
                    :WV-SALTEOR,
                    :WV-IND-MARCA4
               FROM UGDTMAE
              WHERE ENTIOFI   = :WV-ENTIOFI      AND
                    CUENTA    = :WV-CUENTA
           END-EXEC
           EVALUATE SQLCODE
            WHEN ZEROS
             PERFORM 2801A41-VALIDA-SI-LEASING
             IF SI-LEASING-HABIT
              IF WV-SALREAL EQUAL ZEROS AND
                 WV-SALTEOR EQUAL ZEROS AND
                 WV-IND-MARCA4 EQUAL 'H'
               SET SI-LEASING-VALIDO        TO TRUE
              ELSE
               SET NO-LEASING-VALIDO        TO TRUE
              END-IF
             END-IF
            WHEN +100
             SET NO-LEASING-HABIT           TO TRUE
            WHEN OTHER
             MOVE 'UGE0939'                  TO CAA-COD-ERROR
             MOVE 'ERR SELECT EN TABLA '     TO CAA-VAR1-ERROR
             MOVE 'UGDTMAE G '               TO CAA-VAR2-ERROR(1:10)
             MOVE SQLCODE                    TO CAA-VAR2-ERROR(11: )
             PERFORM 999999-ROLLBACK
             PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE
           .
