      *    DOMINGO O FESTIVO, NO PERMITE REALIZAR EL PROCESO.          *
      ******************************************************************
      *
       210000-VALIDA-DIA-ACCESO.
      *
              INITIALIZE TCWC0400-01
              MOVE '1'                            TO W040-CDOPCIO
              MOVE CAA-FECHA-OPER2(9:2)           TO W040-FHTRAT1(1:2)
              MOVE '.'                            TO W040-FHTRAT1(3:1)
              MOVE CAA-FECHA-OPER2(6:2)           TO W040-FHTRAT1(4:2)
              MOVE '.'                            TO W040-FHTRAT1(6:1)
              MOVE CAA-FECHA-OPER2(1:4)           TO W040-FHTRAT1(7:4)
              MOVE '1'                            TO W040-TRSABADO
              MOVE '0'                            TO W040-TRATFEST
              MOVE CAA-ENTIDAD                    TO W040-CDEMPRES
      *
                 EXEC CICS LINK
                    PROGRAM ('TC2C1200')
                    COMMAREA (TCWC0400-01)
                 END-EXEC.

               IF W040-CDRETORN NOT = '00'
                  MOVE 'UGE3631'                 TO CAA-COD-ERROR
                  MOVE 'ERROR RUT.TC2C1200'      TO CAA-VAR1-ERROR
                  MOVE 'COD ERROR: '             TO CAA-VAR2-ERROR(1:12)
                  MOVE  W040-CDRETORN            TO CAA-VAR2-ERROR(13:)
                  PERFORM 300000-FINAL
               ELSE
                   IF W040-TIPODIA = 'H'
                      CONTINUE
                   ELSE
                      MOVE 'UGE0939'             TO CAA-COD-ERROR
                      MOVE 'DIA NO HABIL PARA'   TO CAA-VAR1-ERROR
                      MOVE 'ESTA OPERACION   '   TO CAA-VAR2-ERROR
                      PERFORM 300000-FINAL
                   END-IF
               END-IF.
      *
      *****************************************************************
