      *    PERMITE EL ACCESO A LA TABLA DONDE SE ENCUENTRAN LOS        *
      *    CONTRATOS DE PRESTAMO, UGDTMAE, PARA VER SI EXISTE DICHA    *
      *    CUENTA, SI ESTA APROBADA PENDIENTE DE FORMALIZAR.           *
      ******************************************************************
       230000-VALIDAR-CUENTA.
      *
              PERFORM 231000-LEER-UGDTMAE
              PERFORM 232000-LEER-TABLAS.
      *
      *****************************************************************
      *                 220000-LEER-UGDTREL                           *
      * SE LEE LA UGDTREL PARA TRAER EL DATO DEL CREDITO ANTERIOR     *
      *****************************************************************
       220000-LEER-UGDTREL.
              MOVE WS-CCC-ENTIOFI                TO REL-ENTIOFI
              MOVE WS-CCC-CUENTA                 TO REL-CUENTA
      *
              EXEC SQL
                 SELECT
                          ENTIOFI_REL, CUENTA_REL,
                          INDIMAT
                 INTO
                         :REL-ENTIOFI-REL, :REL-CUENTA-REL,
                         :REL-INDIMAT
                 FROM UGDTREL
                 WHERE ENTIOFI = :REL-ENTIOFI      AND
                       CUENTA  = :REL-CUENTA
              END-EXEC.
      *
              MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
              IF DB2-OK
                 IF REL-INDIMAT = '1' OR REL-INDIMAT = '7'
                    OR REL-INDIMAT = '8'
                      MOVE REL-ENTIOFI-REL        TO WS-CCC-ENTIOFI-ANT
                      MOVE REL-CUENTA-REL         TO WS-CCC-CUENTA-ANT
                 ELSE
                    MOVE 'UGE0939'                TO CAA-COD-ERROR
                    MOVE 'NO HAY REGISTRO EN '    TO CAA-VAR1-ERROR
                    MOVE 'REL NO PERMITE CAMBIO ' TO CAA-VAR2-ERROR
                     PERFORM 300000-FINAL
              ELSE
                 IF DB2-NOTFND AND SQLWARN0 = SPACES
                    MOVE 'UGE0939'                TO CAA-COD-ERROR
                    MOVE 'NO HAY REGISTRO EN '    TO CAA-VAR1-ERROR
                    MOVE 'REL NO PERMITE CAMBIO ' TO CAA-VAR2-ERROR
                    PERFORM 300000-FINAL
                 ELSE
                    MOVE 'UGE0939'               TO CAA-COD-ERROR
                    MOVE 'SELECT UGDTREL'        TO CAA-VAR1-ERROR
                    MOVE 'COD ERROR: '           TO CAA-VAR2-ERROR(1:12)
                    MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR(13:)
                    PERFORM 999999-ABEND-DB2
                 END-IF
              END-IF.
