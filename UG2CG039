      *
      ******************************************************************
      *                    251000-VALIDA-PLAZO                         *
      * SE DETERMINA SI EL PLAZO ES SUPERIOR DEL NUEVO CREDITO CON     *
      * RESPECTO AL ANTERIOR CREDITO, SI ES ASI SE REALIZA SCORING     *
      ******************************************************************
       251000-VALIDA-PLAZO.
      *
              MOVE DIS-PLAZO(2:3)                   TO WS-DIAS-ANT
              MOVE MAE-PLAZO(2:3)                   TO WS-DIAS-VIG
      *
              IF DIS-FECPRILIQ < DIS-FEULIQ
                 MOVE DIS-FECPRILIQ                 TO WS-DATA-INI
                 MOVE 1                             TO WS-NUM-PERI
                 PERFORM 251100-RUTINA-UR8CDFP0
                        UNTIL WS-DATA-INI(1:7) =  DIS-FEULIQ(1:7)
      *
                 PERFORM 251200-CALCULAR-NUM-PERI
      *
                 IF DIS-PLAZO NOT EQUAL SPACES
                     IF DIS-PLAZO(1:1) = '2'
                        COMPUTE WS-DIAS-ANT = WS-DIAS-ANT * 30
                     ELSE
                        IF DIS-PLAZO(1:1) = '3'
                           COMPUTE WS-DIAS-ANT = WS-DIAS-ANT * 360
                        END-IF
                     END-IF
                 ELSE
                     MOVE 'UGE0939'               TO CAA-COD-ERROR
                     MOVE 'EL PLAZO DEL CREDITO'  TO CAA-VAR1-ERROR
                     MOVE 'ANTERIOR ESTA VACIO '  TO CAA-VAR2-ERROR
                     PERFORM 300000-FINAL
                 END-IF
              ELSE
                 IF (DIS-FEULIQ  = DIS-FEFORMA)
                    OR (DIS-FEULIQ > DIS-FEFORMA AND
                        DIS-FEULIQ < DIS-FECPRILIQ)
                    MOVE  ZEROS                   TO WS-DIAS-ANT
                    MOVE  ZEROS                   TO WS-NUM-PERI
      *
                    PERFORM 251200-CALCULAR-NUM-PERI
      *
                 ELSE
                    IF DIS-FEULIQ = DIS-FECPRILIQ
                       MOVE DIS-FEFORMA           TO WS-DATA-INI
                       MOVE ZEROS                 TO WS-NUM-PERI
                       PERFORM 251100-RUTINA-UR8CDFP0
                              UNTIL WS-DATA-INI(1:7) =  DIS-FEULIQ(1:7)
      *
                       PERFORM 251200-CALCULAR-NUM-PERI
      *
                       IF DIS-PLAZO NOT EQUAL SPACES
                           IF DIS-PLAZO(1:1) = '2'
                              COMPUTE WS-DIAS-ANT = WS-DIAS-ANT * 30
                           ELSE
                              IF DIS-PLAZO(1:1) = '3'
                                 COMPUTE WS-DIAS-ANT = WS-DIAS-ANT * 360
                              END-IF
                           END-IF
                       ELSE
                          MOVE 'UGE0939'               TO CAA-COD-ERROR
                          MOVE 'EL PLAZO DEL CREDITO'  TO CAA-VAR1-ERRORR
                          MOVE 'ANTERIOR ESTA VACIO '  TO CAA-VAR2-ERRORR
                          PERFORM 300000-FINAL
                       END-IF
                    ELSE
                       MOVE 'UGE0939'               TO CAA-COD-ERROR
                       MOVE 'ERROR EN FECHAS DEL '  TO CAA-VAR1-ERROR
                       MOVE 'ANTERIOR CREDITO    '  TO CAA-VAR2-ERROR
                       PERFORM 300000-FINAL
                    END-IF
                 END-IF
              END-IF
      *
              IF MAE-PLAZO NOT EQUAL SPACES
                  IF MAE-PLAZO(1:1) = '2'
                     COMPUTE WS-DIAS-VIG = WS-DIAS-VIG * 30
                  ELSE
                     IF MAE-PLAZO(1:1) = '3'
                        COMPUTE WS-DIAS-VIG = WS-DIAS-VIG * 360
                     END-IF
                  END-IF
              ELSE
                  MOVE 'UGE0939'               TO CAA-COD-ERROR
                  MOVE 'EL PLAZO DEL CREDITO'  TO CAA-VAR1-ERROR
                  MOVE 'NUEVO ESTA VACIO '     TO CAA-VAR2-ERROR
                  PERFORM 300000-FINAL
              END-IF
      *
              COMPUTE  WS-DIAS-TOTAL = WS-NUM-PERI + WS-DIAS-VIG
      *
              IF WS-DIAS-TOTAL > WS-DIAS-ANT
                 MOVE 'S'                      TO S039-INDSCOR
 DMLG                                             WS-IND-MARCA1
              ELSE
                 MOVE 'N'                      TO S039-INDSCOR
 DMLG                                             WS-IND-MARCA1
              END-IF
      * EL PLAZO QUE SE DEJO COMO MESA ES DE MAXIMO 20 A┬ªOS, NO FUE
      * SOLO PARA VERIFICAR QUE LA SUMA DEL PLAZO DEL PRIMER CREDITO MAS
      * EL SEGUNDO NO SUPEREN LOS 20 A┬ªOS, SINO BASICAMENTE PARA QUE EL
      * CLIENTE PUDIERA TOMAR UN PLAZO MAYOR Y COMO CONSECUENCIA DE ESTA
      * AMPLIACION DE PLAZO SE ACTIVE EL SCORING.
      * ----- COMENTARIO REALIZADO  POR EL DEPTO DE NEGOCIOS
      *
              COMPUTE WS-DIAS-MAXIMO = 20 * 360
      *COL02-I
      *CONSULTAMOS EL PLAZO MAXIMO PARA CREDITOS HIPOTECARIOS
              MOVE SPACES                    TO T37-ELEMENTO
                                                T37-SECCION
              MOVE 'HPLAZO'                  TO T37-ELEMENTO
              MOVE '0017'                    TO T37-SECCION
              PERFORM 252000-BUSCAR-UGDTT37
              IF T37-RESTO(1:3) EQUAL (SPACES OR LOW-VALUES)
                 OR T37-RESTO(1:3) IS NOT NUMERIC
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                 MOVE 'PLAZO NO PARAMETIZA.' TO CAA-VAR1-ERROR
                 MOVE 'EN UMTA SECCION 0017' TO CAA-VAR2-ERROR
                 PERFORM 300000-FINAL
              ELSE
                 IF T37-RESTO(1:3) IS NUMERIC
                    MOVE T37-RESTO(1:3)      TO WS-PLAZO-MAX-MESES
                    DIVIDE WS-PLAZO-MAX-MESES BY 12
                                           GIVING WS-PLAZO-MAX-ANOS
                 END-IF
              END-IF
      *
              IF WS-PLAZO-MAX-ANOS IS NUMERIC
                 MULTIPLY WS-PLAZO-MAX-ANOS BY 360
                                         GIVING WS-PLAZO-MAX-DIAS
              ELSE
                 MOVE ZEROS                 TO WS-PLAZO-MAX-DIAS
              END-IF
              IF WS-DIAS-TOTAL > WS-PLAZO-MAX-DIAS
                MOVE 'UGE0939'              TO CAA-COD-ERROR
                MOVE 'PLAZO SUPERA '        TO CAA-VAR1-ERROR(1:13)
                MOVE WS-PLAZO-MAX-ANOS      TO CAA-VAR1-ERROR(14:2)
                MOVE ' A#OS'                TO CAA-VAR1-ERROR(16:5)
                MOVE 'DESDE SU INICIO    '  TO CAA-VAR2-ERROR
                PERFORM 300000-FINAL
              END-IF
              .
      *       IF WS-DIAS-TOTAL >  WS-DIAS-MAXIMO
      *          MOVE 'UGE0939'                 TO CAA-COD-ERROR
      *          MOVE 'PLAZO TOTAL SUPERIOR'    TO CAA-VAR1-ERROR
      *          MOVE 'A 20 A┬ªOS  '             TO CAA-VAR2-ERROR(1:12)
      *          PERFORM 300000-FINAL
