      *@COL05-F
              MOVE MAE-SALTEOR                   TO WS-SALDO-VIVO
      *@COL05-I
           ELSE
              IF MAE-SITPRES = '8'
                 MOVE MAE-IMPCONCE               TO WS-SALDO-VIVO
              END-IF
           END-IF
      *@COL05-F
      *
           MOVE MAE-FECPRILIQ                 TO WS-FEC-FIN-1ER-REC.
      ******************************************************************
      *                                                                *
      *                 2943-CALC-IMPRIMIR                             *
      *                                                                *
      *          SE CALCULAN E IMPRIMEN LAS LINEAS DEL CUADRO          *
      *                                                                *
      ******************************************************************
       2943-CALC-IMPRIMIR.
      *
           INITIALIZE UGMC03D
           PERFORM 29431-CALCULAR-LINEA
NOVA01     PERFORM 2123-BUSCA-PLAZOS-VENCIDOS
           IF MAE-SITPRES = '0'
      *COL11-I
              IF MAE-UGYEMCED = 'S'
      *COL11-F
              PERFORM 2500-LLAMADO-UG9CLIB0
      *COL11-I
              ELSE
                 IF SI-LBZ-RESIDUAL
                     PERFORM 10-LLAMA-UG9CLIB1
                 END-IF
              END-IF
      *COL11-F
           ELSE
              IF MAE-SITPRES = '8'
                 PERFORM 2312-CALCULAR-INTERES
              END-IF
           END-IF
      *
           IF WS-FECHA-1 > WS-FECHA-2
              MOVE WS-FECHA-LIQ-ANT           TO WS-DATE-DB2
           ELSE
              MOVE WS-FECHA-AMO-ANT           TO WS-DATE-DB2
           END-IF
      *
           IF HAY-PREPAGO
              SET NO-HAY-PREPAGO              TO TRUE
           ELSE
             PERFORM 29322-IMPRIMIR-LINEA
           END-IF.
      ******************************************************************
      *                                                                *
      *             29431-CALCULAR-LINEA                              *
      *                                                                *
      *   SE CALCULA LA LINEA DEL CUADRO DE AMORTIZACION TENIENDO      *
      *   EN CUENTA SI HAY QUE AMORTIZAR Y LIQUIDAR, AMORTIZAR O       *
      *   LIQUIDAR.                                                    *
      *                                                                *
      ******************************************************************
       29431-CALCULAR-LINEA.
      *
           IF WS-FECHA-LIQ NOT < WS-FECOVALI
              MOVE ADS-PERINT                 TO WS-PERIODICIDAD
           END-IF
      *
      ******************************************************************
      * SOLO SE PERMITEN INTERESES ANT. PARA AMORT. CONSTANTE DE K     *
      ******************************************************************
           IF ADS-CODTIAMO  NOT EQUAL CTE-CON-2 AND
              ADS-INDINANT EQUAL 'A'
              MOVE 'UGE5102'                  TO CAA-COD-ERROR
              PERFORM 291-BORRAR-TS
              PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
      *  AL0051D ENDOWMENT
      *
           IF ADS-CODTIAMO   = 'T' OR ADS-CODTIAMO   = 'W'
              MOVE WS-FECHA-FINAL             TO WS-FECHA-AMO
              MOVE WS-FECHA-DISP              TO WS-DATE-SALIDA
              PERFORM 888888-FORMT-FECHA-DB2
              MOVE WS-DATE-DB2                TO WS-FECHA-AMO-ANT
           END-IF
      *
           MOVE WS-FECHA-AMO                  TO WS-FECHA-1
           MOVE WS-FECHA-LIQ                  TO WS-FECHA-2
      *
           IF WS-FECHA-1 = WS-FECHA-2
              PERFORM  294311-AMORTIZAR-LIQUIDAR
           ELSE
              IF WS-FECHA-1 > WS-FECHA-2
                 PERFORM  294312-LIQUIDAR
              ELSE
                 IF WS-FECHA-1 < WS-FECHA-2
                    PERFORM  294313-AMORTIZAR
                  END-IF
              END-IF
           END-IF.
      *
           EJECT
      *
      ******************************************************************
      *                                                                *
      *             294311-AMORTIZAR-LIQUIDAR.                         *
      *                                                                *
      *   SE CALCULA UNA LINEA DEL CUADRO EN LA QUE SE AMORTIZA Y      *
      *   LIQUIDA                                                      *
      *                                                                *
      ******************************************************************
       294311-AMORTIZAR-LIQUIDAR.
      *
           COMPUTE WS-CONT-AMO = WS-CONT-AMO + 1
           END-COMPUTE
           COMPUTE WS-CONT-LIN = WS-CONT-LIN + 1
           END-COMPUTE
           COMPUTE WS-CONT-LIQ = WS-CONT-LIQ + 1
           END-COMPUTE
      *
      ******************************************************************
      *    SE TIENE EN CUENTA SI SE VA A CALCULAR LA PRIMERA O         *
      *    LAS SIGUIENTES LINEAS DEL CUADRO                            *
      ******************************************************************
           IF SW-PRIMERA-LINEA
              PERFORM 2943111-PRIMERA-LINEA-AL
           ELSE
              PERFORM 2943112-LINEAS-SIG-AL
           END-IF
      *
           MOVE WS-SALDO-1                    TO WS-SALDO-VIVO
           MOVE WS-FECHA-AMO                  TO WS-FECHA-AMO-ANT
           MOVE WS-FECHA-LIQ                  TO WS-FECHA-LIQ-ANT
      *
      ******************************************************************
      *    SE CALCULAN LAS SIGUIENTES FECHAS DE AMORTIZACION Y
      *    DE LIQUIDACION.
      ******************************************************************
           IF ADS-CODTIAMO   NOT = 'T'       AND
              ADS-CODTIAMO   NOT = 'W'
              MOVE WS-FECHA-1                 TO DFP-FECHA-INICIAL
              MOVE WS-FECHA-DISP              TO WS-DATE-SALIDA
              MOVE MAE-UGCDIPAG               TO WS-DIA-PAGO
              MOVE WS-DIA-PAGO                TO DFP-DIA
              MOVE ADS-PERCAP                 TO DFP-PERCAP
      *
              IF ADS-CODTIAMO  = CTE-CON-A
                 MOVE  ADS-PERINT             TO DFP-PERCAP
              END-IF
      *
              MOVE CTE-CON-1                  TO DFP-NUM-PERIODOS
              MOVE ADS-TIPODIAS               TO DFP-TIPODIAS
              PERFORM  666666-LLAMAR-RUTINA
              MOVE DFP-FECHA-FINAL            TO WS-FECHA-AMO
      *
              MOVE WS-FECHA-2                 TO DFP-FECHA-INICIAL
              MOVE WS-FECHA-DISP              TO WS-DATE-SALIDA
              MOVE MAE-UGCDIPAG               TO WS-DIA-PAGO
              MOVE WS-DIA-PAGO                TO DFP-DIA
      *
              IF WS-PERIODICIDAD = SPACES
                 MOVE ADS-PERCAP              TO DFP-PERCAP
              ELSE
                 MOVE WS-PERIODICIDAD         TO DFP-PERCAP
              END-IF
      *
              IF ADS-CODTIAMO = CTE-CON-A
                 MOVE ADS-PERINT              TO DFP-PERCAP
              END-IF
      *
              MOVE CTE-CON-1                  TO DFP-NUM-PERIODOS
              MOVE ADS-TIPODIAS               TO DFP-TIPODIAS
              PERFORM 666666-LLAMAR-RUTINA
              MOVE DFP-FECHA-FINAL            TO WS-FECHA-LIQ
           END-IF
      *
           MOVE ZERO                          TO WS-INTERES-ACUM.
      *
           EJECT
      *
      ******************************************************************
      *                                                                *
      *             2943111-PRIMERA-LINEA-AL                          *
      *                                                                *
      *   SE CALCULA LA PRIMERA LINEA DEL CUADRO DE AMORTIZACION       *
      *                                                                *
      ******************************************************************
       2943111-PRIMERA-LINEA-AL.
      *
           IF WS-TIPO-CUOTA = 'B'
              MOVE WS-CAPITAL-INICIAL         TO CO2-CAPITAL-INICIAL
      *
              IF WS-FECHA-AMO(6:2) = WS-MES-FECPRIAMO
                 MOVE WS-SALDO-VIVO           TO WS-CAPITAL
                                                 WS-CAPITAL-INICIAL
              ELSE
                 MOVE WS-CAPITAL-INICIAL      TO WS-CAPITAL
              END-IF
           ELSE
              MOVE WS-SALDO-VIVO              TO WS-CAPITAL
           END-IF
      *@COL02-I
           IF WS-TIPO-CUOTA = 'L' OR 'M'
              MOVE WS-SALDO-VIVO              TO CO2-CAPITAL-INICIAL
           END-IF
      *@COL02-F
      *
           MOVE WS-INTERES-NOMINAL            TO WS-INTERES
      *
           IF ADS-INDINANT    = 'A'
              MOVE WS-PRICUOTA                TO WS-CAPITAL-1
           END-IF
      *
      ******************************************************************
      *   CALCULA INTERES  DE LA CUOTA                                 *
      * CUANDO EL UGCDIPAG NO COINCIDE CON LA FECHA DE LA PANTALLA,    *
      * PARA LUEGO CALCULAR CUANTO ES LA AMORTIZACION, Y LUEGO         *
      * PROSEGUIR CON EL CRONOGRAMA   --- O ----                       *
      * CUANDO EL CAREINT NO SE INFORMA INDICANDO QUE ES EN LA PRIMERA *
      * AMORTIZACION LA QUE SE PAGARA LOS INTERESES CORRIDOS, LUEGO    *
      * SE PROSEGUIRA CON EL CRONOGRAMA                                *
      ******************************************************************
           IF  (MAE-UGCDIPAG  NOT = WS-DATE-DB2-DIA
                AND ADS-PERINT(1:1) NOT = '1')
               OR (ADS-CARECAP NOT = SPACES AND ADS-CAREINT =  SPACES)
               PERFORM 22172111-A-CALCULAR-FECINI
               PERFORM 22172111-B-CALCULAR-DIAS
               PERFORM 22172111-C-CALCULAR-INT
           END-IF
      *
           PERFORM  293211-CALCULAR-DIAS
           PERFORM  293212-CALCULAR-INT
      *
           MOVE CTE-CON-0                     TO SW-LINEA
      *
      ******************************************************************
      * PARA CUOTAS ESPECIALES                                         *
      ******************************************************************
           IF ADS-CODTIAMO  = 'P' OR 'G'
              PERFORM  294311231-COPY-CUOTA
              MOVE CO2-CUOTA                  TO WS-PRICUOTA
           END-IF.
      *
      ******************************************************************
      *  SI EL UGCDIPAG NO COINCIDE CON LA FECHA DE SOLICITUD          *
      *  O NO SE INFORMA CAREIN                                        *
      *  SE RESTAURA EL INTERES DE LA CUOTA WS-INTERES-CUOTA           *
      ******************************************************************
           IF (MAE-UGCDIPAG NOT = WS-DATE-DB2-DIA
                AND ADS-PERINT(1:1) NOT = '1')
               OR (ADS-CARECAP NOT = SPACES AND ADS-CAREINT =  SPACES)
               MOVE WS-INTERES-DIPAG          TO WS-INTERES-CUOTA
                                                 WS-INTERES-CALCUL-CAP
           END-IF
      *
           PERFORM  29431111-ANAL-INDSUBVE.
      *
      ******************************************************************
      *  RESTAURA EL VALOR INICIAL DE LA CUOTA
      ******************************************************************
           IF ADS-CODTIAMO  = 'P' OR 'G'
              IF WS-CO2-COEFICUA  > 0
                 COMPUTE WS-PRICUOTA    ROUNDED = CO2-CUOTA
                                                  / WS-CO2-COEFICUA
                 END-COMPUTE
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                 296-PROCESAR-PIE-TOTALES.                    *
      * SE ACCEDE AL FORMATO UGRMG67T CON PREFORMATO UG0T PARA JET-FORM*
      * CUANDO G67-PAPEL = 'J'                                         *
      * Y CUANDO NO LO ES
      ******************************************************************
       296-PROCESAR-PIE-TOTALES.
      *
              PERFORM 296-PROC-PIE-TOTALES-NORMAL.
      *
      *
      ******************************************************************
      *                                                                *
      *                 296-PROC-PIE-TOTALES-NORMAL                    *
      * SE ACCEDE AL FORMATO UGRMG673 CON PREFORMATO UGMC03E           *
      *
      ******************************************************************
       296-PROC-PIE-TOTALES-NORMAL.
      *
           MOVE WS-PRICUOTA                   TO G674-PRICUO
                                                 G675-PRICUO
      *
           MOVE WS-ACC-INTINIR                TO G03E-INTINIR
      *
           MOVE WS-ACC-SEGUROS                TO G03E-SEGUROS
      *
           MOVE WS-ACC-DIFERID                TO G03E-DIFERID
      *
           MOVE WS-ACC-CAPINIR                TO G03E-CAPINIR
      *
           MOVE WS-ACC-SUBVENCION             TO G675-SUBVEN
           MOVE WS-ACC-RECIBO                 TO G03E-RECIBO
                                                 G674-TOTAL
                                                 G675-TOTAL
      *
           MOVE LENGTH OF UGMC03E             TO W-LONG-TS
           MOVE SPACES                        TO W-CONTENIDO-TS
           MOVE 'UGRMC03E'                    TO W-NOMBRE-FORMATO
      *
           MOVE UGMC03E                       TO W-CONT-FORMATO
           MOVE '+DC1'                        TO W-PREFIJO-TS
      *
           PERFORM  777777-WRITEQ
      *
           MOVE '+DC1'                        TO CAA-DESTINO(1)
           MOVE 'P'                           TO CAA-IND-PANDOC(1).
      ******************************************************************
      *                                                                *
      *             29462-CALCULAR-CUOTA                               *
      *                                                                *
      *   SE SELECCIONAN LAS CUOTAS DE LA TABLA DE CUOTAS.             *
      *                                                                *
      ******************************************************************
       29462-CALCULAR-CUOTA.
      *
           PERFORM 2123-BUSCA-PLAZOS-VENCIDOS.
      *
      ******************************************************************
      *                                                                *
      *             2123-BUSCA-PLAZOS-VENCIDOS                        *
      *                                                                *
      *   SE BUSCAN LOS PLAZOS VENCIDOS PARA EL RECALCULO DE           *
      *   LAS SIGUENTES CUOTAS EN EL CASO DE UNA AMORTIZACION          *
      *   GRADUAL.                                                     *
      ******************************************************************
       2123-BUSCA-PLAZOS-VENCIDOS.
      *
           MOVE WS-CCC-20-ENTIOFI             TO DRB-ENTIOFI
           MOVE WS-CCC-20-CUENTA              TO DRB-CUENTA
      *
           EXEC SQL
                SELECT UGIQUOTA,
                       UGNPLVEN,
                       UGNPLPEN
                  INTO :DRB-UGIQUOTA,
                       :DRB-UGNPLVEN,
                       :DRB-UGNPLPEN
                  FROM UGDTDRB
                  WHERE ENTIOFI   = :DRB-ENTIOFI   AND
                        CUENTA    = :DRB-CUENTA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
      ******************************************************************
      * SI EL PRESTAMO ESTA RECIEN FORMALIZADO PUEDE QUE NO EXISTA EL  *
      * VALOR DE LA DRB, EN CUYO CASO SE ASUMIRAN COMO LOS PLAZOS      *
      * PENDIENTES LOS CALCULADOS EN LA RUTINA UR8CDAT0                *
      ******************************************************************
              IF MAE-SITPRES = '7' OR '8'
                 MOVE BCD-CUOTAS              TO DRB-UGNPLPEN
                 MOVE ZERO                    TO DRB-UGNPLVEN
              ELSE
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'REG. NO EXISTE '       TO CAA-VAR1-ERROR
                 MOVE 'TABLA UGDTDRB'         TO CAA-VAR2-ERROR
                 PERFORM 291-BORRAR-TS
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           ELSE
              IF NOT DB2-OK AND SQLWARN0 NOT = SPACES
                 MOVE 'UGDTDRB'               TO CAA-VAR1-ERROR
                 MOVE 'SELECT CUOTAS'         TO CAA-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *
      *   ACTUALIZO NUMERO DE CUOTAS PENDIENTES**
           MOVE DRB-UGNPLPEN               TO WS-CUOTAS-PLAZO
           COMPUTE  DRB-UGNPLPEN  =  DRB-UGNPLPEN - WS-RECIBOS.
      ******************************************************************
      *                                                                *
      *               666666-LLAMAR-RUTINA.                            *
      *                                                                *
      *    SE LLAMA A LA RUTINA UR1CDFP0 QUE DESPLAZA FECHAS POR       *
      *    PERIODICIDAD. SI SE PRODUCE ALGUN ERROR SE ABENDA.          *
      *                                                                *
      ******************************************************************
       666666-LLAMAR-RUTINA.
      *
           EXEC CICS LINK
              PROGRAM ('UR1CDFP0')
              COMMAREA (URECDFP)
           END-EXEC
      *
           IF DFP-CORESPUE      NOT = CTE-CON-10
              MOVE 'UGE0517'                  TO CAA-COD-ERROR
              MOVE 'UR1CDFP0'                 TO CAA-VAR1-ERROR
              MOVE DFP-CORESPUE               TO CAA-VAR2-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
      ******************************************************************
      *                2214113-LLAMA-UR8CDAT0.                         *
      *                                                                *
      * RUTINA PARA EL CALCULO DE FECHAS SE USARA LA UR8CDAT0          *
      *                                                                *
      ******************************************************************
       2214113-LLAMA-UR8CDAT0.
      *
           MOVE  WS-DATE-DB2                  TO BCD-FEFORMA
           MOVE  ADS-INDINANT                 TO BCD-INDINANT
      *
           IF ADS-PERCAP NOT EQUAL SPACES AND '999'
              MOVE ADS-PERCAP(1:1)            TO BCD-TIP-PERCAP
              MOVE  ZERO                      TO BCD-NRO-PERCAP(1:1)
              MOVE ADS-PERCAP(2:2)            TO BCD-NRO-PERCAP(2:2)
           ELSE
              MOVE ADS-PERCAP                 TO BCD-PERCAP
           END-IF
      *
           IF ADS-PERINT NOT EQUAL SPACES AND '999'
              MOVE  ADS-PERINT(1:1)           TO BCD-TIP-PERINT
              MOVE  ZERO                      TO BCD-NRO-PERINT(1:1)
              MOVE  ADS-PERINT(2:2)           TO BCD-NRO-PERINT(2:2)
           ELSE
              MOVE  ADS-PERINT                TO BCD-PERINT
           END-IF
      *
           IF ADS-CAREINT NOT EQUAL SPACES
