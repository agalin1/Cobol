      ******************************************************************
           PERFORM 221721112-1-CONTROLA-INT.
      ******************************************************************
      *                                                                *
      *             294311231-COPY-CUOTA                              *
      *                                                                *
      *   SE LLAMA A LA RUTINA DE CALCULO DE CUOTAS A PARTIR DE UNA    *
      *   DADA                                                         *
      *                                                                *
      ******************************************************************
       294311231-COPY-CUOTA.
      ******************************************************************
      * SE INFORMAN LOS NUEVOS CAMPOS DE LA RUTINA
      *   PARA EL CALCULO DE CUOTAS ESPECIALES
      ******************************************************************
           MOVE WS-FECHA-LIQ                  TO WS-CO2-F-AMORTI
           MOVE ADS-PERCAP                    TO WS-CO2-PERCAP
           MOVE ADS-TIPODIAS                  TO WS-CO2-TIPODIAS
      *
           IF MAE-SITPRES = CTE-CON-7 OR
              ((MAE-SITPRES = CTE-CON-8) AND (MAE-IMPDISPU = 0))
              IF MAE-UGCDIPAG = 0
                 MOVE CAA-FECHA-OPER2         TO WS-DATE-DB2
                 MOVE WS-DATE-DB2(9:2)        TO MAE-UGCDIPAG
                                                 ADS-UGCDIPAG
              END-IF
           ELSE
              IF ADS-UGCDIPAG = 0
                 IF MAE-UGCDIPAG = 0
                    IF MAE-FEFORMA(1:4) = '0001'
                       MOVE MAE-FESOLIC(9:2)  TO MAE-UGCDIPAG
                       MOVE MAE-UGCDIPAG      TO ADS-UGCDIPAG
                    ELSE
                       MOVE MAE-FEFORMA(9:2)  TO MAE-UGCDIPAG
                       MOVE MAE-UGCDIPAG      TO ADS-UGCDIPAG
                    END-IF
                 ELSE
                    MOVE MAE-UGCDIPAG         TO ADS-UGCDIPAG
                 END-IF
              ELSE
                 IF MAE-UGCDIPAG = 0
                    MOVE ADS-UGCDIPAG         TO MAE-UGCDIPAG
                 END-IF
              END-IF
           END-IF.
      *
           MOVE MAE-UGCDIPAG                 TO WS-CO2-UGCDIPAG.
           MOVE WS-CCC-20-ENTIOFI            TO WS-CO2-ENTIOFI
           MOVE WS-CCC-20-DIGITO1            TO WS-CO2-DIGITO1
           MOVE WS-CCC-20-DIGITO2            TO WS-CO2-DIGITO2
           MOVE WS-CCC-20-CUENTA             TO WS-CO2-CUENTA-R.
      *
      ******************************************************************
      *   SE INFORMAN LOS CAMPOS DE LA RUTINA CON EL CODIGO DE TIPO    *
      *   DE AMORTIZACION, LA PRIMERA CUOTA, EL CAPITAL SOLICITADO,    *
      *   EL TIPO DE INTERES, LA RAZON DE PROGRESION Y LA              *
      *   SI SE DEBE PRODUCIR UN SALTO EN LA CUOTA                     *
      ******************************************************************
           MOVE ADS-CODTIAMO                  TO CO2-TIP-CUOTA
           MOVE WS-PRICUOTA                   TO CO2-CUOTA
           MOVE WS-SALDO-VIVO                 TO CO2-SALDO
      *
           IF ADS-CODTIAMO = 'B'
              IF WS-FECHA-AMO(6:2) = WS-MES-FECPRIAMO
                 MOVE WS-SALDO-VIVO           TO CO2-CAPITAL-INICIAL
                                                 WS-CAPITAL-INICIAL
              ELSE
                 MOVE WS-CAPITAL-INICIAL      TO CO2-CAPITAL-INICIAL
              END-IF
           END-IF
      *
      *@COL06-I
           IF ADS-CODTIAMO = 'H'
                 MOVE   COT-AMO-ANNO        TO CO2-AMO-ANNO
                 MOVE   WS-GRADIENTE        TO CO2-GRADIENTE
                 MOVE   COT-INT-NOMINAL     TO CO2-INT-NOMINAL
                 IF     WS-CONT-AMO = 2
                    MOVE WS-M-TOTAL         TO CO2-PERIODOS-REST
                 ELSE
                    COMPUTE WS-PER-REST =
                            (WS-M-TOTAL - WS-CONT-AMO) + 2
                    MOVE   WS-PER-REST         TO CO2-PERIODOS-REST
                 END-IF
           END-IF
      *@COL06-F
           MOVE SPACES                        TO CO2-COD-ERROR
                                                 CO2-VAR1-ERROR
      *
           IF ADS-DIASCAL = CTE-CON-COMERCIALES OR CTE-CON-MIXTOS
              MOVE CTE-CON-360-COMP3          TO CO2-DIASCAL
           ELSE
              MOVE CTE-CON-365-COMP3          TO CO2-DIASCAL
           END-IF
      *
           MOVE WS-RAZON                      TO CO2-RAZON
      *
           IF SW-ARRANQUE = ZEROS
              IF ADS-CODTIAMO  = 'D'   OR   'E'
                 PERFORM AVERIGUA-DESDE-DONDE
                 MOVE VAR-INICIA              TO WS-CONT-LIN
                 ADD 1                        TO WS-CONT-LIN
                 MOVE 1                       TO SW-ARRANQUE
              END-IF
           END-IF
      *
           IF WS-CONT-LIN > ADS-LININCUO
              MOVE CTE-CON-1                  TO CO2-SALTO-CUOTA
              MOVE CTE-CON-1                  TO WS-CONT-LIN
           ELSE
              MOVE ZERO                       TO CO2-SALTO-CUOTA
           END-IF
      *
      *EN CASO DE QUE EXISTA CARENCIA
           IF ADS-CODTIAMO = 'C' AND NO-CALC
              PERFORM 2123-BUSCA-PLAZOS-VENCIDOS
              COMPUTE WS-CONT-AMO = WS-CONT-AMO + DRB-UGNPLVEN
              END-COMPUTE
              SET YA-CALC                     TO TRUE
           END-IF
      *
           IF ADS-CODTIAMO = 'C'  AND
              ( ADS-CARECAP NOT EQUAL SPACES) AND NO-CALCULADO
              IF ADS-CARECAP (1:1) NOT EQUAL '3'
                 MOVE ADS-CARECAP(2:3)        TO WS-NUMERO-7
                 DIVIDE  12 INTO WS-COCIENTE-2
                             GIVING WS-NUMERO-7
                             REMAINDER WS-RESIDUO
      *
                 IF WS-RESIDUO NOT EQUAL ZERO
                    MOVE 'CARENCIA CAPITAL'   TO CAA-VAR1-ERROR
                    MOVE 'EXPRESADO EN A#OS'  TO CAA-VAR2-ERROR
                    MOVE 'UGE0710'            TO CAA-COD-ERROR
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
      *
                 MOVE SPACES                  TO CO2-PLAZO
                 MOVE MAE-PLAZO(2:3)          TO WS-NUMERO-5
                 MOVE WS-COCIENTE-2           TO WS-NUMERO-6
              ELSE
                 MOVE SPACES                  TO CO2-PLAZO
                 MOVE MAE-PLAZO(2:3)          TO WS-NUMERO-5
                 MOVE ADS-CARECAP(2:3)        TO WS-NUMERO-6
              END-IF
      *
              COMPUTE WS-PLAZO-NUM = WS-NUMERO-5 - WS-NUMERO-6
      *
              MOVE '30'                       TO CO2-PLAZO(1:2)
              MOVE WS-PLAZO-NUM               TO CO2-PLAZO(3:2)
              SET SI-CALCULADO                TO TRUE
           END-IF
      *
           PERFORM  RUTINA-CALC-CUOTA-SIGUIENTE
      *
           IF CO2-COD-ERROR NOT = SPACES
              MOVE CO2-COD-ERROR              TO CAA-COD-ERROR
              MOVE CO2-VAR1-ERROR             TO CAA-VAR1-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF
      *
           IF CO2-CODIGO = CTE-CON-99
              MOVE CTE-CON-UGE0298            TO CAA-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
      *
      *@COL02-I
           IF (COT-TIPO-CAR = 'H' AND COT-TIP-CUOTA = 'I') OR
               COT-TIP-CUOTA = 'K'
              IF WS-CO2-F-AMORTI(6:2) = '06' OR '12'
                 IF WS-CO2-F-AMORTI(1:7) = MAE-FECPRILIQ(1:7)
@COL03*             COMPUTE CO2-CUOTA = CO2-CUOTA / COT-FACTOR-A
                    COMPUTE CO2-CUOTA = CO2-CUOTA / 2
                    MOVE 'S'             TO WS-IND-GRACIA
@COL03           ELSE
@COL03              COMPUTE CO2-CUOTA = (CO2-CUOTA / 2) * COT-FACTOR-A
                 END-IF
              ELSE
      *@COL03 - I
      *          IF (WS-CO2-F-AMORTI(6:2) = '07' OR '01') AND
      *             WS-IND-GRACIA = 'S'
      *             COMPUTE CO2-CUOTA = CO2-CUOTA * COT-FACTOR-A
      *             MOVE 'N'                TO WS-IND-GRACIA
      *          END-IF
                 IF (WS-CO2-F-AMORTI(6:2) = '07' OR '01')
                    IF WS-IND-GRACIA = 'S'
                       COMPUTE CO2-CUOTA = CO2-CUOTA * 2
                       MOVE 'N'                TO WS-IND-GRACIA
                    ELSE
                       COMPUTE CO2-CUOTA = (CO2-CUOTA /
                                  COT-FACTOR-A) * 2
                    END-IF
                 END-IF
      *@COL03 - F
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *             29431111-ANAL-INDSUBVE                            *
      *                                                                *
      *   SE ANALIZA EL INDICADOR DE SUBVENCION LLAMANDO A LAS         *
      *   RUTINAS ENCARGADAS DE EFECTUAR LOS CALCULOS PARA CADA        *
      *   TIPO                                                         *
      *                                                                *
      ******************************************************************
       29431111-ANAL-INDSUBVE.
      *
           IF ADS-INDSUBVE = CTE-CON-LI OR 'N'
              MOVE ZERO                       TO WS-SUBVENCION-1
              MOVE WS-INTERES-TOTAL           TO WS-INTERES-1
      *
              IF WS-CUOTA-CAPITAL
                 MOVE WS-PRICUOTA             TO WS-CAPITAL-1
              ELSE
                 SUBTRACT WS-INTERES-CALCUL-CAP FROM WS-PRICUOTA
                    GIVING WS-CAPITAL-1
                    ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
                 END-SUBTRACT
              END-IF
           ELSE
              CONTINUE
           END-IF
      *
           SUBTRACT WS-CAPITAL-1     FROM WS-SALDO-VIVO
              GIVING WS-SALDO-1
              ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-SUBTRACT
      *
      ******************************************************************
      *   CUANDO SE TRATA DE LA ULTIMA CUOTA Y ES PRIMER CALCULO       *
      ******************************************************************
           IF (WS-FECHA-AMO = MAE-FEVENCIN AND
                              WS-CAPITAL-1 < WS-SALDO-VIVO) OR
              (WS-FECHA-LIQ = MAE-FEVENCIN AND
                              WS-CAPITAL-1 < WS-SALDO-VIVO)
              MOVE WS-SALDO-VIVO              TO WS-CAPITAL-1
           END-IF
      *
           IF WS-CAPITAL-1 > WS-SALDO-VIVO
              MOVE WS-SALDO-VIVO              TO WS-CAPITAL-1
           END-IF
      *
           SUBTRACT WS-CAPITAL-1 FROM WS-SALDO-VIVO
                 GIVING WS-SALDO-1
                 ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-SUBTRACT
      *
           ADD WS-CAPITAL-1                   TO WS-INTERES-1
              GIVING WS-RECIBO-1
              ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-ADD.
      *
      ******************************************************************
      * INCLUYE CASOS ESPECIALES DE SEGUROS
      *      PARA PORTES Y GASTOS ADMINISTRA
      ******************************************************************
           IF WS-PERIODOS-SD >  WS-LIMITE-SD
              COMPUTE WS-SEGDESR ROUNDED =  WS-SEGDSGR * WS-FACTOR-SD
           ELSE
              COMPUTE WS-SEGDESR ROUNDED =  WS-SEGDSGR
           END-IF
      *
           IF WS-PERIODOS-SA >  WS-LIMITE-SA
              COMPUTE WS-SEGOTRR ROUNDED =  WS-SEGAUTO * WS-FACTOR-SA
           ELSE
              COMPUTE WS-SEGOTRR ROUNDED =  WS-SEGAUTO
           END-IF
      *
           COMPUTE WS-GASTOS-1X ROUNDED =  WS-PORTES   +  WS-GASADM +
                                           WS-SEGDESR  +
                                           WS-SEGOTRR
           END-COMPUTE
      *
           ADD WS-GASTOS-1X                  TO WS-RECIBO-1.
      ******************************************************************
      *                243-VRFCAR-PRDCTO-GCEI                          *
      *    SE VALIDA QUE EL SUBPRODUCTO SEA DE LA CAROLINA             *
      ******************************************************************
      *
       243-VRFCAR-PRDCTO-GCEI.
      *
           INITIALIZE UGTCT37
           MOVE '1021'                      TO T37-SECCION
           MOVE MAE-SUBPRO                  TO T37-ELEMENTO
      *
           EXEC SQL
                SELECT RESTO
                INTO  :T37-RESTO
                FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                      ELEMENTO = :T37-ELEMENTO
           END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK
      *@COL07-I
              IF T37-RESTO(3:2) = 'XX'
                 MOVE 1                      TO WS-BANDERA
              END-IF
      *@COL07-F
              MOVE T37-RESTO(3:2)             TO WS-PRDO-GRCIA
              MOVE T37-RESTO(5:1)             TO WS-INT-CAPITALIZABLES
           ELSE
              IF DB2-NOTFND
                 MOVE ZEROS                   TO WS-PRDO-GRCIA
                 MOVE SPACES                  TO WS-INT-CAPITALIZABLES
              ELSE
                 MOVE 'UGDTT37'            TO CAA-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ************************************************************
