      ******************************************************************
      *                    AVERIGUA-DESDE-DONDE.                       *
      * AVERIGUA QUE PERIODOS HACEN FALTA PARA COMPLEMENTAR EL ANO, Y  *
      * ASI HACER EL SALTO POR CADA ANO                                *
      ******************************************************************
       AVERIGUA-DESDE-DONDE.
      *
            MOVE MAE-FEFORMA(6:2)             TO VAR-MES-FOR-ALF
            MOVE CAA-FECHA-OPER2(6:2)         TO VAR-MES-HOY-ALF
            MOVE ADS-PERCAP(2:2)              TO VAR-VECES-ALF
      *
            IF ADS-PERCAP(1:1) = '2'
               COMPUTE VAR-B =  VAR-VECES-N
            END-IF
      *
            IF ADS-PERCAP(1:1) = '3'
               COMPUTE  VAR-B =  VAR-VECES-N  *  12
            ELSE
               IF ADS-PERCAP(1:1) = '1'
                  DIVIDE VAR-VECES-N  BY 30 GIVING VAR-VECES-N
                  REMAINDER WS-RESTO
                  IF WS-RESTO  > ZEROS
                     ADD 1                    TO VAR-VECES-N
                  END-IF
                  COMPUTE VAR-B =  VAR-VECES-N
               END-IF
            END-IF
      *
            IF VAR-MES-FOR-N  <  VAR-MES-HOY-N
               COMPUTE VAR-A =  VAR-MES-FOR-N  -  VAR-MES-HOY-N
               MOVE VAR-A                     TO VAR-INICIA
            ELSE
               IF VAR-MES-FOR-N  =  VAR-MES-HOY-N
                  MOVE 1                      TO VAR-INICIA
               ELSE
                  IF VAR-MES-FOR-N  >  VAR-MES-HOY-N
                     COMPUTE VAR-A =  VAR-MES-FOR-N  -  VAR-MES-HOY-N
                     COMPUTE VAR-C =  VAR-A  /  VAR-B
                     IF VAR-C   <    1
                        MOVE 11               TO VAR-C
                     END-IF
                     COMPUTE VAR-INICIA =  12   -   VAR-C
                  END-IF
               END-IF
            END-IF.
      *
      ******************************************************************
      *                                                                *
      *             2943132-ANAL-SUB-AMO                              *
      *                                                                *
      *   SE CALCULA LA SUBVENCION EN EL CASO DE QUE SE VAYA A         *
      *   AMORTIZAR                                                    *
      *                                                                *
      ******************************************************************
       2943132-ANAL-SUB-AMO.
      *
           IF (ADS-INDSUBVE   = CTE-CON-LI     OR
              ADS-INDSUBVE   = 'N' )     OR
               (ADS-INDSUBVE   = CTE-CON-SU)
      ******************************************************************
      *    TIPOSUB ES 1 (SUBVENCION SOBRE INTERESES) POR TANTO NO
      *    HAY EN AMORTIZACION
      ******************************************************************
                MOVE ZERO                 TO WS-SUBVENCION-1
                MOVE WS-PRICUOTA          TO WS-CAPITAL-1
           ELSE
              IF ADS-INDSUBVE = CTE-CON-SU
      ******************************************************************
      *    SE CALCULA LA SUBVENCION CUANDO EXISTE Y ES DE CAPITAL
      ******************************************************************
                   IF MAE-SITPRES = CTE-CON-7 OR CTE-CON-8
                      PERFORM  2943111111-ACCEDER-UTRA-PORC
                   ELSE
                      SET DB2-NOTFND          TO TRUE
                   END-IF
      *
                   IF DB2-NOTFND AND SQLWARN0 = SPACES
                      MOVE ZERO               TO WS-SUBVENCION-1
                      MOVE WS-PRICUOTA        TO WS-CAPITAL-1
                   ELSE
                       IF DB2-OK AND SQLWARN0 = SPACES
                          PERFORM 2943111131-PARTE-CAPITAL
                       ELSE
                          PERFORM 999999-ABEND-DB2
                       END-IF
                   END-IF
               END-IF
           END-IF
      *
           MOVE ZERO                          TO WS-INTERES-1
           MOVE WS-CAPITAL-1                  TO WS-RECIBO-1
      *
           SUBTRACT WS-CAPITAL-1 FROM WS-SALDO-VIVO
             GIVING WS-SALDO-1
             ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-SUBTRACT.
      ******************************************************************
      *                                                                *
      *             2932121-CALC-INTERES-REGLA78.                      *
      *                                                                *
      *  SE CALCULAN LOS INTERESES DE LA CUOTA BAJO REGLA 78.          *
      *                       X                                        *
      *                I = -------- * (I.TOTALES)                      *
      *                    Y(Y+1)/2                                    *
      *  X= NUMERO DE PAGOS PENDIENTES = WS-UGNPLPEN                   *
      *  Y= NUMERO DE PAGOS TOTALES DEL PRESTAMO=WS-UGNPLINI           *
      ******************************************************************
       2932121-CALC-INTERES-REGLA78.
      *
           ADD 1                              TO WS-UGNPLINI
              GIVING WS-UGNPLINI-1
              ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-ADD
      *
           MULTIPLY WS-UGNPLINI-1 BY WS-UGNPLINI
               GIVING WS-UGNPLINI-2
               ON SIZE ERROR PERFORM  225-REBOSAMIENTO
           END-MULTIPLY
      *
           DIVIDE WS-UGNPLINI-2 BY 2
                GIVING WS-DENOMINADOR
                ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-DIVIDE
      *
           DIVIDE WS-UGNPLPEN BY WS-DENOMINADOR
                GIVING WS-INTERES-R78
                ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-DIVIDE
      *
           MULTIPLY WS-INTERES-R78 BY WS-INTINITO
               GIVING WS-INTERES-AUX
               ON SIZE ERROR PERFORM  225-REBOSAMIENTO
           END-MULTIPLY
      *
      ******************************************************************
      * SE RESTA 1 AL NUMERO DE PERIODOS PENDIENTES PARA LA SIGUIENTE  *
      * LINEA DEL CUADRO                                               *
      ******************************************************************
           SUBTRACT 1 FROM WS-UGNPLPEN
              GIVING WS-UGNPLPEN
              ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-SUBTRACT.
