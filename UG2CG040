           END-IF.
      ******************************************************************
      *                 29322-2-IMPR-LINEA                           *
      *                                                                *
      *          SE IMPRIMEN LAS LINEAS DEL CUADRO.                    *
      *          LAS LINEAS DE DETALLE ESTAN ASOCIADAS AL FORMATO      *
      *          UGMC03D CON PREFORMATO UG03D                          *
      ******************************************************************
       29322-2-IMPR-LINEA.
      *
           MOVE WS-DATE-DB2-SIGLO             TO WS-DATE-DB2-SIGLO-F
           MOVE WS-DATE-DB2-ANNO              TO WS-DATE-DB2-ANNO-F
           MOVE WS-DATE-DB2-MES               TO WS-DATE-DB2-MES-F
           MOVE WS-DATE-DB2-DIA               TO WS-DATE-DB2-DIA-F
           MOVE WS-DATE-DB2-F                 TO G03D-FEFIVAL
      *
           MOVE WS-INTERES-1                  TO G03D-INTINIR
           ADD  WS-INTERES-1                  TO WS-ACC-INTINIR
           MOVE WS-CAPITAL-1                  TO G03D-CAPINIR
           ADD  WS-CAPITAL-1                  TO WS-ACC-CAPINIR
           MOVE WS-SALDO-1                    TO G03D-SALREAL
           IF MAE-SITPRES = '8'
              IF WS-RECIBO-1 > 0
      *          COMPUTE WS-RECIBO-1 = WS-DIFERIDOS + WS-SEGUROS +
      *                                WS-RECIBO-1
      *@NOVA01 - INICIO
              COMPUTE WS-VALOR-CUOTA-CON = WS-DIFERIDOS + WS-SEGUROS +
                                           WS-RECIBO-1
      *COL-13-I
                                         + WS-PRIMA-SEGVOL
      *COL-13-F
              COMPUTE WS-VALOR-CUOTA-SIN ROUNDED = WS-DIFERIDOS
                                    + WS-SEGUROS + WS-RECIBO-1
      *COL-13-I
                                    + WS-PRIMA-SEGVOL
      *COL-13-F

              IF WS-VALOR-CUOTA-SIN < WS-VALOR-CUOTA-CON
                 COMPUTE WS-VALOR-CUOTA-SIN =
                         WS-VALOR-CUOTA-SIN + 1
                 END-COMPUTE
              END-IF

              MOVE WS-VALOR-CUOTA-SIN TO WS-RECIBO-1
      *@NOVA01 - FIN
              END-IF

           ELSE
              IF MAE-SITPRES = '0'
                 IF WS-RECIBO-1 > 0
                    COMPUTE WS-RECIBO-1 = WS-DIFERIDOS + MAL-SEGURO +
                                          WS-RECIBO-1
      *COL-13-I
                                        + WS-PRIMA-SEGVOL
      *COL-13-F
                 END-IF
              END-IF
           END-IF
           MOVE WS-RECIBO-1                   TO G03D-RECIBO
           ADD  WS-RECIBO-1                   TO WS-ACC-RECIBO
      *
      ******************************************************************
      * CUANDO EL SALDO ES CUBIERTO ANTES DE QUE FINALIZE
      *    EL PLAZO DEL PRESTAMO
      ******************************************************************
           IF WS-SALDO-1 <= ZERO
              ADD WS-CAPITAL-1                TO  WS-SALDO-1
                   GIVING WS-CAPTZ-1
                   ON SIZE ERROR PERFORM 225-REBOSAMIENTO
              END-ADD
              ADD   WS-ACC-CAPINIR TO  WS-SALDO-1
                   GIVING WS-ACC-CAPINIR
                   ON SIZE ERROR PERFORM 225-REBOSAMIENTO
              END-ADD
              MOVE WS-CAPTZ-1                 TO G03D-CAPINIR
              MOVE WS-RECIBO-1                TO G03D-RECIBO
              MOVE ZERO                       TO G03D-SALREAL
              SET SI-FINAL                    TO TRUE
           END-IF
      *
      * -- SE TRANSFORMA LA FECHA DE SALIDA A FORMATO DB2 -------------*
           IF CTA-FECHA-AUX2-ANNO  GREATER  '50'
              MOVE 19                        TO WS-DATE-SALIDA-DB2-SIGLO
           ELSE
              MOVE 20                        TO WS-DATE-SALIDA-DB2-SIGLO
           END-IF
      *
           MOVE CTA-FECHA-AUX2-ANNO           TO WS-DATE-SALIDA-DB2-ANNO
           MOVE CTA-FECHA-AUX2-DIA            TO WS-DATE-SALIDA-DB2-DIA
           MOVE CTA-FECHA-AUX2-MES            TO WS-DATE-SALIDA-DB2-MES
      *
           MOVE ZEROS                         TO WS-OTROS-GASTOS
      *
           IF WS-LINEAS = 241
              MOVE CTE-CON-INCOMPL            TO LITE-LITERAL
              MOVE LENGTH OF UGNCLIT          TO W-LONG-TS
              MOVE SPACES                     TO W-CONTENIDO-TS
              MOVE '+DC1'                     TO W-PREFIJO-TS
              MOVE 'UGRMLITE'                 TO W-NOMBRE-FORMATO
              MOVE UGNCLIT                    TO W-CONT-FORMATO
              PERFORM 777777-WRITEQ
              MOVE '+DC1'                     TO CAA-DESTINO(1)
              MOVE 'P'                        TO CAA-IND-PANDOC(1)
              ADD 1                           TO WS-LINEAS
              MOVE 'UGA0060'                  TO CAA-COD-AVISO1
           ELSE
              IF WS-LINEAS < 241
                 PERFORM 293221-ESCRIBIR-DETALLE
                 ADD 1      TO WS-LINEAS
              END-IF
           END-IF
