      ******************************************************************
      *                                                                *
      *                      -TIPOSUB-32                               *
      *                                                                *
      *   SE REALIZAN LOS CALCULOS PARA EL TIPOSUB 32(TANTO POR CIENTO *
      *   DE SUBVENCION SOBRE LOS INTERESES) CUANDO ES EN CARENCIA     *
      *                                                                *
      ******************************************************************
       293212A-TIPOSUB-32.
      *
      ******************************************************************
      *    SE OBTIENE EL PORCENTAJE DE SUBVENCION PARA EL TRAMO
      *    EN EL QUE NOS ENCONTRAMOS.
      ******************************************************************
           PERFORM  2943111111-ACCEDER-UTRA-PORC
      *
      *    SE CALCULAN LOS INTERESES SUBVENCIONADOS
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
              MOVE ZERO                       TO WS-SUBVENCION-1
              MOVE WS-INTERES-TOTAL           TO WS-INTERES-1
           ELSE
               IF DB2-OK AND SQLWARN0 = SPACES
                  MULTIPLY WS-INTERES-TOTAL BY WS-COMP-2
                      GIVING WS-COMP-2
                      ON SIZE ERROR PERFORM  225-REBOSAMIENTO
                  END-MULTIPLY
      *
                  DIVIDE WS-COMP-2 BY WS-INTERES-NOMINAL
                    GIVING WS-COMP-2
                    ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
                  END-DIVIDE
      *
                  MOVE WS-COMP-2 TO WS-INTERES-1
      *
                  SUBTRACT WS-INTERES-1 FROM WS-INTERES-TOTAL
                      GIVING WS-SUBVENCION-1
                      ON SIZE ERROR PERFORM 225-REBOSAMIENTO
                  END-SUBTRACT
               ELSE
                  MOVE 'UGDTTRA'              TO CAA-VAR1-ERROR
                  PERFORM 999999-ABEND-DB2
               END-IF
           END-IF
      *
           IF WS-CUOTA-CAPITAL
              MOVE WS-PRICUOTA                TO WS-CAPITAL-1
           ELSE
              SUBTRACT WS-INTERES-CALCUL-CAP FROM WS-PRICUOTA
                 GIVING WS-CAPITAL-1
                 ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
              END-SUBTRACT
           END-IF.
      ******************************************************************
      *                                                                *
      *             29431122-ANAL-SUB-ULT                             *
      *                                                                *
      *   SE EFECTUAN LOS CALCULOS DE LA ULTIMA LINEA DEL CUADRO DE    *
      *   AMORTIZACION                                                 *
      *                                                                *
      ******************************************************************
       29431122-ANAL-SUB-ULT.
      *
      ******************************************************************
      * SE DEJA EN CERO EL VALOR DEL WS-INTERES-TOTAL CUANDO EL        *
      *  INTERES DEL TIPO ADELANTADO
      ******************************************************************
           IF ADS-INDINANT = 'A'
              MOVE ZEROS                      TO WS-INTERES-TOTAL
           END-IF
      *
           IF ADS-INDSUBVE   = CTE-CON-LI  OR 'N'
              MOVE ZERO                       TO WS-SUBVENCION-1
              MOVE WS-SALDO-VIVO              TO WS-CAPITAL-1
      *  SE DEJA SIN EFECTO EL CUADRE DE CUOTA
              MOVE ADS-CODTIAMO               TO CTE-CON-CODTIAMO
      *@COL02-I
               IF ADS-CODTIAMO = 'L' OR 'M'
                  COMPUTE WS-CUOTA-FIN ROUNDED = COT-CAPITAL-INICIAL *
                                        (COT-PORC-FINAL / 100)
                  COMPUTE WS-DIFER = WS-CUOTA-FIN - WS-CAPITAL-1 -
                                     WS-INTERES-TOTAL
                  IF WS-DIFER < 5 AND WS-DIFER > -5
                     COMPUTE WS-INTERES-TOTAL = WS-INTERES-TOTAL +
                                                WS-DIFER
                  END-IF
               END-IF
      *@COL02-F
              MOVE WS-INTERES-TOTAL           TO WS-INTERES-1
           ELSE
             CONTINUE
           END-IF
      *
           SUBTRACT WS-CAPITAL-1 FROM WS-SALDO-VIVO
              GIVING WS-SALDO-1
              ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-SUBTRACT
      *
           ADD WS-CAPITAL-1                   TO WS-INTERES-1
             GIVING WS-RECIBO-1
             ON SIZE ERROR  PERFORM  225-REBOSAMIENTO
           END-ADD.
      *
           IF WS-PERIODOS-SD >  WS-LIMITE-SD
              COMPUTE WS-SEGDESR ROUNDED =  WS-SEGDSGR * WS-FACTOR-SD
           ELSE
              COMPUTE WS-SEGDESR ROUNDED =  WS-SEGDSGR
           END-IF
      *
           IF WS-PERIODOS-SA >  WS-LIMITE-SA
              COMPUTE WS-SEGOTRR ROUNDED =  WS-SEGAUTO * WS-FACTOR-SA
           ELSE
              COMPUTE WS-SEGOTRR ROUNDED =  WS-SEGAUTO
           END-IF
      *
           COMPUTE WS-GASTOS-1X ROUNDED =  WS-PORTES   +  WS-GASADM +
                                           WS-SEGDESR  +
                                           WS-SEGOTRR
      *
           ADD WS-GASTOS-1X                   TO WS-RECIBO-1.
      ******************************************************************
      *                                                                *
      *             29431123-CONTI-CUADRO                             *
      *                                                                *
      *   SE CALCULAN LAS LINEAS DEL CUADRO DE AMORTIZACION            *
      *                                                                *
      ******************************************************************
       29431123-CONTI-CUADRO.
      *
           IF MAE-SITPRES = CTE-CON-7  OR CTE-CON-8
              IF WS-SALDO-VIVO = 0
                 MOVE 0                       TO CO2-CUOTA
                                                 CO2-SALDO
              ELSE
                 PERFORM 294311231-COPY-CUOTA
              END-IF
              MOVE CO2-CUOTA                  TO WS-PRICUOTA
           ELSE
               MOVE WS-FECHA-AMO              TO CUO-FECOVALI
      *
               IF CUO-FECOVALI > WS-FIN-VALIDEZ-CUOTA
                  PERFORM 29462-CALCULAR-CUOTA
                  MOVE CUO-IMPMINI            TO WS-PRICUOTA
               END-IF
           END-IF
      *
      * PARA CUOTAS ESPECIALES
           IF MAE-SITPRES NOT = '7' AND '8'
              IF ADS-CODTIAMO  = 'P' OR 'G' OR 'C' OR 'D'
      *VER20011016-I-CREDITON-CAVE
                                     OR 'I'
      *VER20011016-F-CREDITON-CAVE
      *@COL02-I
                                     OR 'K'
      *@COL02-F
      *@COL06-I
                                     OR 'H'
      *@COL06-F
                 PERFORM  294311231-COPY-CUOTA
                 MOVE CO2-CUOTA               TO WS-PRICUOTA
              END-IF
           END-IF
      *
           PERFORM  29431111-ANAL-INDSUBVE.
      *
      * RESTAURA EL VALOR INICIAL DE LA CUOTA
           IF  ADS-CODTIAMO  = 'P' OR 'G'
               IF WS-CO2-COEFICUA  > 0
                  COMPUTE WS-PRICUOTA    ROUNDED = CO2-CUOTA
                                                  / WS-CO2-COEFICUA
               END-IF
           END-IF.
