               :LQS-TIPOAPLI,
               :LQS-IMPMINI,
               :LQS-IMPMAXI
             FROM UGDTLQS
             WHERE PRODUCTO  = :LQS-PRODUCTO      AND
                   SUBPRO    = :LQS-SUBPRO        AND
                   CODCONLI  = :LQS-CODCONLI      AND
                   FECOVALI <= :LQS-FECOVALI      AND
                   FEFIVALI >= :LQS-FECOVALI      AND
                   PLAZO     =
                           (SELECT MIN(PLAZO)
                            FROM UGDTLQS
                            WHERE PRODUCTO  = :LQS-PRODUCTO  AND
                                  SUBPRO    = :LQS-SUBPRO    AND
                                  CODCONLI  = :LQS-CODCONLI  AND
                                  PLAZO    >= :LQS-PLAZO     AND
                                  FECOVALI <= :LQS-FECOVALI  AND
                                  FEFIVALI >= :LQS-FECOVALI)
