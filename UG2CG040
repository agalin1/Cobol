      *COL11-I
      ******************************************************************
      *                 223-BUSCAR-ESTADO-LIB                          *
      *  CONSULTA CONVENIOS DE LIBRANZA PARA RECONOCER SON LIBRANZAS   *
      *  RESIDUALES
      ******************************************************************
       223-BUSCAR-ESTADO-LIB.
            MOVE MAE-ENTIOFI           TO MAL-ENTIOFI
            MOVE MAE-CUENTA            TO MAL-CUENTA
            EXEC SQL
                SELECT CODIGO_CONV,
                       CONSEC_CONV,
                       SITPRES,
                       SEGURO,
                       LIBRE_IMP1,
                       LIBRE_IMP2
                    INTO :MAL-CODIGO-CONV,
                         :MAL-CONSEC-CONV,
                         :MAL-SITPRES,
                         :MAL-SEGURO,
                         :MAL-LIBRE-IMP1,
                         :MAL-LIBRE-IMP2
               FROM UGDTMAL
               WHERE ENTIOFI  = :MAL-ENTIOFI
               AND   CUENTA   = :MAL-CUENTA
            END-EXEC

            MOVE SQLCODE           TO DB2-RETURN-CDE
            IF DB2-OK AND SQLWARN0 = SPACES
               CONTINUE
            ELSE
               IF DB2-NOTFND
                  MOVE SPACES        TO MAL-SITPRES
               END-IF
            END-IF.
      *
      ******************************************************************
      *                        10-LLAMA-UG9CLIB1
      * BUSCA LOS INTERESES DIFERIDOS PARA CREDITOS DE LIBRANZA
      * RESIDUAL
      ******************************************************************
       10-LLAMA-UG9CLIB1.
            INITIALIZE ICWCLIB1
            MOVE MAE-ENTIOFI        TO WLIB1-ENTIOFI
            MOVE MAE-CUENTA         TO WLIB1-CUENTA
            MOVE '0001-01-01'       TO WLIB1-FEFORMA
            MOVE '0001-01-01'       TO WLIB1-FEULIQ
            MOVE '0001-01-01'       TO WLIB1-FEPROC
            MOVE '0001-01-01'       TO WLIB1-FINMES
            MOVE 'CU'               TO WLIB1-OPCION

            CALL BBVA-UG9CLIB1   USING ICWCLIB1

            IF WLIB1-CODERR    NOT =  '00' AND '20'
               MOVE 'UGE0517'             TO CAA-COD-ERROR
               MOVE 'UG9CLIB1'            TO CAA-VAR1-ERROR
               MOVE WLIB1-CODERR          TO CAA-VAR2-ERROR
               PERFORM 3-FINAL-PROGRAMA
            ELSE
               MOVE CNL-GRACIA            TO WS-GRACIA
               MOVE CNL-CODIGO-CONV       TO WS-CODIGO-CONV

               COMPUTE WS-DIFERIDOS = WLIB1-VALOR-INT-DIF +
                                      WLIB1-VALOR-SEG-DIF

               ADD  WS-DIFERIDOS           TO WS-ACC-DIFERID
               MOVE WS-DIFERIDOS           TO G03D-DIFERID
      *COL13-I
      *        MOVE MAL-SEGURO             TO G03D-SEGUROS
               MOVE MAL-SEGURO             TO WS-SEGOBL-SEGVOL
               ADD  WS-PRIMA-SEGVOL        TO WS-SEGOBL-SEGVOL
               MOVE WS-SEGOBL-SEGVOL       TO G03D-SEGUROS
               ADD  WS-PRIMA-SEGVOL        TO WS-ACC-SEGUROS
      *COL13-F
               ADD  MAL-SEGURO             TO WS-ACC-SEGUROS
            END-IF.
      *COL11-F
      *COL13-I
      ******************************************************************
      *                      2510-LLAMADO-IC9CSEL0
      * SE REALIZA EL LLAMADO A LA RUTINA IC9CSEL0 PARA TRAER EL VALOR
      * TOTAL DE LOS SEGUROS VOLUNTARIOS
      ******************************************************************
       2510-LLAMADO-IC9CSEL0.
      *                                                                 00281050
           INITIALIZE SEL0-REGISTRO                                     00281060
      *                                                                 00281070
           MOVE '02'                        TO SEL0-OPCION              00281080
           MOVE MAE-ENTIOFI(1:4)            TO SEL0-PRE-ENTI            00281081
           MOVE MAE-ENTIOFI(5:4)            TO SEL0-PRE-CENT            00281082
           MOVE MAE-CUENTA                  TO SEL0-PRE-CUEN            00281083
           MOVE CAA-FECHA-OPER2             TO SEL0-FEC-PROCESO         00281093
      *COL19-I
           MOVE CTE-PROGRAM                 TO SEL0-PROGRAMA
      *COL19-F
      *                                                                 00281095
           CALL CT-IC9CSEL0 USING SEL0-REGISTRO                         00281096
      *                                                                 00281097
           EVALUATE SEL0-PECRETOR                                       00281098
              WHEN '00'                                                 00281099
                 IF SEL0-VALORTOT-PM > 0                                00281101
                    MOVE SEL0-VALORTOT-PM   TO WS-PRIMA-SEGVOL          00281110
                 END-IF                                                 00281140
              WHEN '20'                                                 00281150
                 CONTINUE                                               00281160
              WHEN OTHER                                                00281170
                 MOVE 'UGE0517'             TO CAA-COD-ERROR
                 MOVE 'IC9CSEL0'            TO CAA-VAR1-ERROR
                 MOVE SEL0-PECRETOR         TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.                                                00281191
      *
      ******************************************************************
      *                     236-VALIDAR-SEGUROS-VOL
      * SE REALIZA EL LLAMADO A LAS RUTINAS UR2CSVLB Y IC9CSEL1 DE
      * ACUERDO CON LA CANTIDAD DE SEGUROS VOLUNTARIOS QUE SE ENCUENTRAN
      * ATADOS AL CONTRATO
      ******************************************************************
       236-VALIDAR-SEGUROS-VOL.
           SET NO-SEGVOL1 TO TRUE
           SET NO-SEGVOL2 TO TRUE
           SET NO-SEGVOL3 TO TRUE
           PERFORM 2361-LLAMADO-UR2CSVLB
      *
           IF SI-SEGVOL1 OR SI-SEGVOL2 OR SI-SEGVOL3
              IF WS-RECIBO-1 > 0
                 COMPUTE WS-VALOR-CUOTA-CON = WS-DIFERIDOS + WS-SEGUROS
                                            + WS-RECIBO-1
                 COMPUTE WS-VALOR-CUOTA-SIN ROUNDED = WS-DIFERIDOS
                                       + WS-SEGUROS + WS-RECIBO-1

                 IF WS-VALOR-CUOTA-SIN < WS-VALOR-CUOTA-CON
                    COMPUTE WS-VALOR-CUOTA-SIN =
                            WS-VALOR-CUOTA-SIN + 1
                    END-COMPUTE
                 END-IF

                 MOVE WS-VALOR-CUOTA-SIN TO WS-VALOR-CUOTA-SEL1
              END-IF
           END-IF
      *
           INITIALIZE WS-PRIMA-SEGVOL WS-SEGOBL-SEGVOL
           IF SI-SEGVOL1
              MOVE WS-SUBPROD-SV1 TO WS-SUBPROD-SV-SEL1
              PERFORM 2362-LLAMADO-IC9CSEL1
           END-IF
      *
           IF SI-SEGVOL2
              MOVE WS-SUBPROD-SV2 TO WS-SUBPROD-SV-SEL1
              PERFORM 2362-LLAMADO-IC9CSEL1
           END-IF
      *
           IF SI-SEGVOL3
              MOVE WS-SUBPROD-SV3 TO WS-SUBPROD-SV-SEL1
              PERFORM 2362-LLAMADO-IC9CSEL1
           END-IF.
      *
      ******************************************************************
      *                     2361-LLAMADO-UR2CSVLB
      * SE REALIZA EL LLAMADO A LAS RUTINA UR2CSVLB PARA TRAER LA
      * INFORMACION DE SEGUROS VOLUNTARIOS QUE SE ENCUENTRAN
      * ATADOS AL CONTRATO
      ******************************************************************
       2361-LLAMADO-UR2CSVLB.
           INITIALIZE UGWCSVLB
           MOVE '03'                        TO SVL-OPCION
           MOVE MAE-ENTIOFI                 TO SVL-CCC(1:8)
           MOVE '00'                        TO SVL-CCC(9:2)
           MOVE MAE-CUENTA                  TO SVL-CCC(11:10)
           MOVE 'UG2CG040'                  TO SVL-PROGRAMA
           MOVE 'NCA'                       TO SVL-CANAL

           EXEC CICS
             LINK PROGRAM('UR2CSVLB')
                 COMMAREA(UGWCSVLB)
           END-EXEC

           IF EIBRESP NOT EQUAL DFHRESP(NORMAL)
              MOVE 'LINK UR2CSVLB'            TO CAA-VAR1-ERROR
              PERFORM 999999-ABEND-CICS
           END-IF

           EVALUATE SVL-CODRET
              WHEN '00'
                 IF SVL-SUBPROD-SEG(1) NOT = LOW-VALUES AND SPACES
                    MOVE SVL-SUBPROD-SEG(1) TO WS-SUBPROD-SV1
                    SET SI-SEGVOL1          TO TRUE
                 END-IF
      *
                 IF SVL-SUBPROD-SEG(2) NOT = LOW-VALUES AND SPACES
                    MOVE SVL-SUBPROD-SEG(2) TO WS-SUBPROD-SV2
                    SET SI-SEGVOL2          TO TRUE
                 END-IF
      *
                 IF SVL-SUBPROD-SEG(3) NOT = LOW-VALUES AND SPACES
                    MOVE SVL-SUBPROD-SEG(3) TO WS-SUBPROD-SV3
                    SET SI-SEGVOL3          TO TRUE
                 END-IF
              WHEN '30'
                 MOVE 'UGE0939'             TO CAA-COD-ERROR
                 MOVE SVL-VAR1-ERROR        TO CAA-VAR1-ERROR
                 MOVE SVL-VAR2-ERROR        TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              WHEN OTHER
                 MOVE SVL-COD-ERROR         TO CAA-COD-ERROR
                 MOVE SVL-VAR1-ERROR        TO CAA-VAR1-ERROR
                 MOVE SVL-VAR2-ERROR        TO CAA-VAR2-ERROR(1:14)
                 MOVE SVL-SQLCODE           TO CAA-VAR2-ERROR(16:)
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
      *
      ******************************************************************
      *                     2362-LLAMADO-IC9CSEL1
      * SE REALIZA EL LLAMADO A LA RUTINA IC9CSEL1 DE
      * ACUERDO CON LA CANTIDAD DE SEGUROS VOLUNTARIOS QUE SE ENCUENTRAN
      * ATADOS AL CONTRATO
      ******************************************************************
       2362-LLAMADO-IC9CSEL1.
           INITIALIZE SEL1-REGISTRO
           MOVE WS-SUBPROD-SV-SEL1        TO SEL1-SUBP-SGR
           MOVE MAE-SUBPRO                TO SEL1-SUBP-PRT
           MOVE MAE-IMPCONCE              TO SEL1-VLR-DSMB
           MOVE WS-VALOR-CUOTA-SEL1       TO SEL1-VLR-CUOT
      *
           MOVE CAA-FECHA-OPER2           TO SEL1-FEC-PROCESO
      *
           MOVE WCLS-FENACIMI             TO SEL1-FEC-NACIMI
           MOVE MAL-CODIGO-CONV           TO SEL1-CONVENIO
           MOVE MAL-CONSEC-CONV           TO SEL1-CONS-CVN
      *
           CALL CT-IC9CSEL1 USING SEL1-REGISTRO
      *
           EVALUATE SEL1-PECRETOR
           WHEN ZEROS
                ADD  SEL1-PRIM-MEN          TO WS-PRIMA-SEGVOL
           WHEN OTHER
                MOVE 'UGE0939'              TO CAA-COD-ERROR
                MOVE SEL1-ERR-MSG1          TO CAA-VAR1-ERROR
                IF SEL1-ERR-MSG2 EQUAL SPACES
                   IF SEL1-PROGR-ERR EQUAL SPACES
                      MOVE SEL1-ERR-TABLA   TO CAA-VAR2-ERROR(1:8)
                      MOVE SEL1-SQLCODE     TO CAA-VAR2-ERROR(9: )
                   ELSE
                      MOVE SEL1-PROGR-ERR   TO CAA-VAR2-ERROR
                   END-IF
                ELSE
                   MOVE SEL1-ERR-MSG2       TO CAA-VAR2-ERROR
                END-IF
                MOVE SEL1-PECRETOR          TO CAA-VAR2-ERROR(19:2)
                PERFORM  3-FINAL-PROGRAMA
           END-EVALUATE.
      *COL13-F
      *COL18-I
      *----------------------------------------------------------------*
      *                       3122-BUSQUEDA-MOV                        *
      *----------------------------------------------------------------*
       3122-BUSQUEDA-MOV.
            INITIALIZE UGTCMOV
            MOVE  WS-CCC-20-ENTIOFI   TO  MOV-ENTIOFI
            MOVE  WS-CCC-20-CUENTA    TO  MOV-CUENTA
            SET   NO-ABONO            TO TRUE

            EXEC SQL
               SELECT  FEOPER
                 INTO  :MOV-FEOPER
                 FROM  UGDTMOV
                WHERE  CUENTA   = :MOV-CUENTA
                  AND  ENTIOFI  = :MOV-ENTIOFI
                  AND  CLACON   = 'D2'
                  AND  (IND_MARCA1 = '2'
                  OR   IND_MARCA1 = 'R')
                  FETCH FIRST ROWS ONLY
            END-EXEC.

            MOVE SQLCODE                   TO DB2-RETURN-CDE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                 IF NOT DB2-OK
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'ERR. NO EXISTE '      TO CAA-VAR1-ERROR
                    MOVE 'TABLA UGDTMOV'        TO CAA-VAR2-ERROR
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    SET SI-ABONO           TO TRUE
                 END-IF
              END-IF.
