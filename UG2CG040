      ******************************************************************
      *                                                                *
      *             22231-CALC-S                                       *
      *                                                                *
      *    CALCULO DEL NUMERO DE AMORTIZACIONES ANUALES                *
      *                                                                *
      *    SI ES CUOTA UNICA (999), LA RUTINA DEL CALCULO DE LA CUOTA  *
      *    IGNORARA ESTE VALOR, POR LO QUE LO PONEMOS A CERO.          *
      *                                                                *
      ******************************************************************
       22231-CALC-S.
      *
           EVALUATE IEN-DIASCAL
              WHEN 'N'
                MOVE 365                      TO WS-DIAS-DIASCAL
              WHEN 'X'
                MOVE 365                      TO WS-DIAS-DIASCAL
              WHEN 'C'
                MOVE 360                      TO WS-DIAS-DIASCAL
              WHEN 'P'
                MOVE 360                      TO WS-DIAS-DIASCAL
              WHEN OTHER
                MOVE 360                      TO WS-DIAS-DIASCAL
           END-EVALUATE.
      *
           EVALUATE WS-TIPO-PER-CAP
             WHEN 1
               COMPUTE COT-AMO-ANNO   ROUNDED =
                       WS-DIAS-DIASCAL        /  WS-PERIODO-CAP
               END-COMPUTE
             WHEN 2
               COMPUTE COT-AMO-ANNO   ROUNDED =
                       12                     / WS-PERIODO-CAP
               END-COMPUTE
             WHEN 3
               COMPUTE COT-AMO-ANNO   ROUNDED =
                       1                      / WS-PERIODO-CAP
               END-COMPUTE
             WHEN 9
               MOVE ZERO                      TO COT-AMO-ANNO
             WHEN  OTHER
               MOVE 'UGE0089'                 TO CAA-COD-ERROR
               PERFORM  3-FINAL-PROGRAMA
           END-EVALUATE.
      ******************************************************************
      *                                                                *
      *             22232-CALC-M                                       *
      *                                                                *
      *    CALCULO DEL TOTAL DE AMORTIZACIONES PENDIENTES              *
      *                                                                *
      ******************************************************************
       22232-CALC-M.
      *
           IF WS-TIPO-PER-CAP  =  1
              IF COT-TIP-CUOTA       =  'A'        OR
                 COT-TIP-CUOTA       =  'T'        OR
                 COT-TIP-CUOTA       =  'W'
                 MOVE 1                       TO COT-TOT-AMORT-PEN
              ELSE
                 IF ADS-TIPODIAS NOT = 1
                    MOVE 'UGE0761'            TO CAA-COD-ERROR
                    PERFORM  3-FINAL-PROGRAMA
                 END-IF
              END-IF
           END-IF.
      *
           MOVE  MAE-FEVENCIN                 TO WS-DB2-AAAA-MM-DD
           MOVE  MAE-FEPROAMO                 TO WS-DB2-AUX-AAAA-MM-DD
      *
           COMPUTE WS-M-TOTAL        ROUNDED =
                   WS-DB2-AAAA               - WS-DB2-AUX-AAAA
           END-COMPUTE
      *
      ******************************************************************
      *  CUENTA EL NUMERO DE CUOTAS                                    *
      ******************************************************************
           IF WS-TIPO-PER-CAP  =  1
              MOVE MAE-FEPROAMO               TO WS-DATA-INI
              MOVE ZERO                       TO WS-NUM-COPS
              PERFORM 0000-RUTINA-UR8CDFP0
                    UNTIL WS-DATA-INI >  MAE-FEVENCIN
                 MOVE WS-NUM-COPS             TO  WS-RESULTAT
           END-IF.
      *
           IF WS-TIPO-PER-CAP  =  2
              COMPUTE WS-M-TOTAL ROUNDED  =
                  ( ( WS-M-TOTAL  * 12 )  +  WS-DB2-MM ) -
                      WS-DB2-AUX-MM
              END-COMPUTE
           END-IF.
      *
           IF WS-TIPO-PER-CAP = 1
              MOVE  WS-RESULTAT               TO COT-TOT-AMORT-PEN
           ELSE
              COMPUTE WS-M-TOTAL        ROUNDED =
                      WS-M-TOTAL                / WS-PERIODO-CAP
              END-COMPUTE
              COMPUTE COT-TOT-AMORT-PEN ROUNDED =
                      WS-M-TOTAL                + 1
              END-COMPUTE
           END-IF.
      ******************************************************************
      *                                                                *
      *             22234-CALC-DPL-AJ                                  *
      *                                                                *
      *                                                                *
      ******************************************************************
       22234-CALC-DPL-AJ.
      *
           MOVE ZEROES                        TO COT-DIAS-PRI-LIQ
           MOVE ZEROES                        TO COT-AJUSTE-ENTREGAS.
      ******************************************************************
      *                222233-VALOR-GRADIENTE                          *
      ******************************************************************
       222233-VALOR-GRADIENTE.

              INITIALIZE UGTCAMA

              MOVE WS-CCC-20-ENTIOFI          TO AMA-ENTIOFI
              MOVE WS-CCC-20-CUENTA           TO AMA-CUENTA

              EXEC SQL
                  SELECT LIBRE_CAR2
                   INTO :AMA-LIBRE-CAR2
                      FROM UGDTAMA
                      WHERE ENTIOFI      = :AMA-ENTIOFI AND
                            CUENTA       = :AMA-CUENTA
              END-EXEC.

              MOVE SQLCODE                       TO DB2-RETURN-CDE

              IF DB2-OK
                 MOVE  AMA-LIBRE-CAR2            TO WS-RED-VALOR-GRA
                 MOVE  WS-GRADIENTE              TO COT-INT-GRAD
              ELSE
                 IF (DB2-NOTFND AND SQLWARN0 = SPACES)
                    MOVE 'UGE0939'               TO CAA-COD-ERROR
                    MOVE 'NO ENCONT. GRADIENTE'  TO CAA-VAR1-ERROR
                    MOVE 'EN UGDTAMA '           TO CAA-VAR2-ERROR(1:10)
                    MOVE SQLCODE                 TO CAA-VAR2-ERROR(11:9)
                    PERFORM  3-FINAL-PROGRAMA
                 ELSE
                    MOVE 'UGE0939'             TO CAA-COD-ERROR
                    MOVE 'SELECT UGDTAMA'      TO CAA-VAR1-ERROR
                    MOVE  SQLCODE              TO CAA-VAR2-ERROR(1:9)
                    PERFORM 999999-ABEND-DB2
                  END-IF
              END-IF.
      ******************************************************************
      * SE HACE LA VALIDACION DE LA ENTIDAD DE REDESCUENTO PARA AJUSTAR*
      * LA CUOTA DE SER NECESARIO.                                     *
      ******************************************************************
       22236-AJUSTA-CUOTA.
           PERFORM 222361-BUSCA-ENT
           IF ENT-LIBRE2(1:1) = 'S'
              COMPUTE WS-CUOTA-RED ROUNDED = COT-CUOTA * 1
              MOVE WS-CUOTA-RED   TO COT-CUOTA
           END-IF.
      *
      ******************************************************************
      * SE BUSCA LA ENTIDAD DE REDESCUENTO PARA SABER SI AJUSTA O NO   *
      ******************************************************************
       222361-BUSCA-ENT.
           INITIALIZE USTCENT
           MOVE ADS-ENTSUB        TO ENT-CODENTIT
           EXEC SQL
                SELECT LIBRE2
                INTO :ENT-LIBRE2
                FROM USDTENT
                WHERE CODENTIT = :ENT-CODENTIT
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE.
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
              MOVE 'USDTENT'               TO CAA-VAR1-ERROR
              MOVE 'SELECT USDTENT'        TO CAA-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.
      *****************************************************************
      * EN CASO DE QUE EL CREDITO AUN NO TENGA ASIGNADO EL TIPO DE    *
      * CARTERA SE BUSCA EL TIPO DEFAULT                              *
      *****************************************************************
       22238-BUSCA-TIPCAR.
           INITIALIZE UGTCT37
           MOVE '1901'                      TO T37-SECCION
           MOVE MAE-SUBPRO                  TO T37-ELEMENTO
           EXEC SQL
                SELECT RESTO
                INTO  :T37-RESTO
                FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                      ELEMENTO = :T37-ELEMENTO
           END-EXEC

           MOVE SQLCODE                     TO DB2-RETURN-CDE

           IF NOT DB2-OK
              MOVE 'UGDTT37'             TO CAA-VAR1-ERROR
              MOVE 'SELECT UGDTT37'      TO CAA-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           ELSE
              MOVE T37-RESTO(1:1)        TO MAE-IND-MARCA4
           END-IF.
