      *----------------------------------------------------------------*
      *                     224-BUSCA-IFAS                             *
      * SE VERIFICA LA EXISTENCIA DE IFAS CUYO TIPO DE INCIDENCIA      *
      * (UGTINCID) NO ES IGUAL A:                                      *
      *   'D' (PAGO ANTICIPADO)           'T' (CAMBIO DE TASA)         *
      *                                                                *
      *----------------------------------------------------------------*
       224-BUSCA-IFAS.
      *
            MOVE  MAE-FEULIQ                  TO WS-FULTVTO
            MOVE  MAE-FEPROLIQ                TO WS-FVTO
      *
            EXEC SQL
                 SELECT COUNT(*) INTO :WS-COMPTADOR
                   FROM UGDTIFA
                  WHERE ENTIOFI  = :MAE-ENTIOFI             AND
                        CUENTA   = :MAE-CUENTA              AND
                        UGYINDIF = '0'                      AND
                        UGTINCID <> 'D'                     AND
                        UGTINCID <> 'T'                     AND
                        UGTINCID <> 'A'                     AND
                        UGFVALOR BETWEEN :WS-FULTVTO AND :WS-FVTO
            END-EXEC
      *
           IF WS-COMPTADOR > 0
              MOVE 'UGE2036'                  TO CAA-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
      *
      ******************************************************************
      *SI HUBO P.ANTICI SE CALCULA EN CUANTAS CUOTAS SE REDUJO EL PLAZO*
      ******************************************************************
           MOVE  MAE-FEULIQ                   TO WS-FULTVTO
           MOVE  MAE-FEPROLIQ                 TO WS-FVTO
           MOVE  ZEROS                        TO WS-RECIBOS
      *
           EXEC SQL
                SELECT SUM(UGNREBSU)
                  INTO :WS-RECIBOS :WS-IND-NULO
                  FROM   UGDTIFA
                  WHERE  ENTIOFI  = :MAE-ENTIOFI             AND
                         CUENTA   = :MAE-CUENTA              AND
                         UGYINDIF = '0'                      AND
                         UGYINAPL = '1'                      AND
                         UGTINCID = 'D'
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
               IF DB2-NOTFND AND SQLWARN0 = SPACES
                MOVE ZEROS                    TO WS-RECIBOS
               ELSE
                  IF WS-IND-NULO < ZEROS
                     MOVE  ZEROS              TO WS-RECIBOS
                  ELSE
                     MOVE 'UGDTIFA'           TO CAA-VAR1-ERROR
                     PERFORM 999999-ABEND-DB2
                  END-IF
               END-IF
            END-IF.
