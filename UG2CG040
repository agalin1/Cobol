      *
           IF (ADS-INDSUBVE   = CTE-CON-LI     OR
              ADS-INDSUBVE   = 'N' )           OR
             ((ADS-INDSUBVE   = CTE-CON-SU))
               IF WS-SUBVENCION-CARENCIA = 'S'
