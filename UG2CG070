      ******************************************************************
      *             2350-LEER-FEFIVALIMAX                              *
      *----------------------------------------------------------------*
      *  HALLAR LA FEFIVALI MAXIMA (LA FECHA DE FIN DE VALIDEZ DE LA   *
      *  ULTIMA CUOTA QUE SE TIENE QUE ESCRIBIR EN LA TABLA DE CUOTAS).*
      *  SI EL INTERES ES FIJO, COINCIDIRA CON LA FECHA DE VENCIMIENTO.*
      *  SI EL INTERES ES VARIABLE, COINCIDIRA CON LA FECHA EN LA QUE  *
      *  DEJA DE ESTAR VIGENTE EL ACTUAL.                              *
      *                                                                *
      ******************************************************************
       2350-LEER-FEFIVALIMAX.
      *
           IF WS-FEFIVALI       <  MAE-FEVENCIN
              MOVE WS-FEFIVALI                TO WS-FEFIVALIMAX
           ELSE
              MOVE MAE-FEVENCIN               TO WS-FEFIVALIMAX
           END-IF.
      *
           EJECT
      *
      ******************************************************************
      *             2351-ACT-TBL-CUOTAS-CON                            *
      *----------------------------------------------------------------*
      *  ACTUALIZAR LA TABLA DE CUOTAS PARA LOS TIPOS DE CUOTA         *
      *  CONSTANTES Y EL DE CUOTA UNICA.                               *
      *                                                                *
      *  OPCION 1, IGUAL VENCIMIENTO Y MENOR CUOTA:                    *
      *    FECOVALI: FECHA VALOR  O FECHA DE FIN DE CARENCIA           *
      *    FEFIVALI: FEFIVALIMAX                                       *
      *                                                                *
      *  OPCION 2, IGUAL CUOTA       Y MENOR VIDA:                     *
      *    FECOVALI: FECHA VALOR                                       *
      *    FEFIVALI: LA MENOR DE FEFIVALIMAX Y VENCIMIENTO             *
      *                                                                *
      *  OPCION 3, IGUAL CUOTA       Y GENERAR CARENCIA:               *
      *    FECOVALI: FECHA ULTIMA AMORTIZACION ("NO ESPECIAL")         *
      *              DESPLAZADA LA CARENCIA                            *
      *    FEFIVALI: FEFIVALIMAX                                       *
      *                                                                *
      ******************************************************************
       2351-ACT-TBL-CUOTAS-CON.
      *
           IF WS-IND-5       NOT =  CTE-CON-ALFA-1
              PERFORM  23521-UPDATE-CUOTA
      *
      ******************************************************************
      *    SI NO ENCUENTRA CUOTA NO ABENDAMOS PORQUE QUIERE DECIR
      *    QUE LA FECHA DE COMIENZO DE VALIDEZ DEL TRAMO ES IGUAL
      *    A LA FECHA VALOR DE LA ENTREGA. ESTE TRAMO SE BORRA
      *    ENTERO POSTERIORMENTE.
      ******************************************************************
              IF NOT (DB2-OK  AND  SQLWARN0  =  SPACES) AND
                 NOT (DB2-NOTFND  AND SQLWARN0  =  SPACES)
      *COL31I
      *          MOVE 'UGDTCUO'               TO CAA-VAR1-ERROR
      *          MOVE 'UPDATE UGDTCUO'        TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'UPDATE UGDTCUO' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
              END-IF
           END-IF
      *@COL34 - INICIO
           IF G07-OPCION = '2' AND MAE-UGYEMCED = 'S'
              AND ( ADE-CODTIAMO = '1' OR ADS-CODTIAMO = '1' )
              CONTINUE
           ELSE
      *@COL34 - FIN
      *
             PERFORM  23522-DELETE-CUOTAS
      *
             IF NOT (DB2-OK  AND SQLWARN0  =  SPACES)
                IF NOT (DB2-NOTFND AND SQLWARN0  =  SPACES)
      *COL31I
      *          MOVE 'UGDTCUO'               TO CAA-VAR1-ERROR
      *          MOVE 'DELETE UGDTCUO'        TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'DELETE UGDTCUO' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
                END-IF
             END-IF
      *
      *@COL34 - INICIO
           END-IF
      *@COL34 - FIN
           EVALUATE G07-OPCION
              WHEN  CTE-CON-1
      *EFR01-I-1
              WHEN  CTE-CON-4
      *EFR01-F-1
                 IF WS-DB2-FEVALOR     >  MAE-FEFINCAR
                    MOVE WS-DB2-FEVALOR       TO CUO-FECOVALI
                 ELSE
                    MOVE MAE-FEFINCAR         TO CUO-FECOVALI
                 END-IF
      *
                 MOVE WS-FEFIVALIMAX          TO CUO-FEFIVALI
      *EFR01-I-1
                 IF G07-OPCION  = '4'
                    MOVE COT-CUOTA            TO CUO-IMPMINI
                 ELSE
      *EFR01-F-1
                 MOVE WS-MES-CUOTAO1          TO CUO-IMPMINI
      *EFR01-I-1
                 END-IF
      *EFR01-F-1
      *EFR02-I
                IF SW-SI-PUNICA
                   IF G07-OPCION = '2'
                      MOVE WS-M-FINAL         TO WS-PLAZO-NVO-PU
                   ELSE
                      IF G07-OPCION = '1'
                         MOVE WS-M-INICIAL    TO WS-PLAZO-NVO-PU
                      END-IF
                   END-IF
                   COMPUTE WS-KTEOR-PU-NVO  = WS-KTEOR-PU - VLR-K-PU
                   COMPUTE WS-COT-PUNICA ROUNDED = WS-KTEOR-PU-NVO /
                                                   WS-PLAZO-NVO-PU
                   ADD WS-COT-PUNICA          TO CUO-IMPMINI
                END-IF
      *EFR02-F
      **KRY01-I
      *          IF CUO-FEFIVALI      > CUO-FECOVALI
                 IF CUO-FEFIVALI      >= CUO-FECOVALI
      **KRY01-F
                    MOVE  CAA-NETNAME-CONT    TO CUO-NETNAME-UMO
                    MOVE  CAA-USERID          TO CUO-USERID-UMO
                    MOVE  CAA-ENTIDAD         TO CUO-ENTIDAD-UMO
                    MOVE  CAA-CENTRO-CONT     TO CUO-CENTRO-UMO
                    MOVE  MAE-MONEDA          TO CUO-MONEDA
                    PERFORM 23513-INSERT-CUOTAS
                 END-IF
      *@COL34 - INICIO
      *       WHEN  CTE-CON-2
      *          MOVE WS-DB2-FEVALOR          TO CUO-FECOVALI
      *          MOVE G071-VENCI2             TO CTA-FECHA-AUX1
      *          MOVE CTA-FECHA-AUX1-MES      TO WS-FOR-MM
      *          MOVE CTA-FECHA-AUX1-DIA      TO WS-FOR-DD
      *          MOVE CTA-FECHA-AUX1-ANNO     TO WS-FOR-AA
      *          PERFORM  2227-FECHA-FOR-A-DB2
      *          MOVE  WS-DB2-AAAA-MM-DD      TO  CUO-FEFIVALI
      *
      *          IF WS-FEFIVALIMAX  <  CUO-FEFIVALI
      *             MOVE WS-FEFIVALIMAX       TO CUO-FEFIVALI
      *          END-IF
      *
      *          MOVE WS-MES-CUOTAO2          TO CUO-IMPMINI
      *
      *          IF CUO-FEFIVALI      > CUO-FECOVALI
      *             MOVE  CAA-NETNAME-CONT    TO CUO-NETNAME-UMO
      *             MOVE  CAA-USERID          TO  CUO-USERID-UMO
      *             MOVE  CAA-ENTIDAD         TO  CUO-ENTIDAD-UMO
      *             MOVE  CAA-CENTRO-CONT     TO  CUO-CENTRO-UMO
      *             MOVE  MAE-MONEDA          TO  CUO-MONEDA
      *             PERFORM 23513-INSERT-CUOTAS
      *          END-IF
      *@COL34 - FIN
           END-EVALUATE.
      *
           EJECT
      *
      ******************************************************************
      *             23513-INSERT-CUOTAS                                *
      *----------------------------------------------------------------*
      *    INSERTAR UNA CUOTA EN LA TABLA DE CUOTAS                    *
      *                                                                *
      ******************************************************************
       23513-INSERT-CUOTAS.
      *
           MOVE WS-CCC-ENTIOFI                TO MAE-ENTIOFI
           MOVE WS-CCC-CUENTA                 TO MAE-CUENTA
      *
           EXEC SQL
             INSERT INTO UGDTCUO
               (ENTIOFI,
                CUENTA,
                FECOVALI,
                FEFIVALI,
                IMPMINI,
                TIMESTAMP,
                NETNAME_UMO,
                USERID_UMO,
                ENTIDAD_UMO,
                CENTRO_UMO,
                MONEDA)
             VALUES
               (:MAE-ENTIOFI,
                :MAE-CUENTA,
                :CUO-FECOVALI,
                :CUO-FEFIVALI,
                :CUO-IMPMINI,
                CURRENT TIMESTAMP,
                :CUO-NETNAME-UMO,
                :CUO-USERID-UMO,
                :CUO-ENTIDAD-UMO,
                :CUO-CENTRO-UMO,
                :CUO-MONEDA)
           END-EXEC
      *
