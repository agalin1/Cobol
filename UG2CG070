      *
      ******************************************************************
      *                   21511-SELECT-UGDTSWP                         *
      *   BUSCA SI EL PAGO SE REALIZO DESDE LA TRANSACCION DE PAGO     *
      *   PARA CREDITOS CON DERIVADO SWAP.                             *
      ******************************************************************
       21511-SELECT-UGDTSWP.
      *
           INITIALIZE UGTCSWP

           PERFORM 8800-ABRIR-CURSOR
           PERFORM 8800-FETCH-CURSOR UNTIL FIN-CURSOR-SWAP
           PERFORM 8800-CERRAR-CURSOR.
      *
      ******************************************************************
      *              8800-ABRIR-CURSOR                                 *
      *----------------------------------------------------------------*
      *  ABRIMOS EL CURSOR QUE CORRESPONDA AL PROCESO ACTUAL           *
      *                                                                *
      ******************************************************************
       8800-ABRIR-CURSOR.
      *
           MOVE MAE-ENTIOFI                   TO SWP-ENTIOFI
           MOVE MAE-CUENTA                    TO SWP-CUENTA
           MOVE 'N'                           TO SWP-IND-MARCA-PAGO
           MOVE G07-IMPORTE                   TO SWP-IMPMOVI

           IF G07-FEVALOR       =  SPACES     OR
              G07-FEVALOR       =  LOW-VALUES
              MOVE CAA-FECHA-OPER2            TO WS-AMD-SWAP
           ELSE
              MOVE  G07-FEVALOR(1:2)          TO SWP-DD
              MOVE  G07-FEVALOR(3:2)          TO SWP-MM
              MOVE  G07-FEVALOR(5:4)          TO SWP-AAAA
           END-IF
      *
           MOVE  WS-AMD-SWAP                  TO SWP-FEVALOR

              EXEC SQL
                  OPEN CURSOR-SWAP
              END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           SET NO-FIN-CURSOR-SWAP             TO TRUE
      *
           IF NOT DB2-OK OR SQLWARN0 NOT EQUAL SPACES
              MOVE 'UGE0939'             TO   CAA-COD-ERROR
              MOVE 'ERROR UGDTSWP'       TO   CAA-VAR1-ERROR
              MOVE 'SQLCODE '            TO   CAA-VAR2-ERROR(1:8)
              MOVE DB2-RETURN-CDE        TO   CAA-VAR2-ERROR(9:)
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      *
           EJECT.
      ******************************************************************
      *              8800-FETCH-CURSOR                                 |
      *----------------------------------------------------------------*
      *  HACEMOS UN FETCH SOBRE EL CURSOR QUE ESTE ABIERTO.            |
      *                                                                *
      ******************************************************************
       8800-FETCH-CURSOR.
      *
              EXEC SQL
               FETCH CURSOR-SWAP  INTO
                    :SWP-FEVALOR    ,
                    :SWP-FECONTA    ,
                    :SWP-NUMMOVI    ,
                    :SWP-IMPMOVI    ,
                    :SWP-NUMMOV-MIR ,
                    :SWP-IND-MARCA-PAGO,
                    :SWP-NUM-SWAP   ,
                    :SWP-TIPO-RECAUDO,
 KJMR               :SWP-TIMEST-UMO
              END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR SQLWARN0 NOT = SPACES
              MOVE 'UGE0939'             TO   CAA-COD-ERROR
              MOVE 'ERROR UGDTSWP'       TO   CAA-VAR1-ERROR
              MOVE 'SQLCODE '            TO   CAA-VAR2-ERROR(1:8)
              MOVE DB2-RETURN-CDE        TO   CAA-VAR2-ERROR(9:)
              PERFORM 3-FINAL-PROGRAMA
           ELSE
              IF DB2-NOTFND
                 IF  NO-PAGO-SW
                     MOVE 'UGE0939'           TO CAA-COD-ERROR
      *COL118-I
      *              MOVE 'CCC SWAP NO TIENE' TO CAA-VAR1-ERROR
                     EVALUATE RSE-APLICATIVO
                     WHEN WSC-DI
                       MOVE 'CCC DI  NO TIENE ' TO CAA-VAR1-ERROR
                     WHEN WSC-SW
                       MOVE 'CCC SWAP NO TIENE' TO CAA-VAR1-ERROR
                     END-EVALUATE
      *COL118-F
                     MOVE 'PAGOS A EFECTUAR'  TO CAA-VAR2-ERROR
                     PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    IF WS-ACUMU-Q > ZEROS
                       IF G07-IMPORTE > WS-ACUMU-Q
                          MOVE 'UGE0939'             TO CAA-COD-ERROR
                          MOVE 'MONTO SUPERA PAGOS'  TO CAA-VAR1-ERROR
      *COL118-I
      *                   MOVE 'SWAP '         TO CAA-VAR2-ERROR(1:8)
                          EVALUATE RSE-APLICATIVO
                          WHEN WSC-SW
                            MOVE 'SWAP ' TO CAA-VAR2-ERROR(1:8)
                          WHEN WSC-DI
                            MOVE 'DI   ' TO CAA-VAR2-ERROR(1:8)
                          END-EVALUATE
      *COL118-F
                          PERFORM 3-FINAL-PROGRAMA
                       END-IF
                    ELSE
                       IF G07-IMPORTE > WS-SOBRANTES
                          MOVE 'UGE0939'             TO CAA-COD-ERROR
                          MOVE 'MONTO SUPERA PAGOS'  TO CAA-VAR1-ERROR
      *COL118-I
      *                   MOVE 'SWAP '         TO CAA-VAR2-ERROR(1:8)
                          EVALUATE RSE-APLICATIVO
                          WHEN WSC-SW
                            MOVE 'SWAP '    TO CAA-VAR2-ERROR(1:8)
                          WHEN WSC-DI
                            MOVE 'DI   '    TO CAA-VAR2-ERROR(1:8)
                          END-EVALUATE
      *COL118-F
                          PERFORM 3-FINAL-PROGRAMA
                       END-IF
                    END-IF
                 END-IF
                 SET FIN-CURSOR-SWAP        TO TRUE
              ELSE
                 SET SI-PAGO-SW             TO TRUE
                 ADD SWP-IMPMOVI            TO WS-SOBRANTES
                 MOVE SPACES                TO G07-CCCARGO
                 MOVE 'S'                   TO G07-CAJA
                 MOVE SWP-FECONTA           TO WS-SWP-FECONTA
                 MOVE SWP-TIPO-RECAUDO      TO WS-TIPO-RECAUDO
      *
                 EVALUATE SWP-IND-MARCA-PAGO
                     WHEN 'A'
                          ADD SWP-IMPMOVI         TO WS-ACUMU-A
                     WHEN 'N'
 KJMR                     ADD SWP-IMPMOVI         TO WS-ACUMU-N
 KJMR                     ADD SWP-IMPMOVI         TO WS-ACUMU-Q
                     WHEN 'Q'
                          ADD SWP-IMPMOVI         TO WS-ACUMU-Q
                 END-EVALUATE
              END-IF
           END-IF.
      *
           EJECT.
      ******************************************************************
