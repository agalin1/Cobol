                     :MAL-SOBRANTE
                FROM UGDTMAL
      *COL115-I
               WHERE CUENTA  = :MAE-CUENTA
                 AND ENTIOFI = :MAE-ENTIOFI
               FETCH FIRST 1 ROW ONLY
      *        WHERE ENTIOFI = :MAE-ENTIOFI
      *          AND CUENTA  = :MAE-CUENTA
      *COL115-F
           END-EXEC
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           IF DB2-OK AND SQLWARN0 = SPACES
              MOVE MAL-CODIGO-CONV            TO CNL-CODIGO-CONV
              MOVE MAL-CONSEC-CONV            TO CNL-CONSEC-CONV
