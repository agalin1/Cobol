      *
           EJECT
      *
      ******************************************************************
      *              2243-SELECT-ADMINIS-STD                           *
      *----------------------------------------------------------------*
      *   BUSCA LOS DIAS A#O A APLICAR Y LA RAZON DE LA PROGRESION     *
      *   EN LAS CONDICIONES DE ADMINISTRACION ESTANDAR, ENTRE OTROS   *
      *   CAMPOS.                                                      *
      *                                                                *
      ******************************************************************
       2243-SELECT-ADMINIS-STD.
      *
           EXEC SQL
             SELECT
               CODTIPRE ,
               CODTIAMO,
               PERCAP,
               PERINT,
               CAREINT,
               CARECAP,
               PROGARIT,
               PROGGEOM,
               LININCUO,
               INDLIQEN,
               INDSUBVE,
               TIPODIAS,
               UGYFARET,
               INDINANT,
               ENTSUB,
      ******************************************************************
      *****  INCLUSION DE VARIABLES UTILIZADAS EN REDESCUENTOS     *****
      ******************************************************************
              CONSUB,    INDINVAR,    ISUMCOM
             INTO
              :ADS-CODTIPRE ,
              :ADS-CODTIAMO,
              :ADS-PERCAP,
              :ADS-PERINT,
              :ADS-CAREINT,
              :ADS-CARECAP,
              :ADS-PROGARIT,
              :ADS-PROGGEOM,
              :ADS-LININCUO,
              :ADS-INDLIQEN,
              :ADS-INDSUBVE,
              :ADS-TIPODIAS,
              :ADS-UGYFARET,
              :ADS-INDINANT,
              :ADS-ENTSUB,
      ******************************************************************
      *****  INCLUSION DE VARIABLES UTILIZADAS EN REDESCUENTOS     *****
      ******************************************************************
              :ADS-CONSUB,  :ADS-INDINVAR,  :ADS-ISUMCON
             FROM UGDTADS
              WHERE PRODUCTO       = :PRO-PRODUCTO       AND
                    SUBPRO         = :PRO-SUBPRO         AND
                    FECOVALI  <=     :MAE-FECAPROBA      AND
                    FEFIVALI  >=     :MAE-FECAPROBA
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE.
      *
           IF (DB2-OK  AND  SQLWARN0 = SPACES)
              MOVE  ADS-CODTIPRE              TO SW-CLAUSULAS-REV
      *COL65-I
                                                 WS-CODTIPRE
      *COL65-F
              MOVE  ADS-PERCAP                TO WS-PERCAP
                                                 WS-PER-CAPITAL
      *
              MOVE  ADS-PERINT                TO WS-PERINT
              MOVE  ADS-CAREINT               TO WS-CAREINT
              MOVE  ADS-CARECAP               TO WS-CARECAP
      *
              MOVE  ADS-CODTIAMO              TO WS-CODTIAMO
                                                 COT-TIP-CUOTA
                                                 CO2-TIP-CUOTA
      *
      *NOVA02-I
           IF SI-FLEXIBLE
              MOVE MAE-FEVENCIN               TO WS-FEVENCIN-ANT
              MOVE MAE-SALREAL                TO WS-SALREAL-INICIAL
              MOVE MPF-PERCAP(1:1)            TO WS-PERCAP(1:1)
              MOVE MPF-PERCAP(3:2)            TO WS-PERCAP(2:2)
              MOVE WS-PERCAP                  TO WS-PER-CAPITAL
              MOVE MPF-PERINT(1:1)            TO WS-PERINT(1:1)
              MOVE MPF-PERINT(3:2)            TO WS-PERINT(2:2)
              MOVE '1'                        TO COT-TIP-CUOTA
              MOVE '1'                        TO CO2-TIP-CUOTA
           END-IF
      *NOVA02-F
      *
              MOVE  ADS-PROGARIT              TO WS-PROGARIT
              MOVE  ADS-PROGGEOM              TO WS-PROGGEOM
              MOVE  ADS-LININCUO              TO WS-LININCUO
              MOVE  ADS-INDLIQEN              TO WS-INDLIQEN
      *@COL03-I
              IF WS-INDLIQEN NOT = 'S'
                 MOVE 'S'                     TO WS-INDLIQEN
              END-IF
      *@COL03-F
              MOVE  ADS-INDSUBVE              TO WS-INDSUBME
              MOVE  ADS-TIPODIAS              TO WS-TIPODIAS
              MOVE  ADS-UGYFARET              TO WS-UGYFARET
              MOVE  ADS-INDINANT              TO WS-INDINANT
           ELSE
              IF (DB2-NOTFND  AND SQLWARN0 = SPACES)
                 MOVE CTE-CON-UGE0079         TO CAA-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              ELSE
      *COL31I
      *          MOVE 'UGDTADS'               TO CAA-VAR1-ERROR
      *          MOVE 'SELECT UGDTADS'        TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTADS' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
              END-IF
           END-IF.
      *
           EJECT
      *
      ******************************************************************
      *              2244-SELECT-ADMINIS-ESP                           *
      *----------------------------------------------------------------*
      *   BUSCA LOS DIAS A#O A APLICAR Y LA RAZON DE LA PROGRESION     *
      *   EN LAS CONDICIONES DE ADMINISTRACION ESPECIFICAS, ENTRE      *
      *   OTROS CAMPOS.                                                *
      *                                                                *
      ******************************************************************
       2244-SELECT-ADMINIS-ESP.
      *
           EXEC SQL
             SELECT
               CODTIPRE ,
               CODTIAMO,
               PERCAP,
               PERINT,
               CAREINT,
               CARECAP,
               PROGARIT,
               PROGGEOM,
               LININCUO,
               INDLIQEN,
               INDSUBVE,
               TIPODIAS,
               UGYFARET,
               INDINANT,
               ENTSUB,
      ******************************************************************
      *****  INCLUSION DE VARIABLES UTILIZADAS EN REDESCUENTOS     *****
      ******************************************************************
               CONSUB,    INDINVAR,    ISUMCOM
             INTO
              :ADE-CODTIPRE ,
              :ADE-CODTIAMO,
              :ADE-PERCAP,
              :ADE-PERINT,
              :ADE-CAREINT,
              :ADE-CARECAP,
              :ADE-PROGARIT,
              :ADE-PROGGEOM,
              :ADE-LININCUO,
              :ADE-INDLIQEN,
              :ADE-INDSUBVE,
              :ADE-TIPODIAS,
              :ADE-UGYFARET,
              :ADE-INDINANT,
              :ADE-ENTSUB,
      ******************************************************************
      *****  INCLUSION DE VARIABLES UTILIZADAS EN REDESCUENTOS     *****
      ******************************************************************
              :ADE-CONSUB,     :ADE-INDINVAR,  :ADE-ISUMCON
             FROM UGDTADE
              WHERE
                    ENTIOFI        = :MAE-ENTIOFI       AND
                    CUENTA         = :MAE-CUENTA        AND
                    FECOVALI  <=     :WS-DB2-FEVALOR  AND
                    FEFIVALI  >=     :WS-DB2-FEVALOR
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE.
      *
           IF (DB2-OK   AND SQLWARN0 = SPACES)
              MOVE  ADE-CODTIPRE              TO SW-CLAUSULAS-REV
      *COL65-I
                                                 WS-CODTIPRE
      *COL65-F
              MOVE  ADE-PERCAP                TO WS-PERCAP
                                                 WS-PER-CAPITAL
      *
              MOVE  ADE-PERINT                TO WS-PERINT
              MOVE  ADE-CAREINT               TO WS-CAREINT
              MOVE  ADE-CARECAP               TO WS-CARECAP
              MOVE  ADE-CODTIAMO              TO WS-CODTIAMO
                                                 COT-TIP-CUOTA
                                                 CO2-TIP-CUOTA
      *
      *NOVA02-I
           IF SI-FLEXIBLE
              MOVE MAE-FEVENCIN               TO WS-FEVENCIN-ANT
              MOVE MAE-SALREAL                TO WS-SALREAL-INICIAL
              MOVE MPF-PERCAP(1:1)            TO WS-PERCAP(1:1)
              MOVE MPF-PERCAP(3:2)            TO WS-PERCAP(2:2)
              MOVE WS-PERCAP                  TO WS-PER-CAPITAL
              MOVE MPF-PERINT(1:1)            TO WS-PERINT(1:1)
              MOVE MPF-PERINT(3:2)            TO WS-PERINT(2:2)
              MOVE '1'                        TO COT-TIP-CUOTA
              MOVE '1'                        TO CO2-TIP-CUOTA
           END-IF
      *NOVA02-F
      *
              MOVE  ADE-PROGARIT              TO WS-PROGARIT
              MOVE  ADE-PROGGEOM              TO WS-PROGGEOM
              MOVE  ADE-LININCUO              TO WS-LININCUO
              MOVE  ADE-INDLIQEN              TO WS-INDLIQEN
      *@COL03-I
              IF WS-INDLIQEN NOT = 'S'
                 MOVE 'S'                     TO WS-INDLIQEN
              END-IF
      *@COL03-F
              MOVE  ADE-INDSUBVE              TO WS-INDSUBME
              MOVE  ADE-TIPODIAS              TO WS-TIPODIAS
              MOVE  ADE-UGYFARET              TO WS-UGYFARET
              MOVE  ADE-INDINANT              TO WS-INDINANT
           ELSE
              IF (DB2-NOTFND  AND SQLWARN0 = SPACES)
                 MOVE CTE-CON-UGE0087         TO CAA-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              ELSE
      *COL31I
      *          MOVE 'UGDTADE'               TO CAA-VAR1-ERROR
      *          MOVE 'SELECT UGDTADE'        TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTADE' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
              END-IF
           END-IF.
      *
           EJECT
      *
      ******************************************************************
      *             2245-LIQUIDA                                       *
      *----------------------------------------------------------------*
      *    SE CALCULAN LOS INTERESES QUE HAY QUE LIQUIDAR VALIDANDO    *
      *    QUE EL IMPORTE DE LA ENTREGA ES SUPERIOR                    *
      *                                                                *
      ******************************************************************
       2245-LIQUIDA.
      *
           IF WS-INDINANT = 'A' OR 'P'
              MOVE 'UGE0161'                  TO CAA-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF
      *
      *@COL48-I
           PERFORM 26400-CALCULO-ANTICIPOS
      *@COL48-F
      ******************************************************************
      *****  BUSCAR SI EL PRESTAMO ES ICR O NO                     *****
      ******************************************************************
           EVALUATE S-TAS-LIQUID
              WHEN 'S'
                 IF MAE-FEULIES      > MAE-FEULIQ
                    MOVE MAE-FEULIES          TO AUX-AAAA-MM-DD
                 ELSE
                    MOVE MAE-FEULIQ           TO AUX-AAAA-MM-DD
      *NOVA02-I
                    IF SI-FLEXIBLE
                       MOVE MPF-FEULIQI       TO AUX-AAAA-MM-DD
                    END-IF
      *NOVA02-F
                 END-IF
              WHEN OTHER
                 MOVE MAE-FEULIQ              TO AUX-AAAA-MM-DD
      *NOVA02-I
                 IF SI-FLEXIBLE
                    MOVE MPF-FEULIQI       TO AUX-AAAA-MM-DD
                 END-IF
      *NOVA02-F
           END-EVALUATE
           IF SW-SI-HAY-GRACIA
               MOVE MAE-FEFORMA             TO AUX-AAAA-MM-DD
           END-IF
      *@COL14-I
           IF NO-VAL-PPC
      *@COL14-F
      *L-V20121031 - INI
              AND SW-TRAS-NO
      *L-V20121031 - FIN
      *GLK01-I
      *        SOLO BUSCA PAGO ANTICIPADO PARA CARTERA HIPOTECARIA
               IF MAE-IND-MARCA4 = 'H'
                  PERFORM 24450-LLAMA-RUT-DAT-PAG-ANT
                  IF DPA-CDRETORNO = '00'         AND
                     DPA-FEOPER-MAX > AUX-AAAA-MM-DD
                     MOVE DPA-FEOPER-MAX          TO AUX-AAAA-MM-DD
      *COL80-I
                     MOVE DPA-FEOPER-MAX          TO WS-FEC-INIANT
                  ELSE
                     MOVE MAE-FEULIQ              TO WS-FEC-INIANT
      *COL80-F
                  END-IF
      *COL119-I
                  PERFORM 24-VALIDAR-CAMBIO-DIA-FACT
                  IF WS-FECHA-CAMBIO-LIQ > AUX-AAAA-MM-DD
                     MOVE WS-FECHA-CAMBIO-LIQ     TO AUX-AAAA-MM-DD
                  END-IF
      *COL119-F
               END-IF
      *GLK01-F
               MOVE AUX-AAAA                      TO WS-AUX-AAAA
               MOVE AUX-MM                        TO WS-AUX-MM
               MOVE AUX-DD                        TO WS-AUX-DD
               MOVE WS-AUX-DD-MM-AAAA             TO W075-FHGRE1
      *
               MOVE WS-DB2-FEVALOR                TO AUX-AAAA-MM-DD
               MOVE AUX-AAAA                      TO WS-AUX-AAAA
               MOVE AUX-MM                        TO WS-AUX-MM
               MOVE AUX-DD                        TO WS-AUX-DD
               MOVE WS-AUX-DD-MM-AAAA             TO W075-FHGRE2
      *
               PERFORM  LLAMAR-TC1C1220
      *
               MOVE WS-DIAS                       TO WS-NUMDIAS-2
      *
               IF WS-CODTIAMO  =  CTE-CON-B
                  COMPUTE  WS-CAPITAL ROUNDED = MAE-UGIIIANA
               ELSE
                  COMPUTE  WS-CAPITAL ROUNDED = MAE-SALTEOR
               END-IF
      *
      *GLK01-I
      *        BUSCA INTERES PARA PAGO ANTICIPADO SOBRE EL MAE-SALTEOR
      *        APLICA COBERTURA SI APLICA, SOLO PARA CARTERA HIPOTECARIA
               IF MAE-IND-MARCA4 ='H'
                  PERFORM 224500-BUSCA-INT-AI
               END-IF
      *GLK01-F

               EVALUATE S-TAS-LIQUID
                  WHEN 'S'
                       MOVE MAE-SALTEOR             TO WS-CAPITAL
                  WHEN OTHER
                       MOVE G07-IMPORTE             TO WS-CAPITAL
               END-EVALUATE
      *COL50-I
      *L-V20121031 - INI
      *       IF MAE-UGYEMCED = 'S'
              IF MAE-IND-MARCA4 = 'N'
      *L-V20121031 - FIN
               PERFORM 22729-SELECT-DIFERIDOS
               IF MAL-LIBRE-IMP1 > 0 OR MAL-LIBRE-IMP5 > 0
      *@COL73-I
                  SET SI-DIFERIDO    TO TRUE
      *@COL73-F
      *COL54-I
      *         IF G07-OPCION = '1'
                IF G07-OPCION = '1' OR (G07-OPCION = '0' AND
                                          G07-COMISIO = '1')
      *COL54-F
      * CALCULAMOS LA PROPORCION DEL ABONO QUE SERA PARA DIFERIDOS
                  COMPUTE WS-TOTAL-DIF = MAL-LIBRE-IMP1 + MAL-LIBRE-IMP5
                  COMPUTE WS-PROPORCION = WS-TOTAL-DIF / MAE-SALTEOR
      *COL95-I
                  IF SI-DIFERIDO-COR AND NO-GRACIA THEN
                     PERFORM 333-CALC-DIF-DIAS
                     COMPUTE WS-AUX-SEG2 ROUNDED = (MAL-LIBRE-IMP5 /
                                        WS-DIAS-TOT) * WS-DIAS-PAGAR
                     MOVE WS-AUX-SEG2      TO WS-AUX-SEG
                     COMPUTE WS-MAL-LIBRE-SEG1 = MAL-LIBRE-IMP5 -
                                                 WS-AUX-SEG
                     COMPUTE WS-AUX-INT = (MAL-LIBRE-IMP1 / WS-DIAS-TOT)
                                        * WS-DIAS-PAGAR
                     COMPUTE WS-ABO-DIFERIDO = WS-AUX-SEG + WS-AUX-INT
                     MOVE WS-ABO-DIFERIDO  TO WS-ABO-DIF-AUX
                     COMPUTE WS-MAL-LIBRE-INT1 = MAL-LIBRE-IMP1 -
                                                 WS-AUX-INT
                     PERFORM 3311-VALIDA-PAGOS
                  ELSE
      *COL95-F
      *COL52-I
      *               COMPUTE WS-ABO-DIFERIDO = G07-IMPORTE
      *                       * WS-PROPORCION
                      IF G07-IMPORTE > MAE-SALTEOR
                         COMPUTE WS-ABO-DIFERIDO = MAE-SALTEOR
                                 * WS-PROPORCION
                         END-COMPUTE
                      ELSE
                         COMPUTE WS-ABO-DIFERIDO = G07-IMPORTE
                                 * WS-PROPORCION
                         END-COMPUTE
                      END-IF
                      IF WS-ABO-DIFERIDO > WS-TOTAL-DIF
                         MOVE WS-TOTAL-DIF TO WS-ABO-DIFERIDO
                      END-IF
      *COL52-F
      *COL95-I
                  END-IF
      *COL95-F
                  COMPUTE WS-CAPITAL = G07-IMPORTE - WS-ABO-DIFERIDO
                END-IF
      *COL54-I
      *         IF G07-OPCION = '2'
                IF G07-OPCION = '2'  OR (G07-OPCION = '0' AND
                                         G07-COMISIO = '2')
      *COL54-F
                 COMPUTE WS-TOTAL-DIF = MAL-LIBRE-IMP1 + MAL-LIBRE-IMP5
                 MOVE 1                          TO WS-NPERIODOS
                 COMPUTE WS-TAS-POR = IEN-EFECTIVA / 100
                 COMPUTE WS-TAS-DIARIA = ( ( 1 + WS-TAS-POR ) **
                                         ( 1 / 365) )  - 1
                 END-COMPUTE
                 PERFORM 22740-DIAS-ULIQ
                 MOVE W075-NUMDIAS               TO WS-DIAS-ULIQ
                 COMPUTE WS-DIF-MES = WS-TOTAL-DIF / DRB-UGNPLPEN
                 MOVE MAL-CUOTA                  TO WS-CUOT-PERI
                 COMPUTE WS-TASA-PERI = (1 + (IEN-EFECTIVA / 100))
                         ** (1 / 12) - 1
                 END-COMPUTE
                 SET NO-SALE                     TO TRUE
                 PERFORM 22776-CALCULOS-PLAZO-A UNTIL SI-SALE
      *COL95-I
                 IF NO-GRACIA AND SI-DIFERIDO-COR THEN
                    MOVE MAE-PLAZO               TO WS-PLAZO1
                    COMPUTE WS-DIAS-PAGAR=WS-NUMERO-PLAZO - WS-NPERIODOS
      * SE VALIDA SI ALCANZA A TOMAR CUOTAS CON EL ABONO REALIZADO
      * SI NO ALCANZA, SE CUENTA COMO UNA CUOTA PARA PAGAR INTERESES Y
      *                SEGUROS, LOS SOBRANTES PAGARAN CAPITAL
                    IF WS-DIAS-PAGAR = ZEROES THEN
                       MOVE 1                    TO WS-DIAS-PAGAR
                    END-IF
                    COMPUTE WS-AUX-SEG= MAL-LIBRE-IMP5 / WS-NUMERO-PLAZO
                    COMPUTE WS-AUX-INT= MAL-LIBRE-IMP1 / WS-NUMERO-PLAZO
                    COMPUTE WS-AUX-SEG = WS-AUX-SEG * WS-DIAS-PAGAR
                    COMPUTE WS-AUX-INT = WS-AUX-INT * WS-DIAS-PAGAR
                    COMPUTE WS-AUX-SEG2 ROUNDED = WS-AUX-SEG
                    MOVE WS-AUX-SEG2             TO WS-AUX-SEG
                    COMPUTE WS-MAL-LIBRE-SEG1 = MAL-LIBRE-IMP5 -
                                                WS-AUX-SEG
                    COMPUTE WS-MAL-LIBRE-INT1 = MAL-LIBRE-IMP1 -
                                                WS-AUX-INT
                    COMPUTE WS-ABO-DIFERIDO   = WS-AUX-SEG + WS-AUX-INT
                    MOVE WS-ABO-DIFERIDO         TO WS-ABO-DIF-AUX
                    PERFORM 3311-VALIDA-PAGOS
                 END-IF
      *COL95-F
                END-IF
               END-IF
              END-IF
      *COL50-F
      *
      *VER20030612-I-COMISIONES-CAVE
                MOVE ZEROS                         TO WS-VAL-COMISIONES
      *VER20030612-F-COMISIONES-CAVE
      *
      ******************************************************************
      *  DISTRIBUCION DE FORMA AUTOMATICA EN LOS INTERESES Y CAPITAL   *
      *  DE ACUERDO AL MONTO TOTAL A ABONAR                            *
      *    - SE REALIZA 5 VECES EL PROCESO DE DISTRIBUCION PARA        *
      *      APROXIMAR EL PAGO DE INTERESES Y CAPITAL.                 *
      ******************************************************************
      *@COL50-I
                IF WS-ABO-DIFERIDO > ZEROS
                   MOVE G07-IMPORTE TO WG07-IMPORTE-AUX
                   MOVE WS-CAPITAL  TO G07-IMPORTE
