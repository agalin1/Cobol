      *@COL84-f
             MOVE '0001-01-01'             TO  LOG-FECANT
             MOVE 'SANC1'                  TO  LOG-CODIGO
             MOVE 1                        TO  LOG-CONSOPE
             MOVE 'UGDTT37'                TO  LOG-TABLA
             MOVE T37-ELEMENTO             TO  LOG-DESCRIPCION(01:25)
             MOVE T37-RESTO                TO  LOG-DESCRIPCION(26:40)
             MOVE MAE-ENTIOFI(1:4)         TO  LOG-ENTIDAD-UMO
             MOVE MAE-ENTIOFI(5:)          TO  LOG-CENTRO-UMO
             MOVE 'CANCANT'                TO  LOG-USERID-UMO
             MOVE 'UG2CG190'               TO  LOG-NETNAME-UMO
             MOVE T37-SECCION              TO  LOG-IMPNUE

              EXEC SQL
                  INSERT INTO UGDTLOG (
                              LOG_ENTIOFI,
                              LOG_CUENTA,
                              LOG_TIMESTAMP,
                              LOG_CODIGO,
                              LOG_FECMOV,
                              LOG_FECANT,
                              LOG_DESCRIPCION,
                              LOG_ENTIDAD_UMO,
                              LOG_CENTRO_UMO,
                              LOG_USERID_UMO,
                              LOG_NETNAME_UMO,
                              LOG_CONSOPE,
                              LOG_TABLA,
                              LOG_IMPNUE)
                  VALUES (    : LOG-ENTIOFI,
                              : LOG-CUENTA,
                                CURRENT TIMESTAMP ,
                              : LOG-CODIGO,
                              : LOG-FECMOV,
                              : LOG-FECANT,
                              : LOG-DESCRIPCION,
                              : LOG-ENTIDAD-UMO,
                              : LOG-CENTRO-UMO,
                              : LOG-USERID-UMO,
                              : LOG-NETNAME-UMO,
                              : LOG-CONSOPE,
                              : LOG-TABLA,
                              : LOG-IMPNUE)
              END-EXEC
      *
              MOVE SQLCODE       TO DB2-RETURN-CDE
      *
              IF NOT DB2-OK  OR  SQLWARN0 NOT = SPACES
                   MOVE 'UGE0939'           TO CAA-COD-ERROR
                   MOVE 'INSERT LOG'        TO CAA-VAR1-ERROR
                   MOVE SQLCODE             TO CAA-VAR2-ERROR
