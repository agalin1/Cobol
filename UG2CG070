           MOVE SQLCODE                       TO DB2-RETURN-CDE.
      *
           EJECT
      *
      ******************************************************************
      *             23523-ACT-TBL-V-O1                                 *
      *----------------------------------------------------------------*
      *    PARA CUOTAS VARIABLES Y OPCION "MANTENER VENCIMIENTO Y      *
      *    REDUCIR CUOTA", HALLAR IMPORTE Y FECHAS DE COMIENZO Y       *
      *    FIN DE VALIDEZ DE LA PRIMERA CUOTA DESPUES DE LA ENTREGA.   *
      *                                                                *
      *  OPCION 1, IGUAL VENCIMIENTO Y MENOR CUOTA:                    *
      *    FECOVALI: FECHA VALOR O FECHA DE FIN DE CARENCIA            *
      *    FEFIVALI: LA QUE HABIA ANTES                                *
      *                                                                *
      ******************************************************************
       23523-ACT-TBL-V-O1.
      *
           MOVE WS-MES-CUOTAO1                TO CUO-IMPMINI
      *
           IF WS-DB2-FEVALOR     >  MAE-FEFINCAR
              MOVE WS-DB2-FEVALOR             TO CUO-FECOVALI
      *
              IF COT-TIP-CUOTA      = CTE-CON-ALFA-3       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-4       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-7       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-8
                 MOVE  MAE-FEPROAMO           TO CUO-FEFIVALI
              ELSE
      ******************************************************************
      *            FEFIVALI=FEPROAMO+(WS-R-INICIAL - 1)*PERIODO
      ******************************************************************
                  MOVE  MAE-FEPROAMO          TO DFP-FECHA-INICIAL
                  SUBTRACT CTE-CON-1-COMP3      FROM WS-R-INICIAL
                       GIVING  DFP-NUM-PERIODOS
                       ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
                  END-SUBTRACT
      *
                  PERFORM  22731-DESPLAZAR-FECHA
                  MOVE  DFP-FECHA-FINAL       TO  CUO-FEFIVALI
              END-IF
           ELSE
              MOVE MAE-FEFINCAR               TO CUO-FECOVALI
      *
              IF COT-TIP-CUOTA      = CTE-CON-ALFA-3       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-4       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-7       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-8
      ******************************************************************
      *            FEFIVALI=FEFINCAR+PERIODO
      ******************************************************************
                 MOVE  MAE-FEFINCAR           TO DFP-FECHA-INICIAL
                 MOVE CTE-CON-1-COMP3         TO DFP-NUM-PERIODOS
                 PERFORM  22731-DESPLAZAR-FECHA
                 MOVE  DFP-FECHA-FINAL        TO CUO-FEFIVALI
              ELSE
      ******************************************************************
      *            FEFIVALI=FEFINCAR+(1 + WS-R-INICIAL - 1)*PERIODO
      ******************************************************************
                 MOVE MAE-FEFINCAR            TO DFP-FECHA-INICIAL
                 MOVE WS-R-INICIAL            TO DFP-NUM-PERIODOS
                 PERFORM  22731-DESPLAZAR-FECHA
                 MOVE  DFP-FECHA-FINAL        TO CUO-FEFIVALI
              END-IF
           END-IF
      *
      *KRY01-I
      *      IF CUO-FEFIVALI      > CUO-FECOVALI
           IF CUO-FEFIVALI      >= CUO-FECOVALI
      *KRY01-F
              MOVE  CAA-NETNAME-CONT          TO CUO-NETNAME-UMO
              MOVE  CAA-USERID                TO CUO-USERID-UMO
              MOVE  CAA-ENTIDAD               TO CUO-ENTIDAD-UMO
              MOVE  CAA-CENTRO-CONT           TO CUO-CENTRO-UMO
              MOVE  MAE-MONEDA                TO CUO-MONEDA
              PERFORM 23513-INSERT-CUOTAS
           END-IF.
      *
           EJECT
      *
      ******************************************************************
      *             23524-ACT-TBL-V-O2                                 *
      *----------------------------------------------------------------*
      *    PARA CUOTAS VARIABLES Y OPCION "MANTENER CUOTA Y REDUCIR    *
      *    VIDA PRESTAMO", HALLAR IMPORTE Y FECHAS DE COMIENZO Y       *
      *    FIN DE VALIDEZ DE LA PRIMERA CUOTA DESPUES DE LA ENTREGA    *
      *                                                                *
      *  OPCION 2, IGUAL CUOTA       Y MENOR VIDA:                     *
      *    FECOVALI: FECHA VALOR                                       *
      *    FEFIVALI: LA QUE HABIA ANTES O LA FECHA DE VENCIMIENTO      *
      *                                                                *
      ******************************************************************
       23524-ACT-TBL-V-O2.
      *
           MOVE WS-MES-CUOTAO2                TO CUO-IMPMINI
           MOVE WS-DB2-FEVALOR                TO CUO-FECOVALI
      *
           IF COT-TIP-CUOTA      = CTE-CON-ALFA-3       OR
              COT-TIP-CUOTA      = CTE-CON-ALFA-4       OR
              COT-TIP-CUOTA      = CTE-CON-ALFA-7       OR
              COT-TIP-CUOTA      = CTE-CON-ALFA-8
              MOVE  MAE-FEPROAMO              TO CUO-FEFIVALI
           ELSE
      ******************************************************************
      *        FEFIVALI=FEPROAMO+(WS-R-FINAL   - 1)*PERIODO
      ******************************************************************
              MOVE  MAE-FEPROAMO              TO DFP-FECHA-INICIAL
              SUBTRACT CTE-CON-1-COMP3      FROM WS-R-FINAL
                   GIVING  DFP-NUM-PERIODOS
                   ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
              END-SUBTRACT
              PERFORM  22731-DESPLAZAR-FECHA
              MOVE  DFP-FECHA-FINAL           TO CUO-FEFIVALI
           END-IF
      *
      *KRY01-I
      *       IF CUO-FEFIVALI      > CUO-FECOVALI
           IF CUO-FEFIVALI      >= CUO-FECOVALI
      *KRY01-F
              MOVE  CAA-NETNAME-CONT          TO CUO-NETNAME-UMO
              MOVE  CAA-USERID                TO CUO-USERID-UMO
              MOVE  CAA-ENTIDAD               TO CUO-ENTIDAD-UMO
              MOVE  CAA-CENTRO-CONT           TO CUO-CENTRO-UMO
              MOVE  MAE-MONEDA                TO CUO-MONEDA
              PERFORM 23513-INSERT-CUOTAS
           END-IF.
      *
           EJECT
      *
      ******************************************************************
      *             23526-ACT-TBL-V-O123                               *
      *----------------------------------------------------------------*
      *    PARA CUOTAS VARIABLES, CALCULAR E INSERTAR LAS SIGUIENTES   *
      *    CUOTAS HASTA EL VENCIMIENTO O FEFIVALIMAX.                  *
      *                                                                *
      ******************************************************************
       23526-ACT-TBL-V-O123.
      *
           MOVE CTE-CON-9999999999999         TO CO2-SALDO
           MOVE CTE-CON-1                     TO CO2-SALTO-CUOTA
      *
           PERFORM WITH TEST BEFORE
              UNTIL CUO-FEFIVALI = WS-FEFIVALIMAX
              MOVE CUO-IMPMINI                TO  CO2-CUOTA
      *
              PERFORM RUTINA-CALC-CUOTA-SIGUIENTE
      *
              IF CO2-CODIGO       NOT =  ZERO
                 MOVE 'UGE0517'               TO CAA-COD-ERROR
                 MOVE 'UGFCCO2'               TO CAA-VAR1-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
      *
              MOVE CO2-CUOTA                  TO CUO-IMPMINI
              MOVE CUO-FEFIVALI               TO CUO-FECOVALI
              MOVE CUO-FECOVALI               TO DFP-FECHA-INICIAL
      *
              IF COT-TIP-CUOTA      = CTE-CON-ALFA-3       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-4       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-7       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-8
      ******************************************************************
      *            FEFIVALI=FECOVALI + PERIODO
      ******************************************************************
                 MOVE  CTE-CON-1-COMP3        TO DFP-NUM-PERIODOS
              ELSE
      ******************************************************************
      *     FEFIVALI=FECOVALI + PERIODO * WS-LININCUO
      ******************************************************************
                 MOVE  WS-LININCUO            TO DFP-NUM-PERIODOS
              END-IF
      *
              PERFORM  22731-DESPLAZAR-FECHA
      *
              MOVE  DFP-FECHA-FINAL           TO CUO-FEFIVALI
      *
              IF WS-FEFIVALIMAX  <  CUO-FEFIVALI
                 MOVE WS-FEFIVALIMAX          TO CUO-FEFIVALI
              END-IF
      *
              MOVE  CAA-NETNAME-CONT          TO CUO-NETNAME-UMO
              MOVE  CAA-USERID                TO CUO-USERID-UMO
              MOVE  CAA-ENTIDAD               TO CUO-ENTIDAD-UMO
              MOVE  CAA-CENTRO-CONT           TO CUO-CENTRO-UMO
              MOVE  MAE-MONEDA                TO CUO-MONEDA
      *
              PERFORM  23513-INSERT-CUOTAS
           END-PERFORM.
      *
           EJECT
      *
      ******************************************************************
      *             242-ACTUALITZAR-DRB                                *
      *                                                                *
      *                                                                *
      ******************************************************************
       242-ACTUALITZAR-DRB.

           MOVE  MAE-ENTIOFI          TO DRB-ENTIOFI
           MOVE  MAE-CUENTA           TO DRB-CUENTA

           EXEC SQL
               SELECT UGNINFAC,
                      UGIQUOTA,
                      UGNPLPEN,
                      UGYINAPL,
      ******************************************************************
      *****  VARIABLE PARA CAPITALIZABLES                          *****
      ******************************************************************
      *@COL50-I
                      UGNPLVEN,
      *@COL50-F
                      UGSPDREB
               INTO :DRB-UGNINFAC,
                    :DRB-UGIQUOTA,
                    :DRB-UGNPLPEN,
                    :DRB-UGYINAPL,
      *@COL50-I
                    :DRB-UGNPLVEN,
      *@COL50-F
                    :DRB-UGSPDREB
               FROM UGDTDRB
      *COL115-I
               WHERE CUENTA  = :DRB-CUENTA
                 AND ENTIOFI = :DRB-ENTIOFI
               FETCH FIRST 1 ROW ONLY
      *        WHERE ENTIOFI = :DRB-ENTIOFI
      *          AND CUENTA  = :DRB-CUENTA
      *COL115-F
           END-EXEC
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK               AND
                   SQLWARN0  =  SPACES)
               IF (DB2-NOTFND           AND
                   SQLWARN0  =  SPACES)
                   MOVE CTE-CON-UGB0004      TO CAA-COD-ERROR
                   MOVE 'UGDTDRB'            TO CAA-VAR1-ERROR
      *COL31I
      *            PERFORM 999999-ABEND-DB2
                   PERFORM 3-FINAL-PROGRAMA
      *COL31F
               ELSE
      *COL31I
      *            MOVE 'UGDTDRB'            TO CAA-VAR1-ERROR
      *            PERFORM 999999-ABEND-DB2
                   MOVE 'UGE0939'        TO CAA-COD-ERROR
                   MOVE 'ERROR  UGDTDRB' TO CAA-VAR1-ERROR
                   MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                   MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                   PERFORM 3-FINAL-PROGRAMA
      *COL31F
               END-IF
           END-IF.
      *COL90-I
           MOVE DRB-UGIQUOTA TO WS-UGIQUOTA-ANT
      *COL90-F
      *
      *
      *@COL32-INI
      *    ADD  CTE-CON-1  TO DRB-UGNINFAC.
      *    MOVE MAE-PLAZO  TO DRB-UGCPLAZO.
      *
      *    COMPUTE WS-DIF-PLAZOS = BCR-PLAPEN - WS-M-FINAL.
      *    IF BCR-FVTO NOT < BCR-FPPAGO
      *        ADD 1 TO WS-DIF-PLAZOS
      *    END-IF.
           MOVE MAE-PLAZO  TO DRB-UGCPLAZO
           IF G07-OPCION NOT = '5'
      *EFR01-I-1
              AND G07-OPCION NOT = '4'
      *EFR01-F-1
              ADD  CTE-CON-1  TO DRB-UGNINFAC
      *
              COMPUTE WS-DIF-PLAZOS = BCR-PLAPEN - WS-M-FINAL
              IF BCR-FVTO NOT < BCR-FPPAGO
                  ADD 1 TO WS-DIF-PLAZOS
              END-IF
           END-IF
      *@COL32-FIN
      *
      *VER20040921-I-CRE.LIQUIDO-CAVE
           IF PRO-INDISSU NOT = 'R'
      *VER20040921-F-CRE.LIQUIDO-CAVE
           AND G07-OPCION NOT = '4'
      *@COL32-INI
           AND G07-OPCION NOT = '5'
      *@COL32-FIN
      *@COL48-I
           AND G07-OPCION NOT = '6'
      *@COL48-F
              IF G07-OPCION = CTE-CON-1
                 IF WS-INDINANT = 'V'
                    IF WS-DB2-FEVALOR NOT < MAE-FEFINCAR
                       MOVE WS-MES-CUOTAO1 TO DRB-UGIQUOTA
                    END-IF
                 ELSE
                    IF WS-DB2-FEVALOR > MAE-FEFINCAR
                       MOVE WS-MES-CUOTAO1 TO DRB-UGIQUOTA
                    END-IF
                 END-IF
              ELSE
      *@COL34 - INICIO
                 IF G07-OPCION = '2' AND MAE-UGYEMCED = 'S'
                    AND ( ADE-CODTIAMO = '1' OR ADS-CODTIAMO = '1' )
                    CONTINUE
                 ELSE
      *@COL34 - FIN
                    IF WS-INDINANT = 'V'
                       IF WS-DB2-FEVALOR NOT < MAE-FEFINCAR
      *COL103-I
                       OR ( MAE-FEFINCAR  > WS-DB2-FEVALOR  AND
                           G07-OPCION = '2' )
      *COL103-F
                          MOVE WS-MES-CUOTAO2 TO DRB-UGIQUOTA
                       END-IF
                    ELSE
                       IF WS-DB2-FEVALOR > MAE-FEFINCAR
                          MOVE WS-MES-CUOTAO2 TO DRB-UGIQUOTA
                       END-IF
                    END-IF
      *@COL34 - INICIO
                 END-IF
      *@COL34 - FIN
      *VER20040921-I-CRE.LIQUIDO-CAVE
              END-IF
      *VER20040921-F-CRE.LIQUIDO-CAVE
           END-IF.
      *
              MOVE 0 TO DRB-UGPQSACT
      *
      ******************************************************************
      ******  VARIABLE PARA EL SALDO TEORICO                       *****
      ******               UNICAMENTE PARA CAPITALIZABLES          *****
      ******************************************************************
           IF WS-CODTIAMO  = 'D' OR WS-CODTIAMO = 'E'
      *VER20040921-I-CRE.LIQUIDO-CAVE
              OR PRO-INDISSU = 'R'
      *VER20040921-F-CRE.LIQUIDO-CAVE
              COMPUTE DRB-UGSPDREB  = MAE-SALTEOR
              END-COMPUTE
           END-IF.
      *@COL81-I
           IF G07-OPCION = '4' OR SW-CUOTA-FINAL-SI
              SUBTRACT WS-MES-IMPORTE       FROM DRB-UGSPDREB
                  GIVING  DRB-UGSPDREB
                  ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
              END-SUBTRACT
           END-IF
      *@COL81-F
      *
      *@COL32-INI
           IF G07-OPCION = '5'
      *EFR01-I
              OR G07-OPCION = '4'
      *EFR01-F
              SUBTRACT WS-MES-IMPORTE       FROM DRB-UGSPDREB
                  GIVING  DRB-UGSPDREB
                  ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
              END-SUBTRACT
           END-IF
      *@COL32-FIN
      *    MOVE  '1'                  TO DRB-UGYINAPL
           IF  G07-OPCION   = '4'
           AND DRB-UGYINAPL = '0'
               MOVE  '0'              TO DRB-UGYINAPL
           ELSE
               MOVE  '1'                  TO DRB-UGYINAPL
           END-IF
      *COL28-I
           IF MAE-UGYEMCED='S'
      *@COL34 - INICIO
      *@COL37 - INICIO
      *       AND G07-OPCION NOT EQUAL '2'
      *@COL37 - FIN
      *@COL34 - FIN
              PERFORM 2420-ACTUALITZAR-MAL
           END-IF
      *COL28-F
           MOVE  CAA-NETNAME-CONT     TO DRB-NETNAME-UMO
           MOVE  CAA-USERID           TO DRB-USERID-UMO
           MOVE  CAA-ENTIDAD          TO DRB-ENTITAT-UMO
           MOVE  CAA-CENTRO-CONT      TO DRB-CENTRE-UMO
      *
      *NOVA02-I
           IF SI-FLEXIBLE
              IF G07-OPCION = '1'
      *COL87-I
      *          MOVE WS-CUOTA-CAP1       TO DRB-UGIQUOTA
      *          MOVE WS-CUOTA-CAP1       TO G071-CUOTA1
                 MOVE WS-CUOTA-CAP2       TO G071-CUOTA1
      *COL87-F
      *COL89-I
                 MOVE MAE-SALTEOR         TO DRB-UGSPDREB
                 MOVE WS-CUOTA-CAP2       TO DRB-UGIQUOTA
      *COL89-F
              ELSE
      *COL87-I
      *          MOVE WS-CUOTA-CAP2       TO DRB-UGIQUOTA
      *          MOVE WS-CUOTA-CAP2       TO G071-CUOTA1
                 MOVE WS-CUOTA-CAP1       TO DRB-UGIQUOTA
                 MOVE WS-CUOTA-CAP1       TO G071-CUOTA1
      *COL87-F
      *COL89-I
                 MOVE MAE-SALTEOR         TO DRB-UGSPDREB
      *COL89-F
              END-IF
      *       PERFORM 2015-AJUSTA-MPF
           END-IF
      *NOVA02-F
      *COL81-I
           IF G07-OPCION = '4'
              MOVE COT-CUOTA              TO DRB-UGIQUOTA
           END-IF
      *COL81-F
      *COL90-I
           IF DRB-UGIQUOTA > WS-UGIQUOTA-ANT
              MOVE WS-UGIQUOTA-ANT TO DRB-UGIQUOTA
           END-IF
      *COL90-F
      *COL92-I
           IF SI-FLEXIBLE
              IF DRB-UGIQUOTA = ZEROS
                 DIVIDE MAE-SALTEOR BY DRB-UGNPLPEN
                       GIVING DRB-UGIQUOTA
              END-IF
           END-IF
      *COL92-F
      *COL87-I
           IF WS-UGCPLAZO = ZEROES
             CONTINUE
           ELSE
             MOVE  WS-UGCPLAZO           TO DRB-UGNPLPEN
           END-IF
      *COL87-F
      *EFR02-I
           IF SW-SI-PUNICA
              IF G07-OPCION = '2'
                 MOVE WS-M-FINAL              TO WS-PLAZO-NVO-PU
              ELSE
                 IF G07-OPCION = '1'
                    MOVE WS-M-INICIAL         TO WS-PLAZO-NVO-PU
                 END-IF
              END-IF
              COMPUTE WS-KTEOR-PU-NVO       = WS-KTEOR-PU - VLR-K-PU
              COMPUTE WS-COT-PUNICA ROUNDED = WS-KTEOR-PU-NVO /
                                              WS-PLAZO-NVO-PU
              ADD WS-COT-PUNICA           TO DRB-UGIQUOTA
           END-IF
      *COL107-I
           IF SI-INT-CAPITALIZADO
              MOVE MAE-SALTEOR            TO DRB-UGSPDREB
           END-IF
      *COL107-F
      *EFR02-F
      *
           EXEC SQL
               UPDATE UGDTDRB
               SET UGPQSACT     = :DRB-UGPQSACT,
                   UGNINFAC     = :DRB-UGNINFAC,
                   UGCPLAZO     = :DRB-UGCPLAZO,
      *COL87-I
                   UGNPLPEN     = :DRB-UGNPLPEN,
