      ******************************************************************
      *                      BUSCAR-UGDTPDI                            *
      *----------------------------------------------------------------*
      *                      SE BUSCAN LOS DATOS                       *
      *                  DENTRO DE LA TABLA UGDTDPI                    *
      ******************************************************************
       BUSCAR-UGDTPDI.
      *
           MOVE WS-FECHA-ACTUAL(1:4)               TO WS-FECHA-PDI(1:4)
           MOVE WS-FECHA-ACTUAL(6:2)               TO WS-FECHA-PDI(5:2)

           EXEC SQL

               SELECT SDO_ANT_CM_DIF,
                      SDO_ANT_I_DIF,
                      SDO_ANT_K_DIF_CAST,
                      SDO_ANT_I_DIF_CAST,
                      ALTA_CM_DIF,
                      ALTA_INT_DIF,
                      ALTA_K_DIF_CAST,
                      ALTA_I_DIF_CAST,
                      AMORT_CM_DIF,
                      AMORT_I_DIF,
                      AMORT_K_DIF_CAST,
                      AMORT_I_DIF_CAST,
                      SDO_FIN_CM_DIF,
                      SDO_FIN_I_DIF,
                      SDO_FIN_K_DIF_CAST,
                      SDO_FIN_I_DIF_CAST

               INTO   :PDI-SDO-ANT-CM-DIF,
                      :PDI-SDO-ANT-I-DIF,
                      :PDI-SDO-ANT-K-DIF-CAST,
                      :PDI-SDO-ANT-I-DIF-CAST,
                      :PDI-ALTA-CM-DIF,
                      :PDI-ALTA-INT-DIF,
                      :PDI-ALTA-K-DIF-CAST,
                      :PDI-ALTA-I-DIF-CAST,
                      :PDI-AMORT-CM-DIF,
                      :PDI-AMORT-I-DIF,
                      :PDI-AMORT-K-DIF-CAST,
                      :PDI-AMORT-I-DIF-CAST,
                      :PDI-SDO-FIN-CM-DIF,
                      :PDI-SDO-FIN-I-DIF,
                      :PDI-SDO-FIN-K-DIF-CAST,
                      :PDI-SDO-FIN-I-DIF-CAST

               FROM   UGDTPDI

               WHERE  ANO_MES =: WS-FECHA-PDI
                 AND  ENTIOFI =: MAE-ENTIOFI
                 AND  CUENTA  =: MAE-CUENTA

           END-EXEC
      *
           MOVE SQLCODE                        TO DB2-RETURN-CDE
      *
           IF DB2-OK
                PERFORM ACTUALIZACION-UGDTPDI
           ELSE IF DB2-NOTFND
                CONTINUE
           ELSE
                MOVE 'UGE0939'               TO CAA-COD-ERROR
                MOVE 'SELECT UGDTPDI  '      TO CAA-VAR1-ERROR
                PERFORM 999999-ROLLBACK
                PERFORM 3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *                   ACTUALIZACION-UGDTPDI                        *
      *----------------------------------------------------------------*
      *                      SE ACTUALIZAN DATOS                       *
      *                  DENTRO DE LA TABLA UGDTDPI                    *
      ******************************************************************
       ACTUALIZACION-UGDTPDI.
      *
           MOVE WS-FECHA-ACTUAL(1:4)     TO WS-FECHA-PDI(1:4)
           MOVE WS-FECHA-ACTUAL(6:2)     TO WS-FECHA-PDI(5:2)
           MOVE CAA-ENTIDAD              TO PDI-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT          TO PDI-CENTRO-UMO
           MOVE CAA-USERID               TO PDI-USERID-UMO
           MOVE CAA-NETNAME              TO PDI-NETNAME-UMO

           COMPUTE PDI-AMORT-CM-DIF     = PDI-AMORT-CM-DIF     +
                                          CRN0-CORR-MON

           COMPUTE PDI-AMORT-I-DIF      = PDI-AMORT-I-DIF      +
                                          CRN0-INT-DIF

           COMPUTE PDI-AMORT-K-DIF-CAST = PDI-AMORT-K-DIF-CAST +
                                          CRN0-CAP-CAS-DIF

           COMPUTE PDI-AMORT-I-DIF-CAST = PDI-AMORT-I-DIF-CAST +
                                          CRN0-INT-CAS-DIF

           COMPUTE PDI-SDO-FIN-CM-DIF   = PDI-SDO-ANT-CM-DIF    -
                                          PDI-AMORT-CM-DIF     +
                                          PDI-ALTA-CM-DIF

           COMPUTE PDI-SDO-FIN-I-DIF    = PDI-SDO-ANT-I-DIF   -
                                          PDI-AMORT-I-DIF      +
                                          PDI-ALTA-INT-DIF

           COMPUTE PDI-SDO-FIN-K-DIF-CAST = PDI-SDO-ANT-K-DIF-CAST -
                                            PDI-AMORT-K-DIF-CAST   +
                                            PDI-ALTA-K-DIF-CAST

           COMPUTE PDI-SDO-FIN-I-DIF-CAST = PDI-SDO-ANT-I-DIF-CAST -
                                            PDI-AMORT-I-DIF-CAST   +
                                            PDI-ALTA-I-DIF-CAST

           EXEC SQL

               UPDATE UGDTPDI

               SET AMORT_CM_DIF       =: PDI-AMORT-CM-DIF,
                   AMORT_I_DIF        =: PDI-AMORT-I-DIF,
                   AMORT_K_DIF_CAST   =: PDI-AMORT-K-DIF-CAST,
                   AMORT_I_DIF_CAST   =: PDI-AMORT-I-DIF-CAST,
                   SDO_FIN_CM_DIF     =: PDI-SDO-FIN-CM-DIF,
                   SDO_FIN_I_DIF      =: PDI-SDO-FIN-I-DIF,
                   SDO_FIN_K_DIF_CAST =: PDI-SDO-FIN-K-DIF-CAST,
                   SDO_FIN_I_DIF_CAST =: PDI-SDO-FIN-I-DIF-CAST,
                   ENTIDAD_UMO        =: PDI-ENTIDAD-UMO,
                   CENTRO_UMO         =: PDI-CENTRO-UMO,
                   USERID_UMO         =: PDI-USERID-UMO,
                   NETNAME_UMO        =: PDI-NETNAME-UMO,
                   TIMESTAMP          = CURRENT TIMESTAMP

               WHERE ANO_MES =: WS-FECHA-PDI
                 AND ENTIOFI =: MAE-ENTIOFI
                 AND CUENTA  =: MAE-CUENTA

           END-EXEC
      *
           MOVE SQLCODE                        TO DB2-RETURN-CDE
      *
           IF DB2-OK
                CONTINUE
           ELSE IF DB2-NOTFND
                CONTINUE
           ELSE
                MOVE 'UGE0939'               TO CAA-COD-ERROR
                MOVE 'UPDATE UGDTPDI  '      TO CAA-VAR1-ERROR
                PERFORM 999999-ROLLBACK
      *COL31I
      *         PERFORM 999999-ABEND-DB2
                MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
      *COL31F
                PERFORM 3-FINAL-PROGRAMA
           END-IF.
