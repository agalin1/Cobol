             IF MAE-IND-MARCA4 = 'N' AND WS-ABO-DIFERIDO > 0
      *COL63-F
      *COL95-I
                IF NO-GRACIA AND SI-DIFERIDO-COR THEN
                   COMPUTE  WS-AUX ROUNDED = WS-AUX + WS-ABO-DIF-AUX
