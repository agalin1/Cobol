              MOVE G07-IMPORTE             TO WS-MES-IMPORTE
              COMPUTE WS-MES-IMPORTE2 = WS-MES-IMPORTE -
                      (WS-AUX-INT + WS-AUX-SEG)
              IF WS-MES-IMPORTE2 < ZEROES THEN
                 MOVE ZEROES                  TO WS-MES-IMPORTE2
              END-IF
              MOVE WS-MES-IMPORTE2            TO WS-MES-IMPORTE
           ELSE
      *COL95-F
           MOVE G07-CAPITAL                   TO WS-MES-IMPORTE
      *COL95-I
           END-IF
      *COL95-F
      *
      *@COL73-I
           IF SI-GRACIA AND NO-DIFERIDO AND
              G07-OPCION EQUAL '0'
              ADD WS-MES-INTERESE             TO WS-MES-IMPORTE
              MULTIPLY WS-MES-INTERESE BY CTN-1-NEG
                 GIVING WS-MES-INTERESE
              MOVE WS-MES-INTERESE            TO WS-IN-EN
           END-IF
      *@COL73-F
           IF MAE-MONEDA NOT = 'COP'
              COMPUTE G071-INTERES     ROUNDED =
                      WS-MES-INTERESE  * WS-CAMBIO
              END-COMPUTE
              MOVE G071-INTERES               TO G072-INTERES
              COMPUTE G071-CAPITAL     ROUNDED =
                      WS-MES-IMPORTE   * WS-CAMBIO
              END-COMPUTE
              MOVE   G071-CAPITAL             TO G072-CAPITAL
           ELSE
              MOVE WS-MES-INTERESE            TO G071-INTERES
                                                 G072-INTERES
              MOVE WS-MES-IMPORTE             TO G071-CAPITAL
                                                 G072-CAPITAL
      *COL98-I
              ADD WS-VAL-INT-ALIV             TO WS-MES-INTERESE
      *COL98-F
           END-IF.
      *@COL15-I
