      *COL107-I
      ******************************************************************
      *                      9999-LIBRINT-CAPT                         *
      * SE VALIDA SI ES UNA LIBRANZA PARA VALIDAR SI TIENE INTERESES   *
      * CAPITALIZADOS                                                  *
      ******************************************************************
       9999-LIBRINT-CAPT.
           IF  MAE-UGYEMCED              =  'S'
           AND MAE-FECPRILIQ             >= MAE-FEULIQ
               SET SI-CAPITALIZA-SIMULADO    TO TRUE
               MOVE ZEROES                   TO WS-ABO-DIFERIDO
                                                WS-MES-COMISION
               PERFORM 9999-RUTINA-UR9CLICP
           END-IF.
      ******************************************************************
      *                      9999-RUTINA-UR9CLICP.                     *
      * LLAMADO A LA RUTINA UR9CLICP                                   *
      ******************************************************************
       9999-RUTINA-UR9CLICP.
           SET NO-INT-CAPITALIZADO       TO TRUE
           INITIALIZE UGWCLICP-01

           MOVE MAE-ENTIOFI                 TO LICP-ENTIOFI
           MOVE MAE-CUENTA                  TO LICP-CUENTA
           IF SI-CAPITALIZA-SIMULADO
           OR G07-OPCION                    =  CTE-CON-0
              MOVE '00'                     TO LICP-OPCION
              MOVE 'P'                      TO LICP-TIPOSIM
           ELSE
              MOVE '03'                     TO LICP-OPCION
           END-IF
           MOVE CAA-FECHA-CONT2             TO LICP-FECHA
           COMPUTE LICP-IMPORTE = G07-IMPORTE     -
                                  WS-AUX-SEG - WS-MES-COMISION

           CALL BBVA-UR9CLICP
                           USING UGWCLICP-01
      *
           EVALUATE LICP-CRETORNO
               WHEN '00'
                    SET SI-INT-CAPITALIZADO   TO TRUE
               WHEN '20'
                    CONTINUE
               WHEN OTHER
                   MOVE 'UGE0939'         TO CAA-COD-ERROR
                   MOVE LICP-MENSAJE1     TO CAA-VAR1-ERROR
                   MOVE LICP-MENSAJE2     TO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
      * -------------------------------------------------------------- *
      *                    9999-CONTA-INTECAP *
      * -------------------------------------------------------------- *
       9999-CONTA-INTECAP.
           INITIALIZE QHECCPT-01
           MOVE 'APA'           TO CPT-CODIGO
           MOVE MAE-MONEDA      TO CPT-DIVISA
           IF SI-INT-CAPITALIZADO AND UTR-TIPOGAR = 'XXX' OR
              UTR-TIPOGAR = SPACES
              MOVE CGP0-COD-HOMOL-PERS     TO UTR-TIPOGAR
           END-IF
           EVALUATE TRUE
               WHEN SI-CCORRIMI
                    PERFORM 9999-CONTA-CORRIM
               WHEN SI-CGRACIA
                    PERFORM 9999-CONTA-GRACIA
           END-EVALUATE.
      * -------------------------------------------------------------- *
       9999-CONTA-CORRIM.
           IF LICP-AJUSTCOR      >  ZEROES
              MOVE 'CAPIT'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTCOR TO CPT-IMPORTE
              MOVE UGWCUTR       TO CPT-CLVCONV
              PERFORM 503-CONCEPTOS-TS
              MOVE 'INFI2'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTCOR TO CPT-IMPORTE
              MOVE '1'           TO UTR-FILLER1
              PERFORM 503-CONCEPTOS-TS
           END-IF
           IF LICP-AJUSTGRA      >  ZEROES
              MOVE 'CAPIT'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTGRA TO CPT-IMPORTE
              MOVE UGWCUTR       TO CPT-CLVCONV
              PERFORM 503-CONCEPTOS-TS
              MOVE 'RPAIN'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTGRA TO CPT-IMPORTE
              PERFORM 503-CONCEPTOS-TS
           END-IF.
      *--------------------------------------------------------------- *
       9999-CONTA-GRACIA.
           IF LICP-AJUSTGRA      >  ZEROES
              MOVE 'CAPIT'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTGRA TO CPT-IMPORTE
              MOVE UGWCUTR       TO CPT-CLVCONV
              PERFORM 503-CONCEPTOS-TS
              MOVE 'RPAIN'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTGRA TO CPT-IMPORTE
              PERFORM 503-CONCEPTOS-TS
           END-IF
           IF LICP-AJUSTAMO      >  ZEROES
              MOVE 'INFI1'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTAMO TO CPT-IMPORTE
              MOVE '1'           TO UTR-FILLER1
              PERFORM 503-CONCEPTOS-TS
              MOVE 'RPAIN'       TO CPT-CONCEPTO-PROG
              MOVE LICP-AJUSTAMO TO CPT-IMPORTE
              MOVE UGWCUTR       TO CPT-CLVCONV
              PERFORM 503-CONCEPTOS-TS
           END-IF.
