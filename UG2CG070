      *   BUSCA SI EL PAGO SE REALIZO DESDE LA TRANSACCION DE PAGO     *
      *   PARA CREDITOS CON DERIVADO SWAP.                             *
      ******************************************************************
       21511-SELECT-UGDTSWP2.
      *
           INITIALIZE UGTCSWP

           PERFORM 8800-ABRIR-CURSOR
           PERFORM 8800-FETCH-CURSO2 UNTIL FIN-CURSOR-SWAP
           PERFORM 8800-CERRAR-CURSOR.
      *
 KJMR ******************************************************************
      *              8800-FETCH-CURSO2                                 |
      *----------------------------------------------------------------*
      *  HACEMOS UN FETCH SOBRE EL CURSOR QUE ESTE ABIERTO.            |
      *                                                                *
      ******************************************************************
       8800-FETCH-CURSO2.
      *
              EXEC SQL
               FETCH CURSOR-SWAP  INTO
                    :SWP-FEVALOR    ,
                    :SWP-FECONTA    ,
                    :SWP-NUMMOVI    ,
                    :SWP-IMPMOVI    ,
                    :SWP-NUMMOV-MIR ,
                    :SWP-IND-MARCA-PAGO,
                    :SWP-NUM-SWAP   ,
                    :SWP-TIPO-RECAUDO,
 KJMR               :SWP-TIMEST-UMO
              END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR SQLWARN0 NOT = SPACES
              MOVE 'UGE0939'             TO   CAA-COD-ERROR
              MOVE 'ERROR UGDTSWP'       TO   CAA-VAR1-ERROR
              MOVE 'SQLCODE '            TO   CAA-VAR2-ERROR(1:8)
              MOVE DB2-RETURN-CDE        TO   CAA-VAR2-ERROR(9:)
              PERFORM 3-FINAL-PROGRAMA
           ELSE
              IF DB2-NOTFND
                 SET FIN-CURSOR-SWAP        TO TRUE
              ELSE
                 IF SWP-IND-MARCA-PAGO = 'N'
                    ADD 1                   TO WS-UGYINCOR
                    PERFORM ACTUALIZA-N-SWAP
                 END-IF
              END-IF
 KJMR      END-IF.
      ******************************************************************
      *                       ACTUALIZA-N-SWA                          *
      *   ACTUALIZA EL INDICADOR DE PAGO AL CREDITO  CON DERIVADO SWAP *
      ******************************************************************
 KJMR  ACTUALIZA-N-SWAP.
      *
           MOVE MAE-ENTIOFI                   TO  SWP-ENTIOFI
           MOVE MAE-CUENTA                    TO  SWP-CUENTA
           MOVE 'A'                           TO  SWP-IND-MARCA-PAGO
      *
           MOVE WS-AMD-SWAP                   TO  SWP-FEVALOR
           MOVE WS-UGYINCOR                   TO  SWP-UGYINCOR

           EXEC SQL
              UPDATE UGDTSWP
                 SET IND_MARCA_PAGO = :SWP-IND-MARCA-PAGO,
                     TIMEST_UMO     = CURRENT TIMESTAMP  ,
                     PRGRM_UMO      = 'UG2CG070'         ,
                     UGYINCOR       = :SWP-UGYINCOR
               WHERE ENTIOFI        = :SWP-ENTIOFI
                 AND CUENTA         = :SWP-CUENTA
                 AND FEVALOR        = :SWP-FEVALOR
                 AND IND_MARCA_PAGO = 'N'
                 AND TIMEST_UMO     = :SWP-TIMEST-UMO
           END-EXEC

           MOVE SQLCODE                        TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
              IF DB2-NOTFND AND SQLWARN0 = SPACES
                 MOVE 'UGE0939'                TO CAA-COD-ERROR
                 MOVE 'NO EXISTE REGISTRO  '   TO CAA-VAR1-ERROR
                 MOVE 'REVISE CONDICIONES  '   TO CAA-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UGE0939'                TO CAA-COD-ERROR
                 MOVE 'UPDATE UGDTSWP'         TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '               TO CAA-VAR2-ERROR
                 MOVE SQLCODE                  TO CAA-VAR2-ERROR(8:4)
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
 KJMR      END-IF.
      ******************************************************************
      *                    2391-SELECT-ESTADOS                         *
      ******************************************************************
      *  SE VALIDA ESTADO Q Y P EN LA TABLA UGDTSWP PARA INSERTAR O    *
      *  ACTUALIZAR REGISTRO DE SOBRANTES Y PAGOS.                     *
      ******************************************************************
       2391-SELECT-ESTADOS.
      *
           INITIALIZE UGTCSWP

           MOVE MAE-ENTIOFI                    TO SWP-ENTIOFI
           MOVE MAE-CUENTA                     TO SWP-CUENTA
           MOVE WS-AMD-SWAP                    TO SWP-FEVALOR

           EXEC SQL                                                     00017360
             SELECT  TIPO_RECAUDO,                                      00017361
                     IMPMOVI     ,
                     DESCRIPCION ,
                     INDRETRO    ,
