               WHERE MPF_CUENTA  = :MPF-CUENTA
                 AND MPF_ENTIOFI = :MPF-ENTIOFI
               FETCH FIRST 1 ROW ONLY
      *        WHERE MPF_ENTIOFI = :MPF-ENTIOFI
      *          AND MPF_CUENTA  = :MPF-CUENTA
      *COL115-F
           END-EXEC
           MOVE SQLCODE                 TO DB2-RETURN-CDE
           IF DB2-OK AND SQLWARN0 = SPACES
              SET SI-FLEXIBLE  TO TRUE
      *COL96-I
              PERFORM 2013C-BUSCA-PLAN-ESPECIAL
      *COL96-F
              MOVE '9999'          TO WS-PERFLE
              IF MPF-PERSEG = '20TO'
                 MOVE '2060'       TO MPF-PERSEG
              END-IF
              IF MPF-PERSEG < WS-PERFLE
                 MOVE MPF-PERSEG TO WS-PERFLE
              END-IF
              IF MPF-PERINT < WS-PERFLE
                 MOVE MPF-PERINT TO WS-PERFLE
              END-IF
              IF MPF-PERCAP < WS-PERFLE
                 MOVE MPF-PERCAP TO WS-PERFLE
              END-IF
              PERFORM 2012A-BUSCA-PAKS-FLEX
           ELSE
              IF DB2-NOTFND AND SQLWARN0 = SPACES
                 SET NO-FLEXIBLE        TO TRUE
              ELSE
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'ERR SEL UGDTMPF'       TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
                 MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      *----------------------------------------------------------------*
      *                   2012A-BUSCA-PAKS-FLEX                        *
      *----------------------------------------------------------------*
       2012A-BUSCA-PAKS-FLEX.

           INITIALIZE UGTCMOV
           MOVE MAE-ENTIOFI                 TO MOV-ENTIOFI
           MOVE MAE-CUENTA                  TO MOV-CUENTA
           EXEC SQL
                SELECT FECONTA
                INTO  :MOV-FECONTA
                FROM UGDTMOV
                WHERE ENTIOFI  = :MOV-ENTIOFI  AND
                      CUENTA   = :MOV-CUENTA   AND
                      (FECONTA > :MPF-FEULIQI   AND
                      FECONTA < :CAA-FECHA-OPER2)  AND
                      CLACON IN ('DA', 'DC', 'DD', 'DE',
                      'D1', 'D2', 'D3', 'D5', 'D9')
                ORDER BY SECUMOV DESC
                FETCH FIRST ROW ONLY
           END-EXEC

           MOVE SQLCODE                         TO DB2-RETURN-CDE
           IF DB2-OK
              MOVE MOV-FECONTA            TO MPF-FEULIQI
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                 MOVE 'UGE0939'            TO CAA-COD-ERROR
                 MOVE 'ERROR TABLA'        TO CAA-VAR1-ERROR
                 MOVE 'UGDTMOVF'           TO CAA-VAR2-ERROR
                 MOVE SQLCODE              TO CAA-VAR2-ERROR(10:)
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      *----------------------------------------------------------------*
      *                   2013B-RED-PZO-CIC                            *
      *----------------------------------------------------------------*
       2013B-RED-PZO-CIC.

      *COL87-I
      *       MOVE G071-CUOTA2 TO WS-CUOTA-FLEX
              MOVE DRB-UGIQUOTA TO WS-CUOTA-FLEX
      *COL87-F
              IF G07-CAPITAL >=  WS-CUOTA-FLEX
                 DIVIDE G07-CAPITAL BY WS-CUOTA-FLEX
                       GIVING WS-NUM-RES-FLE
                 IF WS-NUM-RES-FLE > ZEROES
                    MOVE  WS-FEVENCIN-ANT    TO DF3-FECHA-INICIAL
                    MOVE  CTE-CON-FECHA-NULA TO DF3-FECHA-FINAL
                    MOVE  WS-PERFLE          TO DF3-PERCAP
                    MOVE  MAE-UGCDIPAG       TO WS-UGCDIPAG
                    MOVE  WS-UGCDIPAG        TO DF3-DIA
                    COMPUTE WS-NUM-RES-FLE = WS-NUM-RES-FLE * -1
                    MOVE WS-NUM-RES-FLE      TO DF3-NUM-PERIODOS
                    MOVE WS-TIPODIAS         TO DF3-TIPODIAS

                    CALL   BBVA-UR8CDFP0  USING  URECRES
                                                 URECDF3

                    IF RES-CORESPUE      NOT = '10'
                       MOVE 'UGE1141'         TO CAA-COD-ERROR
                       MOVE 'UR8CDFP0'        TO CAA-VAR1-ERROR
                       MOVE RES-CORESPUE      TO CAA-VAR2-ERROR
                       PERFORM 3-FINAL-PROGRAMA
                    ELSE
                       MOVE DF3-FECHA-FINAL      TO WS-FEC-FLE2
                       MOVE DF3-FECHA-FINAL(1:4) TO G071-VENCI2(7:4)
                       MOVE DF3-FECHA-FINAL(6:2) TO G071-VENCI2(4:2)
                       MOVE DF3-FECHA-FINAL(9:2) TO G071-VENCI2(1:2)
                       MOVE '/'                TO G071-VENCI2(3:1)
                       MOVE '/'                TO G071-VENCI2(6:1)
                    END-IF
                 ELSE
                    MOVE WS-FEVENCIN-ANT      TO WS-FEC-FLE2
                    MOVE WS-FEVENCIN-ANT(1:4) TO G071-VENCI2(7:4)
                    MOVE WS-FEVENCIN-ANT(6:2) TO G071-VENCI2(4:2)
                    MOVE WS-FEVENCIN-ANT(9:2) TO G071-VENCI2(1:2)
                    MOVE '/'                TO G071-VENCI2(3:1)
                    MOVE '/'                TO G071-VENCI2(6:1)
                 END-IF
              ELSE
                  MOVE WS-FEVENCIN-ANT      TO WS-FEC-FLE2
                  MOVE WS-FEVENCIN-ANT(1:4) TO G071-VENCI2(7:4)
                  MOVE WS-FEVENCIN-ANT(6:2) TO G071-VENCI2(4:2)
                  MOVE WS-FEVENCIN-ANT(9:2) TO G071-VENCI2(1:2)
                  MOVE '/'                TO G071-VENCI2(3:1)
                  MOVE '/'                TO G071-VENCI2(6:1)
              END-IF.

      *----------------------------------------------------------------*
      *                   2013-RED-CUO-FLEX                            *
      *----------------------------------------------------------------*
       2013-RED-CUO-FLEX.

           IF MPF-INDTPER = 'C'
              PERFORM 2013A-RED-CUO-CICL
           ELSE
              PERFORM 2013B-RED-CUO-ACIC
           END-IF.

      *----------------------------------------------------------------*
      *                   2013A-RED-CUO-CICL                           *
      *----------------------------------------------------------------*
       2013A-RED-CUO-CICL.

      *COL87-I
      *    IF DRB-UGCPLINI(1:1) EQUAL '1'
      *       MOVE DRB-UGCPLINI(2:3)    TO WS-MESES-P
      *       COMPUTE WS-MESES-P = WS-MESES-P / 30
      *    ELSE
      *       IF DRB-UGCPLINI(1:1) EQUAL '2'
      *          MOVE DRB-UGCPLINI(2:3)    TO WS-MESES-P
      *       ELSE
      *          IF DRB-UGCPLINI(1:1) EQUAL '3'
      *             MOVE DRB-UGCPLINI(2:3)    TO WS-MESES-P
      *             COMPUTE WS-MESES-P = WS-MESES-P * 12
      *          END-IF
      *    END-IF
           EVALUATE G07-OPCION
           WHEN '1'
             MOVE DRB-UGNPLPEN  TO WS-MESES-P
           WHEN '2'
             MOVE DRB-UGIQUOTA  TO WS-CUOTA-FLEX
             DIVIDE G07-CAPITAL BY WS-CUOTA-FLEX
                           GIVING WS-NUM-RES-FLE
             COMPUTE WS-MESES-P = DRB-UGNPLPEN - WS-NUM-RES-FLE
           END-EVALUATE
      *COL87-F

           IF MPF-PERCAP(1:1) EQUAL '1'
              MOVE MPF-PERCAP(2:3)    TO WS-MESES-C
              COMPUTE WS-MESES-C = WS-MESES-C / 30
           ELSE
              IF MPF-PERCAP(1:1) EQUAL '2'
                 MOVE MPF-PERCAP(2:3)    TO WS-MESES-C
              ELSE
                 IF MPF-PERCAP(1:1) EQUAL '3'
                    MOVE MPF-PERCAP(2:3)    TO WS-MESES-C
                    COMPUTE WS-MESES-C = WS-MESES-C * 12
                 END-IF
           END-IF

           IF WS-MESES-C > WS-MESES-P
              MOVE WS-MESES-C   TO WS-MESES-P
           END-IF

           COMPUTE WS-CUOTAS = WS-MESES-P / WS-MESES-C
           COMPUTE WS-CUOTA-CAP1 = WS-CAPITAL / WS-ENTERA
           MOVE WS-CUOTA-CAP1           TO G071-CUOTA1
           COMPUTE WS-CUOTA-CAP2 = WS-SALREAL-INICIAL / WS-ENTERA
           MOVE WS-CUOTA-CAP2           TO G071-CUOTA2.

      *----------------------------------------------------------------*
      *                   2013B-RED-CUO-ACIC                           *
      *----------------------------------------------------------------*
       2013B-RED-CUO-ACIC.
           MOVE MAE-SALTEOR          TO WS-SALTEOR-F
           MOVE G07-CAPITAL          TO WS-IMP-P-CAP
           COMPUTE WS-POR-APLI = WS-IMP-P-CAP / WS-SALTEOR-F
           PERFORM 2013B1-OPEN-CURCFX
           PERFORM 2013B2-FETCH-CURCFX UNTIL SI-FIN-CURCFX
           PERFORM 2013B3-CLOSE-CURCFX.

      *----------------------------------------------------------------*
      *                         2013B1-OPEN-CURCFX                    *
      *----------------------------------------------------------------*
       2013B1-OPEN-CURCFX.
              MOVE MAE-ENTIOFI           TO CFX-ENTIOFI
              MOVE MAE-CUENTA            TO CFX-CUENTA

              EXEC SQL
                   OPEN CURCFX
              END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR
               SQLWARN0 NOT = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE 'ERR OPEN CURCFX'       TO CAA-VAR1-ERROR
               MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
               MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
               PERFORM 3-FINAL-PROGRAMA
           ELSE
               SET NO-FIN-CURCFX   TO TRUE
               MOVE ZEROES                  TO WS-ACUM-CAP
           END-IF.
      *----------------------------------------------------------------*
      *                  2013B2-FETCH-CURCFX                           *
      *----------------------------------------------------------------*
       2013B2-FETCH-CURCFX.

              EXEC SQL
                FETCH CURCFX INTO
                      :CFX-PORC-CUO,
                      :CFX-IMPCAP-CUO,
                      :CFX-FELIQ
              END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR
               SQLWARN0 NOT = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE 'ERR FETCH CURCFX'      TO CAA-VAR1-ERROR
               MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
               MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
               PERFORM 3-FINAL-PROGRAMA
           ELSE
             IF DB2-OK
                IF CFX-IMPCAP-CUO > ZEROES
                   IF WS-CFX-CUOTA EQUAL ZEROES
                      MOVE CFX-IMPCAP-CUO TO WS-CFX-CUOTA
                   END-IF
                   COMPUTE WS-POR-CUO = CFX-PORC-CUO / 100
                   COMPUTE WS-POR-NUE = WS-POR-CUO - (WS-POR-CUO *
                   WS-POR-APLI)
                   COMPUTE WS-CAP-NUE = MAE-CAPSOLI * WS-POR-NUE
                   COMPUTE CFX-PORC-CUO = WS-POR-NUE * 100
                   MOVE WS-CAP-NUE               TO CFX-IMPCAP-CUO
                  IF G07-OPCION EQUAL '1'
                     PERFORM 2014-AJUSTA-CUOTA-CFX
                  ELSE
                     MOVE CFX-IMPCAP-CUO       TO G071-CUOTA1
                     MOVE CFX-IMPCAP-CUO       TO WS-CUOTA-CAP1
                     SET SI-FIN-CURCFX    TO TRUE
                  END-IF
                END-IF
             ELSE
               IF DB2-NOTFND
                  SET SI-FIN-CURCFX    TO TRUE
               END-IF
             END-IF
           END-IF.
      *----------------------------------------------------------------*
      *                  2013B3-CLOSE-CURCFX                           *
      *----------------------------------------------------------------*
       2013B3-CLOSE-CURCFX.

              EXEC SQL
                 CLOSE CURCFX
              END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR
               SQLWARN0 NOT = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE 'ERR CLOSE CURCFX'      TO CAA-VAR1-ERROR
               MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
               MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
               PERFORM 3-FINAL-PROGRAMA
           END-IF.

      *COL96-I
      *----------------------------------------------------------------*
      *                   2013C-BUSCA-PLAN-ESPECIAL                    *
      *----------------------------------------------------------------*
       2013C-BUSCA-PLAN-ESPECIAL.

           INITIALIZE UGTCT37
           MOVE '9086'                        TO T37-SECCION
           MOVE MAE-SUBPRO                    TO T37-ELEMENTO
           PERFORM 2122A-BUSCAR-UGDTT37

           IF  T37-RESTO(1:2) = 'CV' OR
              (T37-RESTO(1:2) = 'CF' AND MPF-PERCAP NOT EQUAL '2001')
               SET SI-CONSUMER TO TRUE
               PERFORM 2013D-BUSCA-ALARGUE
           END-IF
           IF SI-CONSUMER AND NO-ALARGUE
                 IF G07-OPCION EQUAL CTE-CON-2
                    MOVE 'OPCION NO VALIDA  '  TO CAA-VAR1-ERROR
                    MOVE 'REGISTRE RED. CUOTA' TO CAA-VAR2-ERROR
                    MOVE 'UGE0939'             TO CAA-COD-ERROR
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    IF G07-OPCION NOT = CTE-CON-0
                       MOVE 'U036'          TO WS-CODFUN
                       MOVE '5'             TO LUGAR
                       IF CAA-CODERR-AUT(LUGAR) NOT = 'UGE2142'
                          PERFORM VALIDA-FACULTADES
                       END-IF
                    END-IF
                 END-IF
           END-IF.
      *----------------------------------------------------------------*
      *                   2013D-BUSCA-ALARGUE                          *
      *----------------------------------------------------------------*
       2013D-BUSCA-ALARGUE.

           INITIALIZE UGTCMOD
           MOVE MAE-ENTIOFI                TO MOD-CLAVE(1:8)
           MOVE MAE-CUENTA                 TO MOD-CLAVE(9:10)
           MOVE 'U802'                     TO MOD-CODTRAN
           MOVE 'PLAZO'                    TO MOD-COLUMNA
           MOVE 'UG4CCFVN'                 TO MOD-USERID-UMO

           EXEC SQL
               SELECT VALOR_ANT INTO :MOD-VALOR-ANT
                      FROM UGDTMOD
               WHERE  CLAVE        = :MOD-CLAVE    AND
                      CODTRAN      = :MOD-CODTRAN  AND
                      COLUMNA      = :MOD-COLUMNA  AND
                      USERID_UMO   = :MOD-USERID-UMO
           END-EXEC

           MOVE SQLCODE                    TO DB2-RETURN-CDE
           IF DB2-OK
              SET SI-ALARGUE               TO TRUE
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'ERR SELECT UGDTMOD'    TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
                 MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
                PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      *COL96-F
      *----------------------------------------------------------------*
      *                  2014-AJUSTA-CUOTA-CFX                         *
      *----------------------------------------------------------------*
       2014-AJUSTA-CUOTA-CFX.

      *NOVA02K-I
           INITIALIZE             UGTCMOD

           MOVE WS-CFX-PORC-CUO-R         TO MOD-VALOR-ANT(1:4)
           MOVE WS-CFX-IMPCAP-CUO-R       TO MOD-VALOR-ANT(5:15)
           MOVE WS-CFX-FELIQ              TO MOD-VALOR-ANT(20:10)
           ADD 1                          TO WS-CONTA-CLAVE

           MOVE CFX-NETNAME-UMO           TO MOD-NETNAME-UMO
           MOVE CFX-USERID-UMO            TO MOD-USERID-UMO

           MOVE '-AJTCFX-'                TO MOD-CLAVE(19:8)
           MOVE WS-CONTA-CLAVE-R          TO MOD-CLAVE(27:2)
           MOVE 'CFX1'                    TO MOD-CLAVE(29:4)
           MOVE 'G270'                    TO MOD-CODTRAN
           MOVE 'UGDTCFX'                 TO MOD-TABLA

           PERFORM 2014AB-INSERT-UGDTMOD
      *NOVA02K-F
           MOVE CAA-NETNAME              TO CFX-NETNAME-UMO
           MOVE CAA-USERID               TO CFX-USERID-UMO

           EXEC SQL
              UPDATE UGDTCFX
                  SET CFX_PORC_CUO = :CFX-PORC-CUO,
                  CFX_IMPCAP_CUO  = :CFX-IMPCAP-CUO,
                  CFX_NETNAME_UMO = :CFX-NETNAME-UMO,
                  CFX_USERID_UMO = :CFX-USERID-UMO,
                  CFX_TIMESTAMP   = CURRENT TIMESTAMP
               WHERE CFX_ENTIOFI = :CFX-ENTIOFI
                 AND CFX_CUENTA  = :CFX-CUENTA
                 AND CFX_FELIQ   = :CFX-FELIQ
           END-EXEC
           MOVE SQLCODE                 TO DB2-RETURN-CDE
           IF NOT DB2-OK
              MOVE 'UGE0939'               TO CAA-COD-ERROR
              MOVE 'ERR UPDAT CURCFX'      TO CAA-VAR1-ERROR
              MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
              MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
              PERFORM 3-FINAL-PROGRAMA
           ELSE
              ADD CFX-IMPCAP-CUO           TO WS-ACUM-CAP
           END-IF.
      *----------------------------------------------------------------*
      *                   2013B-RED-PZO-ACIC                           *
      *----------------------------------------------------------------*
       2013B-RED-PZO-ACIC.
           MOVE G07-CAPITAL           TO WS-CAP-CFX
           PERFORM 2013B1-OPEN-CURCFX2
           PERFORM 2013B2-FETCH-CURCFX2 UNTIL SI-FIN-CURCFX
           PERFORM 2013B3-CLOSE-CURCFX2.

      *----------------------------------------------------------------*
      *                         2013B1-OPEN-CURCFX2                   *
      *----------------------------------------------------------------*
       2013B1-OPEN-CURCFX2.
              MOVE MAE-ENTIOFI           TO CFX-ENTIOFI
              MOVE MAE-CUENTA            TO CFX-CUENTA

              EXEC SQL
                   OPEN CURCFX2
              END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR
               SQLWARN0 NOT = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE 'ERR OPEN CURCFX2'      TO CAA-VAR1-ERROR
               MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
               MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
               PERFORM 3-FINAL-PROGRAMA
           ELSE
               MOVE 1              TO WS-FX
               MOVE ZEROES         TO WS-CONT-CFX
               SET NO-FIN-CURCFX   TO TRUE
               SET NO-FIN-FEC      TO TRUE
           END-IF.
      *----------------------------------------------------------------*
      *                  2013B2-FETCH-CURCFX2                          *
      *----------------------------------------------------------------*
       2013B2-FETCH-CURCFX2.

              EXEC SQL
                FETCH CURCFX2 INTO
                      :CFX-PORC-CUO,
                      :CFX-IMPCAP-CUO,
                      :CFX-FELIQ
              END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR
               SQLWARN0 NOT = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE 'ERR FETCH CURCFX2'     TO CAA-VAR1-ERROR
               MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
               MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
               PERFORM 3-FINAL-PROGRAMA
           ELSE
             IF DB2-OK
               IF NO-FIN-FEC
                IF CFX-IMPCAP-CUO > WS-CAP-CFX
                   COMPUTE CFX-IMPCAP-CUO = CFX-IMPCAP-CUO
                                           - WS-CAP-CFX
                   MOVE ZEROES                TO WS-CAP-CFX
                   MOVE 'N'                   TO CFX-IND-FACTURA
                ELSE
                   COMPUTE WS-CAP-CFX = WS-CAP-CFX
                                        - CFX-IMPCAP-CUO
                   MOVE ZEROES                TO CFX-IMPCAP-CUO
                   MOVE 'S'                   TO CFX-IND-FACTURA
                   ADD 1                      TO WS-CONT-CFX
                END-IF
                MOVE CFX-FELIQ               TO WS-VENCIN-CFX
      *         MOVE WS-VENCIN-CFX           TO G071-VENCI2
                MOVE WS-VENCIN-CFX(1:4) TO G071-VENCI2(7:4)
                MOVE WS-VENCIN-CFX(6:2) TO G071-VENCI2(4:2)
                MOVE WS-VENCIN-CFX(9:2) TO G071-VENCI2(1:2)
                MOVE '/'                TO G071-VENCI2(3:1)
                MOVE '/'                TO G071-VENCI2(6:1)
                IF G07-OPCION EQUAL '2'
                   PERFORM 2014-AJUSTA-CUOTA-CFX2
                ELSE
                   IF WS-CAP-CFX EQUAL ZEROES
                      IF CFX-IMPCAP-CUO EQUAL ZEROES
                         SET SI-FIN-FEC    TO TRUE
                      ELSE
                         SET SI-FIN-CURCFX TO TRUE
                      END-IF
                   END-IF
                END-IF
               ELSE
                   MOVE CFX-FELIQ               TO WS-VENCIN-CFX
      *            MOVE CFX-FELIQ               TO G071-VENCI2
                   MOVE CFX-FELIQ(1:4) TO G071-VENCI2(7:4)
                   MOVE CFX-FELIQ(6:2) TO G071-VENCI2(4:2)
                   MOVE CFX-FELIQ(9:2) TO G071-VENCI2(1:2)
                   MOVE '/'            TO G071-VENCI2(3:1)
                   MOVE '/'            TO G071-VENCI2(6:1)
                   SET SI-FIN-CURCFX    TO TRUE
               END-IF
             ELSE
               IF DB2-NOTFND
                  SET SI-FIN-CURCFX    TO TRUE
               END-IF
             END-IF
           END-IF.
      *----------------------------------------------------------------*
      *                  2013B3-CLOSE-CURCFX2                          *
      *----------------------------------------------------------------*
       2013B3-CLOSE-CURCFX2.

              EXEC SQL
                 CLOSE CURCFX2
              END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR
               SQLWARN0 NOT = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE 'ERR CLOSE CURCFX2'     TO CAA-VAR1-ERROR
               MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
               MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
               PERFORM 3-FINAL-PROGRAMA
           ELSE
               IF G07-OPCION EQUAL '2' AND WS-FX > ZEROES
                  MOVE 1               TO WS-CFX
                  PERFORM 2014-AJUSTA-CUOTA-CFX2-U UNTIL
                          WS-CFX = WS-FX
               END-IF
           END-IF.

      *----------------------------------------------------------------*
      *                  2013B4-VALIDA-NUMLIQ                          *
      *----------------------------------------------------------------*
       2013B4-VALIDA-NUMLIQ.

           MOVE MAE-ENTIOFI           TO CFX-ENTIOFI
           MOVE MAE-CUENTA            TO CFX-CUENTA

              EXEC SQL
                  SELECT  COUNT(*)
                    INTO :WS-DB2-CONTADOR
                    FROM UGDTCFX
      *COL115-I
      *            WHERE CFX_ENTIOFI = :CFX-ENTIOFI
      *              AND CFX_CUENTA  = :CFX-CUENTA
                   WHERE CFX_CUENTA  = :CFX-CUENTA
                     AND CFX_ENTIOFI = :CFX-ENTIOFI
      *COL115-F
                     AND CFX_IND_FACTURA <> 'S'
              END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF DB2-OK
              MOVE WS-DB2-CONTADOR TO WS-IND-10
              IF WS-DB2-CONTADOR < 2
                 IF G07-OPCION EQUAL '0'
                  MOVE CTE-CON-MENSAJE-5    TO G071-TEXT2
                  MOVE '1'                  TO G071-COND2
                  MOVE SPACES               TO G071-CONDT2
                 ELSE
                  MOVE 'UGE1153'      TO CAA-COD-ERROR
                  PERFORM  3-FINAL-PROGRAMA
                 END-IF
              END-IF
           ELSE
              MOVE 'UGE0939'               TO CAA-COD-ERROR
              MOVE 'ERR COUNT CFX'         TO CAA-VAR1-ERROR
              MOVE 'SQLCODE:'              TO CAA-VAR2-ERROR(1:8)
              MOVE SQLCODE                 TO CAA-VAR2-ERROR(10:)
              PERFORM 3-FINAL-PROGRAMA
           END-IF.

      *----------------------------------------------------------------*
      *                  2014-AJUSTA-CUOTA-CFX2                        *
      *----------------------------------------------------------------*
       2014-AJUSTA-CUOTA-CFX2.

           MOVE UGTCCFX                  TO WS-UGTCCFX(WS-FX)
           ADD 1                         TO WS-FX
           IF WS-CAP-CFX EQUAL ZEROES
              IF CFX-IMPCAP-CUO EQUAL ZEROES
                 SET SI-FIN-FEC    TO TRUE
              ELSE
                 SET SI-FIN-CURCFX TO TRUE
              END-IF
           END-IF.
      *----------------------------------------------------------------*
      *                  2014-AJUSTA-CUOTA-CFX2-U                      *
      *----------------------------------------------------------------*
       2014-AJUSTA-CUOTA-CFX2-U.

      *NOVA02K-I
