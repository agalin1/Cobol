      ******************************************************************
      *             22531-CALC-TOT-INTANT                              *
      *----------------------------------------------------------------*
      *    SE CALCULAN LAS COMISIONES Y GASTOS PARA LLEGAR AL IMPORTE  *
      *    NETO QUE SE APLICA PARA AMORTIZAR, ASI COMO EL IMPORTE DE   *
      *    SUBVENCION, SI PROCEDE. CUANDO EL PRESTAMO ES CON INTERESES *
      *    ANTICIPADOS                                                 *
      *                                                                *
      ******************************************************************
       22531-CALC-TOT-INTANT.
      *
           MOVE WS-IN-EN                      TO WS-MES-INTERESE-ANTI
           MOVE G07-CAPITAL                   TO WS-MES-IMPORTE
      *
           IF MAE-MONEDA NOT = 'COP'
              COMPUTE G071-INTERES     ROUNDED =
                      WS-MES-INTERESE-ANTI * WS-CAMBIO * (-1)
              END-COMPUTE
              MOVE G071-INTERES               TO G072-INTERES
              COMPUTE G071-CAPITAL     ROUNDED =
                      WS-MES-IMPORTE   * WS-CAMBIO
              END-COMPUTE
              MOVE G071-CAPITAL               TO G072-CAPITAL
           ELSE
              COMPUTE G071-INTERES     ROUNDED =
                      WS-MES-INTERESE-ANTI * (-1)
              END-COMPUTE
              MOVE G071-INTERES               TO G072-INTERES
              MOVE WS-MES-IMPORTE             TO G071-CAPITAL
                                                 G072-CAPITAL
           END-IF.
      *@COL15-I
           IF WS-BANDGRA = 1
              MOVE 0                       TO G071-INTERES
                                              G072-INTERES
           END-IF
      *@COL15-F
      *
      ******************************************************************
      *    CUANDO SON INTERESES ANTICIPADOS LO QUE LE DEBERIAMOS       *
      *    COBRAR DE INTERESES EL YA LOS HA PAGADO Y DEBEMOS DEVOLVER- *
      *    SELOS                                                       *
      ******************************************************************
           COMPUTE WS-MES-IMPORTE     ROUNDED =
      *            G07-CAPITAL + WS-MES-INTERESE-ANTI
                   G07-CAPITAL
                     ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
           END-COMPUTE
      *
           MOVE  ZERO                         TO WS-IN-EN
           MOVE  ZERO                         TO WS-MES-INTERESE.
      *
           PERFORM  2252-CALC-COMISION-GASTOS
      *
           COMPUTE  WS-AUX ROUNDED =
                    ( WS-MES-IMPORTE    + WS-MES-INTERESE ) +
                    ( WS-MES-COMISION   + WS-MES-GASTOS   )
                  - ( WS-MES-INTERESE-ANTI )
      *VER20030613-I-COMISIONES-CAVE
                    + WS-MES-IVA
      *VER20030613-F-COMISIONES-CAVE
               ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
           END-COMPUTE.
      *COL50-I
      *COL63-I
      *       IF MAE-UGYEMCED = 'S' AND WS-ABO-DIFERIDO > 0
              IF MAE-IND-MARCA4 = 'N' AND WS-ABO-DIFERIDO > 0
      *COL63-F
                COMPUTE  WS-AUX ROUNDED = WS-AUX + WS-ABO-DIFERIDO
             END-IF
      *COL50-F
      *@COL32-I
           IF G07-OPCION = '5'
              COMPUTE  WS-AUX ROUNDED =
                       ( WS-MES-IMPORTE + WS-MES-COMISION ) +
                       ( WS-MES-GASTOS  + WS-MES-IVA )
                  ON SIZE ERROR  PERFORM 22221-REBOSAMIENTO
              END-COMPUTE
              MOVE 0                       TO G071-INTERES
              MOVE 0                       TO G072-INTERES
           END-IF
      *@COL32-F
      *
           IF MAE-MONEDA NOT = 'COP'
              COMPUTE G071-TOTAL  ROUNDED =
                         WS-AUX        * WS-CAMBIO
              END-COMPUTE
              MOVE   G071-TOTAL               TO G072-TOTAL
              MOVE   WS-AUX                   TO WS-MES-TOTAL
      *COL98-I
              SUBTRACT WS-VAL-INT-ALIV      FROM WS-MES-TOTAL
      *COL98-F
           ELSE
              COMPUTE G071-TOTAL  ROUNDED =
                      WS-AUX
              END-COMPUTE
              MOVE   G071-TOTAL               TO G072-TOTAL
              MOVE  WS-AUX                    TO WS-MES-TOTAL
           END-IF.
      *
      ******************************************************************
      *****  SE VALIDARA QUE LOS VALORES CALCULADOS SEAN IGUALES A *****
      *****  LOS VALORES INTRODUCIDOS POR EL USUARIO SI LA OPCION  *****
      *****  INDICADA NO ES SIMULACION (OPCION = 0)                *****
      ******************************************************************
           EVALUATE G07-OPCION
              WHEN 0
                CONTINUE
              WHEN OTHER
      *COL98-I
              SUBTRACT WS-VAL-INT-ALIV      FROM WS-MES-TOTAL
      *COL98-F
                 IF G07-IMPORTE NOT = WS-MES-TOTAL
                    MOVE 'UGE2058'            TO CAA-COD-ERROR
                    MOVE G071-TOTAL           TO CAA-VAR1-ERROR
                    MOVE 'UGA0115'            TO CAA-COD-AVISO1
                    MOVE 'TOTAL'              TO CAA-VAR1-AVISO1
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
           END-EVALUATE.
      *
           EJECT
      *
      ******************************************************************
