      ******************************************************************
       24-VALIDAR-CAMBIO-DIA-FACT.

              INITIALIZE UGTCMOV
              MOVE MAE-ENTIOFI                 TO MOV-ENTIOFI
              MOVE MAE-CUENTA                  TO MOV-CUENTA

              EXEC SQL
                   SELECT NUMCHEQ
                   INTO  :MOV-NUMCHEQ
                   FROM UGDTMOV
                   WHERE CUENTA   = :MOV-CUENTA   AND
                         ENTIOFI  = :MOV-ENTIOFI  AND
                         USERID_UMO = 'UG2CG717'  AND
                         CLACON     = 'AI'        AND
                         FEOPER   > :MAE-FEULIQ   AND
                         FEOPER   < :MAE-FEPROLIQ
                         ORDER BY FEOPER DESC
                         FETCH FIRST ROW ONLY
              END-EXEC

              MOVE SQLCODE                         TO DB2-RETURN-CDE
              IF DB2-OK
                 MOVE MOV-NUMCHEQ(1:4)           TO WS-FEC-CAB-AAAA
                 MOVE MOV-NUMCHEQ(5:2)           TO WS-FEC-CAB-MM
                 MOVE MOV-NUMCHEQ(7:2)           TO WS-FEC-CAB-DD
              ELSE
                 IF DB2-NOTFND  OR DB2-NULL-VALUE
                    MOVE '0001-01-01'             TO WS-FECHA-CAMBIO-LIQ
                 ELSE
                    MOVE 'UGE0939'            TO CAA-COD-ERROR
                    MOVE 'ERROR TABLA'        TO CAA-VAR1-ERROR
                    MOVE 'UGDTMOV3'           TO CAA-VAR2-ERROR
                    MOVE SQLCODE              TO CAA-VAR2-ERROR(10:)
                    PERFORM 3-FINAL-PROGRAMA
