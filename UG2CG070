              COMPUTE WS-IMPORTE-FINAL = WS-CUOTAFINAL - CTN-1
           IF G07-IMPORTE > WS-IMPORTE-FINAL
      *COL81-F
              IF G07-OPCION = '4'
                 MOVE 'UGE2058'            TO CAA-COD-ERROR
      *COL81-I
      *           MOVE WS-CUOTAFINAL-INT    TO WS-CUOTAFINAL-AUX
                 MOVE WS-IMPORTE-FINAL     TO WS-CUOTAFINAL-AUX
      *COL81-F
                 MOVE WS-CUOTAFINAL-AUX    TO CAA-VAR1-ERROR
                 MOVE 'UGA0115'            TO CAA-COD-AVISO1
                 MOVE 'CUOTA FINAL'        TO CAA-VAR1-AVISO1
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                SET SW-CUOTAFIN-NOK        TO TRUE
              END-IF
           ELSE
              IF WS-ERROR-CAPABO = 'S'
                 MOVE 'UGE2058'               TO CAA-COD-ERROR
                 MOVE DS-INTERES-CUOTA        TO CAA-VAR1-ERROR
                 MOVE 'UGA0115'               TO CAA-COD-AVISO1
                 MOVE 'CAPITAL ABONADO'       TO CAA-VAR1-AVISO1
                 PERFORM 3-FINAL-PROGRAMA
