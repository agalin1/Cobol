      ******************************************************************
      *                 24501-BUSCAR-ANTICIPOS
      * BUSCA EL TOTAL DE ANTICIPOS PARA LEASING HABITACIONAL SP       *
      ******************************************************************
       224501-BUSCAR-ANTICIPOS.

           INITIALIZE UGTCANT
           MOVE MAE-ENTIOFI                   TO ANT-ENTIOFI
           MOVE MAE-CUENTA                    TO ANT-CUENTA
           MOVE 'F'                           TO ANT-ESTADO-ANT
           MOVE MAE-FEULIQ                    TO WS-FECH-ULIQ
           MOVE MAE-FEPROLIQ                  TO WS-FECH-PLIQ

           EXEC SQL
              SELECT SUM(ANT_VALOR_ANT)
                INTO :ANT-VALOR-ANT
              FROM UGDTANT
              WHERE ANT_ENTIOFI = :ANT-ENTIOFI
                AND ANT_CUENTA  = :ANT-CUENTA
                AND ANT_ESTADO_ANT = :ANT-ESTADO-ANT
                AND ANT_FECHA_PAGO >= :WS-FECH-ULIQ
                AND ANT_FECHA_PAGO <= :WS-FECH-PLIQ
           END-EXEC

           EVALUATE SQLCODE
              WHEN ZEROS
                 CONTINUE
              WHEN +100
              WHEN -305
                 MOVE ZEROS         TO ANT-VALOR-ANT
              WHEN OTHER
                 MOVE 'UGE0939'            TO CAA-COD-ERROR
                 MOVE 'ERR TABLA UGDTANT'  TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE'            TO CAA-VAR2-ERROR(1:8)
                 MOVE SQLCODE              TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
