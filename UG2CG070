      ******************************************************************
       453-REGISTRO-UGDTMVC.
           MOVE MAE-ENTIOFI      TO MVC-ENTIOFI
           MOVE MAE-CUENTA       TO MVC-CUENTA

           EXEC SQL
      *COL115-I
      *       SELECT MAX(CONS_MOV)
              SELECT CONS_MOV
      *COL115-F
                INTO :MVC-CONSMOV
              FROM UGDTMVC
      *COL115-I
              WHERE CUENTA  = :MVC-CUENTA
                AND ENTIOFI = :MVC-ENTIOFI
               ORDER BY CONS_MOV DESC
               FETCH FIRST 1 ROW ONLY
      *       WHERE ENTIOFI = :MVC-ENTIOFI
      *         AND CUENTA  = :MVC-CUENTA
      *COL115-F
           END-EXEC

           MOVE SQLCODE  TO DB2-RETURN-CDE

           EVALUATE TRUE
              WHEN DB2-OK
                 MOVE MVC-CONSMOV      TO WS-CONSMOV
                 COMPUTE MVC-CONSMOV = MVC-CONSMOV + 1
              WHEN DB2-NULL-VALUE
              WHEN DB2-NOTFND
                 MOVE 1 TO MVC-CONSMOV
              WHEN OTHER
      *COL31I
      *          MOVE 'UGDTMVC'             TO CAA-VAR1-ERROR
      *          MOVE 'SELECT UGDTMVC'      TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTMVC' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
           END-EVALUATE


           MOVE '02'              TO MVC-TIPOMOV
           MOVE CAA-FECHA-OPER2   TO MVC-FECHMOV

           COMPUTE MVC-CAPCONTANT =
                                WRK-SALDO-REAL-ANT + WRK-SALDO-PERS-ANT
           COMPUTE MVC-CAPCONTACT =
                                REV-SAL-CIER + REV-IMP10
           COMPUTE MVC-CAPCONTNOV =
                                MVC-CAPCONTANT - MVC-CAPCONTACT

           MOVE CAA-FECHA-OPER2    TO MVC-FECHAOPER
           MOVE CAA-FECHA-CONT2    TO MVC-FECHACONT
           MOVE CAA-FECHA-CONT2    TO MVC-FECHAUVR
      *@COL84-i
           IF SI-PAGO-SW
              MOVE WS-DB2-FEVALOR  TO MVC-FECHAUVR
                                      MVC-FECHACONT
                                      MVC-FECHMOV
                                      MVC-FECHAOPER
           END-IF
      *@COL84-f
           MOVE WRK-SALDO-REAL     TO MVC-UVRVALOR1
           MOVE WRK-SALDO-PERSONAL TO MVC-UVRVALOR2
           MOVE SPACES             TO MVC-INDUVRCAR1
           MOVE SPACES             TO MVC-INDUVRCAR2
           MOVE 'UG2CG070:ENTREGA ANTICIPADA'
                                   TO MVC-DETALLE
           MOVE CAA-ENTIDAD        TO MVC-ENTIDADUMO
           MOVE CAA-CENTRO-CONT    TO MVC-CENTROUMO
           MOVE CAA-USERID         TO MVC-USERIDUMO
           MOVE CAA-NETNAME-CONT   TO MVC-NETNAMEUMO

           EXEC SQL  SET :MVC-FECHMOV   = CURRENT DATE      END-EXEC
           EXEC SQL  SET :MVC-TIMESTAMP = CURRENT TIMESTAMP END-EXEC


           EXEC SQL
              INSERT INTO UGDTMVC
                 VALUES (  :MVC-ENTIOFI
                         , :MVC-CUENTA
                         , CURRENT DATE
                         , :MVC-CONSMOV
                         , :MVC-TIPOMOV
                         , :MVC-CAPCONTANT
                         , :MVC-CAPCONTACT
                         , :MVC-CAPCONTNOV
                         , :MVC-FECHAOPER
                         , :MVC-FECHACONT
                         , :MVC-FECHAUVR
                         , :MVC-UVRVALOR1
                         , :MVC-UVRVALOR2
                         , :MVC-INDUVRCAR1
                         , :MVC-INDUVRCAR2
                         , :MVC-DETALLE
                         , :MVC-ENTIDADUMO
                         , :MVC-CENTROUMO
                         , :MVC-USERIDUMO
                         , :MVC-NETNAMEUMO
                         , :MVC-TIMESTAMP
                        )
           END-EXEC

