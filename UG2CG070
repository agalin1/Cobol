           EJECT.
      *
      ******************************************************************
      *              2431-BUSCAR-ANT-IFA                               *
      *----------------------------------------------------------------*
      *    INSERTA EL REGISTRO CORRESPONDIENTE EN LA TABLA DE INCIDEN- *
      *    CIAS DE FACTURACION                                         *
      *                                                                *
      ******************************************************************
       2431-BUSCAR-ANT-IFA.
      *
           MOVE IFA-UGFVALOR                  TO WS-FECHA-AUXIFA
           IF SW-NO-HAY-GRACIA
              MOVE MAE-FEULIQ                 TO IFA-UGFVALOR
           ELSE
              MOVE MAE-FEFORMA                TO IFA-UGFVALOR
           END-IF
           IF WS-INDINANT = 'A'
              EXEC SQL
                   SELECT
                          UGFVALOR,
                          UGNROINC,
                          UGIMPORT,
                          UGINTAMO,
                          UGNREBSU,
                          LLIURE_IND3,
                          TIMESTAMP
                     INTO
                          :WS-UGFVALOR-ANT,
                          :WS-UGNROINC-ANT,
                          :WS-UGIMPORT-ANT,
                          :WS-UGINTAMO-ANT,
                          :WS-UGNREBSU-ANT,
                          :WS-LLIURE-IND3-ANT,
                          :WS-TIMESTAMP-ANT
                     FROM UGDTIFA
                    WHERE ENTIOFI  =  :MAE-ENTIOFI  AND
                          CUENTA   =  :MAE-CUENTA   AND
                          UGCAMORT IN ('X', 'B')    AND
                          UGYINDIF =  '0'           AND
      *                   UGFVALOR >  :MAE-FEULIQ   AND
                      UGFVALOR >  :IFA-UGFVALOR  AND
                          UGFVALOR <= :MAE-FEPROLIQ AND
                          UGTINCID =  'D'
              END-EXEC
           ELSE
              EXEC SQL
                   SELECT
                          UGFVALOR,
                          UGNROINC,
                          UGIMPORT,
                          UGINTAMO,
                          UGNREBSU,
                          LLIURE_IND3,
                          TIMESTAMP
                     INTO
                          :WS-UGFVALOR-ANT,
                          :WS-UGNROINC-ANT,
                          :WS-UGIMPORT-ANT,
                          :WS-UGINTAMO-ANT,
                          :WS-UGNREBSU-ANT,
                          :WS-LLIURE-IND3-ANT,
                          :WS-TIMESTAMP-ANT
                     FROM UGDTIFA
                    WHERE ENTIOFI  =  :MAE-ENTIOFI  AND
                          CUENTA   =  :MAE-CUENTA   AND
                          UGCAMORT IN ('X', 'B')    AND
                          UGYINDIF =  '0'           AND
      *                   UGFVALOR >= :MAE-FEULIQ   AND
                     UGFVALOR >= :IFA-UGFVALOR  AND
                          UGFVALOR <= :MAE-FEPROLIQ AND
                          UGTINCID =  'D'
              END-EXEC
           END-IF.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           MOVE WS-FECHA-AUXIFA               TO IFA-UGFVALOR
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              PERFORM 24311-MARCAR-ANT-IFA
              PERFORM 24312-INSERTAR-NUE-IFA
              PERFORM 24313-INSERTAR-TOT-IFA
              PERFORM 24314-ACTUALIZAR-DRB
           ELSE
              IF DB2-NOTFND  AND SQLWARN0 = SPACES
      *COL81-I
                 IF SW-CUOTA-FINAL-SI
                    MOVE '1'           TO IFA-UGYINDIF
                 END-IF
      *COL81-F
                 PERFORM 2432-INSERTAR-IFA
              ELSE
      *COL31I
      *          MOVE 'UGDTIFA'               TO CAA-VAR1-ERROR
      *          MOVE 'IFAS REDUCCION PLAZO'  TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'SELECT UGDTIFA' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
              END-IF
           END-IF.
      *
           EJECT.
      *
      ******************************************************************
      *              24311-MARCAR-ANT-IFA                              *
      *----------------------------------------------------------------*
      *    MARCA COMO PROCESADA LA IFA QUE SE ENCONTRO ANTERIORMENTE   *
      *                                                                *
      ******************************************************************
       24311-MARCAR-ANT-IFA.
      *
           MOVE WS-TIMESTAMP-ANT              TO IFA-TIMESTAMP
      *
           EXEC SQL
             UPDATE  UGDTIFA
                SET
                    UGYINDIF    =  '1',
                    NETNAME_UMO = :IFA-NETNAME-UMO,
                    USERID_UMO  = :IFA-USERID-UMO,
                    ENTITAT_UMO = :IFA-ENTITAT-UMO,
                    CENTRE_UMO  = :IFA-CENTRE-UMO,
                    TIMESTAMP   =  CURRENT TIMESTAMP
              WHERE
                    ENTIOFI   = :IFA-ENTIOFI       AND
                    CUENTA    = :IFA-CUENTA        AND
                    TIMESTAMP = :IFA-TIMESTAMP
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK    AND SQLWARN0  =  SPACES)
              IF (DB2-NOTFND AND SQLWARN0  =  SPACES)
                 MOVE CTE-CON-UGB0004         TO CAA-COD-ERROR
                 MOVE 'UGDTIFA'               TO CAA-VAR1-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
      *COL31I
      *          MOVE 'UGDTIFA'               TO CAA-VAR1-ERROR
      *          MOVE 'UPDATE UGDTIFA ANTER'  TO CAA-VAR2-ERROR
      *          PERFORM 999999-ABEND-DB2
                 MOVE 'UGE0939'        TO CAA-COD-ERROR
                 MOVE 'UPDATE UGDTIFA' TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '       TO CAA-VAR2-ERROR(1:8)
                 MOVE DB2-RETURN-CDE   TO CAA-VAR2-ERROR(9:)
                 PERFORM 3-FINAL-PROGRAMA
      *COL31F
              END-IF
           END-IF.
