      ******************************************************************
      *                23AA-INSERT-MOD                                 *
      *----------------------------------------------------------------*
      *    REALIZAR EL INSERT EN LA TABLA TMOD.                        *
      *                                                                *
      ******************************************************************
       23AA-INSERT-MOD.
      *
           EXEC SQL INSERT INTO UGDTMOD
               ( CODTRAN,  TABLA,  CLAVE,
                 TIMESTAMP,  COLUMNA,
                 VALOR_ANT,  VALOR_ACT,  COMENTARIO,
                 ENTIDAD_UMO,
                 CENTRO_UMO,  USERID_UMO,  NETNAME_UMO,
                 MONEDA)
              VALUES
               (:MOD-CODTRAN,
                :MOD-TABLA,
                :MOD-CLAVE,
                 CURRENT TIMESTAMP,
                :MOD-COLUMNA,
                :MOD-VALOR-ANT,
                :MOD-VALOR-ACT,
                :MOD-COMENTARIO,
                :MOD-ENTIDAD-UMO,
                :MOD-CENTRO-UMO,
                :MOD-USERID-UMO,
                :MOD-NETNAME-UMO,
                :MOD-MONEDA)
           END-EXEC.
