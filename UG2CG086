                                          CORR-ANU

           COMPUTE PDI-AMORT-I-DIF      = PDI-AMORT-I-DIF      -
                                          INT-ANU

           COMPUTE PDI-AMORT-K-DIF-CAST = PDI-AMORT-K-DIF-CAST -
                                          CAP-CAS-ANU

           COMPUTE PDI-AMORT-I-DIF-CAST = PDI-AMORT-I-DIF-CAST -
                                          INT-CAS-ANU

           COMPUTE PDI-SDO-FIN-CM-DIF   = PDI-SDO-ANT-CM-DIF    -
                                          PDI-AMORT-CM-DIF     +
                                          PDI-ALTA-CM-DIF

           COMPUTE PDI-SDO-FIN-I-DIF    = PDI-SDO-ANT-I-DIF   -
                                          PDI-AMORT-I-DIF      +
                                          PDI-ALTA-INT-DIF

           COMPUTE PDI-SDO-FIN-K-DIF-CAST = PDI-SDO-ANT-K-DIF-CAST -
                                            PDI-AMORT-K-DIF-CAST   +
                                            PDI-ALTA-K-DIF-CAST

           COMPUTE PDI-SDO-FIN-I-DIF-CAST = PDI-SDO-ANT-I-DIF-CAST -
                                            PDI-AMORT-I-DIF-CAST   +
                                            PDI-ALTA-I-DIF-CAST

           EXEC SQL

               UPDATE UGDTPDI

               SET AMORT_CM_DIF       =: PDI-AMORT-CM-DIF,
                   AMORT_I_DIF        =: PDI-AMORT-I-DIF,
                   AMORT_K_DIF_CAST   =: PDI-AMORT-K-DIF-CAST,
                   AMORT_I_DIF_CAST   =: PDI-AMORT-I-DIF-CAST,
                   SDO_FIN_CM_DIF     =: PDI-SDO-FIN-CM-DIF,
                   SDO_FIN_I_DIF      =: PDI-SDO-FIN-I-DIF,
                   SDO_FIN_K_DIF_CAST =: PDI-SDO-FIN-K-DIF-CAST,
                   SDO_FIN_I_DIF_CAST =: PDI-SDO-FIN-I-DIF-CAST,
