      ******************************************************************
       23263-FETCH-MOD-RESTABLECE.
      *
           EXEC SQL
             FETCH CURS-MOD
               INTO
                 :MOD-COLUMNA,
                 :MOD-TIMESTAMP,
                 :MOD-VALOR-ANT
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE.

           IF DB2-OK AND SQLWARN0 = SPACES
               EVALUATE WS-OPER
                   WHEN '1'
                        PERFORM UPDATE-UGDTCFX
                   WHEN '2'
                        PERFORM UPDATE-UGDTCFX2
                   WHEN '3'
                        PERFORM UPDATE-UGDTMPF
               END-EVALUATE

           ELSE
               IF NOT  (DB2-NOTFND         AND
                        SQLWARN0 = SPACES)
                   MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
               SET SW-DATOS-NO   TO TRUE
               IF WS-OPER = '1'
                  SET SI-FIN-CLAVE  TO TRUE
               ELSE
                  IF WS-OPER='2'
                     SET SI-FIN-CLAVE2 TO TRUE
                  END-IF
               END-IF
           END-IF.
