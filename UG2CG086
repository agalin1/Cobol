      ******************************************************************
      *              312-ACTUALIZAR-IND-CONTI                          *
      *    ACTUALIZAR LA TABLA DE MODIFICACIONES CON LOS DATOS DE      *
      *    LA TABLA UGDTREV ANTES DE SU ACTUALIZACION Y DESPUES        *
      ******************************************************************
       312-ACTUALIZAR-IND-CONTI.

           MOVE CAA-CODTRAN                  TO MOD-CODTRAN
           MOVE 'CONTING'                    TO MOD-TABLA
           MOVE WS-CLAVE                     TO MOD-CLAVE
           MOVE 'UGDTREV'                    TO MOD-COLUMNA
           MOVE WS-CAP-CONT                  TO MOD-VALOR-ANT-NUM
           MOVE 'VALOR CAPITAL CONTIN'       TO MOD-COMENTARIO
           MOVE REV-CAP-CONT                 TO MOD-VALOR-ACT-NUM
           MOVE WC-PROGRAMA                  TO MOD-NETNAME-UMO
           MOVE C86A-USUARIO                 TO MOD-USERID-UMO
           MOVE C86A-ENTIDAD-CONT            TO MOD-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT             TO MOD-CENTRO-UMO
           MOVE MAE-MONEDA                   TO MOD-MONEDA

           EXEC SQL
              INSERT INTO UGDTMOD
                ( CODTRAN,
                  TABLA,
                  CLAVE,
                  TIMESTAMP,
                  COLUMNA,
                  VALOR_ANT,
                  VALOR_ACT,
                  COMENTARIO,
                  ENTIDAD_UMO,
                  CENTRO_UMO,
                  USERID_UMO,
                  NETNAME_UMO,
                  MONEDA)
              VALUES
                (:MOD-CODTRAN,
                 :MOD-TABLA,
                 :MOD-CLAVE,
                  CURRENT TIMESTAMP,
                 :MOD-COLUMNA,
                 :MOD-VALOR-ANT,
                 :MOD-VALOR-ACT,
                 :MOD-COMENTARIO,
                 :MOD-ENTIDAD-UMO,
                 :MOD-CENTRO-UMO,
                 :MOD-USERID-UMO,
                 :MOD-NETNAME-UMO,
                 :MOD-MONEDA)
           END-EXEC

           MOVE SQLCODE                      TO DB2-RETURN-CDE

           IF NOT DB2-OK
               MOVE 'UGDTMOD'                TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *                 50-CONTABILIZACION                             *
      *               INICIO DEL PROCESO DE CONTABILIZACION            *
      ******************************************************************
       50-CONTABILIZACION.

           PERFORM  502-FORMATEAR-DATOS-QH
      *
      * CAPITAL PAGADO
           PERFORM  506-CONTAB-CAPITAL-CONTING
           PERFORM  507-CONTAB-CAPITAL-REPERS

      * CIERRA APUNTE CAPITAL PAGADO
           IF CLS-WS-REALPROP >= 0 OR CLS-WS-REALRETO >= 0 OR
              CLS-WS-PERSPROP >= 0 OR CLS-WS-PERSRETO >= 0 OR
              WRK-SALDO-REAL > 0  OR  WRK-SALDO-PERSONAL > 0

                COMPUTE WS-IMPORTE-TELE =
                                 CLS-WS-REALPROP    + CLS-WS-REALRETO +
                                 CLS-WS-PERSPROP    + CLS-WS-PERSRETO

                IF WRK-SALDO-PERSONAL > 0
                   ADD WRK-SALDO-PERSONAL      TO WS-IMPORTE-TELE
                END-IF

                IF WRK-SALDO-REAL > 0
                   ADD WRK-SALDO-REAL          TO WS-IMPORTE-TELE
                END-IF

                PERFORM  508-CIERRE-APUNTE-TELE

           END-IF

      * INTERESES CORRIENTES
           PERFORM  509-CONTAB-INTERES-CTE

      * CIERRA APUNTE INTERES CORRIENTE
           COMPUTE WS-IMPORTE-TELE = ACUM-WS-CTATELE + CLS-WS-INT-CTES

           IF WS-INDINANT = 'A' OR WS-INDINANT = 'P'
              MOVE 0                     TO WS-IMPORTE-TELE
           END-IF

           PERFORM  508-CIERRE-APUNTE-TELE
      *
      * PASIVO DIFERIDO
           PERFORM  510-CONTAB-PASIVO-DIFER

      * CIERRE DE OPERACION
              PERFORM 504-CIERRE-OPERACION.

      ******************************************************************
      *             502-FORMATEAR-DATOS-QH                             *
      ******************************************************************
       502-FORMATEAR-DATOS-QH.
      *
           INITIALIZE UGWCUTR
           MOVE CTE-PRODUCTO                  TO UTR-PRODUCTO
      *
           PERFORM 502A-VALIDAR-TIPOCAR
      *
           MOVE MAE-SUBSUJET                  TO UTR-CORASU
