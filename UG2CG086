      *
      ***** INCLUSION DE VARIABLES PARA PODER REALIZAR LA ANULACION*****
      ***** DE LA TRANSACCION EN LA RUTINA UR7CCLS0                *****
              MOVE CLS-WS-INT-CTES            TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2
              PERFORM  2641-INSERT-TBL-MVTOS-PT
              MOVE 0                          TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2
           END-IF
      *
      * MOVIMIENTO PARA INTERESES ANTICIPADOS                      *****
           IF WS-MES-INTERESE-ANTI > ZERO
              MOVE  WS-INT-ANT-CLACON         TO MOV-CLACON
              COMPUTE MOV-IMPMOVI  =
                      WS-MES-INTERESE-ANTI * (-1)
              END-COMPUTE
              MOVE CLS-WS-INT-ANT-CLTE        TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2
              PERFORM  2641-INSERT-TBL-MVTOS-PT
              MOVE 0                          TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2
           END-IF
      * MOVIMIENTO PARA COMISIONES
           IF WS-MES-COMISION > ZERO
              AND C86A-USUARIO NOT = CTE-PRG-RECLAM-SEG

                MOVE CTE-CON-ENTR-ANT-COM       TO MOV-CLACON
                MOVE WS-MES-COMISION            TO MOV-IMPMOVI
                MOVE CCP-TASA-COMISION          TO MOV-LIBRE-IMP1
                MOVE ZEROS                      TO MOV-LIBRE-IMP2
                PERFORM  2641-INSERT-TBL-MVTOS-PT

           END-IF
      * MOVIMIENTO PARA IVA
           IF WS-MES-IVA > ZERO
              AND C86A-USUARIO NOT = CTE-PRG-RECLAM-SEG

                MOVE 'DA'                       TO MOV-CLACON
                MOVE CCP-TASA-IVA               TO MOV-LIBRE-IMP1
                MOVE CCP-VALOR-IVA              TO MOV-IMPMOVI
                MOVE ZEROS                      TO MOV-LIBRE-IMP2
                PERFORM  2641-INSERT-TBL-MVTOS-PT

           END-IF
      * MOVIMIENTO PARA GASTOS
           IF WS-MES-GASTOS > ZERO
              AND C86A-USUARIO NOT = CTE-PRG-RECLAM-SEG

                MOVE CTE-CON-ENTR-ANT-GAS       TO MOV-CLACON
                MOVE WS-MES-GASTOS              TO MOV-IMPMOVI
                PERFORM  2641-INSERT-TBL-MVTOS-PT

           END-IF.

      ******************************************************************
      *             2641-INSERT-TBL-MVTOS-PT                           *
      *    INSERTAR MOVIMIENTO EN LA TABLA DE MOVIMIENTOS DE CUENTA    *
      ******************************************************************
       2641-INSERT-TBL-MVTOS-PT.
      *
           MOVE WS-ENTIOFI                   TO MAE-ENTIOFI
           MOVE WS-CUENTA                    TO MAE-CUENTA
           MOVE ZEROES                       TO MOV-NUMER-MOV
      *
           EXEC SQL
             INSERT INTO UGDTMOV
               (ENTIOFI,
                CUENTA,
                FECONTA,
                CLAOPER,
                SECUMOV,
                FEOPER,
                FEVALOR,
                ENTIOPE,
                CLACON,
                IMPMOVI,
                INDRETRO,
                FELIQ,
                SALREAL,
                UGYINDIF,
                IND_MARCA1,
                IND_MARCA2,
      *EFR01-I
                IND_MARCA3,
      *EFR01-F
                ENTIDAD_PAG,
                CENTRO_PAG,
                CUENTA_PAG,
                DIGICCC1_PAG,
                DIGICCC2_PAG,
                UGYINCOR ,
                CLADIS ,
                NETNAME_UMO,
                USERID_UMO,
                ENTIDAD_UMO,
                CENTRO_UMO,
                RUTA,
                MONEDA,
                NUMER_MOV,
                LIBRE_IMP1,
                LIBRE_IMP2,
                LIBRE_IMP3)
             VALUES
               (:MAE-ENTIOFI,
                :MAE-CUENTA,
                :MOV-FECONTA,
                :MOV-CLAOPER,
                CURRENT TIMESTAMP,
                :MOV-FEOPER,
                :WS-DB2-FEVALOR,
                :MOV-ENTIOPE,
                :MOV-CLACON,
                :MOV-IMPMOVI,
                :MOV-INDRETRO,
                :MOV-FELIQ,
                :MOV-SALREAL,
                :MOV-UGYINDIF,
                :MOV-IND-MARCA1,
                :MOV-IND-MARCA2,
      *EFR01-I
                :MOV-IND-MARCA3,
      *EFR01-F
                :MOV-ENTIDAD-PAG,
                :MOV-CENTRO-PAG,
                :MOV-CUENTA-PAG,
                :MOV-DIGICCC1-PAG,
                :MOV-DIGICCC2-PAG,
                :MOV-UGYINCOR,
                :MOV-CLADIS,
                :MOV-NETNAME-UMO,
                :MOV-USERID-UMO,
                :MOV-ENTIDAD-UMO,
                :MOV-CENTRO-UMO,
                :MOV-RUTA,
                :MOV-MONEDA,
                :MOV-NUMER-MOV,
                :MOV-LIBRE-IMP1,
                :MOV-LIBRE-IMP2,
                :MOV-LIBRE-IMP3)
           END-EXEC
      *
           MOVE SQLCODE                      TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'UGDTMOV'                 TO C86A-RET-VAR1-ERROR
              MOVE 'INSERT UGDTMOV'          TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *                265-TMOD-CUOTAS                                 *
      *    PARA LA CUOTA VIGENTE Y TODAS LAS POSTERIORES,              *
      *    FORMATEAR EN EL REGISTRO DE LA TABLA UGDTMOD                *
      *    LOS DATOS DE TABLA UGDTCUO, ANTES DE ACTUALIZARLA           *
      ******************************************************************
       265-TMOD-CUOTAS.
      *
           PERFORM  2650-CLAVE-TMOD
           PERFORM  2651-ABRIR-CURSOR
           PERFORM  2652-FETCH-REGISTROS
      *
           PERFORM  2653-TMOD-T39-ANT-INS
             UNTIL NOT DB2-OK
      *
           IF NOT DB2-NOTFND
              MOVE 'UGDTCUO'              TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT UGDTCUO'       TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF
      *
           PERFORM  2654-CERRAR-CURSOR.

      ******************************************************************
      *              2650-CLAVE-TMOD                                   *
      *    FORMATEAR EN EL REGISTRO DE LA TABLA UGDTMOD                *
      *    LA CLAVE PARA LOS REGISTROS DE CUOTAS                       *
      ******************************************************************
       2650-CLAVE-TMOD.
      *
           MOVE CAA-CODTRAN                   TO MOD-CODTRAN
           MOVE 'UGDTCUO'                     TO MOD-TABLA
           MOVE WS-CLAVE                      TO MOD-CLAVE
           MOVE SPACES                        TO MOD-VALOR-ACT
           MOVE 'PROGRAMA UG2CG086'           TO MOD-COMENTARIO
           MOVE C86A-ENTIDAD-CONT             TO MOD-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO MOD-CENTRO-UMO
           MOVE C86A-USUARIO                  TO MOD-USERID-UMO
           MOVE WC-PROGRAMA                   TO MOD-NETNAME-UMO.

      ******************************************************************
      *              2651-ABRIR-CURSOR                                 *
      *   ABRE CURSOR EN LA TABLA DE CUOTAS A PARTIR DE LA CUOTA       *
      *   VIGENTE EN LA FECHA VALOR                                    *
      ******************************************************************
       2651-ABRIR-CURSOR.
      *
           MOVE WS-ENTIOFI                    TO CUO-ENTIOFI
           MOVE WS-CUENTA                     TO CUO-CUENTA
      *
           EXEC SQL
             OPEN CURSOR39
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'OPEN CUSOR39 UGDTCUO'     TO C86A-RET-VAR1-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *              2652-FETCH-REGISTROS                              *
      *   PASA A VARIABLES LOS DATOS DE LA CUOTA LEIDA                 *
      ******************************************************************
       2652-FETCH-REGISTROS.
      *
           EXEC SQL
             FETCH CURSOR39
               INTO
                :CUO-FECOVALI,
                :CUO-FEFIVALI,
                :CUO-IMPMINI
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE.

      ******************************************************************
      *              2653-TMOD-T39-ANT-INS                             *
      *    SE VA INSERTANDO UNA FILA EN LA TABLA UGDTMOD               *
      *    POR CADA COLUMNA LEIDA, Y SE LEE LA SIGUIENTE               *
      *    FILA, HASTA QUE NO HAYA MAS FILAS EN LA TABLA DE CUOTAS     *
      ******************************************************************
       2653-TMOD-T39-ANT-INS.
      *
           PERFORM 26531-INSERTAR-EN-TMOD
           PERFORM 2652-FETCH-REGISTROS.

      ******************************************************************
      *                  26531-INSERTAR-EN-TMOD                        *
      *    FORMATEAR EN EL REGISTRO DE LA TABLA UGDTMOD                *
      *    LOS DATOS DE TABLA CUO ANTES DE BORRAR, LA CLAVE Y          *
      *    REALIZAR EL INSERT EN LA TABLA UGDTMOD                      *
      ******************************************************************
       26531-INSERTAR-EN-TMOD.
      *
           MOVE 'FECOVALI'                    TO MOD-COLUMNA
           MOVE CUO-FECOVALI                  TO MOD-VALOR-ANT
           PERFORM 2621-INSERT-MOD
      *
           MOVE 'IMPMINI'                     TO MOD-COLUMNA
           MOVE CUO-IMPMINI                   TO MOD-VALOR-ANT-NUM
           PERFORM 2621-INSERT-MOD
      *
           MOVE 'FEFIVALI'                    TO MOD-COLUMNA
           MOVE CUO-FEFIVALI                  TO MOD-VALOR-ANT
           PERFORM 2621-INSERT-MOD.

      ******************************************************************
      *              2654-CERRAR-CURSOR                                *
      *   CIERRA CURSOR DE LA TABLA UGDTCUO                            *
      ******************************************************************
       2654-CERRAR-CURSOR.
      *
           EXEC SQL
             CLOSE CURSOR39
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'CLOSECUSOR39 UGDTCUO'     TO C86A-RET-VAR1-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *             266-ACTUALIZAR-TBL-CUOTAS                          *
      *    ACTUALIZAR LA TABLA DE CUOTAS                               *
      ******************************************************************
       266-ACTUALIZAR-TBL-CUOTAS.
      *
           IF WS-FEFIVALI < MAE-FEVENCIN
              MOVE WS-FEFIVALI                TO WS-FEFIVALIMAX
           ELSE
              MOVE MAE-FEVENCIN               TO WS-FEFIVALIMAX
           END-IF
      *
           MOVE COT-TIP-CUOTA                 TO CTE-CON-CODTIAMO
      *
           IF WS-FEFIVALIMAX > MAE-FEFINCAR  OR
              (NOT CTE-CODTIAMO-CAP-MAS-INT  AND
                   COT-TIP-CUOTA NOT = 'I'   AND
                   COT-TIP-CUOTA NOT = 'L' )

              IF COT-TIP-CUOTA = CTE-CON-ALFA-1   OR
                 COT-TIP-CUOTA = CTE-CON-REGLA-78 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-2   OR
                 COT-TIP-CUOTA = CTE-CON-A        OR
                 COT-TIP-CUOTA = 'T'              OR
                 COT-TIP-CUOTA = 'W'              OR
                 COT-TIP-CUOTA = CTE-CON-B        OR
                 COT-TIP-CUOTA = CTE-CON-P        OR
                 COT-TIP-CUOTA = CTE-CON-G        OR
                 COT-TIP-CUOTA = 'I'              OR
                 COT-TIP-CUOTA = 'J'              OR
                 COT-TIP-CUOTA = 'K'              OR
                 COT-TIP-CUOTA = 'L'              OR
                 COT-TIP-CUOTA = 'M'              OR
                 COT-TIP-CUOTA = 'H'

                 PERFORM 2661-ACT-TBL-CUOTAS-CON

              ELSE
                 PERFORM 2662-ACT-TBL-CUOTAS-VAR
              END-IF

           END-IF.

      ******************************************************************
      *             2661-ACT-TBL-CUOTAS-CON                            *
      *  ACTUALIZAR LA TABLA DE CUOTAS PARA LOS TIPOS DE CUOTA         *
      *  CONSTANTES Y EL DE CUOTA UNICA                                *
      *  IGUAL VENCIMIENTO Y MENOR CUOTA:                              *
      *    FECOVALI: FECHA VALOR  O FECHA DE FIN DE CARENCIA           *
      *    FEFIVALI: FEFIVALIMAX                                       *
      ******************************************************************
       2661-ACT-TBL-CUOTAS-CON.
      *
           IF WS-IND-5 NOT =  CTE-CON-ALFA-1
              PERFORM  26611-UPDATE-CUOTA
      *
      *    SI NO ENCUENTRA CUOTA NO ABENDAMOS PORQUE QUIERE DECIR
      *    QUE LA FECHA DE COMIENZO DE VALIDEZ DEL TRAMO ES IGUAL
      *    A LA FECHA VALOR DE LA ENTREGA. ESTE TRAMO SE BORRA
      *    ENTERO POSTERIORMENTE
              IF NOT DB2-OK  AND
                 NOT DB2-NOTFND
                   MOVE 'UGDTCUO'              TO C86A-RET-VAR1-ERROR
                   MOVE 'UPDATE  UGDTCUO'      TO C86A-RET-VAR2-ERROR
                   PERFORM 999999-ABEND-DB2
              END-IF
           END-IF
      *
           PERFORM  26612-DELETE-CUOTAS
      *
           IF NOT DB2-OK
              IF NOT DB2-NOTFND
                 MOVE 'UGDTCUO'                TO C86A-RET-VAR1-ERROR
                 MOVE 'DELETE  UGDTCUO'        TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF
      *
           EVALUATE SW-TIPO-PAGO
              WHEN  'RC'

                IF WS-DB2-FEVALOR     >  MAE-FEFINCAR
                   MOVE WS-DB2-FEVALOR         TO CUO-FECOVALI
                ELSE
                   MOVE MAE-FEFINCAR           TO CUO-FECOVALI
                END-IF
      *
                MOVE WS-FEFIVALIMAX            TO CUO-FEFIVALI
                MOVE WS-MES-CUOTAO1            TO CUO-IMPMINI
      *EFR01-I
                IF SW-SI-PUNICA
                   MOVE WS-M-INICIAL           TO WS-PLAZO-NVO-PU
                   COMPUTE WS-KTEOR-PU-NVO  = WS-KTEOR-PU - VLR-K-PU
                   COMPUTE WS-COT-PUNICA ROUNDED = WS-KTEOR-PU-NVO /
                                                   WS-PLAZO-NVO-PU
                   ADD WS-COT-PUNICA           TO CUO-IMPMINI
                END-IF
      *EFR01-F
      *
                IF CUO-FEFIVALI      > CUO-FECOVALI
                   MOVE C86A-ENTIDAD-CONT      TO CUO-ENTIDAD-UMO
                   MOVE C86A-CENTRO-CONT       TO CUO-CENTRO-UMO
                   MOVE C86A-USUARIO           TO CUO-USERID-UMO
                   MOVE WC-PROGRAMA            TO CUO-NETNAME-UMO
                   MOVE MAE-MONEDA             TO CUO-MONEDA
                   PERFORM 26613-INSERT-CUOTAS
                END-IF

              WHEN  'RP'

                 MOVE WS-DB2-FEVALOR           TO CUO-FECOVALI
      *
                 MOVE  C86A-S-LIBRE-FEC2       TO CTA-FECHA-AUX1
                 MOVE  CTA-FECHA-AUX1-MES      TO WS-FOR-MM
                 MOVE  CTA-FECHA-AUX1-DIA      TO WS-FOR-DD
                 MOVE  CTA-FECHA-AUX1-ANNO     TO WS-FOR-AA
                 MOVE  WS-FOR-DD               TO WS-DB2-DD
                 MOVE  WS-FOR-MM               TO WS-DB2-MM
                 MOVE  WS-FOR-AA               TO WS-DB2-AAAA

                 MOVE WS-DB2-AAAA-MM-DD        TO CUO-FEFIVALI
      *
                 IF WS-FEFIVALIMAX  <  CUO-FEFIVALI
                    MOVE WS-FEFIVALIMAX        TO CUO-FEFIVALI
                 END-IF
      *
                 MOVE WS-MES-CUOTAO2           TO CUO-IMPMINI
      *
      *EFR01-I
                IF SW-SI-PUNICA
                   MOVE WS-M-FINAL             TO WS-PLAZO-NVO-PU
                   COMPUTE WS-KTEOR-PU-NVO  = WS-KTEOR-PU - VLR-K-PU
                   COMPUTE WS-COT-PUNICA ROUNDED = WS-KTEOR-PU-NVO /
                                                   WS-PLAZO-NVO-PU
                   ADD WS-COT-PUNICA           TO CUO-IMPMINI
                END-IF
      *EFR01-F
                 IF CUO-FEFIVALI      > CUO-FECOVALI
                    MOVE C86A-ENTIDAD-CONT     TO CUO-ENTIDAD-UMO
                    MOVE C86A-CENTRO-CONT      TO CUO-CENTRO-UMO
                    MOVE C86A-USUARIO          TO CUO-USERID-UMO
                    MOVE WC-PROGRAMA           TO CUO-NETNAME-UMO
                    MOVE MAE-MONEDA            TO CUO-MONEDA
                    PERFORM 26613-INSERT-CUOTAS
                 END-IF

           END-EVALUATE.

      ******************************************************************
      *             26611-UPDATE-CUOTA                                 *
      *    LA CUOTA QUE CORRESPONDIA A LA FECHA VALOR DE LA ENTREGA    *
      *    DEJA DE ESTAR VIGENTE EN DICHA FECHA                        *
      *    TENGASE EN CUENTA QUE CUANDO LA FECHA VALOR COINCIDE CON    *
      *    FECOVALI NO SE REALIZA EL UPDATE                            *
      ******************************************************************
       26611-UPDATE-CUOTA.
      *
           MOVE WS-ENTIOFI                    TO MAE-ENTIOFI
           MOVE WS-CUENTA                     TO MAE-CUENTA
           MOVE C86A-ENTIDAD-CONT             TO CUO-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO CUO-CENTRO-UMO
           MOVE C86A-USUARIO                  TO CUO-USERID-UMO
           MOVE WC-PROGRAMA                   TO CUO-NETNAME-UMO
           MOVE MAE-MONEDA                    TO CUO-MONEDA
      *
           EXEC SQL
             UPDATE  UGDTCUO
               SET
                 FEFIVALI    = :WS-DB2-FEVALOR,
                 TIMESTAMP   = CURRENT TIMESTAMP,
                 NETNAME_UMO = :CUO-NETNAME-UMO,
                 USERID_UMO  = :CUO-USERID-UMO,
                 ENTIDAD_UMO = :CUO-ENTIDAD-UMO,
                 CENTRO_UMO  = :CUO-CENTRO-UMO
               WHERE
                       ENTIOFI   =      :MAE-ENTIOFI      AND
                       CUENTA    =      :MAE-CUENTA       AND
                       FECOVALI  <      :WS-DB2-FEVALOR   AND
                       FEFIVALI  >      :WS-DB2-FEVALOR
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE.

      ******************************************************************
      *             26612-DELETE-CUOTAS                                *
      *    BORRAR LAS CUOTAS PARA FECHAS POSTERIORES A LA FECHA VALOR  *
      *    DE LA ENTREGA. POSTERIORMENTE SE RECALCULARAN               *
      ******************************************************************
       26612-DELETE-CUOTAS.
      *
           MOVE WS-ENTIOFI                    TO MAE-ENTIOFI
           MOVE WS-CUENTA                     TO MAE-CUENTA
      *
           EXEC SQL
             DELETE  FROM  UGDTCUO
               WHERE
                       ENTIOFI   =      :MAE-ENTIOFI      AND
                       CUENTA    =      :MAE-CUENTA       AND
                       FEFIVALI  >      :WS-DB2-FEVALOR
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE.

      ******************************************************************
      *             26613-INSERT-CUOTAS                                *
      *    INSERTAR UNA CUOTA EN LA TABLA DE CUOTAS                    *
      ******************************************************************
       26613-INSERT-CUOTAS.
      *
           MOVE WS-ENTIOFI                    TO MAE-ENTIOFI
           MOVE WS-CUENTA                     TO MAE-CUENTA
      *
           EXEC SQL
             INSERT INTO UGDTCUO
               (ENTIOFI,
                CUENTA,
                FECOVALI,
                FEFIVALI,
                IMPMINI,
                TIMESTAMP,
                NETNAME_UMO,
                USERID_UMO,
                ENTIDAD_UMO,
                CENTRO_UMO,
                MONEDA)
             VALUES
               (:MAE-ENTIOFI,
                :MAE-CUENTA,
                :CUO-FECOVALI,
                :CUO-FEFIVALI,
                :CUO-IMPMINI,
                CURRENT TIMESTAMP,
                :CUO-NETNAME-UMO,
                :CUO-USERID-UMO,
                :CUO-ENTIDAD-UMO,
                :CUO-CENTRO-UMO,
                :CUO-MONEDA)
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK  AND NOT DB2-DUPREC
              MOVE 'UGDTCUO'                  TO C86A-RET-VAR1-ERROR
              MOVE 'INSERT  UGDTCUO'          TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *             2662-ACT-TBL-CUOTAS-VAR                            *
      *  ACTUALIZAR LA TABLA DE CUOTAS PARA TIPOS DE CUOTA VARIABLE    *
      ******************************************************************
       2662-ACT-TBL-CUOTAS-VAR.
      *
           IF WS-IND-5       =  CTE-CON-ALFA-0
              PERFORM  26611-UPDATE-CUOTA
      *
      *    SI NO ENCUENTRA CUOTA NO ABENDAMOS PORQUE QUIERE DECIR      *
      *    QUE LA FECHA DE COMIENZO DE VALIDEZ DEL TRAMO ES IGUAL      *
      *    A LA FECHA VALOR DE LA ENTREGA. ESTE TRAMO SE BORRA         *
      *    ENTERO POSTERIORMENTE                                       *
              IF NOT DB2-OK AND
                 NOT DB2-NOTFND
                   MOVE 'UGDTCUO'              TO C86A-RET-VAR1-ERROR
                   MOVE 'UPDATE  UGDTCUO'      TO C86A-RET-VAR2-ERROR
                   PERFORM 999999-ABEND-DB2
              END-IF
           END-IF
      *
           PERFORM 26612-DELETE-CUOTAS
      *
           IF NOT DB2-OK
              IF NOT DB2-NOTFND
                 MOVE 'UGDTCUO'                TO C86A-RET-VAR1-ERROR
                 MOVE 'DELETE  UGDTCUO'        TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF
      *
           EVALUATE SW-TIPO-PAGO
              WHEN  'RC'
                 PERFORM  26623-ACT-TBL-V-O1
              WHEN  'RP'
                 PERFORM  26623-2-ACT-TBL-V-O2
           END-EVALUATE
      *
           PERFORM  26624-ACT-TBL-V-O123.

      ******************************************************************
      *             26623-ACT-TBL-V-O1                                 *
      *    PARA CUOTAS VARIABLES Y OPCION "MANTENER VENCIMIENTO Y      *
      *    REDUCIR CUOTA", HALLAR IMPORTE Y FECHAS DE COMIENZO Y       *
      *    FIN DE VALIDEZ DE LA PRIMERA CUOTA DESPUES DE LA ENTREGA    *
      *    FECOVALI: FECHA VALOR O FECHA DE FIN DE CARENCIA            *
      *    FEFIVALI: LA QUE HABIA ANTES                                *
      *                                                                *
      ******************************************************************
       26623-ACT-TBL-V-O1.
      *
           MOVE WS-MES-CUOTAO1                   TO CUO-IMPMINI
      *
           IF WS-DB2-FEVALOR     >  MAE-FEFINCAR
              MOVE WS-DB2-FEVALOR                TO CUO-FECOVALI
      *
              IF COT-TIP-CUOTA      = CTE-CON-ALFA-3       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-4       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-7       OR
                 COT-TIP-CUOTA      = CTE-CON-ALFA-8
                 MOVE  MAE-FEPROAMO              TO CUO-FEFIVALI
              ELSE
      *          FEFIVALI=FEPROAMO+(WS-R-INICIAL - 1)*PERIODO
                 MOVE  MAE-FEPROAMO              TO DFP-FECHA-INICIAL
                 SUBTRACT CTE-CON-1-COMP3      FROM WS-R-INICIAL
                      GIVING  DFP-NUM-PERIODOS
                      ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
                 END-SUBTRACT
      *
                 PERFORM  24731-DESPLAZAR-FECHA
                 MOVE  DFP-FECHA-FINAL           TO  CUO-FEFIVALI
              END-IF
           ELSE
              MOVE MAE-FEFINCAR                  TO CUO-FECOVALI
      *
              IF COT-TIP-CUOTA = CTE-CON-ALFA-3 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-4 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-7 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-8
      *            FEFIVALI=FEFINCAR+PERIODO
                   MOVE  MAE-FEFINCAR            TO DFP-FECHA-INICIAL
                   MOVE CTE-CON-1-COMP3          TO DFP-NUM-PERIODOS
                   PERFORM  24731-DESPLAZAR-FECHA
                   MOVE  DFP-FECHA-FINAL         TO CUO-FEFIVALI
              ELSE
      *            FEFIVALI=FEFINCAR+(1 + WS-R-INICIAL - 1)*PERIODO
                 MOVE MAE-FEFINCAR               TO DFP-FECHA-INICIAL
                 MOVE WS-R-INICIAL               TO DFP-NUM-PERIODOS
                 PERFORM  24731-DESPLAZAR-FECHA
                 MOVE  DFP-FECHA-FINAL           TO CUO-FEFIVALI
              END-IF
           END-IF
      *
           IF CUO-FEFIVALI      > CUO-FECOVALI
              MOVE C86A-ENTIDAD-CONT             TO CUO-ENTIDAD-UMO
              MOVE C86A-CENTRO-CONT              TO CUO-CENTRO-UMO
              MOVE C86A-USUARIO                  TO CUO-USERID-UMO
              MOVE WC-PROGRAMA                   TO CUO-NETNAME-UMO
              MOVE MAE-MONEDA                    TO CUO-MONEDA
              PERFORM 26613-INSERT-CUOTAS
           END-IF.

      ******************************************************************
      *             26623-2-ACT-TBL-V-O2                               *
      *    PARA CUOTAS VARIABLES Y OPCION "MANTENER CUOTA Y REDUCIR    *
      *    VIDA PRESTAMO", HALLAR IMPORTE Y FECHAS DE COMIENZO Y       *
      *    FIN DE VALIDEZ DE LA PRIMERA CUOTA DESPUES DE LA ENTREGA    *
      *  OPCION 2, IGUAL CUOTA       Y MENOR VIDA:                     *
      *    FECOVALI: FECHA VALOR                                       *
      *    FEFIVALI: LA QUE HABIA ANTES O LA FECHA DE VENCIMIENTO      *
      ******************************************************************
       26623-2-ACT-TBL-V-O2.
      *
           MOVE WS-MES-CUOTAO2                   TO CUO-IMPMINI
           MOVE WS-DB2-FEVALOR                   TO CUO-FECOVALI
      *
           IF COT-TIP-CUOTA = CTE-CON-ALFA-3 OR
              COT-TIP-CUOTA = CTE-CON-ALFA-4 OR
              COT-TIP-CUOTA = CTE-CON-ALFA-7 OR
              COT-TIP-CUOTA = CTE-CON-ALFA-8
                MOVE  MAE-FEPROAMO               TO CUO-FEFIVALI
           ELSE
      *        FEFIVALI=FEPROAMO+(WS-R-FINAL   - 1)*PERIODO
              MOVE  MAE-FEPROAMO                 TO DFP-FECHA-INICIAL
              SUBTRACT CTE-CON-1-COMP3      FROM WS-R-FINAL
                   GIVING  DFP-NUM-PERIODOS
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
              END-SUBTRACT
              PERFORM  24731-DESPLAZAR-FECHA
              MOVE  DFP-FECHA-FINAL              TO CUO-FEFIVALI
           END-IF
      *
           IF CUO-FEFIVALI      > CUO-FECOVALI
              MOVE C86A-ENTIDAD-CONT             TO CUO-ENTIDAD-UMO
              MOVE C86A-CENTRO-CONT              TO CUO-CENTRO-UMO
              MOVE C86A-USUARIO                  TO CUO-USERID-UMO
              MOVE WC-PROGRAMA                   TO CUO-NETNAME-UMO
              MOVE MAE-MONEDA                    TO CUO-MONEDA
              PERFORM 26613-INSERT-CUOTAS
           END-IF.

      ******************************************************************
      *             26624-ACT-TBL-V-O123                               *
      *    PARA CUOTAS VARIABLES, CALCULAR E INSERTAR LAS SIGUIENTES   *
      *    CUOTAS HASTA EL VENCIMIENTO O FEFIVALIMAX                   *
      ******************************************************************
       26624-ACT-TBL-V-O123.
      *
           MOVE CTE-CON-9999999999999        TO CO2-SALDO
           MOVE CTE-CON-1                    TO CO2-SALTO-CUOTA
      *
           PERFORM WITH TEST BEFORE
              UNTIL CUO-FEFIVALI = WS-FEFIVALIMAX
              MOVE CUO-IMPMINI               TO  CO2-CUOTA
      *
              PERFORM RUTINA-CALC-CUOTA-SIGUIENTE
      *
              IF CO2-CODIGO       NOT =  ZERO
                 MOVE CAA-COD-ERROR           TO C86A-RET-COD-ERROR
                 MOVE CAA-VAR1-ERROR          TO C86A-RET-VAR1-ERROR
                 MOVE CAA-VAR2-ERROR          TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
      *
              MOVE CO2-CUOTA                 TO CUO-IMPMINI
              MOVE CUO-FEFIVALI              TO CUO-FECOVALI
              MOVE CUO-FECOVALI              TO DFP-FECHA-INICIAL
      *
              IF COT-TIP-CUOTA = CTE-CON-ALFA-3 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-4 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-7 OR
                 COT-TIP-CUOTA = CTE-CON-ALFA-8
                   MOVE  CTE-CON-1-COMP3     TO DFP-NUM-PERIODOS
              ELSE
                 MOVE  WS-LININCUO           TO DFP-NUM-PERIODOS
              END-IF
      *
              PERFORM  24731-DESPLAZAR-FECHA
      *
              MOVE  DFP-FECHA-FINAL          TO CUO-FEFIVALI
      *
              IF WS-FEFIVALIMAX  <  CUO-FEFIVALI
                 MOVE WS-FEFIVALIMAX         TO CUO-FEFIVALI
              END-IF
      *
              MOVE C86A-ENTIDAD-CONT         TO CUO-ENTIDAD-UMO
              MOVE C86A-CENTRO-CONT          TO CUO-CENTRO-UMO
              MOVE C86A-USUARIO              TO CUO-USERID-UMO
              MOVE WC-PROGRAMA               TO CUO-NETNAME-UMO
              MOVE MAE-MONEDA                TO CUO-MONEDA
              PERFORM  26613-INSERT-CUOTAS
           END-PERFORM.

      ******************************************************************
      *    VERIFICA SI EXISTE PROCESO DE SUSPENSION DE CAUSACION PARA  *
      *    EL PRESTAMO                                                 *
      ******************************************************************
       45-CAPITAL-CONTINGENTE.

           INITIALIZE WRK-SALDO-REAL-ANT   WRK-SALDO-REAL
                      WRK-SALDO-PERS-ANT   WRK-SALDO-PERSONAL
                      WRK-REAL-NEGA        WRK-PERS-NEGA

           MOVE MAE-ENTIOFI                       TO REV-ENTIOFI
           MOVE MAE-CUENTA                        TO REV-CUENTA
           MOVE 'KC'                              TO REV-PROCESO

           EXEC SQL
              SELECT SAL_CIER
                    ,IMP10
                    ,CAP_CONT
                INTO :REV-SAL-CIER
                    ,:REV-IMP10
                    ,:REV-CAP-CONT
              FROM UGDTREV
              WHERE ENTIOFI = :REV-ENTIOFI
                AND CUENTA  = :REV-CUENTA
                AND PROCESO = :REV-PROCESO
           END-EXEC

           MOVE SQLCODE                           TO DB2-RETURN-CDE

           IF DB2-OK
              IF REV-SAL-CIER + REV-IMP10 NOT = 0

                 MOVE REV-SAL-CIER                TO WS-SAL-CIER
                 MOVE REV-IMP10                   TO WS-IMP10
                 MOVE REV-CAP-CONT                TO WS-CAP-CONT
                 MOVE 'S'                         TO WRK-SI-CAPITAL-CONT

                 PERFORM 452-REGISTRO-UGDTREV

              ELSE
                 MOVE ZEROS                       TO WS-CAP-CONT
                 MOVE ZEROS                       TO REV-CAP-CONT
                 MOVE 'N'                         TO WRK-SI-CAPITAL-CONT
              END-IF

              PERFORM 312-ACTUALIZAR-IND-CONTI

           ELSE
              IF DB2-NOTFND
                MOVE 'N'                          TO WRK-SI-CAPITAL-CONT
              ELSE
                MOVE 'UGDTREV'                    TO C86A-RET-VAR1-ERROR
                MOVE 'SELECT UGDTREV'             TO C86A-RET-VAR2-ERROR
                PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *  APLICA EL ABONO A CAPITAL CONTINGENTE:                        *
      *  1- SI SALDO ES MAYOR QUE EL VALOR A COBRAR:                   *
      *     RESTA COBRO DE SALDO                                       *
      *     CONTABILIZA TODO A CAPITAL CONTINGENTE                     *
      *  2- SI SALDO CONTINGENTE ES MENOR O IGUAL QUE VALOR A COBRAR   *
      *     SALDO CONTINGENTE QUEDA EN 0                               *
      *     SE CONTABILIZAN CAPITAL CONTINGENTE Y NORMAL               *
      ******************************************************************
       452-REGISTRO-UGDTREV.
           MOVE REV-SAL-CIER                    TO WRK-SALDO-REAL-ANT
           MOVE REV-IMP10                       TO WRK-SALDO-PERS-ANT
      *@COL02-I
      *    IF REV-SAL-CIER > ( CLS-WS-REALPROP + CLS-WS-REALRETO )
      *
      *       COMPUTE REV-SAL-CIER = REV-SAL-CIER -
      *                            ( CLS-WS-REALPROP + CLS-WS-REALRETO )
      *       COMPUTE WRK-SALDO-REAL =
      *                            ( CLS-WS-REALPROP + CLS-WS-REALRETO )
      *
      *       MOVE 0                            TO CLS-WS-REALPROP
      *                                            CLS-WS-REALRETO
      *
      *    ELSE
      *
      *       MOVE REV-SAL-CIER                 TO WRK-SALDO-REAL
      *       MOVE 0                            TO REV-SAL-CIER
      *
      *       IF WRK-SALDO-REAL-ANT <= CLS-WS-REALPROP
      *
      *          IF WRK-SALDO-REAL-ANT < 0
      *             MOVE WRK-SALDO-REAL-ANT     TO WRK-REAL-NEGA
      *          ELSE
      *             SUBTRACT WRK-SALDO-REAL-ANT FROM CLS-WS-REALPROP
      *          END-IF
      *
      *       ELSE
      *          MOVE 0                         TO CLS-WS-REALPROP
      *          COMPUTE CLS-WS-REALRETO = CLS-WS-REALRETO -
      *                         ( WRK-SALDO-REAL-ANT - CLS-WS-REALPROP )
      *       END-IF
      *
      *    END-IF
      *
      *    IF REV-IMP10 > ( CLS-WS-PERSPROP + CLS-WS-PERSRETO )
      *
      *       COMPUTE REV-IMP10 = REV-IMP10 -
      *                         ( CLS-WS-PERSPROP + CLS-WS-PERSRETO )
      *       COMPUTE WRK-SALDO-PERSONAL =
      *                         ( CLS-WS-PERSPROP + CLS-WS-PERSRETO )
      *
      *       MOVE 0                            TO CLS-WS-PERSPROP
      *                                            CLS-WS-PERSRETO
      *
      *    ELSE
      *
      *       MOVE REV-IMP10                    TO WRK-SALDO-PERSONAL
      *       MOVE 0                            TO REV-IMP10
      *
      *       IF WRK-SALDO-PERS-ANT <= CLS-WS-PERSPROP
      *
      *          IF WRK-SALDO-PERS-ANT < 0
      *             MOVE WRK-SALDO-PERS-ANT     TO WRK-PERS-NEGA
      *          ELSE
      *             SUBTRACT WRK-SALDO-PERS-ANT FROM CLS-WS-PERSPROP
      *          END-IF
      *
      *       ELSE
      *          MOVE 0 TO CLS-WS-PERSPROP
      *          COMPUTE CLS-WS-PERSRETO = CLS-WS-PERSRETO -
      *                         ( WRK-SALDO-PERS-ANT - CLS-WS-PERSPROP )
      *       END-IF
      *    END-IF
           IF REV-SAL-CIER > ( CLS-WS-REALPROP + CLS-WS-REALRETO )
              COMPUTE REV-SAL-CIER = REV-SAL-CIER -
                         ( CLS-WS-REALPROP + CLS-WS-REALRETO )
              COMPUTE WRK-SALDO-REAL =
                         ( CLS-WS-REALPROP + CLS-WS-REALRETO )
              MOVE 0     TO CLS-WS-REALPROP
                            CLS-WS-REALRETO
           ELSE
              MOVE REV-SAL-CIER TO WRK-SALDO-REAL
              MOVE 0            TO REV-SAL-CIER
              IF WRK-SALDO-REAL-ANT <= CLS-WS-REALPROP
                 IF WRK-SALDO-REAL-ANT < 0
                    MOVE WRK-SALDO-REAL-ANT     TO WRK-REAL-NEGA
                 ELSE
                    SUBTRACT WRK-SALDO-REAL-ANT FROM CLS-WS-REALPROP
                 END-IF
              ELSE
                 MOVE 0 TO CLS-WS-REALPROP
                 COMPUTE CLS-WS-REALRETO = CLS-WS-REALRETO -
                            ( WRK-SALDO-REAL-ANT - CLS-WS-REALPROP )
              END-IF
           END-IF

           IF REV-IMP10 > ( CLS-WS-PERSPROP + CLS-WS-PERSRETO )
              IF ( CLS-WS-PERSPROP + CLS-WS-PERSRETO ) > 0
                 COMPUTE REV-IMP10 = REV-IMP10 -
                            ( CLS-WS-PERSPROP + CLS-WS-PERSRETO )
                 COMPUTE WRK-SALDO-PERSONAL =
                            ( CLS-WS-PERSPROP + CLS-WS-PERSRETO )
                 MOVE 0   TO CLS-WS-PERSPROP
                            CLS-WS-PERSRETO
              ELSE
                 ADD REV-IMP10    TO WRK-SALDO-REAL
                 MOVE 0            TO REV-IMP10
                 IF WRK-SALDO-REAL-ANT <= CLS-WS-REALPROP
                   IF WRK-SALDO-PERS-ANT < 0
                      MOVE WRK-SALDO-REAL-ANT     TO WRK-REAL-NEGA
                   ELSE
                      SUBTRACT WRK-SALDO-PERS-ANT FROM CLS-WS-REALPROP
                   END-IF
                 ELSE
                    MOVE 0 TO CLS-WS-REALPROP
                    COMPUTE CLS-WS-REALRETO = CLS-WS-REALRETO -
                            ( WRK-SALDO-PERS-ANT - CLS-WS-REALPROP )
                 END-IF
              END-IF
           ELSE
              MOVE REV-IMP10 TO WRK-SALDO-PERSONAL
              MOVE 0                TO REV-IMP10
              IF WRK-SALDO-PERS-ANT <= CLS-WS-PERSPROP
                 IF WRK-SALDO-PERS-ANT < 0
                    MOVE WRK-SALDO-PERS-ANT     TO WRK-PERS-NEGA
                 ELSE
                    SUBTRACT WRK-SALDO-PERS-ANT FROM CLS-WS-PERSPROP
                 END-IF
              ELSE
                 MOVE 0 TO CLS-WS-PERSPROP
                 COMPUTE CLS-WS-PERSRETO = CLS-WS-PERSRETO -
                            ( WRK-SALDO-PERS-ANT - CLS-WS-PERSPROP )
              END-IF
           END-IF
      *@COL02-F
           MOVE MAE-ENTIOFI                     TO REV-ENTIOFI
           MOVE MAE-CUENTA                      TO REV-CUENTA
           MOVE 'KC'                            TO REV-PROCESO

           MOVE C86A-ENTIDAD-CONT               TO REV-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT                TO REV-CENTRO-UMO
           MOVE C86A-USUARIO                    TO REV-USERID-UMO
           MOVE WC-PROGRAMA                     TO REV-NETNAME-UMO

           COMPUTE REV-CAP-CONT = REV-SAL-CIER + REV-IMP10

           EXEC SQL
              UPDATE UGDTREV
                 SET  SAL_CIER     = :REV-SAL-CIER
                    , IMP10        = :REV-IMP10
                    , CAP_CONT     = :REV-CAP-CONT
                    , ENTIDAD_UMO  = :REV-ENTIDAD-UMO
                    , CENTRO_UMO   = :REV-CENTRO-UMO
                    , USERID_UMO   = :REV-USERID-UMO
                    , NETNAME_UMO  = :REV-NETNAME-UMO
                    , TIMESTAMP    = CURRENT TIMESTAMP
              WHERE ENTIOFI = :REV-ENTIOFI
                AND CUENTA  = :REV-CUENTA
                AND PROCESO = :REV-PROCESO
           END-EXEC

           MOVE SQLCODE                         TO DB2-RETURN-CDE

           IF DB2-OK
              PERFORM 453-REGISTRO-UGDTMVC
           ELSE
              MOVE 'UGDTREV'                    TO C86A-RET-VAR1-ERROR
              MOVE 'UPATE UGDTREV'              TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.



      ******************************************************************
      *   GENERE REGISTRO DE MOVIENTO E UGDTMVC
      ******************************************************************
       453-REGISTRO-UGDTMVC.

           MOVE MAE-ENTIOFI                    TO MVC-ENTIOFI
           MOVE MAE-CUENTA                     TO MVC-CUENTA

           EXEC SQL
              SELECT MAX(CONS_MOV)
                INTO :MVC-CONSMOV
              FROM UGDTMVC
              WHERE ENTIOFI = :MVC-ENTIOFI
                AND CUENTA  = :MVC-CUENTA
           END-EXEC

           MOVE SQLCODE  TO DB2-RETURN-CDE

           EVALUATE TRUE
              WHEN DB2-OK
                 MOVE MVC-CONSMOV              TO WS-CONSMOV
                 COMPUTE MVC-CONSMOV = MVC-CONSMOV + 1
              WHEN DB2-NULL-VALUE
              WHEN DB2-NOTFND
                 MOVE ZEROES                   TO WS-CONSMOV
                 MOVE 1                        TO MVC-CONSMOV
              WHEN OTHER
                 MOVE 'UGDTMVC'                TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTMVC'         TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
           END-EVALUATE


           MOVE '02'                           TO MVC-TIPOMOV
           MOVE CAA-FECHA-OPER2                TO MVC-FECHMOV

           COMPUTE MVC-CAPCONTANT = WRK-SALDO-REAL-ANT +
                                    WRK-SALDO-PERS-ANT
           COMPUTE MVC-CAPCONTACT = REV-SAL-CIER + REV-IMP10
           COMPUTE MVC-CAPCONTNOV = MVC-CAPCONTANT - MVC-CAPCONTACT

           MOVE CAA-FECHA-OPER2                TO MVC-FECHAOPER
           MOVE CAA-FECHA-CONT2                TO MVC-FECHACONT
           MOVE CAA-FECHA-CONT2                TO MVC-FECHAUVR
           MOVE WRK-SALDO-REAL                 TO MVC-UVRVALOR1
           MOVE WRK-SALDO-PERSONAL             TO MVC-UVRVALOR2
           MOVE SPACES                         TO MVC-INDUVRCAR1
           MOVE SPACES                         TO MVC-INDUVRCAR2
           MOVE 'UG2CG086:ENTREGA ANTICIPADA'  TO MVC-DETALLE
           MOVE C86A-ENTIDAD-CONT              TO MVC-ENTIDADUMO
           MOVE C86A-CENTRO-CONT               TO MVC-CENTROUMO
           MOVE C86A-USUARIO                   TO MVC-USERIDUMO
           MOVE WC-PROGRAMA               TO MVC-NETNAMEUMO

           EXEC SQL
              SET :MVC-FECHMOV   = CURRENT DATE
           END-EXEC

           EXEC SQL
              SET :MVC-TIMESTAMP = CURRENT TIMESTAMP
           END-EXEC

           EXEC SQL
              INSERT INTO UGDTMVC
                 VALUES (  :MVC-ENTIOFI
                         , :MVC-CUENTA
                         , CURRENT DATE
                         , :MVC-CONSMOV
                         , :MVC-TIPOMOV
                         , :MVC-CAPCONTANT
                         , :MVC-CAPCONTACT
                         , :MVC-CAPCONTNOV
                         , :MVC-FECHAOPER
                         , :MVC-FECHACONT
                         , :MVC-FECHAUVR
                         , :MVC-UVRVALOR1
                         , :MVC-UVRVALOR2
                         , :MVC-INDUVRCAR1
                         , :MVC-INDUVRCAR2
                         , :MVC-DETALLE
                         , :MVC-ENTIDADUMO
                         , :MVC-CENTROUMO
                         , :MVC-USERIDUMO
                         , :MVC-NETNAMEUMO
                         , :MVC-TIMESTAMP
                        )
           END-EXEC

           MOVE SQLCODE                        TO DB2-RETURN-CDE

           IF NOT DB2-OK
              MOVE 'UGDTMVC'                   TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT UGDTMVC'            TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           ELSE
              PERFORM 311-ACTUALIZAR-MOD-REV
           END-IF.

