      *    MAESTRA DE CUPOS (UGDTCMA)                                  *
      ******************************************************************
       211-BUSCAR-MAECUPOS.
      *
           MOVE MAE-ENTIOFI                   TO CMA-ENTIOFI
           MOVE MAE-CUENTA                    TO CMA-CUENTA
      *
           EXEC SQL
             SELECT
                    LIMITE_ACT,
                    DISPONIBLE,
                    RETENIDO,
                    SALDO_INTPER,
                    TASA_NOMINAL,
                    TASA_EFECTIVA,
                    CONSEC_DETALLE
               INTO
                    :CMA-LIMITE-ACT,
                    :CMA-DISPONIBLE,
                    :CMA-RETENIDO,
                    :CMA-SALDO-INTPER,
                    :CMA-TASA-NOMINAL,
                    :CMA-TASA-EFECTIVA,
                    :CMA-CONSEC-DETALLE
               FROM UGDVCMA0
              WHERE CUENTA    = :CMA-CUENTA
                AND ENTIOFI   = :CMA-ENTIOFI
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              ADD 1                           TO CMA-CONSEC-DETALLE
           ELSE
              IF DB2-NOTFND
                 MOVE 'UGE0939'           TO C86A-RET-COD-ERROR
                 MOVE 'NO ENCONTRO CUPOS' TO C86A-RET-VAR1-ERROR
                 MOVE 'UGDTCMA'           TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UGDVCMA0'          TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTCMA'    TO C86A-RET-VAR2-ERROR
                 PERFORM  999999-ABEND-DB2
