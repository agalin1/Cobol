           END-IF
           END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *              228-COMPROBAR-UGIIIANA-MOD                        *
      *                                                                *
      *    SE COMPRUEBA QUE EL UGIIIANA ESTA IGUAL QUE CUANDO SE       *
      *    ESCRIBIO EN UGDTMOD  DESPUES DE LA ENTREGA ANTICIPADA.      *
      *    CALCULO DE NUEVO EL TIMESTAMP, PARA UGIIIANA PORQUE         *
      *    NO EN LA UGDTMOD SE INSERTA POR CURRENT TIMESTAMP, Y        *
      *    ESTE PUEDE SER MAYOR POR MILESIMAS DE SEGUNDO               *
      *                                                                *
      ******************************************************************
      *
       228-COMPROBAR-UGIIIANA-MOD.
      *
           MOVE 'U283'                TO MOD-CODTRAN
           MOVE 'UGDTMAE'             TO MOD-TABLA
           MOVE WS-CCC-ENTIOFI        TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA         TO WS-CUENTA
           MOVE WS-CLAVE              TO MOD-CLAVE

           MOVE 'UGIIIANA'            TO MOD-COLUMNA
           PERFORM 23211-RECOGER-VALOR-MAE
           MOVE MOD-VALOR-ACT-NUM        TO WS-IMPORTE-COMP
           IF MAE-UGIIIANA  NOT = WS-IMPORTE-COMP
              MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
      ******************************************************************
      *              229-COMPROBAR-UGDTAHI-MOD                         *
      *    SE COMPRUEBA QUE SI SE REVERSA UN PAGO DE CUOTA FINAL       *
      *    ESCRIBIO EN UGDTMOD  PARA LA UGDTAHI                       *
      ******************************************************************
      *
       229-COMPROBAR-UGDTAHI-MOD.
      *
           MOVE 'U283'                TO MOD-CODTRAN
           MOVE 'UGDTAHI'             TO MOD-TABLA
           MOVE WS-CCC-ENTIOFI        TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA         TO WS-CUENTA
           MOVE WS-CLAVE              TO MOD-CLAVE
           MOVE 'CUOTAFIN'            TO MOD-COLUMNA
      *
           EXEC SQL
               SELECT  VALOR_ANT    ,     VALOR_ACT
                 INTO :MOD-VALOR-ANT    , :MOD-VALOR-ACT
                 FROM  UGDTMOD
                WHERE  CODTRAN    = :MOD-CODTRAN      AND
                       TABLA      = :MOD-TABLA        AND
                       CLAVE      = :MOD-CLAVE        AND
                       COLUMNA    = :MOD-COLUMNA      AND
                       TIMESTAMP >= :MOD-TIMESTAMP
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE.
      *
           IF DB2-OK
              MOVE 'S'                      TO WS-REVER-CUOTAFIN
              MOVE MOD-VALOR-ANT-NUM        TO WS-CUOTAFIN-ANT
              MOVE 'U283'                   TO MOD-CODTRAN
              MOVE 'UGDTAHI'                TO MOD-TABLA
              MOVE WS-CCC-ENTIOFI           TO WS-ENTIOFI
              MOVE WS-CCC-CUENTA            TO WS-CUENTA
              MOVE WS-CLAVE                 TO MOD-CLAVE
              MOVE 'PORFINA-ACT'            TO MOD-COLUMNA
      *
              EXEC SQL
                  SELECT  VALOR_ANT    ,     VALOR_ACT
                    INTO :MOD-VALOR-ANT    , :MOD-VALOR-ACT
                    FROM  UGDTMOD
                   WHERE  CODTRAN    = :MOD-CODTRAN      AND
                          TABLA      = :MOD-TABLA        AND
                          CLAVE      = :MOD-CLAVE        AND
                          COLUMNA    = :MOD-COLUMNA      AND
                          TIMESTAMP >= :MOD-TIMESTAMP
              END-EXEC
      *
              MOVE SQLCODE                 TO DB2-RETURN-CDE
      *
              IF DB2-OK
                 COMPUTE WS-PORCEN-ANT =  MOD-VALOR-ANT-NUM / 1000000
              ELSE
                 MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                 MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                216-VALIDA-LEASING.                             *
      *----------------------------------------------------------------*
      *   VALIDA QUE EL SUBPRODUCTO SEA DE LEASING                     *
      *                                                                *
      ******************************************************************
       216-VALIDA-LEASING.

           INITIALIZE UGTCT37
           SET SW-NO-LEASING                  TO TRUE.
           MOVE MAE-SUBPRO                    TO T37-ELEMENTO
           MOVE '1250'                        TO T37-SECCION

           EXEC SQL
              SELECT RESTO
                  INTO :T37-RESTO
                  FROM UGDTT37
                 WHERE SECCION   = :T37-SECCION  AND
                       ELEMENTO  = :T37-ELEMENTO
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           EVALUATE TRUE
              WHEN DB2-OK
                 IF T37-RESTO NOT EQUAL SPACES
                    SET SW-SI-LEASING               TO TRUE
                       PERFORM 217-VALOR-ADQ-PESOS
                 ELSE
                    MOVE ZEROS               TO WS-VLR-ADQ-INI
                                                WS-VLR-ADQ-ACT
                 END-IF
              WHEN DB2-NOTFND
                 CONTINUE
              WHEN OTHER
                 MOVE 'UGDTT37'          TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTT37-'  TO C86A-RET-VAR2-ERROR
                 MOVE T37-SECCION        TO C86A-RET-VAR2-ERROR(16:5)
                 PERFORM 999999-ABEND-DB2
           END-EVALUATE.
      ******************************************************************
      *                217-VALOR-ADQ-PESOS.                            *
      *----------------------------------------------------------------*
      *   BUSCA EL VALOR DE ADQUISICION DEL LEASING                    *
      ******************************************************************

       217-VALOR-ADQ-PESOS.
      *
           MOVE WS-CCC-ENTIOFI         TO REV-ENTIOFI
           MOVE WS-CCC-CUENTA          TO REV-CUENTA
           MOVE 'LH'                   TO REV-PROCESO
      *

           EXEC SQL
            SELECT IMP10,IMP11
            INTO  :REV-IMP10,
                  :REV-IMP11
            FROM UGDTREV
            WHERE ENTIOFI   = :REV-ENTIOFI
            AND CUENTA      = :REV-CUENTA
            AND PROCESO     = :REV-PROCESO
           END-EXEC


           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE REV-IMP10    TO WS-VLR-ADQ-INI
              IF REV-IMP11 NOT = ZEROS
                 MOVE REV-IMP11 TO  WS-VLR-ADQ-ACT
              ELSE
                 MOVE ZEROS     TO WS-VLR-ADQ-ACT
              END-IF
           ELSE
              IF DB2-NOTFND
                 MOVE SPACES               TO T37-RESTO
                 MOVE ZEROS                TO WS-VLR-ADQ-INI
                                              WS-VLR-ADQ-ACT
              ELSE
                 MOVE 'UGDTREV'               TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTREV'        TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ******************************************************************
      *              230-COMPROBAR-UGDTREV-MOD                         *
      *    SE COMPRUEBA QUE SI SE REVERSA UN PAGO DE OPCION DE         *
      *    ADQUISICI├ôN                                                *
      ******************************************************************
      *
       230-COMPROBAR-UGDTREV-MOD.
      *
           MOVE 'U283'                TO MOD-CODTRAN
           MOVE 'UGDTREV'             TO MOD-TABLA
           MOVE WS-CCC-ENTIOFI        TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA         TO WS-CUENTA
           MOVE WS-CLAVE              TO MOD-CLAVE
           MOVE 'OPCADQUI'            TO MOD-COLUMNA
      *
           EXEC SQL
               SELECT  VALOR_ANT    ,     VALOR_ACT
                 INTO :MOD-VALOR-ANT    , :MOD-VALOR-ACT
                 FROM  UGDTMOD
                WHERE  CODTRAN    = :MOD-CODTRAN      AND
                       TABLA      = :MOD-TABLA        AND
                       CLAVE      = :MOD-CLAVE        AND
                       COLUMNA    = :MOD-COLUMNA      AND
                       TIMESTAMP >= :MOD-TIMESTAMP
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE.
      *
           IF DB2-OK
              MOVE 'S'                      TO WS-REVER-OPCADQUI
              MOVE MOD-VALOR-ANT-NUM        TO WS-VLR-ADQ-ANT
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                 MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                                                                *
      *                 22A-VAL-DATCALRBO                              *
      *                                                                *
      ******************************************************************
       22A-VAL-DATCALRBO.

           MOVE  MAE-ENTIOFI          TO DRB-ENTIOFI
           MOVE  MAE-CUENTA           TO DRB-CUENTA

           EXEC SQL
               SELECT UGIQUOTA,
                      UGCPLAZO,
                      UGNPLPEN,
                      UGNINFAC,
                      UGSPDREB
               INTO  :DRB-UGIQUOTA,
                     :DRB-UGCPLAZO,
                     :DRB-UGNPLPEN,
                     :DRB-UGNINFAC,
                     :DRB-UGSPDREB
               FROM UGDTDRB
               WHERE ENTIOFI = :DRB-ENTIOFI
                 AND CUENTA  = :DRB-CUENTA
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              IF (DRB-UGCPLAZO NOT = MAE-PLAZO) OR
                 (WS-MES-IMPMINI NOT = 0 AND
                  DRB-UGIQUOTA NOT = WS-MES-IMPMINI)
      *
                  IF SI-FLEXIBLE
                    IF (DRB-UGCPLAZO NOT = MAE-PLAZO) OR
                       (WS-MES-IMPMINI NOT = 0)
      *
                      MOVE 'UGE1285'     TO C86A-RET-COD-ERROR
                      PERFORM  3-FINAL-PROGRAMA
      *
                    ELSE
                      CONTINUE
                    END-IF
                  ELSE
                      MOVE 'UGE1285'         TO C86A-RET-COD-ERROR
                      PERFORM      3-FINAL-PROGRAMA
                  END-IF
      *
              ELSE
                  MOVE DRB-UGNINFAC TO WS-UGNINFAC
              END-IF
           ELSE
              IF (DB2-NOTFND     AND
                   SQLWARN0 = SPACES)
                   MOVE 'UGE0412'     TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
              ELSE
                   MOVE 'UGDTDRB' TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                 22B-VAL-INCIDFAC                               *
      *                                                                *
      ******************************************************************
      *
       22B-VAL-INCIDFAC.
      *
           MOVE MAE-ENTIOFI          TO IFA-ENTIOFI
           MOVE MAE-CUENTA           TO IFA-CUENTA
           MOVE WS-DB2-FEVALOR       TO IFA-UGFVALOR
           IF SI-ENCONTRO-PPC
              MOVE MAE-FEULIQ        TO IFA-UGFVALOR
           END-IF
           IF SI-FLEXIBLE
              MOVE '1'                TO IFA-UGYINDIF
           ELSE
              MOVE '0'                TO IFA-UGYINDIF
           END-IF
           MOVE WS-UGNINFAC          TO IFA-UGNROINC.

           EXEC SQL
                OPEN CURSOR-IFA
           END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              SET SW-CONTINUAR TO TRUE
           ELSE
              IF (DB2-NOTFND     AND
                   SQLWARN0 = SPACES)
                   MOVE 'UGE0412'     TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
              ELSE
                   MOVE 'UGDTIFA'    TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *
           PERFORM 22B1-CONSULTAR-UGDTIFA UNTIL SW-NO-CONTINUAR.
      *
           EXEC SQL
                CLOSE CURSOR-IFA
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              NEXT SENTENCE
           ELSE
              IF (DB2-NOTFND     AND
                   SQLWARN0 = SPACES)
                   MOVE 'UGE0412'     TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
              ELSE
                   MOVE 'UGDTIFA'    TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                 22B1-CONSULTAR-UGDTIFA                         *
      *                                                                *
      ******************************************************************
      *
       22B1-CONSULTAR-UGDTIFA.
      *
           EXEC SQL
               FETCH CURSOR-IFA
               INTO  :IFA-ENTIOFI,
                     :IFA-CUENTA,
                     :IFA-UGTINCID,
                     :IFA-UGYINDIF,
                     :IFA-UGYALAUT,
                     :IFA-UGFVALOR,
                     :IFA-UGNROINC,
                     :IFA-UGIMPORT,
                     :IFA-UGINTAMO,
                     :IFA-UGICOMIS,
                     :IFA-UGISBAMO,
                     :IFA-UGFVNANT,
                     :IFA-UGFVNNOU,
                     :IFA-UGNREBSU,
                     :IFA-LLIURE-IND3,
                     :IFA-LLIURE-DAT1,
                     :IFA-UGNROIRE,
                     :IFA-UGCAMORT
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              IF WS-DIF-INTERES > 0
                 SET NO-GRACIA            TO TRUE
                 MOVE ZEROS               TO WS-MES-INTERESES-DIF
                 MOVE WS-MES-INTERESES    TO WS-MES-INTERESES-DIF
                 SUBTRACT WS-DIF-INTERES FROM WS-MES-INTERESES
              END-IF
              IF ( IFA-LLIURE-IND3 = 'A' OR 'T' )
                 AND IFA-UGFVALOR > '0001-01-01'
                 SET SW-NO-CONTINUAR          TO TRUE
              ELSE
                 IF IFA-UGIMPORT = WS-MES-CAPITAL        AND
                    ( IFA-UGFVNNOU = '0001-01-01' OR
                      IFA-UGFVNNOU = MAE-FEVENCIN      ) AND
                    ( IFA-UGINTAMO = WS-MES-INTERESES OR
                      IFA-UGINTAMO = (WS-MES-INTERESES-ANTI * (-1)) )
                    SET SW-NO-CONTINUAR       TO TRUE
                 ELSE
                    SET SW-CONTINUAR          TO TRUE
                 END-IF
                 IF SI-GRACIA AND IFA-UGINTAMO < ZEROS
                    SET SW-NO-CONTINUAR       TO TRUE
                 END-IF
              END-IF
              IF WS-DIF-INTERES > 0
                 MOVE WS-MES-INTERESES-DIF  TO WS-MES-INTERESES
              END-IF
           ELSE
              SET SW-NO-CONTINUAR TO TRUE
              IF (DB2-NOTFND     AND
                   SQLWARN0 = SPACES)
                   MOVE 'UGE0412'     TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
              ELSE
                   MOVE 'UGDTIFA'    TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *             2225-FECHA-DB2-A-FOR                               *
      *                                                                *
      *    PASA LA FECHA DE FORMATO DB2 (AAAA-MM-DD)  A  FORMATO       *
      *                             FOR (DD-MM-AA)                     *
      *                                                                *
      ******************************************************************
       2225-FECHA-DB2-A-FOR.
      *
           MOVE  WS-DB2-DD         TO WS-FOR-DD
           MOVE  WS-DB2-MM         TO WS-FOR-MM
           MOVE  WS-DB2-AAAA       TO WS-FOR-AA.
      ******************************************************************
      *                     2251-CONSULTAR-DIF                         *
      ******************************************************************
       2251-CONSULTAR-DIF.
      *
           MOVE MAE-ENTIOFI                TO LOG-ENTIOFI
           MOVE MAE-CUENTA                 TO LOG-CUENTA
           MOVE 'PGDF'                     TO LOG-CODIGO
           MOVE WS-DB2-FEOPER              TO LOG-FECMOV
      *
           EXEC SQL
               SELECT    LOG_IMPNUE,
                         LOG_IMPANT
                 INTO   :LOG-IMPNUE,
                        :LOG-IMPANT
                 FROM    UGDTLOG
                 WHERE   LOG_ENTIOFI  = :LOG-ENTIOFI  AND
                         LOG_CUENTA   = :LOG-CUENTA   AND
                         LOG_CODIGO   = :LOG-CODIGO   AND
                         LOG_FECMOV   = :LOG-FECMOV
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              MOVE  LOG-IMPNUE             TO WS-DIF-INTERES
              MOVE  LOG-IMPANT             TO WS-DIF-SEGURO
           ELSE
              IF DB2-NOTFND
                 MOVE ZEROS                TO WS-DIF-SEGURO
                 MOVE ZEROS                TO WS-DIF-INTERES
              ELSE
                 MOVE 'UGE0939'            TO C86A-RET-COD-ERROR
                 MOVE 'SELECT DIFERIDOS'   TO C86A-RET-VAR1-ERROR
                 MOVE SQLCODE              TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                 2231-VALIDAR-GESTOR                            *
      *                                                                *
      * -  SE BUSCA SI HUBO UN MOVIMIENTO EN LA TABLA UGDTMOV CORRES-  *
      *    PONDIENTE AL CAMBIO DE CENTRO GESTOR                        *
      *                                                                *
      *  NO SE PERMITE LA ANULACION DEL PAGO ANTICIPADO  SI SE REALIZO *
      *  UN CAMBIO DE CENTRO GESTOR POSTERIOR A LA FECHA DE PAGO DEL   *
      *  RECIBO                                                        *
      *                                                                *
      * -  SE VALIDA QUE LA OFICINA QUE INTENTA DESHACER EL PAGO ANTI- *
      *    CIPADO SEA LA MISMA QUE LO EFECTUO.                         *
      *                                                                *
      ******************************************************************
       2231-VALIDAR-GESTOR.
      *
           MOVE 0                             TO WS-CONTADOR.
      *
           EXEC SQL
                  SELECT COUNT(*)
                    INTO :WS-CONTADOR
                    FROM UGDTMOV
                   WHERE ENTIOFI   = :MOV-ENTIOFI      AND
                         CUENTA    = :MOV-CUENTA       AND
                         SECUMOV  >  :WS-TIM-MOV-MAX   AND
                         INDRETRO  = 'N'               AND
                         CLACON    = 'ZG'
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK OR SQLWARN0 NOT = SPACES
               MOVE 'UGDTMOV'                 TO C86A-RET-VAR1-ERROR
               MOVE 'SELECT COUNT GESTOR'     TO C86A-RET-VAR2-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      *
           IF WS-CONTADOR = 0
              CONTINUE
           ELSE
              MOVE 'UGE3420'                  TO C86A-RET-COD-ERROR
              MOVE MOV-FEOPER                 TO C86A-RET-VAR1-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
