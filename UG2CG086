                 TABLA      =  :MOD-TABLA      AND
                 CLAVE      =  :MOD-CLAVE      AND
                 TIMESTAMP  >= :WS-TIMESTAMP-SALDO
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK               AND
                   SQLWARN0  =  SPACES)
