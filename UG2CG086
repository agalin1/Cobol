      ******************************************************************
      *                   221T-BUSCA-CONVENIO                          *
      *    PERMITE EL ACCESO A LA TABLA DE CONVENIOS PARA SABER SI     *
      *    ADMITE O NO PAGOS ANTICIPADOS                               *
      ******************************************************************
       221T-BUSCA-CONVENIO.

           IF MAE-INDADMES EQUAL 'S'
              MOVE ADE-ENTSUB                 TO CNV-CODENTIT
              MOVE ADE-CONSUB                 TO CNV-CODCONV
           ELSE
              MOVE ADS-ENTSUB                 TO CNV-CODENTIT
              MOVE ADS-CONSUB                 TO CNV-CODCONV
           END-IF
      *
           MOVE MAE-FECAPROBA                 TO CNV-FINICIO
      *
           EXEC SQL
             SELECT
               PREPAG
             INTO
              :CNV-PREPAG
             FROM USDTCNV
              WHERE CODENTIT = :CNV-CODENTIT     AND
                    CODCONV  = :CNV-CODCONV      AND
                    FINICIO <= :CNV-FINICIO      AND
                    FFINAL  >= :CNV-FINICIO
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF  DB2-NOTFND
               MOVE 'UGE0394'                 TO C86A-RET-COD-ERROR
               PERFORM 3-FINAL-PROGRAMA
           ELSE
               IF  NOT DB2-OK
                   MOVE 'USDTCNV'             TO C86A-RET-VAR1-ERROR
                   MOVE 'SELECT USDTCNV'      TO C86A-RET-VAR2-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF
      *
           IF  CNV-PREPAG NOT = 'S'
               MOVE 'UGE4445'                 TO C86A-RET-COD-ERROR
               MOVE 'ADMITE PAGOS ANTICI.'    TO C86A-RET-VAR1-ERROR
               MOVE 'NO ADMITE PAGOS ANT.'    TO C86A-RET-VAR2-ERROR
               PERFORM 3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *                 23412-3-VALIDA-TIP-CUOTA
      *    LA AMORTIZACION GRADUAL(C), LA ARITMETICA(E) Y LA GEOME-    *
      *    TRICA(D) NO ADMITEN REDUCCION DE CUOTAS                     *
      ******************************************************************
       23412-3-VALIDA-TIP-CUOTA.
      *
           IF SW-TIPO-REDUC-CUOTA
              EVALUATE COT-TIP-CUOTA
                 WHEN 'C'
                 WHEN 'D'
                 WHEN 'E'
                    MOVE 'UGE3403'         TO C86A-RET-COD-ERROR
                    MOVE 'UR9CI012'        TO C86A-RET-VAR1-ERROR
                    PERFORM 3-FINAL-PROGRAMA
                 WHEN OTHER
                    CONTINUE
              END-EVALUATE
           ELSE
      ******************************************************************
      *    NO SE PERMITE REDUCCION DEL PLAZO PARA:                     *
      *       1) LA AMORTIZACION GRADUAL(C)                            *
      *       2) LA AMORTIZACION ROTATIVA (J)                          *
      ******************************************************************
             EVALUATE COT-TIP-CUOTA
                WHEN 'C'
                   MOVE 'UGE3403'              TO C86A-RET-COD-ERROR
                   MOVE 'UR9CI012'             TO C86A-RET-VAR1-ERROR
                   PERFORM 3-FINAL-PROGRAMA
                WHEN 'J'
                   MOVE 'UGE3435'              TO C86A-RET-COD-ERROR
                   MOVE 'REDUCCION DE PLAZO  ' TO C86A-RET-VAR1-ERROR
                   MOVE 'PARA CUPO ROTATIVO  ' TO C86A-RET-VAR2-ERROR
                   PERFORM 3-FINAL-PROGRAMA
                WHEN OTHER
                   CONTINUE
             END-EVALUATE
           END-IF.

