                    WHERE ENTIOFI      = :IFA-ENTIOFI
                      AND CUENTA       = :IFA-CUENTA
                      AND UGFVALOR     = :IFA-UGFVALOR
                      AND UGTINCID     = 'D'
                      AND UGNROINC     = :IFA-UGNROINC
                      AND LLIURE_IND3  = ' '
              END-EXEC
           END-IF.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF NOT (DB2-OK AND SQLWARN0 = SPACES)
              MOVE 'UGDTIFA'                  TO C86A-RET-VAR1-ERROR
              MOVE 'UPDATE IFA ANTERIOR'      TO C86A-RET-VAR2-ERROR
