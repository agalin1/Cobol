      ******************************************************************
      * OBTIENE EL INDICADOR QUE IDENTIFICA SI EL PRESTAMO ES DE       *
      * CREDITO VIRTUAL                                                *
      ******************************************************************
       232-OBT-IND-CV.
      *
           INITIALIZE UGTCT37
           MOVE MAE-SUBPRO                TO T37-ELEMENTO
           MOVE '9084'                    TO T37-SECCION
      *
           EXEC SQL
              SELECT RESTO
              INTO  :T37-RESTO
              FROM UGDTT37
              WHERE ELEMENTO = :T37-ELEMENTO
                AND SECCION  = :T37-SECCION
           END-EXEC
      *
           MOVE SQLCODE                   TO DB2-RETURN-CDE
      *
           IF DB2-OK
              SET SW-VIRTUAL-SI           TO TRUE
           ELSE
              IF DB2-NOTFND
                SET SW-VIRTUAL-NO         TO TRUE
              ELSE
                MOVE 'SELECT-3 UGDTT37'   TO C86A-RET-VAR2-ERROR
                PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *COL04-FIN
      *
      ******************************************************************
      *                       201-ACCEDER-ADE                          *
      * SE REALIZA LA VERIFICACION DE LOS DIAS CALENDARIO PARA SABER   *
      * SI SE TOMAN DIAS NATURALES O DIAS COMERCIALES                  *
      ******************************************************************
       200-ACCEDER-ADE.
      *
           IF MAE-FEVENCIN < WS-DB2-FEVALOR
              MOVE MAE-FEVENCIN   TO WS-FECHA-BUSQUEDA
           ELSE
              MOVE WS-DB2-FEVALOR TO WS-FECHA-BUSQUEDA
           END-IF
      *
           MOVE MAE-ENTIOFI                  TO ADE-ENTIOFI
           MOVE MAE-CUENTA                   TO ADE-CUENTA
      *
           EXEC SQL SELECT
                         DIASCAL
                   INTO
                        :ADE-DIASCAL
              FROM UGDTADE
              WHERE ENTIOFI   =  :ADE-ENTIOFI       AND
                    CUENTA    =  :ADE-CUENTA        AND
                    FECOVALI  <= :WS-FECHA-BUSQUEDA AND
                    FEFIVALI  >= :WS-FECHA-BUSQUEDA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE ADE-DIASCAL                TO WS-DIASCAL-DIAS
           ELSE
              MOVE 'UGDTADE'                  TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT UGDTADE'           TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
           END-IF.
      *
      ******************************************************************
      *                      201-ACCEDER-ADS                           *
      * SE REALIZA LA VERIFICACION DE LOS DIAS CALENDARIO PARA SABER   *
      * SI SE TOMAN DIAS NATURALES O DIAS COMERCIALES                  *
      ******************************************************************
       201-ACCEDER-ADS.
      *
           MOVE MAE-PRODUCTO                  TO ADS-PRODUCTO
           MOVE MAE-SUBPRO                    TO ADS-SUBPRO
      *
           EXEC SQL SELECT
                DIASCAL
              INTO
                :ADS-DIASCAL
              FROM UGDTADS
              WHERE PRODUCTO  = :ADS-PRODUCTO     AND
                    SUBPRO    = :ADS-SUBPRO       AND
                    FECOVALI <= :MAE-FECAPROBA    AND
                    FEFIVALI >= :MAE-FECAPROBA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE ADS-DIASCAL                TO WS-DIASCAL-DIAS
           ELSE
              MOVE 'UGDTADS'                  TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT UGDTADS'           TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *                232-VALIDAR-SUBPRO                              *
      *        SE VERIFICA SI EL SUBPRO ACEPTA ANTICIPADOS             *
      ******************************************************************
       232-VALIDAR-SUBPRO.
      *
            MOVE MAE-PRODUCTO                 TO PRO-PRODUCTO
            MOVE MAE-SUBPRO                   TO PRO-SUBPRO
      *
            EXEC SQL
              SELECT
                INDENTAN,
                IMPMINEA,
                INDISSU,
                IND_MARCA2,
                TEXTORED
              INTO
               :PRO-INDENTAN,
               :PRO-IMPMINEA,
               :PRO-INDISSU,
               :PRO-IND-MARCA2,
               :PRO-TEXTORED
              FROM UGDTPRO
              WHERE PRODUCTO = :PRO-PRODUCTO
              AND   SUBPRO   = :PRO-SUBPRO
            END-EXEC
      *
            MOVE SQLCODE                      TO DB2-RETURN-CDE
      *
            IF DB2-OK
              IF PRO-INDENTAN      = CTE-CON-N
                 MOVE CTE-CON-UGE0108         TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
              MOVE PRO-TEXTORED               TO C86A-DESCSUBPRO
            ELSE
              MOVE 'UGDTPRO'                  TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT UGDTPRO'           TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
            END-IF.

      ******************************************************************
      *                2320-VALIDA-CONSTRUCTOR                        *
      *    SE ACCEDE A LA TABLA UGDTT37 SECCION 1063, VALIDACION DE    *
      *    SUBPRODUCTOS PARA CREDITOS CONSTRUCTOR                      *
      ******************************************************************
       2320-VALIDA-CONSTRUCTOR.
      *
            INITIALIZE UGTCT37
            MOVE '1063'                    TO T37-SECCION
            MOVE MAE-SUBPRO                TO T37-ELEMENTO
            SET  WS-CONSTRUCTOR-NO         TO TRUE
      *
            EXEC SQL
                 SELECT RESTO
                 INTO  :T37-RESTO
                 FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                      ELEMENTO = :T37-ELEMENTO
            END-EXEC
      *
            MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
            IF DB2-OK
               SET  WS-CONSTRUCTOR-SI          TO TRUE
            ELSE
               IF DB2-NOTFND
                  SET  WS-CONSTRUCTOR-NO       TO TRUE
               ELSE
                  MOVE 'UGDTT37'               TO C86A-RET-VAR1-ERROR
                  MOVE 'SELECT-2 UGDTT37'      TO C86A-RET-VAR2-ERROR
                  PERFORM  999999-ABEND-DB2
               END-IF
            END-IF
      * SOLO CUANDO NO HAY CAMBIO DE OPCION PRORRATA A PAGO ANTICIPADO
            IF C86A-E-LIBRE-CAR2(1:1) = 'N'
               IF  WS-CONSTRUCTOR-SI
               AND (SW-TIPO-REDUC-PLAZO OR SW-TIPO-REDUC-CUOTA)

                  MOVE 'UGE0015'                 TO C86A-RET-COD-ERROR
                  MOVE 'CREDI CONSTRUCTOR NO'    TO C86A-RET-VAR1-ERROR
                  IF SW-TIPO-REDUC-PLAZO
                     MOVE 'APLICA REDU. D PLAZO' TO C86A-RET-VAR2-ERROR
                  ELSE
                     MOVE 'APLICA REDU. D CUOTA' TO C86A-RET-VAR2-ERROR
                  END-IF
                  PERFORM 3-FINAL-PROGRAMA

               END-IF
            END-IF

            IF WS-CONSTRUCTOR-NO AND SW-TIPO-PAGO-PRORATA
               MOVE 'UGE0015'                 TO C86A-RET-COD-ERROR
               MOVE 'OPC. PRORATA  APLICA'    TO C86A-RET-VAR1-ERROR
               MOVE 'A CREDIT-CONSTRUCTOR'    TO C86A-RET-VAR2-ERROR
               PERFORM 3-FINAL-PROGRAMA
            END-IF.

      ******************************************************************
      *                  232-1-VALIDAR-GRACIA-CEI                      *
      *    SE ACCEDE A LA TABLA UGDTT37 SECCION 1021, MANEJO DE        *
      *    GRACIA PARA CAPITAL E INTERESES                             *
      ******************************************************************
       232-1-VALIDAR-GRACIA-CEI.
      *
            INITIALIZE UGTCT37
            MOVE '1021'                  TO T37-SECCION
            MOVE PRO-SUBPRO              TO T37-ELEMENTO
            SET SW-NO-HAY-GRACIA         TO TRUE
      *
            EXEC SQL
                 SELECT RESTO
                 INTO  :T37-RESTO
                 FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                      ELEMENTO = :T37-ELEMENTO
            END-EXEC
      *
            MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
            IF DB2-OK
               MOVE T37-RESTO(5:1)       TO WS-INT-CAPITALIZABLES
                 IF WS-INT-CAPITALIZABLES = '0'
                    IF MAE-FEULIQ > WS-DB2-FEVALOR  AND
                       MAE-FECPRILIQ = MAE-FEPROLIQ
                          SET SW-SI-HAY-GRACIA    TO TRUE
                    END-IF
                 END-IF
            ELSE
               IF DB2-NOTFND
                  MOVE SPACES                  TO T37-RESTO
               ELSE
                  MOVE 'UGDTT37'               TO C86A-RET-VAR1-ERROR
                  MOVE 'SELECT UGDTT37'        TO C86A-RET-VAR2-ERROR
                  PERFORM  999999-ABEND-DB2
               END-IF
            END-IF.

      ******************************************************************
      * SE VALIDA SI EL SUBPRODUCTO CORRESPONDE A CREDITOS DE FINAGRO  *
      ******************************************************************
       233-VALIDA-FINAGRO.
      *
           MOVE 0                              TO WS-BAND-FIN
           INITIALIZE UGTCT37
           MOVE MAE-SUBPRO                     TO T37-ELEMENTO
           MOVE '9063'                         TO T37-SECCION
      *
           EXEC SQL
               SELECT SECCION ,
                      ELEMENTO,
                      RESTO
                 INTO :T37-SECCION ,
                      :T37-ELEMENTO,
                      :T37-RESTO
                  FROM UGDTT37
                 WHERE SECCION    = :T37-SECCION
                   AND ELEMENTO   = :T37-ELEMENTO
           END-EXEC.
      *
           MOVE SQLCODE                        TO DB2-RETURN-CDE
      *
           IF DB2-OK
              IF T37-RESTO NOT EQUAL SPACES
                 MOVE  1                       TO WS-BAND-FIN
              END-IF
           ELSE
              IF DB2-NOTFND
                 MOVE SPACES                   TO T37-RESTO
              ELSE
                 MOVE 'UGDTT37'                TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTT37'         TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *                236-VALIDAR-CONTRATO                            *
      ******************************************************************
       234-VALIDAR-CONTRATO.
      *
           INITIALIZE                         URWCUVR
      *
           IF MAE-LIBRE-CAR6 = 'UVR' OR 'UVRBO'
              MOVE C86A-FECHA-OPER            TO UVR-WS-FECHA
              SET  UVR-WS-ONLINE              TO TRUE
              SET  UVR-WS-UVR                 TO TRUE
              MOVE ZEROS                      TO UVR-WS-VALOR-PESOS
              PERFORM 2340-HALLAR-UVR
              SET  UVR-WS-BATCH               TO TRUE
           END-IF
      *                                                                *
           PERFORM 2341-VAL-FECHA-VALOR
      *
           IF NOT SW-TIPO-PAGO-PRORATA
              PERFORM 2343-FACTURA-PRESTEC
           END-IF

      *   VALIDA QUE LA CUENTA DE PRESTAMO NO TIENE PAGOS PENDIENTES   *
           IF MAE-INDDEUPE  =  CTE-CON-S
              MOVE CTE-CON-UGE0109            TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF
      *
           IF NOT SW-TIPO-PAGO-PRORATA
              IF MAE-INDLIQES = 'S'
                 PERFORM 2347-1-ACCESO-PORTES-GASADM-E
              ELSE
                 PERFORM 2347-2-ACCESO-PORTES-GASADM
              END-IF
           END-IF.

      ******************************************************************
      *                   2340-HALLAR-UVR                              *
      *  SI EL PRESTAMO ES DE UVR SE HARAN LAS CORRESPONDIENTES ACTUA- *
      *  LIZACIONES EN LAS DE UNIDADES DE VALOR REAL                   *
      ******************************************************************
       2340-HALLAR-UVR.
      * SI ES UN PRESTAMO MIGRADO GH Y CON UVR GARANTIZADA BUSCAMOS LA
      * COTIZACION DE LA UVR CON LA RUTINA UR9CSEC0
      *
           PERFORM 61C-SEGURO-COBERTURA
      *
           IF SEGURO-COBERTURA AND MAE-IND-MARCA9 = 'M'
                               AND UVR-WS-ONLINE
               PERFORM 61B-HALLAR-UVR-GARANTIZADA
           ELSE
               PERFORM UVR-INICIO
      *
               MOVE UVR-WS-SQLCODE            TO DB2-RETURN-CDE
      *
               IF UVR-WS-INDERROR = SPACES OR '000'
                  CONTINUE
               ELSE
                  IF UVR-WS-TABLAERR = 'UGDTT37' AND DB2-NOTFND
                     MOVE 'UGE3424'           TO C86A-RET-COD-ERROR
                     PERFORM 3-FINAL-PROGRAMA
                  ELSE
                     MOVE UVR-WS-SQLCODE      TO SQLCODE
                     MOVE UVR-WS-TABLAERR     TO C86A-RET-VAR1-ERROR
                     MOVE UVR-WS-VAR1-ALF     TO C86A-RET-VAR2-ERROR
                     PERFORM 999999-ABEND-DB2
                  END-IF
               END-IF
           END-IF.

      ******************************************************************
      *                   61B-HALLAR-UVR-GARANTIZADA
      *     CONSULTA Y CONVIERTE VALORES CON LA UVR-GARANTIZADA        *
      *----------------------------------------------------------------*
       61B-HALLAR-UVR-GARANTIZADA.

            MOVE MAE-ENTIOFI              TO SEC0-E-ENTIOFI
            MOVE MAE-CUENTA               TO SEC0-E-CUENTA
            MOVE C86A-FECHA-OPER          TO SEC0-E-FECONT2

            CALL BBVA-UR9CSEC0 USING UGWCSEC0-01

            EVALUATE SEC0-S-CODRET
               WHEN '00'
      *           VALOR DE LA UVR-GANTIZADA
                  MOVE SEC0-S-UVRTOTAL    TO UVR-WS-COTIZACION
                  MOVE SEC-S-UVRTOT       TO UVR-WS-TASA
      *           PASAR DE PESOS A UVRG
                  IF UVR-WS-UVR
                     COMPUTE UVR-WS-VALOR-UVR ROUNDED =
                       UVR-WS-VALOR-PESOS / SEC0-S-UVRTOTAL
                  END-IF
      *           PASAR DE UVRG  A PESOS
                  IF UVR-WS-PESOS
                      COMPUTE UVR-WS-VALOR-PESOS ROUNDED =
                              UVR-WS-VALOR-UVR * UVR-WS-COTIZACION
                  END-IF
      *          ERROR EN RUTINAS
               WHEN '20'
                  MOVE 'UGE0517'          TO C86A-RET-COD-ERROR
                  MOVE 'UR9CSEC0'         TO C86A-RET-VAR1-ERROR(1:8)
                  MOVE 'RET:'             TO C86A-RET-VAR1-ERROR(10:4)
                  MOVE  SEC0-S-CODRET     TO C86A-RET-VAR1-ERROR(14:2)
                  MOVE  'ERR '            TO C86A-RET-VAR1-ERROR(16:4)
                  MOVE  SEC0-S-VAR2       TO C86A-RET-VAR2-ERROR
                  PERFORM 3-FINAL-PROGRAMA
      *          DATOS NO VALIDOS
               WHEN '50'
                  MOVE 'UGE0517'          TO C86A-RET-COD-ERROR
                  MOVE 'UR9CSEC0'         TO C86A-RET-VAR1-ERROR(1:8)
                  MOVE 'COD-RET: '        TO C86A-RET-VAR1-ERROR(10:2)
                  MOVE  SEC0-S-CODRET     TO C86A-RET-VAR1-ERROR(13:2)
                  MOVE  'CODERR'          TO C86A-RET-VAR1-ERROR(15:6)
                  MOVE  SEC0-S-CODERR     TO C86A-RET-VAR2-ERROR(1:8)
                  MOVE  SEC0-S-VAR1(1:11) TO C86A-RET-VAR2-ERROR(10:11)
                  PERFORM 3-FINAL-PROGRAMA
      *          ERROR DB2
               WHEN '99'
