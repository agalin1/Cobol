      ******************************************************************
      *                    2433-ACTUALIZAR-HCA.                        *
      *    SE ACTUALIZA EL CONTRATO EN LA TABLA UGDTHCA, DEJANDO       *
      *    LOS MOVIMIENTOS(EL ULTIMO REGISTRO INGRESADO EN LA TABLA)   *
      *    POR CANCELACION COMO RETROCEDIDOS.                          *
      ******************************************************************
       2323-ACTUALIZAR-HCA.
      *
           MOVE MAE-ENTIOFI                 TO UHCA-ENTIOFI
           MOVE MAE-CUENTA                  TO UHCA-CUENTA

           PERFORM 2323A-BUSCAR-SECUMOV-HCA

           MOVE CTE-CON-S                 TO UHCA-IND-RETRO
           MOVE CAA-NETNAME-CONT          TO UHCA-NETNAME-UMO
           MOVE CAA-USERID                TO UHCA-USERID-UMO
           MOVE CAA-ENTIDAD               TO UHCA-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT           TO UHCA-CENTRO-UMO

           EXEC SQL UPDATE
             UGDTHCA  SET
               IND_RETRO   = :UHCA-IND-RETRO    ,
               NETNAME_UMO = :UHCA-NETNAME-UMO  ,
               USERID_UMO  = :UHCA-USERID-UMO   ,
               ENTIDAD_UMO = :UHCA-ENTIDAD-UMO  ,
               CENTRO_UMO  = :UHCA-CENTRO-UMO ,
               SECUMOV     =  CURRENT_TIMESTAMP
             WHERE
               ENTIOFI = :UHCA-ENTIOFI     AND
               CUENTA  = :UHCA-CUENTA      AND
               SECUMOV = :UHCA-SECUMOV
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF  NOT DB2-OK  OR SQLWARN0 NOT = SPACES
                   MOVE 'UPDATE UGDTHCA'     TO WS-REFERENCIA
                   MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                2433A-BUSCAR-SECUMOV-HCA                        *
      *----------------------------------------------------------------*
      *      BUSQUEDA DEL MAXIMO SECUMOV DE LA TABLA HCA               *
      *      Y HACI PODER RETROCEDER EL REGISTRO CORRECTO              *
      ******************************************************************
       2323A-BUSCAR-SECUMOV-HCA.

            EXEC SQL
              SELECT MAX(SECUMOV)
              INTO :UHCA-SECUMOV
              FROM UGDTHCA
              WHERE ENTIOFI = :UHCA-ENTIOFI  AND
                    CUENTA  = :UHCA-CUENTA
            END-EXEC.
      *
            MOVE SQLCODE                     TO DB2-RETURN-CDE
      *
            IF DB2-OK
                CONTINUE
            ELSE
                MOVE ZEROS                   TO LOG-CONSOPE
                MOVE 'UGE0939'               TO C86A-RET-COD-ERROR
                MOVE 'SELECT MAX UGDTHCA  '  TO C86A-RET-VAR1-ERROR
                PERFORM 999999-ROLLBACK
                PERFORM 3-FINAL-PROGRAMA
            END-IF.
