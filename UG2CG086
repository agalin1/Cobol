           MOVE  C86A-ENTIDAD-CONT            TO MOV-ENTIDAD-UMO
           MOVE  C86A-CENTRO-CONT             TO MOV-CENTRO-UMO
 DPRC      MOVE 'UG2CG083'                    TO MOV-USERID-UMO
           MOVE  WC-PROGRAMA                  TO MOV-NETNAME-UMO
           IF C86A-USUARIO = CTE-PROG-TC0
              MOVE WC-PROGRAMA-T0             TO MOV-NETNAME-UMO
           END-IF
           MOVE  MAE-MONEDA                   TO MOV-MONEDA
           MOVE SPACES                        TO MOV-CLADIS
           MOVE 'J3'                          TO MOV-CLACON
           MOVE  SW-TIPO-PAGO                 TO MOV-IND-MARCA1
           MOVE  SPACES                       TO MOV-RUTA
           MOVE  WS-MES-IMPORTE               TO MOV-IMPMOVI
      *
      ***** INCLUSION DE VARIABLES PARA PODER REALIZAR LA ANULACION*****
      ***** DE LA TRANSACCION EN LA RUTINA UR7CCLS0                *****
           MOVE CLS-WS-PERSPROP               TO MOV-LIBRE-IMP1
           MOVE CLS-WS-PERSRETO               TO MOV-LIBRE-IMP2
      *
           IF MAE-LIBRE-CAR6 = 'UVR' OR 'UVRBO'
              COMPUTE MOV-LIBRE-IMP3 ROUNDED =
                      UVR-WS-COTIZACION      *   10000
              END-COMPUTE
           ELSE
              MOVE 0                          TO MOV-LIBRE-IMP3
           END-IF
      *
           PERFORM  272-INSERT-TBL-MVTOS-PT

           MOVE 0                             TO MOV-LIBRE-IMP1
           MOVE 0                             TO MOV-LIBRE-IMP2

           IF WS-INTERESES > ZERO
              MOVE  'AI'                      TO MOV-CLACON
              MOVE  WS-INTERESES              TO MOV-IMPMOVI
      *
      ***** INCLUSION DE VARIABLES PARA PODER REALIZAR LA ANULACION*****
      ***** DE LA TRANSACCION EN LA RUTINA UR7CCLS0                *****
              MOVE CLS-WS-INT-CTES            TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2

              PERFORM  272-INSERT-TBL-MVTOS-PT

              MOVE 0                          TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2
           END-IF
      *
      ***** MANEJO DE INTERESES ANTICIPADOS                        *****
           IF WS-INTERESES-ANTI > ZERO
              MOVE  'AI'                      TO MOV-CLACON
              COMPUTE MOV-IMPMOVI  = WS-INTERESES * (-1)
              END-COMPUTE
              MOVE CLS-WS-INT-ANT-CLTE        TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2

              PERFORM  272-INSERT-TBL-MVTOS-PT

              MOVE 0                          TO MOV-LIBRE-IMP1
              MOVE 0                          TO MOV-LIBRE-IMP2
           END-IF.

      ******************************************************************
