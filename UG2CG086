              PERFORM 226-CONSULTAR-DEUDA

              IF C86A-IMPORTE-PAGO  >= (G703-CAPITAL-NOVENC +
                                        G703-INTCORR-NOVENC)

                 MOVE G703-INTCORR-NOVENC        TO WS-IN-EN
                                                    FIN-INTERES
                 COMPUTE WS-CAPITAL ROUNDED = C86A-IMPORTE-PAGO -
                                            WS-IN-EN - WS-VAL-COMISIONES

                 IF C86A-USUARIO = CTE-PRG-RECLAM-SEG
                    SET CCP-NO-COMISION    TO   TRUE
                 ELSE
                    SET SW-SI-SIMULAR-COMI          TO TRUE
                    PERFORM 24453-VALOR-COMISION

                    IF CCP-SI-COMISION
                       COMPUTE WS-VAL-COMISIONES ROUNDED =
                                      CCP-VALOR-COMISION + CCP-VALOR-IVA
                    END-IF

                    COMPUTE WS-CAPITAL ROUNDED = C86A-IMPORTE-PAGO -
                                            WS-IN-EN - WS-VAL-COMISIONES
                 END-IF

              ELSE
      *  DISTRIBUCION DE FORMA AUTOMATICA EN LOS INTERESES Y CAPITAL   *
      *  DE ACUERDO AL MONTO TOTAL A ABONAR                            *
      *    - SE REALIZA 5 VECES EL PROCESO DE DISTRIBUCION PARA        *
      *      APROXIMAR EL PAGO DE INTERESES Y CAPITAL                  *
      *
      *COL04B-I
      *COL04C   IF (SW-VIRTUAL-SI        AND MAE-INDDEUPE = 'N')
                IF SW-VIRTUAL-SI
                   MOVE ZEROS             TO  WS-IN-EN
                   MOVE ZEROS             TO  G703-INTCORR-NOVENC
                   MOVE ZEROS             TO  FIN-INTERES
                   SET CCP-NO-COMISION    TO   TRUE
                ELSE
      *COL04B-F
      *COL05-I
                 IF MAE-IND-MARCA4 = 'H' AND MAE-INDDEUPE = 'N'
                    MOVE ZEROS             TO  WS-IN-EN
                    MOVE ZEROS             TO  G703-INTCORR-NOVENC
                    MOVE ZEROS             TO  FIN-INTERES
                    SET CCP-NO-COMISION    TO   TRUE
                 ELSE
      *COL05-F
                    PERFORM VARYING I FROM 1 BY 1   UNTIL I > 5
      *COL04-INI
                    IF I = 1 AND SW-VIRTUAL-SI
                       PERFORM 24450-OBT-INT-CV
                       MOVE CSA-INT-ACUMULADO    TO FIN-INTERES
                    END-IF
      *             PERFORM 24452-LLAMADO-UR8CFIN0
                    IF SW-VIRTUAL-NO
                       PERFORM 24452-LLAMADO-UR8CFIN0
                    END-IF
      *COL04-FIN
                    MOVE FIN-INTERES                TO WS-IN-EN
      *EFR01-I
                   IF SW-SI-PUNICA
                      SET SI-DEV-INT-PUNI           TO TRUE
                      PERFORM 24452-LLAMADO-UR8CFIN0
                      MOVE FIN-INTERES              TO WS-INT-DEV-PU
                      MOVE WS-INT-DEV-PU            TO WS-IN-EN-PU
                      SET NO-DEV-INT-PUNI           TO TRUE
                   END-IF
      *EFR01-F
      *COL04B-I
                    MOVE WS-CAPITAL  TO WS-CAP-ANTER
      *COL04B-F
                    COMPUTE  WS-CAPITAL ROUNDED = C86A-IMPORTE-PAGO -
                                            WS-IN-EN - WS-VAL-COMISIONES

                    IF C86A-USUARIO = CTE-PRG-RECLAM-SEG
                       SET CCP-NO-COMISION    TO   TRUE
                    ELSE
                       SET SW-SI-SIMULAR-COMI          TO TRUE
                       PERFORM 24453-VALOR-COMISION

                       IF CCP-SI-COMISION
                          COMPUTE WS-VAL-COMISIONES ROUNDED =
                                      CCP-VALOR-COMISION + CCP-VALOR-IVA
                       END-IF

                       COMPUTE WS-CAPITAL ROUNDED = C86A-IMPORTE-PAGO -
                                            WS-IN-EN - WS-VAL-COMISIONES
                    END-IF

                    END-PERFORM
      *COL05-I
                 END-IF
      *COL05-F
      *COL04-I
                END-IF
      *COL04-F

              END-IF
      *EFR01-I
              IF SW-SI-PUNICA
                 COMPUTE WS-CAPITAL = WS-CAPITAL + WS-IN-EN-PU
                 MOVE WS-CAPITAL       TO FIN-CAPITAL
                 COMPUTE FIN-INTERES = WS-IN-EN - FIN-INTERES
                 MOVE FIN-INTERES      TO WS-IN-EN
              END-IF
      *EFR01-F

              COMPUTE WS-IMPORTE-UR8 = WS-CAPITAL + FIN-INTERES +
                                       WS-VAL-COMISIONES
      *
              IF WS-IMPORTE-UR8 NOT = C86A-IMPORTE-PAGO
                 COMPUTE WS-DIF  = C86A-IMPORTE-PAGO - WS-IMPORTE-UR8
                 COMPUTE FIN-INTERES = FIN-INTERES + WS-DIF
                 COMPUTE WS-IN-EN ROUNDED = FIN-INTERES
      *EFR01-I
                 IF SW-SI-PUNICA
                    COMPUTE  WS-IN-EN-PU   ROUNDED = FIN-INTERES
                 END-IF
      *EFR01-F
              END-IF

              IF SW-TIPO-PAGO-PRORATA AND
                 MAE-FEULIQ > WS-DB2-FEVALOR
                 MOVE ZEROS               TO WS-IN-EN
                                             FIN-INTERES
              END-IF


           IF C86A-E-LIBRE-CAR2(1:1) = 'S'
              ADD    WS-INTERES-AI        TO FIN-INTERES
              ADD    WS-INTERES-AI        TO WS-IN-EN

              COMPUTE C86A-IMPORTE-PAGO = C86A-IMPORTE-PAGO +
                                           WS-INTERES-AI
           END-IF

      * VALIDACIONES SOBRE LOS VALORES CALCULADOS                      *
           PERFORM 24454-VALIDAR-CALCULOS
      * CARGA EL VALOR CALCULADO DE CAPITAL
           MOVE WS-CAPITAL                TO WG07-CAPITAL.

      *COL04-INI
      *****************************************************************
      * OBTENER LOS INTERESES ACUMULABRES DESDE LA TABLA UGDTCSA      *
      *****************************************************************
       24450-OBT-INT-CV.
           INITIALIZE UGVCCSA0
           MOVE MAE-ENTIOFI           TO CSA-ENTIOFI
           MOVE MAE-CUENTA            TO CSA-CUENTA
           PERFORM 24450-OPEN-CURCSA

           EXEC SQL
               FETCH CURCSA
               INTO  :CSA-INT-ACUMULADO
           END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE
           IF DB2-OK
              CONTINUE
           ELSE
              IF DB2-NOTFND
                 MOVE ZEROES           TO CSA-INT-ACUMULADO
              ELSE
                 MOVE 'UGDTCSA'               TO C86A-RET-VAR1-ERROR
                 MOVE 'FETCH CURCSA '         TO C86A-RET-VAR2-ERROR
                 PERFORM  999999-ABEND-DB2
              END-IF
           END-IF

           PERFORM 24450-CLOSE-CURCSA.

       24450-OPEN-CURCSA.
           INITIALIZE UGVCCSA0
           MOVE MAE-ENTIOFI     TO CSA-ENTIOFI
           MOVE MAE-CUENTA      TO CSA-CUENTA
      *
           EXEC SQL
               OPEN CURCSA
           END-EXEC
      *
           MOVE SQLCODE         TO DB2-RETURN-CDE
      *
           IF DB2-OK
              CONTINUE
           ELSE
              MOVE 'UGDTCSA'               TO C86A-RET-VAR1-ERROR
              MOVE 'OPEN CURCSA '          TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
           END-IF.

       24450-CLOSE-CURCSA.
      *
           EXEC SQL
              CLOSE CURCSA
           END-EXEC
      *
           MOVE SQLCODE         TO DB2-RETURN-CDE
      *
           IF DB2-OK
              CONTINUE
           ELSE
              MOVE 'UGDTCSA'               TO C86A-RET-VAR1-ERROR
              MOVE 'CLOSE CURCSA '         TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
           END-IF.
      *COL04-FIN

      ******************************************************************
      *              24451-LLAMAR-TC8C1220                             *
      *             LLAMADA A LA RUTINA TC8C1220                       *
      *          (CALCULO DE DIAS ENTRE FECHAS -NATURALES-)            *
      ******************************************************************
       24451-LLAMAR-TC8C1220.
      *
           MOVE  ZEROS                        TO W175-NUMDIAS
           MOVE CTE-CON-3                     TO W175-CDOPCIO
      *
      *    SE CALCULAN LOS DIAS COMO COMERCIALES PARA LOS INTERESES    *
      *    CORRIENTES                                                  *
           IF WS-DIASCAL-DIAS = 'N' OR 'X'
      *COL01-I
      *@COL11-I
      *       OR WS-CODTIPRE(1:2) = 'IB'
      *COL01-F
              OR WS-CODTIPRE(1:2) EQUAL CTE-IB OR CTE-IP
      *@COL11-F
      *COL01-F
              MOVE 'NA'                       TO W175-TPTRAT
           ELSE
              MOVE CTE-CON-CO                 TO W175-TPTRAT
           END-IF
      *
           CALL BBVA-TC8C1220
                              USING  TCWC1750

           IF ( W175-CDRETORN NOT = CTE-CON-ALFA-00 )
              MOVE 'UGE0517'                  TO C86A-RET-COD-ERROR
              MOVE 'TC8C1220'                 TO C86A-RET-VAR1-ERROR
              MOVE W175-CDRETORN              TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
           MOVE W175-NUMDIAS                  TO WS-DIAS.

      ******************************************************************
      *           24452-LLAMADO-UR8CFIN0                               *
      *  - SE LLAMA A LA RUTINA DE CALCULO DE INTERES                  *
      ******************************************************************
       24452-LLAMADO-UR8CFIN0.
      *
           INITIALIZE URWCFIN
           MOVE IEN-NOMINAL                   TO FIN-TIPINT
           MOVE 'N'                           TO FIN-TIPOTASA
           MOVE IEN-PERCAPIT                  TO FIN-PERCAPIT
           MOVE IEN-PERINT                    TO FIN-PERINT
           MOVE IEN-DIASCAL                   TO FIN-DIASCAL
           MOVE WS-CAPITAL                    TO FIN-CAPITAL
      *EFR01-I
           IF SI-DEV-INT-PUNI
              MOVE WS-CAPITAL-PU              TO FIN-CAPITAL
           END-IF

           IF SI-CALCULO-DEVOL
              MOVE WS-CAPITAL-SPUNICA         TO FIN-CAPITAL
              SET NO-CALCULO-DEVOL            TO TRUE
           END-IF
      *EFR01-F
           MOVE WS-DIAS                       TO FIN-PERIODO-NUM
           IF WS-DIAS < 1000
              MOVE CTE-ALFA-1                 TO FIN-PERIODO-TIP
           ELSE
              IF WS-DIAS > 999 AND < 2000
                 MOVE CTE-ALFA-6              TO FIN-PERIODO-TIP
              END-IF
              IF WS-DIAS > 1999 AND < 3000
                 MOVE CTE-ALFA-7              TO FIN-PERIODO-TIP
              END-IF
              IF WS-DIAS > 2999 AND < 4000
                 MOVE CTE-ALFA-8              TO FIN-PERIODO-TIP
              END-IF
           END-IF
      *COL01-I
           MOVE WS-CODTIPRE                TO FIN-CDRETORNO
           MOVE WS-CODTIAMO                TO FIN-MODULRES
           MOVE MAE-FEULIQ(1:4)            TO FIN-MODULRES(2:4)
      *COL01-F
           CALL BBVA-UR8CFIN0 USING URWCFIN
      *
           EVALUATE    FIN-CDRETORNO
              WHEN '00'
                 CONTINUE
              WHEN '10'
                 MOVE 'UGE2000'               TO C86A-RET-COD-ERROR
                 MOVE 'UR8CFIN0'              TO C86A-RET-VAR1-ERROR
                 MOVE FIN-CDRETORNO           TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              WHEN OTHER
                 MOVE 'UGE0517'               TO C86A-RET-COD-ERROR
                 MOVE 'UR8CFIN0'              TO C86A-RET-VAR1-ERROR
                 MOVE FIN-CDRETORNO           TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.

      ******************************************************************
      *              24453-VALOR-COMISION                              *
      *    SE CALCULAN LAS COMISIONES          PARA LLEGAR AL IMPORTE  *
      *    NETO QUE SE APLICA PARA AMORTIZAR                           *
      *                                                                *
      ******************************************************************
       24453-VALOR-COMISION.
      *
           INITIALIZE URWCCCP0
           MOVE MAE-ENTIOFI                 TO CCP-ENTIOFI
           MOVE MAE-CUENTA                  TO CCP-CUENTA
           MOVE WS-DB2-FEVALOR              TO CCP-FECHA-OPER
           MOVE MAE-ENTIOFI(1:4)            TO CCP-ENTIDAD
           MOVE MAE-ENTIOFI(5:4)            TO CCP-CENTRO-CONT
           MOVE ZEROS                       TO CCP-NUMERO-MOV
           MOVE 'PA'                        TO CCP-CODFUN
           MOVE WC-PROGRAMA                 TO CCP-USERID
           MOVE WC-PROGRAMA                 TO CCP-NETNAME
      *
           IF SW-SI-SIMULAR-COMI
              SET CCP-OPCION-CONS           TO TRUE
              MOVE WS-CAPITAL               TO CCP-LIBRE-IMP1-ENT
           ELSE
              SET CCP-OPCION-PAGO           TO TRUE
              MOVE WG07-CAPITAL             TO CCP-LIBRE-IMP1-ENT
           END-IF
      *
           MOVE SPACES                      TO CCP-CODIDENT
                                               CCP-CLAIDENT
                                               CCP-DIGIDENT
      *
           CALL BBVA-UR9CCCP0
                              USING URWCCCP0-01
      *
           EVALUATE CCP-CORESPUE
              WHEN '00'
                 CONTINUE
              WHEN '10'
              WHEN '50'
                 MOVE CCP-CODIGO-ERROR       TO C86A-RET-COD-ERROR
                 MOVE 'UR8CFIN0'             TO C86A-RET-VAR1-ERROR
                 MOVE CCP-VAR1-ERROR         TO C86A-RET-VAR1-ERROR(10:)
                 MOVE CCP-VAR2-ERROR         TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              WHEN '99'
                 MOVE CCP-VAR1-ERROR         TO C86A-RET-VAR1-ERROR
                 MOVE CCP-VAR2-ERROR         TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              WHEN OTHER
                 MOVE 'UGE0517'               TO C86A-RET-COD-ERROR
                 MOVE CCP-VAR1-ERROR          TO C86A-RET-VAR1-ERROR
                 MOVE CCP-VAR2-ERROR          TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
            END-EVALUATE.

      ******************************************************************
      *              24454-VALIDAR-CALCULOS                            *
      *   SE VALIDARAN QUE LOS DATOS CALCULADOS SEAN IGUALES A LOS     *
      *   INTRODUCIDOS POR EL USUARIO                                  *
      ******************************************************************
       24454-VALIDAR-CALCULOS.
      *
      *  EL VALOR DE LOS INTERESES NO PUEDE SER MAYOR QUE EL IMPORTE   *
      *  TOTAL A PAGAR                                                 *
           MOVE WS-IN-EN                      TO DS-INTERES-CUOTA
      *
           IF WS-IN-EN > C86A-IMPORTE-PAGO
                 MOVE 'UGE2095'               TO C86A-RET-COD-ERROR
                 MOVE DS-INTERES-CUOTA        TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
      *  VALIDAR QUE EL VALOR A ABONAR DE CAPITAL INTRODUCIDO POR EL   *
      *  USUARIO SEA IGUAL AL CALCULADO                                *
           MOVE WS-CAPITAL                    TO DS-INTERES-CUOTA
           MOVE 'N'                           TO WS-ERROR-CAPABO.

      ******************************************************************
      *             245-CALC-TOTAL-CARGAR                              *
      *    SE CALCULAN LAS COMISIONES Y GASTOS PARA LLEGAR AL IMPORTE  *
      *    NETO QUE SE APLICA PARA AMORTIZAR, ASI COMO EL IMPORTE DE   *
      *    SUBVENCION, SI PROCEDE                                      *
      ******************************************************************
       245-CALC-TOTAL-CARGAR.
      *
           IF WS-INDSUBME = CTE-CON-SU OR CTE-CON-ME
              MOVE ZERO                       TO WS-INTERESES-SUB-MED
              MOVE CTE-CON-N                  TO WS-INDSUBVE
                                                 WS-INDMEDIA
              MOVE SPACE                      TO WS-TIPOSUB
           END-IF
      *
           IF WS-INDINANT NOT = 'A' AND WS-INDINANT NOT = 'P'
              PERFORM 2451-CALC-TOT-INTVEN
           ELSE
              PERFORM 2452-CALC-TOT-INTANT
           END-IF.

      ******************************************************************
      *             2451-CALC-TOT-INTVEN                               *
      *    SE CALCULAN LAS COMISIONES Y GASTOS PARA LLEGAR AL IMPORTE  *
      *    NETO QUE SE APLICA PARA AMORTIZAR, ASI COMO EL IMPORTE DE   *
      *    SUBVENCION, SI PROCEDE. CUANDO EL PRESTAMO ES CON INTERESES *
      *    VENCIDOS                                                    *
      ******************************************************************
       2451-CALC-TOT-INTVEN.
      *
           MOVE WS-IN-EN                      TO WS-MES-INTERESE
      *@COL07-INI
           IF SI-GRACIA
              IF C86A-FECHA-OPER EQUAL MAE-FEFORMA
                  MOVE CTE-UGE0939              TO C86A-RET-COD-ERROR
                  MOVE CTE-LIBRANZA-NO-PERMITE  TO C86A-RET-VAR1-ERROR
                  MOVE CTE-PAGO-EN-DIA-DE-DESEM TO C86A-RET-VAR2-ERROR
                  PERFORM 999999-ROLLBACK
                  PERFORM 3-FINAL-PROGRAMA
              END-IF
              MOVE C86A-IMPORTE-PAGO            TO WS-CAPITAL
                                                   WG07-CAPITAL
              PERFORM 211-CALCULA-DEVOLUCION
              MOVE WS-INT-DEV-COR               TO WS-MES-INTERESE
              COMPUTE WS-MES-INTERESE = WS-MES-INTERESE * CTN--1
              MOVE WS-MES-INTERESE              TO WS-IN-EN
           END-IF
      *@COL07-FIN
      *
           MOVE WG07-CAPITAL                  TO WS-MES-IMPORTE
      *
      *@COL07-INI
           IF SI-GRACIA
              ADD WS-INT-DEV-COR              TO WS-MES-IMPORTE
           END-IF
      *@COL07-FIN
      *COL12-I
              ADD WS-VAL-INT-ALIV             TO WS-MES-INTERESE
      *COL12-F
           PERFORM  24521-CALC-COMISION-GASTOS
      *
           COMPUTE  WS-AUX ROUNDED =
                    ( WS-MES-IMPORTE    + WS-MES-INTERESE ) +
                    ( WS-MES-COMISION   + WS-MES-GASTOS   )
                    + WS-MES-IVA
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-COMPUTE
      *
           MOVE  WS-AUX                       TO C86A-TOTAL
                                                 WS-MES-TOTAL.

      *@COL07-INI
      ******************************************************************
      *                       213-BUSCA-DLIC                           *
      *----------------------------------------------------------------*
      * BUSCA SI EXISTE REGISTRO DLIC DE INT Y SEG COBRADOS ANTICIPADOS*
      ******************************************************************
       213-BUSCA-DLIC.
           MOVE MAE-ENTIOFI             TO LOG-ENTIOFI
           MOVE MAE-CUENTA              TO LOG-CUENTA
           MOVE 'DLIC'                  TO LOG-CODIGO

           EXEC SQL
             SELECT LOG_IMPANT,
                    LOG_IMPNUE
             INTO :LOG-IMPANT,
                  :LOG-IMPNUE
             FROM UGDTLOG
             WHERE LOG_ENTIOFI = :LOG-ENTIOFI  AND
                   LOG_CUENTA  = :LOG-CUENTA   AND
                   LOG_CODIGO  = :LOG-CODIGO
           END-EXEC

           MOVE SQLCODE                     TO DB2-RETURN-CDE

           IF DB2-OK
              IF LOG-IMPANT > ZEROS OR LOG-IMPNUE > ZEROS
                 SET SI-GRACIA              TO TRUE
              ELSE
                 SET NO-GRACIA              TO TRUE
              END-IF
           ELSE
              IF (DB2-NOTFND AND SQLWARN0 = SPACES)
                 SET NO-GRACIA              TO TRUE
              ELSE
                 MOVE 'UGE0939'             TO C86A-RET-COD-ERROR
                 MOVE 'SELECT UGDTLOG -6'   TO C86A-RET-VAR1-ERROR
                 MOVE  SQLCODE              TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *                   211-CALCULA-DEVOLUCION                       *
      ******************************************************************
       211-CALCULA-DEVOLUCION.
      *
           MOVE C86A-FECHA-OPER   TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA          TO WS-AUX-AAAA
           MOVE AUX-MM            TO WS-AUX-MM
           MOVE AUX-DD            TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA TO W175-FHGRE1
      *
           MOVE MAE-FEULIQ        TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA          TO WS-AUX-AAAA
           MOVE AUX-MM            TO WS-AUX-MM
           MOVE AUX-DD            TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA TO W175-FHGRE2
      *
           IF SI-VAL-PPC
              PERFORM 26411-CALCULAR-MES
              MOVE WS-FEULIQ                  TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE2
           END-IF

           PERFORM 24451-LLAMAR-TC8C1220
      *EFR01-I
           IF SW-SI-PUNICA
              SET SI-CALCULO-DEVOL                  TO TRUE
              COMPUTE WS-CAPITAL-SPUNICA = WS-CAPITAL - VLR-K-PU
           END-IF
      *EFR01-F
           PERFORM 24452-LLAMADO-UR8CFIN0
      *
           MOVE FIN-INTERES       TO WS-INT-DEV-COR.

      *----------------------------------------------------------------*
      *                    26411-CALCULAR-MES                          *
      *----------------------------------------------------------------*
       26411-CALCULAR-MES.
      *
           INITIALIZE TCWC1750
           MOVE ZEROS                         TO W175-NUMDIAS
           MOVE MAE-FEULIQ(1:4)               TO W175-FHGRE1(5:4)
           MOVE MAE-FEULIQ(6:2)               TO W175-FHGRE1(3:2)
           MOVE MAE-FEULIQ(9:2)               TO W175-FHGRE1(1:2)
           MOVE -30                           TO W175-FACTOR
           MOVE '2'                           TO W175-CDOPCIO
           MOVE 'CO'                          TO W175-TPTRAT

           CALL BBVA-TC8C1220 USING TCWC1750
      *
           IF (W175-CDRETORN NOT = '00')
              MOVE 'UGE0517'               TO CAA-COD-ERROR
              MOVE 'TC8C1220'              TO CAA-VAR1-ERROR
              MOVE W175-CDRETORN           TO CAA-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
           MOVE W175-FHGREG(1:2)         TO WS-FEULIQ(9:2)
           MOVE W175-FHGREG(3:2)         TO WS-FEULIQ(6:2)
           MOVE W175-FHGREG(5:4)         TO WS-FEULIQ(1:4)
           MOVE '-'                      TO WS-FEULIQ(5:1)
                                            WS-FEULIQ(8:1).


      *
      ******************************************************************
      *                        212-GUARDA-PCOR                         *
      ******************************************************************
       212-GUARDA-PCOR.
      *
           INITIALIZE UGTCLOG
           PERFORM 23192-BUSCA-CONSEC
      *
           MOVE MAE-ENTIOFI              TO LOG-ENTIOFI
           MOVE MAE-CUENTA               TO LOG-CUENTA
           MOVE CTE-PCOR                 TO LOG-CODIGO
           ADD  CTN-1                    TO LOG-CONSOPE
           MOVE CTE-FECHA-MIN            TO LOG-FECANT
           MOVE CTE-FECHA-MIN            TO LOG-FECNUE
           MOVE WS-DB2-HOY               TO LOG-FECMOV
           MOVE CTE-UGDTLOG              TO LOG-TABLA
           MOVE WS-CAPITAL               TO LOG-IMPNUE
           MOVE WS-INT-DEV-COR           TO LOG-IMPANT
           MOVE SPACES                   TO LOG-COLUMNA
           MOVE CTE-PAK-LIB-CORR         TO LOG-DESCRIPCION
           MOVE C86A-ENTIDAD-CONT        TO LOG-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT         TO LOG-CENTRO-UMO
           MOVE C86A-USUARIO             TO LOG-USERID-UMO
           MOVE WC-PROGRAMA              TO LOG-NETNAME-UMO
      *
           PERFORM 2391-INSERTAR-LOG.
      *
      ******************************************************************
      *                        213-ACTUALIZA-DLIC                      *
      *----------------------------------------------------------------*
      * ACTUALIZA DATOS DE CORRIMIENTO.                                *
      ******************************************************************
       213-ACTUALIZA-DLIC.
           MOVE MAE-ENTIOFI             TO LOG-ENTIOFI
           MOVE MAE-CUENTA              TO LOG-CUENTA
           MOVE 'DLIC'                  TO LOG-CODIGO
           EXEC SQL
             SELECT LOG_IMPANT,
                    LOG_IMPNUE
             INTO :LOG-IMPANT,
                  :LOG-IMPNUE
             FROM UGDTLOG
             WHERE LOG_ENTIOFI = :LOG-ENTIOFI  AND
                   LOG_CUENTA  = :LOG-CUENTA   AND
                   LOG_CODIGO  = :LOG-CODIGO
           END-EXEC
           MOVE SQLCODE                     TO DB2-RETURN-CDE
           IF DB2-OK
              IF LOG-IMPANT > ZEROS
                 SUBTRACT WS-INT-DEV-COR FROM LOG-IMPANT
                    GIVING LOG-IMPANT
                 EXEC SQL
                    UPDATE UGDTLOG
                    SET LOG_IMPANT      = :LOG-IMPANT,
                        LOG_NETNAME_UMO = :LOG-NETNAME-UMO,
                        LOG_TIMESTAMP   = CURRENT TIMESTAMP
                    WHERE LOG_ENTIOFI = :LOG-ENTIOFI
                      AND LOG_CUENTA  = :LOG-CUENTA
                      AND LOG_CODIGO  = :LOG-CODIGO
                 END-EXEC
                 MOVE SQLCODE                    TO DB2-RETURN-CDE
                 IF DB2-OK OR DB2-NOTFND
                    CONTINUE
                 ELSE
                    MOVE 'UGE0939'             TO C86A-RET-COD-ERROR
                    MOVE 'SELECT UGDTLOG -7'   TO C86A-RET-VAR1-ERROR
                    MOVE  SQLCODE              TO C86A-RET-VAR2-ERROR
                    PERFORM 999999-ABEND-DB2
                 END-IF
              END-IF
           ELSE
              IF (DB2-NOTFND AND SQLWARN0 = SPACES)
                 CONTINUE
              ELSE
                 MOVE 'UGE0939'             TO C86A-RET-COD-ERROR
                 MOVE 'SELECT UGDTLOG -6'   TO C86A-RET-VAR1-ERROR
                 MOVE  SQLCODE              TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *@COL07-FIN
      ******************************************************************
      *                 2451A-INTERESES-AI                             *
      *    SE CALCULAN LOS INTERESES CORRESPONDIENTES A LAS PRORRATAS  *
      *    CONSTRUCTOR EFECTUADAS                                      *
      ******************************************************************
       2451A-INTERESES-AI.

           MOVE MAE-ENTIOFI                   TO MOV-ENTIOFI
           MOVE MAE-CUENTA                    TO MOV-CUENTA
           MOVE MAE-FEULIQ                    TO WS-REC-FEULIQ
           MOVE MAE-FEPROLIQ                  TO WS-REC-FEPROLIQ

           EXEC SQL
               SELECT  SUM(IMPMOVI)
               INTO  :WS-MOV-IMPMOVI :WS-IND-SUM
               FROM UGDTMOV
               WHERE ENTIOFI  = :MOV-ENTIOFI  AND
                 CUENTA   = :MOV-CUENTA       AND
                 CLACON   = 'AI'              AND
                 FEOPER  >= :WS-REC-FEULIQ    AND
                 FEOPER  <= :WS-REC-FEPROLIQ  AND
                 INDRETRO = 'N'
           END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              IF WS-IND-SUM LESS THAN ZERO
                 MOVE ZEROS                   TO WS-MOV-IMPMOVI
              END-IF
           ELSE
              MOVE 'UGDTMOV'                  TO C86A-RET-VAR1-ERROR
              MOVE '-INTERESES-AI'            TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *                 2451B-SI-COBRO-AI                              *
      *    SE VALIDA EN LA TABLA UGDTLOG CONCEPTO 'PAAI' SI LOS        *
      *    INTERESES YA HAN SIDO COBRADOS                              *
      ******************************************************************
       2451B-SI-COBRO-AI.

           INITIALIZE UGTCLOG
           SET  NO-INTERES-AI                 TO TRUE
           MOVE MAE-ENTIOFI                   TO LOG-ENTIOFI
           MOVE MAE-CUENTA                    TO LOG-CUENTA
           MOVE CON-PAAI                      TO LOG-CODIGO

           EXEC SQL
               SELECT  LOG_CONSOPE,
                       LOG_FECMOV,
                       LOG_IMPNUE
               INTO    :LOG-CONSOPE,
                       :LOG-FECMOV,
                       :LOG-IMPNUE
               FROM UGDTLOG
               WHERE LOG_ENTIOFI  = :LOG-ENTIOFI      AND
                     LOG_CUENTA   = :LOG-CUENTA       AND
                     LOG_CODIGO   = :LOG-CODIGO
           END-EXEC

           MOVE SQLCODE                TO DB2-RETURN-CDE

           IF DB2-OK
              SET SI-INTERES-AI                TO TRUE
           ELSE
              IF DB2-NOTFND
                 SET NO-INTERES-AI            TO TRUE
              ELSE
                 MOVE 'UGDTLOG'               TO C86A-RET-VAR1-ERROR
                 MOVE 'CONSULTA-PAAI'         TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *               24521-CALC-COMISION-GASTOS                       *
      *    SE CALCULAN LAS COMISIONES Y GASTOS QUE SE CARGAN POR       *
      *    LA ENTREGA ANTICIPADA                                       *
      ******************************************************************
       24521-CALC-COMISION-GASTOS.
      *
           IF CCP-SI-COMISION
              MOVE CCP-VALOR-COMISION         TO WS-MES-COMISION
              MOVE CCP-VALOR-IVA              TO WS-MES-IVA
           ELSE
              MOVE ZEROS                      TO WS-MES-COMISION
                                                 WS-MES-IVA
           END-IF.

      ******************************************************************
      *             2452-CALC-TOT-INTANT                               *
      *    SE CALCULAN LAS COMISIONES Y GASTOS PARA LLEGAR AL IMPORTE  *
      *    NETO QUE SE APLICA PARA AMORTIZAR, ASI COMO EL IMPORTE DE   *
      *    SUBVENCION, SI PROCEDE. CUANDO EL PRESTAMO ES CON INTERESES *
      *    ANTICIPADOS                                                 *
      ******************************************************************
       2452-CALC-TOT-INTANT.
      *
           MOVE WS-IN-EN                     TO WS-MES-INTERESE-ANTI
           MOVE WG07-CAPITAL                 TO WS-MES-IMPORTE
      *
      *    CUANDO SON INTERESES ANTICIPADOS LO QUE LE DEBERIAMOS       *
      *    COBRAR DE INTERESES EL YA LOS HA PAGADO Y DEBEMOS DEVOLVER- *
      *    SELOS                                                       *
           COMPUTE WS-MES-IMPORTE ROUNDED = WG07-CAPITAL

                     ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-COMPUTE
      *
           MOVE  ZERO                        TO WS-IN-EN
           MOVE  ZERO                        TO WS-MES-INTERESE
      *
           PERFORM  24521-CALC-COMISION-GASTOS
      *
           COMPUTE  WS-AUX ROUNDED =
                    ( WS-MES-IMPORTE    + WS-MES-INTERESE ) +
                    ( WS-MES-COMISION   + WS-MES-GASTOS   ) -
                    ( WS-MES-INTERESE-ANTI )  +
                      WS-MES-IVA
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-COMPUTE
      *
           COMPUTE C86A-TOTAL ROUNDED = WS-AUX
           MOVE  WS-AUX                      TO WS-MES-TOTAL
      *
      *****  SE VALIDARA QUE LOS VALORES CALCULADOS SEAN IGUALES A *****
      *****  LOS VALORES INTRODUCIDOS
      *
      *COL12-I
              SUBTRACT WS-VAL-INT-ALIV      FROM WS-MES-TOTAL
      *COL12-F
           IF C86A-IMPORTE-PAGO NOT = WS-MES-TOTAL
                 MOVE 'UGE2058'              TO C86A-RET-COD-ERROR
                 MOVE C86A-TOTAL             TO WS-EDIT-VALOR
                 MOVE WS-EDIT-VALOR          TO C86A-RET-VAR1-ERROR
                 MOVE 'UGA0115'              TO WS-AVISO
                 MOVE 'TOTAL  '              TO WS-AVISO-VAR1
                 PERFORM 120-ENVIAR-AVISO
                 PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
           IF WG07-CAPITAL NOT = WS-MES-IMPORTE
                 MOVE 'UGE2058'              TO C86A-RET-COD-ERROR
                 MOVE WS-MES-IMPORTE         TO WS-EDIT-VALOR
                 MOVE WS-EDIT-VALOR          TO C86A-RET-VAR1-ERROR
                 MOVE 'UGA0115'              TO WS-AVISO
                 MOVE 'CAPITAL'              TO WS-AVISO-VAR1
                 PERFORM 120-ENVIAR-AVISO
                 PERFORM 3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *             247-CALC-CUOTAS-VENCIM                             *
      *    SE CALCULAN LAS FECHAS DE VENCIMIENTO Y CUOTAS QUE RESULTAN *
      *    DE LA ENTREGA ANTICIPADA                                    *
      *    EN CUANTO SE DE ALGUNA DE LAS SIGUIENTES CONDICIONES:       *
      *       - NO HAY CUOTA VIGENTE PARA LA FECHA VALOR DE LA ENTREGA *
      *         (INDICADOR 5 ACTIVADO)                                 *
      *       - LA CUOTA ES DE TIPO "CUOTA UNICA"                      *
      *       - EL CONTRATO TIENE SUBVENCION O MEDIACION               *
      *         (INDICADOR 9 ACTIVADO)                                 *
      ******************************************************************
       247-CALC-CUOTAS-VENCIM.
      *
           PERFORM 2471-VER-CARENCIA-PREVIA
           PERFORM 2472-MENOR-CUOTA
           PERFORM 2475-PRIMER-RECIBO
      *
           IF WS-IND-5            NOT =  CTE-CON-ALFA-1        AND
              COT-TIP-CUOTA       NOT =  CTE-CON-A             AND
              COT-TIP-CUOTA       NOT =  'J'                   AND
              COT-TIP-CUOTA       NOT =  'T'                   AND
              COT-TIP-CUOTA       NOT =  'W'                   AND
              WS-CODTIAMO         NOT =  CTE-CON-B             AND
              WS-IND-10           NOT =  CTE-CON-ALFA-1
      *
              PERFORM 2476-NUEVO-VENCIM
              PERFORM 2475-PRIMER-RECIBO
           END-IF.

      ******************************************************************
      *             2471-VER-CARENCIA-PREVIA                           *
      *    SE HALLA LA CUOTA QUE ESTABA VIGENTE ANTES DE LA ENTREGA    *
      *    ANTICIPADA PARA LA FECHA VALOR INTRODUCIDA. SI, DEBIDO A    *
      *    UNA CARENCIA GENERADA ANTERIORMENTE, NO SE ENCUENTRA CUOTA  *
      *    PREVIA EN LA FECHA VALOR, SE ACTIVA EL INDICADOR            *
      *    WS-IND-5
      ******************************************************************
       2471-VER-CARENCIA-PREVIA.
      *
           EXEC SQL
             SELECT
                    IMPMINI
             INTO
                    :CUO-IMPMINI
             FROM  UGDTCUO
             WHERE
                       ENTIOFI   =     :MAE-ENTIOFI      AND
                       CUENTA    =     :MAE-CUENTA       AND
                       FECOVALI  <=    :WS-DB2-FEVALOR   AND
                       FEFIVALI  >     :WS-DB2-FEVALOR
           END-EXEC
      *
           MOVE SQLCODE                           TO DB2-RETURN-CDE

           IF DB2-OK
              MOVE  CUO-IMPMINI                   TO WS-CUOTA-PREVIA
              MOVE  CTE-CON-ALFA-0                TO WS-IND-5
           ELSE
              IF DB2-NOTFND

                 IF MAE-FEULIQ = WS-DB2-FEVALOR

                    EXEC SQL
                       SELECT
                             IMPMINI
                       INTO
                             :CUO-IMPMINI
                       FROM  UGDTCUO
                       WHERE
                             ENTIOFI   =     :MAE-ENTIOFI      AND
                             CUENTA    =     :MAE-CUENTA       AND
                             FECOVALI  <=    :WS-DB2-FEVALOR   AND
                             FEFIVALI  =     :WS-DB2-FEVALOR
                    END-EXEC

                    MOVE SQLCODE                  TO DB2-RETURN-CDE

                    IF DB2-OK
                       MOVE  CUO-IMPMINI          TO WS-CUOTA-PREVIA
                       MOVE  CTE-CON-ALFA-0       TO WS-IND-5
                    ELSE
                       IF DB2-NOTFND
                          MOVE CTE-CON-ALFA-1          TO WS-IND-5
                       ELSE
                          MOVE 'UGDTCUO'          TO C86A-RET-VAR1-ERROR
                          MOVE 'SELECT UGDTCUO-2' TO C86A-RET-VAR2-ERROR
                          PERFORM 999999-ABEND-DB2
                       END-IF
                    END-IF
                 END-IF

              ELSE
                 MOVE 'UGDTCUO'                   TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTCUO'            TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *             2472-MENOR-CUOTA                                   *
      *    SE HALLA LA PRIMERA NUEVA CUOTA QUE RESULTA DE LA ENTREGA   *
      *    ANTICIPADA CUANDO SE MANTIENE EL VENCIMIENTO                *
      ******************************************************************
       2472-MENOR-CUOTA.
      *
           MOVE  MAE-FEVENCIN                 TO WS-DB2-AAAA-MM-DD
           PERFORM  24721-FECHA-DB2-A-FOR
           MOVE  WS-FOR-MM                    TO CTA-FECHA-AUX1-MES
           MOVE  WS-FOR-DD                    TO CTA-FECHA-AUX1-DIA
           MOVE  WS-FOR-AA                    TO CTA-FECHA-AUX1-ANNO
           MOVE  CTA-FECHA-AUX1               TO C86A-S-LIBRE-FEC1
      *
           IF WS-CODTIAMO  = CTE-CON-B
              SUBTRACT WS-MES-IMPORTE   FROM MAE-UGIIIANA
                  GIVING  COT-CAPITAL-INICIAL
                  ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-SUBTRACT
           END-IF
      *
           SUBTRACT WS-MES-IMPORTE   FROM MAE-SALTEOR
               GIVING  COT-CAPITAL
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-SUBTRACT

      *EFR01-I
           IF SW-SI-PUNICA
              PERFORM 2273-SALTEOR-PUNICA
              SUBTRACT VLR-K-PU FROM WS-MES-IMPORTE
                  GIVING WS-VLR-MES-KI
                  ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-SUBTRACT

              SUBTRACT WS-KTEOR-PU FROM MAE-SALTEOR
                  GIVING WS-SALTEOR-KI
                  ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-SUBTRACT

              SUBTRACT WS-VLR-MES-KI FROM WS-SALTEOR-KI
                  GIVING COT-CAPITAL
                  ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-SUBTRACT
           END-IF
      *EFR01-F
      *
           MOVE  COT-CAPITAL                  TO WS-C-INICIAL
      *
           IF WS-UGYFARET   =  CUOTA-SOBRE-CONCEDIDO
              SUBTRACT MAE-IMPDISPU   FROM  MAE-IMPCONCE
                 GIVING   WS-RETENIDO
                 ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
              END-SUBTRACT
      *
              ADD WS-RETENIDO                 TO WS-C-INICIAL
                 ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-ADD
      *
              IF WS-CODTIAMO  = CTE-CON-B
                 ADD WS-RETENIDO              TO COT-CAPITAL-INICIAL
                     ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-ADD
              END-IF
           END-IF
      *
           MOVE WS-C-INICIAL                  TO COT-CAPITAL
      *
           PERFORM 24722-CALC-S
      *
           IF WS-TIPOTASA = 'E'
              MOVE WS-TIPOAPLI                TO COT-INT-EFECTIVO
              MOVE ZERO                       TO COT-INT-NOMINAL
           ELSE
              MOVE ZERO                       TO COT-INT-EFECTIVO
              MOVE WS-TIPOAPLI                TO COT-INT-NOMINAL
           END-IF
      *
           EVALUATE COT-TIP-CUOTA
              WHEN  CTE-CON-B
              WHEN  CTE-CON-ALFA-1
              WHEN  CTE-CON-REGLA-78
                 PERFORM  24723-CALC-M
                 PERFORM  24724-CALC-DPL-AJ
              WHEN  CTE-CON-ALFA-2
                 PERFORM  24723-CALC-M
              WHEN  CTE-CON-ALFA-3
                 MOVE  WS-PROGGEOM            TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
                 PERFORM  24724-CALC-DPL-AJ
              WHEN  CTE-CON-ALFA-4
                 MOVE WS-PROGGEOM             TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
              WHEN  CTE-CON-ALFA-5
                 MOVE WS-PROGGEOM             TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
                 PERFORM  24725-CALC-T-R-N
                 PERFORM  24724-CALC-DPL-AJ
              WHEN  CTE-CON-ALFA-6
                 MOVE  WS-PROGGEOM            TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
                 PERFORM  24725-CALC-T-R-N
              WHEN  CTE-CON-ALFA-7
                 MOVE  WS-PROGARIT            TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
                 PERFORM  24724-CALC-DPL-AJ
              WHEN  CTE-CON-ALFA-8
                 MOVE  WS-PROGARIT            TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
              WHEN  CTE-CON-ALFA-9
                 MOVE  WS-PROGARIT            TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
                 PERFORM  24725-CALC-T-R-N
                 PERFORM  24724-CALC-DPL-AJ
              WHEN  CTE-CON-ALFA-0
                 MOVE  WS-PROGARIT            TO COT-RAZON
                                                 CO2-RAZON
                 PERFORM  24723-CALC-M
                 PERFORM  24725-CALC-T-R-N
              WHEN  CTE-CON-A
                 MOVE CTE-CON-1-COMP3         TO COT-TOT-AMORT-PEN
                 MOVE CTE-CON-UGA0101         TO WS-AVISO
                 PERFORM 120-ENVIAR-AVISO
              WHEN  'T'
                 MOVE CTE-CON-1-COMP3         TO COT-TOT-AMORT-PEN
                 MOVE CTE-CON-UGA0101         TO WS-AVISO
                 PERFORM 120-ENVIAR-AVISO
              WHEN  'W'
                 MOVE CTE-CON-1-COMP3         TO COT-TOT-AMORT-PEN
                 MOVE CTE-CON-UGA0101         TO WS-AVISO
                 PERFORM 120-ENVIAR-AVISO
              WHEN  'I'
              WHEN  'L'
                 PERFORM  24723-CALC-M
                 PERFORM  24724-CALC-DPL-AJ
              WHEN  'J'
                 MOVE CTE-CON-1-COMP3         TO COT-TOT-AMORT-PEN
              WHEN  'K'
              WHEN  'M'
                 PERFORM  24723-CALC-M
      *ENVIO PLAZO RESTANTE PARA RECALCULO DE CUOTA GRAD
              WHEN  'H'
                 PERFORM  24723-CALC-M
           END-EVALUATE
      *
           MOVE COT-TOT-AMORT-PEN             TO WS-M-INICIAL
           MOVE COT-AMO-RESTAN-PER            TO WS-R-INICIAL
                                                 WS-CONTADOR-1
      * SE ADICIONAN LOS CAMPOS NUEVA PARA LA CCOT0
           PERFORM  24726-RESTO-DATOS-1
      *EFR01-P-I
           IF SW-SI-PUNICA
              PERFORM  227282-CALC-IMP-MINI
           END-IF
      *EFR01-P-F
           PERFORM  24726-1-UR8CCOT0

           MOVE COT-CUOTA                     TO C86A-S-LIBRE-IMP1
                                                 WS-MES-CUOTAO1.

      ******************************************************************
      *             24721-FECHA-DB2-A-FOR                              *
      *    PASA LA FECHA DE FORMATO DB2 (AAAA-MM-DD)  A  FORMATO       *
      *                             FOR (DD-MM-AA)                     *
      ******************************************************************
       24721-FECHA-DB2-A-FOR.
      *
           MOVE  WS-DB2-DD                    TO WS-FOR-DD
           MOVE  WS-DB2-MM                    TO WS-FOR-MM
           MOVE  WS-DB2-AAAA                  TO WS-ANO-TRUNCADO
           MOVE  WS-ANO-TRUNCADO              TO WS-FOR-AA.

      ******************************************************************
      *             24722-CALC-S                                       *
      *    CALCULO DEL NUMERO DE AMORTIZACIONES ANUALES                *
      *    - SI ES CUOTA UNICA (999), LA RUTINA DEL CALCULO DE LA CUOTA*
      *    IGNORARA ESTE VALOR, POR LO QUE LO PONEMOS A CERO           *
      ******************************************************************
       24722-CALC-S.
      *
           EVALUATE  WS-TIPO-PER-CAP
              WHEN  CTE-CON-1
                 DIVIDE   WS-DIASCAL             BY  WS-PERIODO-CAP
                   GIVING  COT-AMO-ANNO
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-DIVIDE
              WHEN  CTE-CON-2
                 DIVIDE   CTE-CON-12-COMP3       BY  WS-PERIODO-CAP
                   GIVING  COT-AMO-ANNO
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-DIVIDE
              WHEN  CTE-CON-3
                 DIVIDE   CTE-CON-1-COMP3       BY  WS-PERIODO-CAP
                   GIVING  COT-AMO-ANNO
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-DIVIDE
              WHEN  CTE-CON-9
                 MOVE  ZERO                   TO COT-AMO-ANNO
              WHEN  OTHER
                 MOVE CTE-CON-UGE0089         TO C86A-RET-COD-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE
      *
           MOVE COT-AMO-ANNO                  TO WS-ENTERO

           IF COT-TIP-CUOTA       NOT =  CTE-CON-A        AND
              COT-TIP-CUOTA       NOT =  'T'              AND
              COT-TIP-CUOTA       NOT =  'W'              AND
      *@COL03-CE30134-I
              COT-TIP-CUOTA       NOT =  'V' AND 'y'      AND
      *@COL03-CE30134-F
              COT-AMO-ANNO        NOT =  WS-ENTERO

              IF WS-TIPO-PER-CAP = CTE-CON-1  AND
                 WS-TIPODIAS  = CTE-CON-1
                 NEXT SENTENCE
              ELSE
                 MOVE CTE-CON-UGE0089         TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF

           END-IF.

      ******************************************************************
      *             24723-CALC-M                                       *
      *    CALCULO DEL TOTAL DE AMORTIZACIONES PENDIENTES              *
      ******************************************************************
       24723-CALC-M.
      *
           IF WS-TIPO-PER-CAP  =  CTE-CON-1
              IF COT-TIP-CUOTA       =  CTE-CON-A  OR
                 COT-TIP-CUOTA       =  'T'        OR
                 COT-TIP-CUOTA       =  'W'
                 MOVE CTE-CON-1-COMP3           TO COT-TOT-AMORT-PEN
              ELSE
                 IF WS-TIPODIAS NOT = CTE-CON-1
                    MOVE 'UGE0761'              TO C86A-RET-COD-ERROR
                    MOVE 'PERIOD EN DIAS '      TO C86A-RET-VAR1-ERROR
                    PERFORM  3-FINAL-PROGRAMA
                 END-IF
              END-IF
           END-IF
      *
           MOVE  MAE-FEVENCIN                   TO WS-DB2-AAAA-MM-DD
           MOVE  MAE-FEPROAMO                   TO WS-DB2-AUX-AAAA-MM-DD
      *
           SUBTRACT WS-DB2-AUX-AAAA    FROM WS-DB2-AAAA
               GIVING  WS-M-TOTAL
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-SUBTRACT
      *
      *   MANEJO PARA PERCAP  =  1   CUENTA EL NUMERO DE CUOTAS        *
           IF WS-TIPO-PER-CAP  =  CTE-CON-1
              MOVE MAE-FEPROAMO                 TO WS-DATA-INI
              MOVE ZERO                         TO WS-NUM-COPS
              PERFORM 247231-RUTINA-UR8CDFP0
                    UNTIL WS-DATA-INI >  MAE-FEVENCIN
              MOVE WS-NUM-COPS                  TO WS-RESULTAT
           END-IF
      *
           IF WS-TIPO-PER-CAP  =  CTE-CON-2
              MULTIPLY WS-M-TOTAL      BY   CTE-CON-12-COMP3
                    GIVING  WS-M-TOTAL
                    ON SIZE ERROR PERFORM 33331-REBOSAMIENTO
              END-MULTIPLY
      *
              ADD      WS-M-TOTAL              WS-DB2-MM
                    GIVING  WS-M-TOTAL
                    ON SIZE ERROR PERFORM 33331-REBOSAMIENTO END-ADD
      *
              SUBTRACT WS-DB2-AUX-MM      FROM WS-M-TOTAL
                    GIVING  WS-M-TOTAL
                    ON SIZE ERROR PERFORM 33331-REBOSAMIENTO
              END-SUBTRACT
           END-IF
      *
           IF WS-TIPO-PER-CAP = CTE-CON-1
              MOVE WS-RESULTAT                  TO COT-TOT-AMORT-PEN
           ELSE
              DIVIDE   WS-M-TOTAL             BY  WS-PERIODO-CAP
                   GIVING  WS-M-TOTAL
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
              END-DIVIDE
      *
              ADD      WS-M-TOTAL          CTE-CON-1-COMP3
                  GIVING  COT-TOT-AMORT-PEN
                  ON SIZE ERROR PERFORM 33331-REBOSAMIENTO
              END-ADD
           END-IF
      *
           IF COT-TOT-AMORT-PEN       =  CTE-CON-1-COMP3
              MOVE CTE-CON-ALFA-1               TO WS-IND-10
           END-IF.

      ******************************************************************
      *                247231-RUTINA-UR8CDFP0                          *
      ******************************************************************
       247231-RUTINA-UR8CDFP0.
      *
           INITIALIZE URECRES URECDF3
      *
           MOVE WS-DATA-INI                   TO DF3-FECHA-INICIAL
           MOVE  WS-PERCAP                    TO DF3-PERCAP
           MOVE  1                            TO DF3-NUM-PERIODOS
           MOVE '1'                           TO DF3-TIPODIAS
      *
           CALL   BBVA-UR8CDFP0  USING  URECRES
                                        URECDF3
      *
           IF RES-CORESPUE = '10'
              MOVE DF3-FECHA-FINAL            TO WS-DATA-INI
              ADD 1                           TO WS-NUM-COPS
           ELSE
              MOVE 'UGE0517'                  TO C86A-RET-COD-ERROR
              MOVE 'UR8CDFP0'                 TO C86A-RET-VAR1-ERROR
              MOVE RES-CORESPUE               TO C86A-RET-VAR2-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *             24724-CALC-DPL-AJ                                  *
      *    SI EL PRESTAMO ESTA EN CARENCIA DPL Y AJ ES CERO            *
      *    PARA LOS CONTRATOS CON TIPO DE CUOTA C (CAPITAL + INTE-     *
      *    RESES) SE CALCULAN:                                         *
      *        PARA LOS PRESTAMOS QUE LIQUIDAN INTERESES EN LA ENTREGA,*
      *            DPL: DIAS HASTA LA PROXIMA AMORTIZACION             *
      *        PARA LOS QUE NO LIQUIDAN,                               *
      *            AJ: AJUSTE DEL SALDO PARA QUE EL CALCULO DE         *
      *            LA NUEVA CUOTA TENGA EN CUENTA LOS INTERESES PEN-   *
      *            DIENTES. TAMBIEN SE A├æADEN LOS INTERESES DESDE      *
      *            LA FECHA DE FORMALIZACION A FIN DE MES, PARA LOS    *
      *            CASOS EN QUE EL TIPODIAS SEA 2, 3, O 4, SI NO SE    *
      *            ESTA DENTRO DEL PERIODO DE CARENCIA, Y SI ESTAMOS   *
      *            ANTES DE LA PRIMERA LIQUIDACION                     *
      ******************************************************************
       24724-CALC-DPL-AJ.
      *
           MOVE ZEROES                        TO COT-DIAS-PRI-LIQ
           MOVE ZEROES                        TO COT-AJUSTE-ENTREGAS.

      ******************************************************************
      *             24725-CALC-T-R-N                                   *
      *    PARA LOS CONTRATOS CON TIPO DE AMORTIZACION PERIODICO, SE   *
      *    CALCULAN:                                                   *
      *        NUMERO DE AMORTIZACIONES POR PERIODO                    *
      *        NUMERO DE PERIODOS DE VIGENCIA QUE RESTAN               *
      *        NUMERO DE AMORTIZACIONES QUE RESTAN EN EL PRESENTE      *
      *            PERIODO                                             *
      ******************************************************************
       24725-CALC-T-R-N.
      *
           MOVE  WS-LININCUO                  TO COT-AMO-PERIODO
      *
           DIVIDE   COT-TOT-AMORT-PEN       BY  COT-AMO-PERIODO
               GIVING     COT-PER-VIGENCIA
               REMAINDER  COT-AMO-RESTAN-PER
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-DIVIDE
      *
           IF COT-AMO-RESTAN-PER       =  ZERO
              MOVE  COT-AMO-PERIODO           TO COT-AMO-RESTAN-PER
           ELSE
              ADD      COT-PER-VIGENCIA        CTE-CON-1-COMP3
                   GIVING  COT-PER-VIGENCIA
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-ADD
           END-IF.

      ******************************************************************
