      ******************************************************************
      *                                                                *
      *              2326-RESTAURAR-CUOTAS                             *
      *                                                                *
      *    SE DEJA LA TABLA DE CUOTAS COMO ESTABA ANTES DE LA          *
      *    ENTREGA. PARA ELLO, SE BORRAN LAS CUOTAS QUE SE             *
      *    A#ADIERON Y SE REESCRIBEN LAS QUE SE BORRARON.              *
      *                                                                *
      ******************************************************************
       2326-RESTAURAR-CUOTAS.
      *
           PERFORM  23261-DELETE-CUOTAS
      *
      *@2FASE-IBBV-PR
      *    MOVE 'UDMC'                   TO MOD-CODTRAN
           MOVE 'U283'                   TO MOD-CODTRAN
           MOVE 'UGDTCUO'                TO MOD-TABLA
           MOVE WS-CCC-ENTIOFI           TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA            TO WS-CUENTA
           MOVE WS-CLAVE                 TO MOD-CLAVE
           MOVE 'FECOVALI'               TO MOD-COLUMNA
      *
           EXEC SQL SELECT
                MIN( TIMESTAMP)
              INTO
                :WS-TIMESTAMP-MOD :WS-MAX-IND
                FROM UGDTMOD
              WHERE
                     CODTRAN      = :MOD-CODTRAN      AND
                     TABLA        = :MOD-TABLA        AND
                     CLAVE        = :MOD-CLAVE        AND
                     COLUMNA      = :MOD-COLUMNA      AND
                     TIMESTAMP > :MOD-TIMESTAMP
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE.
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              IF WS-MAX-IND < ZEROS
                 CONTINUE
              ELSE
                 PERFORM 23262-ABRIR-CURS-MOD
                 PERFORM 23263-FETCH-MOD
      *
      *   GUARDEM LA PRIMERA QUOTA PER REPOSAR-LA A LA TAULA DRB
      *
      *          IF DB2-OK AND SQLWARN0 = SPACES
      *              MOVE CUO-IMPMINI TO WS-IMPMINI
      *          END-IF
                 PERFORM 23264-INSERTAR-T39
                 UNTIL NOT (DB2-OK AND  SQLWARN0 = SPACES)
                    IF NOT (DB2-NOTFND AND  SQLWARN0 = SPACES)
                       MOVE 'UGDTCUO'           TO C86A-RET-VAR1-ERROR  OR
                       PERFORM 999999-ABEND-DB2
                    END-IF
                 PERFORM     23265-CERRAR-CURS-MOD
              END-IF
           ELSE
               MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      *
      ******************************************************************
      *                                                                *
      *             23261-DELETE-CUOTAS                                *
      *                                                                *
      *    BORRAR LAS CUOTAS QUE SE A#ADIERON EN LA ENTREGA ANTICIPADA.*
      *                                                                *
      ******************************************************************
      *
       23261-DELETE-CUOTAS.
      *
           EXEC SQL
             DELETE  FROM  UGDTCUO
               WHERE
                       ENTIOFI   =      :MAE-ENTIOFI      AND
                       CUENTA    =      :MAE-CUENTA       AND
                      (FEFIVALI  =      :WS-DB2-FEVALOR   OR
                       FEFIVALI  >      :WS-DB2-FEVALOR)
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK               AND
                   SQLWARN0  =  SPACES)
               IF NOT (DB2-NOTFND         AND
                       SQLWARN0 = SPACES)
                   MOVE 'UGDTCUO'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      *
           EJECT
      ******************************************************************
      *                                                                *
      *               23262-ABRIR-CURS-MOD                             *
      *                                                                *
      *   ABRE CURSOR EN LA TABLA UGDTMOD   A PARTIR DE LA PRIMERA     *
      *   CUOTA BORRADA EN LA ENTREGA.                                 *
      *                                                                *
      ******************************************************************
       23262-ABRIR-CURS-MOD.
      *
           EXEC SQL
             OPEN CURS-MOD
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK AND SQLWARN0 = SPACES)
              MOVE 'UGDTMOD'             TO C86A-RET-VAR1-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.
      *
      ******************************************************************
      *                                                                *
      *               23263-FETCH-MOD                                  *
      *                                                                *
      *   PASA A VARIABLES LOS DATOS DE LA CUOTA LEIDA                 *
      *                                                                *
      ******************************************************************
      *
       23263-FETCH-MOD.
      *
           EXEC SQL
             FETCH CURS-MOD
               INTO
                 :MOD-COLUMNA,
                 :MOD-TIMESTAMP,
                 :MOD-VALOR-ANT
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE.

           IF DB2-OK AND SQLWARN0 = SPACES
               EVALUATE MOD-COLUMNA
                   WHEN 'FECOVALI'
                       MOVE MOD-VALOR-ANT   TO WS-FECHA-MOD
                       MOVE WS-FECHA-ALF TO CUO-FECOVALI
                   WHEN 'IMPMINI'
      **@2FASE-IBBV-PR
      **               MOVE MOD-VALOR-ANT       TO WS-VALOR-MOD
      **               MOVE WS-VALOR-ALF        TO CUO-IMPMINI
                       MOVE MOD-VALOR-ANT-NUM   TO CUO-IMPMINI
      **@2FASE-FBBV-PR
                   WHEN 'FEFIVALI'
                       MOVE MOD-VALOR-ANT   TO WS-FECHA-MOD
                       MOVE WS-FECHA-ALF TO CUO-FEFIVALI
               END-EVALUATE
           ELSE
               IF NOT  (DB2-NOTFND         AND
                        SQLWARN0 = SPACES)
                   MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.

           EXEC SQL
             FETCH CURS-MOD
               INTO
                 :MOD-COLUMNA,
                 :MOD-TIMESTAMP,
                 :MOD-VALOR-ANT
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE.

           IF DB2-OK AND SQLWARN0 = SPACES
               EVALUATE MOD-COLUMNA
                   WHEN 'FECOVALI'
                       MOVE MOD-VALOR-ANT   TO WS-FECHA-MOD
                       MOVE WS-FECHA-ALF TO CUO-FECOVALI
                   WHEN 'IMPMINI'
      **@2FASE-IBBV-PR
      **               MOVE MOD-VALOR-ANT       TO WS-VALOR-MOD
      **               MOVE WS-VALOR-ALF        TO CUO-IMPMINI
                       MOVE MOD-VALOR-ANT-NUM   TO CUO-IMPMINI
      **@2FASE-FBBV-PR
                   WHEN 'FEFIVALI'
                       MOVE MOD-VALOR-ANT   TO WS-FECHA-MOD
                       MOVE WS-FECHA-ALF TO CUO-FEFIVALI
               END-EVALUATE
           ELSE
               IF NOT  (DB2-NOTFND         AND
                        SQLWARN0 = SPACES)
                   MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.

           EXEC SQL
             FETCH CURS-MOD
               INTO
                 :MOD-COLUMNA,
                 :MOD-TIMESTAMP,
                 :MOD-VALOR-ANT
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE.

           IF DB2-OK AND SQLWARN0 = SPACES
               EVALUATE MOD-COLUMNA
                   WHEN 'FECOVALI'
                       MOVE MOD-VALOR-ANT   TO WS-FECHA-MOD
                       MOVE WS-FECHA-ALF TO CUO-FECOVALI
                   WHEN 'IMPMINI'
      **@2FASE-IBBV-PR
      **               MOVE MOD-VALOR-ANT       TO WS-VALOR-MOD
      **               MOVE WS-VALOR-ALF        TO CUO-IMPMINI
                       MOVE MOD-VALOR-ANT-NUM   TO CUO-IMPMINI
      **@2FASE-FBBV-PR
                   WHEN 'FEFIVALI'
                       MOVE MOD-VALOR-ANT   TO WS-FECHA-MOD
                       MOVE WS-FECHA-ALF TO CUO-FEFIVALI
               END-EVALUATE
           ELSE
               IF NOT  (DB2-NOTFND         AND
                        SQLWARN0 = SPACES)
                   MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
           IF CUO-FECOVALI NOT > WS-DB2-FEVALOR AND
              CUO-FEFIVALI > WS-DB2-FEVALOR
                   MOVE CUO-IMPMINI TO WS-IMPMINI
           END-IF.

           EJECT
