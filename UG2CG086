      *                  362-PROCESAR-LINEA.                           *
      * _______________________________________________________________*
      *          SE IMPRIME EL DOCUMENTO                               *
      *                                                                *
      ******************************************************************
      *
       362-PROCESAR-LINEAS.
      *
      ***** MOVER CAMPOS A IMPRIMIR A LOS CAMPOS DEL FORMATO ********

           PERFORM 3622-BUSCAR-NOMBRE-OFICINA.

           IF MAE-UGCIOPRE = 'C'
              MOVE C-LAMORT TO G10Z-LAMORT
           ELSE
              MOVE E-LAMORT TO G10Z-LAMORT
           END-IF.
           IF  IFA-UGCAMORT = CTE-CON-L OR CTE-CON-A
               MOVE  WS-VENCIM-ACT        TO G10Z-TAMORT
             IF SW-SI-LEASING
                MOVE  WS-VENCIM-ACT-CAN   TO G10Z-TAMORT
             END-IF
           END-IF
           IF  IFA-UGCAMORT = CTE-CON-X OR CTE-CON-B
               MOVE  WS-NUEVO-VENCIM      TO G10Z-TAMORT
           END-IF
           IF WS-REVER-CUOTAFIN = 'S'
               MOVE  WS-NUEVA-CUOFIN      TO G10Z-TAMORT
             IF SW-SI-LEASING
                MOVE WS-NUEVA-CUOFIN-CAN  TO G10Z-TAMORT
             END-IF
           END-IF
           IF WS-REVER-OPCADQUI = 'S'
               MOVE  WS-NUEVA-OPADQUI     TO G10Z-TAMORT
           END-IF

           MOVE WS-CCC                    TO G10Z-CTAPRES.

           MOVE CAA-FECHA-OPER2           TO WS-FELIQ.
           MOVE WS-FELIQ-AAAA             TO WS-FELIQ-ANY.
           MOVE WS-FELIQ-MM               TO WS-FELIQ-MES.
           MOVE WS-FELIQ-DD               TO WS-FELIQ-DIA.
           MOVE WS-FELIQ-DD-MM-AA         TO CTA-FECHA-AUX1
           MOVE CTA-FECHA-AUX1-DIA        TO CTA-FECHA-AUX2-DIA
           MOVE CTA-FECHA-AUX1-MES        TO CTA-FECHA-AUX2-MES
           MOVE CTA-FECHA-AUX1-ANNO       TO CTA-FECHA-AUX2-ANNO
           MOVE CTA-FECHA-AUX2            TO G10Z-FEEDIC
           MOVE MAE-ENOTIT                TO WS-ENOTIT

            IF MAE-MONEDA NOT = 'COP'
               COMPUTE G10Z-SDOPINI  ROUNDED  =
                       WS-SALINI        *  WS-CAMBIO
               END-COMPUTE
               COMPUTE G10Z-NSDOPEN  ROUNDED  =
                       WS-SALFIN        *  WS-CAMBIO
               END-COMPUTE
               COMPUTE G10Z-CAPINI   ROUNDED  =
                       WS-MES-CAPITAL   *  WS-CAMBIO
               END-COMPUTE
               IF ADS-INDINANT = CTE-CON-V
                  PERFORM 3625-MONTAR-FECHAS
               END-IF
               IF ADS-INDINANT NOT = 'A' AND ADS-INDINANT NOT = 'P'
                  COMPUTE G10Z-INTINI   ROUNDED  =
                          WS-MES-INTERESES *  WS-CAMBIO
                  END-COMPUTE
               ELSE
                  COMPUTE G10Z-INTINI   ROUNDED  =
                          WS-MES-INTERESES-ANTI *  WS-CAMBIO * (-1)
                  END-COMPUTE
               END-IF
               COMPUTE G10Z-COMISI   ROUNDED  =
                       WS-MES-COMISION  *  WS-CAMBIO
               END-COMPUTE
               COMPUTE G10Z-IVA      ROUNDED  =
                       WS-MES-IVA       *  WS-CAMBIO
               END-COMPUTE
               COMPUTE G10Z-IMPTOT   ROUNDED  =
                       WS-TOTAL         *  WS-CAMBIO
               END-COMPUTE
               MOVE 0                         TO G10Z-PAGOPRE
            ELSE
               MOVE WS-SALINI                 TO G10Z-SDOPINI
               MOVE WS-SALFIN                 TO G10Z-NSDOPEN

               IF ADS-INDINANT = CTE-CON-V
                  PERFORM 3625-MONTAR-FECHAS
               END-IF
               IF ADS-INDINANT NOT = 'A' AND ADS-INDINANT NOT = 'P'
                  IF WS-INT-DEV-COR > ZEROS
                     MULTIPLY WS-INT-DEV-COR BY -1
                        GIVING WS-INT-COR
                     MOVE WS-INT-COR              TO G10Z-INTINI
                  ELSE
                     MOVE WS-MES-INTERESES        TO G10Z-INTINI
                  END-IF
               ELSE
                  COMPUTE G10Z-INTINI   ROUNDED  =
                          WS-MES-INTERESES-ANTI *  (-1)
                  END-COMPUTE
               END-IF
               MOVE WS-MES-CAPITAL                TO G10Z-CAPINI
               MOVE WS-MES-COMISION           TO G10Z-COMISI
               MOVE WS-MES-IVA                TO G10Z-IVA
               MOVE WS-TOTAL                  TO G10Z-IMPTOT
               MOVE 0                         TO G10Z-PAGOPRE
            END-IF.
           MOVE WS-DB2-FEVALOR            TO WS-CCAA-MM-DD
           IF WS-MES-COMISION > ZEROS
              MOVE SPACES                     TO G10Z-INDCOM
              MOVE CCP-TASA-COMISION          TO WS-TASA-COMISION
              MOVE WS-TASA-COMISION           TO G10Z-TASCOM
              MOVE 'PAGO ANTICIPADO'          TO G10Z-DESCCOM
           ELSE
              MOVE '1'                        TO G10Z-INDCOM
              MOVE ZEROS                      TO G10Z-TASCOM
           END-IF.
      *
           IF WS-MES-IVA      > ZEROS
              MOVE SPACES                     TO G10Z-INDIVA
              MOVE CCP-TASA-IVA               TO WS-TASA-IVA
              MOVE WS-TASA-IVA                TO G10Z-TASIVA
           ELSE
              MOVE '1'                        TO G10Z-INDIVA
              MOVE ZEROS                      TO G10Z-TASIVA
           END-IF.
           IF ADS-ENTSUB NOT = SPACES OR
              ADS-CONSUB NOT = SPACES
                IF MAE-UGCIOPRE = 'C'
                   MOVE 'SUBVENCIO  '  TO C-SUBV
                ELSE
                   MOVE 'SUBVENCION '  TO C-SUBV
                END-IF
                MOVE ADS-ENTSUB         TO C-ORGSUB
                MOVE WS-MES-SUBVEN      TO C-IMPSUBVE
           END-IF.
            IF ADS-INDINANT  NOT = 'A' AND
               ADS-INDINANT  NOT = 'P'
                MOVE 'CAPITAL           '         TO G10Z-DESCRI1
                MOVE 'INTERESES         '         TO G10Z-DESCRI2
                IF SI-GRACIA
                   MOVE CTE-INTERESES-REVERSADOS  TO G10Z-DESCRI2
                   PERFORM 212-BORRA-PCOR
                   PERFORM 213-ACTUALIZA-DLIC
                END-IF
                IF MAE-MONEDA NOT = 'COP'
                   COMPUTE G10Z-TLIQUID  ROUNDED  =
                           WS-TOTAL         *  WS-CAMBIO
                   END-COMPUTE
                ELSE
                   MOVE WS-TOTAL                  TO G10Z-TLIQUID
                END-IF
            ELSE
                MOVE 'CAPITAL TOTAL ABONADO '     TO G10Z-DESCRI1
                MOVE 'INTERESES ANTICIPADOS '     TO G10Z-DESCRI2
                IF MAE-MONEDA NOT = 'COP'
                   COMPUTE G10Z-TLIQUID  ROUNDED  =
                           WS-TOTAL               *  WS-CAMBIO
                   END-COMPUTE
                ELSE
                   COMPUTE G10Z-TLIQUID  ROUNDED  =
                           WS-TOTAL
                   END-COMPUTE
                END-IF
           END-IF.
           IF MIR-ENTIDAD EQUAL SPACES OR LOW-VALUES
              IF  MOV-RUTA(1:1)   = 'S' OR '1'
                  MOVE 'EN EFECTIVO '        TO G10Z-CTACARG
              ELSE
                  IF  MOV-RUTA(1:1)   = 'T' OR '2'
                      MOVE 'TELEPROCESO'     TO G10Z-CTACARG
                  ELSE
                      MOVE 'EN EFECTIVO '    TO G10Z-CTACARG
                  END-IF
              END-IF
           ELSE
              MOVE MIR-ENTIDAD           TO WS-P-CENTIDA
              MOVE MIR-CENTRO-ALTA       TO WS-P-CCENTRO
              MOVE MIR-CUENTA            TO WS-P-CCUENTA
              MOVE MIR-DIGICCC1          TO WS-P-CDIGIT1
              MOVE MIR-DIGICCC2          TO WS-P-CDIGIT2
              MOVE WS-PAGO-CTA           TO G10Z-CTACARG
           END-IF.
           IF MAE-UGCIOPRE = 'C'
              MOVE C-TAEC           TO C-LITTAE
           ELSE
              MOVE E-TAEE           TO C-LITTAE
           END-IF

           IF NOT (MAE-UGPITTAE = 0)
               MOVE MAE-UGPITTAE        TO C-IMPTAE
               MOVE C-TAE               TO G10Z-LITVAR1
           ELSE
               IF NOT (MAE-TAE = 0)
                  MOVE MAE-TAE          TO C-IMPTAE
                  MOVE C-TAE            TO G10Z-LITVAR1
               ELSE
                  MOVE SPACES           TO G10Z-LITVAR1
               END-IF
           END-IF
           MOVE SPACES           TO G10Z-LITVAR1
           IF CTE-CODTIAMO-FORMULA-B
              IF MAE-UGCIOPRE = 'C'
                 MOVE C-LITINTC-B      TO WS-LITINT-B
              ELSE
                 MOVE E-LITINTE-B      TO WS-LITINT-B
              END-IF
              MOVE WS-UGPCMNOM         TO WS-TIP2-B
              MOVE WS-INTGENLIN1-B     TO WS-RESTOINT1C-B
              MOVE WS-TIPOTIT1-B       TO G10Z-FEFIDEM
           ELSE
               IF MAE-UGCIOPRE = 'C'
                  MOVE C-LITINTC        TO WS-LITINT
               ELSE
                  MOVE E-LITINTE        TO WS-LITINT
