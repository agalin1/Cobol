      *     AVERIGUA SI EL CREDITO TIENE UVR GARANTIZADA               *
      *     O SEGURO DE COBERTURA                                      *
      *----------------------------------------------------------------*
       61C-SEGURO-COBERTURA.

           INITIALIZE     UGTCT37
           MOVE MAE-SUBPRO                  TO T37-ELEMENTO
           MOVE '0520'                      TO T37-SECCION

           EXEC SQL
              SELECT RESTO
              INTO :T37-RESTO
              FROM UGDTT37
              WHERE ELEMENTO = :T37-ELEMENTO AND
                    SECCION  = :T37-SECCION
           END-EXEC

           MOVE SQLCODE                     TO DB2-RETURN-CDE

           IF DB2-OK
              SET SEGURO-COBERTURA          TO TRUE
           ELSE
              IF DB2-NOTFND
                 SET NO-SEGURO-COBERTURA    TO TRUE
              ELSE
                 MOVE 'UGDTT37'             TO C86A-RET-VAR1-ERROR
                 MOVE 'SECC='               TO C86A-RET-VAR2-ERROR
                 MOVE T37-SECCION           TO C86A-RET-VAR2-ERROR(6:4)
                 MOVE ' ELEMT='             TO C86A-RET-VAR2-ERROR(10:7)
                 MOVE T37-ELEMENTO          TO C86A-RET-VAR2-ERROR(17:4)
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *            2341-VAL-FECHA-VALOR                                *
      *    VALIDA QUE LA FECHA VALOR DE PANTALLA ES LA DE HOY O        *
      *    ANTERIOR Y QUE ES POSTERIOR A LA DE ULTIMA LIQUIDACION      *
      *    ESPECIAL, A LA DE ULTIMA AMORTIZACION ESPECIAL Y A LA DE    *
      *    ULTIMO CAMBIO DE SITUACION DEL PRESTAMO                     *
      *    SI SE DEJA EN BLANCO, SE TOMA LA FECHA DE HOY               *
      ******************************************************************
       2341-VAL-FECHA-VALOR.
      *
 DPR5 *    PERFORM 23412-VAL-PPC


           IF C86A-FECHA-OPER       =  SPACES OR LOW-VALUES
      *SE MODIFICA PARA QUE TOME LA FECHA CONTABLE COMO FECHA DEL DIA
              MOVE CAA-FECHA-CONT2          TO WS-DB2-FEVALOR
           ELSE
              MOVE  C86A-FECHA-OPER         TO WS-DB2-FEVALOR
              MOVE  CAA-FECHA-CONT2         TO WS-DB2-HOY
      *KAREN VANNESA ACEVEDO TORRES
           END-IF
      *
           IF MAE-INDADMES      = CTE-CON-N
              PERFORM  23412-1-SELECT-ADMINIS-STD
           ELSE
              PERFORM  23412-2-SELECT-ADMINIS-ESP
           END-IF

      ******************************************************************
      *    BUSCAR SI EL CONVENIO ADMITE O NO PAGO ANTICIPADO           *
      ******************************************************************
           IF MAE-IND-MARCA2 = 'R'
              PERFORM 221T-BUSCA-CONVENIO
           END-IF

           PERFORM  23412-3-VALIDA-TIP-CUOTA
      *
           IF SW-TIPO-REDUC-PLAZO  AND  SW-CLAUSULA-010
              MOVE 'UGE1093'                    TO C86A-RET-COD-ERROR
              MOVE 'SW-CLAUSULA-010'            TO C86A-RET-VAR1-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF
      *
      * NO APLICA SI ES CREDITO CONSTRUCTOR HIJO
           PERFORM 2342-TRAE-VALOR-UGDTAMA

           IF WS-DB2-FEVALOR < MAE-FEULIES
              IF WS-CONSTRUCTOR-SI AND
      *          REVISAMOS SI ES HIJO
                 (MAE-CUENTA NOT= AMA-LIBRE-CAR2(11:10))
                   CONTINUE
              ELSE
      *@COL07-INI
                 IF SI-GRACIA
                    CONTINUE
                 ELSE
      *@COL07-FIN
                    MOVE 'UGE1192'               TO C86A-RET-COD-ERROR
                    MOVE MAE-FEULIES             TO C86A-RET-VAR1-ERROR
                    PERFORM  3-FINAL-PROGRAMA
      *@COL07-INI
                 END-IF
      *@COL07-FIN
              END-IF
           END-IF
      *
           IF WS-DB2-FEVALOR NOT < MAE-FEPROLIQ AND WS-INDINANT = 'V'
              MOVE 'UGE1203'                    TO C86A-RET-COD-ERROR
              MOVE MAE-FEPROLIQ                 TO C86A-RET-VAR1-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF
      *
           IF WS-DB2-FEVALOR > MAE-FEPROLIQ AND WS-INDINANT NOT = 'V'
              MOVE 'UGE1205'                    TO C86A-RET-COD-ERROR
              MOVE MAE-FEPROLIQ                 TO C86A-RET-VAR1-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF
      *
      *  CONFIRMAR QUE NO VENGA DE PAGO PROXIMA CUOTA (pago total de la
      *  cuota) YA QUE CUANDO SE HIZO PPC LA FEULIQ SERA MAYOR
      *
           IF C86A-E-LIBRE-CAR1(1:2) NOT = 'SI'
                 IF WS-DB2-HOY <  MAE-FEULIQ AND SW-NO-HAY-GRACIA
                    IF WS-CONSTRUCTOR-SI AND
                       (MAE-CUENTA NOT = AMA-LIBRE-CAR2(11:10))
                          CONTINUE
                    ELSE
      *@COL07-INI
                       IF SI-GRACIA
                          CONTINUE
                       ELSE
      *@COL07-FIN
                          MOVE 'UGE1190'         TO C86A-RET-COD-ERROR
                          MOVE MAE-FEULIQ        TO C86A-RET-VAR1-ERROR
                          PERFORM  3-FINAL-PROGRAMA
      *@COL07-INI
                       END-IF
      *@COL07-FIN
                    END-IF
                 END-IF
           END-IF
      *
           MOVE 0                                 TO WS-DB2-CONTADOR
      *
      * VERIFICAR SI HAY MOVIMIENTOS POSTERIORES A LA FECHA VALOR
           IF WS-INDINANT = 'A' OR 'P'

              EXEC SQL
                   SELECT  COUNT(*)
                     INTO :WS-DB2-CONTADOR :WS-INDICA
                     FROM  UGDTMOV
                    WHERE  CUENTA   = :MAE-CUENTA           AND
                           ENTIOFI  = :MAE-ENTIOFI          AND
                           CLACON  IN ('N1','A2','B2','C2','D2',
                                       'I2','J2','DE','CF') AND
                           INDRETRO = 'N'                   AND
                          FEVALOR  > :WS-DB2-HOY
              END-EXEC

           ELSE

              EXEC SQL
                   SELECT  COUNT(*)
                     INTO :WS-DB2-CONTADOR :WS-INDICA
                     FROM  UGDTMOV
                    WHERE  CUENTA   = :MAE-CUENTA                AND
                           ENTIOFI  = :MAE-ENTIOFI               AND
                           CLACON  IN ('T1','N1','A2','B2','C2','D2',
                                       'I2','J2','UU','DE','CF') AND
                           INDRETRO = 'N'                        AND
                           FEVALOR  > :WS-DB2-HOY
              END-EXEC

           END-IF
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              IF WS-DB2-CONTADOR > 0 AND WS-INDICA >= 0
                 MOVE 'UGE1288'               TO C86A-RET-COD-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           ELSE
              IF (DB2-NOTFND)
                 MOVE 'UGE0373'               TO C86A-RET-COD-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'SELECT UGDTMOV'        TO C86A-RET-VAR1-ERROR
                 MOVE 'COUNT MOV'             TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF
      *
      *    NO DEBEN DE EXISTIR IFAS DE PREPAGOS DENTRO DEL PLAZO       *
      *    EN QUE SE QUIERE APLICAR LA AMORTIZACION                    *
           MOVE 0                             TO WS-CONTADOR
           MOVE IFA-UGFVALOR                  TO WS-FECHA-AUXIFA
           IF SW-NO-HAY-GRACIA
              MOVE MAE-FEULIQ                 TO IFA-UGFVALOR
           ELSE
              MOVE MAE-FEFORMA                TO IFA-UGFVALOR
           END-IF
      *
           IF WS-INDINANT = 'A'

              EXEC SQL
                SELECT COUNT(*)
                INTO :WS-CONTADOR :WS-INDICA
                FROM UGDTIFA
                WHERE ENTIOFI = :MAE-ENTIOFI   AND
                      CUENTA  = :MAE-CUENTA    AND
                      UGYINDIF = '0'           AND
                      UGFVALOR > :IFA-UGFVALOR  AND
                      UGTINCID = 'A'
              END-EXEC

           ELSE

              EXEC SQL
                SELECT COUNT(*)
                INTO :WS-CONTADOR :WS-INDICA
                FROM UGDTIFA
                WHERE ENTIOFI = :MAE-ENTIOFI    AND
                      CUENTA  = :MAE-CUENTA     AND
                      UGYINDIF = '0'            AND
                      UGFVALOR >= :IFA-UGFVALOR AND
                      UGTINCID = 'A'
              END-EXEC

           END-IF
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           MOVE WS-FECHA-AUXIFA               TO IFA-UGFVALOR
      *
           IF DB2-OK
              IF WS-CONTADOR > 0 AND WS-INDICA >= 0
                 MOVE 'UGE2015'               TO C86A-RET-COD-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           ELSE
              MOVE 'SELECT UGDTIFA'           TO C86A-RET-VAR1-ERROR
              MOVE 'COUNT IFAS'               TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

