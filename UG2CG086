      ******************************************************************
      *                26D-ACTUALIZAR-UVR                              *
      *  SI EL PRESTAMO ES DE UVR SE HARAN LAS CORRESPONDIENTES ACTUA- *
      *  LIZACIONES EN LAS DE UNIDADES DE VALOR REAL                   *
      ******************************************************************
       26D-ACTUALIZAR-UVR.
      *
           INITIALIZE                         URWCUVR
      *  MAE-SALTEOR---> SALDO TEORICO EN UVR                          *
           MOVE WS-DB2-FEVALOR                TO UVR-WS-FECHA
           SET  UVR-WS-ONLINE                 TO TRUE
           SET  UVR-WS-UVR                    TO TRUE
           MOVE MAE-SALTEOR                   TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-SALTEOR
      *  MAE-SALREAL---> SALDO REAL    EN UVR                          *
           SET  UVR-WS-BATCH                  TO TRUE
           MOVE MAE-SALREAL                   TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-SALREAL
      *  MAE-ACUIMPA---> ACUMULADO DE IMPAGADOS EN UVR                 *
           MOVE MAE-ACUIMPA                   TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-ACUIMPA
      *
           PERFORM 26D2-LEER-CLASIFICACION
           PERFORM 26D3-LEER-CAUSACION
           PERFORM 26D4-ACTUALIZAR-UGDTUVR.
      *
      *  COPY DEL PROCEDIMIENTO DE CONVERSION DE UVR A PESOS Y VICEVERSA
           EXEC SQL
                INCLUDE URCPYUVR
           END-EXEC.

      ******************************************************************
      *                 26D2-LEER-CLASIFICACION                        *
      *     ACCESO A LA TABLA CLASIFICACION DE CAPITALES               *
      ******************************************************************
       26D2-LEER-CLASIFICACION.
      *
           MOVE MAE-ENTIOFI                   TO CLS-ENTIOFI
           MOVE MAE-CUENTA                    TO CLS-CUENTA
      *
           EXEC SQL
                 SELECT  REALPROP,
                         PERSPROP,
                         REALRETO,
                         PERSRETO
                   INTO  :CLS-REALPROP,
                         :CLS-PERSPROP,
                         :CLS-REALRETO,
                         :CLS-PERSRETO
                   FROM  UGDTCLS
                   WHERE  ENTIOFI   = :CLS-ENTIOFI     AND
                          CUENTA    = :CLS-CUENTA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              CONTINUE
           ELSE
              MOVE 'UGDTCLS'                  TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT  UGDTCLS'          TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF

      *  CLS-PERSPROP--> CAPITAL PERSONAL PROPIO EN UVR                *
           MOVE CLS-PERSPROP                  TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-PERSPROP

      *  CLS-REALPROP--> CAPITAL REAL PROPIO EN UVR
           MOVE CLS-REALPROP                  TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-REALPROP.

      ******************************************************************
      *                 26D3-LEER-CAUSACION                            *
      *     ACCESO A LA TABLA CAUSACION DE INTERESES                   *
      ******************************************************************
       26D3-LEER-CAUSACION.
      *
           MOVE MAE-ENTIOFI                   TO CAU-ENTIDAD
           MOVE MAE-CUENTA                    TO CAU-CUENTA
      *
           EXEC SQL
                 SELECT  INT_CTES,
                         INT_MORA,
                         INT_CTES_CONT,
                         INT_MORA_CONT,
                         INT_ANT_CLTE
                   INTO  :CAU-INT-CTES,
                         :CAU-INT-MORA,
                         :CAU-INT-CTES-CONT,
                         :CAU-INT-MORA-CONT,
                         :CAU-INT-ANT-CLTE
                   FROM  UGDTCAU
                   WHERE  ENTIOFI   = :CAU-ENTIDAD     AND
                          CUENTA    = :CAU-CUENTA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              CONTINUE
           ELSE
              MOVE 'UGDTCAU'                  TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT INTERESES'         TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF
      *
      *  CAU-INT-CTES--> INETERESES CORRIENTES EN UVR                  *
           MOVE CAU-INT-CTES                  TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-INT-CTES
      *
      *  CAU-INT-CTES-CONT--> INTERESES CORRIENTES CONTINGENTES EN UVR *
           MOVE CAU-INT-CTES-CONT             TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-INT-CTES-CONT
      *
      *  CAU-INT-MORA--> INETERESES MORATORIOS EN UVR                  *
           MOVE CAU-INT-MORA                  TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-INT-MORA
      *
      *  CAU-INT-MORA-CONT--> INTERESES MORATORIOS CONTINGENTES EN UVR *
           MOVE CAU-INT-MORA-CONT             TO UVR-WS-VALOR-PESOS
           PERFORM 2340-HALLAR-UVR
           MOVE UVR-WS-VALOR-UVR              TO UVR-INT-MORA-CONT.

      ******************************************************************
      *                 26D4-ACTUALIZAR-UGDTUVR                        *
      *     ACTUALIZA LOS DATOS DE LA TABLA DE UNIDADES DE VALOR REAL  *
      ******************************************************************
       26D4-ACTUALIZAR-UGDTUVR.
      *
           MOVE MAE-ENTIOFI                   TO UVR-ENTIOFI
           MOVE MAE-CUENTA                    TO UVR-CUENTA
      *
           COMPUTE UVR-LIBRE-IMP1 ROUNDED =
                                       DRB-UGIQUOTA / UVR-WS-COTIZACION
      *
           MOVE C86A-ENTIDAD-CONT             TO UVR-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO UVR-CENTRO-UMO
           MOVE C86A-USUARIO                  TO UVR-USERID-UMO
           MOVE WC-PROGRAMA                   TO UVR-NETNAME-UMO
      *
           EXEC SQL
              UPDATE UGDTUVR
                 SET SALTEOR        = :UVR-SALTEOR      ,
                     SALREAL        = :UVR-SALREAL      ,
                     PERSPROP       = :UVR-PERSPROP     ,
                     REALPROP       = :UVR-REALPROP     ,
                     ACUIMPA        = :UVR-ACUIMPA      ,
                     INT_CTES       = :UVR-INT-CTES     ,
                     INT_CTES_CONT  = :UVR-INT-CTES-CONT,
                     INT_MORA       = :UVR-INT-MORA     ,
                     INT_MORA_CONT  = :UVR-INT-MORA-CONT,
                     LIBRE_IMP1     = :UVR-LIBRE-IMP1   ,
                     ENTIDAD_UMO    = :UVR-ENTIDAD-UMO  ,
                     CENTRO_UMO     = :UVR-CENTRO-UMO   ,
                     USERID_UMO     = :UVR-USERID-UMO   ,
                     NETNAME_UMO    = :UVR-NETNAME-UMO  ,
                     TIMESTAMP      =  CURRENT TIMESTAMP
               WHERE ENTIOFI        = :UVR-ENTIOFI
                 AND CUENTA         = :UVR-CUENTA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           EVALUATE TRUE
              WHEN DB2-OK
                 CONTINUE
              WHEN OTHER
                MOVE 'UGDTUVR'           TO C86A-RET-VAR1-ERROR
                MOVE 'UPDATE UVR      '  TO C86A-RET-VAR2-ERROR
                PERFORM 999999-ABEND-DB2
           END-EVALUATE.

      ******************************************************************
      *             26E-ACTUALIZAR-LOG-PAAI                            *
      *  INSERTAMOS EN LA TABLA UGDTLOG EL REGISTRO QUE INDICA QUE LOS *
      *  INTERESES AI, FUERON COBRADOS EN LA CANCELACION DEL CREDITO   *
      *  CONTRUCTOR                                                    *
      ******************************************************************
       26E-ACTUALIZAR-LOG-PAAI.

             INITIALIZE UGTCLOG
             MOVE MAE-ENTIOFI              TO  LOG-ENTIOFI
             MOVE MAE-CUENTA               TO  LOG-CUENTA
             MOVE WS-DB2-HOY               TO  LOG-FECMOV
             MOVE '0001-01-01'             TO  LOG-FECANT
             MOVE CON-PAAI                 TO  LOG-CODIGO
             MOVE 1                        TO  LOG-CONSOPE
             MOVE 'UGDTMOV'                TO  LOG-TABLA
             MOVE 'COBRO INTERESES AI'     TO  LOG-DESCRIPCION
             MOVE MAE-ENTIOFI(1:4)         TO  LOG-ENTIDAD-UMO
             MOVE MAE-ENTIOFI(5:)          TO  LOG-CENTRO-UMO
             MOVE 'CANCCHQ'                TO  LOG-USERID-UMO
             MOVE WC-PROGRAMA              TO  LOG-NETNAME-UMO
             MOVE WS-INTERES-AI            TO  LOG-IMPNUE

              EXEC SQL
                  INSERT INTO UGDTLOG (
                              LOG_ENTIOFI,
                              LOG_CUENTA,
                              LOG_TIMESTAMP,
                              LOG_CODIGO,
                              LOG_FECMOV,
                              LOG_FECANT,
                              LOG_DESCRIPCION,
                              LOG_ENTIDAD_UMO,
                              LOG_CENTRO_UMO,
                              LOG_USERID_UMO,
                              LOG_NETNAME_UMO,
                              LOG_CONSOPE,
                              LOG_TABLA,
                              LOG_IMPNUE)
                  VALUES (    : LOG-ENTIOFI,
                              : LOG-CUENTA,
                                CURRENT TIMESTAMP ,
                              : LOG-CODIGO,
                              : LOG-FECMOV,
                              : LOG-FECANT,
                              : LOG-DESCRIPCION,
                              : LOG-ENTIDAD-UMO,
                              : LOG-CENTRO-UMO,
                              : LOG-USERID-UMO,
                              : LOG-NETNAME-UMO,
                              : LOG-CONSOPE,
                              : LOG-TABLA,
                              : LOG-IMPNUE)
              END-EXEC
      *
              MOVE SQLCODE       TO DB2-RETURN-CDE
      *
              IF NOT DB2-OK
                 MOVE 'UGDTLOG'              TO C86A-RET-VAR1-ERROR
                 MOVE 'INSERT UGDTLOG   '    TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF.

      ******************************************************************
      *              226-CONSULTAR-DEUDA                               *
      *     SE ACCEDE A LA UGDTMAE PARA TRAER DATOS PARA PROCESO       *
      *     SE TRAEN LOS VALORES DE LA DEUDA DEL CONTRATO PARA PROCEDER*
      *     AL REALIZAR EL PAGO                                        *
      *----------------------------------------------------------------*
       226-CONSULTAR-DEUDA.
      *
           INITIALIZE UGWCI701-01
      *
           MOVE ZEROS                    TO FIN-INTERES
           MOVE WS-ENTIOFI               TO G70-CCC-ENTIOFI
           MOVE WS-CUENTA                TO G70-CCC-CUENTA
           MOVE 'N'                      TO G70-CONSUVR
      *
           CALL BBVA-UR9CI701
                           USING UGWCI701-01
      *
           IF G70ERR-CODIGO-RETORNO  NOT = '00'
              MOVE G70ERR-COD-ERROR         TO C86A-RET-COD-ERROR
              MOVE G70ERR-VAR1-ERROR        TO C86A-RET-VAR1-ERROR
              MOVE G70ERR-VAR2-ERROR        TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *                           27-PRORATA                           *
      *    OPCION DE PAGO POR PRORATA PARA CREDITOS CONSTRUCTOR        *
      ******************************************************************
       27-PRORATA.
      *
           MOVE C86A-IMPORTE-PAGO           TO C86A-TOTAL
                                               WS-MES-IMPORTE
           PERFORM 270-OBTENER-TASAS
           IF PRO-INDISSU NOT EQUAL 'R'
             IF WS-INDINANT = 'A' OR 'P'
               PERFORM 271-CALC-INT-NO-VEN-PRE
             ELSE
               PERFORM 272-CALC-INT-NO-VEN-VEN
             END-IF
           END-IF

           IF MAE-88-INDCUAMA-0
              PERFORM 272-ACTUALIZA-UGDTDRB
           END-IF
           PERFORM 272-ACTUALIZA-UGDTMAE
           PERFORM 272-ACTUALIZA-UGDTCLS
           PERFORM 272-ACTUALIZA-UGDTMOV

           IF WS-INDINANT = 'A' OR 'P'
              MOVE WS-INTERESES-ANTI        TO WS-MES-INTERESE
           ELSE
              MOVE WS-INTERESES             TO WS-MES-INTERESE
           END-IF

      *  SI EL PRESTAMO ES DE UVR SE HARAN LAS CORRESPONDIENTES ACTUA- *
      *  LIZACIONES EN LAS UNIDADES DE VALOR REAL                      *
           IF MAE-LIBRE-CAR6 = 'UVR' OR 'UVRBO'
              PERFORM 26D-ACTUALIZAR-UVR
           END-IF.

      ******************************************************************
      *                      270-OBTENER-TASAS                        *
      *   OBTIENE EL VALOR DE LA TASA DE INTERES NOMINAL Y EFECTIVA   *
      *   ANUAL A APLICAR AL CREDITO                                  *
      ******************************************************************
       270-OBTENER-TASAS.

           INITIALIZE URWCIEN0-AREA
           MOVE MAE-PRODUCTO                  TO IEN-PRODUCTO
           MOVE MAE-ENTIOFI                   TO IEN-ENTIOFI
           MOVE MAE-CUENTA                    TO IEN-CUENTA
           MOVE MAE-INDADMES                  TO IEN-INDADMES
           MOVE MAE-INDLIQES                  TO IEN-INDLIQES
           MOVE MAE-SUBPRO                    TO IEN-SUBPRO
           MOVE MAE-PLAZO                     TO IEN-PLAZO
           MOVE MAE-INDCUAMA                  TO IEN-INDCUAMA
           MOVE MAE-FEULIQ                    TO IEN-FEULIQ
           MOVE MAE-FEFINCAR                  TO IEN-FEFINCAR
           MOVE MAE-FEPROLIQ                  TO IEN-FEPROLIQ

           IF ( MAE-88-SITPRES-7 OR MAE-88-SITPRES-8 )
              MOVE WS-DB2-FEVALOR             TO IEN-FEFORMA
           ELSE
              IF ( MAE-88-SITPRES-9 OR MAE-88-SITPRES-A )
                 MOVE MAE-FECSIT              TO IEN-FEFORMA
              ELSE
                 MOVE MAE-FECAPROBA           TO IEN-FEFORMA
              END-IF
           END-IF

           IF ( MAE-88-SITPRES-7 OR MAE-88-SITPRES-8 OR
              MAE-88-SITPRES-A OR MAE-88-SITPRES-9 )
              MOVE MAE-FEFORMA                TO IEN-FECHA-HOY
           ELSE
              IF ( MAE-FEVENCIN < WS-DB2-FEVALOR )
                 MOVE MAE-FEVENCIN            TO IEN-FECHA-HOY
              ELSE
                 MOVE WS-DB2-FEVALOR          TO IEN-FECHA-HOY
              END-IF
           END-IF

      *-- Si el prestamo est┬á vencido se buscaran las condiciones a la
      *      fecha de Vencimiento
      *   Si el prestamo es un cuadro manual cerrado se tratara como si
      *      estuviese abierto
           IF ( MAE-FEVENCIN < WS-DB2-FEVALOR )
              MOVE MAE-FEVENCIN               TO IEN-FECHA-HOY
              IF ( MAE-INDCUAMA  = '1' )
                 MOVE '2'                     TO IEN-INDCUAMA
              END-IF
           END-IF

      *-- Si el prestamo no est┬á ni siquiera Formalizado se buscaran
      *      los Intereses a la fecha Valor
           IF ( MAE-FEVENCIN = '0001-01-01'  AND
              MAE-FEULIQ   = '0001-01-01' )
                 MOVE WS-DB2-FEVALOR          TO IEN-FECHA-HOY
                                                 IEN-FEULIQ
                                                 IEN-FEPROLIQ
           END-IF
      *-- Prestamo es Cuadro Manual Abierto
           IF ( MAE-INDCUAMA = '2' )
              IF ( MAE-FEVENCIN = '0001-01-01' OR
                 MAE-FEFORMA  = '0001-01-01' OR
                 MAE-FEPROLIQ = '0001-01-01' )
                 MOVE 0                       TO IEN-NOMINAL
                 MOVE 0                       TO IEN-EFECTIVA
                 MOVE '1001'                  TO IEN-PERINT
                 MOVE '1001'                  TO IEN-PERCAPIT
                 MOVE 'C'                     TO IEN-DIASCAL
                 MOVE '9999-12-31'            TO IEN-FEFIVALI
                 MOVE '00'                    TO IEN-CORESPUE
              ELSE
                 PERFORM 270-LLAMADO-UR8CIEN0
              END-IF
           ELSE
              PERFORM 270-LLAMADO-UR8CIEN0
           END-IF.

      ******************************************************************
      *             241-LLAMADO-UR8CIEN0                              *
      *   REALIZA EL LLAMADO A LA RUTINA DE OBTENCION DE TASAS DE     *
      *   INTERES DE UN CREDITO                                       *
      ******************************************************************
       270-LLAMADO-UR8CIEN0.

           CALL BBVA-UR8CIEN0 USING URWCIEN0-AREA

           IF ( IEN-CORESPUE NOT = CTE-CON-ALFA-00 )
              IF ( IEN-CORESPUE = '95' )
                 IF ( IEN-TABLENAME = 'UGDTQUM' )
      *-- Manejo error en la Tabl QUM Ultimo recibo
                    MOVE 0                  TO IEN-EFECTIVA
                    MOVE 0                  TO IEN-NOMINAL
                    MOVE '1001'             TO IEN-PERINT
                    MOVE '1001'             TO IEN-PERCAPIT
                    MOVE 'C'                TO IEN-DIASCAL
                    MOVE '9999-12-31'       TO IEN-FEFIVALI
                    MOVE '00'               TO IEN-CORESPUE
                 ELSE
                    MOVE IEN-SQLCODE        TO SQLCODE
                    MOVE IEN-TABLENAME      TO C86A-RET-VAR1-ERROR
                    MOVE IEN-CORESPUE       TO C86A-RET-VAR1-ERROR(17:4)
                    MOVE 'CALL RUTINA '     TO C86A-RET-VAR2-ERROR(1:12)
                    MOVE IEN-PROGRAMA       TO C86A-RET-VAR2-ERROR(13:)
                    PERFORM 999999-ABEND-DB2
                 END-IF
              ELSE
                 IF ( IEN-CORESPUE = '99' )
                    MOVE IEN-SQLCODE        TO SQLCODE
                    MOVE IEN-TABLENAME      TO C86A-RET-VAR1-ERROR
                    MOVE IEN-CORESPUE       TO C86A-RET-VAR1-ERROR(17:4)
                    MOVE 'CALL RUTINA '     TO C86A-RET-VAR2-ERROR(1:12)
                    MOVE IEN-PROGRAMA       TO C86A-RET-VAR2-ERROR(13:)
                    PERFORM 999999-ABEND-DB2
                 END-IF
              END-IF
           END-IF.

      ******************************************************************
      *              271-CALC-INT-NO-VEN-PRE                          *
      *   CALCULO DE INTERESES NO VENCIDOS PARA CREDITOS CON TIPO DE  *
      *   VENCIMIENTO ANTICIPADO                                      *
      *   LA FORMULA PARA CALCULAR LOS IMPORTES NO VENCIDOS ES:       *
      *   SALDO TEORICO + INTERESES                                   *
      *INTERESES = SALDO TEORICO * NUM DE DIAS DESDE LA FECHA ULTIMA  *
      *     LIQ * TIPO DE INTERES / DIAS POR A├æO + INTDEVEN           *
      ******************************************************************
       271-CALC-INT-NO-VEN-PRE.

           MOVE MAE-FEPROLIQ                  TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA                      TO WS-AUX-AAAA
           MOVE AUX-MM                        TO WS-AUX-MM
           MOVE AUX-DD                        TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA             TO W175-FHGRE1
           MOVE WS-DB2-FEVALOR                TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA                      TO WS-AUX-AAAA
           MOVE AUX-MM                        TO WS-AUX-MM
           MOVE AUX-DD                        TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA             TO W175-FHGRE2

           PERFORM 271-LLAMADO-TC8C1220

           MOVE W175-NUMDIAS                  TO WS-NUMEDIAS
           MULTIPLY CTE-CON-100-COMP3         BY WS-DIASCAL

           INITIALIZE URWCFIN
           MOVE C86A-IMPORTE-PAGO             TO FIN-CAPITAL

           PERFORM 2711-LLAMADO-UR8CFIN0

           MOVE FIN-INTERES                   TO WS-INTERESES-ANTI
           IF ((WS-DIASCAL NOT = 'N') AND (MAE-INTDEVEN = CTE-CON-0))

              MOVE WS-DB2-FEVALOR             TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE2
              IF ( MAE-FEULIES > MAE-FEULIQ )
                 MOVE MAE-FEULIES             TO WS-FECHA-2
              ELSE
                 MOVE MAE-FEULIQ              TO WS-FECHA-2
              END-IF
              MOVE WS-FECHA-2                 TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE1

              PERFORM 271-LLAMADO-TC8C1220

              MOVE W175-NUMDIAS               TO WS-NUMEDIAS2
              IF ( WS-CODTIAMO  =  CTE-CON-B )
                 MOVE MAE-UGIIIANA            TO WS-CAP-CO
              ELSE
                 MOVE MAE-SALTEOR             TO WS-CAP-CO
              END-IF
              ADD WS-NUMEDIAS  WS-NUMEDIAS2   GIVING WS-DIAS-TOTALES

              PERFORM 2712-DIF-DIAS-COMERCIAL

              MOVE WS-CAP-CO                  TO FIN-CAPITAL
              COMPUTE FIN-PERIODO-NUM = (( WS-DIAS-TOTALES /
                                            CTE-CON-365-COMP3 -
                                            WS-DIAS-CO /
                                            CTE-CON-360-COMP3) *
                                            WS-DIASCAL )
              PERFORM 2711-LLAMADO-UR8CFIN0

              COMPUTE WS-INTERESES-ANTI = WS-INTERESES-ANTI -
                                          FIN-INTERES
           END-IF
           MULTIPLY WS-INTERESES-ANTI BY -1  GIVING WS-INTERESES-ANTI.

      ******************************************************************
      *               271-LLAMADO-TC8C1220                            *
      *   REALIZA EL LLAMADO A LA RUTINA DE CALCULO DE DIAS ENTRE     *
      *   DOS FECHAS (TC8C1220)                                       *
      ******************************************************************
       271-LLAMADO-TC8C1220.

           EVALUATE WS-INDINANT
              WHEN 'N'
                   MOVE CTE-365                 TO WS-DIASCAL
                   MOVE CTE-CON-NA              TO W175-TPTRAT
              WHEN 'X'
                   MOVE CTE-360                 TO WS-DIASCAL
                   MOVE CTE-CON-NA              TO W175-TPTRAT
              WHEN 'C'
                   MOVE CTE-360                 TO WS-DIASCAL
                   MOVE CTE-CON-CO              TO W175-TPTRAT
              WHEN 'P'
                   MOVE CTE-365                 TO WS-DIASCAL
                   MOVE CTE-CON-CO              TO W175-TPTRAT
              WHEN OTHER
                   MOVE CTE-360                 TO WS-DIASCAL
                   MOVE CTE-CON-CO              TO W175-TPTRAT
           END-EVALUATE

           MOVE CTE-CON-3                       TO W175-CDOPCIO
           MOVE ZEROS                           TO W175-NUMDIAS
      *COL01-I
      *@COL11-I
      *    IF WS-CODTIPRE(1:2) = 'IB'
           IF WS-CODTIPRE(1:2) EQUAL CTE-IB OR CTE-IP
      *@COL11-F
              MOVE CTE-CON-NA              TO W175-TPTRAT
           END-IF
      *COL01-F
           CALL BBVA-TC8C1220 USING  TCWC1750

           IF ( W175-CDRETORN NOT = CTE-CON-ALFA-00 )
              MOVE 'UGE0517'                    TO C86A-RET-COD-ERROR
              MOVE 'TC8C1220'                   TO C86A-RET-VAR1-ERROR
              MOVE 'CALC-INT-NO-VEN-PRE'        TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *              2711-LLAMADO-UR8CFIN0                            *
      *   EFECTUA EL LLAMADO A LA RUTINA DE CALCULO DE INTERESES      *
      ******************************************************************
       2711-LLAMADO-UR8CFIN0.

           MOVE IEN-NOMINAL                   TO FIN-TIPINT
           MOVE 'N'                           TO FIN-TIPOTASA
           MOVE IEN-PERCAPIT                  TO FIN-PERCAPIT
           MOVE IEN-PERINT                    TO FIN-PERINT
           MOVE IEN-DIASCAL                   TO FIN-DIASCAL
           MOVE WS-MES-IMPORTE                TO FIN-CAPITAL
           MOVE WS-NUMEDIAS                   TO FIN-PERIODO-NUM
      *COL01-I
           MOVE WS-CODTIPRE                TO FIN-CDRETORNO
           MOVE WS-CODTIAMO                TO FIN-MODULRES
           MOVE MAE-FEULIQ(1:4)            TO FIN-MODULRES(2:4)
      *COL01-F
           CALL BBVA-UR8CFIN0  USING URWCFIN

           EVALUATE FIN-CDRETORNO
              WHEN '00'
                 CONTINUE
              WHEN OTHER
                 MOVE 'UGE1590'               TO C86A-RET-COD-ERROR
                 MOVE 'UR8CFIN0'              TO C86A-RET-VAR1-ERROR
                 MOVE 'CALCULO DE INTERES.'   TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.

      ******************************************************************
      *              2712-DIF-DIAS-COMERCIAL                          *
      *   SE CALCULAN LA DIFERENCIA DE DIAS COMERCIALES QUE HAY       *
      *   ENTRE LA ULTIMA FECHA DE LIQUIDACION Y LA PROXIMA           *
      ******************************************************************
       2712-DIF-DIAS-COMERCIAL.

           MOVE CTE-CON-CO                    TO W175-TPTRAT

           IF ( MAE-FEULIES > MAE-FEULIQ )
              MOVE MAE-FEULIES                TO AUX-AAAA-MM-DD
           ELSE
              MOVE MAE-FEULIQ                 TO AUX-AAAA-MM-DD
           END-IF

           MOVE AUX-AAAA                      TO WS-AUX-AAAA
           MOVE AUX-MM                        TO WS-AUX-MM
           MOVE AUX-DD                        TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA             TO W175-FHGRE1
           MOVE MAE-FEPROLIQ                  TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA                      TO WS-AUX-AAAA
           MOVE AUX-MM                        TO WS-AUX-MM
           MOVE AUX-DD                        TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA             TO W175-FHGRE2
           MOVE CTE-CON-3                     TO W175-CDOPCIO
           MOVE ZEROS                         TO W175-NUMDIAS

           CALL BBVA-TC8C1220 USING TCWC1750

           IF ( W175-CDRETORN NOT = CTE-CON-ALFA-00 )
              MOVE 'UGE1330'                  TO C86A-RET-COD-ERROR
              MOVE 'TC8C1220'                 TO C86A-RET-VAR1-ERROR
              MOVE 'TC8C1220 -DIF FECHAS'     TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF
           MOVE W175-NUMDIAS                  TO WS-DIAS-CO.

      ******************************************************************
      *              272-CALC-INT-NO-VEN-VEN                          *
      *   CALCULO DE INTERESES NO VENCIDOS PARA CREDITOS CON TIPO DE  *
      *   VENCIMIENTO VENCIDO                                         *
      *   LA FORMULA PARA CALCULAR LOS IMPORTES NO VENCIDOS ES:       *
      *   SALDO TEORICO + INTERESES                                   *
      *INTERESES = SALDO TEORICO * NUM DE DIAS DESDE LA FECHA ULTIMA  *
      *   LIQ * TIPO DE INTERES / DIAS POR A├æO + INTDEVEN             *
      ******************************************************************
       272-CALC-INT-NO-VEN-VEN.

           IF ( MAE-FEULIES > MAE-FEULIQ )
              MOVE MAE-FEULIES                TO WS-FECHA-2
           ELSE
              MOVE MAE-FEULIQ                 TO WS-FECHA-2
           END-IF
           MOVE WS-FECHA-2                    TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA                      TO WS-AUX-AAAA
           MOVE AUX-MM                        TO WS-AUX-MM
           MOVE AUX-DD                        TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA             TO W175-FHGRE1
           MOVE WS-DB2-FEVALOR                TO AUX-AAAA-MM-DD
           MOVE AUX-AAAA                      TO WS-AUX-AAAA
           MOVE AUX-MM                        TO WS-AUX-MM
           MOVE AUX-DD                        TO WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA             TO W175-FHGRE2

           PERFORM 271-LLAMADO-TC8C1220

           MOVE W175-NUMDIAS                  TO WS-NUMEDIAS
           MULTIPLY CTE-CON-100-COMP3         BY WS-DIASCAL

           INITIALIZE URWCFIN
           MOVE C86A-IMPORTE-PAGO             TO FIN-CAPITAL

           PERFORM 2711-LLAMADO-UR8CFIN0

           MOVE FIN-INTERES                   TO WS-INTERESES.

      ******************************************************************
      *                   272-ACTUALIZA-UGDTDRB-CAP                    *
      *     ACTUALIZA CAPITAL EN LA TABLA UGDTDRB PARA PRORATA         *
      ******************************************************************
       272-ACTUALIZA-UGDTDRB.
      *
           MOVE  MAE-ENTIOFI                TO DRB-ENTIOFI
           MOVE  MAE-CUENTA                 TO DRB-CUENTA

           EXEC SQL
               SELECT UGNINFAC,
                      UGIQUOTA,
                      UGNPLPEN,
                      UGYINAPL,
                      UGSPDREB
               INTO :DRB-UGNINFAC,
                    :DRB-UGIQUOTA,
                    :DRB-UGNPLPEN,
                    :DRB-UGYINAPL,
                    :DRB-UGSPDREB
               FROM UGDTDRB
               WHERE ENTIOFI = :DRB-ENTIOFI
                 AND CUENTA  = :DRB-CUENTA
           END-EXEC

           MOVE SQLCODE                     TO DB2-RETURN-CDE
      *
           IF NOT  DB2-OK
               IF  DB2-NOTFND
                   MOVE CTE-CON-UGB0004     TO C86A-RET-COD-ERROR
                   MOVE 'UGDTDRB'           TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               ELSE
                   MOVE 'UGDTDRB'           TO C86A-RET-VAR1-ERROR
                   MOVE 'SELECT  UGDTDRB'   TO C86A-RET-VAR2-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF
      *
           ADD  CTE-CON-1                   TO DRB-UGNINFAC
           MOVE MAE-PLAZO                   TO DRB-UGCPLAZO
      *
           COMPUTE WS-DIF-PLAZOS = BCR-PLAPEN - WS-M-FINAL
           IF BCR-FVTO NOT < BCR-FPPAGO
               ADD 1 TO WS-DIF-PLAZOS
           END-IF
           MOVE 0                           TO DRB-UGPQSACT
      *
      * VARIABLE PARA EL SALDO TEORICO UNICAMENTE PARA CAPITALIZABLES
           IF WS-CODTIAMO  = 'D' OR WS-CODTIAMO = 'E'
              COMPUTE DRB-UGSPDREB  = DRB-UGSPDREB - WS-MES-IMPORTE
           END-IF
      *
           MOVE  '1'                        TO DRB-UGYINAPL
           MOVE  WC-PROGRAMA                TO DRB-NETNAME-UMO
           IF C86A-USUARIO = CTE-PROG-TC0
              MOVE WC-PROGRAMA-T0           TO DRB-NETNAME-UMO
           END-IF
           MOVE  C86A-USUARIO               TO DRB-USERID-UMO
           MOVE  C86A-ENTIDAD-CONT          TO DRB-ENTITAT-UMO
           MOVE  C86A-CENTRO-CONT           TO DRB-CENTRE-UMO
      *
           EXEC SQL
               UPDATE UGDTDRB
               SET UGPQSACT     = :DRB-UGPQSACT,
                   UGNINFAC     = :DRB-UGNINFAC,
                   UGCPLAZO     = :DRB-UGCPLAZO,
                   UGIQUOTA     = :DRB-UGIQUOTA,
                   UGYINAPL     = :DRB-UGYINAPL,
                   NETNAME_UMO  = :DRB-NETNAME-UMO,
                   USERID_UMO   = :DRB-USERID-UMO,
                   ENTITAT_UMO  = :DRB-ENTITAT-UMO,
                   CENTRE_UMO   = :DRB-CENTRE-UMO,
                   STAMP_UMO    = CURRENT TIMESTAMP,
      ******  VARIABLE PARA EL SALDO TEORICO                       *****
                   UGSPDREB     = :DRB-UGSPDREB
               WHERE ENTIOFI = :DRB-ENTIOFI
                 AND CUENTA  = :DRB-CUENTA
           END-EXEC

           MOVE SQLCODE                     TO DB2-RETURN-CDE
      *
           IF NOT  DB2-OK
              MOVE 'UGDTDRB'                TO C86A-RET-VAR1-ERROR
              MOVE 'UPDATE  UGDTDRB'        TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *                     272-ACTUALIZA-UGDTMAE                      *
      *     ACTUALIZA CAPITAL EN LA TABLA UGDTMAE PARA PRORATA         *
      ******************************************************************
       272-ACTUALIZA-UGDTMAE.
      *

           MOVE  MAE-SALTEOR                  TO  WS-SALTEOR-ANT
           MOVE  MAE-FEFINCAR                 TO  WS-FEFINCAR-ANT
           MOVE  MAE-FEULIES                  TO  WS-FEULIES-ANT
           MOVE  MAE-FEPROAMO                 TO  WS-FEPROAMO-ANT
           MOVE  MAE-FEVENCIN                 TO  WS-FEVENCIN-ANT
           MOVE  MAE-INTDEVEN                 TO  WS-INTDEVEN-ANT
           MOVE  MAE-FECSAL                   TO  WS-FECSAL-ANT
           MOVE  MAE-FEULAMES                 TO  WS-FEULAMES-ANT
           MOVE  MAE-UGIIIANA                 TO  WS-UGIIIANA-ANT
           MOVE  MAE-UGYCATAE                 TO  WS-UGYCATAE-ANT
           MOVE  ZERO                         TO  MAE-INTDEVEN
      *
           SUBTRACT WS-MES-IMPORTE       FROM MAE-SALTEOR
               GIVING  MAE-SALTEOR
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-SUBTRACT
      *
           MOVE  MAE-SALREAL                  TO WS-SALREAL-INICIAL
      *
           SUBTRACT WS-MES-IMPORTE       FROM MAE-SALREAL
               GIVING  MAE-SALREAL
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-SUBTRACT
      *
           IF WS-CODTIAMO  = CTE-CON-B
              SUBTRACT  WS-MES-IMPORTE  FROM MAE-UGIIIANA
                 GIVING  MAE-UGIIIANA
                 ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
              END-SUBTRACT
           END-IF
      *
           MOVE  WS-DB2-FEVALOR               TO MAE-FECSAL
                                                 MAE-FEULAMES
           MOVE  CTE-CON-1                    TO MAE-UGYCATAE
           MOVE  MAE-PLAZO                    TO WS-PLAZO-ANT
      *
           IF MAE-FEVENCIN  NOT EQUAL WS-FEVENCIN-ANT
              PERFORM  2611-RECALCULAR-PLAZO
           END-IF
      *
           MOVE WS-ENTIOFI                    TO MAE-ENTIOFI
           MOVE WS-CUENTA                     TO MAE-CUENTA
           MOVE C86A-ENTIDAD-CONT             TO MAE-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO MAE-CENTRO-UMO
           MOVE C86A-USUARIO                  TO MAE-USERID-UMO
           MOVE WC-PROGRAMA                   TO MAE-NETNAME-UMO
           IF C86A-USUARIO = CTE-PROG-TC0
              MOVE WC-PROGRAMA-T0             TO MAE-NETNAME-UMO
           END-IF
      *
           EXEC SQL
             UPDATE  UGDTMAE
               SET
                 FEPROAMO    = :MAE-FEPROAMO,
                 FEVENCIN    = :MAE-FEVENCIN,
                 SALTEOR     = :MAE-SALTEOR,
                 SALREAL     = :MAE-SALREAL,
                 FECSAL      = :MAE-FECSAL,
                 INDLIQES    = :MAE-INDLIQES,
                 PLAZO       = :MAE-PLAZO ,
                 FEULAMES    = :MAE-FEULAMES,
                 FEFINCAR    = :MAE-FEFINCAR,
                 FEULIES     = :MAE-FEULIES,
                 INTDEVEN    = :MAE-INTDEVEN,
                 UGIIIANA    = :MAE-UGIIIANA,
                 UGYCATAE    = :MAE-UGYCATAE,
                 TIMESTAMP   = CURRENT TIMESTAMP,
                 NETNAME_UMO = :MAE-NETNAME-UMO,
                 USERID_UMO  = :MAE-USERID-UMO,
                 ENTIDAD_UMO = :MAE-ENTIDAD-UMO,
                 CENTRO_UMO  = :MAE-CENTRO-UMO
               WHERE
                       ENTIOFI   = :MAE-ENTIOFI      AND
                       CUENTA    = :MAE-CUENTA       AND
                       TIMESTAMP = :WS-TIMESTAMP
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT  DB2-OK
              MOVE 'UGDTMAE'                  TO C86A-RET-VAR1-ERROR
              MOVE 'UPDATE UGDTMAE'           TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *                    272-ACTUALIZA-UGDTCLS                       *
      *     ACTUALIZA CAPITAL EN LA TABLA UGDTCLS PARA PRORATA         *
      ******************************************************************
       272-ACTUALIZA-UGDTCLS.
      *
           INITIALIZE COMM-AREA-UR7CCLS0
           INITIALIZE UGTCMVR URWCCLS
      *
           MOVE WS-ENTIOFI                   TO CLS-WS-ENTIOFI
           MOVE WS-CUENTA                    TO CLS-WS-CUENTA
           MOVE '0'                          TO CLS-WS-TIPO-OPER
           MOVE '1'                          TO CLS-WS-TIPO-PAGO
           MOVE 'N'                          TO CLS-WS-IND-MARCA2
           MOVE WS-MES-IMPORTE               TO CLS-WS-CAPINIRE
      *
           IF WS-INDINANT = 'A' OR WS-INDINANT = 'P'
              MOVE WS-INTERESES-ANTI         TO CLS-WS-INTINIRE
           ELSE
              MOVE WS-INTERESES              TO CLS-WS-INTINIRE
              IF SW-TIPO-PAGO-PRORATA
                 MOVE 0                      TO CLS-WS-INTINIRE
              END-IF
           END-IF

           MOVE ZEROS                        TO CLS-WS-CORINIRE
           MOVE ZEROS                        TO CLS-WS-GASINIRE
           MOVE 0                            TO CLS-WS-COMINIRE
           MOVE 0                            TO CLS-WS-MORATORIO
           MOVE 0                            TO CLS-WS-COMPENSATORIO
           MOVE WS-INDINANT                  TO CLS-WS-INDINANT
           MOVE URWCCLS                      TO COMM-AREA-URWCCLS
           MOVE UGTCMVR                      TO COMM-AREA-UGTCMVR
      *
           CALL BBVA-UR9CCLS0 USING AREA-UR9CCLS0
      *
           MOVE COMM-AREA-URWCCLS            TO URWCCLS
      *
           IF CLS-WS-INDCOND = '000' OR SPACES OR LOW-VALUES
              CONTINUE
           ELSE
              EVALUATE CLS-WS-INDCOND
                 WHEN '010'
                    MOVE 'UGE3406'           TO C86A-RET-COD-ERROR
                    MOVE CLS-WS-TABLAERR     TO C86A-RET-VAR1-ERROR
                    MOVE CLS-WS-SQLCODE      TO C86A-RET-VAR1-ERROR(10:)
                    MOVE 'UR9CCLS0'          TO C86A-RET-VAR2-ERROR
                 WHEN '020'
                    MOVE 'UGE3400'           TO C86A-RET-COD-ERROR
                    MOVE 'UR9CCLS0'          TO C86A-RET-VAR1-ERROR
                    MOVE CLS-WS-TABLAERR     TO C86A-RET-VAR2-ERROR
                 WHEN '030'
                    MOVE 'UGE3402'           TO C86A-RET-COD-ERROR
                    MOVE 'UR9CCLS0'          TO C86A-RET-VAR1-ERROR
                    MOVE CLS-WS-TABLAERR     TO C86A-RET-VAR2-ERROR
                 WHEN OTHER
                    MOVE 'UGE0517'           TO C86A-RET-COD-ERROR
                    MOVE 'UR9CCLS0'          TO C86A-RET-VAR1-ERROR
                    MOVE CLS-WS-INDCOND      TO C86A-RET-VAR2-ERROR
              END-EVALUATE
              PERFORM  3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *                   272-ACTUALIZA-UGDTMOV                        *
      *     ACTUALIZA CAPITAL EN LA TABLA UGDTMOV PARA PRORATA         *
      ******************************************************************
       272-ACTUALIZA-UGDTMOV.
      *

           MOVE MAE-ENTIDAD-VIN               TO MOV-ENTIDAD-PAG
           MOVE MAE-CENTRO-VIN                TO MOV-CENTRO-PAG
           MOVE MAE-CUENTA-VIN                TO MOV-CUENTA-PAG
           MOVE MAE-DIGICCC1-VIN              TO MOV-DIGICCC1-PAG
           MOVE MAE-DIGICCC2-VIN              TO MOV-DIGICCC2-PAG
           MOVE WS-DB2-FEVALOR                TO MOV-FEVALOR
                                                 MOV-FECONTA
                                                 MOV-FEOPER
           MOVE  CTE-CON-ABONO                TO MOV-CLAOPER
           MOVE  MAE-ENTIOFI(1:4)             TO WS-ENTIDAD
           MOVE  MAE-ENTIOFI(5:4)             TO WS-CENTRO
