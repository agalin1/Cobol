                :MOV-FEOPER,
                :WS-DB2-FEVALOR,
                :MOV-ENTIOPE,
                :MOV-CLACON,
                :MOV-IMPMOVI,
                :MOV-INDRETRO,
                :MOV-FELIQ,
                :MOV-SALREAL,
                :MOV-UGYINDIF,
                :MOV-IND-MARCA1,
                :MOV-IND-MARCA2,
                :MOV-ENTIDAD-PAG,
                :MOV-CENTRO-PAG,
                :MOV-CUENTA-PAG,
                :MOV-DIGICCC1-PAG,
                :MOV-DIGICCC2-PAG,
                :MOV-UGYINCOR,
                :MOV-CLADIS,
                :MOV-NETNAME-UMO,
                :MOV-USERID-UMO,
                :MOV-ENTIDAD-UMO,
                :MOV-CENTRO-UMO,
                :MOV-RUTA,
                :MOV-MONEDA,
                :MOV-NUMER-MOV,
      ***** INCLUSION DE VARIABLES PARA PODER REALIZAR LA ANULACION*****
      ***** DE LA TRANSACCION EN LA RUTINA UR7CCLS0                *****
                :MOV-LIBRE-IMP1,
                :MOV-LIBRE-IMP2,
