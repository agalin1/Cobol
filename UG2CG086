      ******************************************************************
       22725-AJUSTA-CUOTA.

           PERFORM 227251-BUSCA-ENTIDAD

           IF ENT-LIBRE2(1:1) = 'S'
              COMPUTE WS-CUOTA-RED ROUNDED = COT-CUOTA * 1
              MOVE WS-CUOTA-RED      TO COT-CUOTA
           END-IF.

      ******************************************************************
      * BUSCA LA ENTIDAD DE REDESCUENTO PARA VERIFICAR SI AJUSTA CUOTA *
      ******************************************************************
       227251-BUSCA-ENTIDAD.

           INITIALIZE USTCENT

           IF MAE-INDADMES = 'S'
              MOVE ADE-ENTSUB              TO ENT-CODENTIT
           ELSE
              MOVE ADS-ENTSUB              TO ENT-CODENTIT
           END-IF

           EXEC SQL
                SELECT LIBRE2
                INTO :ENT-LIBRE2
                FROM USDTENT
                WHERE CODENTIT = :ENT-CODENTIT
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'USDTENT'               TO C86A-RET-VAR1-ERROR
              MOVE 'SELECT USDTENT'        TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      *----------------------------------------------------------------*
      *         2475-PRIMER-RECIBO                                     *
      * CALCULA EL IMPORTE DEL PROXIMO RECIBO                          *
      ******************************************************************
       2475-PRIMER-RECIBO.
      *
           IF WS-INDINANT      = 'A' OR 'P'
              MOVE WS-DB2-FEVALOR             TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE1
      *
              MOVE MAE-FEPROLIQ               TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE2
      *
              PERFORM  24451-LLAMAR-TC8C1220
              MOVE WS-DIAS                    TO WS-VALOR-PROLIQ
      *
              COMPUTE  WS-CAPITAL ROUNDED = WG07-CAPITAL
      *
              PERFORM 24452-LLAMADO-UR8CFIN0
      *
              COMPUTE  WS-INTER ROUNDED = FIN-INTERES
      *
              MULTIPLY WS-INTER BY -1 GIVING WS-INTDEVEN
           ELSE
              IF COT-TIP-CUOTA = 'J'
                 MOVE ZEROS                   TO WS-INTER
                                                 WS-INTDEVEN
                                                 WS-INTERES-TOTAL
              ELSE
                 IF MAE-FEULIES      > MAE-FEULIQ
                    MOVE MAE-FEULIES          TO AUX-AAAA-MM-DD
                    MOVE AUX-AAAA             TO WS-AUX-AAAA
                    MOVE AUX-MM               TO WS-AUX-MM
                    MOVE AUX-DD               TO WS-AUX-DD
                    MOVE WS-AUX-DD-MM-AAAA    TO W175-FHGRE1
                 ELSE
                    MOVE MAE-FEULIQ           TO AUX-AAAA-MM-DD
                    MOVE AUX-AAAA             TO WS-AUX-AAAA
                    MOVE AUX-MM               TO WS-AUX-MM
                    MOVE AUX-DD               TO WS-AUX-DD
                    MOVE WS-AUX-DD-MM-AAAA    TO W175-FHGRE1
                 END-IF
      *
                 MOVE  WS-DB2-FEVALOR         TO AUX-AAAA-MM-DD
                 MOVE  AUX-AAAA               TO WS-AUX-AAAA
                 MOVE  AUX-MM                 TO WS-AUX-MM
                 MOVE  AUX-DD                 TO WS-AUX-DD
                 MOVE  WS-AUX-DD-MM-AAAA      TO W175-FHGRE2
      *
                 PERFORM  24451-LLAMAR-TC8C1220
                 MOVE WS-DIAS                 TO WS-VALOR-FEULIQ
      *
                 COMPUTE  WS-CAPITAL ROUNDED = WG07-CAPITAL
      *
                 PERFORM 24452-LLAMADO-UR8CFIN0
                 COMPUTE WS-INTER  ROUNDED = FIN-INTERES
      *
                 MOVE WS-INTER                TO WS-INTDEVEN
              END-IF
      *
              MOVE MAE-FEPROLIQ               TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE2
      *
              MOVE MAE-FEULIQ                 TO AUX-AAAA-MM-DD
              MOVE AUX-AAAA                   TO WS-AUX-AAAA
              MOVE AUX-MM                     TO WS-AUX-MM
              MOVE AUX-DD                     TO WS-AUX-DD
              MOVE WS-AUX-DD-MM-AAAA          TO W175-FHGRE1
      *
              PERFORM  24451-LLAMAR-TC8C1220
              MOVE WS-DIAS                    TO WS-DIAS-NAT
      * SE MANEJAN LOS MISMOS DIAS EN UG2CG070
                                                 WS-DIAS-COM
      *
              PERFORM 24751-CALCULO-INTERES
           END-IF
      *
           IF MAE-FEPROLIQ > MAE-FEFINCAR
              IF WS-CODTIAMO = '1'   OR WS-CODTIAMO = 'G' OR
                 WS-CODTIAMO = '7'   OR WS-CODTIAMO = 'R' OR
                 WS-CODTIAMO = 'B'   OR WS-CODTIAMO = '3' OR
                 WS-CODTIAMO = 'I'   OR
                 WS-CODTIAMO = 'L'   OR
                 WS-CODTIAMO = 'P'   OR WS-CODTIAMO = '5'
                 PERFORM 24752-OBTENER-INT-CUOTA
      *
                 SUBTRACT WS-INTERES-CUOTA FROM WS-MES-CUOTAO1
                   GIVING WS-CAPITAL1
                 SUBTRACT WS-INTERES-CUOTA FROM WS-MES-CUOTAO2
                   GIVING WS-CAPITAL2
              ELSE
                 MOVE WS-MES-CUOTAO1          TO WS-CAPITAL1
                 MOVE WS-MES-CUOTAO2          TO WS-CAPITAL2
              END-IF
           ELSE
              MOVE 0                          TO WS-CAPITAL1
              MOVE 0                          TO WS-CAPITAL2
           END-IF
      *
           MOVE WS-MES-CUOTAO1             TO WS-RECIBO1
           MOVE WS-MES-CUOTAO2             TO WS-RECIBO2
      *
           COMPUTE WS-RECIBO1 = WS-RECIBO1  + WS-PORTES +
                              + WS-GASADM
      *
           COMPUTE WS-RECIBO2 = WS-RECIBO2  + WS-PORTES +
                              + WS-GASADM.

      ******************************************************************
      *  24751-CALCULO-INTERES                                         *
      *   CALCULA LOS INTERESES A APLICAR AL SIGUIENTE RECIBO DEL      *
      *   CREDITO   (FEULIQ HASTA FEPROLIQ)                            *
      ******************************************************************
       24751-CALCULO-INTERES.
      *
           IF WS-CODTIAMO = 'B'
              IF WS-INTDEVEN = 0 OR WS-INDINANT = 'A' OR 'P'
                 COMPUTE WS-CAPITAL ROUNDED =
                         (MAE-UGIIIANA - WG07-CAPITAL)
                 COMPUTE WS-DIAS = WS-DIAS-COM
              ELSE
                 COMPUTE WS-CAPITAL ROUNDED =
                         (MAE-UGIIIANA - WG07-CAPITAL)
                 COMPUTE WS-DIAS = WS-DIAS-NAT
              END-IF
           ELSE
              IF WS-INTDEVEN = 0 OR WS-INDINANT = 'A' OR 'P'
                 COMPUTE WS-CAPITAL ROUNDED =
                         (MAE-SALTEOR  - WG07-CAPITAL)
                 COMPUTE WS-DIAS = WS-DIAS-COM
              ELSE
                 COMPUTE WS-CAPITAL ROUNDED =
                         (MAE-SALTEOR  - WG07-CAPITAL)
                 COMPUTE WS-DIAS = WS-DIAS-NAT
              END-IF
           END-IF
      *
           PERFORM 24452-LLAMADO-UR8CFIN0
      *
           MOVE FIN-INTERES                   TO WS-INTERES
           MOVE 0                             TO WS-TERMINO-CORRECCION
      *
           ADD WS-INTERES WS-TERMINO-CORRECCION WS-INTDEVEN
               GIVING WS-INTERES-TOTAL.

      ******************************************************************
      *             24752-OBTENER-INT-CUOTA                            *
      *    CALCULA LA PARTE DE CUOTA CORRESPONDIENTE A INTERESES       *
      ******************************************************************
       24752-OBTENER-INT-CUOTA.
      *
           IF WS-CODTIAMO = 'B'
              IF WS-UGYFARET = 'C'
                 COMPUTE WS-SALDO = MAE-UGIIIANA + MAE-IMPCONCE
                                    - MAE-IMPDISPU - WG07-CAPITAL
              ELSE
                COMPUTE WS-SALDO = MAE-UGIIIANA - WG07-CAPITAL
              END-IF
           ELSE
              IF WS-UGYFARET = 'C'
                 COMPUTE WS-SALDO = MAE-SALTEOR + MAE-IMPCONCE
                                    - MAE-IMPDISPU - WG07-CAPITAL
              ELSE
                 COMPUTE WS-SALDO = MAE-SALTEOR - WG07-CAPITAL
              END-IF
           END-IF
      *
           INITIALIZE URWCFIN
           MOVE IEN-NOMINAL                   TO FIN-TIPINT
           MOVE 'N'                           TO FIN-TIPOTASA
           MOVE IEN-PERCAPIT                  TO FIN-PERCAPIT
           MOVE IEN-PERINT                    TO FIN-PERINT
           MOVE IEN-DIASCAL                   TO FIN-DIASCAL
           MOVE  WS-SALDO                     TO FIN-CAPITAL
           MOVE  WS-DIAS-COM                  TO FIN-PERIODO-NUM

           IF WS-DIAS-COM < 1000
              MOVE CTE-CON-1                  TO FIN-PERIODO-TIP
           ELSE
              IF WS-DIAS-COM > 999 AND < 2000
                 MOVE CTE-CON-6               TO FIN-PERIODO-TIP
              END-IF
              IF WS-DIAS-COM > 1999 AND < 3000
                 MOVE CTE-CON-7               TO FIN-PERIODO-TIP
              END-IF
              IF WS-DIAS-COM > 2999 AND < 4000
                 MOVE CTE-CON-8               TO FIN-PERIODO-TIP
              END-IF
           END-IF
      *COL01-I
           MOVE WS-CODTIPRE                TO FIN-CDRETORNO
           MOVE WS-CODTIAMO                TO FIN-MODULRES
           MOVE MAE-FEULIQ(1:4)            TO FIN-MODULRES(2:4)
      *COL01-F
           CALL BBVA-UR8CFIN0  USING URWCFIN
      *
           EVALUATE    FIN-CDRETORNO
              WHEN '00'
                 CONTINUE
              WHEN '10'
                 MOVE 'UGE2000'               TO C86A-RET-COD-ERROR
                 MOVE 'UR8CFIN0'              TO C86A-RET-VAR1-ERROR
                 MOVE FIN-CDRETORNO           TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              WHEN OTHER
                 MOVE 'UGE1590'               TO C86A-RET-COD-ERROR
                 MOVE 'UR8CFIN0'              TO C86A-RET-VAR1-ERROR
                 MOVE FIN-CDRETORNO           TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE
           MOVE FIN-INTERES                   TO WS-INTERES-CUOTA.

      ******************************************************************
      *             2476-NUEVO-VENCIM                                  *
      *    SE HALLA LA PRIMERA NUEVA CUOTA QUE RESULTA DE LA ENTREGA   *
      *    ANTICIPADA Y LA FECHA DE NUEVO VENCIMIENTO QUE RESULTA      *
      *    CUANDO SE DECIDE ACORTAR LA VIDA DEL PRESTAMO MANTENIENDO   *
      *    APROXIMADAMENTE LA CUOTA                                    *
      ******************************************************************
       2476-NUEVO-VENCIM.
      *
           MOVE  MAE-FEVENCIN                 TO WS-FELIQ-ANT
      * CALCULA EL PLAZO RESTANTE PARA RECALCULO CUOTA GRAD
           IF COT-TIP-CUOTA = 'H'
                 PERFORM  24723-CALC-M
           END-IF
      *
      *EFR01-P-I
           IF SI-CALC-IMPMINI AND SW-SI-PUNICA
              IF  IMP-MINI-CUOTA > ZEROES
                  MOVE IMP-MINI-CUOTA         TO WS-CUOTA-PREVIA
              END-IF
           END-IF
      *EFR01-P-F
           PERFORM  WITH TEST AFTER
              UNTIL   COT-CUOTA       NOT <  WS-CUOTA-PREVIA OR
                      COT-TOT-AMORT-PEN      = CTE-CON-1
              MOVE COT-CODIGO                 TO WS-CODIGO-ANT
              MOVE COT-TOT-AMORT-PEN          TO WS-M-ANT
              MOVE COT-AMO-RESTAN-PER         TO WS-R-ANT
              MOVE COT-CUOTA                  TO WS-A-ANT
              MOVE ZERO                       TO COT-CUOTA
                                                 COT-INT-EFECTIVO
              MOVE  WS-C-INICIAL              TO COT-CAPITAL
      *
              SUBTRACT CTE-CON-1-COMP3      FROM COT-TOT-AMORT-PEN
                   GIVING  COT-TOT-AMORT-PEN
                   ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
               END-SUBTRACT

               IF COT-TIP-CUOTA      = CTE-CON-ALFA-5      OR
                  COT-TIP-CUOTA      = CTE-CON-ALFA-6      OR
                  COT-TIP-CUOTA      = CTE-CON-ALFA-9      OR
                  COT-TIP-CUOTA      = CTE-CON-ALFA-0
                  PERFORM  24725-CALC-T-R-N
               END-IF
      *
               PERFORM 24726-RESTO-DATOS-1
               PERFORM 24726-1-UR8CCOT0
      *
           END-PERFORM
      *
           EVALUATE  TRUE
              WHEN  COT-CUOTA      < WS-CUOTA-PREVIA
                 MOVE COT-CUOTA               TO C86A-S-LIBRE-IMP2
                                                 WS-MES-CUOTAO2
      *
                 MOVE CTE-CON-1               TO WS-M-FINAL
                 MOVE CTE-CON-1               TO WS-R-FINAL
                                                 WS-CONTADOR-2
             WHEN  COT-CUOTA      = WS-CUOTA-PREVIA
                MOVE WS-CUOTA-PREVIA          TO C86A-S-LIBRE-IMP2
                                                 WS-MES-CUOTAO2
      *
                MOVE COT-TOT-AMORT-PEN        TO WS-M-FINAL
                MOVE COT-AMO-RESTAN-PER       TO WS-R-FINAL
                                                 WS-CONTADOR-2
             WHEN COT-CUOTA      > WS-CUOTA-PREVIA
                IF WS-CODIGO-ANT  NOT =  CTE-CON-1
                   MOVE WS-A-ANT              TO C86A-S-LIBRE-IMP2
                                                 WS-MES-CUOTAO2
      *
                   MOVE WS-M-ANT              TO WS-M-FINAL
                   MOVE WS-R-ANT              TO WS-R-FINAL
                                                 WS-CONTADOR-2
                ELSE
                   MOVE CTE-CON-UGA0044       TO WS-AVISO
                   PERFORM 120-ENVIAR-AVISO

                   MOVE COT-CUOTA             TO C86A-S-LIBRE-IMP2
                                                 WS-MES-CUOTAO2
                   MOVE COT-TOT-AMORT-PEN     TO WS-M-FINAL
                   MOVE COT-AMO-RESTAN-PER    TO WS-R-FINAL
                                                 WS-CONTADOR-2
               END-IF
           END-EVALUATE
      *
           MOVE  MAE-FEPROAMO                 TO DFP-FECHA-INICIAL
      *
           SUBTRACT CTE-CON-1-COMP3      FROM WS-M-FINAL
               GIVING  DFP-NUM-PERIODOS
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO END-SUBTRACT
      *
           PERFORM 24731-DESPLAZAR-FECHA
      *
           MOVE  DFP-FECHA-FINAL              TO WS-DB2-AAAA-MM-DD
           MOVE  DFP-FECHA-FINAL              TO WS-FELIQ-NOU
      *
           PERFORM  24721-FECHA-DB2-A-FOR
      *
           MOVE  WS-FOR-MM                    TO CTA-FECHA-AUX1-MES
           MOVE  WS-FOR-DD                    TO CTA-FECHA-AUX1-DIA
           MOVE  WS-FOR-AA                    TO CTA-FECHA-AUX1-ANNO
           MOVE  CTA-FECHA-AUX1               TO C86A-S-LIBRE-FEC2.

      ******************************************************************
      *             24731-DESPLAZAR-FECHA                              *
      *    HALLA LA FECHA FINAL A PARTIR DE UNA FECHA INICIAL Y UN     *
      *    NUMERO DE PERIODOS                                          *
      ******************************************************************
       24731-DESPLAZAR-FECHA.
      *
           IF DFP-NUM-PERIODOS  =  ZERO
              MOVE DFP-FECHA-INICIAL          TO DFP-FECHA-FINAL
           ELSE
              IF MAE-UGCDIPAG  = 0
                 MOVE DFP-DIA-INICIAL         TO DFP-DIA
              ELSE
                 MOVE MAE-UGCDIPAG            TO WS-UGCDIPAG
                 MOVE WS-UGCDIPAG             TO DFP-DIA
              END-IF
      *
              MOVE WS-TIPODIAS                TO DFP-TIPODIAS
              MOVE WS-PERCAP                  TO DFP-PERCAP
      *
              PERFORM 24411-UR9CDFP0
            END-IF.

      ******************************************************************
      *              26-CONFIRMACION                                   *
      *  1-ACTUALIZACION TABLAS                                        *
      ******************************************************************
       26-CONFIRMACION.
           IF  SW-TIPO-REDUC-PLAZO
               IF (COT-TIP-CUOTA      =  CTE-CON-A) OR
                  (COT-TIP-CUOTA      =  'T')       OR
                  (COT-TIP-CUOTA      =  'W')
                  MOVE 'UGE1149'             TO C86A-RET-COD-ERROR
                  MOVE 'TIP-CUOTA: '         TO C86A-RET-VAR1-ERROR
                  MOVE COT-TIP-CUOTA         TO C86A-RET-VAR1-ERROR(12:)
                  MOVE 'PARA RED.PLAZO'      TO C86A-RET-VAR2-ERROR
                  PERFORM 3-FINAL-PROGRAMA
               ELSE
                  IF (WS-CODTIAMO = 'B')
                    MOVE 'UGE1150'           TO C86A-RET-COD-ERROR
                    MOVE 'WS-CODTIAMO: '     TO C86A-RET-VAR1-ERROR
                    MOVE WS-CODTIAMO         TO C86A-RET-VAR1-ERROR(14:)
                    MOVE 'PARA RED.PLAZO'    TO C86A-RET-VAR2-ERROR
                    PERFORM 3-FINAL-PROGRAMA
                  ELSE
                     IF (WS-IND-10 = CTE-CON-ALFA-1)
                       MOVE 'UGE1153'        TO C86A-RET-COD-ERROR
                       MOVE 'WS-IND-10: '    TO C86A-RET-VAR1-ERROR
                       MOVE WS-IND-10        TO C86A-RET-VAR1-ERROR(12:)
