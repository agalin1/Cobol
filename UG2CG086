      ******************************************************************
      *               26111-NUEVO-PLAZO                                *
      *  APARTIR DE LA FECHA DE PRIMERA LIQUIDACION, RETROCEDIENDO     *
      *  UN PERIODO, OBTENDREMOS LA FECHA DE FORMALIZACION             *
      *  LA DIFERENCI DE DIAS ENTRE ESTA FECHA Y LA DEL NUEVO          *
      *  VENCIMIENTO, NOS DARA EL PLAZO NUEVO                          *
      ******************************************************************
       26111-NUEVO-PLAZO.
      *
           MOVE  MAE-FEFORMA                  TO WS-FECHA-INI
           MOVE  CTE-CON-FECHA-NULA           TO DF3-FECHA-FINAL
      *
           PERFORM  26111-A-NUEVO-PLAZO  UNTIL
                      DF3-FECHA-FINAL > MAE-FEVENCIN
      *
           COMPUTE  WS-CONT-PLAZO  =  WS-CONT-PLAZO - 1
      *
      *    PARA EVITAR LA GENERACION DE DESCUADRES EN EL PLAZO         *
      *    SE HACE SEGUN SOLICITUD TCIN030925                          *
           PERFORM 261111-HOMOLOGAR-PLAZO.

      ******************************************************************
      *              261111-HOMOLOGAR-PLAZO                            *
      *    REALIZA LA HOMOLOGACION DE LOS CONTADORES OBTENIDOS A UN    *
      *    PLAZO VALIDO PARA EL PRESTAMO                               *
      ******************************************************************
       261111-HOMOLOGAR-PLAZO.
      *
           IF IEN-PERINT(4:1) = SPACES OR LOW-VALUES
              MOVE IEN-PERINT                 TO WS-PERINT-3PL
              MOVE WS-PERINT-3PL-1            TO WS-PERINT-PLA-1
              MOVE WS-PERINT-3PL-2            TO WS-PERINT-PLA-2
           ELSE
              MOVE IEN-PERINT                 TO WS-PERINT-PLA
           END-IF
      *
           EVALUATE WS-PERINT-PLA-1
              WHEN '1'
                 COMPUTE WS-CONT-PLAZO =
                       ( WS-CONT-PLAZO * WS-PERINT-PLA-2 )
                 END-COMPUTE
      *
                 MOVE '1'                     TO MAE-PLAZO(1:1)
              WHEN '2'
                 COMPUTE WS-CONT-PLAZO =
                         WS-CONT-PLAZO * WS-PERINT-PLA-2
                 END-COMPUTE
                 MOVE '2'                     TO MAE-PLAZO(1:1)
              WHEN '3'
                 COMPUTE WS-CONT-PLAZO =
                       ( WS-CONT-PLAZO * WS-PERINT-PLA-2 ) * 12
                 END-COMPUTE
                 MOVE '2'                     TO MAE-PLAZO(1:1)
           END-EVALUATE
      *
           MOVE WS-CONT-PLAZO                 TO MAE-PLAZO(2:3).

      ******************************************************************
      *                26111-A-NUEVO-PLAZO                             *
      *    REALIZA UN BUCLE PARA CONTAR EL NUMERO DE PLAZOS QUE        *
      *    TENDRA EL PRESTAMO                                          *
      ******************************************************************
       26111-A-NUEVO-PLAZO.
      *
           INITIALIZE URECRES URECDF3
           MOVE  WS-FECHA-INI                 TO DF3-FECHA-INICIAL
           MOVE  IEN-PERINT                   TO DF3-PERCAP
           MOVE  MAE-UGCDIPAG                 TO WS-UGCDIPAG
           MOVE  WS-UGCDIPAG                  TO DF3-DIA
           MOVE  +1                           TO DF3-NUM-PERIODOS
           MOVE WS-TIPODIAS                   TO DF3-TIPODIAS

           CALL   BBVA-UR8CDFP0  USING  URECRES
                                        URECDF3
      *
           IF RES-CORESPUE = '10'
              MOVE DF3-FECHA-FINAL            TO WS-FECHA-INI
              ADD 1                           TO WS-CONT-PLAZO
           ELSE
              MOVE 'UGE1141'                  TO C86A-RET-COD-ERROR
              MOVE 'UR8CDFP0'                 TO C86A-RET-VAR1-ERROR
              MOVE RES-CORESPUE               TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.

