                 AND ( UGFCPINC = :IFA-UGFVALOR OR
                       UGFVALOR  = :IFA-UGFVALOR)
           END-EXEC
           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF NOT (DB2-OK               AND
                   SQLWARN0  =  SPACES)
