      *----------------------------------------------------------------*
      *    SI LA IFA QUE ESTABAMOS PROCESANDO ERA UNA IFA DE TOTALES   *
      *    SE BUSCARA LA IFA DE REDUCCION DE PLAZO ANTERIOR PARA       *
      *    REACTIVARLA.                                                *
      *                                                                *
      ******************************************************************
       232A1-ACTIVAR-IFA-ANT.
           MOVE '0'                           TO IFA-UGYINDIF
           MOVE IFA-UGNROIRE                  TO IFA-UGNROINC
           MOVE IFA-LLIURE-DAT1               TO IFA-UGFVALOR
      *
           IF IFA-LLIURE-IND3 = 'A'
              EXEC SQL
                   UPDATE UGDTIFA
                      SET UGYINDIF     = :IFA-UGYINDIF,
                          NETNAME_UMO  = :IFA-NETNAME-UMO,
                          USERID_UMO   = :IFA-USERID-UMO,
                          ENTITAT_UMO  = :IFA-ENTITAT-UMO,
                          CENTRE_UMO   = :IFA-CENTRE-UMO,
                          TIMESTAMP    = CURRENT TIMESTAMP,
                          STAMP_UMO    = CURRENT TIMESTAMP
                    WHERE ENTIOFI      = :IFA-ENTIOFI
                      AND CUENTA       = :IFA-CUENTA
                      AND UGFVALOR     = :IFA-UGFVALOR
                      AND UGTINCID     = 'D'
                      AND UGNROINC     = :IFA-UGNROINC
                      AND LLIURE_IND3 IN ('A', 'T')
              END-EXEC
           ELSE
              EXEC SQL
                   UPDATE UGDTIFA
                      SET UGYINDIF     = :IFA-UGYINDIF,
                          NETNAME_UMO  = :IFA-NETNAME-UMO,
                          USERID_UMO   = :IFA-USERID-UMO,
                          ENTITAT_UMO  = :IFA-ENTITAT-UMO,
                          CENTRE_UMO   = :IFA-CENTRE-UMO,
                          TIMESTAMP    = CURRENT TIMESTAMP,
