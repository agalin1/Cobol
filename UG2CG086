      ******************************************************************
      *       DECLARAR CURSOR DE LA TABLA UGDTCUO                      *
      ******************************************************************
           EXEC SQL
             DECLARE CURSOR39 CURSOR FOR
               SELECT
                 FECOVALI,
                 FEFIVALI,
                 IMPMINI
               FROM UGDTCUO
               WHERE
                     ENTIOFI  =  :CUO-ENTIOFI          AND
                     CUENTA   =  :CUO-CUENTA           AND
                    (FEFIVALI =  :WS-DB2-FEVALOR       OR
                     FEFIVALI >  :WS-DB2-FEVALOR)
           END-EXEC.

      ******************************************************************
      *** CURSOR PARA SELECCIONAR LAS CONDICIONES DE LIQUIDACION      **
      *** QUE SE VERIAN AFECTADAS CON EL CAMBIO DEL PLAZO             **
      ******************************************************************
           EXEC SQL
               DECLARE CURSOR-LQS CURSOR FOR
               SELECT  CODCONLI,
                       TIPOAPLI,
                       IMPMINI,
                       IMPMAXI
                FROM UGDTLQS L
                WHERE PRODUCTO  =  :MAE-PRODUCTO    AND
                      SUBPRO    =  :MAE-SUBPRO      AND
                      CODCONLI NOT IN ( '102', '103') AND
                      CODCONLI NOT IN (SELECT CODCONLI
                               FROM UGDTLQE
                                WHERE ENTIOFI = :MAE-ENTIOFI AND
                                      CUENTA  = :MAE-CUENTA   )  AND
                      PLAZO     =     (SELECT MIN(PLAZO)
                               FROM UGDTLQS
                               WHERE PRODUCTO  = L.PRODUCTO    AND
                                     SUBPRO    = L.SUBPRO      AND
                                     CODCONLI  = L.CODCONLI    AND
                                     PLAZO    >= :WS-PLAZO-VIEJO AND
                                     FECOVALI <= :MAE-FECAPROBA  AND
                                     FEFIVALI >= :MAE-FECAPROBA )  AND

                      FECOVALI <= :MAE-FECAPROBA    AND
                      FEFIVALI >= :MAE-FECAPROBA    AND
      **( Y QUE ESTANDO ACTIVA PARA EL PLAZO NUEVO, SE TRATA DE    )
      **( LINEA DISTINTA A LA QUE TRATABA EL ANTERIOR.             )
                      EXISTS ( SELECT CODCONLI
                        FROM UGDTLQS Q
                         WHERE PRODUCTO  = L.PRODUCTO   AND
                               SUBPRO    = L.SUBPRO     AND
                               CODCONLI  = L.CODCONLI   AND
      **   ( ACTIVAS PARA EL NUEVO PLAZO  )
                               PLAZO     =(SELECT MIN(PLAZO)
                                           FROM UGDTLQS
                                   WHERE PRODUCTO = Q.PRODUCTO  AND
                                         SUBPRO   = Q.SUBPRO    AND
                                         CODCONLI = Q.CODCONLI  AND
                                         PLAZO   >= :WS-PLAZO-NUEVO  AND
                                         FECOVALI <= :MAE-FECAPROBA  AND
                                        FEFIVALI >= :MAE-FECAPROBA ) AND
      **   ( QUE EL PLAZO NO SEA EL MISMO (9999)  )
                             PLAZO    ^= L.PLAZO        AND
                             FECOVALI <= :MAE-FECAPROBA AND
                             FEFIVALI >= :MAE-FECAPROBA      )
           END-EXEC.
      *
           EXEC SQL
               DECLARE CURSOR-LQS2  CURSOR FOR
               SELECT  CODCONLI
                FROM UGDTLQS
                WHERE PRODUCTO  =  :MAE-PRODUCTO    AND
                      SUBPRO    =  :MAE-SUBPRO      AND
