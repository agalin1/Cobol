      ******************************************************************
      *          123-RECALCULA-CUOTA-GRAD                              *
      *****   SE INCLUYE ESTE PROCEDIMIENTO QUE ES UTILIZADO EN LA *****
      *****   RUTINA URWCC02                                       *****
      ******************************************************************
       123-RECALCULA-CUOTA-GRAD.

           EXEC SQL
                SELECT POR_AMO
                  INTO :AGR-POR-AMO
                  FROM UGDTAGR
                  WHERE PLAZO     = :WS-NUMERO-3   AND
                        ANNO      = :WS-ANNO
           END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK
               MOVE AGR-POR-AMO   TO WS-FACTOR
           ELSE
              IF DB2-NOTFND
                  MOVE 'UGE0939'              TO CAA-COD-ERROR
                  MOVE 'REG. NO EXISTE '      TO CAA-VAR1-ERROR
                  MOVE 'TABLA UGDTAGR'        TO CAA-VAR2-ERROR
                  PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UGDTAGR'               TO CAA-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *@COL08-I.
      ******************************************************************
      *                                                                *
      *                      23-PROCESAR-ANULACION                     *
      *                                                                *
      *    COMPROBAR QUE EL CONTRATO SIGUE ESTANDO EN UGDTMAN  Y       *
      *    COINCIDE CON EL DE LA TABLA 1.                              *
      *    TRATAR ANULACION DE CARGO POR CAJA O CUENTA.                *
      *    ACTUALIZAR TABLAS DE PRESTAMOS.                             *
      *    REALIZAR APUNTES CONTABLES.                                 *
      *    GRABAR LINEAS DE RETROCESION EN DOCUMENTO.                  *
      *                                                                *
      ******************************************************************
       23-PROCESAR-ANULACION.
      *
           MOVE CAA-FECHA-OPER2           TO WS-DB2-FEOPER
           INITIALIZE  WS-VALOR-COBERTURA
           PERFORM 225-COMPROBAR-UGDTMOD

      *    IF MOV-ENTIDAD-PAG = CAA-ENTIDAD
      *       AND MOV-CUENTA-PAG NOT = CTE-CUENTA-TELEPROCESO
      *       AND MOV-CUENTA-PAG NOT = SPACES
      *
      *       PERFORM 231-ANUL-CARGO-CUENTA

      *    END-IF
      *
           PERFORM 232-TRATAR-ACTUALIZACIONES
      *
      *    PERFORM  40-ACTUALIZA-UGDTCLS-UGDTCAU.
      *    PERFORM  40A-ACTUALIZA-CAU
           IF (MAE-IND-MARCA2 = 'R')
               PERFORM CALCULAR-REDESCUENTOS
           END-IF

           IF MOV-CUENTA-PAG = SPACES OR LOW-VALUES
              PERFORM 29-FORMA-243
           END-IF

           IF MAE-LIBRE-CAR6 = 'UVR' OR 'UVRBO'
              PERFORM 45-CAPITAL-CONTINGENTE
           END-IF

           PERFORM 2323-ACTUALIZAR-HCA.

           IF SI-FLEXIBLE
               MOVE ZEROS TO  WS-CONTA-CLAVE
               PERFORM 2014A-RETROCESO-FLEXIBLE-CFX2 UNTIL SI-FIN-CLAVE
               PERFORM 2014B-RETROCESO-FLEXIBLE-CFX1 UNTIL SI-FIN-CLAVE2
           END-IF

      ***** LA CONTABILIZACION SE HARA POR RECIBO COBRADO          *****
           PERFORM  50A-CONTABILIZACION.
           MOVE 'UGA0207'        TO C86A-RET-COD-AVISO1.
      *    PERFORM 2437-1-RECIBO.
      ******************************************************************
      *  SI EL PRESTAMO ES DE UVR SE HARAN LAS CORRESPONDIENTES ACTUA- *
      *  LIZACIONES EN LAS UNIDADES DE VALOR REAL                      *
      ******************************************************************
           IF MAE-LIBRE-CAR6 = 'UVR' OR 'UVRBO'
              PERFORM 6-ACTUALIZAR-UVR
           END-IF.
      ******************************************************************
      *                                                                *
      *              225-COMPROBAR-UGDTMOD                             *
      *                                                                *
      *    SE COMPRUEBA QUE EL SALTEOR  ESTA IGUAL QUE CUANDO SE       *
      *    ESCRIBIO EN UGDTMOD  DESPUES DE LA ENTREGA ANTICIPADA.      *
      *                                                                *
      ******************************************************************
      *
       225-COMPROBAR-UGDTMOD.

           MOVE 'U283'                TO MOD-CODTRAN
           MOVE 'UGDTMAE'             TO MOD-TABLA
           MOVE C86A-CCC-ENTIOFI      TO WS-CCC-ENTIOFI
           MOVE C86A-CCC-CUENTA       TO WS-CCC-CUENTA
           MOVE WS-CCC-ENTIOFI        TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA         TO WS-CUENTA
           MOVE WS-CLAVE              TO MOD-CLAVE

           MOVE 'SALTEOR'             TO MOD-COLUMNA
           PERFORM 2251-MAX-TIMESTAMP-MOD
           MOVE MOD-TIMESTAMP         TO WS-TIMESTAMP-SALDO

           PERFORM 2252-RECOGER-VALOR-MOD

           MOVE MOD-VALOR-ACT-NUM        TO WS-IMPORTE-COMP
              SET NO-ENCONTRO-PPC   TO TRUE
              PERFORM 2300-BUSCAR-MOV-PPC
           IF MAE-SALTEOR NOT = WS-IMPORTE-COMP
              MOVE WS-CCC-ENTIOFI           TO MOV-ENTIOFI
              MOVE WS-CCC-CUENTA            TO MOV-CUENTA
              MOVE WS-DB2-FEOPER            TO MOV-FEOPER
      *
              COMPUTE WS-TEMP-IMP = MOV-IMPMOVI + WS-IMPORTE-COMP
              IF MAE-SALTEOR = WS-TEMP-IMP
                 CONTINUE
              ELSE
                 MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *             2251-MAX-TIMESTAMP-MOD                             *
      *                                                                *
      *    RECOGE LA FECHA DE LA ULTIMA MODIFICACION REALIZADA AL      *
      *    CAMPO (SALTEOR)                                             *
      *                                                                *
      ******************************************************************
      *
       2251-MAX-TIMESTAMP-MOD.

           EXEC SQL SELECT
                MAX( TIMESTAMP)
              INTO
                :MOD-TIMESTAMP :WS-MAX-IND
                FROM UGDTMOD
              WHERE
                     CODTRAN      = :MOD-CODTRAN      AND
                     TABLA        = :MOD-TABLA        AND
                     CLAVE        = :MOD-CLAVE        AND
                     COLUMNA      = :MOD-COLUMNA
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE.

           IF DB2-OK AND SQLWARN0 = SPACES
               IF WS-MAX-IND < ZEROS
                   MOVE CTE-CON-UGE0346      TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
               END-IF
           ELSE
               MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                                                                *
      *             2252-RECOGER-VALOR-MOD                             *
      *                                                                *
      *    RECOGE EL VALOR DE SALTEOR DEL ULTIMO REGISTRO              *
      *                                                                *
      ******************************************************************
      *
       2252-RECOGER-VALOR-MOD.

           EXEC SQL SELECT
                 VALOR_ANT,  VALOR_ACT
              INTO
                :MOD-VALOR-ANT,
                :MOD-VALOR-ACT
                FROM UGDTMOD
              WHERE
                     CODTRAN      = :MOD-CODTRAN      AND
                     TABLA        = :MOD-TABLA        AND
                     CLAVE        = :MOD-CLAVE        AND
                     COLUMNA      = :MOD-COLUMNA      AND
                     TIMESTAMP    = :MOD-TIMESTAMP
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE.

           IF DB2-NOTFND AND SQLWARN0 = SPACES
              MOVE CTE-CON-UGE0346      TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           ELSE
              IF NOT (DB2-OK AND SQLWARN0 = SPACES)
                 MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *-----------------------------------------------------------------
      *                       2300-BUSCAR-MOV-PPC
      *-----------------------------------------------------------------
       2300-BUSCAR-MOV-PPC.

           INITIALIZE WS-IND-SUM

           EXEC SQL
                SELECT SUM (IMPMOVI)
                        INTO :MOV-IMPMOVI :WS-IND-SUM
                        FROM UGDTMOV
                WHERE ENTIOFI =:MOV-ENTIOFI AND
                      CUENTA  =:MOV-CUENTA  AND
                      CLACON IN ('S2')      AND
                      INDRETRO ='N'         AND
                      FEOPER = :WS-DB2-FEOPER
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              IF (WS-IND-SUM >= ZERO )
                  MOVE ZEROS      TO WS-TEMP-IMP
                  SET SI-ENCONTRO-PPC   TO TRUE
              ELSE
                  CONTINUE
              END-IF
           ELSE
              IF DB2-NOTFND OR DB2-NULL-VALUE
                 CONTINUE
              ELSE
                 MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ******************************************************************
      *                       231-ANUL-CARGO-CUENTA                    *
      ******************************************************************
       231-ANUL-CARGO-CUENTA.
      *
           INITIALIZE BGECMIR

           MOVE MOV-ENTIDAD-PAG        TO MIR-ENTIDAD
           MOVE MOV-CENTRO-PAG         TO MIR-CENTRO-ALTA
           MOVE MOV-CUENTA-PAG         TO MIR-CUENTA
           MOVE MOV-DIGICCC1-PAG       TO MIR-DIGICCC1
           MOVE MOV-DIGICCC2-PAG       TO MIR-DIGICCC2
           MOVE 'CTP'                  TO MIR-TIPO-CONTAB
           MOVE 'UG '                  TO MIR-APLC-ORI
           MOVE CAA-ENTIDAD            TO MIR-ENTIDAD-ORI
           MOVE CAA-CENTRO-CONT        TO MIR-CENTRO-ORI
           MOVE CAA-USERID             TO MIR-USERID-ORI
           MOVE CAA-NETNAME-CONT       TO MIR-NETNAME-ORI
           MOVE 'I'                    TO MIR-CAJERO-ORI
           MOVE CAA-AUTORIZ            TO MIR-ERRORES-AUT

           MOVE 'BGE0504'              TO MIR-CODI-ERROR(2)
           MOVE 'BGE0520'              TO MIR-CODI-ERROR(5)
           MOVE 'BGE0513'              TO MIR-CODI-ERROR(10)

           MOVE WS-DB2-FEVALOR         TO MIR-FECHA-VALOR
           MOVE CAA-FECHA-OPER2        TO MIR-FECHA-OPER
           MOVE CAA-HORA-TRANS         TO MIR-HORA-OPER
           MOVE 'S'                    TO MIR-IND-SUM-TOT
           MOVE CAA-FECHA-CONT2        TO MIR-FECHA-CONTA

           SET MIR-88-IND-AOM-MAN      TO TRUE
           SET MIR-88-IND-REAL         TO TRUE
           SET MIR-88-IND-NO-RET       TO TRUE
           SET MIR-88-IND-VENTAN       TO TRUE
           SET MIR-88-IND-NO-IMP       TO TRUE

           IF CAA-FECHA-CONT2 = MOV-FECONTA
               MOVE '391'              TO MIR-CODIGO
           ELSE
               MOVE '391'              TO MIR-CODIGO
               MOVE 'S'                TO MIR-IND-ANULA-NO-DIA
           END-IF.
      *GIBA
           MOVE C86A-IMPORTE-PAGO      TO MIR-IMPORTE
              IF MAE-MONEDA NOT = 'COP'
                 COMPUTE MIR-IMPORTE   ROUNDED =
                         MIR-IMPORTE      * WS-CAMBIO
                 END-COMPUTE
              END-IF
           MOVE 'COP'                  TO MIR-DIVISA
           MOVE WS-CCC                 TO WS-CTA-PRESTAMO
           MOVE WS-OBSERVA             TO MIR-OBSERVA
           MOVE WS-NUMER-MOV               TO MIR-NUMER-MOV-ANUL

           EXEC CICS LINK
               PROGRAM  ('BG2CMIR0')
               COMMAREA (BGECMIR)
           END-EXEC.

           IF EIBRESP NOT EQUAL DFHRESP(NORMAL)
              MOVE 'ACCESO-MIR'        TO ABC-REFERENCIA
              PERFORM 999999-ABEND-CICS
           ELSE
               MOVE MIR-NUMER-MOV        TO W-NUMMOV
               MOVE MIR-AUTORIZ          TO CAA-IND-AUTO
               MOVE MIR-ERRORES-AUT      TO CAA-AUTORIZ
              IF MAE-MONEDA NOT = 'COP'
                 COMPUTE MIR-IMPORTE   ROUNDED =
                         MIR-IMPORTE      / WS-CAMBIO
                 END-COMPUTE
              END-IF
               MOVE MIR-IMPORTE          TO CAA-IMPORTE-AUTO
               MOVE MIR-DISPO-AUT        TO WS-DISPO-AUT
               MOVE WS-DISPO-AUT         TO CAA-REFER-AUTO
               SET CAA-88-TIPO-PROCESO-AUTO TO TRUE
               IF MIR-COD-ERROR-DEV NOT = SPACES AND LOW-VALUES
                  MOVE 'UGA0109'          TO C86A-RET-COD-AVISO2
                  MOVE 'BG2CMIR0'         TO C86A-RET-VAR1-AVISO2
                  MOVE MIR-COD-ERROR-DEV TO C86A-RET-COD-ERROR
                  MOVE MIR-VAR1-ERROR     TO C86A-RET-VAR1-ERROR
                  MOVE MIR-VAR2-ERROR     TO C86A-RET-VAR2-ERROR
                  MOVE MIR-COD-AVIS1-DEV TO C86A-RET-COD-AVISO1
                  MOVE MIR-VAR1-AVIS1     TO C86A-RET-VAR1-AVISO1
                  MOVE MIR-VAR2-AVIS1     TO C86A-RET-VAR2-AVISO1
                  PERFORM 3-FINAL-PROGRAMA
               END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                   232-TRATAR-ACTUALIZACIONES.                  *
      *                                                                *
      *    RESTAURAR LA TABLA DE CONTRATO PARA QUE QUEDE COMO ANTES    *
      *    DE LA ENTREGA.                                              *
      *    MARCAR COMO RETROCEDIDOS LOS MOVIMIENTOS DE ENTREGA.        *
      *    BORRAR LA RECLAMACION DE SUBVENCION O DEVOLUCION DE         *
      *    MEDIACION SI LA HUBIERE.                                    *
      *    ACTUALIZAR UGDTMOD  EN CUANTO A LA TABLA DE CONTRATOS.      *
      *    RESTAURAR, EN SU CASO, LAS TABLAS DE CUOTAS Y LA DE         *
      *    TRAMOS DE SUBVENCION.                                       *
      *                                                                *
      ******************************************************************
       232-TRATAR-ACTUALIZACIONES.
           PERFORM  2321-ACTUALIZAR-UMAE
      *
           PERFORM  40-ACTUALIZA-UGDTCLS-UGDTCAU
           IF C86A-E-LIBRE-CAR3 EQUAL SPACES
             PERFORM  40A-ACTUALIZA-CAU
           END-IF
      *
           PERFORM  2322-ACTUALIZAR-UMOV
      *
      *
           PERFORM  2325-OBTENER-TIPO
           MOVE ADS-CODTIAMO      TO CTE-CON-CODTIAMO
      *
           IF ADS-INDINANT = 'V'
              IF WS-DB2-FEVALOR NOT < MAE-FEFINCAR  OR
                 (NOT CTE-CODTIAMO-CAP-MAS-INT      AND
                     CTE-CON-CODTIAMO NOT = 'I'     AND
                     CTE-CON-CODTIAMO NOT = 'L' )
                 IF (WS-REVER-CUOTAFIN = 'N') AND
                    (WS-REVER-OPCADQUI = 'N')
                   PERFORM  2326-RESTAURAR-CUOTAS
                 END-IF
              END-IF
           ELSE
              IF WS-DB2-FEVALOR > MAE-FEFINCAR  OR
                 (NOT CTE-CODTIAMO-CAP-MAS-INT      AND
                     CTE-CON-CODTIAMO NOT = 'I'     AND
                     CTE-CON-CODTIAMO NOT = 'L' )
                 IF (WS-REVER-CUOTAFIN = 'N') AND
                    (WS-REVER-OPCADQUI = 'N')
                   PERFORM  2326-RESTAURAR-CUOTAS
                 END-IF
              END-IF
           END-IF
           PERFORM  2324-ESBORRAR-UMOD
           IF MAE-88-INDCUAMA-0
              EVALUATE CTE-CON-CODTIAMO
                 WHEN 'C'
                    PERFORM 2329-ACTUALITZAR-DRB
                 WHEN 'D'
                    PERFORM 2329-ACTUALITZAR-DRB
                 WHEN 'E'
                    PERFORM 2329-ACTUALITZAR-DRB
                 WHEN OTHER
                    PERFORM 2329-ACTUALITZAR-DRB
                    IF (WS-REVER-OPCADQUI = 'N')
                       PERFORM 232A-ACTUALITZAR-IFA
                    END-IF
              END-EVALUATE
           END-IF.
           IF WS-REVER-CUOTAFIN = 'S'
              PERFORM 2330-ACTUALIZAR-AHI
           END-IF.
           IF WS-REVER-OPCADQUI = 'S'
              PERFORM 2331-ACTUALIZAR-REV
           END-IF.
      ******************************************************************
      *                                                                *
      *                2321-ACTUALIZAR-UMAE.                           *
      *                                                                *
      *    SE ACTUALIZA EL CONTRATO EN LA TABLA UGDTMAE CON LOS DATOS  *
      *    QUE HAY EN UGDTMOD  DE ANTES DE LA ENTREGA.                 *
      *                                                                *
      *    N O T A: ACTUALIZAR EL PARRAFO CUANDO SE CAMBIE UGDTMAE     *
      ******************************************************************
       2321-ACTUALIZAR-UMAE.
      *
           MOVE WS-CCC-ENTIOFI           TO MOV-ENTIOFI
           MOVE WS-CCC-CUENTA            TO MOV-CUENTA
           MOVE WS-SALTEOR-ANT           TO MOV-SALREAL
           MOVE WS-DB2-FEOPER            TO MOV-FEOPER
           MOVE 'DE'                     TO MOV-CLACON

           EXEC SQL
                SELECT IMPMOVI
                  INTO :WS-MES-CAPITAL2
                FROM UGDTMOV
                  WHERE ENTIOFI  =    :MOV-ENTIOFI             AND
                        CUENTA   =    :MOV-CUENTA              AND
                        CLACON   =    :MOV-CLACON              AND
                        FEOPER   =    :WS-DB2-FEOPER           AND
                        INDRETRO =    'N'
           END-EXEC

      *    ADD WS-MES-CAPITAL               TO MAE-SALREAL
      *    ADD WS-MES-CAPITAL2              TO MAE-SALREAL
           MOVE  MAE-SALTEOR                TO WS-SALINI
      *    ADD WS-MES-CAPITAL               TO MAE-SALTEOR
      *    ADD WS-MES-CAPITAL2              TO MAE-SALTEOR
           MOVE  MAE-SALTEOR                TO WS-SALFIN
           MOVE WS-DB2-FEVALOR              TO MAE-FECSAL
                    IF WS-REVER-OPCADQUI = 'S'
                       CONTINUE
                    ELSE
           MOVE WS-DB2-FEVALOR              TO MAE-FEULAMES
                    END-IF
      *
           PERFORM LEER-TABLA-MODIF.
      *    IF MAE-IND-MARCA4 = 'N'
      *       PERFORM 2252-SELECT-SALTEOR-ANT
      *    END-IF
           MOVE CAA-NETNAME-CONT            TO MAE-NETNAME-UMO
           MOVE CAA-USERID                  TO MAE-USERID-UMO
           MOVE CAA-ENTIDAD                 TO MAE-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT             TO MAE-CENTRO-UMO
      *
           EXEC SQL UPDATE
              UGDTMAE          SET
                 FEPROAMO    = :MAE-FEPROAMO,
                 FEVENCIN    = :MAE-FEVENCIN,
                 SALTEOR     = :MAE-SALTEOR,
                 SALREAL     = :MAE-SALREAL,
                 FECSAL      = :MAE-FECSAL,
                 FEULAMES    = :MAE-FEULAMES,
                 FEFINCAR    = :MAE-FEFINCAR,
                 FEULIES     = :MAE-FEULIES,
                 INTDEVEN    = :MAE-INTDEVEN,
                 INDCUAMA    = :MAE-INDCUAMA,
                 UGIIIANA    = :MAE-UGIIIANA,
                 PLAZO       = :MAE-PLAZO,
                 TIMESTAMP   = CURRENT TIMESTAMP,
                 NETNAME_UMO = :MAE-NETNAME-UMO,
                 USERID_UMO  = :MAE-USERID-UMO,
                 ENTIDAD_UMO = :MAE-ENTIDAD-UMO,
                 CENTRO_UMO  = :MAE-CENTRO-UMO
             WHERE
                ENTIOFI   = :MAE-ENTIOFI       AND
                CUENTA    = :MAE-CUENTA        AND
                TIMESTAMP = :MAE-TIMESTAMP
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
               MOVE CTE-CON-UGB0004      TO C86A-RET-COD-ERROR
               MOVE 'UGDTMAE'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
               PERFORM 3-FINAL-PROGRAMA
           ELSE
               IF NOT DB2-OK OR SQLWARN0 NOT EQUAL SPACES
                   MOVE 'UGDTMAE'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
           IF MAE-IND-MARCA4 = 'N'
              PERFORM 290-ACTUALIZAR-UGDTMAL
           END-IF.
      ******************************************************************
      *                     2252-SELECT-SALTEOR-ANT                    *
      ******************************************************************
       2252-SELECT-SALTEOR-ANT.
      *
           MOVE MAE-ENTIOFI                TO LOG-ENTIOFI
           MOVE MAE-CUENTA                 TO LOG-CUENTA
           MOVE 'DFO2'                     TO LOG-CODIGO
           MOVE WS-DB2-FEOPER              TO LOG-FECMOV

           EXEC SQL
               SELECT    LOG_IMPNUE,
                         LOG_IMPANT
                 INTO   :LOG-IMPNUE,
                        :LOG-IMPANT
                 FROM    UGDTLOG
                 WHERE   LOG_ENTIOFI  = :LOG-ENTIOFI  AND
                         LOG_CUENTA   = :LOG-CUENTA   AND
                         LOG_CODIGO   = :LOG-CODIGO   AND
                         LOG_FECMOV   = :LOG-FECMOV
           END-EXEC

           MOVE SQLCODE                    TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES

              MOVE LOG-IMPNUE TO MAE-SALTEOR
                                 MAE-SALREAL
                                 WS-SALFIN
              PERFORM 2404-BORRAR-SALTEOR-ANT
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                 MOVE 'UGE0939'             TO C86A-RET-COD-ERROR
                 MOVE 'SELECT SALTEOR-ANT'  TO C86A-RET-VAR1-ERROR
                 MOVE SQLCODE               TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      *                     2404-BORRAR-SALTEOR-ANT                    *
      * SE BORRA EL REGISTRO DE LA UGDTLOG                             *
      ******************************************************************
       2404-BORRAR-SALTEOR-ANT.
      *
           MOVE MAE-ENTIOFI                TO LOG-ENTIOFI
           MOVE MAE-CUENTA                 TO LOG-CUENTA
           MOVE 'DFO2'                     TO LOG-CODIGO
           MOVE WS-DB2-FEOPER              TO LOG-FECMOV
      *
           EXEC SQL
                 DELETE FROM UGDTLOG
                 WHERE   LOG_ENTIOFI  = :LOG-ENTIOFI  AND
                         LOG_CUENTA   = :LOG-CUENTA   AND
                         LOG_CODIGO   = :LOG-CODIGO   AND
                         LOG_FECMOV   = :LOG-FECMOV
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
              MOVE 'UGE0939'               TO C86A-RET-COD-ERROR
              MOVE 'DELETE SALTEOR-ANT'    TO C86A-RET-VAR1-ERROR
              MOVE SQLCODE                 TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      ******************************************************************
      *                 290-ACTUALIZAR-UGDTMAL                         *
      *----------------------------------------------------------------*
      *   ACTUALIZACION DE LA SITUACION DEL PRESTAMO (SITPRES) EN LA   *
      *   TABLA UGDTMAL EN CASO DE SER UN PRESTAMO DE LIBRANZAS        *
      *                                                                *
      ******************************************************************
       290-ACTUALIZAR-UGDTMAL.
      *
           MOVE MAE-ENTIOFI                   TO MAL-ENTIOFI
           MOVE MAE-CUENTA                    TO MAL-CUENTA
      *
      ******************************************************************
      *    INCLUSION DE MANEJO DE SOBRANTES                            *
      ******************************************************************
           EXEC SQL
             SELECT
                   ENTIOFI,
                   CUENTA,
                   SITPRES,
                   SOBRANTE
               INTO
                  :MAL-ENTIOFI,
                  :MAL-CUENTA,
                  :MAL-SITPRES,
                  :MAL-SOBRANTE
               FROM  UGDTMAL
               WHERE ENTIOFI   = :MAL-ENTIOFI      AND
                     CUENTA    = :MAL-CUENTA
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF (DB2-NOTFND AND SQLWARN0  =  SPACES)
            IF MAE-UGYEMCED NOT ='S'
              MOVE 'UGECFGC'                 TO C86A-RET-COD-ERROR
             ELSE
              MOVE 'UGE3434'                 TO C86A-RET-COD-ERROR
              MOVE 'NO EXISTE UGDTMAL '      TO C86A-RET-VAR1-ERROR
              MOVE MAL-ENTIOFI               TO C86A-RET-VAR2-ERROR(1:8))
              MOVE MAL-CUENTA                TO C86A-RET-VAR2-ERROR(9:1)0)
              PERFORM 3-FINAL-PROGRAMA
            END-IF
           ELSE
              IF NOT  DB2-OK
                 MOVE 'UGDTMAL'               TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTMAL'        TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF
           IF C86A-RET-COD-ERROR ='UGECFGC'
              MOVE SPACES TO C86A-RET-COD-ERROR
            ELSE
            IF MAE-UGYEMCED='S'
             IF MOV-CUENTA-PAG(1:2) = '18'
              IF CAA-CODERR-AUT(1) NOT = 'UGE2800'
                 MOVE 'U008'                  TO WS-CODFUN
                 PERFORM VALIDA-FACULTADES
              END-IF
      *
              COMPUTE MAL-SOBRANTE   = MAL-SOBRANTE +
                      WS-TOTAL
              END-COMPUTE
             END-IF
      *
             MOVE MAE-SITPRES                   TO MAL-SITPRES
            END-IF
            MOVE CAA-NETNAME-CONT              TO MAL-NETNAME-UMO
            MOVE CAA-USERID                    TO MAL-USERID-UMO
            MOVE CAA-ENTIDAD                   TO MAL-ENTIDAD-UMO
            MOVE CAA-CENTRO-CONT               TO MAL-CENTRO-UMO
      *
           EXEC SQL
              UPDATE UGDTMAL
              SET SITPRES     = :MAL-SITPRES,
                  SOBRANTE    = :MAL-SOBRANTE,
