                 MOVE WS-M-FINAL              TO WS-PLAZO-NVO-PU
              ELSE
                 IF SW-TIPO-PAGO = 'RC'
                    MOVE WS-M-INICIAL         TO WS-PLAZO-NVO-PU
                 END-IF
              END-IF
              COMPUTE WS-KTEOR-PU-NVO       = WS-KTEOR-PU - VLR-K-PU
              COMPUTE WS-COT-PUNICA ROUNDED = WS-KTEOR-PU-NVO /
                                              WS-PLAZO-NVO-PU
