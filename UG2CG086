      ******************************************************************
      *                                                                *
      *                 2322-ACTUALIZAR-UMOV.                          *
      *                                                                *
      *    MARCAR COMO RETROCEDIDOS LOS MOVIMIENTOS DE LA ENTREGA.     *
      *                                                                *
      ******************************************************************
       2322-ACTUALIZAR-UMOV.
      *
           MOVE CAA-NETNAME-CONT            TO MOV-NETNAME-UMO
           MOVE CAA-USERID                  TO MOV-USERID-UMO
           MOVE CAA-ENTIDAD                 TO MOV-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT             TO MOV-CENTRO-UMO
      *
           MOVE WS-DB2-FEVALOR           TO MOV-FEVALOR
      *    MOVE G27-SALDOPR              TO MOV-SALREAL
      *    MOVE WS-SALTEOR-ANT           TO MOV-SALREAL

           EXEC SQL
               SELECT SALREAL
                  INTO :MOV-SALREAL
                FROM UGDTMOV
                WHERE ENTIOFI     = :MAE-ENTIOFI              AND
                      CUENTA      = :MAE-CUENTA               AND
                      FEVALOR     = :MOV-FEVALOR              AND
                      INDRETRO    = 'N'                       AND
                      SECUMOV    >= :WS-TIMESTAMP-T06-ULT-MOV AND
                      (CLACON  LIKE 'D%' OR
                       CLACON     = 'AI')
           END-EXEC

           MOVE CAA-NETNAME-CONT            TO MOV-NETNAME-UMO
      *COL10-I
      *    MOVE CAA-USERID                  TO MOV-USERID-UMO
           MOVE 'UG2CG284'                  TO MOV-USERID-UMO
      *COL10-F
           MOVE CAA-ENTIDAD                 TO MOV-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT             TO MOV-CENTRO-UMO
           MOVE WS-DB2-FEVALOR              TO MOV-FEVALOR
      *
           EXEC SQL
               UPDATE UGDTMOV
                  SET INDRETRO    = 'S',
                      UGYINDIF    = '1',
                      NETNAME_UMO = :MOV-NETNAME-UMO,
                      USERID_UMO  = :MOV-USERID-UMO,
                      ENTIDAD_UMO = :MOV-ENTIDAD-UMO,
                      CENTRO_UMO  = :MOV-CENTRO-UMO
                WHERE ENTIOFI     = :MAE-ENTIOFI              AND
                      CUENTA      = :MAE-CUENTA               AND
                      FEVALOR     = :MOV-FEVALOR              AND
                      INDRETRO    = 'N'                       AND
                      SALREAL     = :MOV-SALREAL              AND
                      SECUMOV    >= :WS-TIMESTAMP-T06-ULT-MOV AND
                      (CLACON  LIKE 'D%' OR
                       CLACON     = 'AI')
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
               MOVE CTE-CON-UGB0004      TO C86A-RET-COD-ERROR
               MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
               PERFORM 3-FINAL-PROGRAMA
           ELSE
               IF NOT DB2-OK OR SQLWARN0 NOT EQUAL SPACES
                   MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      *
           IF MAE-IND-MARCA4 = 'H'
              PERFORM 30-SELECT-TBL-COC
           END-IF.
      ******************************************************************
      *                     30-SELECT-TBL-COC                          *
      *   BUSCA EL VALOR DE COBERTURA CONDICIONADA                     *
      ******************************************************************
       30-SELECT-TBL-COC.
      *
           INITIALIZE UGTCCOC
           MOVE ZEROS                          TO WS-VALOR-COBERTURA
      *
           MOVE MAE-CCC(1:8)                   TO COC-ENTIOFI
           MOVE MAE-CCC(9:10)                  TO COC-CUENTA
           MOVE CAA-FECHA-OPER2                TO COC-FECHA-OPER
           MOVE CTE-ALFA-3                     TO COC-TIPO-MOV
           MOVE CTE-N                          TO COC-IND-ACT
      *
           EXEC SQL
              SELECT COBERTURA
                  INTO :COC-COBERTURA
                  FROM UGDTCOC
                 WHERE
                    ENTIOFI       = :COC-ENTIOFI     AND
                    CUENTA        = :COC-CUENTA      AND
                    FECHA_OPER    = :COC-FECHA-OPER  AND
                    IND_ACT       = :COC-IND-ACT
           END-EXEC
      *
           MOVE SQLCODE                        TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE COC-COBERTURA               TO WS-VALOR-COBERTURA
              PERFORM 31-UPDATE-TBL-COC
           ELSE
             IF DB2-NOTFND
                CONTINUE
             ELSE
                MOVE 'UGE0939'                 TO C86A-RET-COD-ERROR
                MOVE 'SELECT UGDTCOC  '        TO C86A-RET-VAR1-ERROR
                PERFORM 999999-ABEND-DB2
             END-IF
           END-IF.
      *
      ******************************************************************
      *                    31-UPDATE-TBL-COC                           *
      ******************************************************************
       31-UPDATE-TBL-COC.
      *
            MOVE MAE-CCC(1:8)                  TO COC-ENTIOFI
            MOVE MAE-CCC(9:10)                 TO COC-CUENTA
            MOVE CAA-FECHA-OPER2               TO COC-FECHA-OPER
            MOVE CTE-ALFA-3                    TO COC-TIPO-MOV
            MOVE CTE-S                         TO COC-IND-ACT
            MOVE CTE-N                         TO WS-INDRETRO
            MOVE CAA-CENTRO-CONT               TO COC-CENTRO-UMO
            MOVE CAA-USERID                    TO COC-USERID-UMO
            MOVE CAA-NETNAME-CONT              TO COC-NETNAME-UMO
      *
            EXEC SQL UPDATE
                   UGDTCOC           SET
                    IND_ACT     = :COC-IND-ACT,
                    CENTRO_UMO  = :COC-CENTRO-UMO,
                    USERID_UMO  = :COC-USERID-UMO,
                    NETNAME_UMO = :COC-NETNAME-UMO
                  WHERE
                    ENTIOFI       = :COC-ENTIOFI     AND
                    CUENTA        = :COC-CUENTA      AND
                    FECHA_OPER    = :COC-FECHA-OPER  AND
                    IND_ACT       = :WS-INDRETRO
            END-EXEC
      *
           MOVE SQLCODE                        TO DB2-RETURN-CDE
      *
           IF DB2-OK
              PERFORM 223000-INSERT-UGDTMOD
           ELSE
              MOVE 'UGE0939'                   TO C86A-RET-COD-ERROR
              MOVE 'UPDATE UGDTCOC  '          TO C86A-RET-VAR1-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.
      *----------------------------------------------------------------*
      *    ACTUALIZA REGISTRO DE LA TABLA UGDTMOV                      *
      *----------------------------------------------------------------*
       223000-INSERT-UGDTMOD.
           MOVE 'U284'                         TO MOD-CODTRAN
           MOVE 'UGDTCOC'                      TO MOD-TABLA
           STRING MAE-ENTIOFI                  DELIMITED BY SIZE,
                  MAE-CUENTA                   DELIMITED BY SIZE,
                  '                      '     DELIMITED BY SIZE
           INTO   MOD-CLAVE
           MOVE 'COC-IND-ACT'                  TO MOD-COLUMNA
           MOVE CTE-N                          TO MOD-VALOR-ANT
           MOVE CTE-S                          TO MOD-VALOR-ACT
           MOVE 'ANULACION PAGO ANTICIPADO'    TO MOD-COMENTARIO
           MOVE MAE-ENTIOFI(1:4)               TO MOD-ENTIDAD-UMO
           MOVE MAE-ENTIOFI(5:4)               TO MOD-CENTRO-UMO
           MOVE WS-PROGRAMA                    TO MOD-USERID-UMO
                                                  MOD-NETNAME-UMO
           MOVE SPACES                         TO MOD-MONEDA
      *
           EXEC SQL INSERT INTO UGDTMOD
               ( CODTRAN,
                 TABLA,
                 CLAVE,
                 TIMESTAMP,
                 COLUMNA,
                 VALOR_ANT,
                 VALOR_ACT,
                 COMENTARIO,
                 ENTIDAD_UMO,
                 CENTRO_UMO,
                 USERID_UMO,
                 NETNAME_UMO,
                 MONEDA)
              VALUES
               (:MOD-CODTRAN,
                :MOD-TABLA,
                :MOD-CLAVE,
                 CURRENT TIMESTAMP,
                :MOD-COLUMNA,
                :MOD-VALOR-ANT,
                :MOD-VALOR-ACT,
                :MOD-COMENTARIO,
                :MOD-ENTIDAD-UMO,
                :MOD-CENTRO-UMO,
                :MOD-USERID-UMO,
                :MOD-NETNAME-UMO,
                :MOD-MONEDA)
           END-EXEC
      *
           EVALUATE SQLCODE
           WHEN ZERO
              CONTINUE
           WHEN OTHER
      *       NO GENERA ERROR PORQUE NO ES PRIORIDAD DEJAR HUELLA
              STRING SQLERRM          DELIMITED BY ' ',
                    'UPDATE UGDTMOD'  DELIMITED BY SIZE
                INTO DPA-ERROR-DB2
           END-EVALUATE.
