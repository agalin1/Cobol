       64-ACTUALIZAR-UGDTUVR-11.
      *
           MOVE MAE-ENTIOFI                   TO UVR-ENTIOFI
           MOVE MAE-CUENTA                    TO UVR-CUENTA
      *
           COMPUTE UVR-LIBRE-IMP1   ROUNDED  =
                   DRB-UGIQUOTA         / UVR-WS-COTIZACION
           END-COMPUTE
      *
           MOVE CAA-ENTIDAD                   TO UVR-ENTIDAD-UMO.
           MOVE CAA-CENTRO-CONT               TO UVR-CENTRO-UMO.
           MOVE CAA-USERID                    TO UVR-USERID-UMO.
           MOVE CAA-NETNAME-CONT              TO UVR-NETNAME-UMO.
      *
           EXEC SQL
              UPDATE UGDTUVR
                 SET SALTEOR        = :UVR-SALTEOR      ,
                     SALREAL        = :UVR-SALREAL      ,
                     PERSPROP       = :UVR-PERSPROP     ,
                     REALPROP       = :UVR-REALPROP     ,
                     ACUIMPA        = :UVR-ACUIMPA      ,
                     INT_CTES       = :UVR-INT-CTES     ,
                     INT_CTES_CONT  = :UVR-INT-CTES-CONT,
                     INT_MORA       = :UVR-INT-MORA     ,
                     INT_MORA_CONT  = :UVR-INT-MORA-CONT,
                     LIBRE_IMP1     = :UVR-LIBRE-IMP1   ,
                     LIBRE_IMP3     = :UVR-LIBRE-IMP3   ,
                     ENTIDAD_UMO    = :UVR-ENTIDAD-UMO  ,
                     CENTRO_UMO     = :UVR-CENTRO-UMO   ,
                     USERID_UMO     = :UVR-USERID-UMO   ,
                     NETNAME_UMO    = :UVR-NETNAME-UMO  ,
                     TIMESTAMP      =  CURRENT TIMESTAMP
               WHERE ENTIOFI        = :UVR-ENTIOFI
                 AND CUENTA         = :UVR-CUENTA
           END-EXEC.
