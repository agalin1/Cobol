      *----------------------------------------------------------------*
      *                    501-APERTURA-TS                             *
      *                                                                *
      * PRUEBA LA RUTINA QH6CAPE0 DE APERTURA DE PROGRAMAS             *
      *----------------------------------------------------------------*
       501-APERTURA-TS.
      *
            INITIALIZE QHECAPE-01
            MOVE 'UG'              TO APE-APLICACION
            MOVE CAA-ENTIDAD       TO APE-ENTIDAD
      *
            EXEC CICS
               LINK PROGRAM ('QH6CAPE0')
               COMMAREA     (QHECAPE-01)
               NOHANDLE
            END-EXEC
      *
            EVALUATE EIBRESP
               WHEN DFHRESP(NORMAL)
                  EVALUATE APE-CDRETORN
                     WHEN CTE-COD-OK
                        CONTINUE
                     WHEN OTHER
                        MOVE APE-VAR1-ERROR TO CAA-VAR2-ERROR
                        MOVE APE-VAR2-ERROR TO CAA-VAR1-ERROR
                        MOVE APE-COD-ERROR  TO CAA-COD-ERROR
                        PERFORM 3-FINAL-PROGRAMA
                  END-EVALUATE
               WHEN OTHER
                  MOVE EIBRESP        TO CAA-VAR2-ERROR
                  MOVE 'QH6CAPE0'     TO CAA-VAR1-ERROR
                  MOVE 'QHE0002'      TO CAA-COD-ERROR
                  PERFORM 3-FINAL-PROGRAMA
            END-EVALUATE.
      *----------------------------------------------------------------*
      *             502A-FORMATEAR-DATOS-QH                            *
      *----------------------------------------------------------------*
      *
       502A-FORMATEAR-DATOS-QH.
      *                                                                *
           INITIALIZE UGWCUTR
           MOVE CTE-PRODUCTO                TO UTR-PRODUCTO
      *
           PERFORM 502B-VALIDAR-TIPOCAR
      *
           MOVE MAE-SUBSUJET                TO UTR-CORASU
           MOVE SPACES                      TO UTR-FORPAGO
           MOVE MAE-SUBPRO                  TO UTR-LINCRE
      *
           IF MAE-IND-MARCA2 EQUAL 'R'
              MOVE ADS-ENTSUB(3:2)          TO UTR-FONDO
           ELSE
              MOVE CTE-GUIONES              TO UTR-FONDO
           END-IF.
      *
           MOVE SPACES                      TO UTR-FILLER1
           MOVE SPACES                      TO UTR-FILLER2
           MOVE SPACES                      TO UTR-TIPGASTO
           MOVE SPACES                      TO UTR-CONCONTA
           MOVE SPACES                      TO UTR-FILLERQH
           MOVE SPACES                      TO UTR-FILLERHA
           MOVE SPACES                      TO UTR-VARIOS.
      *----------------------------------------------------------------*
      *                    502B-VALIDAR-TIPOCAR                        *
      * SE HACE EL LINK A LA RUTINA UR2CCGP0 QUE TRAE ALGUNOS DATOS    *
      * PARA EL COPY UGWCUTR.                                          *
      *----------------------------------------------------------------*
      *
       502B-VALIDAR-TIPOCAR.
      *
           INITIALIZE                            URWCCGP1
           MOVE WS-CCC-ENTIOFI                TO CGP0-CCC-ENTIOFI
           MOVE WS-CCC-CUENTA                 TO CGP0-CCC-CUENTA
           MOVE 'P'                           TO CGP0-OPCION
      *
           EXEC CICS
               LINK PROGRAM ('UR2CCGP0')
               COMMAREA (URWCCGP1)
               NOHANDLE
           END-EXEC
      *
           IF EIBRESP NOT EQUAL DFHRESP(NORMAL) OR
              CGP0-CODIGO-RETORNO = '90'
              MOVE 'LINK UR2CCGP0: 90'  TO CAA-VAR1-ERROR
              PERFORM 999999-ABEND-CICS
           END-IF
      *
           EVALUATE CGP0-CODIGO-RETORNO
              WHEN '00'
                   MOVE CGP0-COD-HOMOL-CARTERA  TO UTR-TIPOCAR
                   MOVE CGP0-COD-HOMOL-CALIFICA TO UTR-CALIFICA
                   MOVE CGP0-COD-HOMOL-TEMPORA  TO UTR-TEMPORA
              WHEN '10'
              WHEN '50'
                   MOVE CGP0-COD-ERROR          TO CAA-COD-ERROR
                   MOVE CGP0-VAR1-ERROR         TO CAA-VAR1-ERROR
                   MOVE CGP0-VAR2-ERROR         TO CAA-VAR2-ERROR
              WHEN '99'
                   MOVE CGP0-VAR1-ERROR         TO CAA-VAR1-ERROR
                   MOVE CGP0-VAR2-ERROR         TO CAA-VAR2-ERROR
                   MOVE CGP0-SQLCODE            TO SQLCODE
                   MOVE CGP0-SQLERRM            TO SQLERRM
                   PERFORM 999999-ABEND-DB2
              WHEN OTHER
                   MOVE 'UR2CCGP0'              TO CAA-VAR1-ERROR
                   MOVE 'UGE1141'               TO CAA-COD-ERROR
           END-EVALUATE.
      *
           IF CAA-COD-ERROR NOT = SPACES
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      ******************************************************************
      *                      91010-HALLAR-MAX-TIME                     *
      *    SE HACE SELECT A LA LOG PARA HALLAR EL MAXIMO TIMESTAMP     *
      ******************************************************************
       91010-HALLAR-MAX-TIME.
      *
           MOVE  WS-CCC(1:8)             TO LOG-ENTIOFI
           MOVE  WS-CCC(11:10)           TO LOG-CUENTA
           MOVE 'RE01'                   TO LOG-CODIGO
           MOVE 'ENTREGA ANTICIPADA PASIVO DIFERIDO'
                                         TO LOG-DESCRIPCION

           EXEC SQL
              SELECT MAX(LOG_TIMESTAMP)
                INTO :WS-LOG-TIMESTAMP :WS-IND-SEC
                FROM UGDTLOG
               WHERE LOG_ENTIOFI    = :LOG-ENTIOFI     AND
                     LOG_CUENTA     = :LOG-CUENTA      AND
                     LOG_CODIGO     = :LOG-CODIGO      AND
                     LOG_DESCRIPCION= :LOG-DESCRIPCION
           END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              IF WS-IND-SEC >= 0
                 CONTINUE
              END-IF
           ELSE
              IF DB2-NOTFND
                  MOVE 'UGE0119'  TO CAA-COD-ERROR
                  PERFORM 999999-ROLLBACK
                  PERFORM 3-FINAL-PROGRAMA
              ELSE
                  MOVE 'UGDTLOG'     TO CAA-VAR1-ERROR
                  PERFORM 999999-ROLLBACK
                  PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      ******************************************************************
      *                      9102-ABRIR-CURS-LOG.                      *
      *    SE ABRE EL CURSOR PARA LEER LOS DATOS DE LA TABLA           *
      *    UGDTLOG, PARA OBTENER LOS VALORES CAUSADOS POR LA           *
      *    CANCELACION QUE VAMOS A REALIZAR.                           *
      ******************************************************************
       9102-ABRIR-CURS-LOG.
      *
           MOVE WS-CCC(1:8)      TO LOG-ENTIOFI
           MOVE WS-CCC(11:10)    TO LOG-CUENTA
           MOVE 'RE01'           TO LOG-CODIGO
      *
           INITIALIZE VARIABLES-ANU
           INITIALIZE WS-UGWCCRN0.
           EXEC SQL
               OPEN CURS-LOG
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK OR SQLWARN0 NOT = SPACES
              MOVE 'UGDTLOG'                 TO CAA-VAR1-ERROR
              MOVE 'ABRIR CURS-LOG'          TO WS-REFERENCIA
              PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                      91032-TRAER-DATOS.                        *
      *  SE TRAEN LOS DATOS DESDE EL CURSOR HASTA LA RUTINA UR9CCRN0   *
      ******************************************************************
       91032-TRAER-DATOS.

           PERFORM 9103-FETCH-CURS-LOG.

           IF WS-LOG-TIMESTAMP(1:16) = LOG-TIMESTAMP(1:16)
              EVALUATE LOG-COLUMNA(13:1)
                   WHEN '1'
                        MOVE LOG-IMPANT   TO  CRN0-INT-ANU
                        MOVE LOG-IMPNUE   TO  INT-ANU
                   WHEN '2'
                        MOVE LOG-IMPANT   TO  CRN0-CORR-ANU
                        MOVE LOG-IMPNUE   TO  CORR-ANU
                   WHEN '3'
                        MOVE LOG-IMPANT   TO  CRN0-CAP-CAS-ANU
                        MOVE LOG-IMPNUE   TO  CAP-CAS-ANU
                   WHEN '4'
                        MOVE LOG-IMPANT   TO  CRN0-INT-CAS-ANU
                        MOVE LOG-IMPNUE   TO  INT-CAS-ANU
              END-EVALUATE
           END-IF.
      ******************************************************************
      *                      9103-FETCH-CURS-LOG.                      *
      *  SE VAN LEYENDO LOS MOVIMIENTOS DE LA TABLA UGDTLOG QUE SE IN- *
      ******************************************************************
       9103-FETCH-CURS-LOG.
      *
           EXEC SQL
               FETCH CURS-LOG
               INTO  :LOG-ENTIOFI,
                     :LOG-CUENTA,
                     :LOG-TIMESTAMP,
                     :LOG-IMPANT,
                     :LOG-IMPNUE,
                     :LOG-COLUMNA
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
               IF WS-LOG-TIMESTAMP(1:16) = LOG-TIMESTAMP(1:16)
                   COMPUTE WS-DB2-CONTADOR = WS-DB2-CONTADOR + 1
                   PERFORM 91033-ELIMINAR-LOG
               END-IF
           ELSE
               IF DB2-NOTFND AND SQLWARN0 = SPACES
                  SET SW-FIN-CURSOR        TO    TRUE
               ELSE
                  MOVE 'UGDTLOG'            TO CAA-VAR1-ERROR
                  MOVE 'FETCH CURS-LOG'     TO WS-REFERENCIA
                  PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      ******************************************************************
      *                       91033-ELIMINAR-LOG                       *
      *  SE ELIMINAN LOS REGISTROS QUE FUERON TOMADOS DE LA UGDTLOG    *
      ******************************************************************
       91033-ELIMINAR-LOG.

           EXEC SQL
