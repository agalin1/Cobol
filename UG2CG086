      ******************************************************************
      *              4011-LLENAR-DATOS-CDE                             *
      *----------------------------------------------------------------*
      *    - MUEVE LAS VARIABLES DE TRABAJO A LOS CAMPOS DE LA TABLA   *
      *      DE DETTALLE DE MOVIMIENTOS DE CUPOS.                      *
      *                                                                *
      ******************************************************************
       4011-LLENAR-DATOS-CDE.
      *
           INITIALIZE                         UGVCCDE0
           MOVE CMA-ENTIOFI                   TO CDE-ENTIOFI
           MOVE CMA-CUENTA                    TO CDE-CUENTA
      *
           MOVE CMA-CONSEC-DETALLE            TO CDE-NRO-OPER
           MOVE 1                             TO CDE-CONSEC
           MOVE 'TF'                          TO CDE-CANAL
           MOVE WS-DB2-FEVALOR             TO CDE-FECHA-OPER
           MOVE WS-DB2-FEVALOR             TO CDE-FECHA-CONT
           MOVE '0006'                        TO CDE-TIPO-MOV
           MOVE ZEROS                         TO CDE-NRO-RECIBO
           MOVE ZEROS                         TO CDE-CONS-GASTO
           MOVE SPACES                        TO CDE-TIPO-GASTO
           MOVE C86A-IMPORTE-PAGO             TO CDE-IMP-CAPITAL
           MOVE ZEROS                         TO CDE-IMP-INT-CTES
           MOVE ZEROS                         TO CDE-IMP-INT-MORA
           MOVE ZEROS                         TO CDE-IMP-GASTOS
           MOVE ZEROS                         TO CDE-IMP-COMISION
           MOVE ZEROS                         TO CDE-IMP-IVA
           MOVE ZEROS                         TO CDE-IMP-SEGUROS
           MOVE 'UG'                          TO CDE-APLIC-DESTINO
      *
           MOVE 'EF'                       TO CDE-IND-TIPO-PAGO
           MOVE SPACES                     TO CDE-CTA-DESTINO
           MOVE ZEROES                     TO CDE-NRO-MOVMIR
      *
      *    MOVE WS-CAP-ANT                    TO CDE-SALDO-CAP-ANT
           MOVE ZEROS                         TO CDE-SALDO-CAP-ANT
           MOVE CMA-SALDO-INTPER              TO CDE-SALDO-INT-ANT
           MOVE CMA-DISPONIBLE                TO CDE-DISPONIBLE-ANT
           MOVE SPACES                        TO CDE-CODIDENT
           MOVE SPACES                        TO CDE-CLAIDENT
           MOVE SPACES                        TO CDE-DIGIDENT
           MOVE SPACES                        TO CDE-NOMBRE
           MOVE 'LIBERACION CUPO POR RECLAMAC' TO CDE-DESCRIPCION
           MOVE MAE-MONEDA                    TO CDE-DIVISA
           MOVE SPACES                        TO CDE-IND-PROVEEDOR
           MOVE C86A-INDRECU                  TO CDE-INDRECU
           MOVE 'S'                           TO CDE-IND-ACT-UG
      *    MOVE WS-SALDO-REAL-INI             TO CDE-REALPROP
      *    MOVE WS-SALDO-PERSONAL-INI         TO CDE-PERSPROP
           MOVE ZEROS                         TO CDE-REALPROP
           MOVE ZEROS                         TO CDE-PERSPROP
           MOVE ZEROS                         TO CDE-REALRETO
           MOVE ZEROS                         TO CDE-PERSRETO
      *
      *    COMPUTE CDE-INT-CTES = WS-INTERES-CAUSADO - CAU-INT-CTES
           MOVE ZEROS                         TO CDE-INT-CTES

      *    MOVE WS-INT-CTES-CONT-CAU          TO CDE-INT-CTES-CONT
           MOVE ZEROS                         TO CDE-INT-CTES-CONT
           MOVE ZEROS                         TO CDE-INT-MORA
      *    MOVE WS-INT-MORA-CONT-CAU          TO CDE-INT-MORA-CONT
           MOVE ZEROS                         TO CDE-INT-MORA-CONT
      *
           MOVE '0001-01-01'                  TO CDE-FELIQ
           MOVE  ZEROS                        TO CDE-NRO-BANCO
           MOVE  ZEROS                        TO CDE-NRO-CHEQUE
           MOVE '0001-01-01'                  TO CDE-FECHA-LIBRE1
           MOVE '0001-01-01'                  TO CDE-FECHA-LIBRE2
           MOVE '0001-01-01'                  TO CDE-FECHA-LIBRE3
           MOVE ZEROS                         TO CDE-VALOR-LIBRE1
           MOVE ZEROS                         TO CDE-VALOR-LIBRE2
           MOVE ZEROS                         TO CDE-VALOR-LIBRE3
           MOVE SPACES                        TO CDE-CAMPO-LIBRE1
           MOVE SPACES                        TO CDE-CAMPO-LIBRE2
           MOVE SPACES                        TO CDE-CAMPO-LIBRE3
           MOVE SPACES                        TO CDE-IND-LIBRE1
           MOVE SPACES                        TO CDE-IND-LIBRE2
           MOVE SPACES                        TO CDE-IND-LIBRE3
      *
           MOVE C86A-ENTIDAD-CONT             TO CDE-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO CDE-CENTRO-UMO
           MOVE C86A-USUARIO                  TO CDE-USERID-UMO.

      ******************************************************************
      *              4012-INSERTAR-UGDTCDE                             *
      *    - INSERTA EL REGISTRO EN LA TABLA DE DETALLE DE MOVIMIENTOS *
      *      DE CUPOS.                                                 *
      ******************************************************************
       4012-INSERTAR-UGDTCDE.
      *
           EXEC SQL
               INSERT
                 INTO  UGDVCDE0
                      (ENTIOFI,                   CUENTA,
                       NRO_OPER,                  CONSEC,
                       CANAL,                     FECHA_OPER,
                       FECHA_CONT,                TIPO_MOV,
                       NRO_RECIBO,                CONS_GASTO,
                       TIPO_GASTO,                IMP_CAPITAL,
                       IMP_INT_CTES,              IMP_INT_MORA,
                       IMP_GASTOS,                IMP_COMISION,
                       IMP_IVA,                   IMP_SEGUROS,
                       APLIC_DESTINO,             CTA_DESTINO,
                       SALDO_CAP_ANT,             SALDO_INT_ANT,
                       DISPONIBLE_ANT,            CODIDENT,
                       CLAIDENT,                  DIGIDENT,
                       NOMBRE,                    IND_TIPO_PAGO,
                       DESCRIPCION,               DIVISA,
                       IND_PROVEEDOR,             INDRECU,
                       IND_ACT_UG,                REALPROP,
                       PERSPROP,                  REALRETO,
                       PERSRETO,                  INT_CTES,
                       INT_CTES_CONT,             INT_MORA,
                       INT_MORA_CONT,
                       FELIQ,
                       NRO_BANCO,
                       NRO_CHEQUE,
                       FECHA_LIBRE1,              FECHA_LIBRE2,
                       FECHA_LIBRE3,              VALOR_LIBRE1,
                       VALOR_LIBRE2,              VALOR_LIBRE3,
                       IND_LIBRE1,                IND_LIBRE2,
                       IND_LIBRE3,
                       ENTIDAD_UMO,               CENTRO_UMO,
                       USERID_UMO,                NETNAME_UMO,
                       TIMESTAMP)
               VALUES
                 (:CDE-ENTIOFI,              :CDE-CUENTA,
                  :CDE-NRO-OPER,             :CDE-CONSEC,
                  :CDE-CANAL,                :CDE-FECHA-OPER,
                  :CDE-FECHA-CONT,           :CDE-TIPO-MOV,
                  :CDE-NRO-RECIBO,           :CDE-CONS-GASTO,
                  :CDE-TIPO-GASTO,           :CDE-IMP-CAPITAL,
                  :CDE-IMP-INT-CTES,         :CDE-IMP-INT-MORA,
                  :CDE-IMP-GASTOS,           :CDE-IMP-COMISION,
                  :CDE-IMP-IVA,              :CDE-IMP-SEGUROS,
                  :CDE-APLIC-DESTINO,        :CDE-CTA-DESTINO,
                  :CDE-SALDO-CAP-ANT,        :CDE-SALDO-INT-ANT,
                  :CDE-DISPONIBLE-ANT,       :CDE-CODIDENT,
                  :CDE-CLAIDENT,             :CDE-DIGIDENT,
                  :CDE-NOMBRE,               :CDE-IND-TIPO-PAGO,
                  :CDE-DESCRIPCION,          :CDE-DIVISA,
                  :CDE-IND-PROVEEDOR,        :CDE-INDRECU,
                  :CDE-IND-ACT-UG,           :CDE-REALPROP,
                  :CDE-PERSPROP,             :CDE-REALRETO,
                  :CDE-PERSRETO,             :CDE-INT-CTES,
                  :CDE-INT-CTES-CONT,        :CDE-INT-MORA,
                  :CDE-INT-MORA-CONT,
                  :CDE-FELIQ,
                  :CDE-NRO-BANCO,
                  :CDE-NRO-CHEQUE,
                  :CDE-FECHA-LIBRE1,         :CDE-FECHA-LIBRE2,
                  :CDE-FECHA-LIBRE3,         :CDE-VALOR-LIBRE1,
                  :CDE-VALOR-LIBRE2,         :CDE-VALOR-LIBRE3,
                  :CDE-IND-LIBRE1,           :CDE-IND-LIBRE2,
                  :CDE-IND-LIBRE3,
                  :CDE-ENTIDAD-UMO,          :CDE-CENTRO-UMO,
                  :CDE-USERID-UMO,           :CDE-NETNAME-UMO,
                   CURRENT TIMESTAMP)
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'UGDTCDE'           TO C86A-RET-VAR1-ERROR
              MOVE 'INSERT UGDTCDE'    TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *              402-ACTULIZAR-CMA                                 *
      *    ACTUALIZA LA TABLA MAESTRA DE CUPOS DE PRESTAMOS            *
      ******************************************************************
       402-ACTUALIZAR-CMA.
           MOVE MAE-ENTIOFI                   TO CMA-ENTIOFI
           MOVE MAE-CUENTA                    TO CMA-CUENTA
      *COL04C-I
      *    MOVE ZEROS                         TO CMA-SALDO-INTPER
      *COL04C-F

           COMPUTE CMA-DISPONIBLE  =
                   CMA-DISPONIBLE  + C86A-IMPORTE-PAGO
           END-COMPUTE

           MOVE C86A-ENTIDAD-CONT             TO CMA-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO CMA-CENTRO-UMO
           MOVE C86A-USUARIO                  TO CMA-USERID-UMO

           EXEC SQL
              UPDATE UGDVCMA0
                 SET
                     DISPONIBLE     = :CMA-DISPONIBLE    ,
                     CONSEC_DETALLE = :CMA-CONSEC-DETALLE,
      *COL04C-I
      *              SALDO_INTPER   = :CMA-SALDO-INTPER  ,
      *COL04C-F
                     ENTIDAD_UMO    = :CMA-ENTIDAD-UMO   ,
                     CENTRO_UMO     = :CMA-CENTRO-UMO    ,
                     USERID_UMO     = :CMA-USERID-UMO    ,
                     NETNAME_UMO    = :CMA-NETNAME-UMO   ,
                     TIMESTAMP      =  CURRENT TIMESTAMP
               WHERE CUENTA         = :CMA-CUENTA
                 AND ENTIOFI        = :CMA-ENTIOFI
           END-EXEC

           MOVE SQLCODE                 TO DB2-RETURN-CDE

           IF NOT DB2-OK
              MOVE 'UGDTCMA'           TO C86A-RET-VAR1-ERROR
              MOVE 'UPDATE UGDTCMA'    TO C86A-RET-VAR2-ERROR
              PERFORM  999999-ABEND-DB2
           END-IF.
      *COL04B-F
      *
      ******************************************************************
      *              269-1-SALIDA-PANTALLA                             *
      *    ENVIA UN AVISO CON LA INFORMACION RELATIVA A LA OPERACION   *
      ******************************************************************
       269-1-SALIDA-PANTALLA.
      *
            EVALUATE  SW-TIPO-PAGO

              WHEN  'RC'
                   MOVE 'VTO ACTUAL'          TO WS-LIT-VENCIM
                   MOVE C86A-S-LIBRE-FEC1     TO WS-FECHA-VENC

              WHEN  'RP'
                   MOVE 'NUEVO VTO '          TO WS-LIT-VENCIM
                   MOVE C86A-S-LIBRE-FEC2     TO WS-FECHA-VENC
            END-EVALUATE
      *
            MOVE 'UGA0123'                    TO WS-AVISO
            MOVE WS-OPCION(1:20)              TO WS-AVISO-VAR1
            MOVE WS-OPCION(21:20)             TO WS-AVISO-VAR2
            PERFORM 120-ENVIAR-AVISO.

      ******************************************************************
      *             261-ACTUALIZAR-TBL-CONTRATOS                       *
      *    ACTUALIZAR LA TABLA DE CONTRATOS EN CUANTO A:               *
      *     1- ACUMULADOR DE INTERESES                                 *
      *     2- FECHA DE ULTIMA LIQUIDACION ESPECIAL                    *
      *     3- SALDO TEORICO                                           *
      *     4- SALDO REAL                                              *
      *     5- FECHA DE SALDO CUENTA                                   *
      *     6- FECHA DE ULTIMA AMORTIZACION                            *
      *     7- INDICADOR DE CUADRO MANUAL                              *
      *     8- INDICADOR DE CONDICIONES ESPECIFICAS                    *
      *     9- PLAZO                                                   *
      ******************************************************************
       261-ACTUALIZAR-TBL-CONTRATOS.
      *
           MOVE  MAE-SALTEOR                  TO  WS-SALTEOR-ANT
           MOVE  MAE-FEFINCAR                 TO  WS-FEFINCAR-ANT
           MOVE  MAE-FEULIES                  TO  WS-FEULIES-ANT
           MOVE  MAE-FEPROAMO                 TO  WS-FEPROAMO-ANT
           MOVE  MAE-FEVENCIN                 TO  WS-FEVENCIN-ANT
           MOVE  MAE-INTDEVEN                 TO  WS-INTDEVEN-ANT
           MOVE  MAE-FECSAL                   TO  WS-FECSAL-ANT
           MOVE  MAE-FEULAMES                 TO  WS-FEULAMES-ANT
           MOVE  MAE-UGIIIANA                 TO  WS-UGIIIANA-ANT
           MOVE  MAE-UGYCATAE                 TO  WS-UGYCATAE-ANT
      *
           IF SW-TIPO-REDUC-PLAZO
              MOVE  C86A-S-LIBRE-FEC2         TO CTA-FECHA-AUX1
              MOVE  CTA-FECHA-AUX1-MES        TO WS-FOR-MM
              MOVE  CTA-FECHA-AUX1-DIA        TO WS-FOR-DD
              MOVE  CTA-FECHA-AUX1-ANNO       TO WS-FOR-AA
              MOVE  WS-FOR-DD                 TO WS-DB2-DD
              MOVE  WS-FOR-MM                 TO WS-DB2-MM
              MOVE  WS-FOR-AA                 TO WS-DB2-AAAA

      *   SI EL PRESTAMO ES CAPITALIZABLE NO SE   ACTUALIZARA LA       *
      *   FECHA DE VENCIMIENTO DEL MISMO                               *
              EVALUATE WS-CODTIAMO
                 WHEN 'C'
                 WHEN 'D'
                 WHEN 'E'
                    CONTINUE
                 WHEN OTHER
                    MOVE WS-DB2-AAAA-MM-DD    TO MAE-FEVENCIN
              END-EVALUATE
           END-IF
      *
           MOVE  ZERO                         TO  MAE-INTDEVEN
      *
           SUBTRACT WS-MES-IMPORTE       FROM MAE-SALTEOR
               GIVING  MAE-SALTEOR
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-SUBTRACT
      *
           MOVE  MAE-SALREAL                  TO WS-SALREAL-INICIAL
      *
           SUBTRACT WS-MES-IMPORTE       FROM MAE-SALREAL
               GIVING  MAE-SALREAL
               ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
           END-SUBTRACT
      *
           IF WS-CODTIAMO  = CTE-CON-B
              SUBTRACT  WS-MES-IMPORTE  FROM MAE-UGIIIANA
                 GIVING  MAE-UGIIIANA
                 ON SIZE ERROR  PERFORM 33331-REBOSAMIENTO
              END-SUBTRACT
           END-IF
      *
           MOVE  WS-DB2-FEVALOR               TO MAE-FECSAL
                                                 MAE-FEULAMES
           MOVE  CTE-CON-1                    TO MAE-UGYCATAE
           MOVE  MAE-PLAZO                    TO WS-PLAZO-ANT
      *
           IF MAE-FEVENCIN  NOT EQUAL WS-FEVENCIN-ANT
              PERFORM  2611-RECALCULAR-PLAZO
           END-IF
      *
           MOVE WS-ENTIOFI                    TO MAE-ENTIOFI
           MOVE WS-CUENTA                     TO MAE-CUENTA
           MOVE C86A-ENTIDAD-CONT             TO MAE-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO MAE-CENTRO-UMO
           MOVE C86A-USUARIO                  TO MAE-USERID-UMO
           MOVE WC-PROGRAMA                   TO MAE-NETNAME-UMO
      *
           EXEC SQL
             UPDATE  UGDTMAE
               SET
                 FEPROAMO    = :MAE-FEPROAMO,
                 FEVENCIN    = :MAE-FEVENCIN,
                 SALTEOR     = :MAE-SALTEOR,
                 SALREAL     = :MAE-SALREAL,
                 FECSAL      = :MAE-FECSAL,
                 INDLIQES    = :MAE-INDLIQES,
                 PLAZO       = :MAE-PLAZO ,
                 FEULAMES    = :MAE-FEULAMES,
                 FEFINCAR    = :MAE-FEFINCAR,
                 FEULIES     = :MAE-FEULIES,
                 INTDEVEN    = :MAE-INTDEVEN,
                 UGIIIANA    = :MAE-UGIIIANA,
                 UGYCATAE    = :MAE-UGYCATAE,
                 TIMESTAMP   = CURRENT TIMESTAMP,
                 NETNAME_UMO = :MAE-NETNAME-UMO,
                 USERID_UMO  = :MAE-USERID-UMO,
                 ENTIDAD_UMO = :MAE-ENTIDAD-UMO,
                 CENTRO_UMO  = :MAE-CENTRO-UMO
               WHERE
                       ENTIOFI   = :MAE-ENTIOFI      AND
                       CUENTA    = :MAE-CUENTA       AND
                       TIMESTAMP = :WS-TIMESTAMP
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'UGDTMAE'                  TO C86A-RET-VAR1-ERROR
              MOVE 'UPDATE UGDTMAE'           TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *               2611-RECALCULAR-PLAZO                            *
      *   RECALCULAMOS EL NUEVO PLAZO                                  *
      *   INSERTAMOS CONDICIONES DE LIQUIDACION ESPECIFICAS QUE        *
      *   SE VIESEN AFECTADAS POR EL CAMBIO                            *
      ******************************************************************
       2611-RECALCULAR-PLAZO.
      *
           PERFORM 26111-NUEVO-PLAZO
      *
           MOVE WC-PROGRAMA                   TO LQE-NETNAME-UMO
           MOVE C86A-USUARIO                  TO LQE-USERID-UMO
           MOVE C86A-ENTIDAD-CONT             TO LQE-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO LQE-CENTRO-UMO
           MOVE MAE-ENTIOFI                   TO LQE-ENTIOFI
           MOVE MAE-CUENTA                    TO LQE-CUENTA
           MOVE MAE-FEFORMA                   TO LQE-FECOVALI
           MOVE MAE-FEVENCIN                  TO LQE-FEFIVALI
           MOVE INT-TIPOTASA                  TO LQE-TIPOTASA
           MOVE INT-PERCAPIT                  TO LQE-PERCAPIT
      *
           MOVE WS-PLAZO                      TO WS-CODIGO-PERIODO-4
           PERFORM 26112-PLAZO-EN-MESES
           MOVE WS-CODIGO-PERIODO-4           TO WS-PLAZO-NUEVO
      *
           MOVE WS-PLAZO-ANT                  TO WS-CODIGO-PERIODO-4
           PERFORM 26112-PLAZO-EN-MESES
           MOVE WS-CODIGO-PERIODO-4           TO WS-PLAZO-VIEJO
      *
           EXEC SQL
             OPEN CURSOR-LQS
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'UGDTLQS'                  TO C86A-RET-VAR1-ERROR
              MOVE 'OPEN CURSOR  UGDTLQS'     TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF
      *
           PERFORM UNTIL NOT DB2-OK
              EXEC SQL
                   FETCH CURSOR-LQS INTO
                           :LQE-CODCONLI, :LQE-TIPOAPLI,
                           :LQE-IMPMINI,  :LQE-IMPMAXI
              END-EXEC
      *
              MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
              IF DB2-OK
                 PERFORM 26113-INSERT-LQE
                 MOVE CTE-CON-S               TO MAE-INDLIQES
              END-IF
           END-PERFORM
      *
           IF (NOT DB2-NOTFND AND NOT DB2-OK)
              MOVE 'UGDTLQS'                  TO C86A-RET-VAR1-ERROR
              MOVE 'FETCH CURSOR UGDTLQS'     TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF
      *
           EXEC SQL
             CLOSE CURSOR-LQS
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              MOVE 'UGDTLQS'                  TO C86A-RET-VAR1-ERROR
              MOVE 'CLOSE CURSOR UGDTLQS'     TO C86A-RET-VAR2-ERROR
              PERFORM 999999-ABEND-DB2
           END-IF
      *
      *  DEBEMOS CONTROLAR, QUE LAS LINEAS QUE NO EXISTIAN PARA EL     *
      *  PLAZO ANTERIOR, NO LAS COJA CON EL NUEVO (LAS GENERAREMOS a 0)*
           MOVE ZEROES                        TO LQE-TIPOAPLI
                                                 LQE-IMPMINI
                                                 LQE-IMPMAXI
