           EJECT.
      *
      ******************************************************************
      *                     PEDIR-AUTORIZACION                         *
      *----------------------------------------------------------------*
      *  LANZA LA VENTANA DE AUTORIZACIONES                            *
      *                                                                *
      ******************************************************************
       PEDIR-AUTORIZACION.
      *
           MOVE EIBTRMID                      TO AUTF-TERMINAL
           MOVE 'UG'                          TO AUTF-CODAPLIC
           MOVE SPACES                        TO AUTF-SUBCLV
           MOVE MAE-ENTIOFI                   TO AUTF-NUMCTA
           MOVE MAE-CUENTA                    TO AUTF-NUMCTA(11:10)
           MOVE ZEROES                        TO AUTF-NUMCLIEN
           MOVE ZEROES                        TO AUTF-CENVAR
           MOVE QGEC0010-DIVISA               TO AUTF-DIVISA
           MOVE ZEROS                         TO AUTF-IMPORTE2
           MOVE SPACES                        TO AUTF-UGEST
           MOVE SPACES                        TO AUTF-AUXILIAR
      *
           EXEC CICS
              LINK
              PROGRAM ('QR1CWTS')
              COMMAREA (QCECAUTF)
              NOHANDLE
           END-EXEC
      *
           IF EIBRESP  EQUAL DFHRESP(NORMAL)
              PERFORM 999999-ROLLBACK
              EVALUATE  TRUE
                 WHEN AUTF-88-RETORN-OK
      ******************************************************************
      *    MANEJO DE SOBRANTES                                         *
      ******************************************************************
                    EVALUATE QGEC0010-CLVFUNC
                       WHEN 'U008'
                          MOVE 'UGE2800'      TO C86A-RET-COD-ERROR
                                                 CAA-CODERR-AUT(1)
                    END-EVALUATE
      *
                    MOVE QGEC0010-IMPORTE1    TO CAA-IMPORTE-AUTO
                    SET CAA-88-IND-AUTO-SI    TO TRUE
                 WHEN AUTF-88-FALTA-DATO
                    MOVE 'UGE2071'            TO C86A-RET-COD-ERROR
                 WHEN AUTF-88-ABEND-RUTI
                    MOVE AUTF-ERROR-CODE      TO C86A-RET-COD-ERROR
                    MOVE AUTF-VAR1-ERROR      TO C86A-RET-VAR1-ERROR
              END-EVALUATE
           ELSE
              MOVE 'ERROR LINK QR1CWTS'       TO C86A-RET-VAR1-ERROR
              PERFORM 999999-ABEND-CICS
           END-IF.
      ******************************************************************
      *                                                                *
      *                     LEER-TABLA-MODIF.                          *
      *                                                                *
      *    LEEMOS LOS DATOS DE LA TABLA MAESTRA QUE SE INSERTARON      *
      *    AL HACER LA ENTREGA.                                        *
      *                                                                *
      ******************************************************************
       LEER-TABLA-MODIF.
      *
           MOVE 'U283'                TO MOD-CODTRAN
           MOVE 'UGDTMAE'            TO MOD-TABLA
           MOVE WS-CCC-ENTIOFI       TO WS-ENTIOFI
           MOVE WS-CCC-CUENTA        TO WS-CUENTA
           MOVE WS-CLAVE             TO MOD-CLAVE
      *
           IF WS-REVER-CUOTAFIN = 'N'
              MOVE 'FEFINCAR'    TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              IF WS-FECHA-ACT NOT = MAE-FEFINCAR
                 MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
              MOVE WS-FECHA-ALF         TO MAE-FEFINCAR
           END-IF
      *
           MOVE 'FEULIES'     TO MOD-COLUMNA
           PERFORM 23211-RECOGER-VALOR-MAE.
           IF WS-FECHA-ACT NOT = MAE-FEULIES
              MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
           MOVE WS-FECHA-ALF         TO MAE-FEULIES
      *
           IF WS-REVER-CUOTAFIN = 'N'
              MOVE 'FEPROAMO'    TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              IF WS-FECHA-ACT NOT = MAE-FEPROAMO
                 MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
              MOVE WS-FECHA-ALF         TO MAE-FEPROAMO
      *
              MOVE 'FEVENCIN'    TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              IF WS-FECHA-ACT NOT = MAE-FEVENCIN
                 MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
              MOVE WS-FECHA-ALF         TO MAE-FEVENCIN
           END-IF
      *
           MOVE 'INTDEVEN'    TO MOD-COLUMNA
           PERFORM 23211-RECOGER-VALOR-MAE.
           MOVE MOD-VALOR-ACT        TO WS-MOD-IMPORT-SIGNE
           MOVE WS-MOD-IMPORT        TO WS-IMPORTE-COMP
           IF WS-MOD-SIGNE = '-'
              MULTIPLY -1            BY WS-IMPORTE-COMP
           END-IF
           IF MAE-INTDEVEN  NOT = WS-IMPORTE-COMP
              MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
           MOVE MOD-VALOR-ANT        TO WS-MOD-IMPORT-SIGNE
           MOVE WS-MOD-IMPORT        TO WS-IMPORTE-COMP
           IF WS-MOD-SIGNE = '-'
              MULTIPLY -1            BY WS-IMPORTE-COMP
           END-IF
           MOVE WS-IMPORTE-COMP      TO MAE-INTDEVEN.
      *
           MOVE 'FECSAL'    TO MOD-COLUMNA
           PERFORM 23211-RECOGER-VALOR-MAE.
           IF WS-FECHA-ACT NOT = MAE-FECSAL
              MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
           MOVE WS-FECHA-ALF         TO MAE-FECSAL
      *
           IF WS-REVER-CUOTAFIN = 'N'
              MOVE 'PLAZO'     TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              IF WS-PLAZO-ACT NOT = MAE-PLAZO
                 MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
              MOVE WS-PLAZO-ALF         TO MAE-PLAZO
           END-IF
      *
           MOVE 'FEULAMES'  TO MOD-COLUMNA
           PERFORM 23211-RECOGER-VALOR-MAE.
           IF WS-FECHA-ACT NOT = MAE-FEULAMES
              MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
              PERFORM  3-FINAL-PROGRAMA
           END-IF.
           MOVE WS-FECHA-ALF         TO MAE-FEULAMES
      *
           IF CTE-CODTIAMO-FORMULA-B
              MOVE 'UGIIIANA'    TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              MOVE MOD-VALOR-ACT-NUM    TO WS-IMPORTE-COMP
              IF MAE-UGIIIANA  NOT = WS-IMPORTE-COMP
                 MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                 PERFORM  3-FINAL-PROGRAMA
              END-IF
              MOVE MOD-VALOR-ANT        TO WS-VALOR-MOD
              MOVE WS-VALOR-ALF         TO MAE-UGIIIANA
           END-IF
      *COL09-I
           IF C86A-E-LIBRE-CAR3 = SPACES
      *COL09-F
              MOVE 'SALTEOR'            TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              MOVE MOD-VALOR-ANT-NUM    TO MAE-SALTEOR

              MOVE 'SALREAL'            TO MOD-COLUMNA
              PERFORM 23211-RECOGER-VALOR-MAE
              MOVE MOD-VALOR-ANT-NUM    TO MAE-SALREAL
      *COL09-I
           END-IF.
      *COL09-F

      ******************************************************************
      *                                                                *
      *            23211-RECOGER-VALOR-MAE                             *
      *                                                                *
      *    RECOGE LOS VALORES ULTIMOS QUE SE INSERTARON EN LA UGDTMAE  *
      *                                                                *
      ******************************************************************
       23211-RECOGER-VALOR-MAE.
      *
           EXEC SQL
               SELECT  VALOR_ANT,         VALOR_ACT
                 INTO :MOD-VALOR-ANT,    :MOD-VALOR-ACT
                 FROM  UGDTMOD
                WHERE  CODTRAN    = :MOD-CODTRAN      AND
                       TABLA      = :MOD-TABLA        AND
                       CLAVE      = :MOD-CLAVE        AND
                       COLUMNA    = :MOD-COLUMNA      AND
                       TIMESTAMP >= :MOD-TIMESTAMP
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE.
      *
           IF NOT (DB2-OK AND SQLWARN0 = SPACES)
              IF DB2-NOTFND AND SQLWARN0 = SPACES
                 IF MOD-COLUMNA = 'PLAZO'
                    IF MOD-TIMESTAMP > '1993-04-19-00.00.00.000001'
                       MOVE CTE-CON-UGE0346   TO C86A-RET-COD-ERROR
                       PERFORM  3-FINAL-PROGRAMA
                    ELSE
                       MOVE SPACES            TO MOD-VALOR-ANT
                                                 MOD-VALOR-ACT
                       MOVE MAE-PLAZO         TO MOD-VALOR-ANT
                                                 MOD-VALOR-ACT
                    END-IF
                 ELSE
                    MOVE CTE-CON-UGE0346      TO C86A-RET-COD-ERROR
                    PERFORM  3-FINAL-PROGRAMA
                 END-IF
              ELSE
                 IF DB2-MAS-DE-UN-REG AND SQLWARN0 = SPACES
                    MOVE CTE-CON-UGE0386      TO C86A-RET-COD-ERROR
                    PERFORM  3-FINAL-PROGRAMA
                 ELSE
                    MOVE 'UGDTMOD'            TO C86A-RET-VAR1-ERROR
                    PERFORM 999999-ABEND-DB2
                 END-IF
              END-IF
           END-IF.
      *
           MOVE MOD-VALOR-ANT           TO WS-FECHA-MOD.
           MOVE MOD-VALOR-ACT           TO WS-FECHA-MOD-ACT.
      ******************************************************************
      *                                                                *
      *                  22-VALIDAR-RETROCESION.                       *
      *                                                                *
      *    SE VALIDA QUE EL USERID_UMO TIENE AUTORIZACION PARA RETROCEDE
      *    VALIDA FECHA VALOR DE LA ENTREGA A RETROCEDER.              *
      *    VALIDA QUE ESTAN ACTIVOS LOS MOVIMIENTOS DE LA ENTREGA A    *
      *    RETROCEDER Y QUE SON LOS ULTIMOS MOVIMIENTOS DE LA TABLA.   *
      *    VALIDA QUE NO SE HA PAGADO O COBRADO LA MEDIACION O         *
      *    SUBVENCION ASOCIADA A LA ENTREGA (EN SU CASO).              *
      *    VALIDA QUE EL CONTRATO ESTA IGUAL QUE CUANDO SE ESCRIBIO    *
      *    EN UGDTMOD  DESPUES DE LA ENTREGA.                          *
      *    VALIDA LA ANULACION DE CARGO SI LA ENTREGA SE REALIZO POR   *
      *    CUENTA DE PASIVO.                                           *
      ******************************************************************
      *
       22-VALIDAR-RETROCESION.
      *
           PERFORM 220-VALIDAR-GRACIA-CEI
      *
           PERFORM 221-VAL-FECHA-VALOR
      *
           PERFORM 222-RECUPERAR-MOV-DISP
      *
           PERFORM 223-NO-HAY-MOV-POSTERIO

           PERFORM 225-COMPROBAR-UGDTMOD

           IF WS-MES-COMISION > ZEROS
              PERFORM 224-VALOR-COMISION
           END-IF
      *
           PERFORM 226-MOSTRAR-CUOTA-VIGENTE

           PERFORM 227-DATOS-JOURNAL-PRES.

           MOVE ADS-CODTIAMO      TO CTE-CON-CODTIAMO
           IF CTE-CODTIAMO-FORMULA-B
              PERFORM  228-COMPROBAR-UGIIIANA-MOD
           END-IF.
      *
           MOVE 'N'                      TO WS-REVER-CUOTAFIN
           IF ADS-CODTIAMO = 'L' OR 'M'
              PERFORM  229-COMPROBAR-UGDTAHI-MOD
           END-IF.
      *
           MOVE 'N'                      TO WS-REVER-OPCADQUI
           PERFORM 216-VALIDA-LEASING.
           IF SW-SI-LEASING
              PERFORM 230-COMPROBAR-UGDTREV-MOD
           END-IF

      *    IF MAE-88-INDIMAT-3 OR MAE-88-INDIMAT-4
      *       PERFORM  230-COMPROBAR-PROMOCIONES
      *    ELSE
      *       IF G27-SECPROP-ALF NOT = SPACES AND LOW-VALUES
      *           MOVE 'UGE1374'          TO CAA-COD-ERROR
      *           PERFORM 3-FINAL-PROGRAMA
      *       END-IF
      *    END-IF.

           IF MAE-88-INDCUAMA-0
              EVALUATE CTE-CON-CODTIAMO
                 WHEN 'C'
                    PERFORM 22A-VAL-DATCALRBO
                 WHEN 'D'
                    PERFORM 22A-VAL-DATCALRBO
                 WHEN 'E'
                    PERFORM 22A-VAL-DATCALRBO
                 WHEN OTHER
                    IF WS-REVER-OPCADQUI = 'S'
                       CONTINUE
                    ELSE
                       PERFORM 22A-VAL-DATCALRBO
      *                PERFORM 22B-VAL-INCIDFAC
                    END-IF
              END-EVALUATE
           END-IF.
      ******************************************************************
      *                  220-VALIDAR-GRACIA-CEI                        *
      *    SE ACCEDE A LA TABLA UGDTT37 SECCION 1021, MANEJO DE        *
      *    GRACIA PARA CAPITAL E INTERESES                             *
      ******************************************************************
       220-VALIDAR-GRACIA-CEI.
      *
           INITIALIZE UGTCT37
           MOVE '1021'                  TO T37-SECCION
           MOVE MAE-SUBPRO              TO T37-ELEMENTO
      *
           EXEC SQL
                SELECT RESTO
                INTO  :T37-RESTO
                FROM UGDTT37
               WHERE SECCION  = :T37-SECCION  AND
                 ELEMENTO = :T37-ELEMENTO
           END-EXEC.
      *
           MOVE SQLCODE                 TO DB2-RETURN-CDE
           IF DB2-OK
              MOVE T37-RESTO(5:1)       TO WS-INT-CAPITALIZABLES
              IF WS-INT-CAPITALIZABLES = '0'
                 IF MAE-FEULIQ > CAA-FECHA-CONT2 AND
                    MAE-FEULIQ < MAE-FECPRILIQ
                    SET SW-SI-HAY-GRACIA      TO TRUE
                 END-IF
              END-IF
           ELSE
              IF DB2-NOTFND
                 MOVE SPACES                  TO T37-RESTO
              ELSE
                 MOVE 'UGDTT37'               TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTT37'        TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
               END-IF
            END-IF.
      ******************************************************************
      *                                                                *
      *              221-VAL-FECHA-VALOR                               *
      *                                                                *
      *    SI SE DEJA EN BLANCO, SE TOMA LA FECHA DE HOY. SI NO,       *
      *    VALIDA QUE LA FECHA VALOR ES LOGICA Y QUE ES LA DE HOY O    *
      *    ANTERIOR.                                                   *
      *                                                                *
      ******************************************************************
      *
       221-VAL-FECHA-VALOR.
      *
           IF G27-FEVALOR = SPACES OR LOW-VALUES
               MOVE CAA-FECHA-OPER2           TO WS-DB2-FEOPER
               MOVE CAA-FECHA-OPER2           TO WS-DB2-AAAA-MM-DD
               MOVE WS-DB2-AAAA               TO WS-ANO-TRUNCADO
               MOVE WS-DB2-AAAA               TO WS-FOR-AA
               MOVE WS-DB2-MM                 TO WS-FOR-MM
               MOVE WS-DB2-DD                 TO WS-FOR-DD
           ELSE
               MOVE  G27-FEVALOR              TO WS-PAN-DDMMAA
               MOVE  WS-PAN-DD                TO WS-FOR-DD
               MOVE  WS-PAN-MM                TO WS-FOR-MM
               MOVE  WS-PAN-AA                TO WS-FOR-AA
               PERFORM  2222-FECHA-PAN-A-DB2
               MOVE  WS-DB2-AAAA-MM-DD        TO WS-DB2-FEOPER
               MOVE  CAA-FECHA-OPER2   TO WS-DB2-HOY

               IF WS-DB2-FEOPER         >  WS-DB2-HOY
                   MOVE CTE-CON-UGE0169      TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
               END-IF
               IF WS-DB2-FEOPER         <  WS-DB2-HOY
                   MOVE CTE-CON-UGE0169      TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
               END-IF
           END-IF.
           PERFORM 212-1-LEE-UNA-MOV
           MOVE MOV-FEVALOR             TO  WS-DB2-FEVALOR
           IF MAE-INDADMES = CTE-CON-N
               PERFORM  22711-LEER-TABLA-UADS
           ELSE
               PERFORM  22712-LEER-TABLA-UADE
           END-IF.
           MOVE ADS-INDINANT             TO WS-INDINANT.
           IF NO-VAL-PPC
              AND SW-TRAS-NO
              IF WS-DB2-FEVALOR < MAE-FEULIQ AND SW-NO-HAY-GRACIA
                 AND NO-GRACIA
                  MOVE MAE-FEULIQ      TO C86A-RET-VAR1-ERROR
                  MOVE 'UGE1190'       TO C86A-RET-COD-ERROR
                  PERFORM  3-FINAL-PROGRAMA
              END-IF
           END-IF.
           MOVE 0 TO WS-CONTADOR2
      *
           IF ADS-INDINANT = 'A'
              EXEC SQL
              SELECT COUNT(*)
              INTO :WS-CONTADOR2
              FROM UGDTIFA
              WHERE ENTIOFI = :MAE-ENTIOFI   AND
                    CUENTA  = :MAE-CUENTA    AND
                    UGYINDIF = '0'           AND
                    UGFVALOR > :MAE-FEULIQ   AND
                    UGTINCID = 'A'
              END-EXEC
           ELSE
              EXEC SQL
              SELECT COUNT(*)
              INTO :WS-CONTADOR2
              FROM UGDTIFA
              WHERE ENTIOFI = :MAE-ENTIOFI    AND
                    CUENTA  = :MAE-CUENTA     AND
                    UGYINDIF = '0'            AND
                    UGFVALOR >= :MAE-FEULIQ   AND
                    UGTINCID = 'A'
              END-EXEC
           END-IF
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF (DB2-OK             AND
               SQLWARN0 = SPACES)
               IF WS-CONTADOR2 > 0
                  MOVE 'UGE2015'       TO  C86A-RET-COD-ERROR
                  PERFORM 3-FINAL-PROGRAMA
               END-IF
           ELSE
               MOVE 'UGDTIFA'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                                                                *
      *             2222-FECHA-PAN-A-DB2                               *
      *                                                                *
      *    PASA LA FECHA DE FORMATO PAN (DDMMAA) A FORMATO             *
      *                             DB2 (AAAA-MM-DD)                   *
      *                                                                *
      ******************************************************************
      *
       2222-FECHA-PAN-A-DB2.
      *
           MOVE  WS-PAN-DD         TO WS-DB2-DD
           MOVE  WS-PAN-MM         TO WS-DB2-MM
           MOVE  WS-PAN-AA         TO WS-DB2-AAAA.
      ******************************************************************
      *                                                                *
      *                 212-1-LEE-UNA-MOV.                             *
      *                                                                *
      *   OBTIENE EL TIPO DE INTERES APLICABLE CON LA RUTINA UR2CINT.  *
      *                                                                *
      ******************************************************************
       212-1-LEE-UNA-MOV.
      *
           PERFORM 2221-ABRIR-CURS-T6.
      *
           PERFORM 2222-FETCH-CURS-T6.
      *
           PERFORM 2224-CLOSE-CURS-T6.
      ******************************************************************
      *                                                                *
      *                  2221-ABRIR-CURS-T6.                           *
      *                                                                *
      *    SE ABRE EL CURSOR PARA LEER LOS MOVIMIENTOS DE LA TABLA     *
      *    UGDTMOV, PARA OBTENER LOS MOVIMIENTOS CAUSADOS POR LA       *
      *    ENTREGA     QUE VAMOS A RETROCEDER.                         *
      *                                                                *
      ******************************************************************
      *
       2221-ABRIR-CURS-T6.
      *
           MOVE WS-CCC-ENTIOFI           TO MOV-ENTIOFI
           MOVE WS-CCC-CUENTA            TO MOV-CUENTA
           MOVE WS-SALTEOR-ANT           TO MOV-SALREAL
           MOVE WS-DB2-FEOPER            TO MOV-FEOPER

           EXEC SQL
              SELECT SALREAL
                     INTO :MOV-SALREAL
              FROM UGDTMOV
              WHERE
                     ENTIOFI=:MOV-ENTIOFI AND
                     CUENTA =:MOV-CUENTA AND
                     (CLACON   LIKE 'D%' OR
                      CLACON   LIKE 'AI' ) AND
                     FEOPER   =    :WS-DB2-FEOPER AND
                     INDRETRO =    'N'
                     FETCH FIRST 1 ROWS ONLY
           END-EXEC

           MOVE WS-CCC-ENTIOFI           TO MOV-ENTIOFI
           MOVE WS-CCC-CUENTA            TO MOV-CUENTA
      *    MOVE WS-SALTEOR-ANT           TO MOV-SALREAL
           MOVE WS-DB2-FEOPER            TO MOV-FEOPER
      *
           EXEC SQL
               OPEN CURS-T6
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK OR SQLWARN0 NOT = SPACES
               MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      *
      ******************************************************************
      *                                                                *
      *                  2222-FETCH-CURS-T6.                           *
      *                                                                *
      *       SE VAN LEYENDO LOS MOVIMIENTOS DE LA TABLA UGDTMOV       *
      *       QUE SE INCLUYERON EN LA TABLA AL ENTREGAR.               *
      *                                                                *
      ******************************************************************
       2222-FETCH-CURS-T6.
      *
           EXEC SQL
               FETCH CURS-T6
              INTO
                :MOV-FEOPER,
                :MOV-FECONTA,
                :MOV-CLACON,
                :MOV-ENTIOPE,
                :MOV-IMPMOVI,
                :MOV-ENTIDAD-PAG,
                :MOV-CENTRO-PAG,
                :MOV-CUENTA-PAG,
                :MOV-DIGICCC1-PAG,
                :MOV-DIGICCC2-PAG,
                :MOV-SECUMOV,
                :MOV-CLADIS,
                :MOV-RUTA,
                :MOV-NUMER-MOV,
                :MOV-FEVALOR,
                :MOV-LIBRE-IMP1,  :MOV-LIBRE-IMP2,   :MOV-LIBRE-IMP3,
                :MOV-ENTIDAD-UMO, :MOV-CENTRO-UMO
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
               PERFORM 22221-TRATAR-OFI-FEC
           ELSE
               IF DB2-NOTFND AND SQLWARN0 = SPACES
                   MOVE CTE-CON-UGE0412      TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
               ELSE
                   MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                  22221-TRATAR-OFI-FEC.                         *
      *                                                                *
      *   SI LA OFICINA QUE REALIZO LA ENTREGA   NO ES LA MISMA QUE    *
      *   LA OFICINA QUE INTENTA RETROCEDER, SE                        *
      *   MUESTRA EL CORRESPONDIENTE MENSAJE DE ERROR.                 *
      *   SI HAN PASADO DETERMINADO NUMERO DE DIAS (AHORA SON 90) DESDE*
      *   LA ENTREGA ANTICIPADA, NO SE PERMITE LA RETROCESION.         *
      *   SE MUESTRAN EN PANTALLA LAS FECHAS DE LA OPERACION DE        *
      *   ENTREGA Y LA FECHA CONTABLE.                                 *
      *                                                                *
      ******************************************************************
      *
       22221-TRATAR-OFI-FEC.
      *
           MOVE CAA-ENTIDAD                 TO WS-ENTIDAD
           MOVE CAA-CENTRO-CONT             TO WS-CENTRO
      *
           MOVE ZEROS                     TO    W075-NUMDIAS
      *
           MOVE CTE-CON-3                 TO    W075-CDOPCIO
           MOVE CTE-CON-NA                TO    W075-TPTRAT
      *
           MOVE MOV-FEOPER                TO    AUX-AAAA-MM-DD
           MOVE AUX-AAAA                  TO    WS-AUX-AAAA
           MOVE AUX-MM                    TO    WS-AUX-MM
           MOVE AUX-DD                    TO    WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA         TO    W075-FHGRE1
      *
           MOVE CAA-FECHA-OPER2           TO    AUX-AAAA-MM-DD
           MOVE AUX-AAAA                  TO    WS-AUX-AAAA
           MOVE AUX-MM                    TO    WS-AUX-MM
           MOVE AUX-DD                    TO    WS-AUX-DD
           MOVE WS-AUX-DD-MM-AAAA         TO    W075-FHGRE2
      *
           EXEC CICS LINK
                PROGRAM ('TC1C1220')
                COMMAREA (TCWC0750-AREA)
           END-EXEC
      *
           IF W075-CDRETORN NOT = CTE-CON-ALFA-00
              MOVE 'UGE1141'             TO C86A-RET-COD-ERROR
              MOVE 'TC1C1220'            TO C86A-RET-VAR1-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
           MOVE MOV-FECONTA              TO WS-DB2-AAAA-MM-DD
      *
           IF (WS-ENTIOFI NOT EQUAL MOV-ENTIOPE OR
              W075-NUMDIAS > CTE-CON-DIAS-RETR)
      *       IF WS-ENTIOFI NOT EQUAL MOV-ENTIOPE
      *          MOVE CTE-CON-UGE0289   TO C86A-RET-COD-ERROR
      *          PERFORM  3-FINAL-PROGRAMA
      *       END-IF
              IF W075-NUMDIAS > CTE-CON-DIAS-RETR
                 MOVE CTE-CON-UGE0288  TO C86A-RET-COD-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *             2224-CLOSE-CURS-T6.                                *
      *                                                                *
      *    SE CIERRA EL CURSOR DE LA TABLA UGDTMOV.                    *
      *                                                                *
      ******************************************************************
      *
       2224-CLOSE-CURS-T6.
      *
           EXEC SQL
               CLOSE CURS-T6
           END-EXEC.
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK OR SQLWARN0 NOT = SPACES
               MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                                                                *
      *                 22711-LEER-TABLA-UADS                          *
      *                                                                *
      *    SE ACCEDE A LA TABLA DE CONDICIONES DE ADMINISTRACION       *
      *    ESTANDARES  PARA SELECCIONAR LOS DATOS NECESARIOS PARA      *
      *    BUSCAR EN LA TABLA 11.                                      *
      *                                                                *
      ******************************************************************
      *
       22711-LEER-TABLA-UADS.
      *
           MOVE MAE-PRODUCTO            TO ADS-PRODUCTO
           EXEC SQL
               SELECT
                       ENTSUB, CONSUB, INDSUBVE, INDLIQEN,
                       TIPODIAS, LININCUO, DIASCAL, PROGGEOM,
                       PROGARIT, CODTIAMO, PERCAP, PERINT, CARECAP,
                       INDINANT,
                       ISUMCOM
                 INTO
                      :ADS-ENTSUB,
                      :ADS-CONSUB,
                      :ADS-INDSUBVE,
                      :ADS-INDLIQEN,
                      :ADS-TIPODIAS,
                      :ADS-LININCUO,
                      :ADS-DIASCAL,
                      :ADS-PROGGEOM,
                      :ADS-PROGARIT,
                      :ADS-CODTIAMO,
                      :ADS-PERCAP,
                      :ADS-PERINT,
                      :ADS-CARECAP,
                      :ADS-INDINANT,
                      :ADS-ISUMCON
                 FROM UGDTADS
                 WHERE PRODUCTO = :ADS-PRODUCTO    AND
                       SUBPRO  = :MAE-SUBPRO       AND
                       FECOVALI <= :MAE-FECAPROBA      AND
                       FEFIVALI >= :MAE-FECAPROBA
           END-EXEC
           MOVE SQLCODE       TO DB2-RETURN-CDE
           IF NOT (DB2-OK  AND SQLWARN0 = SPACES)
               IF (DB2-NOTFND         AND
                   SQLWARN0 = SPACES)
                   MOVE CTE-CON-UGE0079      TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
               ELSE
                   MOVE 'UGDTADS'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *                  22712-LEER-TABLA-UADE                         *
      *                                                                *
      *    SE ACCEDE A LA TABLA DE CONDICIONES DE ADMINISTRACION       *
      *    ESPECIFICAS PARA SELECCIONAR LOS DATOS NECESARIOS PARA      *
      *    BUSCAR EN LA TABLA UGDTSUB.                                 *
      *                                                                *
      ******************************************************************
      *
       22712-LEER-TABLA-UADE.
      *
           MOVE WS-CCC-ENTIOFI          TO ADE-ENTIOFI
           MOVE WS-CCC-CUENTA           TO ADE-CUENTA
           EXEC SQL
               SELECT
                      ENTSUB, CONSUB, INDSUBVE, INDLIQEN,
                      TIPODIAS, LININCUO, DIASCAL, PROGGEOM,
                      PROGARIT, CODTIAMO, PERCAP, PERINT, CARECAP,
                      INDINANT,
                      ISUMCOM
                 INTO
                      :ADS-ENTSUB,
                      :ADS-CONSUB,
                      :ADS-INDSUBVE,
                      :ADS-INDLIQEN,
                      :ADS-TIPODIAS,
                      :ADS-LININCUO,
                      :ADS-DIASCAL,
                      :ADS-PROGGEOM,
                      :ADS-PROGARIT,
                      :ADS-CODTIAMO,
                      :ADS-PERCAP,
                      :ADS-PERINT,
                      :ADS-CARECAP,
                      :ADS-INDINANT,
                      :ADS-ISUMCON
                 FROM UGDTADE
                 WHERE
                       ENTIOFI = :ADE-ENTIOFI      AND
                       CUENTA  = :ADE-CUENTA       AND
                       FECOVALI <= :WS-DB2-FEVALOR AND
                       FEFIVALI >= :WS-DB2-FEVALOR
           END-EXEC
           MOVE SQLCODE       TO DB2-RETURN-CDE
           IF NOT (DB2-OK  AND SQLWARN0 = SPACES)
               IF (DB2-NOTFND         AND
                   SQLWARN0 = SPACES)
                   MOVE CTE-CON-UGE0087      TO C86A-RET-COD-ERROR
                   PERFORM  3-FINAL-PROGRAMA
               ELSE
                   MOVE 'UGDTADE'            TO C86A-RET-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      ******************************************************************
      *                                                                *
      *           222-RECUPERAR-MOV-DISP.                              *
      *                                                                *
      *   PERMITE EL ACCESO A LA TABLA DONDE SE ENCUENTRAN LOS         *
      *   MOVIMIENTOS DEL PRESTAMO, UGDTMOV. VA LEYENDO LOS MOVIMIENTOS
      *   QUE SE INSERTARON EN LA ENTREGA.                             *
      *   SE SUMAN LOS IMPORTES Y  EL IMPORTE TOTAL DEBE  COINCIDIR    *
      *   CON EL TECLEADO POR EL TERMINALISTA.                         *
      *                                                                *
      ******************************************************************
       222-RECUPERAR-MOV-DISP.
      *
           MOVE ZERO TO WS-TOTAL
                        WS-MOV-CAPITAL
                        WS-MOV-INTERES
                        WS-MOV-COMISION
                        WS-MOV-GASTOS
                        WS-MOV-SUBVEN
                        WS-MOV-INTERES-ANTI
      *@COL12-I
                        WS-MOV-INT-ALIV
      *@COL12-I

           PERFORM 2221-ABRIR-CURS-T6
           PERFORM 2222-FETCH-CURS-T6
           MOVE MOV-SECUMOV           TO WS-TIM-MOV-MAX
           EVALUATE MAE-MONEDA
              WHEN 'COP'
                 MOVE 0                  TO  WS-CAMBIO
              WHEN OTHER
                 CONTINUE
           END-EVALUATE.
           PERFORM 2223-LEER-MOVIMIENTOS
              UNTIL NOT DB2-OK               OR
                    SQLWARN0 NOT = SPACES
           PERFORM 2224-CLOSE-CURS-T6

           MOVE MOV-NUMER-MOV            TO WS-NUMER-MOV
              IF MAE-IND-MARCA4 = 'N'
             PERFORM 2250-SELECT-UGDTMAL
             PERFORM 2251-SELECT-DIFERIDOS
             COMPUTE WS-TOTAL = WS-TOTAL +
                                WS-DIF-SEGURO
             END-COMPUTE
           END-IF
      *    IF C86A-IMPORTE-PAGO NOT =  WS-TOTAL
      *        MOVE 'UGE2058'            TO C86A-RET-COD-ERROR
      *        MOVE WS-TOTAL             TO WS-VAR1-IMPORTE
      *        MOVE WS-VAR1-IMPORTE      TO C86A-RET-VAR1-ERROR
      *        PERFORM 3-FINAL-PROGRAMA
      *    END-IF
           IF WS-INT-DEV-COR > ZEROS
              SUBTRACT WS-INT-DEV-COR FROM WS-TOTAL
           END-IF.
      ******************************************************************
      *                                                                *
      *                   223-NO-HAY-MOV-POSTERIO                      *
      *                                                                *
      *    SE COMPRUEBA QUE NO EXISTEN MOVIMIENTOS POSTERIORES A LOS   *
      *    DE LA ENTREGA ANTICIPADA.                                   *
      ******************************************************************
       223-NO-HAY-MOV-POSTERIO.
      *
           EXEC SQL
               SELECT COUNT(*)
                   INTO :WS-CONTADOR
                   FROM UGDTMOV
                   WHERE
                         ENTIOFI  = :MOV-ENTIOFI      AND
                         CUENTA   = :MOV-CUENTA       AND
                         INDRETRO = 'N'               AND
                         CLACON  IN ('T1','N1','A2','B2','C2','D2',
                                     'I2', 'J2','UU') AND
                         SECUMOV  > :WS-TIM-MOV-MAX
           END-EXEC
      *
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
               MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF
      *
           IF WS-CONTADOR > ZERO
               MOVE CTE-CON-UGE0413      TO C86A-RET-COD-ERROR
               PERFORM  3-FINAL-PROGRAMA
           END-IF.
           PERFORM 2231-VALIDAR-GESTOR.
      ******************************************************************
      *                                                                *
      *                  2223-LEER-MOVIMIENTOS.                        *
      *                                                                *
      *   SE SUMA EL IMPORTE DEL MOVIMIENTO LEIDO AL IMPORTE TOTAL.    *
      *   SE MUEVEN LAS CANTIDADES A PANTALLA.                         *
      *   SE GUARDA EN WORKING EL ULTIMO TIMESTAMP.                    *
      *   SE VUELVE A HACER EL FETCH PARA VER SI HAY MAS MOVIMIENTOS   *
      *   QUE RESULTARON DE LA ENTREGA ANTICIPADA.                     *
      *                                                                *
      ******************************************************************
      *
       2223-LEER-MOVIMIENTOS.
      *
              IF MAE-IND-MARCA4 = 'N'
              PERFORM 2251-CONSULTAR-DIF
           END-IF
           PERFORM 22231-TRATAR-CONCEPTO

           IF WS-MOV-CAPITAL < 2 AND
              WS-MOV-INTERES < 2 AND
              WS-MOV-COMISION < 2 AND
              WS-MOV-GASTOS   < 2 AND
              WS-MOV-IVA      < 2 AND
              WS-MOV-SUBVEN   < 2
               IF (MOV-CLACON NOT = CTE-CON-ENTR-ANT-SUB) AND
                  (MOV-CLACON NOT = 'AI')
                   ADD  WS-TOTAL  MOV-IMPMOVI       GIVING  WS-TOTAL
               END-IF
               MOVE MOV-SECUMOV      TO WS-TIMESTAMP-T06-ULT-MOV
           END-IF

           PERFORM 22232-OTRO-FETCH-CURS-T6.
      ******************************************************************
      *                                                                *
      *                  22231-TRATAR-CONCEPTO.                        *
      *                                                                *
      *   SE MUEVEN LAS CANTIDADES A PANTALLA, DEPENDIENDO DE LA       *
      *   CLAVE DE CONCEPTO DEL MOVIMIENTO:                            *
      *   - CAPITAL = CLAVE D2.                                        *
      *   - INTERESES = CLAVE D1.                                      *
      *   - COMISION = CLAVE D3.                                       *
      *   - GASTOS  = CLAVE D4.                                        *
      *                                                                *
      ******************************************************************
      *
       22231-TRATAR-CONCEPTO.
      *
           EVALUATE MOV-CLACON

              WHEN CTE-CON-ENTR-ANT-CAP
      *@COL12-I
              WHEN 'DE'
      *@COL12-F
                IF MOV-CLADIS NOT = SPACES AND LOW-VALUES
                   MOVE G27-SECPROP  TO AUX-SECPROP
                   MOVE AUX-SECPROP  TO ALF-SECPROP
                   IF MOV-CLADIS NOT = ALF-SECPROP
                       MOVE 'UGE1375'    TO C86A-RET-COD-ERROR
                       PERFORM 3-FINAL-PROGRAMA
                   END-IF
                END-IF

                IF WS-MOV-CAPITAL = ZERO
                    MOVE MOV-IMPMOVI      TO WS-MES-CAPITAL
                    MOVE MOV-LIBRE-IMP1   TO WS-CAPPERSPROP
                    MOVE MOV-LIBRE-IMP2   TO WS-CAPPERSRETO
                END-IF
                ADD 1                     TO WS-MOV-CAPITAL
      *
              WHEN CTE-CON-ENTR-ANT-INT
      *@COL12-I
              WHEN 'DC'
      *@COL12-F
                IF WS-MOV-INTERES = ZERO
                    MOVE MOV-IMPMOVI      TO WS-MES-INTERESES
                    MOVE MOV-LIBRE-IMP1   TO WS-INT-CTES
                END-IF
                ADD 1                     TO WS-MOV-INTERES
      *@COL12-I
                IF WS-MOV-INT-ALIV = ZERO
                    PERFORM 22311-LLAMA-RUTINA-ALIVIO
                END-IF
                ADD 1                     TO WS-MOV-INT-ALIV
      *@COL12-F
      *
              WHEN CTE-CON-ENTR-ANT-COM
                IF WS-MOV-COMISION = ZERO
                    MOVE MOV-IMPMOVI      TO WS-MES-COMISION
                END-IF
                ADD 1                     TO WS-MOV-COMISION
                 MOVE MOV-LIBRE-IMP1          TO WS-TASA-COMISION
              WHEN CTE-CON-ENTR-ANT-GAS
                IF WS-MOV-GASTOS = ZERO
                    IF WS-DIF-SEGURO  > 0
                      SUBTRACT WS-DIF-SEGURO  FROM MOV-IMPMOVI
                    END-IF
                    MOVE MOV-IMPMOVI      TO WS-MES-GASTOS
                END-IF
                ADD 1                     TO WS-MOV-GASTOS
              WHEN CTE-CON-ENTR-ANT-SUB
                IF WS-MOV-SUBVEN = ZERO
                    MOVE MOV-IMPMOVI      TO WS-MES-SUBVEN
                END-IF
                ADD 1                     TO WS-MOV-SUBVEN
              WHEN 'D0'
      *@COL12-I
              WHEN 'DF'
      *@COL12-F
                IF WS-MOV-INTERES-ANTI = 0
                    COMPUTE WS-MES-INTERESES-ANTI =
                            MOV-IMPMOVI   * (-1)
                    END-COMPUTE
                END-IF
                MOVE MOV-LIBRE-IMP1      TO WS-INT-CTES-ANT
                ADD 1                    TO WS-MOV-INTERES-ANTI
              WHEN 'DA'
                 IF WS-MOV-IVA  = ZERO
                    MOVE MOV-IMPMOVI          TO WS-MES-IVA
                 END-IF
      *
                 ADD 1                        TO WS-MOV-IVA
                 MOVE MOV-LIBRE-IMP1          TO WS-TASA-IVA
           END-EVALUATE.
      ******************************************************************
      *                                                                *
      *                  22232-OTRO-FETCH-CURS-T6.                     *
      *                                                                *
      *   SE VUELVE A HACER EL FETCH SOBRE LA TABLA UGDTMOV, PARA VER  *
      *   SI HAY MAS MOVIMIENTOS GENERADOS POR LA ENTREGA.             *
      *                                                                *
      ******************************************************************
      *
       22232-OTRO-FETCH-CURS-T6.
      *
           EXEC SQL
               FETCH CURS-T6
              INTO
                :MOV-FEOPER,
                :MOV-FECONTA,
                :MOV-CLACON,
                :MOV-ENTIOPE,
                :MOV-IMPMOVI,
                :MOV-ENTIDAD-PAG,
                :MOV-CENTRO-PAG,
                :MOV-CUENTA-PAG,
                :MOV-DIGICCC1-PAG,
                :MOV-DIGICCC2-PAG,
                :MOV-SECUMOV,
                :MOV-CLADIS,
                :MOV-RUTA,
                :MOV-NUMER-MOV,
                :MOV-FEVALOR,
                :MOV-LIBRE-IMP1,  :MOV-LIBRE-IMP2,   :MOV-LIBRE-IMP3,
                :MOV-ENTIDAD-UMO, :MOV-CENTRO-UMO
           END-EXEC.

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (NOT DB2-OK AND NOT DB2-NOTFND) OR SQLWARN0 NOT = SPACES
               MOVE 'UGDTMOV'            TO C86A-RET-VAR1-ERROR
               PERFORM 999999-ABEND-DB2
           END-IF.
      ******************************************************************
      *                     2250-SELECT-UGDTMAL                        *
      *    SE VALIDA SI LA CUENTA TIENE RECIBOS CON PAGO PROXIMA CUOTA *
      ******************************************************************
       2250-SELECT-UGDTMAL.

           MOVE MAE-ENTIOFI                   TO MAL-ENTIOFI
           MOVE MAE-CUENTA                    TO MAL-CUENTA

           EXEC SQL
             SELECT
                   LIBRE_IMP1,
                   LIBRE_IMP5
               INTO
                  :MAL-LIBRE-IMP1,
                  :MAL-LIBRE-IMP5
               FROM  UGDTMAL
               WHERE ENTIOFI   = :MAL-ENTIOFI      AND
                     CUENTA    = :MAL-CUENTA
           END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF (DB2-NOTFND AND SQLWARN0  =  SPACES)
            IF MAE-UGYEMCED NOT ='S'
              MOVE ZEROS                      TO MAL-LIBRE-IMP1
                                                 MAL-LIBRE-IMP5
             ELSE
              MOVE 'UGE3434'            TO C86A-RET-COD-ERROR
              MOVE 'NO EXISTE UGDTMAL ' TO C86A-RET-VAR1-ERROR
              MOVE MAL-ENTIOFI          TO C86A-RET-VAR2-ERROR(1:8)
              MOVE MAL-CUENTA           TO C86A-RET-VAR2-ERROR(9:10)
              PERFORM 3-FINAL-PROGRAMA
             END-IF
           ELSE
              IF NOT  DB2-OK
                 MOVE 'UGDTMAL'               TO C86A-RET-VAR1-ERROR
                 MOVE 'SELECT UGDTMAL'        TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      *                     2251-SELECT-DIFERIDOS                      *
      ******************************************************************
       2251-SELECT-DIFERIDOS.
      *
           MOVE MAE-ENTIOFI                TO LOG-ENTIOFI
           MOVE MAE-CUENTA                 TO LOG-CUENTA
           MOVE 'PGDF'                     TO LOG-CODIGO
           MOVE WS-DB2-FEOPER              TO LOG-FECMOV
      *
           EXEC SQL
               SELECT    LOG_IMPNUE,
                         LOG_IMPANT
                 INTO   :LOG-IMPNUE,
                        :LOG-IMPANT
                 FROM    UGDTLOG
                 WHERE   LOG_ENTIOFI  = :LOG-ENTIOFI  AND
                         LOG_CUENTA   = :LOG-CUENTA   AND
                         LOG_CODIGO   = :LOG-CODIGO   AND
                         LOG_FECMOV   = :LOG-FECMOV
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              MOVE  LOG-IMPNUE             TO WS-DIF-INTERES
              MOVE  LOG-IMPANT             TO WS-DIF-SEGURO

              ADD   WS-DIF-INTERES         TO MAL-LIBRE-IMP1
              ADD   WS-DIF-SEGURO          TO MAL-LIBRE-IMP5

              PERFORM 2403-BORRAR-DIFERIDOS

           ELSE
              IF DB2-NOTFND
                 MOVE ZEROS                TO WS-DIF-SEGURO
                 MOVE ZEROS                TO WS-DIF-INTERES
              ELSE
                 MOVE 'UGE0939'            TO C86A-RET-COD-ERROR
                 MOVE 'SELECT DIFERIDOS'   TO C86A-RET-VAR1-ERROR
                 MOVE SQLCODE              TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      *                     2403-BORRAR-DIFERIDOS                      *
      * SE BORRA EL REGISTRO DE LA UGDTLOG                             *
      ******************************************************************
       2403-BORRAR-DIFERIDOS.
      *
           MOVE MAE-ENTIOFI                TO LOG-ENTIOFI
           MOVE MAE-CUENTA                 TO LOG-CUENTA
           MOVE 'PGDF'                     TO LOG-CODIGO
           MOVE WS-DB2-FEOPER              TO LOG-FECMOV
      *
           EXEC SQL
                 DELETE FROM UGDTLOG
                 WHERE   LOG_ENTIOFI  = :LOG-ENTIOFI  AND
                         LOG_CUENTA   = :LOG-CUENTA   AND
                         LOG_CODIGO   = :LOG-CODIGO   AND
                         LOG_FECMOV   = :LOG-FECMOV
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
              MOVE 'UGE0939'            TO C86A-RET-COD-ERROR
              MOVE 'DELETE DIFERIDOS'   TO C86A-RET-VAR1-ERROR
              MOVE SQLCODE              TO C86A-RET-VAR2-ERROR
              PERFORM 3-FINAL-PROGRAMA
           END-IF.
      ******************************************************************
      *              224-VALOR-COMISION                                *
      *----------------------------------------------------------------*
      *    SE CALCULAN LAS COMISIONES          PARA LLEGAR AL IMPORTE  *
      *    NETO QUE SE APLICA PARA AMORTIZAR                           *
      *                                                                *
      ******************************************************************
       224-VALOR-COMISION.
      *
           INITIALIZE URWCCCP0
           MOVE MAE-ENTIOFI                   TO CCP-ENTIOFI
           MOVE MAE-CUENTA                    TO CCP-CUENTA
           MOVE CAA-FECHA-OPER2               TO CCP-FECHA-OPER
           MOVE ZEROS                         TO CCP-NUMERO-MOV
           MOVE 'PB'                          TO CCP-CODFUN
      *
           SET CCP-OPCION-PAGO                TO TRUE
           MOVE ZEROS                         TO CCP-NUMERO-MOV
           MOVE WS-NUMER-MOV                  TO CCP-NUMERO-MOV-B
           MOVE WS-MES-COMISION               TO CCP-IMP-COM-ANU
           MOVE WS-MES-IVA                    TO CCP-IMP-IVA-ANU
           MOVE WS-TIMESTAMP-T06-ULT-MOV(12:8) TO CCP-HORA-OPER
      *
           MOVE WS-MES-CAPITAL                TO CCP-LIBRE-IMP1-ENT
      *
           MOVE WCLS-CODIDENT                 TO CCP-CODIDENT
           MOVE WCLS-CLAIDENT                 TO CCP-CLAIDENT
           MOVE WCLS-SECUIDEN                 TO CCP-DIGIDENT
           MOVE CAA-ENTIDAD                   TO CCP-ENTIDAD
           MOVE CAA-CENTRO-CONT               TO CCP-CENTRO-CONT
           MOVE CAA-USERID                    TO CCP-USERID
           MOVE 'UG2CG270'                    TO CCP-NETNAME
      *
           EXEC CICS
                 LINK PROGRAM('UR2CCCP0')
                 COMMAREA  (URWCCCP0)
           END-EXEC
      *
           IF EIBRESP NOT EQUAL DFHRESP(NORMAL)
              MOVE 'LINK UR2CCCP0'            TO C86A-RET-VAR1-ERROR
              PERFORM 999999-ABEND-CICS
           END-IF.
      *
           EVALUATE CCP-CORESPUE
              WHEN '00'
                 CONTINUE
              WHEN '10'
              WHEN '50'
                 MOVE CCP-CODIGO-ERROR        TO C86A-RET-COD-ERROR
                 MOVE CCP-VAR1-ERROR          TO C86A-RET-VAR1-ERROR
                 MOVE CCP-VAR2-ERROR          TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              WHEN '99'
                 MOVE CCP-SQLCODE             TO SQLCODE
                 MOVE CCP-VAR1-ERROR          TO C86A-RET-VAR1-ERROR
                 MOVE CCP-VAR2-ERROR          TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              WHEN OTHER
                 MOVE 'UGE0517'       TO C86A-RET-COD-ERROR
                 MOVE CCP-VAR1-ERROR  TO C86A-RET-VAR1-ERROR
                 MOVE CCP-VAR2-ERROR  TO C86A-RET-VAR2-ERROR
                 MOVE ':'             TO C86A-RET-VAR2-ERROR(18:1)
                 MOVE CCP-CORESPUE    TO C86A-RET-VAR2-ERROR(19:2)
                 MOVE CCP-SQLCODE     TO SQLCODE
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
      ******************************************************************
      *                                                                *
      *              226-MOSTRAR-CUOTA-VIGENTE                         *
      *                                                                *
      *    INFORMA LA FECHA DE VENCIMIENTO DEL PRESTAMO.               *
      *    RECUPERA LA CUOTA QUE QUEDO VIGENTE DESPUES DE LA ENTREGA   *
      *    PARA MOSTRARLA EN PANTALLA.                                 *
      *                                                                *
      ******************************************************************
      *
       226-MOSTRAR-CUOTA-VIGENTE.
      *
           MOVE MAE-FEVENCIN                TO WS-DB2-AAAA-MM-DD
           PERFORM 2225-FECHA-DB2-A-FOR

           EXEC SQL
             SELECT
               IMPMINI
             INTO
               :CUO-IMPMINI
             FROM  UGDTCUO
               WHERE
                       ENTIOFI   =     :MAE-ENTIOFI      AND
                       CUENTA    =     :MAE-CUENTA       AND
                       FECOVALI  <=    :WS-DB2-FEVALOR   AND
                       FEFIVALI  >     :WS-DB2-FEVALOR
           END-EXEC

           MOVE SQLCODE       TO DB2-RETURN-CDE

           IF (DB2-OK             AND
               SQLWARN0 = SPACES)
               MOVE  CUO-IMPMINI          TO  WS-MES-IMPMINI
           ELSE
               IF (DB2-NOTFND         AND
                   SQLWARN0 = SPACES)
                   MOVE ZERO                  TO WS-MES-IMPMINI
               ELSE
                   MOVE 'UGDTCUO'            TO CAA-VAR1-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.
      ******************************************************************
