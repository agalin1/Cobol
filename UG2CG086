      ******************************************************************
      *             506-CONTAB-CAPITAL-CONTING
      *        CONTABILIZACION DEL CAPITAL CONTINGENTE
      ******************************************************************
       506-CONTAB-CAPITAL-CONTING.

           IF WRK-SI-CAPITAL-CONT = 'S'
      *
      * CAPITAL REAL CONTINGENTE
              IF WRK-SALDO-REAL > 0

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'BECAI'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 MOVE CGP0-COD-HOMOL-REAL         TO UTR-TIPOGAR
                 MOVE WRK-SALDO-REAL              TO CPT-IMPORTE
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              ELSE

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'IBECA'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 MOVE CGP0-COD-HOMOL-REAL         TO UTR-TIPOGAR
                 COMPUTE CPT-IMPORTE = WRK-SALDO-REAL * -1
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              END-IF
      *
      *CAPITAL PERSONAL CONTINGENTE
              IF WRK-SALDO-PERSONAL > 0

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'BECAI'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 MOVE CGP0-COD-HOMOL-PERS         TO UTR-TIPOGAR
                 MOVE WRK-SALDO-PERSONAL          TO CPT-IMPORTE
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              ELSE

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'IBECA'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 MOVE CGP0-COD-HOMOL-PERS         TO UTR-TIPOGAR
                 COMPUTE CPT-IMPORTE = WRK-SALDO-PERSONAL * -1
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              END-IF

              IF WRK-SALDO-PERSONAL + WRK-SALDO-REAL > 0

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'CMCVI'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA

                 COMPUTE CPT-IMPORTE = WRK-SALDO-PERSONAL +
                                       WRK-SALDO-REAL
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              ELSE

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'DMCVI'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 COMPUTE CPT-IMPORTE = WRK-SALDO-PERSONAL +
                                       WRK-SALDO-REAL
                 COMPUTE CPT-IMPORTE = CPT-IMPORTE * -1
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              END-IF

              IF WRK-REAL-NEGA NOT EQUAL 0

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'ICAPI'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 COMPUTE CPT-IMPORTE = WRK-REAL-NEGA * -1
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              END-IF

              IF WRK-PERS-NEGA NOT EQUAL 0

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
                 MOVE 'ICAPI'                     TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA                  TO CPT-DIVISA
                 COMPUTE CPT-IMPORTE = WRK-PERS-NEGA * -1
                 MOVE UGWCUTR                     TO CPT-CLVCONV
                 PERFORM  503-CONCEPTOS-TS

              END-IF

           ELSE
                 MOVE ZEROS                       TO WRK-SALDO-PERSONAL
                 MOVE ZEROS                       TO WRK-SALDO-REAL
           END-IF.

      ******************************************************************
      *             507-CONTAB-CAPITAL-REPERS
      *        CONTABILIZACION DEL CAPITAL REAL Y PERSONAL
      ******************************************************************
       507-CONTAB-CAPITAL-REPERS.

      *CAPITAL REAL
      *
           IF CLS-WS-REALPROP >= 0 OR CLS-WS-REALRETO >= 0

              INITIALIZE QHECCPT-01
              MOVE CTE-COD-CONTABLE               TO CPT-CODIGO
              MOVE 'CAPII'                        TO CPT-CONCEPTO-PROG
              MOVE MAE-MONEDA                     TO CPT-DIVISA
              MOVE CGP0-COD-HOMOL-REAL            TO UTR-TIPOGAR
              COMPUTE CPT-IMPORTE = CLS-WS-REALPROP + CLS-WS-REALRETO
              MOVE UGWCUTR                        TO CPT-CLVCONV
              PERFORM  503-CONCEPTOS-TS

           END-IF

           MOVE CPT-IMPORTE                       TO WS-TOTAL-CARGAR
      *
      *CAPITAL PERSONAL
      *@COL07-I
           IF CLS-WS-PERSPROP > ZEROS AND WS-INT-DEV-COR > ZEROS
              SUBTRACT WS-INT-DEV-COR  FROM CLS-WS-PERSPROP
           END-IF
      *@COL07-F
      *
           IF CLS-WS-PERSPROP >= 0 OR CLS-WS-PERSRETO >= 0

             INITIALIZE QHECCPT-01
             MOVE CTE-COD-CONTABLE                TO CPT-CODIGO
             MOVE 'CAPII'                         TO CPT-CONCEPTO-PROG
             MOVE MAE-MONEDA                      TO CPT-DIVISA
             MOVE CGP0-COD-HOMOL-PERS             TO UTR-TIPOGAR
             COMPUTE CPT-IMPORTE = CLS-WS-PERSPROP + CLS-WS-PERSRETO
             MOVE UGWCUTR                         TO CPT-CLVCONV
             PERFORM  503-CONCEPTOS-TS

           END-IF

           COMPUTE WS-TOTAL-CARGAR = WS-TOTAL-CARGAR + CPT-IMPORTE.

      ******************************************************************
      *             508-CIERRE-APUNTE-TELE
      * CIERRE DE APUNTE CONTABLE CON CUENTA DE TELEPROCESO
      ******************************************************************
       508-CIERRE-APUNTE-TELE.

             INITIALIZE QHECCPT-01
             MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
             MOVE 'TINDS'                     TO CPT-CONCEPTO-PROG
             MOVE MAE-MONEDA                  TO CPT-DIVISA
             MOVE WS-IMPORTE-TELE             TO CPT-IMPORTE
             MOVE SPACES                      TO UTR-FORPAGO
             MOVE UGWCUTR                     TO CPT-CLVCONV
             PERFORM  503-CONCEPTOS-TS.

      ******************************************************************
      *             509-CONTAB-INTERES-CTE
      *        CONTABILIZACION DE LOS INTERESES CORRIENTES
      ******************************************************************
       509-CONTAB-INTERES-CTE.

      * MOVIMIENTO A INTERESES 1605
      *
           INITIALIZE QHECCPT-01
           MOVE CTE-COD-CONTABLE              TO CPT-CODIGO
           MOVE 'INTEI'                       TO CPT-CONCEPTO-PROG
           MOVE MAE-MONEDA                    TO CPT-DIVISA
      * IMPORTE DISMINUIDO DE LA CAU
           COMPUTE CPT-IMPORTE = CLS-WS-INT-CTES

           IF WS-INDINANT = 'A' OR WS-INDINANT = 'P'
              MOVE 0                          TO CPT-IMPORTE
           END-IF
      * NUEVOS ATRIBUTOS CONTABLES, UNICAMENTE PARA INTERES
           MOVE '1'                           TO UTR-FILLER1
           IF CGP0-COD-HOMOL-REAL NOT EQUAL SPACES AND 'XXX'
              MOVE CGP0-COD-HOMOL-REAL        TO UTR-TIPOGAR
           ELSE
              MOVE CGP0-COD-HOMOL-PERS        TO UTR-TIPOGAR
           END-IF
           MOVE UGWCUTR                       TO CPT-CLVCONV
           PERFORM  503-CONCEPTOS-TS
      *@COL07-INI
           IF WS-INT-DEV-COR GREATER ZEROES
      *
             INITIALIZE                       QHECCPT-01
      *
             MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
             MOVE CTE-RPAIN                   TO CPT-CONCEPTO-PROG
             MOVE MAE-MONEDA                  TO CPT-DIVISA
             MOVE WS-INT-DEV-COR              TO CPT-IMPORTE
      *
             IF CGP0-COD-HOMOL-REAL NOT EQUAL SPACES AND CTE-XXX
                MOVE CGP0-COD-HOMOL-REAL      TO UTR-TIPOGAR
             ELSE
                MOVE CGP0-COD-HOMOL-PERS      TO UTR-TIPOGAR
             END-IF
      *
             MOVE UGWCUTR                     TO CPT-CLVCONV
      *
             PERFORM 503-CONCEPTOS-TS
      *
             INITIALIZE                       QHECCPT-01
      *
             MOVE CTE-COD-CONTABLE            TO CPT-CODIGO
             MOVE CTE-ABCAI                   TO CPT-CONCEPTO-PROG
             MOVE MAE-MONEDA                  TO CPT-DIVISA
             MOVE WS-INT-DEV-COR              TO CPT-IMPORTE
      *
             IF CGP0-COD-HOMOL-REAL NOT EQUAL SPACES AND CTE-XXX
                MOVE CGP0-COD-HOMOL-REAL      TO UTR-TIPOGAR
             ELSE
                MOVE CGP0-COD-HOMOL-PERS      TO UTR-TIPOGAR
             END-IF
      *
             MOVE UGWCUTR                     TO CPT-CLVCONV
      *
             PERFORM 503-CONCEPTOS-TS
             PERFORM 212-GUARDA-PCOR
             PERFORM 213-ACTUALIZA-DLIC
      *
           END-IF
      *@COL07-FIN

      * MOVIMIENTO A INTERESES  4102
      *
           INITIALIZE QHECCPT-01
           MOVE CTE-COD-CONTABLE              TO CPT-CODIGO
           MOVE 'INFII'                       TO CPT-CONCEPTO-PROG
           MOVE MAE-MONEDA                    TO CPT-DIVISA
      *@COL07-I
           IF SI-GRACIA
              MOVE ZEROS TO ACUM-WS-INTERES-PAGADOS
           END-IF
      *@COL07-F
      * LO PAGADO DE CORRIENTES NORMALES MENOS LO QUE DISMINUYO A LA CAU
           COMPUTE CPT-IMPORTE = ACUM-WS-INTERES-PAGADOS -
                                 CLS-WS-INT-CTES
      *
           IF WS-INDINANT = 'A' OR WS-INDINANT = 'P'
              MOVE 0                          TO CPT-IMPORTE
           END-IF

           MOVE CPT-IMPORTE                   TO ACUM-WS-CTATELE
      * NUEVOS ATRIBUTOS CONTABLES, UNICAMENTE PARA INTERES
           MOVE '1'                           TO UTR-FILLER1
           IF CGP0-COD-HOMOL-REAL NOT EQUAL SPACES AND 'XXX'
              MOVE CGP0-COD-HOMOL-REAL        TO UTR-TIPOGAR
           ELSE
              MOVE CGP0-COD-HOMOL-PERS        TO UTR-TIPOGAR
           END-IF
           MOVE UGWCUTR                       TO CPT-CLVCONV
           PERFORM  503-CONCEPTOS-TS.

      ******************************************************************
      *             510-CONTAB-PASIVO-DIFER
      *        CONTABILIZACION DEL PASIVO DIFERIDO
      ******************************************************************
       510-CONTAB-PASIVO-DIFER.

           IF MAE-UGYTIMOR = 'R'

              PERFORM 9101-PASIVO-DIFERIDO

              IF CRN0-INT-DIF       > ZEROS

                 INITIALIZE UGTCLOG
                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE         TO CPT-CODIGO
                 MOVE 'DIFEI'                  TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA               TO CPT-DIVISA
                 MOVE CRN0-INT-DIF             TO CPT-IMPORTE
                 MOVE UGWCUTR                  TO CPT-CLVCONV
                 PERFORM 503-CONCEPTOS-TS

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE         TO CPT-CODIGO
                 MOVE 'INFID'                  TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA               TO CPT-DIVISA
                 MOVE CRN0-INT-DIF             TO CPT-IMPORTE
                 MOVE UGWCUTR                  TO CPT-CLVCONV
                 PERFORM 503-CONCEPTOS-TS

                 MOVE CRN0-INT-DIF             TO LOG-IMPNUE
                 MOVE CRN0-INT-DIF-CON         TO LOG-IMPANT
                 MOVE 'CAMPO-LIBRE-1'          TO LOG-COLUMNA
                 PERFORM 2391-GRABAR-LOG

              END-IF

              IF CRN0-CORR-MON      > ZEROS

                 INITIALIZE UGTCLOG
                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE         TO CPT-CODIGO
                 MOVE 'CMDFI'                  TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA               TO CPT-DIVISA
                 MOVE CRN0-CORR-MON            TO CPT-IMPORTE
                 MOVE UGWCUTR                  TO CPT-CLVCONV
                 PERFORM 503-CONCEPTOS-TS

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE         TO CPT-CODIGO
                 MOVE 'CMDF3'                  TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA               TO CPT-DIVISA
                 MOVE CRN0-CORR-MON            TO CPT-IMPORTE
                 MOVE UGWCUTR                  TO CPT-CLVCONV
                 PERFORM 503-CONCEPTOS-TS

                 MOVE CRN0-CORR-MON            TO LOG-IMPNUE
                 MOVE CRN0-CORR-MON-CON        TO LOG-IMPANT
                 MOVE 'CAMPO-LIBRE-2'          TO LOG-COLUMNA
                 PERFORM 2391-GRABAR-LOG

              END-IF

              COMPUTE WS-CASTIGADO = CRN0-CAP-CAS-DIF + CRN0-INT-CAS-DIF

              IF WS-CASTIGADO > ZEROS

                 INITIALIZE UGTCLOG
                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE         TO CPT-CODIGO
                 MOVE 'DIFCI'                  TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA               TO CPT-DIVISA
                 MOVE WS-CASTIGADO             TO CPT-IMPORTE
                 MOVE UGWCUTR                  TO CPT-CLVCONV
                 PERFORM 503-CONCEPTOS-TS

                 INITIALIZE QHECCPT-01
                 MOVE CTE-COD-CONTABLE         TO CPT-CODIGO
                 MOVE 'RDICI'                  TO CPT-CONCEPTO-PROG
                 MOVE MAE-MONEDA               TO CPT-DIVISA
                 MOVE WS-CASTIGADO             TO CPT-IMPORTE
                 MOVE UGWCUTR                  TO CPT-CLVCONV
                 PERFORM 503-CONCEPTOS-TS

                 MOVE CRN0-CAP-CAS-DIF         TO LOG-IMPNUE
                 MOVE CRN0-CAP-CAS-DIF-CON     TO LOG-IMPANT
                 MOVE 'CAMPO-LIBRE-3'          TO LOG-COLUMNA
                 PERFORM 2391-GRABAR-LOG

              END-IF

              IF CRN0-INT-CAS-DIF   > ZEROS

                 INITIALIZE UGTCLOG
                 MOVE CRN0-INT-CAS-DIF         TO LOG-IMPNUE
                 MOVE CRN0-INT-CAS-DIF-CON     TO LOG-IMPANT
                 MOVE 'CAMPO-LIBRE-4'          TO LOG-COLUMNA
                 PERFORM 2391-GRABAR-LOG

              END-IF

              PERFORM 5101-BUSCAR-UGDTPDI

           END-IF.

      ******************************************************************
      *              9101-PASIVO-DIFERIDO                              *
      *   SE VALIDA QUE SEA CREDITO REESTRUCTURADO PARA HACER EL       *
      *   RESPECTIVO CALCULO Y PODER HACER EL APUNTE CONTABLE          *
      ******************************************************************
       9101-PASIVO-DIFERIDO.

            INITIALIZE WS-UGWCCRN0
            MOVE  WS-ENTIOFI                TO CRN0-ENTIOFI
            MOVE  WS-CUENTA                 TO CRN0-CUENTA
            MOVE  WS-TOTAL-CARGAR           TO CRN0-CAPITAL
            MOVE  CAA-FECHA-CONT2           TO CRN0-FECHA-OPER2
            MOVE  '2'                       TO CRN0-OPCION

            EXEC CICS
                LINK PROGRAM ('UR2CCRN0')
                COMMAREA     (WS-UGWCCRN0)
                NOHANDLE
            END-EXEC

            EVALUATE CRN0-RETORNO
               WHEN '00'
                   CONTINUE
               WHEN '05'
                   MOVE ZEROS               TO CRN0-CORR-MON
                                               CRN0-INT-DIF
                                               CRN0-CAP-CAS-DIF
                                               CRN0-INT-CAS-DIF
               WHEN '10'
               WHEN '15'
               WHEN '20'
               WHEN '70'
               WHEN '80'
               WHEN '90'
                   MOVE 'UGE0939'           TO C86A-RET-COD-ERROR
                   MOVE 'UR2CCRN0'          TO C86A-RET-VAR1-ERROR
                   MOVE CRN0-DETALLE        TO C86A-RET-VAR2-ERROR
                   PERFORM 3-FINAL-PROGRAMA
               WHEN '60'
                   CONTINUE
               WHEN '99'
                   MOVE 'UGE0939'           TO C86A-RET-COD-ERROR
                   MOVE 'UR2CCRN0'          TO C86A-RET-VAR1-ERROR
                   MOVE CRN0-SQLCODE        TO C86A-RET-VAR2-ERROR(1:9)
                   MOVE CRN0-TABLA          TO C86A-RET-VAR2-ERROR(10:3)
                   MOVE CRN0-DETALLE        TO C86A-RET-VAR2-ERROR(12:8)
                   PERFORM 999999-ABEND-DB2
               WHEN OTHER
                    MOVE 'UGE0517'          TO C86A-RET-COD-ERROR
                    MOVE 'UR2CCRN0 CODIGO DE '
                                            TO C86A-RET-VAR1-ERROR
                    MOVE 'RETORNO '         TO C86A-RET-VAR2-ERROR(1:8)
                    MOVE CRN0-RETORNO       TO C86A-RET-VAR2-ERROR(10:2)
                    MOVE CRN0-SQLCODE       TO C86A-RET-VAR2-ERROR(12:)
                    PERFORM 3-FINAL-PROGRAMA
            END-EVALUATE.

      ******************************************************************
      *                   2391-GRABAR-LOG                              *
      *         SON GRABADOS LOS REGISTROS DE LOS CAMBIOS              *
      *                  EN LA TABLA UGDTLOG                           *
      ******************************************************************
       2391-GRABAR-LOG.

            PERFORM 23192-BUSCA-CONSEC
            MOVE MAE-ENTIOFI                TO LOG-ENTIOFI
            MOVE MAE-CUENTA                 TO LOG-CUENTA
            MOVE 'RE01'                     TO LOG-CODIGO
            ADD  1                          TO LOG-CONSOPE
            MOVE '0001-01-01'               TO LOG-FECANT
            MOVE '0001-01-01'               TO LOG-FECNUE
            MOVE WS-DB2-HOY                 TO LOG-FECMOV
            MOVE 'UGDTCRN'                  TO LOG-TABLA
            MOVE 'ENTREGA ANTICIPADA PASIVO DIFERIDO'
                                            TO LOG-DESCRIPCION
            MOVE C86A-ENTIDAD-CONT          TO LOG-ENTIDAD-UMO
            MOVE C86A-CENTRO-CONT           TO LOG-CENTRO-UMO
            MOVE C86A-USUARIO               TO LOG-USERID-UMO
            MOVE WC-PROGRAMA                TO LOG-NETNAME-UMO
            PERFORM 2391-INSERTAR-LOG.

      ******************************************************************
      *                   23192-BUSCA-CONSEC                           *
      *  BUSQUEDA DEL CONSECUTIVO PARA LA TABLA UGDTLOG
      ******************************************************************
       23192-BUSCA-CONSEC.

            MOVE MAE-ENTIOFI                 TO LOG-ENTIOFI
            MOVE MAE-CUENTA                  TO LOG-CUENTA
      *
            EXEC SQL
              SELECT MAX(LOG_CONSOPE)
              INTO :LOG-CONSOPE
              FROM UGDTLOG
              WHERE LOG_ENTIOFI = :LOG-ENTIOFI  AND
                    LOG_CUENTA  = :LOG-CUENTA
            END-EXEC
      *
            MOVE SQLCODE                     TO DB2-RETURN-CDE
      *
            IF DB2-OK
                CONTINUE
            ELSE IF DB2-NULL-VALUE
                MOVE ZEROS                   TO LOG-CONSOPE
            ELSE
                MOVE ZEROS                   TO LOG-CONSOPE
                MOVE 'SELECT MAX UGDTLOG  '  TO C86A-RET-VAR1-ERROR
                PERFORM 3-FINAL-PROGRAMA
            END-IF.

      ******************************************************************
      *                     2391-INSERTAR-LOG                          *
      *   SE INSERTAN LOS DATOS DENTRO DE LA TABLA UGDTLOG
      ******************************************************************
       2391-INSERTAR-LOG.
      *
           EXEC SQL
               INSERT INTO UGDTLOG
                 (LOG_ENTIOFI,
                  LOG_CUENTA,
                  LOG_TIMESTAMP,
                  LOG_CODIGO,
                  LOG_FECMOV,
                  LOG_CONSOPE,
                  LOG_FECANT,
                  LOG_IMPANT,
                  LOG_CARANT,
                  LOG_TASA_ANT,
                  LOG_FECNUE,
                  LOG_IMPNUE,
                  LOG_CARNUE,
                  LOG_TASA_NUE,
                  LOG_TABLA,
                  LOG_COLUMNA,
                  LOG_DESCRIPCION,
                  LOG_ENTIDAD_UMO,
                  LOG_CENTRO_UMO,
                  LOG_USERID_UMO,
                  LOG_NETNAME_UMO)
               VALUES
                 (:LOG-ENTIOFI,
                  :LOG-CUENTA,
                  CURRENT TIMESTAMP,
                  :LOG-CODIGO,
                  :LOG-FECMOV,
                  :LOG-CONSOPE,
                  :LOG-FECANT,
                  :LOG-IMPANT,
                  :LOG-CARANT,
                  :LOG-TASA-ANT,
                  :LOG-FECNUE,
                  :LOG-IMPNUE,
                  :LOG-CARNUE,
                  :LOG-TASA-NUE,
                  :LOG-TABLA,
                  :LOG-COLUMNA,
                  :LOG-DESCRIPCION,
                  :LOG-ENTIDAD-UMO,
                  :LOG-CENTRO-UMO,
                  :LOG-USERID-UMO,
                  :LOG-NETNAME-UMO)
               END-EXEC
      *
               MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
               EVALUATE DB2-OK
                 WHEN TRUE
                    CONTINUE
                 WHEN OTHER
                    MOVE 'UGDTLOG'                TO C86A-RET-VAR1-ERROR
                    MOVE 'ERR. UPDATE LOG RET '   TO C86A-RET-VAR2-ERROR
                    PERFORM 999999-ABEND-DB2
               END-EVALUATE.

      ******************************************************************
      *                      BUSCAR-UGDTPDI                            *
      *  SE BUSCAN LOS DATOS DENTRO DE LA TABLA UGDTDPI
      ******************************************************************
       5101-BUSCAR-UGDTPDI.
      *
           MOVE WS-DB2-HOY(1:4)                 TO WS-FECHA-PDI(1:4)
           MOVE WS-DB2-HOY(6:2)                 TO WS-FECHA-PDI(5:2)

           EXEC SQL

               SELECT SDO_ANT_CM_DIF,
                      SDO_ANT_I_DIF,
                      SDO_ANT_K_DIF_CAST,
                      SDO_ANT_I_DIF_CAST,
                      ALTA_CM_DIF,
                      ALTA_INT_DIF,
                      ALTA_K_DIF_CAST,
                      ALTA_I_DIF_CAST,
                      AMORT_CM_DIF,
                      AMORT_I_DIF,
                      AMORT_K_DIF_CAST,
                      AMORT_I_DIF_CAST,
                      SDO_FIN_CM_DIF,
                      SDO_FIN_I_DIF,
                      SDO_FIN_K_DIF_CAST,
                      SDO_FIN_I_DIF_CAST

               INTO   :PDI-SDO-ANT-CM-DIF,
                      :PDI-SDO-ANT-I-DIF,
                      :PDI-SDO-ANT-K-DIF-CAST,
                      :PDI-SDO-ANT-I-DIF-CAST,
                      :PDI-ALTA-CM-DIF,
                      :PDI-ALTA-INT-DIF,
                      :PDI-ALTA-K-DIF-CAST,
                      :PDI-ALTA-I-DIF-CAST,
                      :PDI-AMORT-CM-DIF,
                      :PDI-AMORT-I-DIF,
                      :PDI-AMORT-K-DIF-CAST,
                      :PDI-AMORT-I-DIF-CAST,
                      :PDI-SDO-FIN-CM-DIF,
                      :PDI-SDO-FIN-I-DIF,
                      :PDI-SDO-FIN-K-DIF-CAST,
                      :PDI-SDO-FIN-I-DIF-CAST
               FROM   UGDTPDI
               WHERE  ANO_MES =: WS-FECHA-PDI
                 AND  ENTIOFI =: MAE-ENTIOFI
                 AND  CUENTA  =: MAE-CUENTA

           END-EXEC
      *
           MOVE SQLCODE                         TO DB2-RETURN-CDE
      *
           IF DB2-OK
                PERFORM 51011-ACTUALIZACION-UGDTPDI
           ELSE IF DB2-NOTFND
                CONTINUE
           ELSE
                MOVE 'UGE0939'                  TO C86A-RET-COD-ERROR
                MOVE 'SELECT UGDTPDI  '         TO C86A-RET-VAR1-ERROR
                PERFORM 3-FINAL-PROGRAMA
           END-IF.

      ******************************************************************
      *                   ACTUALIZACION-UGDTPDI                        *
      * SE ACTUALIZAN DATOS DENTRO DE LA TABLA UGDTDPI
      ******************************************************************
       51011-ACTUALIZACION-UGDTPDI.
      *
           MOVE WS-DB2-HOY(1:4)               TO WS-FECHA-PDI(1:4)
           MOVE WS-DB2-HOY(6:2)               TO WS-FECHA-PDI(5:2)
           MOVE C86A-ENTIDAD-CONT             TO PDI-ENTIDAD-UMO
           MOVE C86A-CENTRO-CONT              TO PDI-CENTRO-UMO
           MOVE C86A-USUARIO                  TO PDI-USERID-UMO
           MOVE WC-PROGRAMA                   TO PDI-NETNAME-UMO

           COMPUTE PDI-AMORT-CM-DIF     = PDI-AMORT-CM-DIF     +
                                          CRN0-CORR-MON

           COMPUTE PDI-AMORT-I-DIF      = PDI-AMORT-I-DIF      +
                                          CRN0-INT-DIF

           COMPUTE PDI-AMORT-K-DIF-CAST = PDI-AMORT-K-DIF-CAST +
                                          CRN0-CAP-CAS-DIF

           COMPUTE PDI-AMORT-I-DIF-CAST = PDI-AMORT-I-DIF-CAST +
                                          CRN0-INT-CAS-DIF

           COMPUTE PDI-SDO-FIN-CM-DIF   = PDI-SDO-ANT-CM-DIF    -
                                          PDI-AMORT-CM-DIF     +
                                          PDI-ALTA-CM-DIF

           COMPUTE PDI-SDO-FIN-I-DIF    = PDI-SDO-ANT-I-DIF   -
                                          PDI-AMORT-I-DIF      +
                                          PDI-ALTA-INT-DIF

           COMPUTE PDI-SDO-FIN-K-DIF-CAST = PDI-SDO-ANT-K-DIF-CAST -
                                            PDI-AMORT-K-DIF-CAST   +
                                            PDI-ALTA-K-DIF-CAST

           COMPUTE PDI-SDO-FIN-I-DIF-CAST = PDI-SDO-ANT-I-DIF-CAST -
                                            PDI-AMORT-I-DIF-CAST   +
                                            PDI-ALTA-I-DIF-CAST

           EXEC SQL
               UPDATE UGDTPDI
               SET AMORT_CM_DIF       =: PDI-AMORT-CM-DIF,
                   AMORT_I_DIF        =: PDI-AMORT-I-DIF,
                   AMORT_K_DIF_CAST   =: PDI-AMORT-K-DIF-CAST,
                   AMORT_I_DIF_CAST   =: PDI-AMORT-I-DIF-CAST,
                   SDO_FIN_CM_DIF     =: PDI-SDO-FIN-CM-DIF,
                   SDO_FIN_I_DIF      =: PDI-SDO-FIN-I-DIF,
                   SDO_FIN_K_DIF_CAST =: PDI-SDO-FIN-K-DIF-CAST,
                   SDO_FIN_I_DIF_CAST =: PDI-SDO-FIN-I-DIF-CAST,
                   ENTIDAD_UMO        =: PDI-ENTIDAD-UMO,
                   CENTRO_UMO         =: PDI-CENTRO-UMO,
                   USERID_UMO         =: PDI-USERID-UMO,
                   NETNAME_UMO        =: PDI-NETNAME-UMO,
                   TIMESTAMP          = CURRENT TIMESTAMP
               WHERE ANO_MES =: WS-FECHA-PDI
                 AND ENTIOFI =: MAE-ENTIOFI
                 AND CUENTA  =: MAE-CUENTA

           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
                CONTINUE
           ELSE IF DB2-NOTFND
                CONTINUE
           ELSE
                MOVE 'UGDTPDI'                TO C86A-RET-VAR1-ERROR
                MOVE 'UPDATE UGDTPDI  '       TO C86A-RET-VAR2-ERROR
                PERFORM 999999-ABEND-DB2
           END-IF.

      ******************************************************************
      *             267-ACTUALIZAR-DRB                                 *
      ******************************************************************
       267-ACTUALIZAR-DRB.

           MOVE  MAE-ENTIOFI                 TO DRB-ENTIOFI
           MOVE  MAE-CUENTA                  TO DRB-CUENTA

           EXEC SQL
               SELECT UGNINFAC,
                      UGIQUOTA,
                      UGNPLPEN,
                      UGYINAPL,
                      UGSPDREB
               INTO :DRB-UGNINFAC,
                    :DRB-UGIQUOTA,
                    :DRB-UGNPLPEN,
                    :DRB-UGYINAPL,
                    :DRB-UGSPDREB
               FROM UGDTDRB
               WHERE ENTIOFI = :DRB-ENTIOFI
                 AND CUENTA  = :DRB-CUENTA
           END-EXEC

           MOVE SQLCODE                      TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
               IF DB2-NOTFND
                   MOVE CTE-CON-UGB0004      TO C86A-RET-COD-ERROR
                   MOVE 'UGDTDRB'            TO C86A-RET-VAR1-ERROR
                   MOVE SQLCODE              TO C86A-RET-VAR1-ERROR(9:7)
                   PERFORM 3-FINAL-PROGRAMA
               ELSE
                   MOVE 'UGDTDRB'            TO C86A-RET-VAR1-ERROR
                   MOVE 'SELECT  UGDTDRB'    TO C86A-RET-VAR2-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF
      *
           ADD  CTE-CON-1                    TO DRB-UGNINFAC
           MOVE MAE-PLAZO                    TO DRB-UGCPLAZO
      *
           COMPUTE WS-DIF-PLAZOS = BCR-PLAPEN - WS-M-FINAL
           IF BCR-FVTO NOT < BCR-FPPAGO
               ADD 1 TO WS-DIF-PLAZOS
           END-IF
      *
           IF SW-TIPO-REDUC-CUOTA
              IF WS-INDINANT = 'V'
                 IF WS-DB2-FEVALOR NOT < MAE-FEFINCAR
                    MOVE WS-MES-CUOTAO1      TO DRB-UGIQUOTA
                 END-IF
              ELSE
                 IF WS-DB2-FEVALOR > MAE-FEFINCAR
                    MOVE WS-MES-CUOTAO1      TO DRB-UGIQUOTA
                 END-IF
              END-IF
           ELSE
              IF WS-INDINANT = 'V'
                 IF WS-DB2-FEVALOR NOT < MAE-FEFINCAR
                    MOVE WS-MES-CUOTAO2      TO DRB-UGIQUOTA
                 END-IF
              ELSE
                 IF WS-DB2-FEVALOR > MAE-FEFINCAR
                    MOVE WS-MES-CUOTAO2      TO DRB-UGIQUOTA
                 END-IF
              END-IF
           END-IF
      *
           MOVE 0                            TO DRB-UGPQSACT
      *
      * VARIABLE PARA EL SALDO TEORICO UNICAMENTE PARA CAPITALIZABLES
           IF WS-CODTIAMO  = 'D' OR WS-CODTIAMO = 'E'
              COMPUTE DRB-UGSPDREB  = MAE-SALTEOR
              END-COMPUTE
           END-IF

      *EFR01-I
           IF SW-SI-PUNICA
              IF SW-TIPO-PAGO = 'RP'
                 MOVE WS-M-FINAL              TO WS-PLAZO-NVO-PU
              ELSE
                 IF SW-TIPO-PAGO = 'RC'
                    MOVE WS-M-INICIAL         TO WS-PLAZO-NVO-PU
                 END-IF
              END-IF
              COMPUTE WS-KTEOR-PU-NVO       = WS-KTEOR-PU - VLR-K-PU
              COMPUTE WS-COT-PUNICA ROUNDED = WS-KTEOR-PU-NVO /
                                              WS-PLAZO-NVO-PU
              ADD WS-COT-PUNICA               TO DRB-UGIQUOTA
           END-IF
      *EFR01-F
      *
           MOVE  '1'                         TO DRB-UGYINAPL
           MOVE  WC-PROGRAMA                 TO DRB-NETNAME-UMO
           MOVE  C86A-USUARIO                TO DRB-USERID-UMO
           MOVE  C86A-ENTIDAD-CONT           TO DRB-ENTITAT-UMO
           MOVE  C86A-CENTRO-CONT            TO DRB-CENTRE-UMO
      *
           EXEC SQL
               UPDATE UGDTDRB
               SET UGPQSACT     = :DRB-UGPQSACT,
                   UGNINFAC     = :DRB-UGNINFAC,
                   UGCPLAZO     = :DRB-UGCPLAZO,
                   UGIQUOTA     = :DRB-UGIQUOTA,
                   UGYINAPL     = :DRB-UGYINAPL,
                   NETNAME_UMO  = :DRB-NETNAME-UMO,
                   USERID_UMO   = :DRB-USERID-UMO,
                   ENTITAT_UMO  = :DRB-ENTITAT-UMO,
                   CENTRE_UMO   = :DRB-CENTRE-UMO,
                   STAMP_UMO    = CURRENT TIMESTAMP,
      ******  VARIABLE PARA EL SALDO TEORICO                       *****
                   UGSPDREB     = :DRB-UGSPDREB
               WHERE ENTIOFI = :DRB-ENTIOFI
                 AND CUENTA  = :DRB-CUENTA
           END-EXEC

           MOVE SQLCODE                      TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
               IF DB2-NOTFND
                   MOVE CTE-CON-UGB0004      TO C86A-RET-COD-ERROR
                   MOVE 'UGDTDRB'            TO C86A-RET-VAR1-ERROR
                   MOVE SQLCODE              TO C86A-RET-VAR1-ERROR(9:7)
                   PERFORM 3-FINAL-PROGRAMA
               ELSE
                   MOVE 'UGDTDRB'            TO C86A-RET-VAR1-ERROR
                   MOVE 'UPDATE  UGDTDRB'    TO C86A-RET-VAR2-ERROR
                   PERFORM 999999-ABEND-DB2
               END-IF
           END-IF.

      ******************************************************************
      *            268-ACTUALIZAR-IFA                                  *
      ******************************************************************
       268-ACTUALIZAR-IFA.
      *
           INITIALIZE UGTCIFA
           MOVE  MAE-ENTIOFI               TO IFA-ENTIOFI
           MOVE  MAE-CUENTA                TO IFA-CUENTA

 DPR5
 DPR5      MOVE  WS-DB2-HOY                TO IFA-UGFVALOR

           MOVE  DRB-UGNINFAC              TO IFA-UGNROINC
           MOVE  MOV-FECONTA               TO IFA-UGFCPINC
           MOVE  MOV-UGYINDIF              TO IFA-UGYINDIF
           MOVE  MOV-ENTIOPE(1:4)          TO IFA-UGCENTIT
           MOVE  MOV-ENTIOPE(5:4)          TO IFA-UGCOFINC
           MOVE  WC-PROGRAMA               TO IFA-NETNAME-UMO
           MOVE  C86A-USUARIO              TO IFA-USERID-UMO
           MOVE  C86A-ENTIDAD-CONT         TO IFA-ENTITAT-UMO
           MOVE  C86A-CENTRO-CONT          TO IFA-CENTRE-UMO
           MOVE  MOV-SALREAL               TO IFA-LLIURE-IMP1
           MOVE  '1'                       TO IFA-UGYINAPL
           MOVE  '0'                       TO IFA-UGYSIMUL
           MOVE  'D'                       TO IFA-UGTINCID
           MOVE  '0'                       TO IFA-UGYALAUT
           MOVE  WS-MES-IMPORTE            TO IFA-UGIMPORT
      *
           IF WS-INDINANT = 'A' OR 'P'
              COMPUTE IFA-UGINTAMO = WS-MES-INTERESE-ANTI * (-1)
           ELSE
              MOVE  WS-MES-INTERESE        TO IFA-UGINTAMO
           END-IF
      *
           MOVE  ZEROS                     TO IFA-UGICOMIS

           IF SW-TIPO-REDUC-PLAZO
              MOVE WS-DIF-PLAZOS           TO IFA-UGNREBSU
              MOVE WS-FELIQ-ANT            TO IFA-UGFVNANT
              MOVE WS-FELIQ-NOU            TO IFA-UGFVNNOU
           ELSE
              MOVE 0                       TO IFA-UGNREBSU
              MOVE '0001-01-01'            TO IFA-UGFVNANT
              MOVE '0001-01-01'            TO IFA-UGFVNNOU
           END-IF

           IF MAE-LIBRE-CAR6 = 'UVR' OR 'UVRBO'
              COMPUTE IFA-UGISBAMO ROUNDED = UVR-WS-COTIZACION * 10000
           ELSE
              IF WS-INDSUBVE = CTE-CON-S AND
                 WS-INDLIQEN = CTE-CON-S AND
                 WS-INTERESES-SUB-MED > 0
                   MOVE WS-INTERESES-SUB-MED  TO IFA-UGISBAMO
              ELSE
                   MOVE 0                     TO IFA-UGISBAMO
              END-IF
           END-IF
      *
           IF SW-TIPO-REDUC-PLAZO
              MOVE 'X'                     TO IFA-UGCAMORT
           ELSE
              MOVE 'L'                     TO IFA-UGCAMORT
           END-IF
      *
           MOVE CTE-CON-FECHA-NULA         TO IFA-UGFAMTP3
           MOVE CTE-CON-FECHA-NULA         TO IFA-UGFPGNOU
           MOVE CTE-CON-FECHA-NULA         TO IFA-LLIURE-DAT1
           MOVE CTE-CON-FECHA-NULA         TO IFA-LLIURE-DAT2
           MOVE MAE-MONEDA                 TO IFA-MONEDA
      *
      * SE MUEVE EL IMPORTE DE LA CUOTA ANTERIOR A LA INSERCION
      *         DE LA INCIDENCIA
           MOVE DRB-UGIQUOTA               TO IFA-LLIURE-IMP2
           MOVE WC-PROGRAMA                TO IFA-LLIURE-MARCA1
      *
      *****  INDICADOR SI EL INTERES FUE CALCULADO SOBRE EL MONTO  *****
      *****  O SOBRE EL SALDO                                      *****
           MOVE S-TAS-LIQUID               TO IFA-LLIURE-IND2
      *
      * SOLO DEBE EXISTIR UNA IFA POR CAMBIO DE PLAZO VIGENTE DENTRO DEL
      * PERIODO DE LIQUIDACION SE INCLUYE ESTE CONTROL PARA EVITAR
      * ERRORES EN EL BATCH
      *COL13-I
           SET SW-NO-RES-IFA               TO TRUE
      *COL13-F
           IF SW-TIPO-REDUC-PLAZO
              PERFORM 2681-BUSCAR-ANT-IFA
           ELSE
              PERFORM 2682-INSERTAR-IFA
           END-IF.

      ******************************************************************
      *              2681-BUSCAR-ANT-IFA                               *
      *    BUSCAR  EL REGISTRO CORRESPONDIENTE EN LA TABLA DE INCIDEN- *
      *    CIAS DE FACTURACION                                         *
      ******************************************************************
       2681-BUSCAR-ANT-IFA.
      *
           MOVE IFA-UGFVALOR                  TO WS-FECHA-AUXIFA

           IF SW-NO-HAY-GRACIA
              MOVE MAE-FEULIQ                 TO IFA-UGFVALOR
           ELSE
              MOVE MAE-FEFORMA                TO IFA-UGFVALOR
           END-IF

           IF WS-INDINANT = 'A'
              EXEC SQL
                   SELECT
                          UGFVALOR,
                          UGNROINC,
                          UGIMPORT,
                          UGINTAMO,
                          UGNREBSU,
                          LLIURE_IND3,
                          TIMESTAMP
                     INTO
                          :WS-UGFVALOR-ANT,
                          :WS-UGNROINC-ANT,
                          :WS-UGIMPORT-ANT,
                          :WS-UGINTAMO-ANT,
                          :WS-UGNREBSU-ANT,
                          :WS-LLIURE-IND3-ANT,
                          :WS-TIMESTAMP-ANT
                     FROM UGDTIFA
                    WHERE ENTIOFI  =  :MAE-ENTIOFI  AND
                          CUENTA   =  :MAE-CUENTA   AND
                          UGCAMORT IN ('X', 'B')    AND
                          UGYINDIF =  '0'           AND
                          UGFVALOR >  :IFA-UGFVALOR AND
                          UGFVALOR <= :MAE-FEPROLIQ AND
                          UGTINCID =  'D'
              END-EXEC
           ELSE
              EXEC SQL
                   SELECT
                          UGFVALOR,
                          UGNROINC,
                          UGIMPORT,
                          UGINTAMO,
                          UGNREBSU,
                          LLIURE_IND3,
                          TIMESTAMP
                     INTO
                          :WS-UGFVALOR-ANT,
                          :WS-UGNROINC-ANT,
                          :WS-UGIMPORT-ANT,
                          :WS-UGINTAMO-ANT,
                          :WS-UGNREBSU-ANT,
                          :WS-LLIURE-IND3-ANT,
                          :WS-TIMESTAMP-ANT
                     FROM UGDTIFA
                    WHERE ENTIOFI  =  :MAE-ENTIOFI  AND
                          CUENTA   =  :MAE-CUENTA   AND
                          UGCAMORT IN ('X', 'B')    AND
                          UGYINDIF =  '0'           AND
                          UGFVALOR >= :IFA-UGFVALOR AND
                          UGFVALOR <= :MAE-FEPROLIQ AND
                          UGTINCID =  'D'
              END-EXEC
           END-IF
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           MOVE WS-FECHA-AUXIFA               TO IFA-UGFVALOR
      *
           IF DB2-OK
              PERFORM 26811-MARCAR-ANT-IFA
              PERFORM 26812-INSERTAR-NUE-IFA
              PERFORM 26813-INSERTAR-TOT-IFA
              PERFORM 26814-ACTUALIZAR-DRB
           ELSE
              IF DB2-NOTFND
                 PERFORM 2682-INSERTAR-IFA
              ELSE
                 MOVE 'UPDATE  UGDTIFA'       TO C86A-RET-VAR1-ERROR
                 MOVE 'IFAS REDUCCION PLAZO'  TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *              26811-MARCAR-ANT-IFA                              *
      *    MARCA COMO PROCESADA LA IFA QUE SE ENCONTRO ANTERIORMENTE   *
      ******************************************************************
       26811-MARCAR-ANT-IFA.
      *
           MOVE WS-TIMESTAMP-ANT              TO IFA-TIMESTAMP
      *
           EXEC SQL
             UPDATE  UGDTIFA
                SET
                    UGYINDIF    =  '1',
                    NETNAME_UMO = :IFA-NETNAME-UMO,
                    USERID_UMO  = :IFA-USERID-UMO,
                    ENTITAT_UMO = :IFA-ENTITAT-UMO,
                    CENTRE_UMO  = :IFA-CENTRE-UMO,
                    TIMESTAMP   =  CURRENT TIMESTAMP
              WHERE
                    ENTIOFI   = :IFA-ENTIOFI       AND
                    CUENTA    = :IFA-CUENTA        AND
                    TIMESTAMP = :IFA-TIMESTAMP
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              IF  DB2-NOTFND
                 MOVE CTE-CON-UGB0004         TO C86A-RET-COD-ERROR
                 MOVE 'UPDATE UGDTIFA ANTER'  TO C86A-RET-VAR1-ERROR
                 MOVE SQLCODE                 TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UPDATE  UGDTIFA'       TO C86A-RET-VAR1-ERROR
                 MOVE 'UPDATE UGDTIFA ANTER'  TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

      ******************************************************************
      *              24312-INSERTAR-NUE-IFA                            *
      *    INSERTA LA NUEVA IFA EN LA TABLA UGDTIFA                    *
      ******************************************************************
       26812-INSERTAR-NUE-IFA.
      *
           MOVE SPACES                        TO IFA-LLIURE-IND3
           MOVE '1'                           TO IFA-UGYINDIF
      *
           PERFORM 2682-INSERTAR-IFA.

      ******************************************************************
      *              24313-INSERTAR-TOT-IFA                            *
      *    INSERTA LA IFA TOTALIZANDO LOS VALORES Y DEJANDOLA COMO     *
      *    PENDIENTE DE PROCESAR                                       *
      ******************************************************************
       26813-INSERTAR-TOT-IFA.
      *
      * PARA CONTROLAR SI LA IFA ANTERIOR QUE SE VA A TOTALIZAR YA ERA *
      * UNA IFA TOTAL, SE MARCARA LA QUE VAMOS A INSERTAR COMO
      * 'A' = ACUMULADA DE TOTALES, O SI HASTA AHORA ES LA PRIMERA QUE
      * VAMOS A TOTALIZAR ==> 'T'
           IF WS-LLIURE-IND3-ANT = 'T' OR 'A'
              MOVE 'A'                        TO IFA-LLIURE-IND3
           ELSE
              MOVE 'T'                        TO IFA-LLIURE-IND3
           END-IF
      *
           MOVE '0'                           TO IFA-UGYINDIF
           ADD 1                              TO IFA-UGNROINC
           MOVE WS-UGFVALOR-ANT               TO IFA-LLIURE-DAT1

      *    GUARDAMOS EL NUMERO DE LA IFA ANTERIOR LA CUAL VA A SER     *
      *    TOTALIZADA                                                  *
           MOVE WS-UGNROINC-ANT               TO IFA-UGNROIRE
      *
           COMPUTE IFA-UGIMPORT = IFA-UGIMPORT  + WS-UGIMPORT-ANT
           COMPUTE IFA-UGINTAMO = IFA-UGINTAMO  + WS-UGINTAMO-ANT
           COMPUTE IFA-UGNREBSU = IFA-UGNREBSU  + WS-UGNREBSU-ANT
      *
           PERFORM 2682-INSERTAR-IFA.

      ******************************************************************
      *              26814-ACTUALIZAR-DRB                              *
      *    ACTUALIZA EL CONTADOR DE INCIDENCIAS EXISTENTES             *
      ******************************************************************
       26814-ACTUALIZAR-DRB.
      *
           MOVE IFA-ENTIOFI                   TO DRB-ENTIOFI
           MOVE IFA-CUENTA                    TO DRB-CUENTA
           MOVE IFA-UGNROINC                  TO DRB-UGNINFAC
      *
           EXEC SQL
             UPDATE  UGDTDRB
                SET
                    UGNINFAC    = :DRB-UGNINFAC,
                    NETNAME_UMO = :IFA-NETNAME-UMO,
                    USERID_UMO  = :IFA-USERID-UMO,
                    ENTITAT_UMO = :IFA-ENTITAT-UMO,
                    CENTRE_UMO  = :IFA-CENTRE-UMO,
                    STAMP_UMO   =  CURRENT TIMESTAMP
              WHERE
                    ENTIOFI     = :DRB-ENTIOFI       AND
                    CUENTA      = :DRB-CUENTA
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT DB2-OK
              IF  DB2-NOTFND
                 MOVE CTE-CON-UGB0004         TO C86A-RET-COD-ERROR
                 MOVE 'UPDATE CONT UGDTDRB'   TO C86A-RET-VAR1-ERROR
                 MOVE SQLCODE                 TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UPDATE  UGDTDRB'       TO C86A-RET-VAR1-ERROR
                 MOVE 'UPDATE NUMERO INCIDE'  TO C86A-RET-VAR2-ERROR
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.

