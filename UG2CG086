      ******************************************************************
      *             24726-1-UR8CCOT0                                   *
      ******************************************************************
       24726-1-UR8CCOT0.
      *
           IF COT-TIP-CUOTA = 'H'

              MOVE MAE-ENTIOFI                TO AMA-ENTIOFI
              MOVE MAE-CUENTA                 TO AMA-CUENTA

              EXEC SQL
                  SELECT LIBRE_CAR2
                  INTO :AMA-LIBRE-CAR2
                  FROM UGDTAMA
                  WHERE ENTIOFI = :AMA-ENTIOFI
                    AND CUENTA  = :AMA-CUENTA
              END-EXEC

              MOVE SQLCODE TO DB2-RETURN-CDE
      *
              IF NOT DB2-OK
                 IF  DB2-NOTFND
                    MOVE 'UGE0939'               TO C86A-RET-COD-ERROR
                    MOVE 'NO ENCONT. GRADIENTE'  TO C86A-RET-VAR1-ERROR
                    MOVE 'EN UGDTAMA '      TO C86A-RET-VAR2-ERROR(1:10)
                    MOVE SQLCODE            TO C86A-RET-VAR2-ERROR(11:9)
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    MOVE 'UGDTAMA'               TO C86A-RET-VAR1-ERROR
                    MOVE 'SELECT UGDTAMA GRAD'   TO C86A-RET-VAR2-ERROR
                    PERFORM 999999-ABEND-DB2
                 END-IF
              END-IF

              MOVE AMA-LIBRE-CAR2(1:5)           TO WS-GRAD
              MOVE WS-GRAD-N                     TO COT-INT-GRAD

           END-IF

           CALL  BBVA-UR8CCOT0 USING COT-NIVEL-01
      *
           EVALUATE  COT-CODIGO
              WHEN  ZERO

                 IF MAE-IND-MARCA2 = 'R'
                    PERFORM 22725-AJUSTA-CUOTA
                 END-IF

                 IF WS-BAND-FIN = 1 AND WS-CODTIAMO = '2'
                    COMPUTE WS-CAPITAL-ENT ROUNDED = COT-CUOTA
                    MOVE WS-CAPITAL-ENT       TO COT-CUOTA
                 END-IF

                 MOVE CTE-CON-ALFA-0          TO WS-IND-3

              WHEN  CTE-CON-1
                 MOVE CTE-CON-UGA0043         TO WS-AVISO
                 PERFORM 120-ENVIAR-AVISO
                 MOVE CTE-CON-ALFA-1          TO WS-IND-3
              WHEN  OTHER
                 MOVE 'UGE0517'               TO C86A-RET-COD-ERROR
                 MOVE 'UR8CCOT0'              TO C86A-RET-VAR1-ERROR
                 MOVE COT-CODIGO              TO C86A-RET-VAR2-ERROR
                 PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.

      ******************************************************************
