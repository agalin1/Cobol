                UGYINDIF,
                IND_MARCA1,
                IND_MARCA2,
                ENTIDAD_PAG,
                CENTRO_PAG,
                CUENTA_PAG,
                DIGICCC1_PAG,
                DIGICCC2_PAG,
                UGYINCOR ,
                CLADIS ,
                NETNAME_UMO,
                USERID_UMO,
                ENTIDAD_UMO,
                CENTRO_UMO,
                RUTA,
                MONEDA,
                NUMER_MOV,
      ***** INCLUSION DE VARIABLES PARA PODER REALIZAR LA ANULACION*****
