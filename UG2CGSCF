                           MOVE WS-FECSOLI         TO WS-FECSALVA
                           MOVE WS-FECIMPO         TO WS-FECSOLI
                           MOVE WS-FECHA-FIN       TO WS-FECHA-AUX
                           PERFORM 22113-DIF-FEFORMA-ULTCUO
                           MOVE WS-FECSALVA        TO WS-FECSOLI
                           MOVE WS-DIF-MESES       TO WS-MESES-SEG
                        END-IF
                     END-IF
                   END-IF
      *@COL03-F
                   COMPUTE WS-PRIMSEGU = WS-PRIMSEGU * WS-MESES-SEG
                   MOVE WS-PRIMSEGU     TO WS-CUOTA-SEGURO(WS-CONTA4)
                   ADD WS-PRIMSEGU      TO WS-CUOTA-TOTAL(WS-CONTA4)
                END-IF
               END-IF
      *        PERFORM 227C-CALCULAR-SEGUROS
      *
      *        MOVE WS-PRIMSEGU     TO WS-CUOTA-SEGURO(WS-CONTA4)
      *        ADD WS-PRIMSEGU      TO WS-CUOTA-TOTAL(WS-CONTA4)

               ADD 1                      TO WS-CONTA3
             END-IF

             IF WS-CONTA6 EQUAL 1
                MOVE NSCF-VLRCRED         TO WS-SALDOPEN(WS-CONTA4)
             ELSE
                MOVE WS-DEUDA-PEND        TO WS-SALDOPEN(WS-CONTA4)
             END-IF

      *COL01-I
      *      ADD 1                        TO WS-CONTA4
             IF SW-NO-INTREM
                 AND (WS-CUOTA-TOTAL(WS-CONTA4) EQUAL ZEROES)
                   CONTINUE
             ELSE
                   ADD 1                  TO WS-CONTA4
             END-IF
      *COL01-F

             IF WS-FELIQCA(WS-CONTA1) EQUAL SPACES
               SET SI-FIN-CAPITAL         TO TRUE
             END-IF

             IF WS-FELIQIN(WS-CONTA2) EQUAL SPACES
               SET SI-FIN-INTERES         TO TRUE
             END-IF

             IF WS-FELIQSE(WS-CONTA3) EQUAL SPACES
               SET SI-FIN-SEGURO          TO TRUE
             END-IF

             MOVE WS-FELIQCA(WS-CONTA1)         TO WS-FECIMPO

             IF NO-FIN-INTERES
               IF WS-FECIMPO > WS-FELIQIN(WS-CONTA2)
                  MOVE WS-FELIQIN(WS-CONTA2) TO WS-FECIMPO
               END-IF
             END-IF

             IF NO-FIN-SEGURO
               IF WS-FECIMPO > WS-FELIQSE(WS-CONTA3)
                 MOVE WS-FELIQSE(WS-CONTA3) TO WS-FECIMPO
               END-IF
             END-IF

           END-PERFORM

           COMPUTE WS-TOTALREG-FLEX = WS-CONTA4 - 1.

