      *COL01-I
      ******************************************************************
      * 2831-CALCULA-VEHI                                              *
      * SE REALIZA EL CALCULO PARA VEHICULOS                           *
      ******************************************************************
       2831-CALCULA-VEHI.
      *
           PERFORM 282-CONSULTAR-LQS
           PERFORM 9999-CAMBIA-TASA-NOMINAL
           MOVE CVT-NOMINAL    TO WS-CI-TEAP-LQS
      *
           EVALUATE NSCF-OPCSUBV
              WHEN 1
                PERFORM 2832-CALCULA-VEHI-OPC1
              WHEN 2
                PERFORM 2833-CALCULA-VEHI-OPC2
              WHEN 3
                PERFORM 2834-CALCULA-VEHI-OPC3
              WHEN OTHER
                 MOVE 'UGE0710'       TO CAA-COD-ERROR
                 MOVE 'OPC. SUBV'     TO CAA-VAR1-ERROR
                 MOVE '<1> <2> O <3>' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
           END-EVALUATE.
      ******************************************************************
      * 2832-CALCULA-VEHI-OPC1                                         *
      * SE REALIZA CALCULO VEHICULO POR OPCION 1                       *
      ******************************************************************
       2832-CALCULA-VEHI-OPC1.
                IF NSCF-GRCSUBV = '1' OR NSCF-GRCSUBV = '2'
                 MOVE WS-CI-VLRS TO WS-VAL-SUBVENCION
                 DIVIDE WS-CI-VLRS BY WS-CI-VLRF    GIVING WS-CI-TEPA
                 COMPUTE WS-CI-TEPV = (1 / (1 - WS-CI-TEPA)) - 1
                 COMPUTE WS-CI-TEAS = ((1 + WS-CI-TEPV) **
                         (12 / WS-PLAZ-SUBV)) - 1
                 MULTIPLY 100 BY WS-CI-TEAS GIVING WS-TASA-SUBV
      *          PARA EL CASO CON PERIODO DE GRACIA SE CALCULAN LOS
      *          INTERESES AL FINAL DEL PERIODO SUBVENCIONADO
                 IF NSCF-GRCSUBV = '1'
      * PARA LOS PLANES ESPECIALES, CON OPCION DE % DESCUENTO O VALOR
      * FIJO CON GRACIA LA TASA DE SUBVENCION CALCULADA DEBE SER MAYOR
      * O IGUAL A LA TASA POLITICA DEL SUBPRODUCTO
                    IF SW-ESPECIAL-SI
                       IF WS-TASA-SUBV < WS-CI-TEAP
                          MOVE 'UGE7608'           TO CAA-COD-ERROR
                          MOVE SPACES              TO CAA-VAR1-ERROR
                          MOVE SPACES              TO CAA-VAR2-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          CONTINUE
                       END-IF
                    ELSE
                       CONTINUE
                    END-IF

                    COMPUTE WS-TZ-CONTR = ((1 + ( WS-CI-TEAP / 100)) /
                                           (1 + WS-CI-TEAS)) - 1
                    IF WS-TZ-CONTR < 0
                       MOVE 0 TO WS-TZ-CONTR
                    END-IF
                    COMPUTE WS-TZ-CONTR-M = ((1 + WS-TZ-CONTR) **
                                             ( 1 / 12 )) - 1
                    COMPUTE WS-TZ-CONTR-A = (( 1 + WS-TZ-CONTR-M ) **
                                              12) - 1
                    COMPUTE WS-INT-FIN-SUBV = ((( 1 + WS-TZ-CONTR-A ) **
                                           (WS-PLAZ-SUBV / 12)) - 1 ) *
                                              WS-CI-VLRF
                 COMPUTE WS-INT-FIN-SUBV-N ROUNDED = 1 * WS-INT-FIN-SUBV
      *          DISPLAY 'U884 TASA CONTRAT        :' WS-TZ-CONTR-A
      *          DISPLAY 'U884 INTER FINAL P. SUBV :' WS-INT-FIN-SUBV-N
OIRT  *
                 IF WS-INT-FIN-SUBV-N >    ZEROS
                    SET SW-SI-INTRE             TO TRUE
                 END-IF
OIRT  *
                 ELSE
                    IF WS-TASA-SUBV < WS-CI-TEAP AND SW-ESPECIAL-SI
                       MOVE 'UGE7611'           TO CAA-COD-ERROR
                       MOVE SPACES              TO CAA-VAR1-ERROR
                       MOVE SPACES              TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    END-IF
                 END-IF
                ELSE
      *            IF NSCF-OPCION EQUAL CTE-S
                    PERFORM 102-GENERA-PLAN-CUOTAS
      *            END-IF
      *             PERFORM 282-CONSULTAR-LQS
                    PERFORM 2831-LLAMA-TIR
                    MULTIPLY 1 BY WS-TIR-EA GIVING WS-TASA-SUBV ROUNDED
                    MOVE WS-CI-VLRS TO WS-VAL-SUBVENCION
                END-IF.
      ******************************************************************
      * 2833-CALCULA-VEHI-OPC2                                        *
      * SE REALIZA CALCULO VEHICULO POR OPCION 2                       *
      ******************************************************************
       2833-CALCULA-VEHI-OPC2.
                IF NSCF-GRCSUBV = '1' OR NSCF-GRCSUBV = '2'
OIRT  *          COMPUTE WS-CI-VLRS = WS-CI-VLRF * WS-PORCDES
OIRT             COMPUTE WS-CI-VLRS = WS-VLRVEHI * WS-PORCDES
                 MOVE WS-CI-VLRS TO WS-VAL-SUBVENCION
                 DIVIDE WS-CI-VLRS BY WS-CI-VLRF    GIVING WS-CI-TEPA
                 COMPUTE WS-CI-TEPV = (1 / (1 - WS-CI-TEPA)) - 1
                 COMPUTE WS-CI-TEAS = ((1 + WS-CI-TEPV) **
                         (12 / WS-PLAZ-SUBV)) - 1
                 MULTIPLY 100 BY WS-CI-TEAS GIVING WS-TASA-SUBV
                 IF NSCF-GRCSUBV = '1'
      * PARA LOS PLANES ESPECIALES, CON OPCION DE % DESCUENTO O VALOR
      * FIJO CON GRACIA LA TASA DE SUBVENCION CALCULADA DEBE SER MAYOR
      * O IGUAL A LA TASA POLITICA DEL SUBPRODUCTO
                    IF SW-ESPECIAL-SI
                       IF WS-TASA-SUBV < WS-CI-TEAP
                          MOVE 'UGE7608'           TO CAA-COD-ERROR
                          MOVE SPACES              TO CAA-VAR1-ERROR
                          MOVE SPACES              TO CAA-VAR2-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          CONTINUE
                       END-IF
                    ELSE
                       CONTINUE
                    END-IF

                    COMPUTE WS-TZ-CONTR = ((1 + ( WS-CI-TEAP / 100)) /
                                           (1 + WS-CI-TEAS)) - 1
                    IF WS-TZ-CONTR < 0
                       MOVE 0 TO WS-TZ-CONTR
                    END-IF
                    COMPUTE WS-TZ-CONTR-M = ((1 + WS-TZ-CONTR) **
                                             ( 1 / 12 )) - 1
                    COMPUTE WS-TZ-CONTR-A = (( 1 + WS-TZ-CONTR-M ) **
                                              12) - 1
                    COMPUTE WS-INT-FIN-SUBV = ((( 1 + WS-TZ-CONTR-A ) **
                                           (WS-PLAZ-SUBV / 12)) - 1 ) *
                                              WS-CI-VLRF
                 COMPUTE WS-INT-FIN-SUBV-N ROUNDED = 1 * WS-INT-FIN-SUBV
      *          DISPLAY 'U144 INTER FINAL P. SUBV2:' WS-INT-FIN-SUBV-N
OIRT  *
                 IF WS-INT-FIN-SUBV-N > ZEROS
                    SET SW-SI-INTRE             TO TRUE
                 END-IF
OIRT  *
                 ELSE
                    IF WS-TASA-SUBV < WS-CI-TEAP AND SW-ESPECIAL-SI
                       MOVE 'UGE7611'           TO CAA-COD-ERROR
                       MOVE SPACES              TO CAA-VAR1-ERROR
                       MOVE SPACES              TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    END-IF
                 END-IF
                ELSE
OIRT  *          COMPUTE WS-CI-VLRS = WS-CI-VLRF * WS-PORCDES
OIRT             COMPUTE WS-CI-VLRS = WS-VLRVEHI * WS-PORCDES
      *          IF NSCF-OPCION EQUAL CTE-S
                    PERFORM 102-GENERA-PLAN-CUOTAS
      *          END-IF
      *          PERFORM 282-CONSULTAR-LQS
                 PERFORM 2831-LLAMA-TIR
                 MULTIPLY 1 BY WS-TIR-EA GIVING WS-TASA-SUBV ROUNDED
                 MOVE WS-CI-VLRS TO WS-VAL-SUBVENCION
                END-IF.
      ******************************************************************
      * 2834-CALCULA-VEHI-OPC3                                        *
      * SE REALIZA CALCULO VEHICULO POR OPCION 3                       *
      ******************************************************************
       2834-CALCULA-VEHI-OPC3.
                 COMPUTE WS-TASCONCMV = (( 1 + (WS-TASCONC / 100 )) **
                                         ( 1 / 12 )) - 1
                 COMPUTE WS-CI-VLRS = WS-CI-VLRF * WS-TASCONCMV *
                         WS-PLAZ-SUBV
                 IF WS-CI-VLRS > WS-CI-VLRF
                    MOVE 'UGE7610'           TO CAA-COD-ERROR
                    MOVE SPACES              TO CAA-VAR1-ERROR
                    MOVE SPACES              TO CAA-VAR2-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 END-IF
                 MOVE WS-TASCONC TO WS-TASA-SUBV
                 MOVE WS-CI-VLRS TO WS-VAL-SUBVENCION.
      ******************************************************************
      * 102-GENERA-PLAN-CUOTAS                                         *
      ******************************************************************
       102-GENERA-PLAN-CUOTAS.
           MOVE ZEROS TO WS-PERIODICIDAD WS-VALCUO WS-I TIR-UGWCTIR0
                         WS-IMPORTE-TOTAL WS-PLZ-REAL
           MOVE CAA-FECHA-OPER2 TO WS-FECHA-ORI
           MOVE 1 TO WS-I
           IF SW-ESPECIAL-SI
      *       RECORRE LOS DATOS DE LA GRILLA PARA RECUPERAR LOS
      *       VALORES DE LAS CUOTAS INGRESADAS, COMPLETA EL PLAN DE
      *       CUOTAS CON CEROS PARA LLENAR LA T-MEM Y QUE CUADRE
      *       CON EL PLAZO DEL CREDITO
              PERFORM VARYING WS-J FROM 1 BY 1 UNTIL WS-J > WS-CI-N
                      OR (NSCF-CUOTA-FECHA(WS-I) = SPACES OR
                          NSCF-CUOTA-FECHA(WS-I) = LOW-VALUES)
                 MOVE WS-J            TO WS-NUMERO-MESES
                 PERFORM 10-DESPLAZA-FECHA
                 IF NSCF-CUOTA-FECHA-AAAA(WS-I) = WS-FECHA-DES-AAAA AND
                    NSCF-CUOTA-FECHA-MM(WS-I) = WS-FECHA-DES-MM
                    PERFORM 222-MUEVE-REG-ACTUAL
                    MOVE WS-CUOT-ACT-IMPORTE TO TIR-ABONO(WS-J)
                    ADD 1 TO WS-I
                 ELSE
                    MOVE ZERO TO TIR-ABONO(WS-J)
                 END-IF
              END-PERFORM
           ELSE
      *       PILAS!!! VERIFICAR PARA LOS CASOS CON GRACIA SI SE DEBE
      *       TENER EN CUENTA PARA AUMENTAR EL VALOR DE LAS CUOTAS.
              IF NSCF-GRCSUBV = '1'
                 SUBTRACT WS-PLAZ-GRACIA FROM WS-CI-N GIVING WS-PLZ-REAL
                 IF WS-PLZ-REAL = 0
                    MOVE 'UGE7604' TO CAA-COD-ERROR
                    MOVE SPACES TO CAA-VAR1-ERROR
                    MOVE SPACES TO CAA-VAR2-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 END-IF
              ELSE
                 MOVE WS-CI-N TO WS-PLZ-REAL
              END-IF
              MOVE WS-PERC          TO WS-PERC-N
      ************SOLUCIONADO****************************************
              DIVIDE WS-PLZ-REAL BY WS-PERC-N GIVING WS-COC1 REMAINDER
                     WS-RES1
              DIVIDE WS-CI-VLRF BY WS-COC1 GIVING WS-VALCUO
              PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-PLZ-REAL
                 DIVIDE WS-I BY WS-PERC-N GIVING WS-COC2 REMAINDER
                        WS-RES2
                 IF WS-RES2 = 0
                    MOVE WS-VALCUO TO TIR-ABONO(WS-I)
                    ADD WS-VALCUO TO WS-IMPORTE-TOTAL
                 ELSE
                    MOVE 0 TO TIR-ABONO(WS-I)
                 END-IF
              END-PERFORM
              COMPUTE WS-IMPORTE-TOTAL-2 ROUNDED = WS-IMPORTE-TOTAL * 1


      *       DISPLAY 'WS-IMPORTE-TOTAL-2' WS-IMPORTE-TOTAL-2
      *       DISPLAY 'WS-CI-VLRF'         WS-CI-VLRF

              IF WS-IMPORTE-TOTAL-2 = WS-CI-VLRF
                 CONTINUE
              ELSE
                 MOVE 'UGE2652' TO CAA-COD-ERROR
                 MOVE 'TOTAL PLAN CUOTAS' TO CAA-VAR1-ERROR
                 MOVE 'NO ES VALOR CRED' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
           END-IF.
      ******************************************************************
      * 2831-LLAMA-TIR                                                 *
      ******************************************************************
       2831-LLAMA-TIR.
           MOVE '01' TO TIR-OPCION
           SUBTRACT WS-CI-VLRS FROM WS-CI-VLRF GIVING TIR-VALDESM
           MOVE WS-CI-TEAP TO TIR-TASAPOL
           MOVE WS-CI-N    TO TIR-PLAZO
           CALL 'UG9CTIR0' USING TIR-UGWCTIR0
           IF TIR-RETORNO = '00'
                 MOVE ZEROS TO WS-TIR-EA
                 DIVIDE TIR-TASATIR BY 100 GIVING WS-TASATIR-PCT
                 COMPUTE WS-TIR-EA = (( 1 + WS-TASATIR-PCT ) ** 12 ) - 1
                 MULTIPLY 100 BY WS-TIR-EA
           ELSE
              MOVE 'UGE7601' TO CAA-COD-ERROR
              MOVE TIR-RETORNO     TO CAA-VAR1-ERROR
              MOVE TIR-DESCRIPCION TO CAA-VAR2-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF.
      ******************************************************************
      * 10-DESPLAZA-FECHA                                              *
      ******************************************************************
       10-DESPLAZA-FECHA.
           INITIALIZE WS-FCH-FACT1 WS-FCH-FACT2
           MOVE WS-FECHA-ORI TO WS-FECHA-DES
           ADD WS-NUMERO-MESES TO WS-FECHA-ORI-MM GIVING WS-FECHA-DES-MM
           IF WS-FECHA-DES-MM > 12
              DIVIDE WS-FECHA-DES-MM BY 12 GIVING WS-FCH-FACT1 REMAINDER
                     WS-FCH-FACT2
           ELSE
              MOVE WS-FECHA-DES-MM TO WS-FCH-FACT2
           END-IF
           IF WS-FCH-FACT1 < 1
              CONTINUE
           ELSE
              IF WS-FCH-FACT2 >= 1
                 ADD WS-FCH-FACT1 TO WS-FECHA-DES-AAAA
              ELSE
                 COMPUTE WS-FECHA-DES-AAAA = WS-FECHA-DES-AAAA +
                                             (WS-FCH-FACT1 - 1)
              END-IF
           END-IF
           MOVE WS-FCH-FACT2 TO WS-FECHA-DES-MM
           IF WS-FECHA-DES-MM = ZERO
              MOVE 12 TO WS-FECHA-DES-MM
           END-IF
           PERFORM 101-VALIDA-BISIESTO
           IF WS-FECHA-DES-MM = 2
              IF ES-BISIESTO
                 IF WS-FECHA-DES-DD > 28
                    MOVE 29 TO WS-FECHA-DES-DD
                 ELSE
                    CONTINUE
                 END-IF
              ELSE
                 IF WS-FECHA-DES-DD > 28
                    MOVE 28 TO WS-FECHA-DES-DD
                 ELSE
                    CONTINUE
                 END-IF
              END-IF
           ELSE
              IF (WS-FECHA-DES-MM = 4 OR WS-FECHA-DES-MM = 6 OR
                  WS-FECHA-DES-MM = 9 OR WS-FECHA-DES-MM = 11) AND
                  WS-FECHA-DES-DD > 30
                 MOVE 30 TO WS-FECHA-DES-DD
              ELSE
                 CONTINUE
              END-IF
           END-IF.

       101-VALIDA-BISIESTO.
           INITIALIZE SW-BISIESTO WS-FCH-FACT1 WS-FCH-FACT2
           DIVIDE WS-FECHA-DES-AAAA BY 4 GIVING WS-FCH-FACT1 REMAINDER
                  WS-FCH-FACT2
           IF WS-FCH-FACT2 NOT = ZERO
              SET NO-ES-BISIESTO TO TRUE
           ELSE
              DIVIDE WS-FECHA-DES-AAAA BY 100 GIVING
                     WS-FCH-FACT1 REMAINDER WS-FCH-FACT2
              IF WS-FCH-FACT2 NOT = ZERO
                 SET ES-BISIESTO TO TRUE
              ELSE
                 DIVIDE WS-FECHA-DES-AAAA BY 400 GIVING
                        WS-FCH-FACT1 REMAINDER WS-FCH-FACT2
                 IF WS-FCH-FACT2 = ZERO
                    SET ES-BISIESTO TO TRUE
                 ELSE
                    SET NO-ES-BISIESTO TO TRUE
                 END-IF
              END-IF
           END-IF.
