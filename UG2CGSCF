                    IF WS-CI-VLRS >= WS-CI-VLRF
                       MOVE 'UGE2652'              TO CAA-COD-ERROR
                       MOVE 'VAL SUBVENCION DEBE ' TO CAA-VAR1-ERROR
                       MOVE 'SER < VAL CREDITO   ' TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    END-IF
                 END-IF
                 IF NSCF-VLRVEHI-ALF  = SPACES OR
                    NSCF-VLRVEHI-ALF  = LOW-VALUES
                    MOVE 'UGE0710'      TO CAA-COD-ERROR
                    MOVE 'VALOR VEHICULO' TO CAA-VAR1-ERROR
                    MOVE 'NUMERICO'     TO CAA-VAR2-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 ELSE
      *             COMPUTE WS-VLRVEHI = FUNCTION NUMVAL(NSCF-VLRVEHI)
                    MOVE NSCF-VLRVEHI    TO WS-VLRVEHI
                    IF WS-VLRVEHI < WS-CI-VLRF
                       MOVE 'UGE7606' TO CAA-COD-ERROR
                       MOVE SPACES TO CAA-VAR1-ERROR
                       MOVE SPACES TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    END-IF
                 END-IF
                 EVALUATE NSCF-GRCSUBV
                    WHEN '1'
                       IF NSCF-PLZSUBV = SPACES OR
                          NSCF-PLZSUBV = LOW-VALUES
                          MOVE 'UGEW001'          TO CAA-COD-ERROR
                          MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          COMPUTE WS-PLAZ-SUBV =
                                  FUNCTION NUMVAL(NSCF-PLZSUBV)
                          IF WS-PLAZ-SUBV > 18
                             MOVE 'UGE2652' TO CAA-COD-ERROR
                             MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                             MOVE 'DEBE SER <= 18' TO CAA-VAR2-ERROR
                             PERFORM 3-FIN-PROGRAMA
                          ELSE
                             IF WS-PLAZ-SUBV > WS-CI-N
                                MOVE 'UGE7605' TO CAA-COD-ERROR
                                MOVE SPACES TO CAA-VAR1-ERROR
                                MOVE SPACES TO CAA-VAR2-ERROR
                                PERFORM 3-FIN-PROGRAMA
                             ELSE
                                MOVE WS-PLAZ-SUBV TO WS-PLAZ-GRACIA
                                SET  SW-GRACIA-SI TO TRUE
                             END-IF
                          END-IF
                       END-IF
                    WHEN '2'
                       IF NSCF-PLZSUBV = SPACES OR
                          NSCF-PLZSUBV = LOW-VALUES
                          MOVE 'UGEW001'          TO CAA-COD-ERROR
                          MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          COMPUTE WS-PLAZ-SUBV =
                                  FUNCTION NUMVAL(NSCF-PLZSUBV)
                          IF WS-PLAZ-SUBV > 18
                             MOVE 'UGE2652' TO CAA-COD-ERROR
                             MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                             MOVE 'DEBE SER <= 18' TO CAA-VAR2-ERROR
                             PERFORM 3-FIN-PROGRAMA
                          ELSE
                             IF WS-PLAZ-SUBV > WS-CI-N
                                MOVE 'UGE7605' TO CAA-COD-ERROR
                                MOVE SPACES TO CAA-VAR1-ERROR
                                MOVE SPACES TO CAA-VAR2-ERROR
                                PERFORM 3-FIN-PROGRAMA
                             ELSE
                                SET SW-TASPOL-SI  TO TRUE
                                MOVE WS-PLAZ-SUBV TO WS-PLAZ-TASA
                                MOVE 0 TO WS-PLAZ-GRACIA
                             END-IF
                          END-IF
                       END-IF
                    WHEN '3'
                       MOVE WS-CI-N TO WS-PLAZ-SUBV
                    WHEN OTHER
                       MOVE 'UGE0710'      TO CAA-COD-ERROR
                       MOVE 'GRACIA SUBVENC' TO CAA-VAR1-ERROR
                       MOVE '<1> <2> O <3> '    TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                 END-EVALUATE
                 IF SW-ESPECIAL-SI
                    PERFORM 22-VALIDA-PLAN-ACIC-CALCULO
                 ELSE
                    PERFORM 2811-VALIDA-PERIODICIDADES
                 END-IF.
      *
      ******************************************************************
      * 20232-OPCION-2                                                 *
      * OPCION SUBVENCION 2                                            *
      ******************************************************************
       20232-OPCION-2.
                 IF NSCF-PORCDES = SPACES OR
                    NSCF-PORCDES = LOW-VALUES
                    MOVE 'UGEW001'          TO CAA-COD-ERROR
                    MOVE 'PORC. DESCUENTO ' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                 ELSE
                    COMPUTE WS-PORCDES =
                            FUNCTION NUMVAL(NSCF-PORCDES) / 100
                    IF WS-PORCDES >= 0.0001
                       IF WS-PORCDES <= 0.9
                          CONTINUE
                       ELSE
                          MOVE 'UGE2652' TO CAA-COD-ERROR
                          MOVE 'EL PORC. DESC. DEBE' TO CAA-VAR1-ERROR
                          MOVE 'SER MENOR AL 90%   ' TO CAA-VAR2-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       END-IF
                    ELSE
                       MOVE 'UGE2652' TO CAA-COD-ERROR
                       MOVE 'EL PORC. DESC. DEBE' TO CAA-VAR1-ERROR
                       MOVE 'SER MAYOR AL 0.1%  ' TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    END-IF
                 END-IF
                 IF NSCF-VLRVEHI-ALF = SPACES OR
                    NSCF-VLRVEHI-ALF = LOW-VALUES
                    MOVE 'UGEW001'          TO CAA-COD-ERROR
                    MOVE 'PORC. DESCUENTO ' TO CAA-VAR1-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 ELSE
      *             COMPUTE WS-VLRVEHI = FUNCTION NUMVAL(NSCF-VLRVEHI)
                    MOVE NSCF-VLRVEHI    TO WS-VLRVEHI
                    IF WS-VLRVEHI < WS-CI-VLRF
                       MOVE 'UGE7606' TO CAA-COD-ERROR
                       MOVE SPACES TO CAA-VAR1-ERROR
                       MOVE SPACES TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    END-IF
                 END-IF
                 EVALUATE NSCF-GRCSUBV
                    WHEN '1'
                    WHEN '2'
                       IF NSCF-PLZSUBV = SPACES OR
                          NSCF-PLZSUBV = LOW-VALUES
                          MOVE 'UGEW001'          TO CAA-COD-ERROR
                          MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          COMPUTE WS-PLAZ-SUBV =
                                  FUNCTION NUMVAL(NSCF-PLZSUBV)
                          IF WS-PLAZ-SUBV > 18
                             MOVE 'UGE2652' TO CAA-COD-ERROR
                             MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                             MOVE 'DEBE SER <= 18' TO CAA-VAR2-ERROR
                             PERFORM 3-FIN-PROGRAMA
                          ELSE
                             IF WS-PLAZ-SUBV > WS-CI-N
                                MOVE 'UGE7605' TO CAA-COD-ERROR
                                MOVE SPACES TO CAA-VAR1-ERROR
                                MOVE SPACES TO CAA-VAR2-ERROR
                                PERFORM 3-FIN-PROGRAMA
                             END-IF
                          END-IF
                       END-IF
2702                   IF NSCF-GRCSUBV = '1'
2702                      MOVE WS-PLAZ-SUBV TO WS-PLAZ-GRACIA
                          SET  SW-GRACIA-SI TO TRUE
                       ELSE
                          MOVE WS-PLAZ-SUBV TO WS-PLAZ-TASA
                          SET  SW-TASPOL-SI TO TRUE
2702                   END-IF
                    WHEN '3'
                       CONTINUE
                    WHEN OTHER
                       MOVE 'UGE0710'      TO CAA-COD-ERROR
                       MOVE 'GRACIA SUBVENC' TO CAA-VAR1-ERROR
                       MOVE '<1> <2> O <3> '    TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                 END-EVALUATE
                 IF SW-ESPECIAL-SI
                    PERFORM 22-VALIDA-PLAN-ACIC-CALCULO
                 ELSE
                    PERFORM 2811-VALIDA-PERIODICIDADES
                 END-IF.
      *
      ******************************************************************
      * 20233-OPCION-3                                                 *
      * OPCION SUBVENCION 3                                            *
      ******************************************************************
       20233-OPCION-3.
                 EVALUATE NSCF-GRCSUBV
                    WHEN '1'
                       IF NSCF-PLZSUBV = SPACES OR
                          NSCF-PLZSUBV = LOW-VALUES
                          MOVE 'UGEW001'          TO CAA-COD-ERROR
                          MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          COMPUTE WS-PLAZ-SUBV =
                                  FUNCTION NUMVAL(NSCF-PLZSUBV)
                          IF WS-PLAZ-SUBV > 18
                             MOVE 'UGE2652' TO CAA-COD-ERROR
                             MOVE 'PLAZO SUBVENCION' TO CAA-VAR1-ERROR
                             MOVE 'DEBE SER <= 18' TO CAA-VAR2-ERROR
                             PERFORM 3-FIN-PROGRAMA
                          ELSE
                             IF WS-PLAZ-SUBV > WS-CI-N
                                MOVE 'UGE7605' TO CAA-COD-ERROR
                                MOVE SPACES TO CAA-VAR1-ERROR
                                MOVE SPACES TO CAA-VAR2-ERROR
                                PERFORM 3-FIN-PROGRAMA
                             END-IF
                          END-IF
                          MOVE WS-PLAZ-SUBV TO WS-PLAZ-GRACIA
                          SET  SW-GRACIA-SI TO TRUE
                          SET  SW-NO-INTREM TO TRUE
                       END-IF
                       IF NSCF-VLRVEHI-ALF = SPACES OR
                          NSCF-VLRVEHI-ALF = LOW-VALUES
                          MOVE 'UGEW001'        TO CAA-COD-ERROR
                          MOVE 'VALOR VEHICULO' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
      *                   COMPUTE WS-VLRVEHI =
      *                           FUNCTION NUMVAL(NSCF-VLRVEHI)
                          MOVE NSCF-VLRVEHI    TO WS-VLRVEHI
                          IF WS-VLRVEHI < WS-CI-VLRF
                             MOVE 'UGE7606' TO CAA-COD-ERROR
                             MOVE SPACES TO CAA-VAR1-ERROR
                             MOVE SPACES TO CAA-VAR2-ERROR
                             PERFORM 3-FIN-PROGRAMA
                          END-IF
                       END-IF
                       IF NSCF-TASCONC = SPACES OR
                          NSCF-TASCONC = LOW-VALUES
                          MOVE 'UGEW001'            TO CAA-COD-ERROR
                          MOVE 'TASA CONCESIONARIO' TO CAA-VAR1-ERROR
                          PERFORM 3-FIN-PROGRAMA
                       ELSE
                          COMPUTE WS-TASCONC =
                                  FUNCTION NUMVAL(NSCF-TASCONC)
                       END-IF
                    WHEN OTHER
                       MOVE 'UGE0710'      TO CAA-COD-ERROR
                       MOVE 'GRACIA SUBVENC' TO CAA-VAR1-ERROR
                       MOVE '<1>'    TO CAA-VAR2-ERROR
                       PERFORM 3-FIN-PROGRAMA
                 END-EVALUATE
                 IF SW-ESPECIAL-SI
                    PERFORM 22-VALIDA-PLAN-ACIC-CALCULO
                 ELSE
                    PERFORM 2811-VALIDA-PERIODICIDADES
                 END-IF.
      *
      ******************************************************************
      * 22-VALIDA-PLAN-ACIC-CALCULO                                    *
      *                                                                *
      ******************************************************************
       22-VALIDA-PLAN-ACIC-CALCULO.
           MOVE NSCF-CUOTA-FECHA-AAAA(1) TO FECHA-AAAAMMDD(1:4)
           MOVE NSCF-CUOTA-FECHA-MM(1)   TO FECHA-AAAAMMDD(5:2)
           MOVE CAA-FECHA-OPER-9(7:2)    TO FECHA-AAAAMMDD(7:2)
           COMPUTE FECHA-ENTERO =
                   FUNCTION INTEGER-OF-DATE(FECHA-AAAAMMDD) -
                   FUNCTION INTEGER-OF-DATE(CAA-FECHA-OPER-9)
           DIVIDE FECHA-ENTERO BY 30 GIVING PERIODIC-NM

           IF CAA-FECHA-OPER-9(5:2) = '02'
              DIVIDE FECHA-ENTERO BY 28 GIVING PERIODIC-NM
           END-IF

           IF PERIODIC-NM(4:2) >= '01'
              CONTINUE
           ELSE
              MOVE 'UGE0939' TO CAA-COD-ERROR
      *@COL01-I
      *       MOVE 'FECHA CUOTA 1 DEBE ' TO CAA-VAR1-ERROR
      *       MOVE 'SER UN MES ADELANTE' TO CAA-VAR2-ERROR
              MOVE 'FECHA NO PUEDE SER ' TO CAA-VAR1-ERROR
              MOVE 'ANTERIOR'            TO CAA-VAR2-ERROR
      *@COL01-F
              PERFORM 3-FIN-PROGRAMA
           END-IF

           INITIALIZE WS-FECHA-ORI
           INITIALIZE WS-IMPORTE-TOTAL WS-PORCENTAJE-TOTAL
           MOVE CAA-FECHA-OPER2 TO WS-FECHA-ORI
           MOVE WS-PLAZ-SUBV    TO WS-NUMERO-MESES
           PERFORM 10-DESPLAZA-FECHA
           MOVE WS-FECHA-DES TO WS-FECHA-FIN-SUBV
           INITIALIZE WS-CUOT-ANT WS-NUMERO-CUOTAS-ACIC
           MOVE WS-CI-N TO WS-NUMERO-MESES
           PERFORM 10-DESPLAZA-FECHA
           MOVE WS-FECHA-DES-AAAA TO WS-FECHA-FINAL-AAAA
           MOVE WS-FECHA-DES-MM   TO WS-FECHA-FINAL-MM
           MOVE WS-FECHA-DES-DD   TO WS-FECHA-FINAL-DD
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL
              NSCF-CUOTA-FECHA(WS-I) = SPACES OR
              NSCF-CUOTA-FECHA(WS-I) = LOW-VALUES
              PERFORM 222-MUEVE-REG-ACTUAL
      *       DISPLAY 'U144 JCAM CUOTA:' NSCF-CUOTA(WS-I)
              IF WS-CUOT-ACT-IMPORTE <= 0.0
                 MOVE 'UGE2652' TO CAA-COD-ERROR
                 STRING 'IMPORTE CUOTA ' WS-I DELIMITED BY
                 SIZE INTO CAA-VAR1-ERROR
                 MOVE 'DEBE SER > 0' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-CUOT-ACT-FECHA <= WS-CUOT-ANT-FECHA
                 MOVE 'UGE7555' TO CAA-COD-ERROR
                 MOVE SPACES    TO CAA-VAR1-ERROR
                 MOVE SPACES    TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-CUOT-ACT-FECHA <= WS-FECHA-FIN-SUBV AND
                 NSCF-GRCSUBV = '1'
                 MOVE 'UGE2652' TO CAA-COD-ERROR
                 STRING 'FCH CUOTA ' WS-I DELIMITED BY
                 SIZE INTO CAA-VAR1-ERROR
                 MOVE 'ESTA EN PRD. GRACIA' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-CUOT-ACT-FECHA < WS-FECHA-OPER
                 MOVE 'UGE2652' TO CAA-COD-ERROR
                 STRING 'FCH CUOTA: ' WS-I ' ES < ' DELIMITED BY
                 SIZE INTO CAA-VAR1-ERROR
                 MOVE 'A FCH DIA' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-CUOT-ACT-FECHA-MM < '01' OR
                 WS-CUOT-ACT-FECHA-MM > '12'
                 MOVE 'UGE1774' TO CAA-COD-ERROR
                 STRING 'FECHA MM CUOTA: ' WS-I DELIMITED BY
                 SIZE INTO CAA-VAR1-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-CUOT-ACT-FECHA-AAAA < '0001' OR
                 WS-CUOT-ACT-FECHA-AAAA > '9999'
                 MOVE 'UGE1774' TO CAA-COD-ERROR
                 STRING 'FECHA AAAA CUOTA: ' WS-I DELIMITED BY
                 SIZE INTO CAA-VAR1-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-CUOT-ACT-FECHA <= WS-FECHA-FINAL
                 ADD WS-CUOT-ACT-IMPORTE TO WS-IMPORTE-TOTAL
                 ADD WS-CUOT-ACT-PORC TO WS-PORCENTAJE-TOTAL
              ELSE
                 MOVE 'UGE2652'                  TO CAA-COD-ERROR
                 STRING 'FCH DE LA CUOTA ' WS-I DELIMITED BY
                    SIZE INTO CAA-VAR1-ERROR
                 MOVE 'EXCEDE FCH FIN CRED' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA

              END-IF
      *        DISPLAY 'WS-IMPORTE-TOTAL ' WS-IMPORTE-TOTAL
      *        DISPLAY 'WS-CI-VLRF ' WS-CI-VLRF
      * VERIFICAR SI ES CONTRA EL VALOR DEL CREDITO O CONTRA EL VAL. VE
              IF WS-IMPORTE-TOTAL > WS-CI-VLRF
                 MOVE 'UGE2652'                  TO CAA-COD-ERROR
                 MOVE 'VLR TOTAL CUOTAS ES ' TO CAA-VAR1-ERROR
                 MOVE 'MAYOR VLR TOT CREDIT' TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF

              IF WS-PORCENTAJE-TOTAL > 100
                 MOVE 'UGE2652'           TO CAA-COD-ERROR
                 MOVE '% TOTAL DE CUOTAS' TO CAA-VAR1-ERROR
                 MOVE 'ES MAYOR A 100%'   TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
              MOVE WS-CUOT-ACT TO WS-CUOT-ANT
              ADD 1 TO WS-NUMERO-CUOTAS-ACIC
           END-PERFORM
      *@COL04-I
           SET NO-VALIDAR               TO TRUE
           IF WS-IMPORTE-TOTAL EQUAL WS-CI-VLRF
              CONTINUE
           ELSE
              SET SI-VALIDAR            TO TRUE
           END-IF
      *@COL04-F

           IF WS-PORCENTAJE-TOTAL < 100
      *@COL04-I
              AND SI-VALIDAR
      *@COL04-F
              MOVE 'UGE2652'            TO CAA-COD-ERROR
              MOVE '% TOTAL DE CUOTAS'  TO CAA-VAR1-ERROR
      *@COL04-I
              MOVE 'ES INFERIOR A 100%-' TO CAA-VAR2-ERROR
      *       MOVE 'ES INFERIOR A 100%' TO CAA-VAR2-ERROR
      *@COL04-F
              PERFORM 3-FIN-PROGRAMA
           END-IF.
      *
      ******************************************************************
      * 2811-VALIDA-PERIODICIDADES                                     *
      *                                                                *
      ******************************************************************
       2811-VALIDA-PERIODICIDADES.
           MOVE WS-PERC TO WS-PERC-N
           DIVIDE WS-CI-N BY WS-PERC-N GIVING WS-COC1 REMAINDER
                  WS-RES1
      *STF01-I
      *    IF SW-CONSUMO-VEHI-SI
           IF SW-CONSUMO-VEHI-SI OR SW-CONSUMO-FLEX-SI
      *STF01-F
              DIVIDE WS-PLAZ-SUBV BY WS-PERC-N GIVING WS-COC2 REMAINDER
                     WS-RES2
              IF WS-RES1 = 0 AND WS-RES2 = 0
                 CONTINUE
              ELSE
                 MOVE 'UGE7600' TO CAA-COD-ERROR
                 MOVE SPACES TO CAA-VAR1-ERROR
                 MOVE SPACES TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
           ELSE
              IF WS-RES1 = 0
                 CONTINUE
              ELSE
                 MOVE 'UGE7600' TO CAA-COD-ERROR
                 MOVE SPACES TO CAA-VAR1-ERROR
                 MOVE SPACES TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
           END-IF.
      *COL01-F
      *
      ******************************************************************
      * 218-VALIDAR-PLAZO                                              *
      * SE VALIDA QUE EL PLAZO ESTE DENTRO DEL RANGO MINIMO Y MAXIMO   *
      * DEFINIDO PARA EL PRODUCTO.                                     *
      ******************************************************************
       218-VALIDAR-PLAZO.
      *
           PERFORM  2181-TRAER-PLAZOS-MAX-MIN
           PERFORM  2182-TRANSFORMA-PLAZOS
      *
           IF WS-PLAZO-MIN > WS-PLAZO-MM  OR
              WS-PLAZO-MAX < WS-PLAZO-MM
              MOVE CTE-CON-UGE0124            TO CAA-COD-ERROR
              MOVE PRO-PLAZOMIN               TO CAA-VAR1-ERROR
              MOVE PRO-PLAZOMAX               TO CAA-VAR2-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF.
      *
      ******************************************************************
      * 2181-TRAER-PLAZOS-MAX-MIN.                                     *
      * CONSULTA EL PLAZO MINIMO Y EL PLAZO MAXIMO PERMITIDOS PAEA EL  *
      * SUBPRODUCTO INFORMADO.                                         *
      ******************************************************************
       2181-TRAER-PLAZOS-MAX-MIN.
      *
           MOVE WS-PRODUCTO                   TO PRO-PRODUCTO
           MOVE NSCF-SUBPROD                  TO PRO-SUBPRO
      *
           EXEC SQL
              SELECT  PLAZOMAX,
                      PLAZOMIN
                INTO :PRO-PLAZOMAX,
                     :PRO-PLAZOMIN
                 FROM UGDTPRO
                WHERE SUBPRO   = :PRO-SUBPRO       AND
                      PRODUCTO = :PRO-PRODUCTO
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              CONTINUE
           ELSE
              IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                 MOVE CTE-UGE0204         TO CAA-COD-ERROR
                 PERFORM 3-FIN-PROGRAMA
              ELSE
                 MOVE CTE-UGE0939         TO CAA-COD-ERROR
                 MOVE CTE-ERR-SEL-UGD     TO CAA-VAR1-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
           END-IF.
      *
      ******************************************************************
      * 2182-TRANSFORMA-PLAZOS                                         *
      * CONVERIMOS A MESES EL PLAZO MINIMO Y MAXIMO DEL PRODUCTO Y EL  *
      * PLAZO INFORMADO.                                  *            *
      ******************************************************************
       2182-TRANSFORMA-PLAZOS.

      * EXPRESAMOS EL PLAZO MAXIMO EN MESES
           IF PRO-PLAZOMAX(1:1) EQUAL '1'
              MOVE PRO-PLAZOMAX(2:3)           TO WS-PLAZO-MAX
              COMPUTE WS-PLAZO-MAX =  WS-PLAZO-MAX / 30
           ELSE
              IF PRO-PLAZOMAX(1:1) EQUAL '2'
                 MOVE PRO-PLAZOMAX(2:3)        TO WS-PLAZO-MAX
              ELSE
                 IF PRO-PLAZOMAX(1:1) EQUAL '3'
                    MOVE PRO-PLAZOMAX(2:3)     TO WS-PLAZO-MAX
                    COMPUTE WS-PLAZO-MAX =  WS-PLAZO-MAX * 12
                 ELSE
                    MOVE 'UGE0939'             TO CAA-COD-ERROR
                    MOVE 'ERR EN PLAZO: '      TO CAA-VAR1-ERROR(1:14)
                    MOVE PRO-PLAZOMAX          TO CAA-VAR1-ERROR(15:4)
                    MOVE 'PERIODICID INVALID ' TO CAA-VAR2-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 END-IF
              END-IF
           END-IF

      * EXPRESAMOS EL PLAZO MINIMO EN MESES
           IF PRO-PLAZOMIN(1:1) EQUAL '1'
              MOVE PRO-PLAZOMIN(2:3)           TO WS-PLAZO-MIN
              COMPUTE WS-PLAZO-MIN =  WS-PLAZO-MIN / 30
           ELSE
              IF PRO-PLAZOMIN(1:1) EQUAL '2'
                 MOVE PRO-PLAZOMIN(2:3)        TO WS-PLAZO-MIN
              ELSE
                 IF PRO-PLAZOMIN(1:1) EQUAL '3'
                    MOVE PRO-PLAZOMIN(2:3)     TO WS-PLAZO-MIN
                    COMPUTE WS-PLAZO-MIN =  WS-PLAZO-MIN * 12
                 ELSE
                    MOVE 'UGE0939'             TO CAA-COD-ERROR
                    MOVE 'ERR EN PLAZO: '      TO CAA-VAR1-ERROR(1:14)
                    MOVE PRO-PLAZOMIN          TO CAA-VAR1-ERROR(15:4)
                    MOVE 'PERIODICID INVALID ' TO CAA-VAR2-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 END-IF
              END-IF
           END-IF

      * EXPRESAMOS EL PLAZO INFORMADO EN MESES
           IF NSCF-PLAZO(1:1) EQUAL '1'
              MOVE NSCF-PLAZO(2:3)             TO WS-PLAZO-MM
              COMPUTE WS-PLAZO-MM =  WS-PLAZO-MM / 30
           ELSE
              IF NSCF-PLAZO(1:1) EQUAL '2'
                 MOVE NSCF-PLAZO(2:3)          TO WS-PLAZO-MM
              ELSE
                 IF NSCF-PLAZO(1:1) EQUAL '3'
                    MOVE NSCF-PLAZO(2:3)       TO WS-PLAZO-MM
                    COMPUTE WS-PLAZO-MM =  WS-PLAZO-MM * 12
                 ELSE
                    MOVE 'UGE0939'             TO CAA-COD-ERROR
                    MOVE 'ERR EN PLAZO: '      TO CAA-VAR1-ERROR(1:14)
                    MOVE NSCF-PLAZO            TO CAA-VAR1-ERROR(15:4)
                    MOVE 'PERIODICID INVALID ' TO CAA-VAR2-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 END-IF
              END-IF
           END-IF.
      *
      ******************************************************************
      * 2021-VALIDA-NIT-CONCESIONARIO                                  *
      * SE REALIZA VALIDACION DE CONCESIONARIO.                        *
      ******************************************************************
       2021-VALIDA-NIT-CONCESIONARIO.
           INITIALIZE DATOS-BASICOS
           MOVE CTE-2                      TO DATOS-OPCION
           MOVE CTE-3                      TO DATOS-CODIDENT
           MOVE NSCF-IDCONC(1:15)          TO DATOS-CLAIDENT
      *
           CALL CTE-PE9C1000 USING DATOS-BASICOS
      *
           EVALUATE DATOS-COD-RETORNO
              WHEN CTE-00
                 CONTINUE
              WHEN CTE-10
              WHEN CTE-40
                 MOVE CTE-UGE0550          TO CAA-COD-ERROR
                 MOVE CTE-ID-CON           TO CAA-VAR1-ERROR
                 MOVE CTE-DE-PER           TO CAA-VAR1-ERROR
                 PERFORM 3-FIN-PROGRAMA
              WHEN OTHER
                 MOVE CTE-UGE0517          TO CAA-COD-ERROR
                 MOVE CTE-TC9-COD          TO CAA-VAR1-ERROR
                 MOVE DATOS-COD-RETORNO    TO CAA-VAR2-ERROR
                 PERFORM 9-ABEND-DB2
           END-EVALUATE.
      *
      ******************************************************************
      * 2022-VALIDA-ADS                                                *
      * SE REALIZA CONSULTA SELECT A LA TABLA UGDTADS.                 *
      ******************************************************************
       2022-VALIDA-ADS.
           MOVE WS-PRODUCTO                TO ADS-PRODUCTO
           MOVE NSCF-SUBPROD               TO ADS-SUBPRO
           MOVE WS-FECSOLI                 TO ADS-FECOVALI
      *
           EXEC SQL
                SELECT CODTIAMO
                      ,PERCAP
                      ,PERINT
                      ,CODTIAMO
                      ,TIPODIAS
                      ,INDINVAR
                      ,CODTIPRE
                      ,ISUMCOM
                      ,INDINANT
                  INTO :ADS-CODTIAMO
                      ,:ADS-PERCAP
                      ,:ADS-PERINT
                      ,:ADS-CODTIAMO
                      ,:ADS-TIPODIAS
                      ,:ADS-INDINVAR
                      ,:ADS-CODTIPRE
                      ,:ADS-ISUMCON
                      ,:ADS-INDINANT
                  FROM UGDTADS
                 WHERE PRODUCTO  = :ADS-PRODUCTO
                   AND SUBPRO    = :ADS-SUBPRO
                   AND FECOVALI <= :ADS-FECOVALI
                   AND FEFIVALI >= :ADS-FECOVALI
           END-EXEC
      *
           MOVE SQLCODE TO DB2-RETURN-CDE
      *
           IF DB2-OK
              IF NSCF-PERC EQUAL CTE-20ES AND ADS-CODTIAMO EQUAL CTE-A
                 CONTINUE
              ELSE
                 IF ADS-CODTIAMO EQUAL CTE-C OR ADS-CODTIAMO IS NUMERIC
                    CONTINUE
                 ELSE
                    MOVE CTE-UGE7554       TO CAA-COD-ERROR
                    MOVE SPACES            TO CAA-VAR1-ERROR
                    MOVE SPACES            TO CAA-VAR1-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 END-IF
              END-IF
           ELSE
              IF DB2-NOTFND
                 MOVE CTE-UGE0146             TO CAA-COD-ERROR
                 MOVE SPACES                  TO CAA-VAR1-ERROR
                 MOVE SPACES                  TO CAA-VAR1-ERROR
                 PERFORM 3-FIN-PROGRAMA
              ELSE
                 MOVE SQLCODE                 TO ABC-SQLCODE
                 MOVE CTE-UGDTLQS             TO ABC-OBJETO-ERROR
                 MOVE CTE-SELECT              TO ABC-REFERENCIA
                 PERFORM 9-ABEND-DB2
              END-IF
           END-IF.
      *
      ******************************************************************
      * 22-VALIDA-PLAN-ACICLICOS                                       *
      * SE REALIZA LA VALIDACION DE PLAN ACICLICOS.                    *
      ******************************************************************
       22-VALIDA-PLAN-ACICLICOS.
           INITIALIZE WS-CUOT-ANT WS-NUMERO-CUOTAS-ACIC
                      WS-PORCENTAJE-TOTAL
      *@COL04-I
                      WS-IMP-TOTAL
      *@COL04-F
      *
           PERFORM 22111-OBTENER-PLAZO
           PERFORM 221-CALCULA-FECHA-FIN
      *
           MOVE NSCF-VLRCRED            TO WS-SALDO-NUEVO
           MOVE 1                       TO WS-CONTA4
           MOVE WS-FECSOLI              TO WS-FEULIQIN
           MOVE ZEROS                   TO WS-TOTALREG-FLEX

           MOVE WS-FECSOLI(1:4)         TO WS-CUOT-ANT-FECHA-AAAA
           MOVE WS-FECSOLI(6:2)         TO WS-CUOT-ANT-FECHA-MM
           MOVE WS-FECSOLI(9:2)         TO WS-CUOT-ANT-FECHA-DD
           MOVE ZEROS                   TO WS-CUOT-ANT-PORC
           MOVE ZEROS                   TO WS-CUOT-ANT-IMPORTE

           IF NSCF-PERS EQUAL CTE-20TO
              SET SI-PROCESAR-SEG-ANTI  TO TRUE
           END-IF

           PERFORM VARYING WS-I FROM CTN-1 BY CTN-1 UNTIL
              NSCF-CUOTA-FECHA(WS-I) EQUAL SPACES OR
              NSCF-CUOTA-FECHA(WS-I) EQUAL LOW-VALUES

              PERFORM 222-MUEVE-REG-ACTUAL
      *
              IF WS-CUOT-ACT-IMPORTE LESS OR EQUAL ZERO
                 MOVE CTE-UGE2652          TO CAA-COD-ERROR
                 STRING CTE-IMP-CUO
                        WS-I DELIMITED BY SIZE
                        INTO CAA-VAR1-ERROR
                 END-STRING
                 MOVE CTE-DEB-SER          TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
      *
              IF WS-CUOT-ACT-FECHA LESS OR EQUAL WS-CUOT-ANT-FECHA
                 MOVE CTE-UGE0939          TO CAA-COD-ERROR
                 MOVE SPACES               TO CAA-VAR1-ERROR
                 MOVE CTE-FECHA-CUOTA      TO CAA-VAR1-ERROR(1:12)
                 MOVE WS-I                 TO CAA-VAR1-ERROR(13:2)
                 MOVE CTE-DEBE             TO CAA-VAR1-ERROR(15:5)
                 MOVE CTE-UN-MES-ADE       TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
      *
              IF WS-CUOT-ACT-FECHA-MM LESS    CTE-01 OR
                 WS-CUOT-ACT-FECHA-MM GREATER CTE-12
                 MOVE CTE-UGE1774          TO CAA-COD-ERROR
                 STRING CTE-FEC-MM-CUO
                        WS-I
                        DELIMITED BY SIZE INTO CAA-VAR1-ERROR
                 END-STRING
                 PERFORM 3-FIN-PROGRAMA
              END-IF
      *
              IF WS-CUOT-ACT-FECHA-AAAA LESS    CTE-0001 OR
                 WS-CUOT-ACT-FECHA-AAAA GREATER CTE-9999
                 MOVE CTE-UGE1774          TO CAA-COD-ERROR
                 STRING CTE-FEC-AAA-CUO
                        WS-I
                        DELIMITED BY SIZE INTO CAA-VAR1-ERROR
                 END-STRING
                 PERFORM 3-FIN-PROGRAMA
              END-IF
      *
              IF WS-CUOT-ACT-FECHA LESS OR EQUAL WS-FECHA-FINAL
                 ADD WS-CUOT-ACT-IMPORTE   TO WS-IMPORTE-TOTAL
      *@COL04-I
                                              WS-IMP-TOTAL
      *@COL04-F
                 ADD WS-CUOT-ACT-PORC      TO WS-PORCENTAJE-TOTAL

                 PERFORM 2121-PROCESAR-CUOTA
              ELSE
                 MOVE CTE-UGE2652          TO CAA-COD-ERROR
                 STRING CTE-FCH-DELA-CUO
                        WS-I
                        DELIMITED BY SIZE INTO CAA-VAR1-ERROR
                 END-STRING
                 MOVE CTE-EXC-FCH-FIN      TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              END-IF
      *
           END-PERFORM
      *
      *@COL04-I
           SET NO-VALIDAR               TO TRUE
           IF WS-IMP-TOTAL EQUAL WS-CI-VLRF
              CONTINUE
           ELSE
              SET SI-VALIDAR            TO TRUE
           END-IF
      *@COL04-F
           IF WS-PORCENTAJE-TOTAL GREATER CTN-100
              MOVE CTE-UGE2652             TO CAA-COD-ERROR
              MOVE CTE-TOT-CUO             TO CAA-VAR1-ERROR
              MOVE CTE-ES-INF-100          TO CAA-VAR2-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF
      *
           IF WS-PORCENTAJE-TOTAL < CTN-100
      *@COL04-I
              AND SI-VALIDAR
      *@COL04-F
              MOVE 'UGE2652'               TO CAA-COD-ERROR
              MOVE '% TOTAL DE CUOTAS'     TO CAA-VAR1-ERROR
              MOVE 'ES INFERIOR A 100%'    TO CAA-VAR2-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF
      *
           COMPUTE WS-TOTALREG-FLEX = WS-CONTA4 - 1

           IF SI-PROCESAR-SEG-ANTI
              COMPUTE WS-CUOTA-TOTAL(1) = WS-CUOTA-TOTAL(1) -
                                          WS-CUOTA-SEGURO(1)

              MOVE WS-CUOTA-SEGURO(1)     TO WS-PRIMSEGU

              MOVE WS-FECHA-CUOTA(WS-TOTALREG-FLEX)  TO WS-FECHA-AUX

              PERFORM 22113-DIF-FEFORMA-ULTCUO

              COMPUTE WS-PRIMSEGU = WS-PRIMSEGU * WS-DIF-MESES

              MOVE WS-PRIMSEGU            TO WS-CUOTA-SEGURO(1)
              ADD  WS-PRIMSEGU            TO WS-CUOTA-TOTAL(1)
           END-IF.
      *
      ******************************************************************
      * 221-CALCULA-FECHA-FIN                                          *
      * SE REALZA CALCULO DE LA FECHA FINAL.                           *
      ******************************************************************
       221-CALCULA-FECHA-FIN.
           INITIALIZE WS-FECHA-FINAL
      *               W175-ENTRADA
      *               W175-SALIDA
      *
      *    MOVE CTE-2                      TO W175-CDOPCIO
      *    MOVE WS-FECSOLI(1:4)            TO W175-FHGRE1(5:4)
      *    MOVE WS-FECSOLI(6:2)            TO W175-FHGRE1(3:2)
      *    MOVE WS-FECSOLI(9:2)            TO W175-FHGRE1(1:2)
      *    MOVE CTE-CO                     TO W175-TPTRAT
      *
      *    MOVE WS-PLAZO-MESES             TO W175-FACTOR
      *    MULTIPLY CTN-30 BY W175-FACTOR
      *
      *    CALL CTE-TC8C1220 USING TCWC1750
      *
      *    EVALUATE W175-CDRETORN
      *       WHEN CTE-00
      *          MOVE W175-FHGREG(1:2)     TO WS-FECHA-FINAL-DD
      *                                       WS-FEFIN-AAAA-MM-DD(9:2)
      *          MOVE W175-FHGREG(3:2)     TO WS-FECHA-FINAL-MM
      *                                       WS-FEFIN-AAAA-MM-DD(6:2)
      *          MOVE W175-FHGREG(5:4)     TO WS-FECHA-FINAL-AAAA
      *                                       WS-FEFIN-AAAA-MM-DD(1:4)
      *
      *          MOVE '-'                  TO WS-FEFIN-AAAA-MM-DD(5:1)
      *                                       WS-FEFIN-AAAA-MM-DD(8:1)
      *       WHEN OTHER
      *          MOVE CTE-UGE0517          TO CAA-COD-ERROR
      *          MOVE CTE-TC8-COD          TO CAA-VAR1-ERROR
      *          MOVE W175-CDRETORN        TO CAA-VAR2-ERROR
      *          PERFORM 3-FIN-PROGRAMA
      *    END-EVALUATE.
      *
           INITIALIZE                         URECDF3
           MOVE WS-PLAZO                      TO DF3-PERCAP
           MOVE WS-FECSOLI                    TO DF3-FECHA-INICIAL
           MOVE WS-FECSOLI(9:2)               TO DF3-DIA
           MOVE 1                             TO DF3-NUM-PERIODOS
           MOVE '1'                           TO DF3-TIPODIAS

           CALL  BBVA-UR8CDFP0  USING  URECRES
                                       URECDF3

           IF RES-CORESPUE NOT = '10'
              MOVE 'UGE0939'                  TO CAA-COD-ERROR
              MOVE 'ERR UR8CDFP0 CAP'         TO CAA-VAR1-ERROR
              MOVE RES-CORESPUE               TO CAA-VAR2-ERROR
              PERFORM  3-FIN-PROGRAMA
           ELSE
              MOVE  DF3-FECHA-FINAL           TO WS-FEFIN-AAAA-MM-DD
              MOVE  DF3-FECHA-FINAL(9:2)      TO WS-FECHA-FINAL-DD
              MOVE  DF3-FECHA-FINAL(6:2)      TO WS-FECHA-FINAL-MM
              MOVE  DF3-FECHA-FINAL(1:4)      TO WS-FECHA-FINAL-AAAA.

      *
      ******************************************************************
      * 222-MUEVE-REG-ACTUAL                                           *
      * SE REALIZA MOVIMIENTO DEL REGISTRO ACTUAL.                     *
      ******************************************************************
       222-MUEVE-REG-ACTUAL.
           MOVE NSCF-CUOTA-FECHA-AAAA(WS-I)
                                           TO WS-CUOT-ACT-FECHA-AAAA
           MOVE NSCF-CUOTA-FECHA-MM(WS-I)  TO WS-CUOT-ACT-FECHA-MM
      *
           COMPUTE WS-CUOT-ACT-PORC =
                                  FUNCTION NUMVAL(NSCF-CUOTA-PORC(WS-I))
           COMPUTE WS-CUOT-ACT-IMPORTE =
                               FUNCTION NUMVAL(NSCF-CUOTA-IMPORTE(WS-I))

      *@COL02-I
           MOVE WS-CUOT-ACT-FECHA-AAAA     TO WS-AAAA
           MOVE WS-CUOT-ACT-FECHA-MM       TO WS-MM

           IF SI-DIA-31 OR
              SI-DIA-30 OR
              SI-DIA-29

              PERFORM 2221-VALIDA-DIA-MES
           ELSE
              MOVE WS-FECSOLI(9:2)       TO WS-CUOT-ACT-FECHA-DD
           END-IF.
      *@COL02-F
      *
      *@COL02-I
      ******************************************************************
      *                        2221-VALIDA-DIA-MES.                    *
      *   VALIDA EL DIA DE LA CUOTA EN CASOS DE QUE EL DIA DE LA FECHA *
      *   DE SOLICITUD SEA 29, 30 O 31.
      ******************************************************************
       2221-VALIDA-DIA-MES.

           IF WS-MM EQUAL 2

              PERFORM 22211-VERIFICA-BISIESTO

              IF SI-BISIESTO
                 MOVE '29'                  TO WS-CUOT-ACT-FECHA-DD
              ELSE
                 MOVE '28'                  TO WS-CUOT-ACT-FECHA-DD
              END-IF

              SET NO-BISIESTO               TO TRUE
           ELSE
              IF SI-DIA-31
                 IF WS-MM EQUAL 1 OR
                    WS-MM EQUAL 3 OR
                    WS-MM EQUAL 5 OR
                    WS-MM EQUAL 7 OR
                    WS-MM EQUAL 8 OR
                    WS-MM EQUAL 10 OR
                    WS-MM EQUAL 12

                    MOVE WS-FECSOLI(9:2)    TO WS-CUOT-ACT-FECHA-DD
                 ELSE
                    MOVE '30'               TO WS-CUOT-ACT-FECHA-DD
              ELSE
                 MOVE WS-FECSOLI(9:2)       TO WS-CUOT-ACT-FECHA-DD
              END-IF

           END-IF.
      ******************************************************************
      *                     22211-VERIFICA-BISIESTO                    *
      *  SI LA CUOTA ES EN FEBRERO VERIFICA SI EL A#O ES BISIESTO PARA *
      *  EL DIA DEL COBRO DE LA CUOTA.                                 *
      ******************************************************************
       22211-VERIFICA-BISIESTO.

           DIVIDE WS-AAAA BY 4 GIVING WS-RESULTADO1
                  REMAINDER WS-RESTO1
           DIVIDE WS-AAAA BY 100 GIVING WS-RESULTADO2
                  REMAINDER WS-RESTO2
           DIVIDE WS-AAAA BY 400 GIVING WS-RESULTADO3
                  REMAINDER WS-RESTO3

           IF((WS-RESTO1 EQUAL ZERO AND WS-RESTO2 NOT EQUAL ZERO) OR
             (WS-RESTO3 EQUAL ZERO))

             SET SI-BISIESTO                TO TRUE
           ELSE
             SET NO-BISIESTO                TO TRUE
           END-IF.

      *@COL02-F
      *
      ******************************************************************
      *                        2121-PROCESAR-CUOTA.                    *
      *     SE PROCESA CADA CUOTA DEL CREDITO DE CONSUMO FLEXIBLE      *
      *     ACICLICO                                                   *
      ******************************************************************
       2121-PROCESAR-CUOTA.

           MOVE WS-SALDO-NUEVO          TO WS-SALDO-ANTERIOR

           MOVE WS-CUOT-ACT-FECHA-AAAA  TO   WS-FECHA-AAAA
           MOVE WS-CUOT-ACT-FECHA-MM    TO   WS-FECHA-MM
           MOVE WS-CUOT-ACT-FECHA-DD    TO   WS-FECHA-DD

           MOVE WS-FEC-AAAA-MM-DD       TO WS-FECHA-CUOTA(WS-CONTA4)
                                           WS-FEPROLIQIN

           MOVE WS-CUOT-ACT-IMPORTE     TO WS-CUOTA-AMORT(WS-CONTA4)

           ADD  WS-CUOT-ACT-IMPORTE     TO WS-CUOTA-TOTAL(WS-CONTA4)


           MOVE WS-FEPROLIQIN(1:4)       TO W075-FHGRE2(5:4)
           MOVE WS-FEPROLIQIN(6:2)       TO W075-FHGRE2(3:2)
           MOVE WS-FEPROLIQIN(9:2)       TO W075-FHGRE2(1:2)
           MOVE WS-FEULIQIN(1:4)         TO W075-FHGRE1(5:4)
           MOVE WS-FEULIQIN(6:2)         TO W075-FHGRE1(3:2)
           MOVE WS-FEULIQIN(9:2)         TO W075-FHGRE1(1:2)

           PERFORM 227A-CALCULA-DIAS

           MOVE W075-NUMDIAS             TO WS-DIAS-INT

           PERFORM 227B-CALCULAR-INTERESES

           MOVE WS-FEPROLIQIN            TO WS-FEULIQIN
           MOVE WS-IMP-INT               TO WS-CUOTA-INTERES(WS-CONTA4)

           ADD  WS-IMP-INT               TO WS-CUOTA-TOTAL(WS-CONTA4)

           IF SI-PROCESAR-SEG-ANTI
              IF WS-CONTA4 = 1
                  MOVE WS-FEFIN-AAAA-MM-DD  TO W101-ICFINIRE
                  PERFORM 227C-CALCULAR-SEGUROS
               ELSE
                  MOVE ZEROS             TO WS-PRIMSEGU
               END-IF
           ELSE
               MOVE WS-FECHA-CUOTA(WS-CONTA4) TO W101-ICFINIRE

               PERFORM 227C-CALCULAR-SEGUROS

               COMPUTE WS-MESES = WS-DIAS-INT / 30
               COMPUTE WS-PRIMSEGU = WS-PRIMSEGU * WS-MESES
           END-IF

           MOVE WS-PRIMSEGU     TO WS-CUOTA-SEGURO(WS-CONTA4)
           ADD WS-PRIMSEGU      TO WS-CUOTA-TOTAL(WS-CONTA4)

           COMPUTE WS-SALDO-NUEVO = WS-SALDO-NUEVO -
                                              WS-CUOTA-AMORT(WS-CONTA4)

           MOVE WS-SALDO-NUEVO      TO WS-SALDOPEN(WS-CONTA4)

           ADD 1                    TO WS-CONTA4.
      *
      ******************************************************************
      *                       22113-DIF-FEFORMA-ULTCUO                 *
      *   SE OBTIENE LA DIFERENCIA EN MESES ENTRE LA FECHA DE SOLICITUD*
      *   Y LA FECHA DE LA ULTIMA CUOTA.                               *
      ******************************************************************
       22113-DIF-FEFORMA-ULTCUO.

            MOVE WS-FECSOLI                          TO WS-FEC-1
            MOVE WS-FECHA-AUX                        TO WS-FEC-2

            IF WS-FEC2-AAAA EQUAL WS-FEC1-AAAA
               IF WS-FEC2-MM <= WS-FEC1-MM
                  MOVE ZERO          TO WS-MESES
               ELSE
                  COMPUTE WS-MESES = WS-FEC2-MM - WS-FEC1-MM
      *@COL03-I
      *           IF WS-FEC2-DD < WS-FEC1-DD
      *              COMPUTE WS-MESES = WS-MESES - 1
      *           END-IF
      *@COL03-F
               END-IF
            ELSE
               COMPUTE WS-ANIO = WS-FEC2-AAAA - WS-FEC1-AAAA
               COMPUTE WS-MESES = WS-ANIO * 12
               IF WS-FEC2-MM < WS-FEC1-MM
                  COMPUTE WS-MESES2 = WS-FEC1-MM - WS-FEC2-MM
                  COMPUTE WS-MESES = WS-MESES - WS-MESES2
               ELSE
                  COMPUTE WS-MESES2 = WS-FEC2-MM - WS-FEC1-MM
                  COMPUTE WS-MESES = WS-MESES - WS-MESES2
               END-IF
      *@COL03-I
      *        IF WS-FEC2-DD <  WS-FEC1-DD
      *           COMPUTE WS-MESES = WS-MESES - 1
      *        END-IF
      *@COL03-F
            END-IF

            MOVE WS-MESES              TO  WS-DIF-MESES.
      *
      ******************************************************************
      * 223-IMPRIMIR.                                                  *
      * SE REALIZA LLAMADO A LOS PARRAFOS PARA REALIZAR DIFERENTES     *
      * ESCRITURAS.                                                    *
      ******************************************************************
       223-IMPRIMIR.
           PERFORM 224-IMPRIMIR-CABECERA
      *    PERFORM 225-FORMATEAR-CUERPO
           PERFORM 2251-IMPRIMIR-RESUMEN
           PERFORM 226-ENCABEZADOS-LTERAL
           PERFORM 227-PROCESAR-LINEAS
           PERFORM 228-IMPRIMIR-TOTALES.
      *
      ******************************************************************
      * 224-IMPRIMIR-CABECERA                                          *
      * SE INFORMAN VARIABLES PARA IMPRIMIR LA CABECERA.               *
      ******************************************************************
       224-IMPRIMIR-CABECERA.
           MOVE LENGTH OF UGNC57Z          TO W-LONG-TS
           MOVE CAA-FECHA-OPER2            TO G57Z-FECHACO
           MOVE CAA-HORA-TRANSED           TO G57Z-HORACO
           MOVE CAA-USERID                 TO G57Z-USUARCO
           MOVE CAA-CENTRO-CONT            TO G57Z-OFICICO
           MOVE CAA-TERMINAL               TO G57Z-TERMINAL
           MOVE CAA-CODTRAN                TO G57Z-TRANSAC
           MOVE SPACES                     TO W-CONTENIDO-TS
           MOVE CTE-UGRMG57Z               TO W-NOMBRE-FORMATO
           MOVE UGNC57Z                    TO W-CONT-FORMATO
      *
           MOVE CAA-TERMINAL               TO W-SUFIJO-TS
           PERFORM 7777-WRITEQ
           MOVE '+DC1'                     TO CAA-DESTINO(1)
           MOVE 'P'                        TO CAA-IND-PANDOC(1)
           MOVE '1'                        TO CAA-NUM-DOCUM(1)
           MOVE '00'                       TO CAA-PRILIN-DOCUM(1).
      *
      ******************************************************************
      * 225-FORMATEAR-CUERPO                                           *
      * SE REALIZA FORMATEO DEL CUERPO.                                *
      ******************************************************************
       225-FORMATEAR-CUERPO.
            MOVE WS-PRODUCTO               TO GSCS-PRODUCT
      *
            PERFORM 250-VALIDAR-SUBPRODUCTO
            IF NSCF-OPCION = 'S'
            PERFORM AAA-ACCESO-A-MONEDAS
      *
            MOVE NSCF-SUBPROD              TO GSCS-SUBPRO
            MOVE NSCF-VLRCRED              TO GSCS-IMPCONC
      *     MOVE ZEROS                     TO GSCS-CUOTA
      *
            PERFORM 252-VALIDAR-TIPOINT-TAE
            PERFORM 253-OBTENER-TASA
      *
            MOVE NSCF-TAE                  TO GSCS-TAE
                                              GSCS-DATOTAE

            MOVE NSCF-TIPOINT              TO GSCS-TIPOINT
            MOVE WS-MONEDA                 TO GSCS-MONEDA
      *
            PERFORM 254-PERIOD-PLAZO
      *
            MOVE NSCF-PLAZO                TO GSCS-PLAZO
      *
            PERFORM 256-PERIOD-INTERESES
      *
            MOVE WS-PERI                 TO GSCS-PERINT
      *
            PERFORM 257-PERIOD-PERCAP
      *
            MOVE WS-PERC                 TO GSCS-PERCAP
      *
            PERFORM 258-PERIOD-SEGUROS
      *
            MOVE WS-PERS                 TO GSCS-PERSEG

            MOVE WS-FECSOLI                TO GSCS-FESOLIC
            MOVE NSCF-FEASIMU(5:4)         TO GSCS-FECNACI(7:4)
            MOVE CTE-GUION                 TO GSCS-FECNACI(6:1)
            MOVE NSCF-FEASIMU(3:2)         TO GSCS-FECNACI(4:2)
            MOVE CTE-GUION                 TO GSCS-FECNACI(3:1)
            MOVE NSCF-FEASIMU(1:2)         TO GSCS-FECNACI(1:2)
            END-IF.
      *     MOVE CTE-CUOTA                 TO GSCS-TIPCUO
      *     MOVE SPACES                    TO GSCS-VALCOMP
      *     MOVE ZEROS                     TO GSCS-PORCOBO.

      ******************************************************************
      * 226-ENCABEZADOS-LTERAL                                         *
      * SE IMPRIME EL RESUMEN DEL CREDITO.                             *
      ******************************************************************
       2251-IMPRIMIR-RESUMEN.

            MOVE LENGTH OF UGNCSCS          TO W-LONG-TS
            MOVE SPACES                     TO W-CONTENIDO-TS
      *STF01-I
            EVALUATE TRUE
                WHEN SW-CONSUMO-VEHI-SI
                     MOVE CTE-LIT-VEHI      TO GSCS-LITERAL
                WHEN SW-CONSUMO-FLEX-SI
                     MOVE CTE-LIT-FLEX      TO GSCS-LITERAL
                WHEN OTHER
                     MOVE SPACES            TO GSCS-LITERAL
            END-EVALUATE
      *STF01-F
            MOVE CTE-UGRMGSCS               TO W-NOMBRE-FORMATO
            MOVE UGNCSCS                    TO W-CONT-FORMATO
            MOVE CAA-TERMINAL               TO W-SUFIJO-TS
            PERFORM 7777-WRITEQ
            MOVE '+DC1'                     TO CAA-DESTINO(1)
            MOVE 'P'                        TO CAA-IND-PANDOC(1)
            MOVE '1'                        TO CAA-NUM-DOCUM(1)
            MOVE '00'                       TO CAA-PRILIN-DOCUM(1).


      ******************************************************************
      * 226-ENCABEZADOS-LTERAL                                         *
      * SE INFORMAN VARIABLES PARA ESCRIBIR ENCABEZADO LITERAL.        *
      ******************************************************************
       226-ENCABEZADOS-LTERAL.
            INITIALIZE UGNC669
      *
            MOVE CTE-LINEA-LTERAL          TO G669-LINEA1
            MOVE LENGTH OF UGNC669         TO W-LONG-TS
            MOVE SPACES                    TO W-CONTENIDO-TS
            MOVE CTE-UGRMG669              TO W-NOMBRE-FORMATO
            MOVE UGNC669                   TO W-CONT-FORMATO
            MOVE CAA-TERMINAL              TO W-SUFIJO-TS
            PERFORM 7777-WRITEQ
            MOVE '+DC1'                     TO CAA-DESTINO(1)
            MOVE 'P'                        TO CAA-IND-PANDOC(1)
            MOVE '1'                        TO CAA-NUM-DOCUM(1)
            MOVE '00'                       TO CAA-PRILIN-DOCUM(1).
      *
      ******************************************************************
      * 227-PROCESAR-LINEAS                                            *
      * SE REALIZA PROCESAMIENTO DE LAS LINEAS.                        *
      ******************************************************************
       227-PROCESAR-LINEAS.
           INITIALIZE UGNC662

           MOVE 1                          TO WS-I
      *
           PERFORM UNTIL WS-I > WS-TOTALREG-FLEX

              MOVE WS-FECHA-CUOTA(WS-I)  TO WS-FECHA-AAAA-MM-DD
              MOVE WS-FECHA-AAAA-MM-DD(1:4)   TO WS-FECHA-DDMMAAAA(5:4)
              MOVE WS-FECHA-AAAA-MM-DD(6:2)   TO WS-FECHA-DDMMAAAA(3:2)
              MOVE WS-FECHA-AAAA-MM-DD(9:2)   TO WS-FECHA-DDMMAAAA(1:2)

              MOVE WS-FECHA-DDMMAAAA          TO G662-FEFIVAL

      *       MOVE WS-CUOTA-AMORT(WS-I)       TO G662-CAPINIR
      *       ADD  WS-CUOTA-AMORT(WS-I)       TO WS-ACC-CAPINIR

              MOVE WS-CUOTA-INTERES(WS-I)     TO G662-INTINIR
              ADD  WS-CUOTA-INTERES(WS-I)     TO WS-ACC-INTINIR

              MOVE WS-CUOTA-SEGURO(WS-I)      TO G662-PRISEGU
              ADD  WS-CUOTA-SEGURO(WS-I)      TO WS-ACC-PRISEGU

              IF WS-I EQUAL WS-TOTALREG-FLEX
                 IF WS-SALDOPEN(WS-I) EQUAL ZERO
                    MOVE WS-CUOTA-AMORT(WS-I)       TO G662-CAPINIR
                    ADD  WS-CUOTA-AMORT(WS-I)       TO WS-ACC-CAPINIR
                    MOVE WS-CUOTA-TOTAL(WS-I)       TO G662-RECIBO
                    ADD  WS-CUOTA-TOTAL(WS-I)       TO WS-ACC-RECIBO
                    MOVE WS-SALDOPEN(WS-I)          TO G662-SALREAL
                 ELSE
      *COL05-I
                    MOVE WS-CUOTA-AMORT(WS-I)  TO WS-CUOTA-TOTAL(WS-I)
                    ADD WS-IMP-INT             TO WS-CUOTA-TOTAL(WS-I)
      *COL05-F
                    ADD WS-SALDOPEN(WS-I)      TO WS-CUOTA-AMORT(WS-I)
                    ADD WS-SALDOPEN(WS-I)      TO WS-CUOTA-TOTAL(WS-I)
                    MOVE ZEROS                 TO WS-SALDOPEN(WS-I)
                    MOVE WS-CUOTA-AMORT(WS-I)  TO G662-CAPINIR
                    ADD  WS-CUOTA-AMORT(WS-I)  TO WS-ACC-CAPINIR
                    MOVE WS-CUOTA-TOTAL(WS-I)  TO G662-RECIBO
                    ADD  WS-CUOTA-TOTAL(WS-I)  TO WS-ACC-RECIBO
                    MOVE WS-SALDOPEN(WS-I)     TO G662-SALREAL
                END-IF
              ELSE
                 MOVE WS-CUOTA-AMORT(WS-I)       TO G662-CAPINIR
                 ADD  WS-CUOTA-AMORT(WS-I)       TO WS-ACC-CAPINIR
                 MOVE WS-CUOTA-TOTAL(WS-I)       TO G662-RECIBO
                 ADD  WS-CUOTA-TOTAL(WS-I)       TO WS-ACC-RECIBO
                 MOVE WS-SALDOPEN(WS-I)          TO G662-SALREAL
              END-IF
      *       MOVE WS-SALDOPEN(WS-I)          TO G662-SALREAL

              PERFORM 267D-IMPRIMIR
      *
              ADD CTN-1C                   TO WS-I
           END-PERFORM.
      *
      ******************************************************************
      * 227A-CALCULA-DIAS                                              *
      * SE REALIZA EL CALCULO DE DIAS.                                 *
      ******************************************************************
       227A-CALCULA-DIAS.
      *
           MOVE ZEROS                      TO W075-NUMDIAS
           MOVE CTE-3                      TO W075-CDOPCIO
      *    MOVE CTE-N                      TO W075-TPTRAT
           MOVE CTE-C                      TO W075-TPTRAT
      *
           EXEC CICS
                LINK PROGRAM (CTE-TC1C1220)
                COMMAREA     (TCWC0750-AREA)
           END-EXEC
      *
           IF W075-CDRETORN EQUAL ZEROS
              CONTINUE
           ELSE
              MOVE CTE-UGE0939             TO CAA-COD-ERROR
              MOVE CTE-ERR-TC1             TO CAA-VAR1-ERROR
              MOVE W075-CDRETORN           TO CAA-VAR2-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF.
      *
      ******************************************************************
      * 227B-CALCULAR-INTERESES                                        *
      * SE REALIZA OPERACIONES PERA CALCULAR EL INTERES.               *
      ******************************************************************
       227B-CALCULAR-INTERESES.
           INITIALIZE URWCFIN
      *
           IF NSCF-TIPOINT > ZERO
              MOVE NSCF-TIPOINT            TO WS-TIPINT2
              MOVE WS-TIPINT2              TO FIN-TIPINT
              MOVE CTE-N                   TO FIN-TIPOTASA
           ELSE
              MOVE NSCF-TAE                TO WS-TIPINT2
              MOVE WS-TIPINT2              TO FIN-TIPINT
              MOVE CTE-E                   TO FIN-TIPOTASA
           END-IF
      *COL01-I
           IF (SW-TASPOL-SI
              AND (WS-FEPROLIQIN > WS-FECHA-FINGRACIA))
              OR SW-GRACIA-SI
              MOVE WS-CI-TEAP-LQS          TO FIN-TIPINT
              MOVE CTE-N                   TO FIN-TIPOTASA
           END-IF
      *
           IF   SW-NO-INTREM
              AND (WS-FEPROLIQIN <= WS-FECHA-FINGRACIA)
              MOVE ZEROES                  TO WS-DIAS-INT
           END-IF
      *COL01-F
      *    MOVE NSCF-TAE                   TO FIN-TIPINT
      *    MOVE CTE-E                      TO FIN-TIPOTASA
      *    IF NSCF-TASASUB EQUAL SPACES OR LOW-VALUES
      *       CONTINUE
      *    ELSE
      *       COMPUTE WS-TASA = FUNCTION NUMVAL(NSCF-TASASUB)
      *       IF WS-TASA > FIN-TIPINT
      *          MOVE 0                    TO FIN-TIPINT
      *       ELSE
      *         COMPUTE WS-TASA = FUNCTION NUMVAL(NSCF-TASASUB)
      *         COMPUTE WS-POLITIC = FIN-TIPINT/100
      *         END-COMPUTE
      *         COMPUTE WS-SUBVENC = WS-TASA/100
      *         END-COMPUTE
      *         COMPUTE FIN-TIPINT = (1+WS-POLITIC)/(1+WS-SUBVENC)
      *         END-COMPUTE
      *         COMPUTE FIN-TIPINT = FIN-TIPINT - 1
      *         END-COMPUTE
      *         COMPUTE FIN-TIPINT = FIN-TIPINT * 100
      *         END-COMPUTE
      *       END-IF
      *    END-IF
           IF FIN-TIPINT < 0
              MOVE 0                       TO FIN-TIPINT
           END-IF
           MOVE CTE-1001                   TO FIN-PERCAPIT

           IF NSCF-PERC EQUAL CTE-20ES
              MOVE ADS-PERINT              TO FIN-PERINT
           ELSE
              MOVE NSCF-PERI               TO FIN-PERINT
           END-IF

      *    MOVE CTE-N                      TO FIN-DIASCAL
           MOVE CTE-C                      TO FIN-DIASCAL
           MOVE WS-SALDO-ANTERIOR          TO FIN-CAPITAL
           MOVE CTN-1                      TO FIN-PERIODO-TIP
           MOVE WS-DIAS-INT                TO FIN-PERIODO-NUM
      *
           IF WS-DIAS-INT LESS CTN-1000
              MOVE CTN-1                   TO FIN-PERIODO-TIP
           ELSE
              IF WS-DIAS-INT GREATER CTN-999 AND LESS CTN-2000
                 MOVE CTN-6                TO FIN-PERIODO-TIP
              END-IF
      *
              IF WS-DIAS-INT GREATER CTN-1999 AND LESS CTN-3000
                 MOVE CTN-7                TO FIN-PERIODO-TIP
              END-IF
      *
              IF WS-DIAS-INT GREATER CTN-2999 AND LESS CTN-4000
                 MOVE CTN-8                TO FIN-PERIODO-TIP
              END-IF
           END-IF
      *
           CALL CTE-UR8CFIN0 USING URWCFIN
      *
           EVALUATE FIN-CDRETORNO
              WHEN CTE-00
                 MOVE FIN-INTERES          TO WS-IMP-INT
                 MOVE WS-IMP-INT           TO G662-INTINIR
                 ADD  WS-IMP-INT           TO WS-ACUM-INTERES
              WHEN OTHER
                 MOVE CTE-UGE0939          TO CAA-COD-ERROR
                 MOVE CTE-ERR-UR8          TO CAA-VAR1-ERROR
                 MOVE FIN-CDRETORNO        TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
           END-EVALUATE.
      *
      ******************************************************************
      * 227C-CALCULAR-SEGUROS                                          *
      * SE REALIZAN OPERACIONES PARA CALCULAR SEGUROS.                 *
      ******************************************************************
       227C-CALCULAR-SEGUROS.
           MOVE CTE-96                     TO W101-PRODUCTO
           MOVE NSCF-SUBPROD               TO W101-SUBPRODUCTO
           MOVE WS-SALDO-ANTERIOR          TO W101-VALOR
           MOVE NSCF-FEASIMU(5:4)          TO W101-FECNACIMI(1:4)
           MOVE CTE-GUION                  TO W101-FECNACIMI(5:1)
           MOVE NSCF-FEASIMU(3:2)          TO W101-FECNACIMI(6:2)
           MOVE CTE-GUION                  TO W101-FECNACIMI(8:1)
           MOVE NSCF-FEASIMU(1:2)          TO W101-FECNACIMI(9:2)
      *
           IF PRO-INDEALER EQUAL CTE-S
              MOVE CTE-L                   TO W101-TIPO
              MOVE NSCF-PLAZO(1:1)         TO WS-TIPO-PLAZO
              MOVE NSCF-PLAZO(2:3)         TO WS-DURA-PLAZO

              EVALUATE WS-TIPO-PLAZO
                 WHEN  CTN-1
                    MOVE CTN-360           TO WS-TIEMPO
                 WHEN  CTN-2
                    MOVE CTN-12            TO WS-TIEMPO
                 WHEN OTHER
                    MOVE CTN-1             TO WS-TIEMPO
              END-EVALUATE
      *
              COMPUTE W101-DURACION = WS-DURA-PLAZO / WS-TIEMPO
      *
              IF W101-DURACION LESS CTN-1
                 MOVE CTN-1                TO W101-DURACION
              END-IF
           ELSE
              MOVE SPACES                  TO W101-TIPO
           END-IF
      *
           CALL CTE-IC9C1001 USING ICWC101
      *
           EVALUATE W101-ICCRETOR
              WHEN CTE-00
                 MOVE W101-ICIPRTOT        TO WS-PRIMSEGU
              WHEN CTE-10
                 MOVE CTE-UGE0939          TO CAA-COD-ERROR
                 MOVE CTE-ERR-DAT-ENT      TO CAA-VAR1-ERROR
                 MOVE W101-ICCRETOR        TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              WHEN CTE-50
                 MOVE CTE-UGA0123          TO CAA-COD-AVISO1
                 MOVE W101-ICCRETOR        TO CAA-VAR1-AVISO1(1:2)
                 MOVE CTE-SUBPRODUC2       TO CAA-VAR1-AVISO1(3:12)
                 MOVE NSCF-SUBPROD         TO CAA-VAR1-AVISO1(16:4)
                 MOVE CTE-SIN-TAR          TO CAA-VAR2-AVISO1(1:11)
                 MOVE W101-ICMERREF(1:4)   TO CAA-VAR2-AVISO1(13:4)
                 MOVE ZEROS                TO WS-PRIMSEGU
              WHEN CTE-60
                 MOVE CTE-UGA0123          TO CAA-COD-AVISO1
                 MOVE W101-ICCRETOR        TO CAA-VAR1-AVISO1(1:2)
                 MOVE CTE-SIN-TAR          TO CAA-VAR1-AVISO1(4:11)
                 MOVE W101-ICMERREF(1:4)   TO CAA-VAR1-AVISO1(16:4)
                 MOVE CTE-PAR-EST-EDA      TO CAA-VAR2-AVISO1(1:15)
                 MOVE W101-ICMERREF(6:3)   TO CAA-VAR2-AVISO1(17:3)
                 MOVE ZEROS                TO WS-PRIMSEGU
              WHEN OTHER
                 MOVE CTE-UGE0939          TO CAA-COD-ERROR
                 MOVE W101-ICCRETOR        TO CAA-VAR1-ERROR(1:2)
                 MOVE CTE-ERR-RUT          TO CAA-VAR1-ERROR(3:15)
                 MOVE CTE-IC9C1001         TO CAA-VAR2-ERROR(1:8)
                 MOVE W101-ICLTANOM        TO CAA-VAR2-ERROR(10:8)
                 PERFORM 3-FIN-PROGRAMA
           END-EVALUATE.
      *
      ******************************************************************
      * 267D-IMPRIMIR                                                  *
      * SE INFORMAN VARIABLES PARA REALIZAR ESCRITURA.                 *
      ******************************************************************
       267D-IMPRIMIR.
           MOVE LENGTH OF UGNC662          TO W-LONG-TS
           MOVE SPACES                     TO W-CONTENIDO-TS
           MOVE CTE-UGRMG662               TO W-NOMBRE-FORMATO
           MOVE UGNC662                    TO W-CONT-FORMATO
           MOVE CAA-TERMINAL               TO W-SUFIJO-TS
           PERFORM 7777-WRITEQ
           MOVE '+DC1'                     TO CAA-DESTINO(1)
           MOVE 'P'                        TO CAA-IND-PANDOC(1)
           MOVE '1'                        TO CAA-NUM-DOCUM(1)
           MOVE '00'                       TO CAA-PRILIN-DOCUM(1).
      *
      ******************************************************************
      * 228-IMPRIMIR-TOTALES                                           *
      * SE REALIZA LA ESCRITURA DE LOS TOTALES.                        *
      ******************************************************************
       228-IMPRIMIR-TOTALES.

           COMPUTE WS-ACC-CAPINIR ROUNDED = WS-ACC-CAPINIR + ZERO

           MOVE WS-ACC-CAPINIR             TO G663-CAPINIR
           MOVE WS-ACC-INTINIR             TO G663-INTINIR
           MOVE WS-ACC-PRISEGU             TO G663-PRISEGU
           MOVE WS-ACC-RECIBO              TO G663-RECIBOS
           MOVE LENGTH OF UGNC663          TO W-LONG-TS
           MOVE SPACES                     TO W-CONTENIDO-TS
           MOVE CTE-UGRMG663               TO W-NOMBRE-FORMATO
           MOVE UGNC663                    TO W-CONT-FORMATO
           MOVE CAA-TERMINAL               TO W-SUFIJO-TS
           PERFORM 7777-WRITEQ
           MOVE '+DC1'                     TO CAA-DESTINO(1)
           MOVE 'P'                        TO CAA-IND-PANDOC(1)
           MOVE '1'                        TO CAA-NUM-DOCUM(1)
           MOVE '00'                       TO CAA-PRILIN-DOCUM(1).
      *
      ******************************************************************
      * 250-VALIDAR-SUBPRODUCTO                                        *
      * SE REALIZA LA VALIDACION DEL SUBPRODUCTO.                      *
      ******************************************************************
       250-VALIDAR-SUBPRODUCTO.
            MOVE WS-PRODUCTO               TO PRO-PRODUCTO
            MOVE NSCF-SUBPROD              TO PRO-SUBPRO
      *
            EXEC SQL
                 SELECT TEXTORED
                       ,MONEDA
                       ,INDEALER
                   INTO :PRO-TEXTORED
                       ,:PRO-MONEDA
                       ,:PRO-INDEALER
                   FROM UGDTPRO
                  WHERE SUBPRO   = :PRO-SUBPRO
                    AND PRODUCTO = :PRO-PRODUCTO
            END-EXEC
      *
            MOVE SQLCODE TO DB2-RETURN-CDE
      *
            IF DB2-OK
               MOVE PRO-TEXTORED           TO GSCS-TEXTORE
            ELSE
               IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                  MOVE CTE-UGE0204         TO CAA-COD-ERROR
                  PERFORM 3-FIN-PROGRAMA
               ELSE
                  MOVE CTE-UGE0939         TO CAA-COD-ERROR
                  MOVE CTE-ERR-SEL-UGD     TO CAA-VAR1-ERROR
                  PERFORM 3-FIN-PROGRAMA
               END-IF
            END-IF.
      *
      ******************************************************************
      *             RUTINA DE ACCESO A LA TABLA DE MONEDAS PARA SACAR  *
      *             DESCRIPCION DE MONEDA                              *
      ******************************************************************
       AAA-ACCESO-A-MONEDAS.
      *
           INITIALIZE TCWC0200
           MOVE PRO-MONEDA                    TO W020-CDDIVISS
      *
           EXEC CICS
                  LINK PROGRAM('TC2C1800')
                  COMMAREA(TCWC0200)
           END-EXEC
      *
           EVALUATE W020-CDRETORN
              WHEN '00'
                 MOVE W020-CDDIVISS           TO DS-MONEDA
                 MOVE W020-NBDIVIN            TO DS-DESMON
                 MOVE  DS-DEMONEDA            TO WS-MONEDA
              WHEN OTHER
                 MOVE W020-CDDIVISS           TO DS-MONEDA
                 MOVE 'SIN DESCRIPCION'       TO DS-DESMON
                 MOVE  DS-DEMONEDA            TO WS-MONEDA
           END-EVALUATE.
      *
      ******************************************************************
      * 252-VALIDAR-TIPOINT-TAE                                        *
      * SE REALIZA LA VALIDACION DE TIPOINT.                           *
      ******************************************************************
       252-VALIDAR-TIPOINT-TAE.
           IF (NSCF-TAE-ALF NOT EQUAL (LOW-VALUES AND ZEROS AND SPACES))
              AND (NSCF-TIPOINT-ALF NOT EQUAL (LOW-VALUES AND
                  ZEROS AND SPACES ))
              MOVE CTE-UGE0939             TO CAA-COD-ERROR
              MOVE CTE-INF-SOL-UNA         TO CAA-VAR1-ERROR
              MOVE CTE-TAS-DE-INT          TO CAA-VAR2-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF
      *
           IF (NSCF-TIPOINT-ALF EQUAL LOW-VALUES OR SPACES) AND
              (NSCF-TAE-ALF     EQUAL LOW-VALUES OR SPACES)
              PERFORM 252-1-BUSCAR-LQS
           END-IF.
      *
      ******************************************************************
      * 252-1-BUSCAR-LQS                                               *
      * SE REALIZA BUSQUEDE DE LQS.                                    *
      ******************************************************************
       252-1-BUSCAR-LQS.
           IF ADS-INDINVAR EQUAL CTE-S
              MOVE CTE-102                 TO LQS-CODCONLI
           ELSE
              MOVE CTE-101                 TO LQS-CODCONLI
           END-IF
      *
           MOVE WS-PRODUCTO                TO LQS-PRODUCTO
           MOVE NSCF-SUBPROD               TO LQS-SUBPRO
           MOVE NSCF-PLAZO                 TO LQS-PLAZO
           MOVE WS-FECSOLI                 TO LQS-FECOVALI
           MOVE LQS-PLAZO                  TO WS-CODIGO-PERIODO-4
      *
           EVALUATE WS-CODIGO-4
              WHEN CTN-3
                 MULTIPLY WS-PERIODO-4 BY CTN-12 GIVING WS-MESES-TOT
      *
                 IF WS-MESES-TOT GREATER CTN-999
                    MOVE CTN-999           TO WS-PERIODO-4
                 ELSE
                    MOVE WS-MESES-TOT      TO WS-PERIODO-4
                 END-IF
              WHEN CTN-2
                 CONTINUE
              WHEN CTN-1
                 DIVIDE WS-PERIODO-4 BY CTN-30 GIVING WS-MESES-TOT
                 MOVE WS-MESES-TOT         TO WS-PERIODO-4
           END-EVALUATE
      *
           MOVE CTN-2                      TO WS-CODIGO-4
           MOVE WS-CODIGO-PERIODO-4        TO LQS-PLAZO
      *
           EXEC SQL
                SELECT TIPOAPLI
                      ,IMPMINI
                      ,IMPMAXI
                      ,PERCAPIT
                      ,TIPOTASA
                  INTO :LQS-TIPOAPLI
                      ,:LQS-IMPMINI
                      ,:LQS-IMPMAXI
                      ,:LQS-PERCAPIT
                      ,:LQS-TIPOTASA
                  FROM UGDTLQS
                 WHERE PRODUCTO  = :LQS-PRODUCTO
                   AND SUBPRO    = :LQS-SUBPRO
                   AND CODCONLI  = :LQS-CODCONLI
                   AND FECOVALI <= :LQS-FECOVALI
                   AND FEFIVALI >= :LQS-FECOVALI
                   AND PLAZO     =
                       (SELECT MIN(PLAZO)
                          FROM UGDTLQS
                         WHERE PRODUCTO  = :LQS-PRODUCTO
                           AND SUBPRO    = :LQS-SUBPRO
                           AND CODCONLI  = :LQS-CODCONLI
                           AND PLAZO    >= :LQS-PLAZO
                           AND FECOVALI <= :LQS-FECOVALI
                           AND FEFIVALI >= :LQS-FECOVALI )
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 EQUAL SPACES
              EVALUATE ADS-INDINVAR
                 WHEN CTE-S
                   PERFORM 252-1-LLAMADA-UGDTRFI
      *
                   IF ADS-ISUMCON EQUAL CTE-S
                      IF LQS-TIPOTASA EQUAL CTE-E
                         COMPUTE NSCF-TAE = LQS-TIPOAPLI + RFI-UGTIPINT
                      ELSE
                         COMPUTE NSCF-TIPOINT = LQS-TIPOAPLI +
                                                RFI-UGTIPINT
                      END-IF
                   ELSE
                      IF LQS-TIPOTASA EQUAL CTE-E
                         MOVE RFI-UGTIPINT TO NSCF-TAE
                      ELSE
                         MOVE RFI-UGTIPINT TO NSCF-TIPOINT
                      END-IF
                    END-IF
                 WHEN OTHER
                    IF LQS-TIPOTASA EQUAL CTE-E
                       MOVE LQS-TIPOAPLI   TO NSCF-TAE
                    ELSE
                       MOVE LQS-TIPOAPLI   TO NSCF-TIPOINT
                    END-IF
              END-EVALUATE
           ELSE
              IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                 MOVE CTE-UGE3838          TO CAA-COD-ERROR
                 PERFORM 3-FIN-PROGRAMA
              ELSE
                 MOVE SQLCODE              TO ABC-SQLCODE
                 MOVE CTE-UGDTLQS          TO ABC-OBJETO-ERROR
                 MOVE CTE-SELECT           TO ABC-REFERENCIA
                 PERFORM 9-ABEND-DB2
              END-IF
           END-IF.
      *
      ******************************************************************
      * 252-1-LLAMADA-UGDTRFI                                          *
      * SE REALIZA CONSULTA SELECT A LA TABLA UGDTRFI.                 *
      ******************************************************************
       252-1-LLAMADA-UGDTRFI.
           IF ADS-CODTIPRE EQUAL SPACES OR LOW-VALUES
              MOVE CTE-DTF                 TO RFI-UGIDXREF
           ELSE
              MOVE ADS-CODTIPRE            TO RFI-UGIDXREF
           END-IF
      *
           MOVE LQS-FECOVALI               TO RFI-FECOVALI
      *
           EXEC SQL
                SELECT UGTIPINT
                  INTO :RFI-UGTIPINT
                  FROM UGDTRFI
                 WHERE UGIDXREF = :RFI-UGIDXREF
                   AND FEFIVALI =
                      (SELECT MAX(FEFIVALI)
                         FROM UGDTRFI
                        WHERE UGIDXREF  = :RFI-UGIDXREF
                          AND FECOVALI <= :RFI-FECOVALI)
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 EQUAL SPACES OR LOW-VALUES
              CONTINUE
           ELSE
              IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES OR LOW-VALUES
                 MOVE CTE-UGE3138          TO CAA-COD-ERROR
                 MOVE RFI-UGIDXREF         TO CAA-VAR1-ERROR
                 MOVE RFI-FECOVALI         TO CAA-VAR2-ERROR
                 PERFORM 3-FIN-PROGRAMA
              ELSE
                 MOVE SQLCODE              TO ABC-SQLCODE
                 MOVE CTE-UGDTRFI          TO ABC-OBJETO-ERROR
                 MOVE CTE-SELECT           TO ABC-REFERENCIA
                 PERFORM 9-ABEND-DB2
              END-IF
           END-IF.
      *
      ******************************************************************
      * CALCULA-NUEVA-TASA                                             *
      * SE CALCULA LA NUEVA TASA APLICANDO LA TASA DE SUBVENCION       *
      ******************************************************************
       CALCULA-NUEVA-TASA.
           COMPUTE WS-TASA = FUNCTION NUMVAL(NSCF-TASASUB)
           IF WS-TASA > WS-TIPINT
              MOVE 0                    TO WS-TIPINT
           ELSE
              COMPUTE WS-TASA = FUNCTION NUMVAL(NSCF-TASASUB)
              COMPUTE WS-POLITIC = WS-TIPINT/100
              END-COMPUTE
              COMPUTE WS-SUBVENC = WS-TASA/100
              END-COMPUTE
              COMPUTE WS-TIPINT = (1+WS-POLITIC)/(1+WS-SUBVENC)
              END-COMPUTE
              COMPUTE WS-TIPINT = WS-TIPINT - 1
              END-COMPUTE
              COMPUTE WS-TIPINT = WS-TIPINT * 100
              END-COMPUTE
           END-IF.
      ******************************************************************
      * 253-OBTENER-TASA                                               *
      * SE REALIZA OBTENCION DE LA TASA.                               *
      ******************************************************************
       253-OBTENER-TASA.
           IF NSCF-TIPOINT-ALF EQUAL LOW-VALUES OR ZEROS OR SPACES
              INITIALIZE URWCCVT
              MOVE CTE-N                   TO CVT-RESULTADO
      *
              IF ADS-CODTIPRE EQUAL SPACES OR LOW-VALUES
                 MOVE CTE-DTF              TO CVT-TIPO-TASA
              ELSE
                 MOVE ADS-CODTIPRE         TO CVT-TIPO-TASA
              END-IF
      *
              MOVE CTE-S                   TO CVT-IND-CONV
              MOVE ZERO                    TO CVT-PUNTOS
              IF NSCF-TASASUB EQUAL SPACES OR LOW-VALUES
                 CONTINUE
              ELSE
                 MOVE NSCF-TAE             TO WS-TIPINT
                 PERFORM CALCULA-NUEVA-TASA
                 MOVE WS-TIPINT            TO NSCF-TAE
              END-IF
              MOVE NSCF-TAE                TO CVT-TASA

              IF NSCF-PERC EQUAL CTE-20ES
                 MOVE ADS-PERINT           TO CVT-PERINT
              ELSE
                 MOVE NSCF-PERI            TO CVT-PERINT
              END-IF

              MOVE NSCF-PLAZO              TO CVT-PLAZO
              PERFORM 253-1-CALCULA-TASA-NOMINAL
              MOVE CVT-NOMINAL             TO NSCF-TIPOINT
           ELSE
              INITIALIZE URWCCVT
      *
              MOVE CTE-E                   TO CVT-RESULTADO
      *
              IF ADS-CODTIPRE EQUAL SPACES OR LOW-VALUES
                 MOVE CTE-DTF              TO CVT-TIPO-TASA
              ELSE
                 MOVE ADS-CODTIPRE         TO CVT-TIPO-TASA
              END-IF
      *
              MOVE CTE-S                   TO CVT-IND-CONV
              MOVE ZERO                    TO CVT-PUNTOS
              IF NSCF-TASASUB EQUAL SPACES OR LOW-VALUES
                 CONTINUE
              ELSE
                 MOVE NSCF-TIPOINT         TO WS-TIPINT
                 PERFORM CALCULA-NUEVA-TASA
                 MOVE WS-TIPINT            TO NSCF-TIPOINT
              END-IF
              MOVE NSCF-TIPOINT            TO CVT-TASA

              IF NSCF-PERC EQUAL CTE-20ES
                 MOVE ADS-PERINT           TO CVT-PERINT
              ELSE
                 MOVE NSCF-PERI            TO CVT-PERINT
              END-IF

              MOVE NSCF-PLAZO              TO CVT-PLAZO
              PERFORM 253-1-CALCULA-TASA-NOMINAL
              MOVE CVT-EFECTIVA            TO NSCF-TAE
           END-IF.
      *
      ******************************************************************
      * 253-1-CALCULA-TASA-NOMINAL                                     *
      * SE REALIZA EL CALCULO DE LA TAZA NOMINAL.                      *
      ******************************************************************
       253-1-CALCULA-TASA-NOMINAL.
           IF ADS-CODTIPRE(1:2) EQUAL CTE-IB AND
              CVT-RESULTADO     EQUAL CTE-N
              MOVE NSCF-TAE                TO CVT-NOMINAL
              MOVE ZEROS                   TO CVT-COD-ERROR
           ELSE
              EXEC CICS LINK
                   PROGRAM (CTE-UR1CCVT0)
                   COMMAREA (RWCCVT-AREA)
              END-EXEC
           END-IF
      *
           IF CVT-COD-ERROR NOT EQUAL ZEROS
              MOVE CTE-UGE0517             TO CAA-COD-ERROR
              MOVE CTE-UR1CCVT0            TO CAA-VAR1-ERROR
              MOVE CVT-COD-ERROR           TO CAA-VAR2-ERROR
              PERFORM  3-FIN-PROGRAMA
           END-IF.
      *
      ******************************************************************
      * 254-PERIOD-PLAZO                                               *
      * SE INFORMAN VARIABLES PARA REALIZAR ACCESO A LA TAVLA UGDTCOD. *
      ******************************************************************
       254-PERIOD-PLAZO.
           MOVE CTE-CON-TIPO-PLAZO         TO COD-TIPO
           MOVE NSCF-PLAZO                 TO COD-CODIGO
      *
           PERFORM 255-ACCEDER-TABLA-UCOD
      *
           IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
              MOVE CTE-UGE0141             TO CAA-COD-ERROR
              MOVE CTE-PAR-TER-TEC         TO CAA-VAR1-ERROR
              PERFORM 3-FIN-PROGRAMA
           END-IF
      *
           MOVE COD-DESCRRED               TO GSCS-DESPLAZ.
      *
      ******************************************************************
      * 255-ACCEDER-TABLA-UCOD                                         *
      * SE REALIZA CONSULTA SELECT A LA TABLA UGDTCOD.                 *
      ******************************************************************
       255-ACCEDER-TABLA-UCOD.
            EXEC SQL
                 SELECT DESCRRED
                   INTO :COD-DESCRRED
                   FROM UGDTCOD
                  WHERE TIPO   = :COD-TIPO
                    AND CODIGO = :COD-CODIGO
            END-EXEC
      *
            MOVE SQLCODE                   TO DB2-RETURN-CDE
      *
            IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
               MOVE WS-DESC-INEX           TO COD-DESCRRED
            ELSE
               IF NOT DB2-OK OR SQLWARN0 NOT EQUAL SPACES
                  MOVE SQLCODE             TO ABC-SQLCODE
                  MOVE CTE-UGDTCOD         TO ABC-OBJETO-ERROR
                  MOVE CTE-SELECT          TO ABC-REFERENCIA
                  PERFORM 9-ABEND-DB2
               END-IF
            END-IF.
      *
      ******************************************************************
      * 256-PERIOD-INTERESES                                           *
      * SE VERIFICA LA PERIOCIDAD DE INTERES.                          *
      ******************************************************************
       256-PERIOD-INTERESES.
           IF NSCF-PERI EQUAL SPACES OR LOW-VALUES
      *       MOVE ADS-PERINT              TO COD-CODIGO
      *       MOVE CTE-CON-TIPO-PERINT     TO COD-TIPO
      *       MOVE WS-PERI                 TO COD-CODIGO
      *
      *       PERFORM 255-ACCEDER-TABLA-UCOD
      *
      *       MOVE COD-DESCRRED            TO GSCS-DESPERI
              MOVE 'ESPECIAL'              TO GSCS-DESPERI
              MOVE '2ES'                   TO WS-PERI
           ELSE
              IF ADS-CODTIAMO NOT EQUAL CTE-A AND
                NSCF-PERI EQUAL CTE-999
                 MOVE CTE-UGE0151          TO CAA-COD-ERROR
                 PERFORM 3-FIN-PROGRAMA
              ELSE
                 MOVE CTE-CON-TIPO-PERINT  TO COD-TIPO
                 MOVE WS-PERI              TO COD-CODIGO
      *
                 PERFORM  255-ACCEDER-TABLA-UCOD
      *
                 IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                    MOVE CTE-UGE0141       TO CAA-COD-ERROR
                    MOVE CTE-PER-INT2      TO CAA-VAR1-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 ELSE
                    MOVE COD-DESCRRED      TO GSCS-DESPERI
                 END-IF
              END-IF
           END-IF.
      *
      ******************************************************************
      * 257-PERIOD-PERCAP                                              *
      * SE VERIFICA PERIOCIDAD CAPITAL.                                *
      ******************************************************************
       257-PERIOD-PERCAP.
           IF NSCF-PERC EQUAL CTE-20ES
      *       MOVE ADS-PERCAP              TO COD-CODIGO
      *       MOVE CTE-CON-TIPO-PERCAP     TO COD-TIPO
      *       MOVE NSCF-PERC               TO COD-CODIGO
      *
      *       PERFORM 255-ACCEDER-TABLA-UCOD
      *
      *       MOVE COD-DESCRRED            TO GSCS-DESPERC
              MOVE 'ESPECIAL'              TO GSCS-DESPERC
              MOVE '2ES'                   TO WS-PERC
           ELSE
              IF ADS-CODTIAMO  EQUAL CTE-A   AND
                 NSCF-PERC NOT EQUAL CTE-999
                 MOVE CTE-UGE0151          TO CAA-COD-ERROR
                 PERFORM 3-FIN-PROGRAMA
              ELSE
                 IF ADS-CODTIAMO NOT EQUAL CTE-A AND
                    NSCF-PERC    EQUAL CTE-999
                    MOVE CTE-UGE0151       TO CAA-COD-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 ELSE
                    MOVE CTE-CON-TIPO-PERCAP
                                           TO COD-TIPO
                    MOVE WS-PERC         TO COD-CODIGO
      *
                    PERFORM 255-ACCEDER-TABLA-UCOD
      *
                    IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                       MOVE CTE-UGE0141    TO CAA-COD-ERROR
                       MOVE CTE-PER-CAP2   TO CAA-VAR1-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    ELSE
                       MOVE COD-DESCRRED   TO GSCS-DESPERC
                    END-IF
                 END-IF
              END-IF
           END-IF.
      *
      ******************************************************************
      * 258-PERIOD-SEGUROS                                             *
      * SE VERIFICA PERIOCIDAD SEGUROS.                                *
      ******************************************************************
       258-PERIOD-SEGUROS.
           IF NSCF-PERS EQUAL SPACES OR LOW-VALUES
      *       MOVE ADS-PERINT              TO COD-CODIGO
      *       MOVE CTE-CON-TIPO-PERINT     TO COD-TIPO
      *       MOVE NSCF-PERS               TO COD-CODIGO
      *
      *       PERFORM 255-ACCEDER-TABLA-UCOD
      *
      *       MOVE COD-DESCRRED            TO GSCS-DESPERS
              MOVE 'ESPECIAL'              TO GSCS-DESPERS
              MOVE '2ES'                   TO WS-PERS
           ELSE
              IF NSCF-PERS EQUAL CTE-20TO
                 MOVE 'ANTICIPADO'         TO GSCS-DESPERS
                 MOVE '2TO'                TO WS-PERS
              ELSE
                 IF ADS-CODTIAMO NOT EQUAL CTE-A AND
                    NSCF-PERS    EQUAL CTE-999
                    MOVE CTE-UGE0151          TO CAA-COD-ERROR
                    PERFORM 3-FIN-PROGRAMA
                 ELSE
                    MOVE CTE-CON-TIPO-PERINT  TO COD-TIPO
                    MOVE WS-PERS            TO COD-CODIGO
                    PERFORM  255-ACCEDER-TABLA-UCOD
      *
                    IF DB2-NOTFND AND SQLWARN0 EQUAL SPACES
                       MOVE CTE-UGE0141       TO CAA-COD-ERROR
                       MOVE CTE-PER-SEG       TO CAA-VAR1-ERROR
                       PERFORM 3-FIN-PROGRAMA
                    ELSE
                       MOVE COD-DESCRRED      TO GSCS-DESPERS
                    END-IF
                 END-IF
              END-IF
           END-IF.
      *
      ******************************************************************
      *                        2200-MANEJO-CICLICO                     *
      *     SIMULACION FINACIERA PARA PRESTAMOS DE CONSUMO FLEXIBLE    *
      *     CICLICOS.                                                  *
      ******************************************************************
       2200-MANEJO-CICLICO.

           PERFORM 2210-CALCULA-CAPITAL
           PERFORM 2220-CALCULA-PERIODO-INTERES
           PERFORM 2230-CALCULA-PERIODO-SEGURO
           PERFORM 2250-GENERA-CUADRO.

      ******************************************************************
      *                        2210-CALCULA-CAPITAL                    *
      *     GENERA TABLA CON VALOR DE LAS CUOTAS Y FECHA EN QUE SE     *
      *     DEBE PAGAR                                                 *
      ******************************************************************
       2210-CALCULA-CAPITAL.

               PERFORM 22111-OBTENER-PLAZO

               MOVE NSCF-PERC(2:3)               TO WS-PER-CAP-MM

      *COL01-I
               IF SW-GRACIA-SI
                  SUBTRACT WS-PLAZ-GRACIA FROM WS-PLAZO-MESES
                           GIVING WS-PLAZO-MESES-G
                  COMPUTE WS-NUMCUO-TOTAL-G =
                          WS-PLAZO-MESES-G / WS-PER-CAP-MM
               END-IF
      *COL01-F
               COMPUTE WS-NUMCUO-TOTAL = WS-PLAZO-MESES / WS-PER-CAP-MM
      *COL01-I
      *        COMPUTE WS-IMPCUOTA = NSCF-VLRCRED / WS-NUMCUO-TOTAL
               IF SW-GRACIA-SI
      *COL05-I
                  PERFORM 22023-CALCULA-CUOTA
                  MOVE  COT-CUOTA     TO WS-IMPCUOTA
      *           COMPUTE WS-IMPCUOTA = NSCF-VLRCRED / WS-NUMCUO-TOTAL-G
      *COL05-F
                  IF NSCF-PERS IS NUMERIC
                     MOVE  NSCF-PERS(3:2) TO CIC-PERIODIC-SEG
                     DIVIDE WS-PLAZO-MESES-G BY CIC-PERIODIC-SEG GIVING
                            WS-COC1 REMAINDER WS-RES1
                  END-IF
                  IF NSCF-PERI IS NUMERIC
                     MOVE  NSCF-PERI(3:2) TO CIC-PERIODIC-INT
                     DIVIDE  WS-PLAZO-MESES  BY CIC-PERIODIC-INT GIVING
                            WS-COC2 REMAINDER WS-RES2
                  END-IF

                  IF WS-RES1 = 0 AND WS-RES2 = 0
                     CONTINUE
                  ELSE
                     MOVE 'UGE7612' TO CAA-COD-ERROR
                     MOVE SPACES TO CAA-VAR1-ERROR
                     MOVE SPACES TO CAA-VAR2-ERROR
                     PERFORM 3-FIN-PROGRAMA
                  END-IF

               ELSE
                  COMPUTE WS-IMPCUOTA = NSCF-VLRCRED / WS-NUMCUO-TOTAL
               END-IF
      *COL01-F


               MOVE 1                      TO WS-CONTA1
               MOVE 1                      TO WS-CONTA6
               MOVE WS-FECSOLI             TO WS-FEULIQ
               MOVE NSCF-PERC              TO WS-PERIOD

               PERFORM 2240-FEPROLIQ

      *COL01-I
      *        COMPUTE WS-SALDO-NUEVO = NSCF-VLRCRED - WS-IMPCUOTA
               IF SW-GRACIA-SI OR SW-TASPOL-SI
                  MOVE    WS-FECSOLI       TO WS-FEULIQ
                  PERFORM 9999-FEFINGRACIA
               END-IF
      *
               IF SW-GRACIA-SI
                 AND (WS-FECHA-CALCULADA <= WS-FECHA-FINGRACIA)
                     MOVE 0                      TO WS-CONTA1
                     COMPUTE WS-SALDO-NUEVO = NSCF-VLRCRED
      *              MOVE    ZEROES        TO WS-AMORTIZA(WS-CONTA1)
               ELSE
                  COMPUTE WS-SALDO-NUEVO = NSCF-VLRCRED - WS-IMPCUOTA
                  MOVE WS-FECHA-CALCULADA TO WS-FELIQCA(WS-CONTA1)
                  MOVE WS-IMPCUOTA        TO WS-AMORTIZA(WS-CONTA1)
                  MOVE WS-SALDO-NUEVO     TO WS-NUEVO-SALDO(WS-CONTA1)
               END-IF
      *COL01-F

      *COL01-I
      *        MOVE WS-FECHA-CALCULADA     TO WS-FELIQCA(WS-CONTA1)
      *        MOVE WS-IMPCUOTA            TO WS-AMORTIZA(WS-CONTA1)
      *        MOVE WS-SALDO-NUEVO         TO WS-NUEVO-SALDO(WS-CONTA1)
      *COL01-F

               ADD  1                      TO WS-CONTA6

               PERFORM UNTIL WS-CONTA6 > WS-NUMCUO-TOTAL

      *COL01-I
      *            ADD 1                   TO WS-CONTA1
      *COL01-F
                   ADD 1                   TO WS-CONTA6

                   MOVE WS-FECHA-CALCULADA TO WS-FEULIQ

                   PERFORM 2240-FEPROLIQ
      *COL01-I
                IF SW-GRACIA-SI
                   AND (WS-FECHA-CALCULADA <= WS-FECHA-FINGRACIA)
      *            COMPUTE WS-SALDO-NUEVO = WS-SALDO-NUEVO
      *            MOVE    ZEROES          TO WS-AMORTIZA(WS-CONTA1)
                   CONTINUE
                ELSE
                   ADD 1                   TO WS-CONTA1
                   COMPUTE WS-SALDO-NUEVO = WS-SALDO-NUEVO - WS-IMPCUOTA
                   MOVE WS-FECHA-CALCULADA TO WS-FELIQCA(WS-CONTA1)
                   MOVE WS-IMPCUOTA        TO WS-AMORTIZA(WS-CONTA1)
                   MOVE WS-SALDO-NUEVO     TO WS-NUEVO-SALDO(WS-CONTA1)
                END-IF
      *COL01-F


      *COL01-I
      *            MOVE WS-FECHA-CALCULADA TO WS-FELIQCA(WS-CONTA1)
      *            MOVE WS-IMPCUOTA        TO WS-AMORTIZA(WS-CONTA1)
      *            MOVE WS-SALDO-NUEVO     TO WS-NUEVO-SALDO(WS-CONTA1)
      *COL01-F
               END-PERFORM

               MOVE WS-FELIQCA(WS-CONTA1)  TO WS-FECHA-FIN.
      *
      ******************************************************************
      *                        22111-OBTENER-PLAZO                     *
      *        SE OBTIEN EL PLAZO DEL CREDITO EXPRESADO EN MESES       *
      ******************************************************************
       22111-OBTENER-PLAZO.

            MOVE NSCF-PLAZO                     TO WS-PLAZO

            IF WS-PLAZO(1:1) EQUAL '1'
               MOVE WS-PLAZO(2:3)               TO WS-PLAZO-MESES
               COMPUTE WS-PLAZO-MESES =  WS-PLAZO-MESES / 30
            ELSE
               IF WS-PLAZO(1:1) EQUAL '2'
                  MOVE WS-PLAZO(2:3)            TO WS-PLAZO-MESES
               ELSE
                  IF WS-PLAZO(1:1) EQUAL '3'
                     MOVE WS-PLAZO(2:3)         TO WS-PLAZO-MESES
                     COMPUTE WS-PLAZO-MESES =  WS-PLAZO-MESES * 12
                  ELSE
                     MOVE 'UGE0939'             TO CAA-COD-ERROR
                     MOVE 'ERR EN PLAZO: '      TO CAA-VAR1-ERROR(1:14)
                     MOVE NSCF-PLAZO            TO CAA-VAR1-ERROR(15:4)
                     MOVE 'PERIODICID INVALID ' TO CAA-VAR2-ERROR
                     PERFORM 3-FIN-PROGRAMA
                  END-IF
               END-IF
            END-IF.
      *
      ******************************************************************
      *                  2220-CALCULA-PERIODO-INTERES.                 *
      *     GENERA TABLA CON LAS FECHAS EN LAS QUE SEBE COBRAR EL      *
      *     INTERES                                                    *
      ******************************************************************
       2220-CALCULA-PERIODO-INTERES.

            MOVE WS-FECSOLI             TO WS-FEULIQ
            MOVE NSCF-PERI              TO WS-PERIOD

            PERFORM 2240-FEPROLIQ

            MOVE WS-FECHA-CALCULADA     TO WS-FEPROLIQI
            MOVE 1                      TO WS-CONTA2

            PERFORM UNTIL WS-FEPROLIQI > WS-FECHA-FIN
      *COL01-I
               IF SW-GRACIA-SI
                   AND (WS-FEPROLIQI < WS-FECHA-FINGRACIA)
                   CONTINUE
               ELSE
                   MOVE WS-FEPROLIQI    TO WS-FELIQIN(WS-CONTA2)
                   ADD 1                TO WS-CONTA2
               END-IF
      *        MOVE WS-FEPROLIQI        TO WS-FELIQIN(WS-CONTA2)
      *
      *        ADD 1                    TO WS-CONTA2
      *COL01-F

               MOVE WS-FEPROLIQI        TO WS-FEULIQ

               PERFORM 2240-FEPROLIQ

               MOVE WS-FECHA-CALCULADA   TO WS-FEPROLIQI

            END-PERFORM.


      ******************************************************************
      *                   2230-CALCULA-PERIODO-SEGURO.                 *
      *     GENERA TABLA CON LAS FECHAS EN LAS QUE SEBE COBRAR EL      *
      *     SEGURO.                                                    *
      ******************************************************************
       2230-CALCULA-PERIODO-SEGURO.

            MOVE 1                           TO WS-CONTA3

            IF NSCF-PERS NOT EQUAL CTE-20TO
               SET NO-PROCESAR-SEG-ANTI      TO TRUE
               MOVE NSCF-PERS                TO WS-PERIOD

               IF NSCF-PERS EQUAL CTE-2001
                  MOVE WS-FECSOLI            TO WS-FEULIQ
               ELSE
                  MOVE WS-FECSOLI            TO WS-FEULIQ
                  PERFORM 2240-FEPROLIQ

                  IF WS-FECHA-CALCULADA < WS-FELIQCA(1) AND
                     WS-FECHA-CALCULADA < WS-FELIQIN(1)
      *COL01-I
                     IF SW-GRACIA-SI
                      AND (WS-FECHA-CALCULADA <= WS-FECHA-FINGRACIA)
                        MOVE WS-FECHA-CALCULADA TO WS-FEULIQ
                     ELSE
                        MOVE WS-FECHA-CALCULADA TO WS-FELIQSE(WS-CONTA3)
                                                   WS-FEULIQ
                     END-IF
      *              MOVE WS-FECHA-CALCULADA TO WS-FELIQSE(WS-CONTA3)
      *                                         WS-FEULIQ
      *COL01-F
                  ELSE
                     IF WS-FELIQIN(1)< WS-FELIQCA(1)
      *COL01-I
                        IF SW-GRACIA-SI
                         AND (WS-FELIQIN(1) <= WS-FECHA-FINGRACIA)
                           MOVE WS-FELIQIN(1)   TO WS-FEULIQ
                        ELSE
                           MOVE WS-FELIQIN(1)   TO WS-FELIQSE(WS-CONTA3)
                                                   WS-FEULIQ
                        END-IF
      *                 MOVE WS-FELIQIN(1)      TO WS-FELIQSE(WS-CONTA3)
      *                                         WS-FEULIQ
      *COL01-F
                     ELSE
                        MOVE WS-FELIQCA(1)      TO WS-FELIQSE(WS-CONTA3)
                                                WS-FEULIQ
                     END-IF
                  END-IF
      *COL01-I
                 IF SW-GRACIA-NO
      *COL01-F
                  ADD  1                     TO WS-CONTA3
      *COL01-I
                 END-IF
      *COL01-F
               END-IF

                  PERFORM 2240-FEPROLIQ

                  MOVE WS-FECHA-CALCULADA       TO WS-FEPROLIQS

                  PERFORM UNTIL WS-FEPROLIQS > WS-FECHA-FIN

      *COL01-I
                     IF SW-GRACIA-SI
                      AND (WS-FEPROLIQS <= WS-FECHA-FINGRACIA)
                       CONTINUE
                     ELSE
                       MOVE WS-FEPROLIQS        TO WS-FELIQSE(WS-CONTA3)
                       ADD 1                    TO WS-CONTA3
                     END-IF

      *               MOVE WS-FEPROLIQS        TO WS-FELIQSE(WS-CONTA3)
      *
      *               ADD 1                    TO WS-CONTA3
      *COL01-F

                      MOVE WS-FEPROLIQS        TO WS-FEULIQ

                      PERFORM 2240-FEPROLIQ

                      MOVE WS-FECHA-CALCULADA   TO WS-FEPROLIQS

                  END-PERFORM
      *@COL03-I
                  MOVE WS-FEULIQ              TO WS-FEULTSEG
      *@COL03-F
            ELSE
               SET SI-PROCESAR-SEG-ANTI      TO TRUE

               IF WS-FELIQIN(1)< WS-FELIQCA(1)
                  MOVE WS-FELIQIN(1)      TO WS-FELIQSE(WS-CONTA3)
               ELSE
                  MOVE WS-FELIQCA(1)      TO WS-FELIQSE(WS-CONTA3)
               END-IF
            END-IF.

      *COL01-I
      ******************************************************************
      *               9999-FEFINGRACIA                                 *
      ******************************************************************
       9999-FEFINGRACIA.

           INITIALIZE                         URECDF3
           MOVE '201'                         TO DF3-PERCAP
           MOVE WS-FEULIQ                     TO DF3-FECHA-INICIAL
           MOVE WS-FEULIQ(9:2)                TO DF3-DIA
           MOVE WS-PLAZ-GRACIA                TO DF3-NUM-PERIODOS
           IF SW-TASPOL-SI
              MOVE WS-PLAZ-TASA               TO DF3-NUM-PERIODOS
           END-IF
           MOVE '1'                           TO DF3-TIPODIAS

           CALL  BBVA-UR8CDFP0  USING  URECRES
                                      URECDF3

           IF RES-CORESPUE NOT = '10'
              MOVE 'UGE0939'                  TO CAA-COD-ERROR
              MOVE 'ERR UR8CDFP0 GRA'         TO CAA-VAR1-ERROR
              MOVE RES-CORESPUE               TO CAA-VAR2-ERROR
              PERFORM  3-FIN-PROGRAMA
           ELSE
              MOVE  DF3-FECHA-FINAL           TO WS-FECHA-FINGRACIA
           END-IF.

      *COL01-F
      ******************************************************************
      *               2212-FEPROLIQ-CAP                                *
      ******************************************************************
       2240-FEPROLIQ.

           INITIALIZE                         URECDF3
           MOVE WS-PERIOD                     TO DF3-PERCAP
           MOVE WS-FEULIQ                     TO DF3-FECHA-INICIAL
           MOVE WS-FEULIQ(9:2)                TO DF3-DIA
           MOVE 1                             TO DF3-NUM-PERIODOS
           MOVE '1'                           TO DF3-TIPODIAS

           CALL  BBVA-UR8CDFP0  USING  URECRES
                                      URECDF3

           IF RES-CORESPUE NOT = '10'
              MOVE 'UGE0939'                  TO CAA-COD-ERROR
              MOVE 'ERR UR8CDFP0 CAP'         TO CAA-VAR1-ERROR
              MOVE RES-CORESPUE               TO CAA-VAR2-ERROR
              PERFORM  3-FIN-PROGRAMA
           ELSE
              MOVE  DF3-FECHA-FINAL           TO WS-FECHA-CALCULADA
      *@COL01-I
              IF SI-DIA-31 OR
                 SI-DIA-30 OR
                 SI-DIA-29

                 PERFORM 22401-VERIFICA-DIA
              END-IF
      *@COL01-F
           END-IF.
      *
      *@COL01-I
      ******************************************************************
      *                        22401-VERIFICA-DIA.                     *
      *    VERIFICA EL CORRIMIENTO DE DIA DE LIQUIDACION EN CASO DE    *
      *    QUE LA FECHA DE SOLICITUD SEA UN DIA 31, PARA QUE COBRE LA  *
      *    CUOTA LOS 31 O EL 30 SEGUN SEA EL MES Y EL 28 0 29 SEGUN
      *    SEA EL CASO EN EL MES DE FEBRRO
      ******************************************************************
       22401-VERIFICA-DIA.

           IF DF3-MES-FINAL NOT EQUAL 2
              IF SI-DIA-29
                 MOVE '29'              TO WS-FECHA-CALCULADA(9:2)
              ELSE
                 IF SI-DIA-30
