           END-IF

           PERFORM UNTIL SI-FIN-CAPITAL AND
                         SI-FIN-INTERES AND
                         SI-FIN-SEGURO

             MOVE WS-SALDO-NUEVO           TO WS-SALDO-ANTERIOR

             IF WS-FECIMPO EQUAL WS-FELIQCA(WS-CONTA1)
               MOVE WS-FELIQCA(WS-CONTA1)  TO WS-FECHA-CUOTA(WS-CONTA4)
               MOVE WS-AMORTIZA(WS-CONTA1) TO WS-CUOTA-AMORT(WS-CONTA4)
               ADD WS-AMORTIZA(WS-CONTA1)  TO WS-CUOTA-TOTAL(WS-CONTA4)

               MOVE WS-NUEVO-SALDO(WS-CONTA1) TO WS-SALDO-NUEVO
                                                 WS-DEUDA-PEND

               ADD 1                      TO WS-CONTA1
               ADD 1                      TO WS-CONTA6
             END-IF

             IF WS-FECIMPO EQUAL WS-FELIQIN(WS-CONTA2)
      *
      *COL01-I
      *       IF SW-NO-INTREM
      *          AND (WS-FELIQIN(WS-CONTA2) <= WS-FECHA-FINGRACIA)
      *            MOVE WS-FELIQIN(WS-CONTA2)  TO WS-FEULIQIN
      *            ADD 1 TO   WS-CONTA2
      *       ELSE
      *COL01-F
               MOVE WS-FELIQIN(WS-CONTA2)  TO WS-FECHA-CUOTA(WS-CONTA4)
                                              WS-FEPROLIQIN
      *
               MOVE WS-FEPROLIQIN(1:4)       TO W075-FHGRE2(5:4)
               MOVE WS-FEPROLIQIN(6:2)       TO W075-FHGRE2(3:2)
               MOVE WS-FEPROLIQIN(9:2)       TO W075-FHGRE2(1:2)
               MOVE WS-FEULIQIN(1:4)         TO W075-FHGRE1(5:4)
               MOVE WS-FEULIQIN(6:2)         TO W075-FHGRE1(3:2)
               MOVE WS-FEULIQIN(9:2)         TO W075-FHGRE1(1:2)
      *
               PERFORM 227A-CALCULA-DIAS
      *
               MOVE W075-NUMDIAS             TO WS-DIAS-INT
      *
               PERFORM 227B-CALCULAR-INTERESES
      *
               MOVE WS-FEPROLIQIN       TO WS-FEULIQIN
OIRT           IF WS-CONTA2 = 1 AND NSCF-OPCSUBV NOT = '3' AND
OIRT              NSCF-GRCSUBV = '1'
OIRT             IF SW-SI-INTRE
OIRT               MOVE WS-INT-FIN-SUBV-N TO WS-CUOTA-INTERES(WS-CONTA4)
OIRT               ADD  WS-INT-FIN-SUBV-N TO WS-CUOTA-TOTAL(WS-CONTA4)
OIRT             ELSE
OIRT               MOVE ZEROS             TO WS-CUOTA-INTERES(WS-CONTA4)
OIRT             END-IF
OIRT           ELSE
                   MOVE WS-IMP-INT        TO WS-CUOTA-INTERES(WS-CONTA4)
                   ADD  WS-IMP-INT        TO WS-CUOTA-TOTAL(WS-CONTA4)
      *COL05-I
                 IF WS-CUOTA-AMORT(WS-CONTA4) IS NOT = ZEROES THEN
                   COMPUTE WS-CUOTA-AMORT(WS-CONTA4) =
                           WS-CUOTA-AMORT(WS-CONTA4) - WS-IMP-INT
                   MOVE WS-AMORTIZA(WS-CONTA1) TO
                                               WS-CUOTA-TOTAL(WS-CONTA4)
                 END-IF
      *COL05-F
OIRT           END-IF

               ADD 1                      TO WS-CONTA2
      *COL01-I
      *       END-IF
      *COL01-F
             END-IF

             IF WS-FECIMPO EQUAL WS-FELIQSE(WS-CONTA3)
               IF SI-PROCESAR-SEG-ANTI
                  MOVE WS-FECHA-FIN        TO W101-ICFINIRE
                  MOVE ZEROS               TO WS-PLAZO-MESES

                  PERFORM 22111-OBTENER-PLAZO
                  PERFORM 227C-CALCULAR-SEGUROS

                  COMPUTE WS-PRIMSEGU = WS-PRIMSEGU * WS-PLAZO-MESES

                  MOVE WS-PRIMSEGU     TO WS-CUOTA-SEGURO(WS-CONTA4)
                  ADD WS-PRIMSEGU      TO WS-CUOTA-TOTAL(WS-CONTA4)

               ELSE
                MOVE WS-FELIQSE(WS-CONTA3) TO WS-FECHA-CUOTA(WS-CONTA4)
                                              W101-ICFINIRE

                PERFORM 227C-CALCULAR-SEGUROS

                IF WS-CONTA4 EQUAL 1
                   MOVE WS-FECIMPO      TO WS-FECHA-AUX
                   PERFORM 22113-DIF-FEFORMA-ULTCUO
      *@COL03-I
                   MOVE ZEROS           TO WS-SEGUANTI
                   COMPUTE WS-SEGUANTI = WS-PRIMSEGU * WS-MESES-SEG
      *@COL03-F
                   COMPUTE WS-PRIMSEGU = WS-PRIMSEGU * WS-DIF-MESES
      *@COL03-I
                   IF NSCF-PERS  NOT EQUAL '2001'
                      ADD WS-SEGUANTI      TO WS-PRIMSEGU
                   END-IF
      *@COL03-F
                   MOVE WS-PRIMSEGU     TO WS-CUOTA-SEGURO(WS-CONTA4)
                   ADD WS-PRIMSEGU      TO WS-CUOTA-TOTAL(WS-CONTA4)
                ELSE
      *@COL03-I
                   IF NSCF-PERS  NOT EQUAL '2001'
                      IF WS-FEULTSEG EQUAL WS-FECIMPO
                        IF WS-FECIMPO EQUAL WS-FECHA-FIN
                           MOVE ZERO               TO WS-PRIMSEGU
