           IF WS-FELIQIN(WS-CONTA2) NOT EQUAL SPACES
             IF WS-FECIMPO > WS-FELIQIN(WS-CONTA2)
                MOVE WS-FELIQIN(WS-CONTA2) TO WS-FECIMPO
             END-IF
           END-IF

           IF WS-FELIQSE(WS-CONTA3) NOT EQUAL SPACES
             IF WS-FECIMPO > WS-FELIQSE(WS-CONTA3)
                MOVE WS-FELIQSE(WS-CONTA3) TO WS-FECIMPO
             END-IF
           END-IF

           IF NO-PROCESAR-SEG-ANTI
