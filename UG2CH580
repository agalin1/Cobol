       263-VALIDA-REG-LOG.
           INITIALIZE UGTCLOG
           MOVE MAE-ENTIOFI        TO LOG-ENTIOFI
           MOVE MAE-CUENTA         TO LOG-CUENTA
           MOVE 'VCAR'             TO LOG-CODIGO
           EXEC SQL
              SELECT LOG_CODIGO
              INTO  :LOG-CODIGO
              FROM
              UGDTLOG
              WHERE LOG_ENTIOFI = :LOG-ENTIOFI
              AND   LOG_CUENTA  = :LOG-CUENTA
              AND   LOG_CODIGO  = :LOG-CODIGO
           END-EXEC
           MOVE SQLCODE                     TO DB2-RETURN-CDE
           IF DB2-OK AND SQLWARN0 = SPACES
                     MOVE 'UGE0939'              TO CAA-COD-ERROR
                     MOVE 'REGISTRO YA EXISTE '  TO CAA-VAR1-ERROR
                     MOVE 'EN UGLOG VCAR      '  TO CAA-VAR2-ERROR
                     PERFORM 999999-ROLLBACK
                     PERFORM 3-FINAL-PROGRAMA
           ELSE
              IF DB2-NOTFND
                    CONTINUE
              ELSE
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'ERR SELECT UGDTLOG'   TO CAA-VAR1-ERROR
                    MOVE 'SQLCODE '             TO CAA-VAR2-ERROR(1:8)
                    MOVE SQLCODE                TO CAA-VAR2-ERROR(9:)
                    PERFORM 999999-ROLLBACK
                    PERFORM 999999-ABEND-DB2
                    PERFORM 3-FINAL-PROGRAMA
