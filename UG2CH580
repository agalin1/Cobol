              SELECT IMP11
                INTO :REV-IMP11
              FROM UGDTREV
              WHERE ENTIOFI = :REV-ENTIOFI
                AND CUENTA  = :REV-CUENTA
                AND PROCESO = :REV-PROCESO
           END-EXEC
      *
           MOVE SQLCODE                  TO DB2-RETURN-CDE
      *
           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
              MOVE 'UGE0939'                    TO CAA-COD-ERROR
              MOVE 'ERR SELECT UGDTREV'         TO CAA-VAR1-ERROR
              MOVE 'SQLCODE '                   TO CAA-VAR2-ERROR(1:8)
              MOVE SQLCODE                      TO CAA-VAR2-ERROR(9:)
      *@COL12A-I
              PERFORM 999999-ROLLBACK
      *@COL12A-F
              PERFORM 999999-ABEND-DB2
              PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
           IF REV-IMP11 <= 0
              IF MAE-CCC-VIN NOT = SPACES OR LOW-VALUES
                 PERFORM ABONO-VINCULADA
              ELSE
                 MOVE 'UGE0939'                 TO CAA-COD-ERROR
                 MOVE 'SOBRANTE SIN  '          TO CAA-VAR1-ERROR
                 MOVE 'CTA VINCULADA'           TO CAA-VAR2-ERROR
      *@COL12A-I
                 PERFORM 999999-ROLLBACK
      *@COL12A-F
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           ELSE
              IF REV-IMP11 < WS-DISPO-POS-PAGO
                 COMPUTE WS-DISPO-POS-PAGO =
                                       WS-DISPO-POS-PAGO  - REV-IMP11
                 IF MAE-CCC-VIN NOT = SPACES OR LOW-VALUES
                    PERFORM ABONO-VINCULADA
                 ELSE
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'SOBRANTE SIN  '       TO CAA-VAR1-ERROR
                    MOVE 'CTA VINCULADA'        TO CAA-VAR2-ERROR
      *@COL12A-I
                    PERFORM 999999-ROLLBACK
      *@COL12A-F
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
