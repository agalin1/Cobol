      *COL12-F
      *COL19-I
      ******************************************************************
      * 2122-VALIDA-FLEXIBLE                                           *
      *                                                                *
      * VALIDA SI EL PRODUCTO ES CONSUMO FLEXIBLE                      *
      *                                                                *
      ******************************************************************
       2122-VALIDA-FLEXIBLE.
      *
           INITIALIZE                              UGTCT37
           MOVE MAE-SUBPRO                       TO T37-ELEMENTO
           MOVE '9086'                           TO T37-SECCION
           EXEC SQL
              SELECT RESTO
              INTO :T37-RESTO
              FROM
              UGDTT37
              WHERE ELEMENTO = :T37-ELEMENTO
              AND   SECCION  = :T37-SECCION
           END-EXEC
           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              MOVE 'UGE0939'              TO CAA-COD-ERROR
              MOVE 'SUBPRODUCTO NO PUEDE' TO CAA-VAR1-ERROR
              MOVE 'SER CONSUMO FLEXIBLE' TO CAA-VAR2-ERROR
              PERFORM 999999-ROLLBACK
              PERFORM  3-FINAL-PROGRAMA
           ELSE
              IF DB2-NOTFND
                 CONTINUE
              ELSE
                    MOVE 'UGDTT37'               TO CAA-COD-ERROR
                    MOVE 'SECCION'               TO CAA-VAR2-ERROR
                    MOVE T37-SECCION             TO CAA-VAR2-ERROR(8:4)
                    MOVE 'ELEMENTO'              TO CAA-VAR2-ERROR(9:8)
                    MOVE T37-ELEMENTO            TO CAA-VAR2-ERROR(17:4)
                    PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *COL19-F
      *
      *COL21-I
      ******************************************************************
      *                   5000-CREDITOS POR LIBRANZAS                  *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO DE VALIDACION DE CREDITOS POR LIBRANZA CON       *
      * AUTORIZACION REMOTA.                                           *
      ******************************************************************
       5000-CREDITOS-POR-LIBRANZAS.

            PERFORM 5100-CONSULTA-UMTA-MAX-VEN
            PERFORM 5200-CONSULTA-REC
            PERFORM 5300-CONSULTA-UMTA-NUM-CUOTA
            PERFORM 5400-CONSULTA-CUOTA
      *COL29-I
            PERFORM 5310-CONSULTA-LOG
      *COL29-F
            PERFORM 5500-AUTORIZACION-REMOTA.
      *
      ******************************************************************
      *                  5100-CONSULTA-UMTA-MAX-VEN.                   *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO PARA CONSULTAR MAXIMO NUMERO DE CUOTAS VENCIDAS  *
      * EN TA TABLA UGDTT37.                                           *
      ******************************************************************
       5100-CONSULTA-UMTA-MAX-VEN.

           INITIALIZE UGTCT37
           MOVE '9119'      TO T37-SECCION
           MOVE '02'        TO T37-ELEMENTO

           EXEC SQL
                SELECT RESTO
                INTO :T37-RESTO
                FROM UGDTT37
                WHERE SECCION = :T37-SECCION AND
                      ELEMENTO = :T37-ELEMENTO
           END-EXEC.

           MOVE SQLCODE                      TO DB2-RETURN-CDE

           IF DB2-OK
              MOVE T37-RESTO(1:3)            TO WS-MAX-VENCIDAS
           ELSE
              IF DB2-NOTFND
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'NUMERO DE CUOTA NO  '  TO CAA-VAR1-ERROR
                 MOVE 'ENCONTRADA - UGDTT37'  TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UGE0939'                TO CAA-COD-ERROR
                 MOVE 'ERR SELECT UGDTT37'     TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '               TO CAA-VAR2-ERROR(1:8)
                 MOVE SQLCODE                  TO CAA-VAR2-ERROR(9:)
                 PERFORM 999999-ROLLBACK
                 PERFORM 999999-ABEND-DB2
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      *
      ******************************************************************
      *                       5200-CONSULTA-REC                        *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO PARA CONSULTAR EL NUMERO DE RECIBOS VENCIDOS ME- *
      * DIANTE CURSORES                                                *
      ******************************************************************
       5200-CONSULTA-REC.

            PERFORM 5270-ABRIR-CURSOR-REC
            PERFORM 5280-FETCH-CURSOR-REC UNTIL SI-FIN-CURSOR-REC
            IF SI-FIN-CURSOR-REC
               PERFORM 5290-CERRAR-CURSOR-REC
            END-IF.
      *
      ******************************************************************
      *                       5270-ABRIR-CURSOR-REC                    *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO PARA CONSULTAR EL NUMERO DE RECIBOS VENCIDOS ME- *
      * DIANTE CURSORES                                                *
      ******************************************************************
       5270-ABRIR-CURSOR-REC.

              INITIALIZE UGTCREC

              MOVE MAE-ENTIOFI                  TO REC-ENTIOFI
              MOVE MAE-CUENTA                   TO REC-CUENTA
              MOVE CAA-FECHA-OPER2              TO REC-FEULPROV
      *
              EXEC SQL
                   OPEN CURSOR-REC
              END-EXEC
      *
              MOVE SQLCODE                      TO DB2-RETURN-CDE

              IF NOT DB2-OK
                  MOVE 'UGE0939'               TO CAA-COD-ERROR
                  MOVE 'ERROR OPEN CURS-REC'   TO CAA-VAR1-ERROR
                  MOVE 'COD ERROR: '           TO CAA-VAR2-ERROR(1:12)
                  MOVE DB2-RETURN-CDE          TO CAA-VAR2-ERROR(13:)
                  PERFORM 999999-ABEND-DB2
                  PERFORM 3-FINAL-PROGRAMA
              END-IF.
      *
      ******************************************************************
      *                    5280-FETCH-CURSOR-REC.                      *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO PARA CONSULTAR EL NUMERO DE RECIBOS VENCIDOS ME- *
      * DIANTE CURSORES                                                *
      ******************************************************************
       5280-FETCH-CURSOR-REC.

           EXEC SQL
                FETCH CURSOR-REC
                INTO :REC-ENTIOFI,
                     :REC-CUENTA
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
           IF DB2-OK
                 ADD 1                        TO W-CONT-REC
           ELSE
              IF DB2-NOTFND
                 SET SI-FIN-CURSOR-REC       TO TRUE
              ELSE
                 MOVE 'UGE0939'                TO CAA-COD-ERROR
                 MOVE 'ERROR LEER CURSOR-REC'  TO CAA-VAR1-ERROR
                 MOVE 'COD ERROR: '            TO CAA-VAR2-ERROR(1:12)
                 MOVE DB2-RETURN-CDE           TO CAA-VAR2-ERROR(13:)
                 PERFORM 999999-ABEND-DB2
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      *
      ******************************************************************
      *                       5290-CERRAR-CURSOR                       *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO PARA CONSULTAR EL NUMERO DE RECIBOS VENCIDOS ME- *
      * DIANTE CURSORES                                                *
      ******************************************************************
       5290-CERRAR-CURSOR-REC.
      *
            EXEC SQL
                 CLOSE CURSOR-REC
            END-EXEC.
      *
            MOVE SQLCODE       TO DB2-RETURN-CDE
            IF NOT DB2-OK
               MOVE 'UGE0939'                TO CAA-COD-ERROR
               MOVE 'ERROR CLOSE CURSOR-REC' TO CAA-VAR1-ERROR
               MOVE 'COD ERROR: '            TO CAA-VAR2-ERROR(1:12)
               MOVE DB2-RETURN-CDE           TO CAA-VAR2-ERROR(13:)
               PERFORM 999999-ABEND-DB2
            END-IF.
      *
      ******************************************************************
      *                  5300-CONSULTA-UMTA-NUM-CUOTA                  *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO PARA CONSULTAR EL NUMERO DE CUOTAS EN LA TABLA   *
      * UGDTT37                                                        *
      ******************************************************************
       5300-CONSULTA-UMTA-NUM-CUOTA.

           INITIALIZE UGTCT37
           MOVE '9119'      TO T37-SECCION
           MOVE '01'        TO T37-ELEMENTO

           EXEC SQL
                SELECT RESTO
                INTO :T37-RESTO
                FROM UGDTT37
                WHERE SECCION = :T37-SECCION AND
                      ELEMENTO = :T37-ELEMENTO
           END-EXEC.

           MOVE SQLCODE                      TO DB2-RETURN-CDE

           IF DB2-OK
              MOVE T37-RESTO(1:3)            TO WS-CUOTA-UMBRAL
           ELSE
              IF DB2-NOTFND
                 MOVE 'UGE0939'               TO CAA-COD-ERROR
                 MOVE 'NUMERO DE CUOTA NO  '  TO CAA-VAR1-ERROR
                 MOVE 'ENCONTRADA - UGDTT37'  TO CAA-VAR2-ERROR
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              ELSE
                 MOVE 'UGE0939'                TO CAA-COD-ERROR
                 MOVE 'ERR SELECT UGDTT37'     TO CAA-VAR1-ERROR
                 MOVE 'SQLCODE '               TO CAA-VAR2-ERROR(1:8)
                 MOVE SQLCODE                  TO CAA-VAR2-ERROR(9:)

                 PERFORM 999999-ROLLBACK
                 PERFORM 999999-ABEND-DB2
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           END-IF.
      *
      ******************************************************************
      *                     5400-CONSULTA-CUOTA.                       *
      *----------------------------------------------------------------*
      * PROCEDIMIENTO DE VALIDACION DE CREDITOS POR LIBRANZA CON       *
