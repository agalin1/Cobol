                                                 AUTF-IMPORTE1
           MOVE ZEROS                         TO QGEC0010-IMPORTE2
      *
           EXEC CICS
                LINK PROGRAM('QG7C0010')
                COMMAREA (QGEC0010-AREA)
                NOHANDLE
           END-EXEC
      *
           EVALUATE QGEC0010-CODRETORN
              WHEN '1'
                 CONTINUE
              WHEN '2'
                 MOVE 'UGE0011'  TO CAA-COD-ERROR
      *@COL12A-I
                 PERFORM 999999-ROLLBACK
      *@COL12A-F
                 PERFORM  3-FINAL-PROGRAMA
              WHEN '3'
                 IF CAA-CODERR-AUT(WS-IND) NOT = 'UGE3430'
                    PERFORM  PEDIR-AUTORIZACION
                    PERFORM  3-FINAL-PROGRAMA
                 END-IF
              WHEN '4'
                 MOVE 'UGE1583'               TO CAA-COD-ERROR
                 MOVE ' 4 '                   TO CAA-VAR1-ERROR
                 MOVE 'QG7C0010'              TO CAA-VAR2-ERROR
      *@COL12A-I
                 PERFORM 999999-ROLLBACK
      *@COL12A-F
                 PERFORM  3-FINAL-PROGRAMA
              WHEN OTHER
                 MOVE 'UGE2056'               TO CAA-COD-ERROR
      *@COL12A-I
                 PERFORM 999999-ROLLBACK
      *@COL12A-F
                 PERFORM  3-FINAL-PROGRAMA
           END-EVALUATE.
      *
           EJECT.
      *
      ******************************************************************
      *              PEDIR-AUTORIZACION                                *
      *----------------------------------------------------------------*
      *   RUTINA DE ACCESO A 'PEDIR-AUTORIZACION'                      *
      *                                                                *
      ******************************************************************
       PEDIR-AUTORIZACION.
      *
           MOVE EIBTRMID                      TO AUTF-TERMINAL
           MOVE 'UG'                          TO AUTF-CODAPLIC
           MOVE QGEC0010-SUBCLV               TO AUTF-SUBCLV
           MOVE WS-CCC                        TO AUTF-NUMCTA
           MOVE ZEROES                        TO AUTF-NUMCLIEN
           MOVE ZEROES                        TO AUTF-CENVAR
           MOVE QGEC0010-DIVISA               TO AUTF-DIVISA
           MOVE ZEROS                         TO AUTF-IMPORTE2
           MOVE SPACES                        TO AUTF-UGEST
           MOVE SPACES                        TO AUTF-AUXILIAR
      *
           EXEC CICS
              LINK
              PROGRAM ('QR1CWTS')
              COMMAREA (QCECAUTF)
              NOHANDLE
           END-EXEC
      *
           IF EIBRESP  EQUAL DFHRESP(NORMAL)
              PERFORM 999999-ROLLBACK
              EVALUATE  TRUE
                 WHEN AUTF-88-RETORN-OK
                    IF QGEC0010-CLVFUNC EQUAL 'U122'
                       MOVE 'UGE3430'         TO CAA-COD-ERROR
                                                 CAA-CODERR-AUT(WS-IND)
                    END-IF

                    MOVE QGEC0010-IMPORTE1    TO CAA-IMPORTE-AUTO
                    SET CAA-88-IND-AUTO-SI    TO TRUE
                 WHEN AUTF-88-FALTA-DATO
                    MOVE 'UGE2071'            TO CAA-COD-ERROR
                 WHEN AUTF-88-ABEND-RUTI
                    MOVE AUTF-ERROR-CODE      TO CAA-COD-ERROR
                    MOVE AUTF-VAR1-ERROR      TO CAA-VAR1-ERROR
              END-EVALUATE
           ELSE
              MOVE 'ERROR LINK QR1CWTS'       TO CAA-VAR1-ERROR
              PERFORM 999999-ABEND-CICS
           END-IF.
      *
           EJECT.
      *
      *****************************************************************
      *                  2114-INSERTA-UGDTLOG.
      *****************************************************************
       2114-INSERTA-UGDTLOG.
           MOVE MAE-ENTIOFI              TO LOG-ENTIOFI
           MOVE MAE-CUENTA               TO LOG-CUENTA
           MOVE 'UH58'                   TO LOG-CODIGO
           MOVE '0001-01-01'             TO LOG-FECANT
           MOVE '0001-01-01'             TO LOG-FECNUE
           MOVE CAA-FECHA-OPER2          TO LOG-FECMOV
           MOVE WS-TOTAL                 TO LOG-IMPANT
           MOVE 'UGDTLOG'                TO LOG-TABLA
           MOVE 'AUTORIZACION USUARIOS'
                                         TO LOG-DESCRIPCION
           MOVE MAE-SUBPRO               TO LOG-DESCRIPCION(22:4)
           MOVE WS-NUMCLIEN              TO LOG-DESCRIPCION(26:8)
           MOVE CAA-ENTIDAD              TO LOG-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT          TO LOG-CENTRO-UMO
           IF CUA-USERID-AUT(1) NOT EQUAL SPACES AND
                                             LOW-VALUES
              MOVE CUA-USERID-AUT(1)     TO LOG-USERID-UMO
           ELSE
              MOVE CAA-USERID            TO LOG-USERID-UMO
           END-IF
           MOVE CAA-NETNAME              TO LOG-NETNAME-UMO

      *
            EXEC SQL
                INSERT INTO UGDTLOG (LOG_ENTIOFI,
                   LOG_CUENTA, LOG_TIMESTAMP,
                   LOG_CODIGO, LOG_FECMOV,
                   LOG_FECANT, LOG_IMPANT,
                   LOG_TABLA,
                   LOG_DESCRIPCION,
                   LOG_ENTIDAD_UMO, LOG_CENTRO_UMO,
                   LOG_USERID_UMO, LOG_NETNAME_UMO)

                VALUES (:LOG-ENTIOFI,:LOG-CUENTA,
                   CURRENT TIMESTAMP, :LOG-CODIGO,
                  :LOG-FECMOV,
                  :LOG-FECANT, :LOG-IMPANT,
                  :LOG-TABLA,
                  :LOG-DESCRIPCION, :LOG-ENTIDAD-UMO,
                  :LOG-CENTRO-UMO, :LOG-USERID-UMO,
                  :LOG-NETNAME-UMO)
             END-EXEC
      *
               MOVE SQLCODE                        TO DB2-RETURN-CDE
