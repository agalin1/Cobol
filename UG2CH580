      *
      ******************************************************************
      *              224-TRATAMIENTO-CHEQUE                            *
      *----------------------------------------------------------------*
      *     - TRATAMIENTO SALVO BUEN COBRO                             *
      *     PRIMERO VERIFICAMOS QUE EL CHEQUE NO ESTE EN LA SBC EN ESTA*
      *     DO TR O EF
      *     SBC-CAMPO-LIBRE1 VA A TENER EL NUMERO DE BANDA CAPTURADO
      ******************************************************************
       224-TRATAMIENTO-CHEQUE.
      *
      *CONSULTA
            INITIALIZE UGVCSBC0
            MOVE WS-CCC-ENTIOFI          TO SBC-ENTIOFI
            MOVE WS-CCC-CUENTA           TO SBC-CUENTA
      *@COL01-1-I
      *     MOVE '00'                    TO SBC-NUM-BANCO(1:2)
      *     MOVE WS-BANCO-EMIS           TO SBC-NUM-BANCO(3:4)
            MOVE '000'                   TO SBC-NUM-BANCO(1:3)
            MOVE WS-BANCO-EMIS(2:3)      TO SBC-NUM-BANCO(4:3)
      *@COL01-1-F
            MOVE WS-NUM-CHEQ             TO SBC-NUM-CHEQUE
            MOVE WS-NUM-CTA              TO SBC-NUM-CTACHEQ
            MOVE WS-PLAZA                TO SBC-PLAZA
      *@COL12-I
            IF WS-PROPIO-SI
               MOVE CAA-FECHA-OPER2      TO WS-FECHA-CAMARA
            END-IF
      *@COL12-F
      *
            EXEC SQL
               SELECT NUM_BANCO     ,
                      CAMPO_LIBRE1  ,
                      FECHA_OPER    ,
                      IMPORTE       ,
                      ESTADO        ,
                      PLAZA
               INTO   :SBC-NUM-BANCO     ,
                      :SBC-CAMPO-LIBRE1  ,
                      :SBC-FECHA-OPER    ,
                      :SBC-IMPORTE       ,
                      :SBC-ESTADO        ,
                      :SBC-PLAZA
               FROM UGDVSBC0
               WHERE ENTIOFI     = :SBC-ENTIOFI
                 AND CUENTA      = :SBC-CUENTA
                 AND NUM_BANCO   = :SBC-NUM-BANCO
                 AND NUM_CHEQUE  = :SBC-NUM-CHEQUE
                 AND NUM_CTACHEQ = :SBC-NUM-CTACHEQ
                 AND PLAZA       = :SBC-PLAZA
                 AND (ESTADO     = 'TR' OR
                      ESTADO     = 'EF')
            END-EXEC

            MOVE SQLCODE                 TO DB2-RETURN-CDE
      *
            IF DB2-OK AND SQLWARN0 = SPACES
               MOVE 'UGE0939'            TO    CAA-COD-ERROR
               MOVE 'CREDITO DUPLICADO ' TO    CAA-VAR1-ERROR
               MOVE SBC-ENTIOFI          TO    CAA-VAR2-ERROR(1:8)
               MOVE SBC-CUENTA           TO    CAA-VAR2-ERROR(9:10)
               PERFORM 999999-ROLLBACK
               PERFORM 3-FINAL-PROGRAMA
            ELSE
               IF DB2-NOTFND AND SQLWARN0 = SPACES
                 CONTINUE
               ELSE
                 MOVE 'UGDTSBC'          TO ABC-OBJETO-ERROR
                 MOVE 'SELECT'           TO ABC-REFERENCIA
                 PERFORM 999999-ABEND-DB2
               END-IF
            END-IF
      *@COL01-I
           PERFORM 224B-TRATAMIENTO-CHEQUE
      *@COL01-F
      *
      *INSERCION
           INITIALIZE UGVCCHQ0-01
      *
           MOVE '02'                     TO CHQ-OPCION
           MOVE WS-CCC-ENTIOFI           TO CHQ-ENTIOFI
           MOVE WS-CCC-CUENTA            TO CHQ-CUENTA
           MOVE WS-NUM-OPER              TO CHQ-NRO-OPER
           MOVE CTE-DIVISA               TO CHQ-DIVISA
           MOVE CTE-CANAL-TF             TO CHQ-CANAL
           MOVE WS-FECHA-CAMARA          TO CHQ-FECHA-OPER
                                            CHQ-FECHA-CONTA

           MOVE CTE-PROGRAMA             TO CHQ-NETNAME-UMO
      *
      *@COL01-1-I
      *    MOVE '00'                     TO CHQ-NUM-BANCO(1:2)
      *    MOVE WS-BANCO-EMIS            TO CHQ-NUM-BANCO(3:4)
           MOVE '000'                    TO CHQ-NUM-BANCO(1:3)
           MOVE WS-BANCO-EMIS(2:3)       TO CHQ-NUM-BANCO(4:3)
      *@COL01-1-F
           MOVE WS-NUM-CHEQ              TO CHQ-NUM-CHEQUE
           MOVE WS-NUM-CTA               TO CHQ-NUM-CTACHEQ
      * PARA TENER EL NUEMERO CAPTURADO DE LA BANDA CTA/CHEQ
           MOVE WS-CTA-CHEQ              TO CHQ-NUM-CTACHEQ-N
           MOVE WS-PLAZA                 TO CHQ-PLAZA
           MOVE WS-IMPORTE-PAG(WS-IND)   TO CHQ-IMPORTE
           MOVE UH580-OPCION(WS-IND)     TO CHQ-FILLER(5:1)
           MOVE UH580-IMPORTE-CH         TO CHQ-FILLER(6:16)
           MOVE CTE-S                    TO CHQ-FILLER(22:1)
           MOVE WS-CCC1                  TO CHQ-FILLER(23:20)
      *
           CALL BBVA-UR9CCHQ0
                           USING UGVCCHQ0-01
      *
           IF CHQ-RET-CODIGO NOT = CTE-CON-ALFA-00
              IF CHQ-RET-CODIGO = '99'
                MOVE 'UGE0939'             TO CAA-COD-ERROR
                MOVE 'ER DB2 UR9CCHQ0:'    TO CAA-VAR1-ERROR
                MOVE CHQ-RET-SQLCODE       TO CAA-VAR1-ERROR(17:)
                MOVE CHQ-RET-VAR1-ERROR    TO CAA-VAR2-ERROR
              ELSE
                MOVE CHQ-RET-COD-ERROR     TO CAA-COD-ERROR
                MOVE CHQ-RET-VAR1-ERROR    TO CAA-VAR1-ERROR
                MOVE CHQ-RET-VAR2-ERROR    TO CAA-VAR2-ERROR
              END-IF
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
      *COL12-I
      *    END-IF.
           END-IF
           IF WS-PROPIO-SI
      * SI EL CHEQUE ES PROPIO NO ES NECESARIO PROCESARLO EN EL BATCH
      * POR LO QUE SE REALIZA SU LIBERACION INMEDIATAMENTE
               SET CHQ-LIBERACION              TO TRUE
               CALL BBVA-UR9CCHQ0 USING UGVCCHQ0-01
               IF CHQ-RET-CODIGO NOT = CTE-CON-ALFA-00
                   IF CHQ-RET-CODIGO = '99'
                       MOVE 'UGE0939'          TO CAA-COD-ERROR
                       MOVE 'ER DB2 UR9CCHQ0:' TO CAA-VAR1-ERROR
                       MOVE CHQ-RET-SQLCODE    TO CAA-VAR1-ERROR(17:)
                       MOVE CHQ-RET-VAR1-ERROR TO CAA-VAR2-ERROR
                   ELSE
                       MOVE CHQ-RET-COD-ERROR  TO CAA-COD-ERROR
                       MOVE CHQ-RET-VAR1-ERROR TO CAA-VAR1-ERROR
                       MOVE CHQ-RET-VAR2-ERROR TO CAA-VAR2-ERROR
                   END-IF
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
               END-IF
           END-IF.
      *COL12-F
      *
      *@COL01-I
      ******************************************************************
      *              224B-TRATAMIENTO-CHEQUE                           *
      *----------------------------------------------------------------*
      *     - TRATAMIENTO SALVO BUEN COBRO                             *
      *     PRIMERO VERIFICAMOS QUE EL CHEQUE NO ESTE EN LA SBC EN ESTA*
      *     DO TR O EF
      *     SBC-CAMPO-LIBRE1 VA A TENER EL NUMERO DE BANDA CAPTURADO
      ******************************************************************
       224B-TRATAMIENTO-CHEQUE.
      *
      *CONSULTA
            INITIALIZE UGVCSBC0
            MOVE WS-CCC-ENTIOFI          TO SBC-ENTIOFI
            MOVE WS-CCC-CUENTA           TO SBC-CUENTA
            MOVE '000'                   TO SBC-NUM-BANCO(1:3)
            MOVE WS-BANCO-EMIS(2:3)      TO SBC-NUM-BANCO(4:3)
            MOVE WS-NUM-CHEQ             TO SBC-NUM-CHEQUE
            MOVE WS-PLAZA                TO SBC-PLAZA
      *
            EXEC SQL
               SELECT NUM_BANCO     ,
                      CAMPO_LIBRE1  ,
                      FECHA_OPER    ,
                      IMPORTE       ,
                      ESTADO        ,
                      PLAZA
               INTO   :SBC-NUM-BANCO     ,
                      :SBC-CAMPO-LIBRE1  ,
                      :SBC-FECHA-OPER    ,
                      :SBC-IMPORTE       ,
                      :SBC-ESTADO        ,
                      :SBC-PLAZA
               FROM UGDVSBC0
               WHERE ENTIOFI     = :SBC-ENTIOFI
                 AND CUENTA      = :SBC-CUENTA
                 AND NUM_BANCO   = :SBC-NUM-BANCO
                 AND NUM_CHEQUE  = :SBC-NUM-CHEQUE
                 AND PLAZA       = :SBC-PLAZA
                 AND FECHA_OPER  = :WS-FECHA-CAMARA
                 AND (ESTADO     = 'TR' OR
                      ESTADO     = 'EF')
            END-EXEC

            MOVE SQLCODE                 TO DB2-RETURN-CDE
      *
            IF DB2-OK AND SQLWARN0 = SPACES
               MOVE 'UGE0939'               TO CAA-COD-ERROR
               MOVE  SBC-CAMPO-LIBRE1       TO CAA-VAR1-ERROR
               MOVE 'CHE-DUPLICADO ANULAR'  TO CAA-VAR2-ERROR
               PERFORM 999999-ROLLBACK
               PERFORM 3-FINAL-PROGRAMA
            ELSE
               IF DB2-NOTFND AND SQLWARN0 = SPACES
                 CONTINUE
               ELSE
                 MOVE 'UGDTSBC'          TO ABC-OBJETO-ERROR
                 MOVE 'SELECT'           TO ABC-REFERENCIA
                 PERFORM 999999-ABEND-DB2
               END-IF
            END-IF.
      *@COL01-F
      *
      ******************************************************************
      *              225-INSERTA-MOV                                   *
