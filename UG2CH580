      *
           MOVE MAE-ENTIOFI                 TO LOG-ENTIOFI
           MOVE MAE-CUENTA                  TO LOG-CUENTA
           MOVE 'DLIC'                      TO LOG-CODIGO
      *
           EXEC SQL
              SELECT LOG_IMPNUE,
                     LOG_IMPANT,
                     LOG_TASA_NUE,
                     LOG_FECANT,
                     LOG_FECNUE,
                     LOG_CONSOPE
               INTO :LOG-IMPNUE,
                    :LOG-IMPANT,
                    :LOG-TASA-NUE,
                    :LOG-FECANT,
                    :LOG-FECNUE,
                    :LOG-CONSOPE
                FROM UGDTLOG
               WHERE LOG_ENTIOFI = :LOG-ENTIOFI
                 AND LOG_CUENTA  = :LOG-CUENTA
                 AND LOG_CODIGO  = :LOG-CODIGO
