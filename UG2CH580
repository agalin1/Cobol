                 IF TABG-RESPAG-JUR = 'C'
      *@COL03-F
                    IF WS-IMPORTE-PAG(WS-IND) <  ( WS-CHQ-VS-DEUDA +
                                                   TABG-VRTAL-PRE  +
                                                   TABG-VRTAL-JUR )
                       MOVE WS-IMPORTE-PAG(WS-IND)     TO ABH-IMPORTE
                    ELSE
                       COMPUTE ABH-IMPORTE    = WS-CHQ-VS-DEUDA +
                                                TABG-VRTAL-PRE  +
                                                TABG-VRTAL-JUR
                    END-IF
      *@COL03-I
                 ELSE
                    IF WS-IMPORTE-PAG(WS-IND) < ( WS-CHQ-VS-DEUDA +
                                                  TABG-VRTAL-PRE  )
                       MOVE WS-IMPORTE-PAG(WS-IND) TO ABH-IMPORTE
                    ELSE
                       COMPUTE ABH-IMPORTE    = WS-CHQ-VS-DEUDA +
                                                TABG-VRTAL-PRE
                    END-IF
                 END-IF
              ELSE
                 IF TABG-RESPAG-JUR = 'C'
                    IF WS-IMPORTE-PAG(WS-IND) < ( WS-CHQ-VS-DEUDA +
                                                  TABG-VRTAL-JUR  )
                       MOVE WS-IMPORTE-PAG(WS-IND)   TO ABH-IMPORTE
                    ELSE
                       COMPUTE ABH-IMPORTE    = WS-CHQ-VS-DEUDA +
                                                TABG-VRTAL-JUR
                    END-IF
                 ELSE
                    IF WS-IMPORTE-PAG(WS-IND) < WS-CHQ-VS-DEUDA
                       MOVE WS-IMPORTE-PAG(WS-IND)   TO ABH-IMPORTE
                    ELSE
                       COMPUTE ABH-IMPORTE    = WS-CHQ-VS-DEUDA
                    END-IF
                 END-IF
              END-IF
      *@COL03-F
           END-IF.
      *
           IF WS-TIPO-GESTION = 'P' OR WS-TIPO-GESTION = 'E'
              MOVE TABG-HONO-PRE            TO ABH-HONOR-SINIVA
              MOVE TABG-VRIVA-PRE           TO ABH-HONOR-IVA
              MOVE TABG-VRTAL-PRE           TO ABH-TOTAL-HONORIVA
           ELSE
              IF WS-TIPO-GESTION = 'J' OR WS-TIPO-GESTION = 'D'
                 MOVE TABG-HONO-JUR         TO ABH-HONOR-SINIVA
                 MOVE TABG-VRIVA-JUR        TO ABH-HONOR-IVA
                 MOVE TABG-VRTAL-JUR        TO ABH-TOTAL-HONORIVA
              END-IF
           END-IF
           MOVE  ZEROS                   TO ABH-VAL-IMPORTE
           MOVE SW-ABONO-MIR-ABO         TO ABH-ESTADO

           IF SW-ABONO-MIR-ABO  = 'N'
              IF MIR-COD-ERROR-DEV EQUAL  LOW-VALUES
      *@COL03-I
                 OR MIR-COD-ERROR-DEV EQUAL SPACES
      *@COL03-F
                 MOVE SPACES             TO MIR-COD-ERROR-DEV
              ELSE
                 MOVE MIR-COD-ERROR-DEV  TO ABH-CODERROR
              END-IF
           ELSE
              MOVE SPACES                TO ABH-CODERROR
           END-IF
      *
           MOVE MIR-NUM-RETEN            TO WS-MIR-NUM-RETE
      *
           MOVE WS-NUM-OPER              TO WS-NUM-OPER-NUM
           MOVE WS-NUM-OPER-NUM          TO WS-NUM-OPER-ALF
      *
           MOVE WS-NUM-OPER-ALF          TO ABH-DESCRIPCION(1:8)
           MOVE 'NRO RET MIR:'           TO ABH-DESCRIPCION(9:12)
           MOVE WS-MIR-NUM-RETE-R        TO ABH-DESCRIPCION(21:5)

      * SE MANDA R PORQUE SE DEJA ESE VALOR RETENIDO (NO DISPOBIBLE) EN
      * LA CUENTA DEL ABOGADO
           MOVE  'R'                     TO ABH-TIPOPAG
           IF MIR-DIASVAL-RET-9 EQUAL ZEROS  OR
              MIR-DIASVAL-RET-9 EQUAL LOW-VALUES
              MOVE ZEROS                 TO ABH-VAL-TASA
           ELSE
              MOVE MIR-DIASVAL-RET-9     TO ABH-VAL-TASA
           END-IF
      * SE MANDA P PORQUE SE DEJA PENDIENTE PARA IMPRIMIR
           MOVE 'P'                      TO ABH-IND-PROCESO
      *
           MOVE WS-TIPO-GESTION          TO ABH-TIPOGES
      *
           MOVE SPACES                   TO ABH-IND-BAJA
           MOVE CAA-ENTIDAD              TO ABH-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT          TO ABH-CENTRO-UMO
           MOVE CAA-USERID               TO ABH-USERID-UMO
           MOVE 'UH58    '               TO ABH-NETNAME-UMO

           PERFORM 2412-INSERT-UGDTABH.
      *
      ******************************************************************
      *                  2412-INSERT-UGDTABH
      ******************************************************************
        2412-INSERT-UGDTABH.
      *
             EXEC SQL  INSERT
                 INTO  UGDTABH
                      (TIPOID       ,        NUMID        ,
                       DIGI_ID ,             IND_PROCESO ,
                       FECMOV       ,        CONSEC       ,
                       FECMOD,               IND_BAJA,
                       SUCURSAL     ,        ENTIOFI      ,
                       CUENTA       ,        DIGICCC1     ,
                       DIGICCC2     ,        IMPORTE      ,
                       HONOR_SINIVA ,        HONOR_IVA    ,
                       TOTAL_HONORIVA,       ESTADO       ,
                       VAL_IMPORTE,          DESCRIPCION,
                       ENTIDAD_UMO  ,        CENTRO_UMO   ,
                       USERID_UMO   ,        NETNAME_UMO,
                       TIPOPAG      ,        TIPOGES,
                       CODERROR,             VAL_TASA,
                       TIMESTAMP,
      *@COL03-I
                       TARIFA,               ENTIOFI_ABO  ,
                       CUENTA_ABO,           FECHA_INI,
                       FECHA_FIN,            SALDO_INI_CONV,
                       SALDO_FIN_CONV)
      *@COL03-F
                 VALUES
                     (:ABH-TIPOID  ,        :ABH-NUMID,
                      :ABH-DIGI-ID , :ABH-IND-PROCESO,
                      :ABH-FECMOV  ,        :ABH-CONSEC,
                      :ABH-FECMOD  ,        :ABH-IND-BAJA,
                      :ABH-SUCURSAL,        :ABH-ENTIOFI,
                      :ABH-CUENTA  ,        :ABH-DIGICCC1,
                      :ABH-DIGICCC2,        :ABH-IMPORTE,
                      :ABH-HONOR-SINIVA,    :ABH-HONOR-IVA,
                      :ABH-TOTAL-HONORIVA,  :ABH-ESTADO,
                      :ABH-VAL-IMPORTE,     :ABH-DESCRIPCION,
                      :ABH-ENTIDAD-UMO,     :ABH-CENTRO-UMO,
                      :ABH-USERID-UMO,      :ABH-NETNAME-UMO,
                      :ABH-TIPOPAG   ,      :ABH-TIPOGES,
                      :ABH-CODERROR,        :ABH-VAL-TASA,
                      CURRENT TIMESTAMP,
      *@COL03-I
                      :ABH-TARIFA,          :ABH-ENTIOFI-ABO,
                      :ABH-CUENTA-ABO,      :ABH-FECHA-INI,
                      :ABH-FECHA-FIN,       :ABH-SALDO-INI-CONV,
                      :ABH-SALDO-FIN-CONV)
      *@COL03-F
             END-EXEC

             MOVE SQLCODE                       TO DB2-RETURN-CDE.

             IF NOT DB2-OK OR SQLWARN0 NOT EQUAL SPACES
                MOVE 'UGDTABH'                 TO ABC-OBJETO-ERROR
                MOVE 'INSERT'                  TO ABC-REFERENCIA
                MOVE 'UGDTABH'                 TO CAA-VAR1-ERROR(1:8)
                MOVE SQLCODE                   TO CAA-VAR1-ERROR(9:)
                MOVE 'INSERT UGDTABH'          TO CAA-VAR2-ERROR
                PERFORM 999999-ABEND-DB2
             END-IF.
      *
      ******************************************************************
      *                      2411-BUSCAR-CONSEC
      * BUSCA CONSECUTIVO
      ******************************************************************
       2411-BUSCAR-CONSEC.
      *
            INITIALIZE UGTCABH
                       WS-CONSEC
                       WS-CONSEC-TEMP
                       WS-CONSEC-ALF
                       WS-CONSEC-OPER-N
                       WS-CONSEC-NUM-N
                       WS-INDICA
      *
            MOVE  MAE-ENTIOFI                   TO ABH-ENTIOFI
            MOVE  MAE-CUENTA                    TO ABH-CUENTA
            MOVE  WS-FECHA-CAMARA               TO ABH-FECMOV

            EXEC SQL
                SELECT  MAX(CONSEC)
                INTO :WS-CONSEC :WS-INDICA
                FROM  UGDTABH
                WHERE ENTIOFI = :ABH-ENTIOFI
                AND   CUENTA  = :ABH-CUENTA
                AND   FECMOV  = :ABH-FECMOV
            END-EXEC.

            MOVE SQLCODE                        TO DB2-RETURN-CDE

            MOVE WS-CONSEC                   TO WS-CONSEC-TEMP
            MOVE WS-CONSEC-TEMP              TO WS-CONSEC-ALF
            IF WS-INDICA < 0 OR WS-CONSEC = ZEROES
               MOVE '000000'                   TO WS-CONSEC-ALF
            END-IF

            MOVE WS-CONSEC-OPER           TO WS-CONSEC-OPER-N
            MOVE WS-CONSEC-NUM            TO WS-CONSEC-NUM-N

            IF WS-NRO-REGISTRO = 0
               ADD     1                  TO WS-CONSEC-OPER-N
               MOVE    1                  TO WS-CONSEC-NUM-N
            ELSE
               ADD     1                  TO WS-CONSEC-NUM-N
            END-IF

            MOVE WS-CONSEC-OPER-N         TO WS-CONSEC-OPER
            MOVE WS-CONSEC-NUM-N          TO WS-CONSEC-NUM
            MOVE WS-CONSEC-ALF            TO WS-CONSEC-TEMP
            MOVE WS-CONSEC-TEMP           TO WS-CONSEC
            ADD  1                        TO WS-NRO-REGISTRO


            IF NOT DB2-OK AND NOT DB2-NULREC
               MOVE 'UGE0939'                TO CAA-COD-ERROR
               MOVE 'ERROR AL SELECT'        TO CAA-VAR1-ERROR
               MOVE 'FECMOV AL UGDTABH'      TO CAA-VAR2-ERROR
               PERFORM 999999-ROLLBACK
               PERFORM  3-FINAL-PROGRAMA
            END-IF.
      *
      *----------------------------------------------------------------*
      *                     22-PROCESAR-CHEQUE.                        *
      *     -OBTENER NUMERO DE OPERACION
      *     -MANEJO DE PRORROGA
      *     -MANEJO SALVO BUEN COBRO                                   *
      *     -LLAMADO A CAMARA
      *     -GENERAR MOVIMIENTO
      *     -GENERAR CONTABILIDAD
      *     -CARGAR EL FORMATO DE SALIDA                               *
      *----------------------------------------------------------------*
       22-PROCESAR-CHEQUE.
      *
      * PARA EL CASO DE MAS DE UN PAGO A LA MISMA CUENTA
            IF MAE-FEAPLARE  <= CAA-FECHA-OPER2
              PERFORM 222-MANEJO-PRORROGA
            END-IF
            COMPUTE WS-CHQ-VS-DEUDA  =  G703-TOT-DEUDA-VEN +
                                        G705-GASTNOAT
      *
      *@NOVA01-I
            IF WS-SITPRES = '2'
               IF MAE-SITDEUSU = '50' OR MAE-SITDEUSU = '98'
                  COMPUTE WS-CHQ-VS-DEUDA = WS-CHQ-VS-DEUDA +
                                            AMA-LIBRE-IMP1
               END-IF
            END-IF
      *@NOVA01-F
            PERFORM 224-TRATAMIENTO-CHEQUE
      *
            IF WS-CHQ-VS-DEUDA > 0
               IF WS-IMPORTE-PAG(WS-IND) < WS-CHQ-VS-DEUDA
                  MOVE WS-IMPORTE-PAG(WS-IND) TO TABG-VALOR-BASE
               ELSE
                  MOVE WS-CHQ-VS-DEUDA       TO TABG-VALOR-BASE
               END-IF
               INITIALIZE                    BGECMIR
               MOVE ZEROS                    TO MIR-NUM-RETEN
                                                MIR-DIASVAL-RET-9
               SET NO-ABONO-ABO-PRE          TO TRUE
               SET NO-ABONO-ABO-JUR          TO TRUE
               SET NO-ABONO-MIR-ABO          TO TRUE
               SET SW-PREJUR-HONO-NO         TO TRUE
               SET SW-CONSULTA-SI            TO TRUE
               PERFORM 225-CALCULAR-HONORARIOS
               SET SW-CONSULTA-NO            TO TRUE
      *
               PERFORM 226-CALCULO-BASE-HON
               INITIALIZE UGWCTABG
               PERFORM 225-CALCULAR-HONORARIOS
               PERFORM 230-VALIDAR-HONORARIOS
               IF MAE-IND-MARCA4 = 'H'
                  IF (TABG-VRTAL-PRE > 0 AND TABG-VRTAL-JUR = 0)
                     COMPUTE WS-CHQ-VS-DEUDA  = WS-CHQ-VS-DEUDA -
                                                WS-IMPORTE-PAG(WS-IND)
                  ELSE
      *@COL03-I
                        IF TABG-RESPAG-JUR = 'C'
      *@COL03-F
                           COMPUTE WS-CHQ-VS-DEUDA = WS-CHQ-VS-DEUDA -
                                              ( WS-IMPORTE-PAG(WS-IND) -
                                                  TABG-VRTAL-JUR )
      *@COL03-I
                        ELSE
                           COMPUTE WS-CHQ-VS-DEUDA = WS-CHQ-VS-DEUDA -
                                               ( WS-IMPORTE-PAG(WS-IND))
                        END-IF
      *@COL03-F
                  END-IF
               ELSE
      *@COL03-I
                  IF TABG-RESPAG-PRE = 'C'
                     IF TABG-RESPAG-JUR = 'C'
      *@COL03-F
                        COMPUTE WS-CHQ-VS-DEUDA  = WS-CHQ-VS-DEUDA -
                                              ( WS-IMPORTE-PAG(WS-IND) -
                                                TABG-VRTAL-PRE  -
                                                TABG-VRTAL-JUR )
      *@COL03-I
                     ELSE
                        COMPUTE WS-CHQ-VS-DEUDA  = WS-CHQ-VS-DEUDA -
                                              ( WS-IMPORTE-PAG(WS-IND)-
                                                   TABG-VRTAL-PRE )

                     END-IF
                  ELSE
                     IF TABG-RESPAG-JUR = 'C'
                        COMPUTE  WS-CHQ-VS-DEUDA  = WS-CHQ-VS-DEUDA -
                                                (WS-IMPORTE-PAG(WS-IND)-
                                                     TABG-VRTAL-JUR )
                     ELSE
                        COMPUTE  WS-CHQ-VS-DEUDA  = WS-CHQ-VS-DEUDA -
                                                (WS-IMPORTE-PAG(WS-IND))
                     END-IF
                  END-IF
      *@COL03-F
               END-IF
            END-IF
            PERFORM 225-INSERTA-MOV
            PERFORM 250-CONTABILIDAD.

      *
      ******************************************************************
      *       215-VALIDAR-REDESCUNTO                                   *
      *       VALIDACION PARA CREDITOS CON DEUDA VENCIDA Y REDESCUENTO *
      ******************************************************************
       215-VALIDAR-REDESCUENTO.
      *
           IF MAE-ACUIMPA <= 0 AND MAE-IND-MARCA2 = 'R'
              MOVE 'UGE0939'                      TO CAA-COD-ERROR
              MOVE 'CRED REDE PAGOS SOLO'          TO CAA-VAR1-ERROR
              MOVE 'DEUDA VENC. CRE   '          TO CAA-VAR2-ERROR(1:18)
              MOVE WS-IND                     TO CAA-VAR2-ERROR(19:2)
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
           END-IF
      *
           MOVE '1'                               TO WS-INDMSGR
           IF MAE-ACUIMPA > 0 AND MAE-IND-MARCA2 = 'R'
                MOVE 'PRESTAMO REDESCUENTO ESTE PAGO SOLO APLICARA A LA
      -              ' DEUDA VENCIDA'             TO WS-UH581-MSGRED1
                MOVE 'EL SALDO RETORNA A LA CUENTA DEL CLIENTE
      -              ' '                          TO WS-UH581-MSGRED2
                MOVE SPACES                       TO WS-INDMSGR
           ELSE
                MOVE '1'                          TO WS-INDMSGR
           END-IF.
      *
      ******************************************************************
      *           216-VALIDAR-AJUSTE-RELIQ                             *
      *        VALIDACION PARA AJUSTE DE RELIQUIDACION                 *
      ******************************************************************
       216-VALIDAR-AJUSTE-RELIQ.
      *
           MOVE '1'                      TO WS-INDINTR
           IF (MAE-IND-MARCA4 = 'H' AND MAE-IND-MARCA9 = 'M')
           OR WS-CONSTRUCTOR-SI
              PERFORM 2161-CONSULTA-PEND
              IF MAE-IND-MARCA4 = 'H' AND MAE-IND-MARCA9 = 'M'
                 IF WS-VALOR > WS-TOTAL-DEUDA
                    PERFORM 2162-CONSULTA-AJUREL
                    IF INT-REL-IMPPEND > 0
                       MOVE SPACES          TO WS-INDINTR
                    ELSE
                       MOVE '1'             TO WS-INDINTR
                    END-IF
                 END-IF
              END-IF
           END-IF.

      *
      ******************************************************************
      *                  2160-CONSULTA-DRB                             *
      *   CONSULTA LA DRB PARA SABER SI ES LA ULTIMA CUOTA O SI YA NO  *
      *   TIENE CUOTAS PENDIENTES.                                     *
      ******************************************************************
       2160-CONSULTA-DRB.

           MOVE  MAE-ENTIOFI          TO DRB-ENTIOFI
           MOVE  MAE-CUENTA           TO DRB-CUENTA

           EXEC SQL
               SELECT UGNPLPEN
      *COL37-I
                 ,    UGTFMACT
      *COL37-F
               INTO :DRB-UGNPLPEN
      *COL37-I
                 ,  :DRB-UGTFMACT
      *COL37-F
               FROM UGDTDRB
               WHERE ENTIOFI = :DRB-ENTIOFI
                 AND CUENTA  = :DRB-CUENTA
           END-EXEC
           MOVE SQLCODE       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK               AND
                   SQLWARN0  =  SPACES)
                MOVE 'UGDTDRB'         TO ABC-OBJETO-ERROR
                MOVE 'SELECT-1'        TO ABC-REFERENCIA
                PERFORM 999999-ABEND-DB2
           END-IF.
      *
      *@COL01-2-I
      *
      ******************************************************************
      *                      2160-ACCESO-REC                           *
      *----------------------------------------------------------------*
      *    SE VALIDA SI EXISTE RECIBO PAGO PROXIMA CUOTA               *
      *    PENDIENTE DE PAGO, PARA DEJARLO PAGAR.                      *
      ******************************************************************
       2160-ACCESO-REC.
      *
           INITIALIZE UGTCREC
      *
           MOVE MAE-ENTIOFI                TO REC-ENTIOFI
           MOVE MAE-CUENTA                 TO REC-CUENTA
           MOVE MAE-FEULIQ                 TO REC-FELIQ
      *
           EXEC SQL
               SELECT  INDPECO
                 INTO :REC-INDPECO
                 FROM  UGDTREC
               WHERE   CUENTA   = :REC-CUENTA   AND
                       ENTIOFI  = :REC-ENTIOFI  AND
                       FELIQ    = :REC-FELIQ
           END-EXEC.
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF NOT (DB2-OK AND SQLWARN0 = SPACES)
                 MOVE 'UGDTREC'        TO ABC-OBJETO-ERROR
                 MOVE 'SELECT-P'       TO ABC-REFERENCIA
                 PERFORM 999999-ABEND-DB2
           ELSE
              IF REC-INDPECO = '5'
                 MOVE '1'          TO WS-PPC-PENDIENTE
              ELSE
                 MOVE '0'          TO WS-PPC-PENDIENTE
           END-IF.
      *@COL01-2-F
      *
      ******************************************************************
      *                2160-VALIDA-CONSTRUCTOR.                       *
      *    SE ACCEDE A LA TABLA UGDTT37 SECCION 1063, VALIDACION DE    *
      *    SUBPRODUCTOS PARA CREDITOS CONSTRUCTOR.                     *
      ******************************************************************
       2160-VALIDA-CONSTRUCTOR.
      *
            INITIALIZE UGTCT37
            MOVE '1063'                    TO T37-SECCION
            MOVE MAE-SUBPRO                TO T37-ELEMENTO
      *
            EXEC SQL
                 SELECT RESTO
                 INTO  :T37-RESTO
                 FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                  ELEMENTO = :T37-ELEMENTO
            END-EXEC.
      *
            MOVE SQLCODE                   TO DB2-RETURN-CDE
      *
            IF DB2-OK
               SET  WS-CONSTRUCTOR-SI      TO TRUE
            ELSE
               IF DB2-NOTFND
                  SET  WS-CONSTRUCTOR-NO   TO TRUE
               ELSE
                  MOVE 'UGDTT37'           TO ABC-OBJETO-ERROR
                  MOVE 'SELECT-2'          TO ABC-REFERENCIA
                  PERFORM 999999-ABEND-DB2
               END-IF
            END-IF.
      *
      ******************************************************************
      *                       2161-VALIDA-PPC.                         *
      *    SE VALIDA QUE LOS CREDITOS CONSTRUCTOR AL INTENTAR ABONAR   *
      *    POR PRORATA NO TENGA PPC PENDIENTE.                         *
      ******************************************************************
       2161-VALIDA-PPC.
            IF MAE-FEULIQ > CAA-FECHA-CONT2
               PERFORM 2161-ACCESO-REC
            ELSE
               SET NO-VAL-PPC TO TRUE
            END-IF.
      ******************************************************************
      *                      2161-ACCESO-REC                           *
      *----------------------------------------------------------------*
      *    SE VALIDA SI LA CUENTA TIENE RECIBOS CON PAGO PROXIMA CUOTA *
      ******************************************************************
       2161-ACCESO-REC.
      *
           MOVE MAE-ENTIOFI                TO REC-ENTIOFI
           MOVE MAE-CUENTA                 TO REC-CUENTA
           MOVE MAE-FEULIQ                 TO REC-FELIQ
      *
           EXEC SQL
               SELECT  INDPECO
                 INTO :REC-INDPECO
                 FROM  UGDTREC
               WHERE   CUENTA   = :REC-CUENTA   AND
                       ENTIOFI  = :REC-ENTIOFI  AND
                       FELIQ    = :REC-FELIQ
           END-EXEC.
      *
           MOVE SQLCODE                  TO DB2-RETURN-CDE
      *
           IF DB2-OK AND (SQLWARN0 = SPACES OR LOW-VALUES)
              SET SI-VAL-PPC TO TRUE
              IF REC-INDPECO = '5'
                 MOVE 'UGE0939'              TO CAA-COD-ERROR
                 MOVE 'CREDITO CONSTRUCTOR ' TO CAA-VAR1-ERROR
                 MOVE 'CON PPC PENDIENTE.  ' TO CAA-VAR2-ERROR
                 MOVE WS-IND                 TO CAA-VAR2-ERROR(19:2)
                 PERFORM 999999-ROLLBACK
                 PERFORM 3-FINAL-PROGRAMA
              END-IF
           ELSE
              IF DB2-NOTFND
                 SET NO-VAL-PPC TO TRUE
              ELSE
                MOVE 'UGDTREC'           TO ABC-OBJETO-ERROR
                MOVE 'SELECT'            TO ABC-REFERENCIA
                PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *
      ******************************************************************
      *                 2161-CONSULTA-PEND                             *
      *        CONSULTA EL VALOR DE LA DEUDA PENDIENTE                 *
      ******************************************************************
       2161-CONSULTA-PEND.
      *
           INITIALIZE                 UGWCI701
      *
           MOVE WS-CCC-ENTIOFI           TO G70-CCC-ENTIOFI
           MOVE WS-CCC-CUENTA            TO G70-CCC-CUENTA
           MOVE 'N'                      TO G70-CONSUVR
      *

           CALL BBVA-UR9CI701 USING UGWCI701
      *
           IF G70ERR-CODIGO-RETORNO  NOT = '00'
              IF G70ERR-CODIGO-RETORNO = '99'
                MOVE 'UGE0939'             TO CAA-COD-ERROR
                MOVE 'ER DB2 UR9CI701:'    TO CAA-VAR1-ERROR
                MOVE G70ERR-SQLCODE        TO CAA-VAR1-ERROR(17:)
                MOVE G70ERR-SQLERRM        TO CAA-VAR2-ERROR
              ELSE
                MOVE G70ERR-COD-ERROR      TO CAA-COD-ERROR
                MOVE G70ERR-VAR1-ERROR     TO CAA-VAR1-ERROR
                MOVE G70ERR-VAR2-ERROR     TO CAA-VAR2-ERROR
              END-IF
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
           ELSE
              COMPUTE WS-TOTAL-DEUDA =
                      G703-TOT-DEUDA-VEN + G703-TOT-DEUDA-NOVEN
      *COL28-I
              MOVE G703-INTCORR-NOVENC TO   WS-TINTERE
      *COL28-F
           END-IF.
      *
      *COL25-I
      ******************************************************************
      *21631-VALIDA-SUBPROD-T9124                                      *
      ******************************************************************
       21631-VALIDA-SUBPROD-T9124.
           INITIALIZE                              UGTCT37
           MOVE MAE-SUBPRO                       TO T37-ELEMENTO
           MOVE '9124'                           TO T37-SECCION
           EXEC SQL
              SELECT RESTO
              INTO :T37-RESTO
              FROM
              UGDTT37
              WHERE ELEMENTO = :T37-ELEMENTO
              AND   SECCION  = :T37-SECCION
           END-EXEC

           MOVE SQLCODE                         TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              SET GENERA-AVISO          TO TRUE
           ELSE
              IF DB2-NOTFND
                    SET NO-GENERA-AVISO TO TRUE
              ELSE
                 IF DB2-RECATR1 OR DB2-RECATR2
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'RECURSO ATRAPADO T37' TO CAA-VAR1-ERROR
                    MOVE 'INTENTE LUEGO'        TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
                 ELSE
                    MOVE 'UGE0939'              TO CAA-COD-ERROR
                    MOVE 'ERR1 SELECT UGDTT37'  TO CAA-VAR1-ERROR
                    MOVE 'SQLCODE '             TO CAA-VAR2-ERROR(1:8)
                    MOVE SQLCODE                TO CAA-VAR2-ERROR(9:)
                    PERFORM 999999-ROLLBACK
                    PERFORM 999999-ABEND-DB2
                    PERFORM 3-FINAL-PROGRAMA
                 END-IF
              END-IF
           END-IF.
      *@COL25-F
      ******************************************************************
      *           2162-CONSULTA-AJUREL                                 *
      *        CONSULTA EL SALDO DEL AJUSTE DE RELIQUIDACION           *
      ******************************************************************
       2162-CONSULTA-AJUREL.
      *
           INITIALIZE                 UGWCINT0
      *
           MOVE WS-CCC-ENTIOFI        TO INT-REL-ENTIOFI
           MOVE WS-CCC-CUENTA         TO INT-REL-CUENTA
           MOVE 'O'                   TO INT-REL-OPCION
           MOVE 'C'                   TO INT-REL-MODO

           CALL BBVA-UR9CINT0 USING UGWCINT0
      *
           EVALUATE INT-REL-RET-CODIGO
               WHEN '00'
               WHEN '10'
                   CONTINUE
               WHEN '12'
                   MOVE 'UGE0939'             TO CAA-COD-ERROR
                   MOVE 'ERR.12 RUT.UR9CINT0' TO CAA-VAR1-ERROR
                   MOVE INT-REL-DES-CODIGO    TO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
               WHEN '50'
                   MOVE 'UGE0939'             TO CAA-COD-ERROR
                   MOVE 'ERR.50 RUT.UR9CINT0' TO CAA-VAR1-ERROR
                   MOVE INT-REL-DES-CODIGO    TO CAA-VAR2-ERROR
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
               WHEN '99'
                   MOVE 'UR9CINT0'            TO WS-PROGRAMA
                   MOVE 'UGE0939'             TO CAA-COD-ERROR
                   MOVE INT-REL-RET-CODIGO    TO CAA-VAR1-ERROR
                   MOVE 'RUT.UR9CINT0'        TO CAA-VAR2-ERROR
                   MOVE INT-REL-SQLCODE       TO SQLCODE
                   PERFORM 999999-ROLLBACK
                   PERFORM 3-FINAL-PROGRAMA
           END-EVALUATE.
      *
      ******************************************************************
      *        221-OBTENER-NUM-OPER                                    *
      *        SE OBTIENE EL ULTIMO NUMERO DE OPERACION                *
      ******************************************************************
       221-OBTENER-NUM-OPER.
      *
            MOVE UH580-NUMCRED(WS-IND1)   TO WS-CCC2
            MOVE WS-CCC2-ENTIOFI          TO MCH-ENTIOFI
            MOVE WS-CCC2-CUENTA           TO MCH-CUENTA
      *
            EXEC SQL
                 SELECT  MAX(NRO_OPER)
                 INTO    :MCH-NRO-OPER
                 FROM    UGDTMCH
                 WHERE   ENTIOFI = :MCH-ENTIOFI
                 AND     CUENTA  = :MCH-CUENTA
            END-EXEC.
      *
            MOVE SQLCODE                 TO DB2-RETURN-CDE
      *
            IF DB2-OK AND (SQLWARN0 = SPACES OR LOW-VALUES)
              IF WS-IND1 = 1
                 MOVE MCH-NRO-OPER       TO WS-NUM-OPER
              ELSE
                 IF MCH-NRO-OPER > WS-NUM-OPER
                    MOVE MCH-NRO-OPER       TO WS-NUM-OPER
                 END-IF
              END-IF
            ELSE
                IF DB2-NULREC
                   CONTINUE
                ELSE
                  MOVE 'UGDTMCH'             TO ABC-OBJETO-ERROR
                  MOVE 'SELECT'              TO ABC-REFERENCIA
                  PERFORM 999999-ABEND-DB2
                END-IF
            END-IF.
      *
      ******************************************************************
      *              222-MANEJO-PRORROGA                               *
      *----------------------------------------------------------------*
      *     - CALCULO  DE LOS DOS DIAS HABILES SIGUIENTES              *
      *     - ACTUALIZACION DE LA TABLA UGDTMAE                        *
      *                                                                *
      ******************************************************************
      *****  CALCULAR LOS DOS DIAS HABILES SIGUIENTES              *****
      ******************************************************************
       222-MANEJO-PRORROGA.
      *
           INITIALIZE                         TCWC0400-AREA
           MOVE '3'                           TO W040-CDOPCIO
           MOVE CAA-FECHA-OPER2               TO WS-FECHA-AMD
           MOVE WS-FECHA-AMD-D                TO W040-FHTRAT1(1:2)
           MOVE '.'                           TO W040-FHTRAT1(3:1)
           MOVE WS-FECHA-AMD-M                TO W040-FHTRAT1(4:2)
           MOVE '.'                           TO W040-FHTRAT1(6:1)
           MOVE WS-FECHA-AMD-A                TO W040-FHTRAT1(7:4)
           MOVE 2                             TO W040-FACTOR
           MOVE '1'                           TO W040-TRSABADO
           MOVE '4'                           TO W040-TRATFEST
           MOVE WS-CCC-ENTIDAD                TO W040-STBANCO
           MOVE WS-CCC-CENTRO                 TO W040-STOFICI
      *
           EXEC CICS
              LINK PROGRAM ('TC2C1200')
              COMMAREA (TCWC0400-AREA)
              NOHANDLE
           END-EXEC
      *
           IF EIBRESP EQUAL DFHRESP(NORMAL)
              EVALUATE W040-CDRETORN
                 WHEN '00'
                    MOVE W040-FHHABIL(1:2)    TO WS-DIA-EFEC-PAGO
                    MOVE W040-FHHABIL(4:2)    TO WS-MES-EFEC-PAGO
                    MOVE W040-FHHABIL(7:4)    TO WS-ANO-EFEC-PAGO
                 WHEN OTHER
                    MOVE 'UGE0939'            TO CAA-COD-ERROR
                    MOVE W040-CDRETORN        TO CAA-VAR1-ERROR
                    MOVE 'TC2C1200'           TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                    PERFORM 3-FINAL-PROGRAMA
              END-EVALUATE
           ELSE
              MOVE 'ERROR LINK TC2C1200'      TO ABC-REFERENCIA
              PERFORM 999999-ABEND-CICS
           END-IF.
      *
      ******************************************************************
      *****  ACTUALIZAR LA TABLA UGDTMAE                           *****
      ******************************************************************
           MOVE WS-FECHA-EFEC-PAGO            TO MAE-FEAPLARE
           MOVE CAA-NETNAME-CONT              TO MAE-NETNAME-UMO
           MOVE CAA-USERID                    TO MAE-USERID-UMO
           MOVE WS-CCC-ENTIDAD                TO MAE-ENTIDAD-UMO
           MOVE WS-CCC-CENTRO                 TO MAE-CENTRO-UMO
      *
           EXEC SQL
              UPDATE  UGDTMAE
                 SET
                      TIMESTAMP   = CURRENT TIMESTAMP,
                      NETNAME_UMO = :MAE-NETNAME-UMO,
                      USERID_UMO  = :MAE-USERID-UMO,
                      ENTIDAD_UMO = :MAE-ENTIDAD-UMO,
                      CENTRO_UMO  = :MAE-CENTRO-UMO,
                      FEAPLARE    = :MAE-FEAPLARE
               WHERE  ENTIOFI     = :MAE-ENTIOFI AND
                      CUENTA      = :MAE-CUENTA AND
                      TIMESTAMP   = :WS-TIMESTAMP
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
              MOVE 'UGE1915'                  TO CAA-COD-ERROR
              PERFORM 999999-ROLLBACK
              PERFORM 3-FINAL-PROGRAMA
           ELSE
              IF NOT DB2-OK OR SQLWARN0 NOT EQUAL SPACES
                 MOVE 'UGDTMAE'               TO ABC-OBJETO-ERROR
                 MOVE 'SELECT'                TO ABC-REFERENCIA
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
