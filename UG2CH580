                   LOG_DESCRIPCION,
                   LOG_ENTIDAD_UMO,
                   LOG_CENTRO_UMO,
                   LOG_USERID_UMO,
                   LOG_NETNAME_UMO)
                VALUES (
                  :LOG-ENTIOFI,
                  :LOG-CUENTA,
