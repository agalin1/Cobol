           IF WS-PROPIO-SI
              MOVE 'C'                     TO MCH-IND-ACT-UG
           ELSE
              MOVE 'N'                     TO MCH-IND-ACT-UG
           END-IF
      *@COL12-F
           MOVE CTE-CON-FECHA-NULA         TO MCH-FELIQ
      *@COL01-1-I
      *    MOVE '00'                       TO MCH-NRO-BANCO(1:2)
      *    MOVE WS-BANCO-EMIS              TO MCH-NRO-BANCO(3:4)
           MOVE '000'                      TO MCH-NRO-BANCO(1:3)
           MOVE WS-BANCO-EMIS(2:3)         TO MCH-NRO-BANCO(4:3)
      *@COL01-1-F
           MOVE WS-NUM-CHEQ                TO MCH-NRO-CHEQUE
           MOVE CAA-ENTIDAD                TO MCH-ENTIDAD-UMO
           MOVE CAA-CENTRO-CONT            TO MCH-CENTRO-UMO
           MOVE CAA-USERID                 TO MCH-USERID-UMO
           MOVE CTE-PROGRAMA               TO MCH-NETNAME-UMO
      *
           EXEC SQL
                 INSERT INTO UGDTMCH
                        (ENTIOFI         ,
                         CUENTA          ,
                         NRO_OPER        ,
                         CONSEC          ,
                         CANAL           ,
                         FECHA_OPER      ,
                         FECHA_CONT      ,
                         TIPO_MOV        ,
                         NRO_RECIBO      ,
                         FELIQ           ,
                         CONS_GASTO      ,
                         TIPO_GASTO      ,
                         IMP_CAPITAL     ,
                         IMP_INT_CTES    ,
                         IMP_INT_MORA    ,
                         IMP_GASTOS      ,
                         IMP_COMISION    ,
                         IMP_IVA         ,
                         IMP_SEGUROS     ,
                         APLIC_DESTINO   ,
                         CTA_DESTINO     ,
                         SALDO_CAP_ANT   ,
                         SALDO_INT_ANT   ,
                         DISPONIBLE_ANT  ,
                         CODIDENT        ,
                         CLAIDENT        ,
                         DIGIDENT        ,
                         NOMBRE          ,
                         IND_TIPO_PAGO   ,
                         DESCRIPCION     ,
                         DIVISA          ,
                         IND_PROVEEDOR   ,
                         INDRECU         ,
                         IND_ACT_UG      ,
                         REALPROP        ,
                         PERSPROP        ,
                         REALRETO        ,
                         PERSRETO        ,
                         INT_CTES        ,
                         INT_CTES_CONT   ,
                         INT_MORA        ,
                         INT_MORA_CONT   ,
                         NRO_BANCO       ,
                         NRO_CHEQUE      ,
                         ENTIDAD_UMO     ,
                         CENTRO_UMO      ,
                         USERID_UMO      ,
                         NETNAME_UMO     ,
                         TIMESTAMP)
                 VALUES
                         (:MCH-ENTIOFI          ,
                          :MCH-CUENTA           ,
                          :MCH-NRO-OPER         ,
