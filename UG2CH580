      *@COL03-F
                   IF WS-IMPORTE-PAG(WS-IND) < ( WS-CHQ-VS-DEUDA +
                                                 TABG-VRTAL-PRE  +
                                                 TABG-VRTAL-JUR )
                      MOVE WS-IMPORTE-PAG(WS-IND)    TO WS-VALOR-BASE
                   ELSE
                      COMPUTE WS-VALOR-BASE  = WS-CHQ-VS-DEUDA +
                                               TABG-VRTAL-PRE  +
                                               TABG-VRTAL-JUR
                   END-IF
      *@COL03-I
                ELSE
                   IF WS-IMPORTE-PAG(WS-IND) < ( WS-CHQ-VS-DEUDA +
                                                 TABG-VRTAL-PRE  )
                      MOVE WS-IMPORTE-PAG(WS-IND)     TO WS-VALOR-BASE
                   ELSE
                      COMPUTE WS-VALOR-BASE  = WS-CHQ-VS-DEUDA +
                                               TABG-VRTAL-PRE
                   END-IF
                END-IF
             ELSE
                IF TABG-RESPAG-JUR = 'C'
                   IF WS-IMPORTE-PAG(WS-IND) < ( WS-CHQ-VS-DEUDA +
                                                 TABG-VRTAL-JUR  )
