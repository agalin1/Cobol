           IF RUNTERR-CODIGO-RETORNO  = '00'
              IF RUNT1-VALOR-GASTO > 0 OR RUNT1-VALOR-IVA > 0
                MOVE RUNT1-VALOR-GASTO     TO WS-GAS-RUNT
                MOVE RUNT1-VALOR-IVA       TO WS-IVA-RUNT
