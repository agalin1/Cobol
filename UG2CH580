             SELECT DPR_FECHALT
             INTO   :DPR-FECHALT
             FROM   UGDTDPR
             WHERE DPR_NUMCLIEN = :DPR-NUMCLIEN
                   AND DPR_ENTIOFI  = :DPR-ENTIOFI
                   AND DPR_CUENTA   = :DPR-CUENTA
                   AND DPR_TIPOPER  = 'N'
                   AND DPR_ESTADO   = 'F'
                   AND DPR_PRODUC   = 'RN'
                   ORDER BY DPR_FECHALT DESC
                   FETCH FIRST 1 ROWS ONLY
           END-EXEC.
