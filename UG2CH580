      * LA CUENTA DEL ABOGADO                                          *
      ******************************************************************
       240-CARGO-HONORARIOS.
      *
           INITIALIZE BGECMIR
      *
           MOVE WS-ENTIOFI-ABO (1:4)         TO MIR-ENTIDAD
           MOVE WS-ENTIOFI-ABO (5:4)         TO MIR-CENTRO-ALTA
           MOVE WS-CUENTA-ABO                TO MIR-CUENTA
           MOVE SPACES                       TO MIR-DIGICCC1
                                                MIR-DIGICCC2
      *****************************************************************
      *  PARA ASEGURARSE QUE SOLO SE UTILICEN LAS CUENTAS DE AHORRO,
      *  CORRIENTES, O CUENTAS DE ESPERA
      *****************************************************************
           IF MIR-CUENTA(1:2) = '01' OR '02'
              CONTINUE
           ELSE
              MOVE 'UGE1981'                  TO CAA-COD-ERROR
              PERFORM 999999-ROLLBACK
              IF MIR-CUENTA(1:2) = '19'
                 IF MIR-CENTRO-ALTA   NOT = CAA-CENTRO-CONT
                    MOVE 'UGE3412'            TO CAA-COD-ERROR
                    MOVE MIR-CENTRO-ALTA      TO CAA-VAR1-ERROR
                    MOVE CAA-CENTRO-CONT      TO CAA-VAR2-ERROR
                    PERFORM 999999-ROLLBACK
                 END-IF
                 CONTINUE
              ELSE
                 MOVE 'UGE1981'               TO CAA-COD-ERROR
                 PERFORM 999999-ROLLBACK
              END-IF
           END-IF
      *
           MOVE 'CARGO HONORARIOS X CHEQUE'   TO MIR-OBSERVA
