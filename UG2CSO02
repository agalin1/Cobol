      *----------------------------------------------------------------*00016400
      *        4000I-ACTUALIZA-UGGTDAT  DISPONIBILIDAD                 *00016500
      *   REALIZA ACTUALIZACI├│N DE ESTADO Y DESCRIPCI├│N EN UGGTDAT.    *
      *----------------------------------------------------------------*00016600
       4000I-DISPONIBILIDAD.                                            00016700

           EXEC SQL
               SELECT  PAB_CODIGO_CAMP
               INTO   :PAB-CODIGO-CAMP
               FROM    UGDTPAB
               WHERE   PAB_NUMCLIEN    = :RU2-CLIENTE
                 AND   PAB_ESTADO_CAMP = 'VS'
                 AND   PAB_CODIGO_PROD = :RU2-PRODUCTO
                 AND   PAB_CANAL_ASIG  <> ' '
                 AND   PAB_LIM_MINIMO  > 0
                 AND   PAB_LIM_MAXIMO  > 0
                 FETCH FIRST 1 ROWS ONLY
           END-EXEC

           MOVE SQLCODE                      TO DB2-RETURN-CDE

           IF   DB2-OK
                EXEC SQL
                    SELECT DAT_COD_CAM,
                           DAT_INDICADOR_PROD,
                           DAT_COD_CAM_RIESGOS
                    INTO  :DAT-COD-CAM,
                          :DAT-INDICADOR-PROD,
                          :DAT-COD-CAM-RIESGOS
                    FROM UGDTDAT
                    WHERE DAT_CLIENTE         = :RU2-CLIENTE
                    AND   DAT_INDICADOR_PROD  = :RU2-IND-PDTO
                    AND   DAT_COD_CAM_RIESGOS = :RU2-COD-CAM-RIES
 COL02              ORDER BY DAT_PRODUCTO DESC
 COL02              FETCH FIRST 1 ROWS ONLY
                END-EXEC
      *COL01-I
      *             AND   DAT_PRODUCTO        = :RU2-PRODUCTO
      *             AND   DAT_COD_CAM_RIESGOS = :RU2-COD-CAM-RIES
      *         END-EXEC
      *COL01-F

                MOVE SQLCODE TO DB2-RETURN-CDE

                IF   DB2-OK
                     MOVE DAT-INDICADOR-PROD TO RU2-IND-PDTO
                     PERFORM 4090I-ACTUALIZA
                END-IF

                IF   DB2-NOTFND
                     EXEC SQL
                          SELECT DAT_COD_CAM,
                                 DAT_INDICADOR_PROD,
                                 DAT_COD_CAM_RIESGOS
                          INTO  :DAT-COD-CAM,
                                :DAT-INDICADOR-PROD,
                                :DAT-COD-CAM-RIESGOS
                          FROM UGDTDAT
                          WHERE DAT_CLIENTE         = :RU2-CLIENTE
                          AND   DAT_INDICADOR_PROD  = :RU2-IND-PDTO
                          AND   DAT_COD_CAM         = :RU2-COD-CAM-RIES
 COL02                    ORDER BY DAT_PRODUCTO DESC
 COL02                    FETCH FIRST 1 ROWS ONLY
                     END-EXEC
      *COL01-I
      *                   AND   DAT_PRODUCTO        = :RU2-PRODUCTO
      *                   AND   DAT_COD_CAM         = :RU2-COD-CAM-RIES
      *              END-EXEC
      *COL01-F
                END-IF

                MOVE SQLCODE TO DB2-RETURN-CDE

                IF   DB2-OK
                     MOVE DAT-COD-CAM-RIESGOS TO RU2-COD-CAM-RIES
                     MOVE DAT-INDICADOR-PROD  TO RU2-IND-PDTO
                     PERFORM 4090I-ACTUALIZA
                END-IF
           END-IF.

       4000F-DISPONIBILIDAD.  EXIT.                                     00016700
      *----------------------------------------------------------------*00016400
      *                 4020I-ACTUALIZA-UGGTDAT                        *00016500
      *   REALIZA ACTUALIZACI├│N DE ESTADO Y DESCRIPCI├│N EN UGGTDAT.    *
      *   BUSQUEDA Y ACTUALIZACI├│N POR CODIGO CAMPA┬ªA DE SALE FORCE.   *
      *----------------------------------------------------------------*00016600
       4020I-ACTUALIZA-UGGTDAT.                                         00016700

           EXEC SQL
                SELECT DAT_PRODUCTO,
                       DAT_COD_CAM,
                       DAT_COD_CAM_RIESGOS
                INTO  :DAT-PRODUCTO,
                      :DAT-COD-CAM,
                      :DAT-COD-CAM-RIESGOS
                FROM UGDTDAT
                WHERE DAT_CLIENTE         = :RU2-CLIENTE
                AND   DAT_INDICADOR_PROD  = :RU2-IND-PDTO
                AND   DAT_COD_CAM         = :RU2-COD-CAM-RIES
 COL02          ORDER BY DAT_PRODUCTO DESC
 COL02          FETCH FIRST 1 ROWS ONLY
           END-EXEC

           MOVE SQLCODE TO DB2-RETURN-CDE

           EVALUATE TRUE
                WHEN DB2-OK
                     PERFORM 4090I-ACTUALIZA

                WHEN DB2-NOTFND
                     PERFORM 4050I-ACTUALIZA-UGGTDAT

                WHEN OTHER
 COL02*              MOVE 'OZF2007'              TO RU2-CODRET
 COL02*              MOVE 'ERROR DB2 EN UGDTDAT' TO RU2-VAR1-ERROR
 COL02               MOVE 'OZE0000'              TO RU2-CODRET
 COL02               MOVE 'ERROR DB2 EN UGDTDAT1' TO RU2-VAR1-ERROR
                     MOVE '                    ' TO RU2-VAR2-ERROR
                     PERFORM 8000I-FINAL
           END-EVALUATE.

       4020F-ACTUALIZA-UGGTDAT. EXIT.                                   00016700
      *----------------------------------------------------------------*
      *                 4010I-ACTUALIZA-UGGTDAT                        *00016500
      *   REALIZA ACTUALIZACI├│N DE ESTADO Y DESCRIPCI├│N EN UGGTDAT.    *
      *   BUSQUEDA Y ACTUALIZACI├│N POR CODIGO CAMPA┬ªA DE RIESGOS(PAB). *
      *----------------------------------------------------------------*00016600
       4050I-ACTUALIZA-UGGTDAT.                                         00016700

           EXEC SQL
                SELECT DAT_PRODUCTO,
                       DAT_COD_CAM,
                       DAT_COD_CAM_RIESGOS
                INTO  :DAT-PRODUCTO,
                      :DAT-COD-CAM,
                      :DAT-COD-CAM-RIESGOS
                FROM UGDTDAT
                WHERE DAT_CLIENTE         = :RU2-CLIENTE
                AND   DAT_INDICADOR_PROD  = :RU2-IND-PDTO
                AND   DAT_COD_CAM_RIESGOS = :RU2-COD-CAM-RIES
 COL02          ORDER BY DAT_PRODUCTO DESC
 COL02          FETCH FIRST 1 ROWS ONLY
           END-EXEC

           MOVE SQLCODE TO DB2-RETURN-CDE

           EVALUATE TRUE
                WHEN DB2-OK
                     PERFORM 4090I-ACTUALIZA
                WHEN DB2-NOTFND
                     MOVE DAT-COD-CAM            TO RU2-COD-CAM-RIES
                     PERFORM 4090I-ACTUALIZA
                     PERFORM 8000I-FINAL
                WHEN OTHER
 COL02*              MOVE 'OZF2009'              TO RU2-CODRET
 COL02*              MOVE 'ERROR DB2 EN UGDTDAT' TO RU2-VAR1-ERROR
 COL02               MOVE 'OZE0000'              TO RU2-CODRET
 COL02               MOVE 'ERROR DB2 EN UGDTDAT2' TO RU2-VAR1-ERROR
                     MOVE '                    ' TO RU2-VAR2-ERROR
                     PERFORM 8000I-FINAL
           END-EVALUATE.

       4050F-ACTUALIZA-UGGTDAT. EXIT.                                   00016700
      *----------------------------------------------------------------*
      *                 4070I-BUSCA-PDTO                               *00016500
      *   DEVUELVE EL CODIGO DE PRODUCTO EXISTENTE EN UGDTDAT.         *
      *   PRIMERO REALIZA BUSQUEDA POR CODIGO CAMPA┬ªA DE RIESGO.       *
      *----------------------------------------------------------------*00016600
       4070I-BUSCA-PDTO.

           MOVE RU2-CLIENTE      TO DAT-CLIENTE
           MOVE RU2-IND-PDTO     TO DAT-INDICADOR-PROD                  00019100
           MOVE RU2-COD-CAM-RIES TO DAT-COD-CAM-RIESGOS

           EXEC SQL
                SELECT DAT_PRODUCTO
                INTO  :DAT-PRODUCTO
                FROM UGDTDAT
                WHERE DAT_CLIENTE         = :DAT-CLIENTE
                AND   DAT_INDICADOR_PROD  = :DAT-INDICADOR-PROD
                AND   DAT_COD_CAM_RIESGOS = :DAT-COD-CAM-RIESGOS
 COL02          ORDER BY DAT_PRODUCTO DESC
 COL02          FETCH FIRST 1 ROWS ONLY
           END-EXEC

           MOVE SQLCODE TO DB2-RETURN-CDE

           EVALUATE TRUE
                WHEN DB2-OK
                     MOVE  DAT-PRODUCTO        TO RU2-PRODUCTO
                WHEN DB2-NOTFND
                     PERFORM 4080I-BUSCA-PDTO
                WHEN OTHER
                     MOVE  SPACES              TO RU2-PRODUCTO
           END-EVALUATE.

       4070F-BUSCA-PDTO.  EXIT.
      *----------------------------------------------------------------*
      *                 4080I-BUSCA-PDTO                               *00016500
      *   DEVUELVE EL CODIGO DE PRODUCTO EXISTENTE EN UGDTDAT.         *
      *   SEGUNDO REALIZA BUSQUEDA POR CODIGO CAMPA┬ªA DE SALE FORCE.   *
      *----------------------------------------------------------------*00016600
       4080I-BUSCA-PDTO.

           EXEC SQL
                SELECT DAT_PRODUCTO
                INTO  :DAT-PRODUCTO
                FROM UGDTDAT
                WHERE DAT_CLIENTE         = :RU2-CLIENTE
                AND   DAT_INDICADOR_PROD  = :RU2-IND-PDTO
                AND   DAT_COD_CAM         = :RU2-COD-CAM-RIES
 COL02          ORDER BY DAT_PRODUCTO DESC
 COL02          FETCH FIRST 1 ROWS ONLY
           END-EXEC

           MOVE SQLCODE TO DB2-RETURN-CDE

