       4090I-ACTUALIZA.

           MOVE RU2-CLIENTE           TO DAT-CLIENTE
           MOVE RU2-IND-PDTO          TO DAT-INDICADOR-PROD
           MOVE RU2-COD-CAM-RIES      TO DAT-COD-CAM-RIESGOS
           MOVE RU2-PRODUCTO          TO DAT-PRODUCTO
      *@COL03-I
           IF RU2-COD-CAM-RIES  = 'OFERTA_D0_AB'
      *@COL04-I
              OR RU2-COD-CAM-RIES  = 'OFERTA_D0_BS'
      *@COL04-F
              IF RU2-ESTADO   = 'FC'
                 MOVE '08' TO  RU2-ESTADO
              END-IF
           END-IF
      *@COL03-F
           IF RU2-PRODUCTO = '60' OR '99'                               00291000
              EXEC SQL
                  UPDATE UGDTDAT
                  SET  DAT_ESTADO         = :RU2-ESTADO       ,
                       DAT_USERID_UMO     = :CT-OZ2COZF2      ,
                       DAT_TIMESTAMP      =  CURRENT TIMESTAMP

                  WHERE DAT_CLIENTE       = :DAT-CLIENTE                00291900
                  AND   DAT_COD_CAM_RIESGOS = :DAT-COD-CAM-RIESGOS      00292100
                  AND  (DAT_PRODUCTO  = '60' OR                         00292200
                        DAT_PRODUCTO  = '99' )                          00292400
              END-EXEC
           ELSE                                                         00292700
              EXEC SQL
                  UPDATE UGDTDAT
                  SET  DAT_ESTADO         = :RU2-ESTADO       ,
                       DAT_USERID_UMO     = :CT-OZ2COZF2      ,
                       DAT_TIMESTAMP      =  CURRENT TIMESTAMP
                  WHERE DAT_CLIENTE       = :DAT-CLIENTE
                  AND  DAT_INDICADOR_PROD = :DAT-INDICADOR-PROD
                  AND DAT_COD_CAM_RIESGOS = :DAT-COD-CAM-RIESGOS
              END-EXEC
           END-IF

           MOVE SQLCODE TO DB2-RETURN-CDE

           EVALUATE TRUE
                WHEN DB2-OK
                     CONTINUE
                WHEN DB2-NOTFND
                     EXEC SQL
                          UPDATE UGDTDAT
                          SET  DAT_ESTADO         = :RU2-ESTADO       ,
                               DAT_USERID_UMO     = :CT-OZ2COZF2      ,
                               DAT_TIMESTAMP      =  CURRENT TIMESTAMP
                          WHERE DAT_CLIENTE       = :DAT-CLIENTE
                          AND  DAT_INDICADOR_PROD = :DAT-INDICADOR-PROD
                          AND  DAT_COD_CAM        = :DAT-COD-CAM-RIESGOS
                     END-EXEC
                WHEN OTHER
 COL02*              MOVE 'OZF2010'              TO RU2-CODRET
 COL02*              MOVE 'ERROR DB2 EN UGDTDAT' TO RU2-VAR1-ERROR
 COL02               MOVE 'OZE0000'              TO RU2-CODRET
 COL02               MOVE 'ERROR DB2 EN UGDTDAT3' TO RU2-VAR1-ERROR
                     MOVE '                    ' TO RU2-VAR2-ERROR
                     PERFORM 8000I-FINAL
           END-EVALUATE.

