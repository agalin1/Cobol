      *================================================================*
      *                                                                *
      *             2833132-ANAL-SUB-AMO                              *
      *                                                                *
      *   SE CALCULA LA SUBVENCION EN EL CASO DE QUE SE VAYA A         *
      *   AMORTIZAR                                                    *
      *                                                                *
      *================================================================*
      *
       2833132-ANAL-SUB-AMO.
      *
           IF (ADS-INDSUBVE   = CTE-CON-LI  OR
              ADS-INDSUBVE   = 'N' )        OR
              (ADS-INDSUBVE   = CTE-CON-SU )

      *    TIPOSUB ES 1 (SUBVENCION SOBRE INTERESES) POR TANTO NO
      *    HAY EN AMORTIZACION
      *
                MOVE ZERO                    TO WS-SUBVENCION-1
                MOVE WS-CUOTA-ACTUAL         TO WS-CAPITAL-1
           ELSE
               IF ADS-INDSUBVE   = CTE-CON-SU

      *    SE CALCULA LA SUBVENCION CUANDO EXISTE Y ES DE CAPITAL
                   PERFORM  2833111311-ACCEDER-UTRA-PORC
                   IF DB2-NOTFND AND SQLWARN0 = SPACES
                       MOVE ZERO               TO WS-SUBVENCION-1
                       MOVE WS-CUOTA-ACTUAL    TO WS-CAPITAL-1
                   ELSE
                       IF DB2-OK AND SQLWARN0 = SPACES
                           PERFORM  2833111331-PARTE-CAPITAL
                           CONTINUE
                       ELSE
                           MOVE 'UGDTTRA'            TO TBLA-DESCRIP1
                           PERFORM 999999-ABEND-DB2
                       END-IF
                   END-IF
               END-IF
           END-IF
           MOVE ZERO                    TO WS-INTERES-1
           MOVE WS-CAPITAL-1            TO WS-RECIBO-1
           ADD WS-GASTOS-1 TO WS-RECIBO-1
              GIVING WS-RECIBO-1
              ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
           END-ADD.
           IF  WS-PERIODOS >  WS-LIMITE
               ADD WS-GASTOS-1X TO WS-RECIBO-1
                   GIVING WS-RECIBO-1
                   ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
               END-ADD
           ELSE
               ADD WS-GASTOS-1 TO WS-RECIBO-1
                   GIVING WS-RECIBO-1
                   ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
               END-ADD
           END-IF.
           SUBTRACT WS-CAPITAL-1 FROM WS-SALDO-VIVO
             GIVING WS-SALDO-1
             ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
           END-SUBTRACT.

      *================================================================*
      *                                                                *
      *                 28332-IMPRIMIR-LINEA                         *
      *                                                                *
      *          SE IMPRIMEN LAS LINEAS DEL CUADRO.                    *
      *                                                                *
      *          LAS LINEAS DE DETALLE ESTAN ASOCIADAS AL FORMATO      *
      *          WS-TABLA                                              *
      *                                                                *
      *================================================================*
      *
       28332-IMPRIMIR-LINEA.
      *
           ADD 1                           TO WS-IND-TBL
      *
           INITIALIZE WS-TABLA
                      TBLA-FECHA(WS-IND-TBL)
      *
           MOVE ZEROES              TO TBLA-NUMERO-CUOTA   (WS-IND-TBL)
                                       TBLA-VALOR-CUOTA    (WS-IND-TBL)
                                       TBLA-VALOR-INTERESES(WS-IND-TBL)
                                       TBLA-VALOR-SEGURO   (WS-IND-TBL)
                                       TBLA-VALOR-CAPITAL  (WS-IND-TBL)
                                       TBLA-SALDO-PENDIENTE(WS-IND-TBL)
      *
           MOVE WS-IND-TBL          TO TBLA-NUMERO-CUOTA(WS-IND-TBL)

           IF WS-FECHA-1 > WS-FECHA-2
               MOVE WS-FECHA-LIQ-ANT          TO WS-DATE-DB2
           ELSE
               MOVE WS-FECHA-AMO-ANT          TO WS-DATE-DB2
           END-IF
      *
           PERFORM  283321-FORMT-FECHA-SCREEN
      *
           MOVE WS-DATE-SALIDA           TO CTA-FECHA-AUX1
           MOVE CTA-FECHA-AUX1-DIA       TO CTA-FECHA-AUX2-DIA
           MOVE CTA-FECHA-AUX1-MES       TO CTA-FECHA-AUX2-MES
           MOVE CTA-FECHA-AUX1-ANNO      TO CTA-FECHA-AUX2-ANNO
           MOVE CTA-FECHA-AUX2           TO WS-G662-FEFIVAL
                                            TBLA-FECHA(WS-IND-TBL)
      *
           COMPUTE ITERACION            = ITERACION + 1
      *
           IF  W-MES = 2
              IF (W-DIA = 28                OR W-DIA = 29)
                 IF ITERACION = 1
                    MOVE WS-DIA-SOLICITUD          TO WS-DATE-DB2-DIA
                 END-IF
              END-IF
           ELSE
              IF WS-DIA-SOLICITUD = 31
                 MOVE WS-DIA-SOLICITUD             TO WS-DATE-DB2-DIA
                 IF  CTA-FECHA-AUX2-MES = '02'
                     MOVE CTA-FECHA-AUX2-ANNO      TO WS-DATE-AUX-ANNO
                     PERFORM 28311-COMPROBAR-ANNO-BISIESTO
                     MOVE WS-DATE-AUX-DIA          TO WS-DATE-DB2-DIA
                 ELSE
                     IF (CTA-FECHA-AUX2-MES = '04' OR
                         CTA-FECHA-AUX2-MES = '06' OR
                         CTA-FECHA-AUX2-MES = '09' OR
                         CTA-FECHA-AUX2-MES = '11')
                         MOVE 30                   TO WS-DATE-DB2-DIA
                     END-IF
                 END-IF
              END-IF
           END-IF
      *
           MOVE  WS-DATE-DB2(9:2)       TO WS-G662-FEFIVAL(1:2)
           MOVE  WS-DATE-DB2(6:2)       TO WS-G662-FEFIVAL(3:2)
           MOVE  WS-DATE-DB2(1:4)       TO WS-G662-FEFIVAL(5:4)
           MOVE WS-G662-FEFIVAL         TO TBLA-FECHA(WS-IND-TBL)
           MOVE WS-INTERES-1            TO WS-G662-INTINIR
                                       TBLA-VALOR-INTERESES(WS-IND-TBL)
           ADD  WS-INTERES-1            TO WS-ACC-INTINIR
      *
           IF WS-NUM-PERIODOS EQUAL WS-CONT-AMO
               IF WS-NUM-PERIODOS GREATER 1
                SUBTRACT WS-CAPITAL-1 FROM WS-SALDO-VIVO
                     GIVING WS-SALDO-1
                     ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
                END-SUBTRACT
               END-IF
           END-IF
      *
           IF SI-SUBPRO-LEASING OR SW-SI-SUB-COBLH
              AND WS-VR-OPCOMP > 0
              IF (WS-FECHA-FINAL = WS-FECHA-1 AND
                  WS-FECHA-FINAL = WS-FECHA-2)
                    COMPUTE WS-CAPITAL-1 = WS-CAPITAL-1 + WS-VR-OPCOMP
              END-IF
           END-IF
      *
           MOVE WS-CAPITAL-1            TO WS-G662-CAPINIR
                                         TBLA-VALOR-CAPITAL(WS-IND-TBL)
           ADD  WS-CAPITAL-1            TO WS-ACC-CAPINIR
           MOVE WS-SALDO-1              TO WS-G662-SALREAL
                                       TBLA-SALDO-PENDIENTE(WS-IND-TBL)
      *
           IF SW-SI-SUB-COBERTU

              IF (WS-PAGCOB = 1 AND ITERACION <= 84) OR
                 (WS-PAGCOB = 2)
                 COMPUTE WS-SALDO-2    = WS-SALDO-1 + WS-CAPITAL-1
                 COMPUTE WS-COBERTURA =
              (WS-SALDO-2 * (((1 + (WS-PORCOBE / 100)) ** (1/12)) - 1))
                 MOVE WS-COBERTURA         TO WS-G662-PRISEGU
                                          TBLA-VALOR-SEGURO(WS-IND-TBL)
      *COL11-I
                 IF SW-CREDITOVIRTUAL-SI
                   IF TBLA-TIPIDEN = CTE-3
                    MOVE ZEROS             TO WS-G662-PRISEGU
                                          TBLA-VALOR-SEGURO(WS-IND-TBL)
                   END-IF
                 END-IF
      *COL11-F
                 ADD  WS-COBERTURA         TO WS-ACC-COBERTU
                 COMPUTE WS-RECIBO-1 = WS-RECIBO-1 - WS-COBERTURA
              END-IF
           ELSE
              IF SW-SI-SUB-COBLH
                 COMPUTE WS-SALDO-2  = WS-SALDO-1 + WS-CAPITAL-1
                    COMPUTE WS-SALDO-3  = WS-SALDO-2 + WS-VR-OPCOMP
                 COMPUTE WS-COBERTURA =
              (WS-SALDO-3 * (((1 + (WS-PORCOBE / 100)) ** (1/12)) - 1))
                 MOVE WS-COBERTURA         TO WS-G662-PRISEGU
                                          TBLA-VALOR-SEGURO(WS-IND-TBL)
      *COL11-I
                 IF SW-CREDITOVIRTUAL-SI
                   IF TBLA-TIPIDEN = CTE-3
                    MOVE ZEROS             TO WS-G662-PRISEGU
                                          TBLA-VALOR-SEGURO(WS-IND-TBL)
                   END-IF
                 END-IF
      *COL11-F
