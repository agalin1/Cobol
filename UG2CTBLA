      * COL09-I
      *================================================================*
      * 20100-VALIDAR-ADV                                              *
      * SE REALIZA UNA CONSULTA SELECT A LA TABLA UGDTT37.             *
      *================================================================*
       20100-VALIDAR-ADV.
      *
           INITIALIZE UGTCT37
      *
           MOVE CTE-9976                   TO T37-SECCION
           MOVE TBLA-PROSUB                TO T37-ELEMENTO(1:4)
      *
           EXEC SQL
                SELECT RESTO
                  INTO :T37-RESTO
                  FROM UGDTT37
                 WHERE SECCION  = :T37-SECCION
                   AND ELEMENTO = :T37-ELEMENTO
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK
              SET SI-ADV                   TO TRUE
           ELSE
              SET NO-ADV                   TO TRUE
           END-IF.
      * COL09-F
      * -------------------------------------------------------------- *
      *COL11-I
      ******************************************************************
      *                      LLAMA-RUTINA-UR2CIT37                     *
      * LLAMA A LA RUTINA UR2CIT3 PARA SABER SI LOS SUBPRODUCTOS CON   *
      * LOS QUE SE ESTAN HACIENDO LA SIMULACION SON DE CREDITO VIRTUAL *
      ******************************************************************
       LLAMA-RUTINA-UR2CIT37.
      *
           INITIALIZE UGWCIT37-REG
           SET SW-CREDITOVIRTUAL-NO         TO TRUE
           MOVE '9101'                      TO IT37-SECCION
           MOVE WS-SUBPRODUCTO              TO IT37-ELEMENTO(01:04)
           MOVE 'D'                         TO IT37-CICS
      *
           EXEC CICS
                LINK PROGRAM(BBVA-UR2CIT37)
                COMMAREA(UGWCIT37-REG-1)
                NOHANDLE
           END-EXEC
      *
           EVALUATE IT37-CODRETORNO
             WHEN CTE-00
                  SET SW-CREDITOVIRTUAL-SI  TO TRUE
             WHEN CTE-10
                  SET SW-CREDITOVIRTUAL-NO  TO TRUE
             WHEN OTHER
               MOVE IT37-CODRETORNO         TO TBLA-CODRETO
               MOVE 'UGE0939'               TO TBLA-CODERROR
               MOVE IT37-VAR1-ERROR         TO TBLA-DESCRIP1
               MOVE IT37-VAR2-ERROR         TO TBLA-DESCRIP2
               PERFORM 30000-FINAL
           END-EVALUATE
           .
      *
      ******************************************************************
      *                        VALIDA-TIPO-TASA                        *
      * SOLO PARA CREDITO VIRTUAL VALIDA SI EL TRAMO 101 NO EXISTE, EN *
      * CASO DE QUE EL SUBPRODUCTO NO TENGA TRAMO 101 BUSCA EL TRAMO   *
      * 102 PARA OBTENER LA TASA POLITICA DE AHI.                      *
      ******************************************************************
       VALIDA-TIPO-TASA.
           INITIALIZE UGTCLQS
           MOVE '101'                        TO LQS-CODCONLI
           PERFORM CONSULTA-LQS-101
           IF DB2-NOTFND
              INITIALIZE UGTCLQS
              MOVE '102'                     TO LQS-CODCONLI
              PERFORM CONSULTA-LQS-101
           END-IF
           .
      *
      ******************************************************************
      *                       CONSULTA-LQS-101                         *
      * SE REALIZA UN SELECT EN LA TABLA UGDTLQS POR EL SUBPRODUCTO Y  *
      * EL TRAMO 101 PARA OBTENER LA TASA POLITICA DEL SUBPRODUCTO QUE *
      * ES EL CAMPO LQS-TIPOAPLI EN LA TABLA Y MOVERLO A VARIABLE DE   *
      * TASA EFECTIVA                                                  *
      ******************************************************************
       CONSULTA-LQS-101.
           MOVE TBLA-FESOLIC                 TO LQS-FECOVALI
           MOVE '96'                         TO LQS-PRODUCTO
           MOVE WS-SUBPRODUCTO               TO LQS-SUBPRO
           EXEC SQL
              SELECT  TIPOAPLI
                INTO :LQS-TIPOAPLI
                FROM  UGDTLQS
              WHERE PRODUCTO =  :LQS-PRODUCTO
                AND SUBPRO   =  :LQS-SUBPRO
                AND CODCONLI =  :LQS-CODCONLI
                AND FECOVALI <= :LQS-FECOVALI
                AND FEFIVALI >= :LQS-FECOVALI
           END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              IF LQS-CODCONLI = '101'
                 MOVE LQS-TIPOAPLI            TO WS-EFECTIVA-CV
              ELSE
                IF LQS-CODCONLI = '102'
                   PERFORM SELECT-TABLA-UGDTRFI
                   COMPUTE WS-TIPOAPLI-PORC = (1 + (LQS-TIPOAPLI / 100))
                   COMPUTE WS-UGTIPINT-PORC = (1 + (RFI-UGTIPINT / 100))
                   COMPUTE WS-SUMA-TASA = ((WS-TIPOAPLI-PORC *
                   WS-UGTIPINT-PORC) - 1)
                   COMPUTE WS-VTU-PORC-CV = WS-SUMA-TASA * 100
                   MOVE WS-VTU-PORC-CV        TO WS-EFECTIVA-CV
                END-IF
              END-IF
           ELSE
             IF DB2-NOTFND AND SQLWARN0 = SPACES
                IF LQS-CODCONLI = '101'
                   CONTINUE
                ELSE
                  IF LQS-CODCONLI = '102'
                     MOVE FIN-TIPINT          TO WS-EFECTIVA-CV
                  END-IF
                END-IF
             ELSE
                MOVE '99'                     TO TBLA-CODRETO
                MOVE 'UGE0939'                TO TBLA-CODERROR
                MOVE 'ERROR EN SELECT UGDT'   TO TBLA-DESCRIP1
                MOVE 'LQS: '                  TO TBLA-DESCRIP2(01:05)
                MOVE DB2-RETURN-CDE           TO TBLA-DESCRIP2(06:)
                PERFORM 999999-ABEND-DB2
             END-IF
           END-IF
           .
      *
      ******************************************************************
      *                    SELECT-TABLA-UGDTRFI                        *
      * REALIZA UN SELECT DE LA TABLA UGDTRFI PARA TRAER EL VALOR DE   *
      * LA TASA DEL DTF.                                               *
      ******************************************************************
       SELECT-TABLA-UGDTRFI.
      *
           INITIALIZE UGTCRFI
           MOVE TBLA-FESOLIC                 TO RFI-FECOVALI
           MOVE 'DTF'                        TO RFI-UGIDXREF

           EXEC SQL
              SELECT  UGTIPINT
                INTO :RFI-UGTIPINT
                FROM  UGDTRFI
              WHERE UGIDXREF =  :RFI-UGIDXREF
                AND FECOVALI <= :RFI-FECOVALI
                AND FEFIVALI >= :RFI-FECOVALI
           END-EXEC

           MOVE SQLCODE                       TO DB2-RETURN-CDE

           IF DB2-OK AND SQLWARN0 = SPACES
              CONTINUE
           ELSE
             IF DB2-NOTFND AND SQLWARN0 = SPACES
                CONTINUE
             ELSE
                MOVE '99'                     TO TBLA-CODRETO
                MOVE 'UGE0939'                TO TBLA-CODERROR
                MOVE 'ERROR EN SELECT UGDT'   TO TBLA-DESCRIP1
                MOVE 'LQS: '                  TO TBLA-DESCRIP2(01:05)
                MOVE DB2-RETURN-CDE           TO TBLA-DESCRIP2(06:)
                PERFORM 999999-ABEND-DB2
             END-IF
           END-IF
           .
