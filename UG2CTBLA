      *
           EVALUATE COT-CODIGO
              WHEN CTE-CON-01-A
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE CTE-CON-UGE0331         TO TBLA-CODERROR
                 PERFORM  30000-FINAL
              WHEN CTE-CON-98
                 PERFORM 21711-REBOSAMIENTO
              WHEN '47'
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE 'UGE0939'               TO TBLA-CODERROR
                 MOVE 'ERROR TABLA      '     TO TBLA-DESCRIP1
                 MOVE 'CORPORATIVA 552'       TO TBLA-DESCRIP2
                 PERFORM  30000-FINAL
              WHEN '48'
                 MOVE 'UGE0939'               TO TBLA-CODERROR
                 MOVE 'ERROR TABLA      '     TO TBLA-DESCRIP1
                 MOVE 'CORPORATIVA 552'       TO TBLA-DESCRIP2
                 PERFORM  30000-FINAL
              WHEN CTE-CON-99
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE CTE-CON-UGE0298         TO TBLA-CODERROR
                 PERFORM  30000-FINAL
           END-EVALUATE.
      *
      *================================================================*
      *    AJUSTE PARA LAS CUOTAS DE LOS MESES 6 Y 12                  *
      *================================================================*
           IF COT-TIP-CUOTA = 'I'
              OR COT-TIP-CUOTA = 'K'
              IF COT-F-AMORTI(6:2) = '06' OR '12'
                 IF COT-TIPO-CAR = 'H'
                    COMPUTE COT-CUOTA = COT-CUOTA * COT-FACTOR-A
                 ELSE
                    COMPUTE COT-CUOTA = COT-CUOTA * 2
                    END-COMPUTE
                 END-IF
              END-IF
           END-IF.
           IF (COT-TIPO-CAR = 'H' AND COT-TIP-CUOTA = 'I') OR
               COT-TIP-CUOTA = 'K'
              IF COT-F-AMORTI(6:2) = '06' OR '12'
                 IF COT-F-AMORTI(1:7) = COT-F-FORMA(1:7)
                    COMPUTE COT-CUOTA = COT-CUOTA / COT-FACTOR-A
                    MOVE 'S'             TO WS-IND-GRACIA
                 END-IF
              END-IF
           END-IF
           IF PRO-IND-MARCA2 = 'R'
              PERFORM 2421-AJUSTA-CUOTA
           END-IF.
           IF WS-CUOTA-CAPITAL AND WS-BAND-FIN = 1
              COMPUTE WS-CAPITAL-ENT ROUNDED = COT-CUOTA
              MOVE WS-CAPITAL-ENT        TO COT-CUOTA
           END-IF.
      *
      *================================================================*
      * SE DETERMINA SI SE DEBE O NO AJUSTAR LA CUOTA DE UN REDESCUENTO*
      *================================================================*
       2421-AJUSTA-CUOTA.
           COMPUTE WS-CUOTA-RED ROUNDED = COT-CUOTA * 1
           MOVE WS-CUOTA-RED     TO COT-CUOTA.
      *
      *================================================================*
      *                                                                *
      *             26-MOVER-RUT-PANT.                              *
      *                                                                *
      *    MUEVEN LOS DATOS DEVUELTOS POR LA RUTINA A LA PANTALLA      *
      *    TENIENDO EN CUENTA DE SI EL IMPORTE ESTABA O NO INFORMADO   *
      *    YA QUE LA RUTINA SI SE LE INFORMA EL CAPITAL DEVUELVE       *
      *    EN DICHO CAMPO EL CAPITAL CORREGIDO.                        *
      *                                                                *
      *================================================================*
       26-MOVER-RUT-PANT.
      *
           IF TBLA-IMPCONC-ALF = (LOW-VALUES OR SPACES) OR
              TBLA-IMPCONC    = ZEROS
              MOVE COT-CAPITAL                TO TBLA-IMPCONC
           END-IF
      *
           MOVE COT-INT-NOMINAL               TO TBLA-TIPOINT.
      *
      *================================================================*
      *                  27-CALCULA-INT-LEASING                        *
      *================================================================*
       27-CALCULA-INT-LEASING.
           INITIALIZE URWCFIN

           MOVE WS-TASA-NOMINAL               TO FIN-TIPINT
           MOVE 'N'                           TO FIN-TIPOTASA

           PERFORM 28331111-CALCULAR-DIAS

           MOVE '1001'                        TO FIN-PERCAPIT
           MOVE WS-PERINT                     TO FIN-PERINT
           MOVE ADS-DIASCAL                   TO FIN-DIASCAL
           MOVE WS-VR-OPCOMP                  TO FIN-CAPITAL
           MOVE WS-DIAS                       TO FIN-PERIODO-NUM

           IF WS-DIAS < 1000
              MOVE CTE-ALFA-1                 TO FIN-PERIODO-TIP
           ELSE
              IF WS-DIAS > 999 AND < 2000
                 MOVE CTE-ALFA-6              TO FIN-PERIODO-TIP
              END-IF
              IF WS-DIAS > 1999 AND < 3000
                 MOVE CTE-ALFA-7              TO FIN-PERIODO-TIP
              END-IF
              IF WS-DIAS > 2999 AND < 4000
                 MOVE CTE-ALFA-8              TO FIN-PERIODO-TIP
              END-IF
           END-IF

           CALL BBVA-UR8CFIN0 USING URWCFIN

           PERFORM 2217211121-EVALUAR-COD-RET

           COMPUTE WS-CUOTA-ACTUAL = WS-CUOTA-ACTUAL + FIN-INTERES.
      *================================================================*
      *             28-IMPRIMIR                                        *
