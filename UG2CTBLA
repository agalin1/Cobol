           MOVE WS-DATE-SCREEN-ANNO          TO WS-FECHA-LBR-AAAA
           MOVE WS-DATE-SCREEN-MES           TO WS-FECHA-LBR-MM
           MOVE WS-DATE-SCREEN-DIA           TO WS-FECHA-LBR-DD.
      *
           IF WS-DATE-SCREEN-DIA < CNL-DIA-VCTO
              ADD 1                          TO WS-FECHA-LBR-MM
              IF WS-FECHA-LBR-MM > 12
                 MOVE 1                      TO WS-FECHA-LBR-MM
                 ADD 1                       TO WS-FECHA-LBR-AAAA
              END-IF
           END-IF
      *
           MOVE CNL-DIA-VCTO                  TO WS-FECHA-LBR-DD.
           MOVE CNL-DIA-VCTO                  TO WS-DATE-SCREEN-DIA.
      *
      *================================================================*
      *             20211-VALIDAR-SUBPRO                               *
      * VALIDA EL SUBPRODUCTO, DEBE ESTAR DADO DE ALTA EN LA TABLA DE  *
      * PRODUCTOS.                                                     *
      *================================================================*
       20211-VALIDAR-SUBPRO.
      *
      *================================================================*
      *  SE COMPRUEBA QUE EL SUBTIPO DE PRODUCTO EXISTE Y ESTA ACTIVO  *
      *================================================================*
           PERFORM  20212-ACCESO-TBL-UGDTPRO
      *
      *================================================================*
      * SE ACCESA AL LQS PARA OBTENER PORTES Y GAST.ADM                *
      *================================================================*
           PERFORM  20214-PORTES-GASADM.
      *
      *================================================================*
      *             20212-ACCESO-TBL-UGDTPRO                         *
      *    SE ACCEDE A LA TABLA DE SUBPRODUCTOS                        *
      *================================================================*
       20212-ACCESO-TBL-UGDTPRO.
      *
           MOVE WS-PRODUCTO                TO PRO-PRODUCTO
           MOVE WS-SUBPRODUCTO             TO PRO-SUBPRO
      *
           EXEC SQL
              SELECT  TEXTORED,
                      PLAZOMAX,
                      PLAZOMIN,
                      IMPMAXGE,
                      FECOVALI,
                      FEFIVALI,
                      PORINMIN,
                      PORINMAX,
                      MONEDA,
                      IMPMINGE,
                      UGYSEASO,
                      INDEALER,
                      LIBRE_CAR1,
                      IND_MARCA2,
                      INDISSU,
                      LIBRE_IMP1,
                      LIBRE_IMP2
                INTO :PRO-TEXTORED,
                     :PRO-PLAZOMAX,
                     :PRO-PLAZOMIN,
                     :PRO-IMPMAXGE,
                     :PRO-FECOVALI,
                     :PRO-FEFIVALI,
                     :PRO-PORINMIN,
                     :PRO-PORINMAX,
                     :PRO-MONEDA,
                     :PRO-IMPMINGE,
                     :PRO-UGYSEASO,
                     :PRO-INDEALER,
                     :PRO-LIBRE-CAR1,
                     :PRO-IND-MARCA2,
                     :PRO-INDISSU,
                     :PRO-LIBRE-IMP1,
                     :PRO-LIBRE-IMP2
                 FROM UGDTPRO
                WHERE SUBPRO   = :PRO-SUBPRO       AND
                      PRODUCTO = :PRO-PRODUCTO
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           EVALUATE TRUE
             WHEN DB2-OK
               PERFORM 20212-VALIDACIONES
             WHEN DB2-NOTFND
      *@COL01-I
      *        MOVE '20212-ACCESO-TBL-UGD' TO WTRC0-PARRAFO
      *        MOVE 'ERR NOT FOUND DTPRO ' TO WTRC0-DESCRIPCION
      *        MOVE SPACES                 TO WTRC0-VALOR-ALF
      *        PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
               MOVE '30'                    TO TBLA-CODRETO
               MOVE CTE-CON-UGE0204        TO TBLA-CODERROR
               PERFORM 30000-FINAL
             WHEN OTHER
      *@COL01-I
      *        MOVE '20212-ACCESO-TBL-UGD' TO WTRC0-PARRAFO
      *        MOVE 'ERROR DB2           ' TO WTRC0-DESCRIPCION
      *        MOVE SQLCODE                TO WTRC0-VALOR-ALF
      *        PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
               MOVE 'UGDTPRO'              TO TBLA-DESCRIP1
               PERFORM 999999-ABEND-DB2
           END-EVALUATE.
      *
      *================================================================*
      *             20212-VALIDACIONES                                 *
      *================================================================*
       20212-VALIDACIONES.
      *
      *    ============================================================*
      *    = EL SUBPRODUCTO DEBE ESTAR ACTIVO EN LA FECHA ACTUAL.      *
      *    ============================================================*
           IF PRO-FECOVALI > WS-DATE-DB2 OR
              PRO-FEFIVALI < WS-DATE-DB2
              MOVE '30'                    TO TBLA-CODRETO
              MOVE 'UGE0218'               TO TBLA-CODERROR
              PERFORM 30000-FINAL
           END-IF
      *
           IF PRO-INDISSU = 'R'
      *COL11-I
            IF SW-CREDITOVIRTUAL-SI
               CONTINUE
            ELSE
      *COL11-F
              MOVE '30'                    TO TBLA-CODRETO
              MOVE 'UGE2140'               TO TBLA-CODERROR
              MOVE 'SIMULACION'            TO TBLA-DESCRIP1
              PERFORM 30000-FINAL
      *COL11-I
            END-IF
      *COL11-F
           END-IF
      *
      *    ============================================================*
      *    = SE RECUPERAN CONDICIONES DE ADMINISTRACION ESTANDARES     *
      *    = ACTIVAS ASOCIADAS AL PRODUCTO DE LA TABLA UGDTADS         *
      *    ============================================================*
      *
           MOVE WS-DATE-DB2                TO ADS-FECOVALI
      *
           PERFORM 20213-ACCEDER-TABLA-UADS
      *
           IF ADS-CODTIAMO  EQUAL 'X'
             MOVE '30'                    TO TBLA-CODRETO
             MOVE 'UGE0939'                TO TBLA-CODERROR
             MOVE 'SIM. NO VALIDA '        TO TBLA-DESCRIP1
             MOVE 'PARA CUADRO MAN'        TO TBLA-DESCRIP2
             PERFORM 30000-FINAL
           END-IF
      *
           IF ADS-CODTIAMO  EQUAL 'E'
             MOVE '30'                    TO TBLA-CODRETO
             MOVE 'UGE0939'                TO TBLA-CODERROR
             MOVE 'SIM. NO VALIDA '        TO TBLA-DESCRIP1
             MOVE 'AMORT ARITMETICA'       TO TBLA-DESCRIP2
             PERFORM 30000-FINAL
           END-IF
      *    ============================================================*
      *    = SI EL TIPODIAS ES DISTINTO DE 1, 2, 3 O 4 NO SE REALIZA   *
      *    = SIMULACION.                                               *
      *    ============================================================*
           IF ADS-TIPODIAS NOT = (CTE-CON-1 AND  CTE-CON-2 AND
                                  CTE-CON-3 AND CTE-CON-4)
             MOVE '30'                    TO TBLA-CODRETO
             MOVE CTE-CON-UGE0100          TO TBLA-CODERROR
             PERFORM 30000-FINAL
           END-IF
      *
           MOVE ADS-CODTIAMO               TO WS-TIPO-CUOTA
           MOVE CTE-CON-FECHA-DEFECTO      TO WS-FECOVALI
      *
           IF ADS-PROGARIT  NOT = ZEROS
             MOVE ADS-PROGARIT             TO WS-RAZON
           ELSE
             IF ADS-PROGGEOM NOT = ZEROS
               MOVE ADS-PROGGEOM           TO WS-RAZON
             END-IF
           END-IF.
      *
      *================================================================*
      *             20213-ACCEDER-TABLA-UADS                           *
      * ACCESO A LA TABLA DE CONDICIONES DE ADMINISTRACION ESTANDARES  *
      *================================================================*
       20213-ACCEDER-TABLA-UADS.
      *
           MOVE WS-PRODUCTO                TO ADS-PRODUCTO
           MOVE WS-SUBPRODUCTO             TO ADS-SUBPRO
      *
           EXEC SQL
              SELECT PERCAP,
                     PERINT,
                     CODTIAMO,
                     DIASCAL,
                     PROGARIT,
                     PROGGEOM,
                     TIPODIAS,
                     INDSUBVE,
                     ENTSUB,
                     CONSUB,
                     LININCUO,
                     CARECAP,
                     CAREINT,
                     UGCDIPAG,
                     INDINVAR,
                     CODTIPRE,
                     ISUMCOM,
                     INDINANT
               INTO :ADS-PERCAP,
                    :ADS-PERINT,
                    :ADS-CODTIAMO,
                    :ADS-DIASCAL,
                    :ADS-PROGARIT,
                    :ADS-PROGGEOM,
                    :ADS-TIPODIAS,
                    :ADS-INDSUBVE,
                    :ADS-ENTSUB,
                    :ADS-CONSUB,
                    :ADS-LININCUO,
                    :ADS-CARECAP,
                    :ADS-CAREINT,
                    :ADS-UGCDIPAG,
                    :ADS-INDINVAR,
                    :ADS-CODTIPRE,
                    :ADS-ISUMCON,
                    :ADS-INDINANT
                FROM UGDTADS
               WHERE PRODUCTO = :ADS-PRODUCTO    AND
                     SUBPRO   = :ADS-SUBPRO      AND
                    FECOVALI <= :ADS-FECOVALI    AND
                    FEFIVALI >= :ADS-FECOVALI
           END-EXEC
      *
           MOVE SQLCODE                    TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE ADS-DIASCAL             TO WS-DIASCAL
           END-IF
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
             MOVE '30'                    TO TBLA-CODRETO
             MOVE 'UGE0146'                TO TBLA-CODERROR
             PERFORM      30000-FINAL
           ELSE
             IF NOT DB2-OK
                MOVE 'UGDTADS'             TO TBLA-DESCRIP1
                PERFORM 999999-ABEND-DB2
             END-IF
           END-IF.
      *
      *================================================================*
      *                    20212-VALIDAR-GRACIA-CEI                    *
      * ACCESO A LA TABLA UGDTT37, SECCION 1021, MANEJO DE GRACIA PARA *
      * CAPITAL E INTERESES.                                           *
      *================================================================*
       20212-VALIDAR-GRACIA-CEI.
      *
      *@COL01-I
      *    MOVE '20212-VALIDAR-GRACIA'     TO WTRC0-PARRAFO
      *    MOVE 'RESTO 2             '     TO WTRC0-DESCRIPCION
      *    MOVE SPACES                     TO WTRC0-VALOR-ALF
      *    PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
      *
           INITIALIZE UGTCT37
      *
           MOVE '1021'                      TO T37-SECCION
           MOVE TBLA-PROSUB                 TO T37-ELEMENTO
      *
           EXEC SQL
                SELECT RESTO
                INTO  :T37-RESTO
                FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                      ELEMENTO = :T37-ELEMENTO
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-OK
              MOVE T37-RESTO(3:2)             TO WS-PRDO-GRCIA
              MOVE T37-RESTO(1:4)             TO WS-CARECAP
              MOVE T37-RESTO(5:1)             TO WS-INT-CAPITALIZABLES
           ELSE
              IF DB2-NOTFND
                 MOVE ZEROS                   TO WS-PRDO-GRCIA
                 MOVE SPACES                  TO WS-INT-CAPITALIZABLES
              ELSE
                 MOVE 'UGDTT37'            TO TBLA-DESCRIP1
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *
      *================================================================*
      *             20213-VALIDAR-IMPCONCE                             *
      * SE VALIDA QUE ESTE INFORMADO O BIEN EL CAPITAL SOLICITADO      *
      *================================================================*
       20213-VALIDAR-IMPCONCE.
      *
           IF TBLA-IMPCONC IS NOT NUMERIC AND
              (TBLA-IMPCONC-ALF NOT = (LOW-VALUES AND SPACES) AND
              TBLA-IMPCONC NOT = ZEROS)
      *@COL01-I
      *       MOVE '20213-VALIDAR-IMPCON'  TO WTRC0-PARRAFO
      *       MOVE 'INFORMAR MONTO      '  TO WTRC0-DESCRIPCION
      *       MOVE SPACES                  TO WTRC0-VALOR-ALF
      *       PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
              MOVE '30'                    TO TBLA-CODRETO
              MOVE CTE-CON-UGE0229         TO TBLA-CODERROR
              PERFORM 30000-FINAL
           END-IF
      *
      *================================================================*
      *    EL IMPORTE SOLICITADO DEBE COMO MINIMO EL INFORMADO EN      *
      *    LA UGDTPRO                                                  *
      *================================================================*
           IF  TBLA-IMPCONC < PRO-IMPMINGE
             MOVE  PRO-IMPMINGE            TO DS-INTERES-CUOTA
             MOVE '30'                    TO TBLA-CODRETO
             MOVE 'UGE2085'                TO TBLA-CODERROR
             MOVE DS-INTERES-CUOTA         TO TBLA-DESCRIP1
      *@COL01-I
      *      MOVE '20213-VALIDAR-IMPCON'   TO WTRC0-PARRAFO
      *      MOVE 'MONTO NO SUPERA MINI'   TO WTRC0-DESCRIPCION
      *      MOVE DS-INTERES-CUOTA         TO WTRC0-VALOR-ALF
      *      PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
             PERFORM 30000-FINAL
           END-IF
      *
      *================================================================*
      *    SE VALIDA QUE ESTE INFORMADO EL CAPITAL SOLICITADO SI SE    *
      *    TRATA DE FORMULA B                                          *
      *================================================================*
           IF ADS-CODTIAMO = 'B' AND
              TBLA-IMPCONC-ALF = (LOW-VALUES OR ZEROS OR SPACES)
              MOVE '30'                    TO TBLA-CODRETO
              MOVE CTE-CON-UGE0031         TO TBLA-CODERROR
              PERFORM 30000-FINAL
           END-IF.
      *
      *================================================================*
      *             20214-VALIDAR-TIPOINT-TAE                          *
      *   SE VALIDAN EL TIPO DE INTERES Y LA TASA EFECTIVA.            *
      *================================================================*
       20214-VALIDAR-TIPOINT-TAE.
      *
      *    ============================================================*
      *    = VALIDAMOS QUE NO SE INFORMEN AMBAS TASAS DE INTERES.
      *    ============================================================*
           IF  (TBLA-TAE-ALF NOT = (LOW-VALUES AND ZEROS AND SPACES ))
           AND (TBLA-TIPOINT-ALF NOT = (LOW-VALUES AND
                                       ZEROS AND SPACES ))
              MOVE 'UGE0939'                  TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              MOVE 'INFORMAR SOLO UNA'        TO TBLA-DESCRIP1
              MOVE 'TASA DE INTERES'          TO TBLA-DESCRIP2
      *@COL01-I
      *       MOVE '20214-VALIDAR-TIPOIN'  TO WTRC0-PARRAFO
      *       MOVE 'INFORMAR SOLO 1 TASA'  TO WTRC0-DESCRIPCION
      *       MOVE SPACES                  TO WTRC0-VALOR-ALF
      *       PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
              PERFORM 30000-FINAL
           END-IF.
      *
      *    ============================================================*
      *    = SI NO SE INFORMA LA TASA NOMINAL, NI LA TASA ANUAL EFECTI.*
      *    = SE GENERA ERROR.                                          *
      *    ============================================================*
           IF (TBLA-TIPOINT-ALF     = LOW-VALUES  OR SPACES ) AND
              (TBLA-TAE-ALF         = LOW-VALUES  OR SPACES )
              MOVE 'UGE0939'                  TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              MOVE 'INFORMAR UNA DE  '        TO TBLA-DESCRIP1
              MOVE 'LAS DOS TASAS. '          TO TBLA-DESCRIP2
      *@COL01-I
      *       MOVE '20214-VALIDAR-TIPOIN'  TO WTRC0-PARRAFO
      *       MOVE 'INFORMAR UNA TASA   '  TO WTRC0-DESCRIPCION
      *       MOVE SPACES                  TO WTRC0-VALOR-ALF
      *       PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
              PERFORM 30000-FINAL
           END-IF.
      *
      *================================================================*
      *             20215-VALIDAR-PERINT                             *
      *   SE VALIDAN LA PERIODICIDAD DE INTERES.                       *
      *================================================================*
       20215-VALIDAR-PERINT.
      *
           MOVE ADS-PERINT                TO WS-PERINT
           MOVE CTE-CON-TIPO-PERINT       TO COD-TIPO
           MOVE WS-PERINT                 TO COD-CODIGO
           PERFORM  2151-ACCEDER-TABLA-UCOD
           MOVE COD-DESCRRED              TO WS-DESPERI.
      *
      *================================================================*
      *             2151-ACCEDER-TABLA-UCOD                           *
      *   SE ACCEDE A LA TABLA DE CODIGOS                              *
      *================================================================*
       2151-ACCEDER-TABLA-UCOD.
      *
           EXEC SQL
                  SELECT  DESCRRED
                    INTO :COD-DESCRRED
                    FROM  UGDTCOD
                   WHERE  TIPO   = :COD-TIPO      AND
                          CODIGO = :COD-CODIGO
           END-EXEC
      *
           MOVE SQLCODE                       TO DB2-RETURN-CDE
      *
           IF DB2-NOTFND AND SQLWARN0 = SPACES
              MOVE WS-DESC-INEX               TO COD-DESCRRED
           ELSE
              IF NOT DB2-OK OR SQLWARN0 NOT = SPACES
                 MOVE 'UGDTCOD'               TO TBLA-DESCRIP1
                    PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *
      *================================================================*
      *                                                                *
      *             20216-VALIDAR-PERCAP                               *
      *                                                                *
      *   SE VALIDAN LA PERIODICIDAD DE CAPITAL.                       *
      *                                                                *
      *================================================================*
       20216-VALIDAR-PERCAP.
      *
           MOVE ADS-PERCAP                 TO WS-PERCAP
           MOVE CTE-CON-TIPO-PERCAP        TO COD-TIPO
           MOVE WS-PERCAP                  TO COD-CODIGO
           PERFORM  2151-ACCEDER-TABLA-UCOD
           MOVE COD-DESCRRED               TO WS-DESPERC
      *
           MOVE ADS-CODTIAMO               TO CTE-CON-CODTIAMO
      *
           IF CTE-CODTIAMO-CAP-MAS-INT
              IF WS-PERCAP NOT EQUAL WS-PERINT
                 MOVE WS-PRODUCTO          TO CTE-PRO-CODTIAMO-MODIF
                 IF CTE-PRO-CODTIAMO-MODIF-SI
                     PERFORM XXX-EVALUAR-TIPO-CUOTA
                 ELSE
                     MOVE 'UGE0224'        TO TBLA-CODERROR
                     MOVE '30'                    TO TBLA-CODRETO
                     PERFORM 30000-FINAL
                 END-IF
              END-IF
           END-IF.
      *
      *================================================================*
      *               20217-CONVERTIR-LININCUO                         *
      *   SE CALCULA EL LININCUO EQUIVALENTE CON LA PERIODICIDAD DE    *
      *   CAPITAL ELEGIDA AL QUE HABIA PARA EL SUBPRODUCTO.            *
      *================================================================*
       20217-CONVERTIR-LININCUO.
      *
           MOVE WS-PERCAP                     TO WS-CODIGO-PERIODO
      *
           MULTIPLY WS-PERIODO BY WS-CONVERSION-DIAS(WS-CODIGO)
               GIVING WS-PERCAP-DIAS-1
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           MOVE ADS-PERCAP                    TO WS-CODIGO-PERIODO
      *
           MULTIPLY WS-PERIODO BY WS-CONVERSION-DIAS(WS-CODIGO)
               GIVING WS-PERCAP-DIAS-2
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           IF WS-PERCAP-DIAS-1 > WS-PERCAP-DIAS-2
              MOVE WS-PERCAP-DIAS-1           TO WS-DIVIDENDO
              MOVE ADS-PERCAP                 TO WS-DIV-ENTRADA-2
           ELSE
              MOVE WS-PERCAP-DIAS-2           TO WS-DIVIDENDO
              MOVE WS-PERCAP                  TO WS-DIV-ENTRADA-2
           END-IF
      *
           PERFORM 21722-DIVISIBILIDAD-2
      *
           IF WS-RESTO NOT = ZERO
              MOVE 'UGE0748'                  TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              PERFORM  30000-FINAL
           END-IF
      *
           IF WS-PERCAP-DIAS-1 > WS-PERCAP-DIAS-2
               IF WS-COCIENTE > ADS-LININCUO
                  MOVE 'UGE0748'              TO TBLA-CODERROR
                  MOVE '30'                    TO TBLA-CODRETO
                  PERFORM  30000-FINAL
               ELSE
                  DIVIDE ADS-LININCUO BY WS-COCIENTE
                      GIVING ADS-LININCUO
               END-IF
           ELSE
               MULTIPLY ADS-LININCUO BY WS-COCIENTE
                  GIVING ADS-LININCUO
           END-IF.
      *
      *================================================================*
      *             20219-VALIDAR-PLAZO                              *
      *   SE VALIDA EL PLAZO. DEBE EXISTIR EN LA TABLA DE CODIGOS      *
      *   Y SER MULTIPLO DE LA PERIODICIDAD DE CAPITAL E INTERESES.    *
      *================================================================*
       20219-VALIDAR-PLAZO.
      *
      *================================================================*
      *    SE COMPRUEBA QUE EXISTE EN LA TABLA DE CODIGOS              *
      *================================================================*
           MOVE CTE-CON-TIPO-PLAZO            TO COD-TIPO
           MOVE TBLA-PLAZO                    TO COD-CODIGO
           PERFORM  2151-ACCEDER-TABLA-UCOD
      *
           IF DB2-NOTFND  AND SQLWARN0 = SPACES
              MOVE CTE-CON-UGE0141            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
COL07 *       MOVE 'PARA TERMINO TECLEAD'     TO TBLA-DESCRIP1
COL07         MOVE CTE-CON-TIPO-PLAZO         TO TBLA-DESCRIP1
COL07         MOVE TBLA-PLAZO                 TO TBLA-DESCRIP1(10:)
              PERFORM 30000-FINAL
           END-IF
      *
           MOVE COD-DESCRRED                  TO WS-DESPLAZ
      *
      *================================================================*
      *    SE COMPRUEBA QUE ESTA ENTRE LOS PLAZOS ADMITIDOS PARA       *
      *    EL SUBTIPO DE PRODUCTO SELECCIONADO                         *
      *================================================================*
           PERFORM  2171-TRANSFORMAR-DIAS
      *
           IF WS-PLAZO-MIN      > WS-PLAZO       OR
              WS-PLAZO-MAX      < WS-PLAZO
              MOVE CTE-CON-UGE0124            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              MOVE PRO-PLAZOMIN               TO TBLA-DESCRIP1
              MOVE PRO-PLAZOMAX               TO TBLA-DESCRIP2
              PERFORM 30000-FINAL
           END-IF
      *
           IF WS-PERCAP       NOT = SPACES AND
              WS-PERCAP       NOT = '999'
              PERFORM  2172-DIV-PERCAP
           ELSE
              MOVE CTE-CON-1                  TO WS-NUM-PERIODOS
           END-IF.
      *
      *================================================================*
      *  REGLA 78                                                      *
      *================================================================*
           IF WS-TIPO-CUOTA = CTE-CON-REGLA-78
              MOVE WS-NUM-PERIODOS            TO WS-UGNPLINI
                                                 WS-UGNPLPEN
           END-IF
      *
      *================================================================*
      *    SE COMPRUEBA QUE EL PLAZO ES DIVISIBLE POR LA PERIODICIDAD
      *    DE INTERESES.
      *================================================================*
           IF WS-PERINT NOT = SPACES AND   WS-PERINT NOT = '999'
               PERFORM  21725-DIV-PERINT
           END-IF
      *
           IF ADS-CODTIAMO = 'C'
              IF TBLA-PLAZO(1:1) NOT EQUAL '3'
                 MOVE 'UGE0939'               TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE 'INFORMAR PLAZO'        TO TBLA-DESCRIP1
                 MOVE 'EN ANIOS '             TO TBLA-DESCRIP2
                 PERFORM 30000-FINAL
              END-IF
      *
              MOVE WS-PERCAP(2:2)             TO WS-NUMERO-4
      *
              DIVIDE  3 INTO WS-NUMERO-4
                         GIVING    WS-COCIENTE-2
                         REMAINDER WS-RESTE-1
      *
              IF WS-PERCAP(1:1) NOT EQUAL '2' OR
                  WS-RESTE-1 NOT EQUAL ZERO
                 MOVE 'UGE0939'               TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE 'PER.DE CAPITAL'        TO TBLA-DESCRIP1
                 MOVE '= TRIMESTRAL. '        TO TBLA-DESCRIP2
                 PERFORM 30000-FINAL
              END-IF
           END-IF.
      *
      *================================================================*
      *                                                                *
      *             2171-TRANSFORMAR-DIAS                              *
      *                                                                *
      *    SE TRANSFORMA EN DIAS LOS PLAZOS MINIMO Y MAXIMO DEL        *
      *    PRODUCTO Y EL PLAZO DEL CONTRATO.                           *
      *                                                                *
      *================================================================*
       2171-TRANSFORMAR-DIAS.
      *
           MOVE PRO-PLAZOMIN                  TO WS-CODIGO-PERIODO-4
           MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
               GIVING WS-PLAZO-MIN
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           MOVE PRO-PLAZOMAX                  TO WS-CODIGO-PERIODO-4
           MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
               GIVING WS-PLAZO-MAX
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           MOVE TBLA-PLAZO                    TO WS-CODIGO-PERIODO-4
           MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
               GIVING WS-PLAZO
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY.
      *
      *================================================================*
      *                                                                *
      *                 21711-REBOSAMIENTO                             *
      *                                                                *
      *          SE FINALIZA LA EJECUCION POR REBOSAMIENTO EN LOS      *
      *          CALCULOS.                                             *
      *                                                                *
      *================================================================*
       21711-REBOSAMIENTO.
      *
           MOVE CTE-CON-UGE0297               TO TBLA-CODERROR
           MOVE '30'                    TO TBLA-CODRETO
           PERFORM  30000-FINAL.
      *
      *================================================================*
      *                                                                *
      *             2172-DIV-PERCAP                                    *
      *                                                                *
      *    SE COMPRUEBA QUE EL PLAZO ES MULTIPLO DE LAS PERIODICIDADES *
      *    DE CAPITAL Y DE INTERESES Y QUE ADEMAS LA LINEA DE          *
      *    INCREMENTO DE LA CUOTA ES DIVISOR DEL NUMERO DE PERIODOS.   *
      *                                                                *
      *================================================================*
       2172-DIV-PERCAP.
      *
           IF ADS-CODTIAMO EQUAL 'C'
              IF WS-CARECAP NOT EQUAL SPACES
                 IF WS-CARECAP(1:1) NOT EQUAL '3'
                    MOVE 'UGE0939'            TO TBLA-CODERROR
                    MOVE '30'                    TO TBLA-CODRETO
                    MOVE 'PARA AMOR.GRADUAL'  TO TBLA-DESCRIP1
                    MOVE 'GRACIA = ANUAL '    TO TBLA-DESCRIP2
                    PERFORM 30000-FINAL
                 END-IF
              END-IF
      *
              IF WS-CAREINT NOT EQUAL SPACES
                 IF WS-CAREINT NOT EQUAL '203'
                    MOVE 'UGE0939'            TO TBLA-CODERROR
                    MOVE '30'                    TO TBLA-CODRETO
                    MOVE 'PARA AMOR.GRADUAL'  TO TBLA-DESCRIP1
                      MOVE 'INT.GRAC = TRIMES'  TO TBLA-DESCRIP2
                      PERFORM 30000-FINAL
                 END-IF
               END-IF
           END-IF
      *
           IF ADS-CODTIAMO   = 'D'
              IF (WS-CARECAP   NOT EQUAL SPACES AND LOW-VALUES)
                 OR (WS-CAREINT NOT EQUAL SPACES AND LOW-VALUES)
                   MOVE 'UGE0939'             TO TBLA-CODERROR
                   MOVE '30'                    TO TBLA-CODRETO
                   MOVE 'AM.GEOMETRICA NO '   TO TBLA-DESCRIP1
                   MOVE 'PERMITE CARENCIA '   TO TBLA-DESCRIP2
                   PERFORM 30000-FINAL
              END-IF
           END-IF
      *
      *================================================================*
      *    SE COMPRUEBA QUE EL PLAZO MENOS LA CARENCIA DE CAPITAL ES
      *    DIVISIBLE DE LA PERIODICIDAD DE CAPITAL.
      *================================================================*
           MOVE WS-PERCAP                     TO WS-DIV-ENTRADA-2
      *
           IF ADS-CARECAP      NOT = SPACES
               MOVE TBLA-PLAZO                TO WS-SUB-ENTRADA-1
               MOVE ADS-CARECAP               TO WS-SUB-ENTRADA-2
               PERFORM  21721-SUSTRAER
               PERFORM  21722-DIVISIBILIDAD-2
           ELSE
               MOVE TBLA-PLAZO                TO WS-DIV-ENTRADA-1
               PERFORM  21723-DIVISIBILIDAD
           END-IF
      *
           MOVE WS-COCIENTE                   TO WS-NUM-PERIODOS
      *
           IF WS-RESTO NOT = ZERO
              MOVE CTE-CON-UGE0226            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              PERFORM 30000-FINAL
           ELSE
      *================================================================*
      *    SE COMPRUEBA QUE LA LINEA DE INCREMENTO DE CUOTA ES
      *    DIVISOR DEL PLAZO EN EL CASO EN QUE EL TIPO DE
      *    AMORTIZACION SEA SUCESIVA
      *================================================================*
              MOVE ADS-CODTIAMO               TO CTE-CON-CODTIAMO
              IF CTE-CODTIAMO-PERIODICA
                 PERFORM  21724-DIV-LININCUO
              END-IF
           END-IF.
      *
      *================================================================*
      *                                                                *
      *             21721-SUSTRAER                                    *
      *                                                                *
      *    ESTA RUTINA REALIZA LA RESTA   DE DOS CODIGOS CON FORMATO   *
      *    FORMATO XNN DONDE:                                          *
      *        - X   :  1 DIAS                                         *
      *                 2 MESES                                        *
      *                 3 A#OS                                         *
      *                                                                *
      *        - NN  :  NUMERO DE A#OS, MESES O DIAS                   *
      *                                                                *
      *                                                                *
      *================================================================*
       21721-SUSTRAER.
      *
           MOVE WS-SUB-ENTRADA-1              TO WS-CODIGO-PERIODO-4
           MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
               GIVING WS-MINUENDO
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           MOVE WS-SUB-ENTRADA-2              TO WS-CODIGO-PERIODO-4
           MULTIPLY WS-PERIODO-4  BY WS-CONVERSION-DIAS(WS-CODIGO-4)
               GIVING WS-SUSTRAENDO
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           IF WS-SUSTRAENDO >= WS-MINUENDO
              MOVE CTE-CON-UGE0235            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              PERFORM 30000-FINAL
           END-IF
      *
           SUBTRACT WS-SUSTRAENDO FROM WS-MINUENDO
               GIVING WS-DIVIDENDO
               ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
           END-SUBTRACT.
      *
      *================================================================*
      *                                                                *
      *             21722-DIVISIBILIDAD-2                             *
      *                                                                *
      *    ESTA RUTINA REALIZA LA DIVISON DE DOS CODIGOS TENIENDO      *
      *    EL SEGUNDO FORMATO XNN DONDE:                               *
      *        - X   :  1 DIAS                                         *
      *                 2 MESES                                        *
      *                 3 A#OS                                         *
      *                                                                *
      *        - NN  :  NUMERO DE A#OS, MESES O DIAS                   *
      *                                                                *
      *                                                                *
      *================================================================*
       21722-DIVISIBILIDAD-2.
      *
           MOVE WS-DIV-ENTRADA-2              TO WS-CODIGO-PERIODO
           MULTIPLY WS-PERIODO BY WS-CONVERSION-DIAS(WS-CODIGO)
               GIVING WS-DIVISOR
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           DIVIDE WS-DIVIDENDO BY WS-DIVISOR
               GIVING WS-COCIENTE
               REMAINDER WS-RESTO
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-DIVIDE.
      *
      *================================================================*
      *                                                                *
      *             21723-DIVISIBILIDAD                               *
      *                                                                *
      *    ESTA RUTINA REALIZA LA DIVISON DE DOS CODIGOS CON           *
      *    FORMATO XNN/N DONDE:                                        *
      *        - X   :  1 DIAS                                         *
      *                 2 MESES                                        *
      *                 3 A#OS                                         *
      *                                                                *
      *        - NN/N:  NUMERO DE A#OS, MESES O DIAS                   *
      *                                                                *
      *                                                                *
      *================================================================*
       21723-DIVISIBILIDAD.
      *
           MOVE WS-DIV-ENTRADA-1              TO WS-CODIGO-PERIODO-4
           MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
               GIVING WS-DIVIDENDO
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           MOVE WS-DIV-ENTRADA-2              TO WS-CODIGO-PERIODO
           MULTIPLY WS-PERIODO BY WS-CONVERSION-DIAS(WS-CODIGO)
               GIVING WS-DIVISOR
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-MULTIPLY
      *
           DIVIDE WS-DIVIDENDO BY WS-DIVISOR
               GIVING WS-COCIENTE
               REMAINDER WS-RESTO
               ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
           END-DIVIDE.
      *
      *================================================================*
      *                                                                *
      *                 21724-DIV-LININCUO                             *
      *                                                                *
      *    SE COMPRUEBA QUE EL NUMERO DE PERIODOS ES MAYOR Y MULTIPLO  *
      *    DE LA LINEA DE INCREMENTO DE CUOTA                          *
      *                                                                *
      *================================================================*
       21724-DIV-LININCUO.
      *
           IF WS-COCIENTE > ADS-LININCUO
              DIVIDE WS-COCIENTE BY ADS-LININCUO
                   GIVING WS-COCIENTE
                   REMAINDER WS-RESTO
                   ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
              END-DIVIDE
              IF WS-RESTO NOT = ZERO
                 MOVE CTE-CON-UGE0216         TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 PERFORM 30000-FINAL
              END-IF
           ELSE
              MOVE CTE-CON-UGE0240            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              PERFORM 30000-FINAL
           END-IF.
      *
      *================================================================*
      *                                                                *
      *             21725-DIV-PERINT                                  *
      *                                                                *
      *    SE COMPRUEBA QUE EL PLAZO ES MULTIPLO DE LA  PERIODICIDAD   *
      *    DE INTERESES                                                *
      *                                                                *
      *================================================================*
       21725-DIV-PERINT.
      *
           IF WS-PERCAP = SPACES OR
              WS-PERCAP = '999'
               MOVE TBLA-PLAZO                TO WS-CODIGO-PERIODO-4
               MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
                   GIVING WS-DIVIDENDO
                   ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
               END-MULTIPLY
           END-IF.
      *
           MOVE WS-PERINT                     TO WS-DIV-ENTRADA-2
      *
           PERFORM  21722-DIVISIBILIDAD-2
      *
           IF WS-RESTO NOT = ZERO
              MOVE CTE-CON-UGE0226            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              PERFORM 30000-FINAL
           END-IF.
      *
      *================================================================*
      *             20218-VALIDAR-CAREINT                              *
      *    SE COMPRUEBA QUE LA CARENCIA ES MULTIPLO DE LA PERIODICIDAD *
      *    DE LIQUIDACION DE INTERESES EN EL PERIODO DE CARENCIA       *
      *================================================================*
       20218-VALIDAR-CAREINT.
      *
           IF WS-CARECAP NOT = SPACES AND LOW-VALUES
              MOVE WS-CARECAP                 TO ADS-CARECAP
           ELSE
              MOVE SPACES                     TO WS-CARECAP
              MOVE WS-CARECAP                 TO ADS-CARECAP
           END-IF.
      *
           IF WS-CAREINT NOT = SPACES AND LOW-VALUES
              MOVE WS-CAREINT                 TO ADS-CAREINT
           ELSE
              MOVE SPACES                     TO WS-CAREINT
              MOVE WS-CAREINT                 TO ADS-CAREINT
           END-IF.
      *
           IF ( ADS-CARECAP  NOT = SPACES AND LOW-VALUES )
              IF ADS-CAREINT NOT = SPACES AND LOW-VALUES
                 MOVE ADS-CAREINT             TO WS-PERIODICIDAD
                                                 WS-CAREINT
              ELSE
                 MOVE SPACES                  TO WS-CAREINT
                 MOVE WS-CAREINT              TO WS-PERIODICIDAD
                                                 WS-CAREINT
                                                 ADS-CAREINT
              END-IF
           ELSE
              MOVE SPACES                     TO ADS-CAREINT
                                                 WS-CAREINT
           END-IF
      *
      *================================================================*
      * SOLO SE ANALIZA DIVISIBILIDAD CUANDO AMBOS TIENEN DATOS        *
      *================================================================*
           IF ( ADS-CARECAP NOT = SPACES AND LOW-VALUES ) AND
              ( ADS-CAREINT NOT = SPACES AND LOW-VALUES )
              MOVE ADS-CARECAP                TO WS-CODIGO-PERIODO-4
              MULTIPLY WS-PERIODO-4 BY WS-CONVERSION-DIAS(WS-CODIGO-4)
                  GIVING WS-DIVIDENDO
                  ON SIZE ERROR PERFORM  21711-REBOSAMIENTO
              END-MULTIPLY
      *
              MOVE ADS-CAREINT                TO WS-DIV-ENTRADA-2
              PERFORM  21722-DIVISIBILIDAD-2
              IF WS-RESTO NOT = ZERO
                 MOVE CTE-CON-UGE0948         TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 PERFORM 30000-FINAL
              END-IF
           END-IF.
      *
      *================================================================*
      *                                                                *
      *             XXX-EVALUAR-TIPO-CUOTA                             *
      *                                                                *
      * EN EL CASO DE QUE SE HAYA TECLEADO UNAS PERIODICIDADES DE CAPI-*
      * TAL E INTERESES DISTINTAS ENTRE SI, Y EL TIPO DE CUOTA SEA     *
      * CONSTANTE DE CAPITAL MAS INTERESES, EN ESTE PARRAFO SE TRADUCE *
      * EL TIPO DE CUOTA, PARA INSERTAR EN UGDTADE UN TIPO DE CUOTA    *
      * (CODTIAMO), QUE SEA COHERENTE CON UNAS PERIODICIDADES DISTINTAS*
      * ENTRE SI; ESTO SOLO SE PERMITE PARA DETERMINADOS PRODUCTOS .   *
      *  LA TRADUCCION QUE SE REALIZA ES LA SIGUIENTE:                 *
      *    VALORES DE CODTIAMO:                                        *
      *        ANTER.        NUEVOS                                    *
      *       -------       --------                                   *
      *          1 ----------> 2                                       *
      *          3 ----------> 4                                       *
      *          5 ----------> 6                                       *
      *          7 ----------> 8                                       *
      *          9 ----------> 0                                       *
      *                                                                *
      *================================================================*
       XXX-EVALUAR-TIPO-CUOTA.
      *
           EVALUATE ADS-CODTIAMO
              WHEN '1'
                 MOVE '2'                     TO ADS-CODTIAMO
              WHEN '3'
                 MOVE '4'                     TO ADS-CODTIAMO
              WHEN '5'
                 MOVE '6'                     TO ADS-CODTIAMO
              WHEN '7'
                 MOVE '8'                     TO ADS-CODTIAMO
              WHEN '9'
                 MOVE '0'                     TO ADS-CODTIAMO
      *================================================================*
      *  REGLA 78                                                      *
      *================================================================*
              WHEN 'R'
                 MOVE 'R'                     TO ADS-CODTIAMO
           END-EVALUATE.
      *
           MOVE ADS-CODTIAMO                  TO WS-TIPO-CUOTA.
      *
      *================================================================*
      *             24-CALCULAR-PRI-CUOTA.                             *
      *   SE CALCULA LA PRIMERA CUOTA POR MEDIO DE LA RUTINA UR1CCOT   *
      *================================================================*
       24-CALCULAR-PRI-CUOTA.
      *
           IF TBLA-IMPCONC-ALF = LOW-VALUES OR ZEROS
              MOVE ZERO                       TO WS-IMPCONCE-VACIO
           ELSE
              MOVE TBLA-IMPCONC               TO WS-IMPCONCE-VACIO
           END-IF
      *
           MOVE ZERO                          TO WS-PRICUOTA-VACIO
      *
           IF TBLA-TIPOINT-ALF = LOW-VALUES OR ZEROS
              MOVE ZERO                       TO WS-INTERES-VACIO
           ELSE
              MOVE TBLA-TIPOINT               TO WS-INTERES-VACIO
           END-IF
      *
           IF WS-PORFINA-ALF = LOW-VALUES OR ZEROS
              MOVE ZEROS                      TO WS-PORFINA
           END-IF
      *
           IF ADS-CODTIAMO = 'L' OR 'M'
              IF WS-PORFINA < PRO-LIBRE-IMP1 OR
                 WS-PORFINA > PRO-LIBRE-IMP2
                 MOVE 'UGE0939'                  TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE 'PORCENTAJE CUOTA FIN'     TO TBLA-DESCRIP1
                 MOVE 'FUERA DE RANGO'           TO TBLA-DESCRIP2
                 PERFORM  30000-FINAL
              END-IF
           END-IF
      *
           IF TBLA-TAE-ALF = LOW-VALUES OR SPACES
              MOVE ZERO                       TO WS-TAE-VACIO
           ELSE
              MOVE TBLA-TAE                   TO WS-TAE-VACIO
           END-IF
      *
      *================================================================*
      *   SE FORMATEAN LOS DATOS DE ENTRADA A LA RUTINA DE CALCULO
      *   DE LA PRIMERA CUOTA
      *================================================================*
           PERFORM 241-FORM-DATOS-ENTR
      *
           MOVE 'S'                           TO COT-CALCULAR-A
           MOVE ZEROS                         TO COT-FACTOR-A
           MOVE WS-FECHA-AMO                  TO COT-F-FORMA
      *
      *
DAST       IF ADS-CODTIAMO = 'H'
      *@COL01-I
             CONTINUE
      *      MOVE '24-CALCULAR-PRI-CUOT'      TO WTRC0-PARRAFO
      *      MOVE 'VER ADS-CODTIAMO:   '      TO WTRC0-DESCRIPCION
      *      MOVE ADS-CODTIAMO                TO WTRC0-VALOR-ALF
      *      PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
           END-IF
      *
           MOVE  ADS-CODTIPRE   TO COT-CODIGO
      *
           PERFORM  242-LLAMAR-MODULO-CALC
      *
           MOVE COT-INT-NOMINAL                TO WS-INTERES-NOMINAL.
      *
      *================================================================*
      *             241-FORM-DATOS-ENTR                                *
      *   SE INFORMAN LOS CAMPOS DE ENTRADA DE LA RUTINA DE CALCULO DE *
      *   LA PRIMERA CUOTA.                                            *
      *================================================================*
       241-FORM-DATOS-ENTR.
      *
           MOVE TBLA-IMPCONC                  TO COT-CAPITAL
      *
           INITIALIZE URWCCVT
      *
           IF ADS-CODTIPRE = SPACES OR LOW-VALUES
              MOVE 'DTF'                      TO CVT-TIPO-TASA
           ELSE
              MOVE ADS-CODTIPRE               TO CVT-TIPO-TASA
           END-IF
      *
           MOVE 'S'                           TO CVT-IND-CONV
           MOVE ZERO                          TO CVT-PUNTOS
           MOVE WS-PERINT                     TO CVT-PERINT
           MOVE TBLA-PLAZO                    TO CVT-PLAZO
      *
           IF TBLA-TIPOINT-ALF = LOW-VALUES OR ZEROS OR SPACES
              MOVE 'N'                        TO CVT-RESULTADO
              MOVE TBLA-TAE                   TO CVT-TASA
      *COL11-I
              IF SW-CREDITOVIRTUAL-SI
                 INITIALIZE CVT-TASA
                 PERFORM VALIDA-TIPO-TASA
                 MOVE WS-EFECTIVA-CV          TO CVT-TASA
              END-IF
      *COL11-F
              PERFORM 2030-CALCULA-TASA-NOMINAL
              MOVE CVT-NOMINAL                TO WS-TASA-NOMINAL
      *@COL01-I
      *       MOVE CVT-NOMINAL                TO COT-INT-NOMINAL
              MOVE CVT-NOMINAL                TO WS-TIPO-APLI
              MOVE WS-TIPO-APLI               TO COT-INT-NOMINAL
      *@COL01-F
              MOVE CVT-NOMINAL                TO WS-TASA-NOMINAL-F
              MOVE TBLA-TAE                   TO WS-TASA-EFECTIVA-F
           ELSE
      *SE INFORMO LA NOMINAL
              MOVE 'E'                        TO CVT-RESULTADO
              MOVE TBLA-TIPOINT               TO CVT-TASA
              PERFORM 2030-CALCULA-TASA-NOMINAL
              MOVE TBLA-TIPOINT               TO WS-TASA-NOMINAL
              MOVE TBLA-TIPOINT               TO COT-INT-NOMINAL
              MOVE TBLA-TIPOINT               TO WS-TASA-NOMINAL-F
              MOVE CVT-EFECTIVA               TO WS-TASA-EFECTIVA-F
           END-IF
      *
           MOVE ZEROES                     TO WS-TASA-REDOND
           MOVE WS-TASA-EFECTIVA-F         TO WS-TASA-REDOND
           MOVE WS-TASA-REDOND             TO TBLA-TASTAE
      *
           MOVE ZEROES                     TO WS-TASA-REDOND
           MOVE WS-TASA-NOMINAL-F          TO WS-TASA-REDOND
           MOVE WS-TASA-REDOND             TO TBLA-TASNOMINAL
           MOVE ZEROES                     TO WS-TASA-REDOND
      *
           MOVE ZEROS                         TO COT-INT-EFECTIVO
      * VALIDA SI EL SUBPRODUCTO ES LA CAROLINA
           IF WS-INT-CAPITALIZABLES = '1'
              COMPUTE WS-TASA-MNSUAL = (COT-INT-NOMINAL / 100) / 12
              COMPUTE WS-INT-GRA = (WS-TASA-MNSUAL * TBLA-IMPCONC) *
                                   WS-PRDO-GRCIA
              COMPUTE COT-CAPITAL = COT-CAPITAL + WS-INT-GRA
              COMPUTE TBLA-IMPCONC = TBLA-IMPCONC + WS-INT-GRA
           END-IF
      *
           IF ADS-CODTIAMO = 'B' OR 'L' OR 'M'
              MOVE TBLA-IMPCONC               TO COT-CAPITAL-INICIAL
           END-IF
      *
           PERFORM 2412-BUSCA-TIPCAR
      *LJSM-I
      * DETERMINA SI APLICA LA NUEVA METODOLOGIA DE LIQUIDACION.
           PERFORM 9000-VALIDAR-METODO-LIQ
      *LJSM-J
      *
           IF ADS-CODTIAMO = 'L' OR 'M'
              MOVE WS-PORFINA                 TO COT-PORC-FINAL
              COMPUTE WS-CUOTA-FIN ROUNDED = COT-CAPITAL-INICIAL *
                                   (COT-PORC-FINAL / 100)
           END-IF
      *
           PERFORM 2411-RESTO-DATOS.
           PERFORM 221411-RESTO-DATOS-1.
      *
      *================================================================*
      *             2411-RESTO-DATOS                                   *
      *   SE FORMATEAN EL RESTO DE LOS DATOS DE ENTRADA A LA RUTINA    *
      *   DE CALCULO DE LA PRIMERA CUOTA                               *
      *================================================================*
       2411-RESTO-DATOS.
      *
           MOVE ADS-CODTIAMO                  TO COT-TIP-CUOTA
           MOVE ZERO                          TO COT-AJUSTE-ENTREGAS
      *
      *================================================================*
      *    SE CALCULA EL NUMERO DE AMORTIZACIONES ANUALES
      *================================================================*
           MOVE WS-PERCAP                     TO WS-CODIGO-PERIODO
           MOVE ZERO                          TO WS-RESTO
      *
           EVALUATE WS-CODIGO
              WHEN CTE-CON-3
                 DIVIDE CTE-CON-1      BY WS-PERIODO
                    GIVING COT-AMO-ANNO
                    REMAINDER WS-RESTO
                    ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
                 END-DIVIDE
              WHEN CTE-CON-2
                 DIVIDE CTE-CON-12     BY WS-PERIODO
                    GIVING COT-AMO-ANNO
                    REMAINDER WS-RESTO
                    ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
                 END-DIVIDE
                      MOVE COT-AMO-ANNO      TO WS-COT-AMO-ANNO
      *
                      IF COT-AMO-ANNO EQUAL  WS-COT-AMO-ANNO
                         CONTINUE
                      ELSE
                         MOVE ZEROS            TO COT-AMO-ANNO
                         MOVE WS-COT-AMO-ANNO  TO COT-AMO-ANNO
                      END-IF
              WHEN CTE-CON-1
                 IF ADS-DIASCAL = CTE-CON-COMERCIALES OR CTE-CON-MIXTOS
                    DIVIDE CTE-CON-360-COMP3     BY WS-PERIODO
                       GIVING COT-AMO-ANNO
                       REMAINDER WS-RESTO
                       ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
                    END-DIVIDE
                 ELSE
                    DIVIDE CTE-CON-365-COMP3     BY WS-PERIODO
                       GIVING COT-AMO-ANNO
                       REMAINDER WS-RESTO
                       ON SIZE ERROR PERFORM 21711-REBOSAMIENTO
                    END-DIVIDE
                 END-IF
           END-EVALUATE
      *
      *================================================================*
      *    SI EL NUMERO DE AMORTIZACIONES POR A#O NO ES UN NUMERO
      *    ENTERO NO SE PUEDE EFECTUAR LA SIMULACION
      *================================================================*
           IF WS-RESTO > ZERO
              MOVE CTE-CON-UGE0298            TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              PERFORM  30000-FINAL
           END-IF
      *
      *================================================================*
      *    SI EL TIPO DE AMORTIZACION ES PERIODICO SE PASAN A LA       *
      *    RUTINA LA LINEA DE INCREMENTO DE LA CUOTA Y EL NUMERO       *
      *    DE PERIODOS DE VIGENCIA DEL PRESTAMO                        *
      *================================================================*
           IF ADS-CODTIAMO   = CTE-CON-5      OR
              ADS-CODTIAMO   = CTE-CON-6      OR
              ADS-CODTIAMO   = CTE-CON-9      OR
              ADS-CODTIAMO   = CTE-CON-0
              MOVE ADS-LININCUO               TO COT-AMO-PERIODO
                                                 COT-AMO-RESTAN-PER
