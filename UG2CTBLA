      *================================================================*
      * SE BUSCA EL TIPO DE CARTERA PARA EL SUBPRODUCTO                *
      *================================================================*
      *
       2412-BUSCA-TIPCAR.
      *@COL01-I
      *    MOVE '2412-BUSCA-TIPCAR.  '     TO WTRC0-PARRAFO
      *    MOVE 'RESTO 3             '     TO WTRC0-DESCRIPCION
      *    MOVE SPACES                     TO WTRC0-VALOR-ALF
      *    PERFORM 998-ESCRIBIR-CNTRACE
      *@COL01-F
      *
           INITIALIZE UGTCT37
      *
           MOVE '1901'                      TO T37-SECCION
           MOVE ADS-SUBPRO                  TO T37-ELEMENTO
      *
           EXEC SQL
                SELECT RESTO
                INTO  :T37-RESTO
                FROM UGDTT37
                WHERE SECCION  = :T37-SECCION  AND
                      ELEMENTO = :T37-ELEMENTO
           END-EXEC

           MOVE SQLCODE                     TO DB2-RETURN-CDE

           IF DB2-OK
              MOVE T37-RESTO(1:1)           TO COT-TIPO-CAR
           ELSE
              IF DB2-NOTFND
                 MOVE 'UGE0939'               TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE 'NO EXISTE TIPO DE   '  TO TBLA-DESCRIP1
                 MOVE 'CARTERA UGDTT37 1901'  TO TBLA-DESCRIP2
                 PERFORM 30000-FINAL
              ELSE
                 MOVE 'UGDTT37'            TO TBLA-DESCRIP1
                 PERFORM 999999-ABEND-DB2
              END-IF
           END-IF.
      *
      *================================================================*
      *                                                                *
      *             22235-CALC-PLAZO-GRACIA                            *
      *                                                                *
      *    CALCULA EL PLAZO REAL DE LAS AMORTIZACIONES DE CAPITAL DE   *
      *    UN PRESTAMO.  (MAE-PLAZO - GRACIA DE CAPITAL)               *
      *                                                                *
      *    NOTA: LOS VALORES A COMPARAR DEBEN ESTAR EXPRESADOS EN ANOS.*
      *          ESTE RESULTADO SE UTILIZARA EN EL CALCULO DE LA CUOTA *
      *          GRADUAL.                                              *
      *                                                                *
      *================================================================*
       22235-CALC-PLAZO-GRACIA.
      *
           MOVE ZERO                          TO WS-TOT-PLAZO-GRACIA.
      *
           IF TBLA-PLAZO(1:1) NOT = '3'
              MOVE 'UGE0939'                  TO TBLA-CODERROR
              MOVE '30'                    TO TBLA-CODRETO
              MOVE 'EL PLAZO NO ESTA EN '     TO TBLA-DESCRIP1
              MOVE 'ANOS.               '     TO TBLA-DESCRIP2
              MOVE TBLA-PLAZO                 TO TBLA-DESCRIP2(17:4)
              PERFORM 30000-FINAL
           END-IF.
      *
           MOVE TBLA-PLAZO                    TO WS-PLAZO-GRACIA.
           MOVE WS-PLAZO-GRACIA1              TO WS-TOT-PLAZO-GRACIA1
           MOVE WS-PLAZO-GRACIA2              TO WS-TOT-PLAZO-GRACIA2
      *
           IF ADS-CARECAP = SPACES or LOW-VALUES
              continue
           else
              IF ADS-CARECAP(1:1) NOT = '3'
                 MOVE 'UGE0939'               TO TBLA-CODERROR
                 MOVE '30'                    TO TBLA-CODRETO
                 MOVE 'GRACIA CAPITAL NO   '  TO TBLA-DESCRIP1
                 MOVE 'ESTA EN ANOS.       '  TO TBLA-DESCRIP2
                 MOVE ADS-CARECAP             TO TBLA-DESCRIP2(17:4)
                 PERFORM 30000-FINAL
              ELSE
                 MOVE ADS-CARECAP             TO WS-PLAZO-GRACIA
                 COMPUTE WS-TOT-PLAZO-GRACIA2 =
                         WS-TOT-PLAZO-GRACIA2 - WS-PLAZO-GRACIA2
                 END-COMPUTE
              END-IF
           END-IF.
      *
           MOVE ZERO                          TO WS-PLAZO-GRACIA.
      *
           COMPUTE WS-PLAZO-GRACIA2 =
                   WS-TOT-PLAZO-GRACIA2 * COT-AMO-ANNO
           END-COMPUTE
      *
           IF COT-TOT-AMORT-PEN > WS-PLAZO-GRACIA2
              MOVE '30'                    TO TBLA-CODRETO
              MOVE 'UGE0939'                  TO TBLA-CODERROR
              MOVE '# AMORTIZ.PENDIENTES'     TO TBLA-DESCRIP1
              MOVE 'MAYOR QUE EL PLAZO  '     TO TBLA-DESCRIP2
              PERFORM 30000-FINAL
           END-IF.
      *
           MOVE WS-TOT-PLAZO-GRACIA           TO WS-ACUM-PLAZO-GRACIA
           MOVE WS-ACUM-PLAZO-GRACIA          TO COT-PER-VIGENCIA.
