      * -------------------------------------------------------------- *
      * COL03-I
       9999-CALCULO-COMISION.
           SET SW-ERREVAL-NO    TO TRUE
           INITIALIZE           QGECCOM0-01 WS-CLAVE-COMI
           MOVE CTE-1           TO RCO-UNIDADES RCO-CANTIDAD
           MOVE CTE-S           TO RCO-MODO-CONSUL
           MOVE CTE-96          TO RCO-PRODUCTO
           MOVE CTE-UG          TO RCO-APLICCOM
           MOVE UGSI-SUBPRODUC  TO RCO-SUBPRODU
           MOVE CTE-UG2CUGSI    TO RCO-CAA-NETNAME
           MOVE W-FECHA-DISPLAY TO RCO-CAA-FECHA-OPER2
           MOVE UGSI-APLICATIVO TO RCO-DESCR-LIBRE
           MOVE UGSI-VALORSOLICITUD TO RCO-IMPORTE
           PERFORM 231-VALIDA-CLAVE-SERVICIO
           MOVE WS-CLAVE-COMI   TO RCO-CLAVECOM
           PERFORM 9999-BUSCA-NUMCLIEN
           PERFORM 9999-OFICINA-GESTORA
           EXEC CICS
               LINK PROGRAM ('QG7CCOM0')
               COMMAREA (QGECCOM0-01)
               NOHANDLE
           END-EXEC
           EVALUATE RCO-RETORNO
              WHEN CTE-COMI-OK
                   PERFORM 9999-PASAINFO-COM
              WHEN CTE-DTOS-IMCOMPLETOS
                   MOVE CTE-MENSAJE2 TO UGSI-DESCRI2
                   SET SW-ERREVAL-SI TO TRUE
              WHEN CON-ERROR-IMPORTE-NEGAT
                   MOVE CTE-MENSAJE3 TO UGSI-DESCRI2
                   SET SW-ERREVAL-SI TO TRUE
              WHEN CTE-NO-RELACION-PRODCOMI
                   MOVE CTE-MENSAJE4 TO UGSI-DESCRI2
                   SET SW-ERREVAL-SI TO TRUE
              WHEN CTE-ERROR-IVA-BR7CRRF0
                   MOVE CTE-MENSAJE5 TO UGSI-DESCRI2
                   SET SW-ERREVAL-SI TO TRUE
              WHEN OTHER
                   MOVE RCO-RETORNO  TO UGSI-DESCRI2
                   SET SW-ERREVAL-SI TO TRUE
           END-EVALUATE
           IF SW-ERREVAL-SI
              MOVE RCO-RETORNO  TO UGSI-CODRETO
              MOVE CTE-MENSAJE1 TO UGSI-DESCRI1
              PERFORM 2990-ESCRIBE-COLA-TS
              PERFORM 999999-ROLLBACK
              PERFORM 3000-FINAL
           END-IF.
      * -------------------------------------------------------------- *
       999999-ROLLBACK.

           EXEC CICS
                 SYNCPOINT ROLLBACK
           END-EXEC
           IF EIBRESP NOT EQUAL DFHRESP(NORMAL)
              MOVE CTE-UGE0939  TO UGSI-CODRETO
              MOVE 'ERROR EN ROLLBACK'    TO UGSI-DESCRI1
              MOVE 'EIBRESP: '            TO UGSI-DESCRI2
              PERFORM 999999-ROLLBACK
              PERFORM 3000-FINAL
           END-IF
           SET   SW-SI-ROLLBACK           TO TRUE.

      *----------------------------------------------------------------*
      *                  231-VALIDA-CLAVE-SERVICIO                     *
      *----------------------------------------------------------------*
      *     SECCION CON LAS CLAVES DE SERVICIO POR TIPO DE SERVICIO    *
      *----------------------------------------------------------------*
       231-VALIDA-CLAVE-SERVICIO.
           SET SW-ERREVAL-NO    TO TRUE
           INITIALIZE           UGTCT37
           MOVE CTE-0547        TO T37-SECCION
           MOVE UGSI-IDCOMISION TO T37-ELEMENTO
           EXEC SQL
              SELECT RESTO
              INTO   :T37-RESTO
              FROM   UGDTT37
              WHERE SECCION   = :T37-SECCION
              AND   ELEMENTO  = :T37-ELEMENTO
           END-EXEC
           MOVE SQLCODE                     TO DB2-RETURN-CDE
           IF DB2-OK
              MOVE T37-RESTO(38:4)           TO WS-CLAVE-COMI
           ELSE
              SET SW-ERREVAL-SI TO TRUE
              IF DB2-NOTFND
                 MOVE CTE-MENSAJE7 TO UGSI-DESCRI2
              ELSE
                 MOVE CTE-MENSAJE8 TO UGSI-DESCRI2
              END-IF
           END-IF
           IF SW-ERREVAL-SI
              MOVE CT-10        TO UGSI-CODRETO
              MOVE CTE-MENSAJE6 TO UGSI-DESCRI1
              PERFORM 999999-ROLLBACK
              PERFORM 3000-FINAL
           END-IF.
      * -------------------------------------------------------------- *
       9999-PASAINFO-COM.
           MOVE RCO-PORC-IVA      TO WS-PORC-IVA-ED
           MOVE RCO-PORC-COM      TO WS-PORC-COM-ED
           MOVE RCO-IMP-IVA-TEOR  TO WS-IMP-IVA-TEOR-ED
           MOVE RCO-IMPORTE-TEORI TO WS-IMPORTE-TEORI-ED
           MOVE RCO-IMPORTE-APLIC TO WS-IMPORTE-APLIC-ED
           MOVE RCO-IMP-IVA-TEOR  TO UGSI-VR-IVACOM
           MOVE RCO-IMPORTE-TEORI TO UGSI-VR-COMISION
           MOVE CTE-IVA           TO UGSI-LABEL-IVA
           MOVE CTE-COP        TO UGSI-DIVISA-COMISI UGSI-DIVISA-IVACOM.
      * -------------------------------------------------------------- *
      *                      9999-BUSCA-NUMCLIEN                       *
      *  SE REALIZA EL LLAMADO A LA RUTINA PE9C1000 PARA TRAER EL      *
      *                  NUMERO DE CLIENTE RELACIONADO                 *
      ******************************************************************
       9999-BUSCA-NUMCLIEN.
           INITIALIZE           DATOS-BASICOS
           MOVE CTE-2            TO DATOS-OPCION
           MOVE UGSI-TIPO-DOCUME TO DATOS-CODIDENT
           MOVE UGSI-NUME-IDENT  TO DATOS-CLAIDENT
           CALL RUT-PE9C1000 USING DATOS-BASICOS
           IF DATOS-COD-RETORNO = CTE-00
              CONTINUE
           ELSE
              MOVE CT-10        TO UGSI-CODRETO
              MOVE CTE-MENSAJ10 TO UGSI-DESCRI1
              MOVE CTE-MENSAJE9 TO UGSI-DESCRI2
             PERFORM  3000-FINAL
           END-IF.
      * -------------------------------------------------------------- *
       9999-OFICINA-GESTORA.
           INITIALIZE           PEWC5200-01
           MOVE CTE-00          TO W520-PECRETOR
           MOVE DATOS-NUMCLIEN  TO W520-NUMCLIEN
           CALL CTE-PE9C5200    USING PEWC5200-01
           IF W520-PECRETOR = CTE-00
              IF W520-IDENENT  = SPACES
                 MOVE CTE-0013   TO W520-IDENENT
              END-IF
              MOVE W520-CODIDENT TO RCO-TIPO-IDENT
              MOVE W520-CLAIDENT TO RCO-NUME-IDENT
              MOVE W520-DIGIDENT TO RCO-DIG-IDENT
              MOVE W520-IDENENT TO RCO-CAA-ENTIDAD     RRF-ENTIDAD
              MOVE W520-OFIALTA TO RCO-CAA-CENTRO-CONT RRF-SUCURSAL-OP
           ELSE
              MOVE  CT-10   TO UGSI-CODRETO
              MOVE CTE-MENSAJ11 TO UGSI-DESCRI1
              MOVE CTE-MENSAJE9 TO UGSI-DESCRI2
              PERFORM  3000-FINAL
           END-IF.
      * COL03-F
      * -------------------------------------------------------------- *
